#!/bin/sh

# 1. 스테이징된 파일 중 Spotless 관리 대상 목록 추출 (Java, YAML, Gradle, MD, Gitignore)
# -E 옵션으로 정규표현식을 사용하여 여러 확장자를 한 번에 잡습니다.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(java|yml|yaml|gradle|md)$")
FILE_COUNT=$(echo "$STAGED_FILES" | wc -l | xargs)

if [ -z "$STAGED_FILES" ]; then
    echo "✔ Spotless 관리 대상 파일이 없어 검사를 건너뜁니다."
    exit 0
fi

# 2. Gradle에 전달하기 위해 파일 목록을 콤마(,)로 변환
FILES_COMMA_SEPARATED=$(echo "$STAGED_FILES" | paste -sd "," -)

echo "🔍 선택된 파일 ${FILE_COUNT}건에 대해 Spotless 적용 중..."

# 3. 특정 파일만 타겟팅하여 Spotless 실행
./gradlew spotlessApply -PspotlessFiles="$FILES_COMMA_SEPARATED"

if [ $? -ne 0 ]; then
    echo "❌ Spotless 실행 중 오류가 발생했습니다."
    exit 1
fi

# 4. 수정된 파일들만 다시 스테이징
# STAGED_FILES에 담긴 모든 파일을 다시 add 합니다.
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        git add "$FILE"
    fi
done

echo "✅ 모든 대상 파일의 Spotless 적용 및 재스테이징 완료."
exit 0