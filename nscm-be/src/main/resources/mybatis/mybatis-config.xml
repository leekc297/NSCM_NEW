<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"  "./mybatis-3-config.dtd">

<configuration>
    <settings>
        <setting name="jdbcTypeForNull" value="NULL"/>	<!-- null 허용 -->
        <!-- [E20260824-FETCHSIZE] 0 = 드라이버 기본값이고 Oracle JDBC 기본은 10행이다.
             DB 가 원격(사내 100.65.143.121)이라 대량 조회에서 왕복 횟수가 그대로 지연이 된다.
             DMF0020 실측(div82 / 12개월 / 10,524행 x 102컬럼):
               fetchSize 10 -> 약 1,052회 왕복, BE 내부 약 22초 (API TTFB 34초)
               같은 커서를 arraysize 2000 으로 받으면 4초 (직접 측정)
             1000 = 왕복 11회. 102컬럼이어도 1,000행 버퍼는 수 MB 라 힙 부담이 낮다. -->
        <setting name="defaultFetchSize" value="1000"/>
		<!-- 
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <setting name="lazyLoadingEnabled" value="true"/>
        <setting name="callSettersOnNulls" value="true"/>
		-->
    </settings>

<!-- 
    <typeAliases>
        <package name="com.lgcns.nscm.dto"/>
    </typeAliases>
-->

    <typeHandlers>
        <typeHandler handler="org.apache.ibatis.type.ClobTypeHandler" jdbcType="CLOB" javaType="java.lang.String" />
    	
		<!--
        <typeHandler handler="org.apache.ibatis.type.DateTypeHandler" javaType="java.util.Date" jdbcType="TIMESTAMP"/>
        -->
    </typeHandlers>

