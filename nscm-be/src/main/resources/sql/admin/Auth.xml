<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"  "../../mybatis/mybatis-3-mapper.dtd">
<mapper namespace="com.lgcns.nscm.admin.auth">

    <resultMap id="authResultMap" type="java.util.HashMap" />
    
    <select id="checkMenuAuth" statementType="CALLABLE">
		{ CALL SCM_MGR.PKG_NSCM_UI_COM_AUTH.PR_CHECK_MNU_AUTH(
			#{userId},
			#{mnuId},
			#{DATARESULT, mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=userResultMap}
		) }
	</select>
	
    <select id="checkMenuBtnAuth" statementType="CALLABLE">
		{ CALL SCM_MGR.PKG_NSCM_UI_COM_AUTH.PR_CHECK_MNU_BTN_AUTH(
			#{userId},
			#{mnuId},
			#{shtNm},
			#{mnuBtnCd},
			#{DATARESULT, mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=userResultMap}
		) }
	</select>
	
    <select id="retrieveMenuBtnAuth" statementType="CALLABLE">
		{ CALL SCM_MGR.PKG_NSCM_UI_COM_AUTH.PR_GET_MNU_BTN_AUTH(
			#{userId},
			#{mnuId},
			#{DATARESULT, mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=userResultMap}
		) }
	</select>
	
	<select id="checkMenuBtnAuthOri" statementType="CALLABLE">
		{ CALL SCM_MGR.PKG_NSCM_UI_COM_AUTH.PR_CHECK_MNU_BTN_AUTH(
			#{userId},
			#{mnuId},
			#{mnuBtnCd},
			#{DATARESULT, mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=userResultMap}
		) }
	</select>
	
	<select id="retrieveMenuBtnAuthOri" statementType="CALLABLE">
		{ CALL SCM_MGR.PKG_NSCM_UI_COM_AUTH.PR_GET_MNU_BTN_AUTH(
			#{userId},
			#{mnuId},
			#{DATARESULT, mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=userResultMap}
		) }
	</select>
	
    <select id="retrieveUnitAuth" statementType="CALLABLE">
		{ CALL SCM_MGR.PKG_NSCM_UI_COM_AUTH.PR_GET_UNIT_AUTH(
			#{userId},
			#{mnuId},
			#{DATARESULT, mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=userResultMap}
		) }
	</select>
    
</mapper>