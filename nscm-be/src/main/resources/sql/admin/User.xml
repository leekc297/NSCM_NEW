<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"  "../../mybatis/mybatis-3-mapper.dtd">
<mapper namespace="com.lgcns.nscm.admin.user">

    <resultMap id="userResultMap" type="java.util.HashMap" />
    
    <select id="retrieveUser" statementType="CALLABLE">
		{ CALL SCM_MGR.PKG_NSCM_UI_COM_USER.PR_GET_NSCM_USER(
			#{userId},
			#{DATARESULT, mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=userResultMap}
		) }
    </select>
        
    <select id="updateLangCd" statementType="CALLABLE">
		{ CALL SCM_MGR.PKG_NSCM_UI_COM_USER.PR_UPDATE_LANG_CD(
			#{userId},
			#{langCd}
		) }
    </select>
        
</mapper>