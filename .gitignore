# =============================================================================
# NSCM 모노레포 .gitignore — GitHub leekc297/NSCM (개인 백업)
# =============================================================================
# 이 PC 단독 관리. 사내 자산 외부 노출 위험 최소화.
# =============================================================================

# ---------------- 민감 파일 (절대 commit 금지) ----------------
**/config/config-local.yml
**/config/config-dev.yml
**/config/config-prod.yml
**/config/config-production.yml
**/credentials*
**/secrets*
**/*secret*
*.pem
*.key
*.pfx
*.p12
.env
.env.*
!.env.example

# .npmrc 의 토큰 부분만 신경 (현재는 주석 처리 상태지만 보수적으로)
**/.npmrc

# ---------------- 빌드 산출물 ----------------
**/node_modules/
**/dist/
**/build/
**/.turbo/
**/.vite/
**/.cache/
**/.gradle/
**/.idea/
nscm-be/bin/
nscm-be/out/
nscm-be/build/
nscm-be/logs/
**/target/
**/*.class
**/*.jar
**/*.war

# ---------------- 사내 GitLab .git 백업 (NSCM_gitlab_backup) ----------------
NSCM_gitlab_backup/

# ---------------- 임시/캐시 ----------------
**/*.log
**/*.tmp
**/*.swp
**/.DS_Store
**/Thumbs.db
**/.vscode/launch.json

# ---------------- 분석 대용량 (별도 백업 권장) ----------------
# 분석 산출물은 회사 자산. 외부 git 노출 금지.
_phase1/
_phase2/
_phase3/
_phase4/
_analysis/

# Doc 의 회사 자산 (분석/figma/legacy/UI 캡처)
Doc/_analysis/
Doc/_archive/
Doc/_figma/
Doc/_legacy_source/
Doc/output/
Doc/ui_cap/
# Doc/_dev_rules/, Doc/_templates/, Doc/README.md 는 commit OK (룰셋 + 템플릿)

# BE 로그 / output
nscm-be/logs/
nscm-be/output/
nscm-be/build/

# .npmrc 변종
**/.npmrc.cloud
**/.npmrc.local
**/.npmrc.backup

# .uuid 임시 파일
**/.uuid.LCK
**/.uuid.TMP-*

# .claude 사용자 캐시 (현재 PC 전용)
.claude/projects/
.claude/settings.local.json
.claude/sessions/

# 이전 화면 패키지 산출물 (대용량 + 회사 자산)
_dmf0020_artifacts/
_dmf0099_artifacts/
*_artifacts/*.zip

# 임시 SQL / 데이터
tmp_*.sql
tmp_*.csv
tmp_*.txt

# 대용량 압축 (100MB 초과 가능)
*.7z
*.zip
*.tar.gz
*.tar.bz2
*.rar

# .uuid 임시
.uuid
**/.uuid

# ---------------- _artifacts 의 sysdba/grant 파일 ----------------
# 다른 _artifacts/*.sql 은 commit OK (비밀번호 노출 0건 확인됨)
_artifacts/*sysdba*.sql
_artifacts/grant_minyonglee1_full_admin.sql
_artifacts/local-docker-oracle/
_artifacts/cloud-to-local-mirror/

# ---------------- DB / 로컬 데이터 ----------------
**/oracle_data/
*.dmp
*.dat

# ---------------- 백업 / 임시 / Claude Code ----------------
**/pnpm-lock.yaml.bak
**/*.bak
.claude/scheduled_tasks.lock
