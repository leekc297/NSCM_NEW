# ---------------- _backup_metadata 대용량 제외 (GitHub 100MB 한도) ----------------
# backup-all.ps1 가 git bundle / oracle dmp / tar 등을 메타 폴더에 복사하지만
# 100MB 초과 파일은 GitHub push 차단 (2026-06-06 source.bundle 127MB 사고).
# Manifest/log 만 GitHub 미러, 대용량은 D:\NSCM_backup\ 원본만 유지.
_backup_metadata/**/source.bundle
_backup_metadata/**/*.dmp
_backup_metadata/**/*.tar
_backup_metadata/**/*.tar.gz
_backup_metadata/**/*.zip

# ---------------- 임시/캐시 ----------------
**/*.log
!_backup_metadata/**/*.log
**/*.tmp
**/*.swp
**/.DS_Store
**/Thumbs.db
**/.vscode/launch.json

