-- ==============================================================================================================
-- SSP LOOKUP 이관 3/4 · Oracle(클라우드 QA) 확인 쿼리 · 전부 조회 문장
-- 순서 : 1/4 백업 → [O1] 실행 전 건수 기록 → 2/4 파일 [M2] 결과(MERGE 문장) 스크립트 실행 → [O1] · [O2] · [O3] 다시 실행 → 맞으면 COMMIT
--        DBeaver 자동 커밋이 켜져 있으면 MERGE 문장마다 바로 반영됨. 확인 뒤 반영하려면 수동 커밋으로 바꾸고 실행
-- 로컬 시험(2026-11-25 11:26, AS-IS 개발 → ZIOUI1, ROLLBACK) : MERGE 2,314문장 오류 0 · 26.8초 · 실행 뒤 AS-IS 와 값 다른 칸 0
-- ==============================================================================================================

-- ==============================================================================================================
-- [O1] SSP 그룹 건수
-- 확인 : MERGE 뒤 MASTER_CNT ≥ 2/4 파일 [M1] MASTER_CNT, DETAIL_CNT(IF_STOCK_CHECK 제외) ≥ [M1] DETAIL_CNT
--        Oracle 에만 있는 유형 · 행은 지우지 않으므로 같거나 많음
-- ==============================================================================================================
SELECT (SELECT COUNT(*)
          FROM SCM_ADM_LOOKUP_MASTER M
         WHERE M.LOOKUP_GROUP = 'SSP') AS MASTER_CNT
     , (SELECT COUNT(*)
          FROM SCM_ADM_LOOKUP_MASTER_DETAIL D
         WHERE D.LOOKUP_TYPE IN (SELECT G.LOOKUP_TYPE
                                   FROM SCM_ADM_LOOKUP_MASTER G
                                  WHERE G.LOOKUP_GROUP = 'SSP')
           AND D.LOOKUP_TYPE <> 'IF_STOCK_CHECK') AS DETAIL_CNT
     , (SELECT COUNT(*)
          FROM SCM_ADM_LOOKUP_MASTER_DETAIL D
         WHERE D.LOOKUP_TYPE = 'IF_STOCK_CHECK') AS IF_STOCK_CHECK_CNT        /* MERGE 대상 아님. 실행 전후 같아야 함 */
  FROM DUAL;

-- ==============================================================================================================
-- [O2] 유형별 상세 건수 : 2/4 파일 [M3] 결과와 유형별 비교
-- 확인 : MSSQL 에 있는 유형은 DETAIL_CNT 가 같거나 많음(Oracle 에만 있는 행 포함). IF_STOCK_CHECK 는 비교 대상 아님
-- ==============================================================================================================
SELECT M.LOOKUP_TYPE
     , M.VALID_YN
     , (SELECT COUNT(*)
          FROM SCM_ADM_LOOKUP_MASTER_DETAIL D
         WHERE D.LOOKUP_TYPE = M.LOOKUP_TYPE) AS DETAIL_CNT
     , (SELECT MAX(D.LAST_UPDATE_DATE)
          FROM SCM_ADM_LOOKUP_MASTER_DETAIL D
         WHERE D.LOOKUP_TYPE = M.LOOKUP_TYPE) AS LAST_UPDATE_DATE
  FROM SCM_ADM_LOOKUP_MASTER M
 WHERE M.LOOKUP_GROUP = 'SSP'
 ORDER BY M.LOOKUP_TYPE;

-- ==============================================================================================================
-- [O3] 상세 VALID_YN 값 확인
-- 확인 : Y, N 만 나옴(소문자 y 없음)
-- ==============================================================================================================
SELECT D.VALID_YN
     , COUNT(*) AS CNT
  FROM SCM_ADM_LOOKUP_MASTER_DETAIL D
 WHERE D.LOOKUP_TYPE IN (SELECT G.LOOKUP_TYPE
                           FROM SCM_ADM_LOOKUP_MASTER G
                          WHERE G.LOOKUP_GROUP = 'SSP')
 GROUP BY D.VALID_YN
 ORDER BY D.VALID_YN;

-- ==============================================================================================================
-- [O4] 반영 : 위 결과가 맞으면 아래 COMMIT 실행. 맞지 않으면 ROLLBACK 실행 후 결과 회신
-- COMMIT 뒤 되돌릴 때는 4/4 복원 파일 실행
-- ==============================================================================================================
