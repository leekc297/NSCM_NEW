        const viaPopup = pick(y => y.source === 'ASIS' && y.rule_id === 'G5' && new RegExp(String.raw`DefColumns\.${b}\b`).test(y.condition)).length > 0; // String.raw — 템플릿의 '\b' 는 백스페이스로 해석된다(2026-10-23 오탐)
