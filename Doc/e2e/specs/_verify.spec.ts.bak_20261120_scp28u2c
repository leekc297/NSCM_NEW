        //   행을 고른 뒤 남은 대화상자는 선택 확인일 수 있어 아래 clearDialogs(OK)로 받아들인다(Close 로 닫으면 선택이 취소됨)
        if (nRows === 0 && (await dlg.isVisible().catch(() => false))) {
