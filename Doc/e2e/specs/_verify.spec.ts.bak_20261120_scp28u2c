        // 저장 키 칸 + 필수 안내가 지목한 칸(extraReq)은 G5 근거가 없어도 팝업을 시도 — DMF0005 Team(TeamModal 더블클릭, 2026-10-24)
        const keyCell = (!!KEYSPEC && KEYSPEC.keys.includes(b)) || extraReq.includes(b);
