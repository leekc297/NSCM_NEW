      if (src === '?') { for (const x of xs) put(x.row_id, '판정필요', `원천 컬럼 분기 해석 불가 — 조건 '${x.condition.slice(0, 100)}'`); continue; }
      if (!crBase) { for (const x of xs) put(x.row_id, 'ERROR', '조회 결과 0행 — 연쇄 측정 불가'); continue; }
      const cr = await srcRowOf(src);  // T268
      if (!(await probe.editable(p, cr.row, src))) { for (const x of xs) put(x.row_id, '판정필요', `원천 ${src} ${cr.nm} 편집 불가(신규행·기존행·앞 40행 모두)`); continue; }
      // 원천에 값이 없으면 채운다
      if (!((await probe.value(p, cr.row, src)) ?? '')) { const c = (await probe.candidates(p, cr.row, src)) || []; const v = c.find(t => t.trim()); if (v) { await probe.setByEditor(p, cr.row, src, v); await p.waitForTimeout(600); } }
      // 대상(연쇄로 바뀌는 칸)들: 콤보면 값이 없을 때 후보로 채운다
      const tgts = [...new Set(xs.flatMap(x => x.target.split(',')).filter(t => /^[A-Z0-9_]+$/.test(t) && t !== src))];
      for (const t of tgts) {
        if ((await probe.value(p, cr.row, t)) ?? '') continue;
        const c = await probe.candidates(p, cr.row, t); const v = c && c.find(s2 => s2.trim());
        if (v) { await probe.setByEditor(p, cr.row, t, v); await p.waitForTimeout(400); }
      }
      const before = Object.fromEntries(await Promise.all(tgts.map(async t => [t, (await probe.value(p, cr.row, t)) ?? ''] as const)));
      const pt = await probe.cellCenter(p, cr.row, src);
      if (!pt) { for (const x of xs) put(x.row_id, 'ERROR', `${src} 셀 위치 확인 불가`); continue; }
      await p.mouse.dblclick(pt.x, pt.y); await p.waitForTimeout(500); await p.keyboard.press('Escape'); await p.waitForTimeout(800);
      const after = Object.fromEntries(await Promise.all(tgts.map(async t => [t, (await probe.value(p, cr.row, t)) ?? ''] as const)));
      const srcAfter = (await probe.value(p, cr.row, src)) ?? '';
      const lost = tgts.filter(t => before[t] && before[t] !== after[t]);
      const ev = `${src}='${srcAfter}' 더블클릭+Esc(값 변경 없음) → ${tgts.map(t => `${t} '${before[t]}'→'${after[t]}'`).join(', ')}`;
      for (const x of xs) put(x.row_id, lost.length ? 'FAIL' : (tgts.some(t => before[t]) ? 'PASS' : '판정필요'), lost.length ? `${ev} — 값 변경 없이 연쇄가 발동해 ${lost.join(',')} 초기화` : (tgts.some(t => before[t]) ? ev : `${ev} — 대상 값을 채우지 못해 판정 불가`));
    }

    lap('E5');
    // 후보 밖 값 입력 차단(E5) — 마지막(행 값을 오염시키므로). 콤보 셀에 목록에 없는 값을 넣으면 거부돼야 한다
    for (const x of pick(x => x.source === 'COLUMN' && x.rule_id === 'E5')) {
      const b = binding(x.target);
      const ir = await inRow(b);
      if (!ir) { put(x.row_id, ex || nr ? 'PASS' : 'ERROR', ex || nr ? `${b} 신규행·기존행 모두 편집 불가 — 입력 경로 없음` : '조회 결과 0행 — 목록 밖 값 입력 측정 불가'); continue; }
      if ((await probe.candidates(p, ir.row, b)) == null) { put(x.row_id, '판정필요', `${b} 콤보(dataMap) 없음 — D5 행 참고`); continue; }
      const bad = 'ZZ_E2E_NOT_IN_LIST'; await probe.setByEditor(p, ir.row, b, bad); const got = (await probe.value(p, ir.row, b)) ?? ''; await restore(b, ir);
      put(x.row_id, got === bad ? 'FAIL' : 'PASS', `${b}: 목록 밖 '${bad}' 입력 → 값 '${got}'${got === bad ? ' — 후보 밖 값이 저장 대상' : ''}`);
    }

    lap('E7');
    // 팝업 입력 컬럼 Key-in 검증(E7 · 2026-10-30 SSP45 공통요건 23) — 팝업으로 고르는 셀에 직접 입력이 열리면 잘못된 값은 되돌리거나 검증 메시지로 막아야 한다.
    //   직접 편집이 막혀 있으면(D1 '팝업 입력' 기대 충족) key-in 경로가 없어 대상 없음(PASS). 마지막에 실행(행 값 오염) · 원값 복원 · 저장 안 함
    for (const x of pick(x => x.source === 'COLUMN' && x.rule_id === 'E7')) {
      const b = binding(x.target);
      const ir = await inRow(b);
      if (!ir) { put(x.row_id, 'PASS', `${b}: 신규행·기존행 모두 직접 편집 불가(팝업으로만 입력) — key-in 경로 없음(D1 기대 충족)`); continue; }
      const bad = 'ZZ_E2E_BAD_POPUP_KEY';
      // 2026-11-09 T173(SSP0025 7~9번 허위 FAIL): 기대는 '되돌림 또는 검증 메시지(저장 차단)' 인데 저장을 눌러 보지 않고 '값이 남음' 만으로 FAIL 을 냈다.
      //   AS-IS SSP0025 는 TextCellType(직접 입력 허용) + 저장 시 GetUserIDChk(MSG00251) 로 막는다(SaveData:400-408) · TO-BE 도 저장 시 USER_CHECK 로 막는다.
      //   → 값이 남고 즉시 메시지가 없으면 Save 를 눌러 '저장 시 차단' 을 실측한다. 필수 칸이 채워진 기존행을 우선(신규행은 필수 검사에 먼저 막힘) ·
      //     저장 구간은 조회(READ)·검증(CHECK/CHK/VALID) 요청만 서버로 보내고 나머지 call-proc 은 가로채 서버 미전송(DB 무변경) — 가로챈 요청 = 저장 시도
      const er = ex && ex.row !== ir.row && (await probe.editable(p, ex.row, b)) ? { row: ex.row, where: `기존행 r${ex.row}`, orig: (await probe.value(p, ex.row, b)) ?? '' } : ir;
      const typed = await probe.setByEditor(p, er.row, b, bad);
      await p.waitForTimeout(600);
      const got = (await probe.value(p, er.row, b)) ?? '';
      const alert = await nscm.alertText();
      if (alert) await nscm.clearDialogs();
      if (!typed) { await restore(b, er); put(x.row_id, 'PASS', `${b} ${er.where}: 편집기가 열리지 않음 — key-in 차단`); continue; }
      const kept = got === bad;
      if (!kept || alert) { await restore(b, er); put(x.row_id, 'PASS', `${b} ${er.where}: 잘못된 값 '${bad}' key-in → 셀 값 '${got}'${alert ? ` · 검증 메시지 '${alert.replace(/\s+/g, ' ').slice(0, 80)}'` : ''}${kept ? ' — 메시지로 차단' : ' — 되돌림'}`); continue; }
      let saveNote = 'Save 버튼 없음 — 저장 시 차단 미측정'; let res: 'PASS' | 'FAIL' | '판정필요' = '판정필요';
      if (await nscm.subButtonVisible('Save')) {
        const OK_RE = /[/][^/]*(SEARCH|GET|INIT|LIST|COMBO|CHECK|CHK|VALID)[^/]*[/]call-proc/i; const ANY = /[/]call-proc/; const blocked: string[] = []; const msgs: string[] = [];
        await p.route(ANY, async rt => { const u = rt.request().url(); if (OK_RE.test(u)) { await rt.fallback(); return; } blocked.push((u.match(/[/]([^/]+)[/]call-proc/) || [])[1] || u); await rt.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify({ code: '0', message: '', result: { O_RESULT_CURSOR: [{ CODE: '-1', MSG: '[E7 저장 차단 시험] 서버 미전송' }] } }) }); });
        try {
          await nscm.subButton('Save').click({ timeout: 10_000 }).catch(() => undefined);
          for (let k = 0; k < 6; k++) { await p.waitForTimeout(1_000); const m = await nscm.alertText(); if (!m) { if (k >= 2) break; continue; } msgs.push(m.replace(/\s+/g, ' ').slice(0, 120)); await nscm.closeAlert('ok').catch(() => undefined); }
        } finally { await p.unroute(ANY).catch(() => undefined); await nscm.clearDialogs(); }
        const realMsgs = msgs.filter(m => !/저장하시겠|save\?|진행하시겠/i.test(m));
        if (blocked.length) { res = 'FAIL'; saveNote = `Save → 잘못된 값으로 저장 요청 시도 ${blocked.join(',')}(검사기가 가로채 서버 미전송)${realMsgs.length ? ` · 메시지 '${realMsgs.join(' / ')}'` : ''} — 저장 시에도 차단 안 됨`; }
        else if (realMsgs.some(m => m.includes(bad) || /미등록|등록되지|not registered|invalid|존재하지|없는 사용자/i.test(m))) { res = 'PASS'; saveNote = `Save → 검증 메시지 '${realMsgs.join(' / ')}' · 저장 요청 없음 — 저장 시 차단(AS-IS 저장 시 검증과 같은 방식)`; }
        else if (realMsgs.length) { saveNote = `Save → 다른 검증 메시지에 먼저 막힘 '${realMsgs.join(' / ')}' · 저장 요청 없음 — 이 칸의 잘못된 값 차단 여부 미확인`; }
        else saveNote = 'Save → 메시지·저장 요청 모두 없음 — 차단 여부 미확인';
      }
      await restore(b, er);
      put(x.row_id, res, `${b} ${er.where}: 잘못된 값 '${bad}' key-in → 셀 값 '${got}'(즉시 메시지 없음) · ${saveNote}`);
    }

    async function judgeEdit(x: Record<string, string>, e: boolean | null, where: string, row: number) {
      const b = binding(x.target);
      // 조건부 기대 — 그 행의 실제 값으로 AS-IS guard 를 계산해 확정(계산 불가면 판정필요 유지)
      if (e != null && /^조건부/.test(x.expected)) {
        const ev = await evalCondLock(x.expected, async c => (await probe.value(p, row, c)) ?? '');
        if (ev) { put(x.row_id, e === !ev.locked ? 'PASS' : 'FAIL', `${where} ${b} 편집=${e} · AS-IS ${ev.locked ? '잠금' : '편집 가능'} (행 값 ${ev.by})`); return; }
      }
      // 그리드에 없는 컬럼 = 이 Division·개인화·다른 시트(탭)에서 미표시 — 도구 오류가 아니라 이 조건에서 해당없음(표시 여부는 A5 행이 판정)
      if (e == null) { put(x.row_id, 'NA', `${where} ${b}: 현재 그리드에 없음(Division·개인화·다른 시트) — 표시 여부는 A5 행에서 판정`); return; }
      if (/^잠금 해석 실패/.test(x.expected)) { put(x.row_id, 'ERROR', `[잠금 해석 실패] ${where} ${b} 편집=${e} — AS-IS 잠금 문장을 해석하지 못해 기대값 없음(facts_lockrules 보강 대상): ${x.expected.slice(0, 160)}`); return; }
      // T114: AS-IS 일반 텍스트 셀 + 더블클릭 팝업(보조) — TO-BE 직접 입력+팝업 / 팝업 전용(CR-072) 모두 정상 · 잘못된 값 처리는 E7 · 팝업 동작은 G5
      if (/^팝업 보조 입력/.test(x.expected)) put(x.row_id, 'PASS', `${where} ${b} 직접 편집=${e} — AS-IS 일반 텍스트 셀(직접 입력 + 더블클릭 팝업) · TO-BE ${e ? '직접 입력 + 팝업' : '팝업 전용(CR-072)'} 정상(잘못된 값 처리 E7 · 팝업 동작 G5)`);
      else if (/^팝업 입력/.test(x.expected)) put(x.row_id, e ? 'FAIL' : 'PASS', `${where} ${b} 직접 편집=${e} (AS-IS 직접 입력 차단·더블클릭 팝업으로만 입력 — 팝업 동작은 G5 행)`);
      else if (/^편집 가능/.test(x.expected)) put(x.row_id, e ? 'PASS' : 'FAIL', `${where} ${b} 편집=${e} (AS-IS 편집 가능)`);
      else if (/^잠금/.test(x.expected)) put(x.row_id, e ? 'FAIL' : 'PASS', `${where} ${b} 편집=${e} (AS-IS 잠금)`);
      else put(x.row_id, '판정필요', `${where} ${b} 편집=${e} — 기대: ${x.expected.slice(0, 160)}`);
    }
  });

  test('그리드 더블클릭 팝업 인자(G5) — AS-IS 가 팝업에 넘기는 셀 값이 TO-BE 팝업 조회 요청에 들어가는지', async ({ nscm }) => {
    test.setTimeout(240_000);
    const p = nscm.page;
    const g5 = pick(x => x.source === 'ASIS' && x.rule_id === 'G5' && /DoubleClick/.test(x.asis_ref));
    if (!g5.length) return;
    const actsP = path.join(ROOT, 'Doc', 'asisfacts', 'screens', ID, 'actions.csv');
    const acts = fs.existsSync(actsP) ? parseCsv(fs.readFileSync(actsP, 'utf8')) : [];
    const r = await nscm.openScreen(ID);
    if (!r.authorized) return;
    await nscm.search();
    await probe.waitRows(p);  // 시간 상한 120s(2026-10-29 횟수 상한 → 시간 상한)
    await nscm.clearDialogs();
    const ex = await probe.findRow(p, 'existing');
    for (const x of g5) {
      const col = (/e\.Column\s*==\s*\w+\.GetColumnIndex\(\s*DefColumns\.([A-Z0-9_]+)/.exec(x.condition) || [])[1];
      const method = (/\.(\w*DoubleClick\w*)/.exec(x.asis_ref) || [])[1] || 'CellDoubleClick';
      // 팝업 인자 원천 = 같은 핸들러에서 GetText/GetValue(e.Row, …DefColumns.X) 로 읽는 셀
      const srcCols = [...new Set(acts.filter(a => a.method === method && /Get(Text|Value)\(\s*e\.Row/.test(a.value + a.raw)).flatMap(a => [...(a.value + a.raw).matchAll(/DefColumns\.([A-Z0-9_]+)/g)].map(m => m[1])))].filter(c => c !== col);
      if (!col || !ex) { put(x.row_id, '판정필요', `팝업 셀 해석 불가 또는 조회 0행 (col=${col || '-'})`); continue; }
      const vals = Object.fromEntries(await Promise.all(srcCols.map(async c => [c, (await probe.value(p, ex.row, c)) ?? ''] as const)));
      const before = nscm.calls.length;
      const pt = await probe.cellCenter(p, ex.row, col);
      if (!pt) {
        const all = (await probe.allBindings(p)) || [];
        put(x.row_id, all.includes(col) ? 'ERROR' : 'NA', all.includes(col) ? `${col} 셀 위치 확인 불가(컬럼은 있음 — 도구 확인 필요)` : `팝업 셀 ${col} 이 현재 그리드에 없음(Division·개인화·다른 시트)`); continue;
      }
      await p.mouse.dblclick(pt.x, pt.y); await p.waitForTimeout(2_500);
      const pop = nscm.calls.slice(before).filter(c => !/SAVE|INS|UPD|DEL/i.test(c.btn));
      const body = pop.map(c => c.body || '').join(' ');
      // 값이 그대로 없더라도 같은 이름의 요청 키(FROM_CITY → fromCity)가 비어 있지 않으면 전달된 것으로 본다 — 명칭→코드 환산(TRUCK→TRK) 허용(2026-10-23 오탐)
      const camel = (c: string) => c.toLowerCase().replace(/_([a-z])/g, (_, ch: string) => ch.toUpperCase());
      const keyFilled = (c: string) => [camel(c), camel(c).replace(/Name$/, '')].some(k => new RegExp(`"${k}"\\s*:\\s*"[^"]+"`).test(body));
      const missing = Object.entries(vals).filter(([c, v]) => v && !body.includes(v) && !keyFilled(c)).map(([c, v]) => `${c}='${v}'`);
      const filled = Object.entries(vals).filter(([, v]) => v).length;
      if (!pop.length) put(x.row_id, 'FAIL', `기존행 ${col} 더블클릭 후 팝업 조회 호출 없음 (AS-IS ${x.asis_ref.slice(0, 60)})`);
      // 2026-11-19 SSP0014 미검증 해소(T352): AS-IS 핸들러가 팝업에 넘기는 셀 값이 없으면(GetText/GetValue(e.Row, …) 0개 · SSP0014 UserInfoPopup = SSOUserYN·SingleSelectYn·Language 만) 대조할 인자가 없다 —
      //   종전엔 '원천 셀() 값이 모두 비어' 판정필요(16행). 팝업 조회 호출이 있으면 PASS(셀 값 인자 0개 근거 = 핸들러 원문)
      else if (!srcCols.length) put(x.row_id, 'PASS', `AS-IS ${method} 의 ${col} 분기는 팝업에 셀 값을 넘기지 않음(GetText/GetValue(e.Row, …) 0개 · actions.csv) · TO-BE 팝업 호출 ${pop.map(c => `${c.sheet}/${c.btn}`).join(',')} — 셀 값 인자 대조 대상 없음`);
      else if (!filled) put(x.row_id, '판정필요', `원천 셀(${srcCols.join(',')}) 값이 모두 비어 인자 대조 불가 — 다른 행으로 재확인`);
      else put(x.row_id, missing.length ? 'FAIL' : 'PASS', `팝업 호출 ${pop.map(c => `${c.sheet}/${c.btn}`).join(',')} · AS-IS 인자 원천 ${srcCols.join(',')} · 요청에 없음: ${missing.join(', ') || '없음'} · 요청 ${body.slice(0, 200)}`);
      // 팝업 표준(H6) — 팝업이 열린 상태에서: 버튼 순서 OK→CLOSE · 그리드 No. 컬럼 · 건수 표시 (확정 규칙 CR-005 · C8)
      for (const h of pick(y => y.source === 'ASIS' && y.rule_id === 'H6' && y.target === x.target)) {
        if (!pop.length) { put(h.row_id, '판정필요', '팝업이 열리지 않아 표준 확인 불가(G5 행 참고)'); continue; }
        const d = await p.evaluate(() => {
          const dlg = [...document.querySelectorAll('[role="dialog"], .MuiDialog-root')].filter(e => (e as HTMLElement).getBoundingClientRect().height > 0).pop() as HTMLElement | undefined;
          if (!dlg) return null;
          const btns = [...dlg.querySelectorAll('button')].map(b => (b.innerText || b.getAttribute('aria-label') || '').trim()).filter(Boolean);
          // No. 는 좌상단 코너(.wj-topleft, 행 머리글 영역)에 있을 수 있다 — 컬럼 헤더만 보면 'Route Id' 를 첫 컬럼으로 오인(2026-10-23 H6 오탐 3건)
          const corner = [...dlg.querySelectorAll('.wj-topleft .wj-cell')].map(c => (c as HTMLElement).innerText.trim()).filter(Boolean);
          const hdr = [...corner, ...[...dlg.querySelectorAll('.wj-colheaders .wj-cell')].map(c => (c as HTMLElement).innerText.trim()).filter(Boolean)];
          const text = dlg.innerText || '';
          return { btns, firstHdr: hdr[0] || '', count: /(Total|총)\s*[:：]?\s*[\d,]+|[\d,]+\s*건/i.test(text) };
        });
