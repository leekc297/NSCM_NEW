      for (const v of [...groups.values(), ...cands.filter(v => ![...groups.values()].includes(v))].slice(0, Math.max(5, Math.min(groups.size, 10)))) {
        if (!(await probe.setByEditor(p, cRow.row, src, v))) continue; await p.waitForTimeout(500);
