  for (const [k, v] of Object.entries(DYN.popupFields)) prev.popupFields[k] = v; prev.at = new Date().toISOString(); fs.writeFileSync(p0, JSON.stringify(prev, null, 1), 'utf8'); } catch { /* 동적 facts 는 보조 산출물 */ } };
