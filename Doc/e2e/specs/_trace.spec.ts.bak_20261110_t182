      const tgt = c.name || ''; const src = (c.src || []).find(s => s !== tgt) || '';
      if (!src) { put(x.row_id, '판정필요', `${tgt} 연쇄 원천 해석 불가 — AS-IS ${(c.raws || [])[0] || ''}`); continue; }
      if (!(await probe.editable(p, cRow.row, src))) { put(x.row_id, '판정필요', `원천 ${src} ${crNm} 편집 불가`); continue; }
