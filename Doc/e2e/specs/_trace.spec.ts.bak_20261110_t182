    };
    for (const { x, c } of cols.filter(t => t.x.rule_id === 'D1')) {
      const b = c.name || ''; const ee = c.editExpect;
      if (!ee) { put(x.row_id, '판정필요', `${b} AS-IS 편집 기대(edit_expect) 없음`); continue; }
      if (!ex) { put(x.row_id, 'ERROR', `조회 결과 0행 — 기존행 프로브 불가`); continue; }
