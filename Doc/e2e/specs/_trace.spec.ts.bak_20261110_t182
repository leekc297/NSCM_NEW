          // AS-IS 문장 행(E4 errCode 99010~99040 분기)도 같은 실측으로 판정 — W4 E4 의 정적 FAIL(대조표 미구현 가정)을 덮는다
          for (const x of all.filter(r => r.source === 'ASIS' && r.rule_id === 'E4' && /990[1-4]0|errCode/.test(`${r.target} ${r.expected} ${r.asis_ref || ''} ${r.condition || ''}`))) put(x.row_id, hi.length ? 'PASS' : 'FAIL', `저장 실패(중복) 응답 처리 실측(W9): ${saveDesc} → 신규행 셀 색 변화 ${hi.length ? hi.map(c => c.b).join(', ') + ' (문제 행·셀 강조 구현됨)' : '없음(강조 미구현)'} — AS-IS 는 errCode 99010/99020/99030/99040 별로 문제 행·셀을 InvalidColor 로 표시`);
          const specific = /중복|duplicate|기간|period|overlap|priority|우선/i.test(msg);
          putAll(GD2, specific ? 'PASS' : 'FAIL', `${saveDesc} — AS-IS 는 오류코드별 구체 메시지(99010 BOD 중복 · 99020 Priority 중복 · 99030/99040 기간 중첩)를 띄움${specific ? ' → 메시지가 원인을 말함(일치)' : ' → 공용 메시지만 표시, 어떤 중복·중첩인지 알 수 없음(미구현)'}`);
        }
        await nscm.clearDialogs();
      }
    }
  });
});
