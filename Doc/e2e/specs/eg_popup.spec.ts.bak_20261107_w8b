// ─── 팝업 열기(트리거별) ───
type Opened = { dlg: Locator | null; how: string; why: string; condIdx?: number; label?: string; row?: number };
const TAG = 'egp';
function condLabels(c: Call): string[] {
  const ctl = c.trigger.input || c.trigger.control;
  const planF = (PLAN?.fields || []).find(f => (f.asis || '').toLowerCase() === (ctl || '').toLowerCase());
  const suf = (ctl || '').replace(/^(btn|txt|clb|cbo)/i, '');
  // 팝업 클래스 이름 토큰(접두 화면 ID·Popup 접미 제거) — AS-IS 버튼 문구가 비어 있는 버튼(btnSPVer)을 TO-BE 조회조건 칸에 대응시키는 보조 후보
  const clsToks = c.cls.replace(/^[A-Z]+\d+_/, '').replace(/Popup(Ex)?$/i, '').replace(/([a-z])([A-Z])/g, '$1 $2').split(/[\s_]+/).filter(t => t.length >= 4 && !/^(United|Form|Input|Select|Multi|Division|Divis|Set)$/i.test(t));
  return [...(planF?.labels || []), planF?.label || '', c.trigger.cond_label || '', suf, ...clsToks].filter(Boolean);
}
async function openPopup(nscm: Nscm, c: Call, state: { popup: boolean }): Promise<Opened> {
  const p = nscm.page; const k = c.trigger.kind;
  const before = await dialogCount(p);
  state.popup = true;
  const viaCond = async (): Promise<Opened | null> => {
    const pc = await mainPopupConds(nscm); const want = condLabels(c).map(nrm);
    let hit = pc.find(x => want.includes(nrm(x.label)));
    if (!hit) hit = pc.find(x => want.some(w => w.length >= 4 && (nrm(x.label).includes(w) || w.includes(nrm(x.label)))));
    if (!hit) return null;
    const t = await mainPopTrigger(p, hit.idx);
    await t.click({ timeout: 5_000, force: true }).catch(() => undefined);
    return { dlg: await waitPopup(p, TAG, before), how: `조건 '${hit.label}' 아이콘`, why: '', condIdx: hit.idx, label: hit.label };
  };
  if (k === 'COND') {
    const r = await viaCond(); if (r) return r;
    const pc = await mainPopupConds(nscm);
    return { dlg: null, how: 'COND', why: `조회영역 팝업형 칸 [${pc.map(x => x.label).join(', ')}] 중 라벨 [${condLabels(c).join(', ')}] 없음` };
  }
  if (k === 'BTN' || k === 'INSERT') {
    const names = k === 'INSERT' ? ['Insert'] : [c.trigger.button_text || '', (PLAN?.buttons || []).find(b => (b.asis || '').toLowerCase() === c.trigger.control.toLowerCase())?.label || '', c.trigger.control.replace(/^btn/i, '')].filter(Boolean);
    for (const n of names) {
      const esc = n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&').replace(/\s+/g, '\\s*');
      const b = await nscm.visibleFirst(p.getByRole('button', { name: new RegExp(`^${esc}(\\(F\\d+\\))?$`, 'i') })).catch(() => null);
      if (b) { await b.click({ timeout: 5_000 }).catch(() => undefined); return { dlg: await waitPopup(p, TAG, before), how: `버튼 '${n}'`, why: '' }; }
    }
    // AS-IS 버튼이 TO-BE 에서 조회조건 칸 아이콘으로 옮겨진 경우
    if (k === 'BTN') { const r = await viaCond(); if (r) return { ...r, how: `(AS-IS 버튼 → TO-BE 칸) ${r.how}` }; }
    const all = await nscm.page.getByRole('button').allInnerTexts().catch(() => [] as string[]);
    return { dlg: null, how: 'BTN', why: `버튼 [${names.join('/')}] 비노출 — 화면 버튼 [${all.map(t => t.trim()).filter(Boolean).slice(0, 30).join(', ')}]` };
  }
  if (k === 'CELL') {
    const col = c.trigger.column; if (!col) return { dlg: null, how: 'CELL', why: `AS-IS 팝업 셀 컬럼 해석 불가(guard: ${c.trigger.guard.slice(0, 120)})` };
    if (/sub/i.test(c.trigger.control)) return { dlg: null, how: 'CELL', why: `AS-IS 보조 그리드(${c.trigger.control}) 팝업 — 보조 그리드 프로브 경로 미구현` };
    const all = (await probe.allBindings(p)) || [];
    if (!all.includes(col)) return { dlg: null, how: 'CELL', why: `컬럼 ${col} 이 현재 그리드에 없음(바인딩 ${all.length}개 — Division·개인화·시트 차이 가능)` };
    const ex = await probe.findRow(p, 'existing');
    if (!ex) return { dlg: null, how: 'CELL', why: '조회 0행 — 셀 더블클릭 불가' };
    const pt = await probe.cellCenter(p, ex.row, col);
    if (!pt) return { dlg: null, how: 'CELL', why: `${col} 셀 위치 확인 불가` };
    await p.mouse.dblclick(pt.x, pt.y);
    let d = await waitPopup(p, TAG, before, 6_000);
    // 기존행에서 안 열리면 신규행으로(AS-IS 가드가 신규행 전용인 경우)
    if (!d && await nscm.subButtonVisible('Insert').catch(() => false)) {
      await nscm.subButton('Insert').click({ timeout: 5_000 }).catch(() => undefined); await p.waitForTimeout(800); await nscm.clearDialogs().catch(() => undefined);
      const nr = await probe.findRow(p, 'new');
      if (nr) { const q = await probe.cellCenter(p, nr.row, col); if (q) { await p.mouse.dblclick(q.x, q.y); d = await waitPopup(p, TAG, await dialogCount(p) - 0 > before ? before : before, 6_000); return { dlg: d, how: `신규행 ${col} 더블클릭`, why: '', row: nr.row }; } }
    }
    return { dlg: d, how: `기존행 ${col} 더블클릭`, why: '', row: ex.row };
  }
  return { dlg: null, how: k, why: `AS-IS 메서드 ${c.method} — 트리거 분류 불가(이름 관례 밖)` };
}

const DIVCOL: { col: string; via: string; has: boolean; rows: number }[] = [];
async function withLimit<T>(pr: Promise<T>, ms: number, dflt: T): Promise<T> { return Promise.race([pr, new Promise<T>(res => setTimeout(() => res(dflt), ms))]); }

/** 빈 필수 칸 — 조회가 안 되는 화면(필수 팝업 조건 미입력)은 팝업형 칸을 첫 행으로 채운다(실제 화면 후보만) */
async function fillPopupConds(nscm: Nscm): Promise<string> {
  const p = nscm.page; const pc = await mainPopupConds(nscm); const done: string[] = [];
  for (const x of pc.filter(q => !q.value)) {
    const before = await dialogCount(p); const t = await mainPopTrigger(p, x.idx);
    await t.click({ timeout: 5_000, force: true }).catch(() => undefined);
    const d = await waitPopup(p, TAG, before, 6_000); if (!d) continue;
    await p.waitForTimeout(1_500); if ((await popRowCount(p, TAG)) <= 0) { const b = d.getByRole('button', { name: /^(조회|Search)(\(F5\))?$/i }).first(); if (await b.isVisible().catch(() => false)) { await b.click().catch(() => undefined); await p.waitForTimeout(4_000); } }
    if ((await popRowCount(p, TAG)) > 0) { await pickRows(p, d, TAG, [0], 'ok').catch(() => undefined); done.push(x.label); }
    if (await d.isVisible().catch(() => false)) await closePopup(p, d).catch(() => false);
    await nscm.clearDialogs().catch(() => undefined);
  }
  return done.join(',');
}

async function prepare(nscm: Nscm, c: Call): Promise<{ ok: boolean; why: string; rows: number; via: string }> {
  const r = await nscm.openScreen(ID);
  if (!r.authorized) return { ok: false, why: '화면 권한 없음', rows: -1, via: '' };
  if (r.notFound) return { ok: false, why: '화면 없음(Not Found)', rows: -1, via: '' };
  await nscm.page.waitForTimeout(1_200);
  await nscm.clearDialogs().catch(() => undefined);
  let rows = -1; let via = '';
  // 셀 팝업 컬럼이 Division 한정(메타 DIVISION_ID)이면 그 Division 으로 전환 후 조회 — 실제 화면 후보만
  if (c.trigger.kind === 'CELL' && c.trigger.column) {
    const divs = [...new Set((META?.columns || []).filter(x => x.COLUMN_NAME === c.trigger.column).flatMap(x => String(x.DIVISION_ID || '').split(/[,|;\s]+/)).filter(x => x && !/^all$/i.test(x)))];
    const cur = await mainDivision(nscm);
    if (divs.length && cur && !divs.some(d => d === cur || cur.startsWith(d))) { const hit: string[] = []; for (const d of divs.slice(0, 4)) { if (await nscm.setDivision(d).catch(() => false)) { hit.push(d); via = `Division ${cur}→${d}(컬럼 ${c.trigger.column} 메타 DIVISION_ID [${divs.join(',')}])`; break; } } if (!hit.length) via = `컬럼 ${c.trigger.column} 메타 Division [${divs.join(',')}] 전환 실패(현재 ${cur})`; await nscm.page.waitForTimeout(600); }
  }
  if (c.trigger.kind === 'CELL' || c.trigger.kind === 'INSERT') {
    await nscm.search({ timeout: 60_000 }).catch(() => undefined); await probe.waitRows(nscm.page, 30_000).catch(() => undefined); await nscm.clearDialogs().catch(() => undefined);
    rows = await probe.rowCount(nscm.page);
    if (rows <= 0) { const f = await withLimit(fillPopupConds(nscm), 90_000, ''); if (f) { via = `빈 팝업 칸 채움 ${f}`; await nscm.search({ timeout: 60_000 }).catch(() => undefined); await probe.waitRows(nscm.page, 30_000).catch(() => undefined); await nscm.clearDialogs().catch(() => undefined); rows = await probe.rowCount(nscm.page); } }
    if (rows <= 0) { const e = await withLimit(ensureRows(nscm, 3, `eg_${ID}`), 150_000, { rows: 0, via: '대안 조회 시간 초과' }).catch(() => ({ rows: 0, via: '실패' })); rows = e.rows; via = (via ? via + ' · ' : '') + e.via; }
    // Division 전환 뒤 컬럼 표시(문서 GAP-104 EG101)
    if (c.trigger.kind === 'CELL' && via.includes('Division ') && via.includes('→')) { const has = ((await probe.allBindings(nscm.page)) || []).includes(c.trigger.column); DIVCOL.push({ col: c.trigger.column, via, has, rows }); }
  }
  return { ok: true, why: '', rows, via };
}

const OK_RX = /^(확인|OK|Confirm|Select|선택|Apply|적용)$/i; const CL_RX = /^(Close|닫기|Cancel|취소)$/i;

// ─── 측정 묶음: 표준(제목·버튼·No.·건수) ───
// AS-IS 트리거 버튼 → TO-BE 공용 모달 컴포넌트(tools/Harness/rules/tobe_catalog.csv asis_types 'button:^btnX$') — 2026-11-06
const CATALOG: { name: string; rx: RegExp }[] = (() => { try { return parseCsv(fs.readFileSync(path.join(ROOT, 'tools', 'Harness', 'rules', 'tobe_catalog.csv'), 'utf8').replace(/^\uFEFF/, '')).flatMap(r => String(r.asis_types || '').split(/[|;]/).map(t => t.trim()).filter(t => /^button:/.test(t)).map(t => { try { return { name: r.name, rx: new RegExp(t.replace(/^button:/, ''), 'i') }; } catch { return null; } }).filter((x): x is { name: string; rx: RegExp } => !!x)); } catch { return []; } })();
