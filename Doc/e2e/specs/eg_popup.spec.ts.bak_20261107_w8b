const META: { columns: MetaCol[]; measures: MetaMea[]; titleset: { USER_ID: string; SHEET_NAME: string; N: number }[]; no_personal_accounts: string[] } | null = (() => { try { return JSON.parse(fs.readFileSync(path.join(ROOT, 'Doc', 'verify', '_parallel', 'E02', 'facts', `${ID}.meta.json`), 'utf8')); } catch { return null; } })();
const divIn = (list: string, d: string) => { const v = String(list || '').trim(); if (!v || /^all$/i.test(v)) return true; return v.split(/[,|;\s]+/).filter(Boolean).some(x => x === d || d.startsWith(x)); };

// ─── 셀 팝업 컬럼: 직접 편집·Delete·붙여넣기·Key-in 잘못된 값 ───
async function runCell(nscm: Nscm, net: PopNet, state: { popup: boolean }, i: number, c: Call) {
  const put = makePut(i, c); const p = nscm.page; const col = c.trigger.column;
  if (c.trigger.kind !== 'CELL' || !col) { put('CELL', ['EG104', 'EG176', 'EG137'], 'NA', '셀 팝업 컬럼', `트리거 ${c.trigger.kind}`, ''); return; }
  if (/sub/i.test(c.trigger.control)) { put('CELL', ['EG104', 'EG176', 'EG137'], 'ERROR', '셀 팝업 컬럼', `보조 그리드(${c.trigger.control}) 경로 미구현`, ''); return; }
  const pr = await prepare(nscm, c);
  if (!pr.ok || pr.rows <= 0) { put('CELL', ['EG104', 'EG176', 'EG137'], 'ERROR', '셀 팝업 컬럼', pr.ok ? `조회 0행 · ${pr.via}` : pr.why, ''); return; }
  const all = (await probe.allBindings(p)) || [];
  if (!all.includes(col)) { put('CELL', ['EG104', 'EG176', 'EG137'], 'NA', '셀 팝업 컬럼', `${col} 그리드에 없음(Division·개인화)`, ''); return; }
  const meta = (META?.columns || []).filter(x => x.COLUMN_NAME === col); const ctlTypes = [...new Set(meta.map(x => x.CELL_CONTROL_OBJECT_TYPE_CODE))];
  const isText = ctlTypes.some(t => /FPTextModal/i.test(t)); const isModal = ctlTypes.some(t => /FPModal/i.test(t));
  const ex = await probe.findRow(p, 'existing'); if (!ex) { put('CELL', ['EG104'], 'ERROR', '셀 팝업 컬럼', '기존행 없음', ''); return; }
  // 편집 가능한 행(행 조건 잠금 제외) — 없으면 기존행 그대로
  const er = await probe.firstEditableRow(p, col, 60, [], 3_000).catch(() => -1); const row = er >= 0 ? er : ex.row;
  const edit = await probe.editable(p, row, col);
  // 메타 대조
  put('CELL_TYPE', ['EG137'], !ctlTypes.length ? 'ERROR' : isText || isModal ? 'PASS' : '판정필요', `AS-IS 더블클릭 팝업 컬럼(${c.asis_ref}) → 메타 FPModal/FPTextModal`, `${col} 메타 입력 방식 [${ctlTypes.join(',') || '메타 행 없음'}] · 직접 편집 ${edit} (행 ${row})`, '문서 GAPPI-1·GAPPI-16 · ' + c.asis_ref);
  if (isModal && !isText) put('CELL_NOEDIT', ['EG104'], edit ? 'FAIL' : 'PASS', '팝업 전용 컬럼 — 직접 편집 불가', `editor 열림 ${edit}`, '문서 DM-18 · ' + c.asis_ref);
  if (isText) put('CELL_KEYIN', ['EG137'], edit ? 'PASS' : '판정필요', 'FPTextModal = 키인 가능 + 팝업', `editor 열림 ${edit}(행 ${row}) — 행 조건 잠금이면 다른 행 필요`, '문서 GAPPI-16');
  // 팝업 아이콘
  const cls = await probe.cellClasses(p, row, col).catch(() => '');
  const icon = await p.evaluate(`(() => { const c = ${probe.CTL_SRC}; const col = c && c.columns.getColumn(${JSON.stringify(col)}); const el = col && c.cells.getCellElement(${row}, col.index); return el ? !!el.querySelector('svg, button, [class*="icon"], [class*="Icon"]') : null; })()`).catch(() => null) as boolean | null;
  put('CELL_ICON', ['EG137'], icon === null ? 'ERROR' : icon ? 'PASS' : '판정필요', '팝업 셀 아이콘 표시', `아이콘 ${icon} · 셀 클래스 '${String(cls).slice(0, 80)}' · 메타 [${ctlTypes.join(',')}]`, '');
  // Delete — 값 삭제 허용(문서 DM-18)
  const v0 = (await probe.value(p, row, col)) ?? '';
  const pt = await probe.cellCenter(p, row, col);
  if (pt && v0) {
    await p.mouse.click(pt.x, pt.y); await p.waitForTimeout(120); await p.keyboard.press('Delete'); await p.waitForTimeout(350); await nscm.clearDialogs().catch(() => undefined);
    const v1 = (await probe.value(p, row, col)) ?? '';
    put('CELL_DELETE', ['EG104'], isModal ? (v1 === '' ? 'PASS' : '판정필요') : 'NA', 'Delete 키 값 삭제 허용', `'${v0}'→'${v1}'`, '문서 DM-18');
  } else put('CELL_DELETE', ['EG104'], 'NA', 'Delete 값 삭제', v0 ? '셀 위치 불명' : `행 ${row} 값 없음`, '');
  // 붙여넣기 — 다른 행 값 복사 → 코드 컬럼 동반
  const allVals = (await probe.columnValues(p, col)) || []; const srcIdx = allVals.findIndex((v, n) => v && n !== row && v !== v0);
  if (pt && srcIdx >= 0) {
    await p.context().grantPermissions(['clipboard-read', 'clipboard-write']).catch(() => undefined);
    const src = await probe.cellCenter(p, srcIdx, col);
    if (src) {
      await p.mouse.click(src.x, src.y); await p.waitForTimeout(100); await p.keyboard.press('Control+c'); await p.waitForTimeout(250);
      const srcItem = (await probe.rowItem(p, srcIdx)) || {};
      const pt2 = await probe.cellCenter(p, row, col);
      if (pt2) { await p.mouse.click(pt2.x, pt2.y); await p.waitForTimeout(100); }
      const b4 = (await probe.rowItem(p, row)) || {};
      await p.keyboard.press('Control+v'); await p.waitForTimeout(700); await nscm.clearDialogs().catch(() => undefined);
      const af = (await probe.rowItem(p, row)) || {};
      const changed = Object.keys(af).filter(k => af[k] !== b4[k] && !/CRUD|_SEL|STATUS/i.test(k));
      const matched = changed.filter(k => af[k] === srcItem[k]);
      put('CELL_PASTE', ['EG104', 'EG159'], !isModal && !isText ? 'NA' : (af[col] ?? '') === srcItem[col] ? (changed.length >= 1 ? 'PASS' : '판정필요') : '판정필요', `붙여넣기 → ${col} = 원천값 · 코드 컬럼 동반(문서 DM-18)`, `값 '${b4[col]}'→'${af[col]}' (원천 '${srcItem[col]}') · 바뀐 컬럼 [${changed.slice(0, 8).join(',')}] · 원천과 같은 [${matched.slice(0, 8).join(',')}]`, '문서 DM-18');
    }
  } else put('CELL_PASTE', ['EG104', 'EG159'], 'NA', '붙여넣기', '다른 값 행 없음', '');
  // Key-in 잘못된 값(FPTextModal) — 되돌림/메시지/저장 본문
  if (isText && edit) {
    const bad = 'ZZ_E2E_BAD_KEY';
    const ok = await probe.setByEditor(p, row, col, bad); await p.waitForTimeout(800); await p.keyboard.press('Tab').catch(() => undefined); await p.waitForTimeout(500);
    const msg = await nscm.alertText().catch(() => ''); await nscm.clearDialogs().catch(() => undefined);
    const after = (await probe.value(p, row, col)) ?? '';
    let bodyHasBad = false; let saveNote = ''; let serverRejected = false;
    if (after === bad && await nscm.subButtonVisible('Save').catch(() => false)) {
      const m1 = net.mark(); await nscm.subButton('Save').click({ timeout: 5_000 }).catch(() => undefined); await p.waitForTimeout(1_200);
      const yes = p.getByRole('button', { name: /^(확인|OK|Yes|예|Confirm)$/i }).last(); if (await yes.isVisible().catch(() => false)) await yes.click({ timeout: 2_000 }).catch(() => undefined);
      await settle(p, net, m1, 15_000); const sv = net.since(m1).filter(r => /SAVE|INS|UPD/i.test(r.btn + r.url)); bodyHasBad = sv.some(r => r.body.includes(bad));
      const alertAfter = (await nscm.alertText().catch(() => '')) || '';
      // 서버(SP) 검증으로 거부된 저장 — 요청은 갔지만 오류 응답/오류 알림이 있고 성공 알림이 아니면 '잘못된 값이 저장되지 않음'(AS-IS 는 FE 사전검증 MSG00458 · 2026-11-06 SCP0127 E7 보완 = PKG SAVE 품목 검증)
      serverRejected = bodyHasBad && (sv.some(r => r.status >= 400) || (!!alertAfter && !/(저장(이|되|을)|success|완료|saved)/i.test(alertAfter)));
      saveNote = ` · Save 요청 ${sv.length}건(응답 ${sv.map(r => r.status).join(',') || '-'}) · 잘못된 값 포함 ${bodyHasBad} · 알림 '${alertAfter.slice(0, 80)}'${serverRejected ? ' · 서버 검증 거부(저장 안 됨)' : ''}`; await nscm.clearDialogs().catch(() => undefined);
    }
    put('CELL_BADKEY', ['EG176'], !ok ? 'ERROR' : bodyHasBad && !serverRejected ? 'FAIL' : after === bad && !msg && !serverRejected ? '판정필요' : 'PASS', '팝업 셀 Key-in 잘못된 값 → 되돌림/메시지 · 저장 본문에 안 실림(서버 검증 거부 포함)', `입력 '${bad}' → 값 '${after}' · 메시지 '${msg.slice(0, 80)}'${saveNote}`, '문서 SSP45REQ-23');
  } else put('CELL_BADKEY', ['EG176'], 'NA', 'Key-in 잘못된 값', `FPTextModal 아님/편집 불가 (메타 ${ctlTypes.join(',')} · 편집 ${edit})`, '');
  void state;
}

// ─── Insert: 팝업 선행 N행 / 읽기 전용 무동작 — 문서 GAP-468·GAP-477 ───
async function runInsert(nscm: Nscm, net: PopNet, state: { popup: boolean }, i: number, c: Call) {
  const put = makePut(i, c); const p = nscm.page; const r = await nscm.openScreen(ID); if (!r.authorized) { put('INSERT', ['EG125', 'EG444'], 'ERROR', 'Insert', '화면 권한 없음', ''); return; }
  await nscm.search({ timeout: 60_000 }).catch(() => undefined); await probe.waitRows(p, 30_000).catch(() => undefined); await nscm.clearDialogs().catch(() => undefined);
  const btns = p.getByRole('button', { name: /^Insert(\(F\d+\))?$/i }); const nb = await btns.count().catch(() => 0);
  const gridRows = () => p.evaluate(() => { const o: number[] = []; for (const el of Array.from(document.querySelectorAll('.wj-flexgrid')) as HTMLElement[]) { if (el.offsetParent === null || el.closest('.MuiDialog-root, [role="dialog"]')) continue; const e = el as unknown as Record<string, { rows?: { length: number } }>; let k = e['$WJ-CTRL']; if (!k || !k.rows) for (const q of Object.getOwnPropertyNames(el)) { const v = (el as unknown as Record<string, { rows?: { length: number }; columns?: unknown }>)[q]; if (v && typeof v === 'object' && v.columns) { k = v; break; } } o.push(k && k.rows ? k.rows.length : -1); } return o; }).catch(() => [] as number[]);
  if (!nb) { put('INSERT', ['EG125', 'EG444'], 'NA', 'Insert 버튼', '화면에 Insert 버튼 없음', ''); return; }
