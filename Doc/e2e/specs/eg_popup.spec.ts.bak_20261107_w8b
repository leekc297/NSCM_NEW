  if (main.length < 2) { put('PERIOD', ['EG287', 'EG431'], '판정필요', '팝업 Period = 메인 Period', `메인 기간 칸 못 읽음 · 팝업 [${pc.values.join(' ~ ')}]`, ''); return; }
  const mon = (v: string) => (v.replace(/\D/g, '').slice(0, 6));
  const same = mon(pc.values[0] || '') === mon(main[0]) && mon(pc.values[1] || '') === mon(main[1]);
  const passed = c.period_args.length > 0 || c.args.some(a => a.kind === 'CONTROL' && /date|period|from|to|month/i.test(a.arg));
  const day = (v: string) => v.replace(/\D/g, '').slice(6, 8);
  const lastDay = (v: string) => { const d = v.replace(/\D/g, ''); const y = +d.slice(0, 4), mm = +d.slice(4, 6); return new Date(y, mm, 0).getDate(); };
  const dayNote = day(pc.values[0] || '') ? `팝업 시작일 ${day(pc.values[0])} · 종료일 ${day(pc.values[1] || '')}(말일 ${lastDay(pc.values[1] || '')})` : '일 없음';
  put('PERIOD', ['EG287', 'EG431'], same ? 'PASS' : passed ? 'FAIL' : '판정필요', `팝업 Period 월 = 메인 Period 월(${main.join(' ~ ')})`, `팝업 [${pc.values.join(' ~ ')}] · ${dayNote} · AS-IS 기간 인자 [${c.period_args.join(',')}]`, passed ? `${c.asis_ref}` : '문서 DM-88·DM-223');
}

