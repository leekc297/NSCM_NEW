      const i = it.children[1].querySelector('input') as HTMLInputElement | null; const chips = Array.from(it.querySelectorAll('.MuiChip-label')).map(e => (e as HTMLElement).innerText);
      return (i && i.value) || chips.join(',') || (it.children[1] as HTMLElement).innerText || '';
    }
    return '';
  }).catch(() => '');
  if (ui) return (ui.trim().split(/\s+/)[0] || '');
  const b = [...nscm.calls].reverse().find(c => /SEARCH/i.test(c.btn) && /division/i.test(c.body || ''))?.body || '';
