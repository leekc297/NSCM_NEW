async function readMainDivText(nscm: Nscm): Promise<string> {
  return nscm.page.evaluate(() => { for (const it of Array.from(document.querySelectorAll('[class*="_formItem_"], [class*="formItem"]')) as HTMLElement[]) { if (it.offsetParent === null || it.closest('[role="dialog"], .MuiDialog-root, .wj-flexgrid') || it.children.length < 2) continue; const lb = ((it.firstElementChild as HTMLElement).innerText || '').trim().toLowerCase().replace(/[*. ]/g, ''); if (lb !== 'div' && lb !== 'division') continue; const i = it.children[1].querySelector('input') as HTMLInputElement | null; return `${(i && i.value) || ''} ${(it.children[1] as HTMLElement).innerText || ''}`; } return ''; }).catch(() => '');
