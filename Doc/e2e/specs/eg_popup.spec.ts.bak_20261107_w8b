async function mainDivision(nscm: Nscm): Promise<string> {
  const ui = await nscm.page.evaluate(() => {
    for (const it of Array.from(document.querySelectorAll('[class*="_formItem_"], [class*="formItem"]')) as HTMLElement[]) {
