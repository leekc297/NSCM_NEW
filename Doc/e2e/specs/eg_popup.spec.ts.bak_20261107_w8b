  const put = makePut(i, c); const p = nscm.page; const pr = await prepare(nscm, c);
  if (!pr.ok) { put('TEXT_PASS', ['EG288', 'EG137'], 'ERROR', '메인 텍스트 전달', pr.why, ''); return; }
  if (c.trigger.kind !== 'COND') { put('TEXT_PASS', ['EG288'], 'NA', '메인 텍스트 → 팝업 조건', `트리거 ${c.trigger.kind}`, ''); return; }
  const m0 = net.mark(); const o = await openPopup(nscm, c, state);
  if (!o.dlg || o.condIdx == null) { put('TEXT_PASS', ['EG288', 'EG137'], 'ERROR', '메인 텍스트 전달', `${o.how}: ${o.why || '안 열림'}`, ''); return; }
  await settle(p, net, m0, 30_000); if ((await waitPopRows(p, TAG, 4_000)) <= 0) { await popSearch(p, o.dlg, net, 60_000); await waitPopRows(p, TAG, 5_000); }
  const d = await popDisplay(p, TAG, 200); await closePopup(p, o.dlg).catch(() => false); await nscm.clearDialogs().catch(() => undefined);
  const inp = mainPopRoot(p, o.condIdx).locator('input:not([type="hidden"]), textarea').first();
  const editable = await inp.isEditable().catch(() => false);
  put('TEXT_INPUT', ['EG137'], editable ? 'PASS' : 'FAIL', '텍스트 입력 + 아이콘 팝업 공통 입력 칸', `입력 가능 ${editable} · 칸 '${o.label}'`, '문서 GAPPI-1·GAPPI-16');
  if (!d || !d.rows.length) { put('TEXT_PASS', ['EG288'], '판정필요', '메인 텍스트 전달', '팝업 행 없음 — 입력값 후보 없음', ''); return; }
  const lab = nrm(o.label || ''); let ci = d.headers.findIndex(h => nrm(h) === lab); if (ci < 0) ci = d.headers.findIndex(h => lab && (nrm(h).includes(lab) || lab.includes(nrm(h)))); if (ci < 0) ci = 0;
  const v = d.rows.map(r => r[ci]).find(x => x && x.length >= 2) || '';
  if (!v) { put('TEXT_PASS', ['EG288'], '판정필요', '메인 텍스트 전달', `컬럼 '${d.headers[ci]}' 값 없음`, ''); return; }
  await inp.fill(v).catch(() => undefined);
  const m1 = net.mark(); const t = await mainPopTrigger(p, o.condIdx); const before = await dialogCount(p);
  state.popup = true; await t.click({ timeout: 5_000, force: true }).catch(() => undefined);
  const d2 = await waitPopup(p, TAG, before);
  if (!d2) { put('TEXT_PASS', ['EG288'], 'ERROR', '메인 텍스트 전달', '재오픈 실패', ''); return; }
  await settle(p, net, m1, 30_000); await p.waitForTimeout(300);
  const m2 = await measure(p, TAG); const inPop = (m2?.conds || []).filter(x => x.values.some(y => y.includes(v))).map(x => x.label);
  const recs = net.since(m1); const carried = recs.some(r => r.body.includes(v)); const n = await popRowCount(p, TAG);
  const d3 = n > 0 ? await popDisplay(p, TAG, 200) : null; const allHas = d3 ? d3.rows.every(r => r.some(x => x.includes(v))) : false;
  const asisPass = c.args.some(a => a.kind === 'CONTROL' && new RegExp((c.trigger.input || '').replace(/^txt/i, ''), 'i').test(a.arg + a.param));
  const ok = (inPop.length || carried) && (n === 0 || allHas || carried);
  put('TEXT_PASS', ['EG288'], ok ? 'PASS' : asisPass ? 'FAIL' : '판정필요', `메인 입력 '${v}' → 팝업 조건·요청 전달 · 그 기준 조회`, `팝업 조건 표시 [${inPop.join(',')}] · 요청 포함 ${carried} · 행 ${n} · 전행 포함 ${allHas} · 본문 ${recs.map(r => r.body).join(' ').slice(0, 200)} · AS-IS 인자 [${c.args.map(a => `${a.param}=${a.kind}`).join(',')}]`, asisPass ? c.asis_ref : '문서 DM-C5·SSP45REQ-6');
  state.popup = false; await closePopup(p, d2).catch(() => false);
}

// ─── 팝업 Close = 미저장 폐기·재오픈 재조회 · Save 후 상태(가짜 응답) ───
async function runSaveState(nscm: Nscm, net: PopNet, state: { popup: boolean }, i: number, c: Call) {
  const put = makePut(i, c); const p = nscm.page; const k = facts.classes[c.cls] || { cls: c.cls, in_pack: false }; const pr = await prepare(nscm, c);
  const saves = (k.sps || []).filter(s => s.save);
  if (!pr.ok) { put('POP_SAVE', ['EG197', 'EG304', 'EG445', 'EG178', 'EG434'], 'ERROR', '팝업 저장', pr.why, ''); return; }
  const m0 = net.mark(); const o = await openPopup(nscm, c, state);
  if (!o.dlg) { put('POP_SAVE', ['EG197', 'EG304', 'EG445', 'EG178', 'EG434'], saves.length ? 'ERROR' : 'NA', '팝업 저장', `${o.how}: ${o.why || '안 열림'} · AS-IS 저장 SP ${saves.length}`, ''); return; }
  await settle(p, net, m0, 30_000);
  const saveBtn = o.dlg.getByRole('button', { name: /^(Save|저장)(\(F\d+\))?$/i }).first();
  const hasSave = await saveBtn.isVisible().catch(() => false);
  if (!hasSave) { put('POP_SAVE', ['EG197', 'EG304', 'EG445', 'EG178', 'EG434'], saves.length ? '판정필요' : 'NA', 'Save 버튼 팝업', `Save 버튼 없음 · AS-IS 저장 SP [${saves.map(s => s.sp).join(',')}]`, saves[0]?.ref || ''); await closePopup(p, o.dlg).catch(() => false); return; }
  if ((await waitPopRows(p, TAG, 4_000)) <= 0) { await popSearch(p, o.dlg, net, 60_000); await waitPopRows(p, TAG, 5_000); }
  const n = await popRowCount(p, TAG);
  if (n <= 0) { put('POP_SAVE', ['EG197', 'EG304', 'EG445', 'EG178', 'EG434'], '판정필요', '팝업 편집', '행 0 — 편집 대상 없음', ''); await closePopup(p, o.dlg).catch(() => false); return; }
  // 편집 가능한 첫 숫자·문자 셀에 값 입력(저장 안 함 — 가짜 응답)
  const edit = await p.evaluate(`(async () => { const r = document.querySelector('[data-e2e-pop=${JSON.stringify(TAG)}]'); const el = r && r.querySelector('.wj-flexgrid'); let c = el && el['$WJ-CTRL']; if (el && (!c || !c.columns)) for (const q of Object.getOwnPropertyNames(el)) { const v = el[q]; if (v && typeof v === 'object' && v.columns) { c = v; break; } } if (!c) return null;
    for (let i = 0; i < c.columns.length; i++) { const x = c.columns[i]; if (x.visible === false || !x.binding || x.isReadOnly || x.dataMap) continue; let ok = false; try { ok = c.startEditing(true, 0, i); } catch { ok = false; } if (!ok) continue; const ed = c.activeEditor; if (!ed) { c.finishEditing(true); continue; } const old = String(c.rows[0].dataItem[x.binding] ?? ''); const nv = (x.dataType === 2 || /^-?\\d+(\\.\\d+)?$/.test(old)) ? String((Number(old) || 0) + 1) : old + 'X'; ed.value = nv; c.finishEditing(false); return { binding: x.binding, old, nv, now: String(c.rows[0].dataItem[x.binding] ?? '') }; } return { binding: '', old: '', nv: '', now: '' }; })()`).catch(() => null) as { binding: string; old: string; nv: string; now: string } | null;
  if (!edit || !edit.binding) { put('POP_SAVE', ['EG197', 'EG178', 'EG434'], '판정필요', '팝업 셀 편집', `편집 가능한 셀 없음 — 기능 ${saves.map(s => s.sp).join(',') || '미상'}`, ''); await closePopup(p, o.dlg).catch(() => false); return; }
  // Save → 요청·상태(가짜 응답)
  const ms = net.mark(); await saveBtn.click({ timeout: 5_000 }).catch(() => undefined); await p.waitForTimeout(800);
  const yes = p.getByRole('button', { name: /^(확인|OK|Yes|예|Confirm)$/i }).last(); if (await yes.isVisible().catch(() => false)) await yes.click({ timeout: 2_000 }).catch(() => undefined);
  await settle(p, net, ms, 15_000);
  const sv = net.since(ms).filter(r => /SAVE|INS|UPD|DEL/i.test(r.btn) || /SAVE|INS|UPD|DEL/i.test(r.url));
  const al = await nscm.alertText().catch(() => '');
  const closedAfter = !(await o.dlg.isVisible().catch(() => false));
  put('SAVE_REQ', ['EG178', 'EG434'], sv.length ? (sv[0].body.includes(edit.nv) ? 'PASS' : 'FAIL') : '판정필요', `편집 ${edit.binding} '${edit.old}'→'${edit.nv}' Save → 저장 요청에 값(실제 DB 반영은 메인 세션 실저장)`, `요청 ${sv.length}건 ${sv.map(r => r.url).join(',').slice(0, 120)} · 본문 ${sv.map(r => r.body).join(' ').slice(0, 200)} · 알림 '${al.slice(0, 80)}'`, saves[0]?.ref || '문서 DM-55·GAP-329');
  const asisClose = (k.close_after || []).filter(x => /Save/i.test(x.method));
  put('SAVE_CLOSE', ['EG445'], asisClose.length ? (closedAfter ? 'PASS' : 'FAIL') : closedAfter ? '판정필요' : 'NA', `AS-IS 저장 메서드 뒤 this.Close(${asisClose[0]?.ref || '없음'}) → 팝업 닫힘`, `저장 후 닫힘 ${closedAfter}`, asisClose[0]?.ref || '');
  await nscm.clearDialogs().catch(() => undefined);
  state.popup = false;
  if (!closedAfter) await closePopup(p, o.dlg).catch(() => false);
}


