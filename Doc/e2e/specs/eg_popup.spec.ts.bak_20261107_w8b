const condMultiWant = new Map<string, { want: boolean; type: string; ref: string }>();
// ─── 조건 칸: 존재·입력 가능·라벨·Div 고정 ───
function checkConds(put: ReturnType<typeof makePut>, m: PopMeasure, c: Call, k: Klass, mainDiv: string) {
  const asis = (k.conds || []).filter(x => x.visible_designer && !x.hidden_code && x.label && !/layoutControl|^\s*$/i.test(x.label));
  if (!k.in_pack) { put('COND_LIST', ['EG278', 'EG330'], 'ERROR', 'AS-IS 조건 칸 ↔ TO-BE', 'AS-IS 원문을 찾지 못함', ''); return; }
  const findTo = (lab: string) => { const a = nrm(lab); const al = a === 'division' ? ['div', 'division'] : a === 'div' ? ['div', 'division'] : [a]; return m.conds.find(x => al.includes(nrm(x.label))) || m.conds.find(x => x.label && (nrm(x.label).includes(a) || a.includes(nrm(x.label)))); };
  const missing: string[] = []; const mismatch: string[] = [];
  for (const a of asis) {
    const t = findTo(a.label);
    if (!t) { missing.push(a.label); continue; }
    if (nrm(t.label) !== nrm(a.label) && !['div', 'division'].includes(nrm(a.label))) mismatch.push(`${a.label}→${t.label}`);
    const fixed = a.disabled_designer || !!a.disabled_code;
    // 입력 가능(AS-IS 고정 아님)
    if (!fixed && !a.disabled_guarded.length) put('COND_ENABLED', ['EG278'], t.disabled ? 'FAIL' : 'PASS', `팝업 조건 '${a.label}' 입력 가능(AS-IS 비활성 문장 없음)`, `TO-BE '${t.label}' disabled=${t.disabled} · 값 [${t.values.join(' | ').slice(0, 80)}]`, `${k.file}:${a.ref}`);
    // Division 고정
    if (/^(div|division)/i.test(nrm(a.label))) {
      if (fixed) put('DIV_FIXED', ['EG284'], t.disabled ? (mainDiv && (t.values.join(' ').includes(mainDiv) || t.values.some(v => !!v.trim() && mainDivText.includes(v.trim()))) ? 'PASS' : mainDiv ? 'FAIL' : '판정필요') : 'FAIL', `AS-IS Division 비활성(${a.disabled_code?.ref || a.ref}) → 팝업 Div 메인값 고정·수정 불가`, `disabled=${t.disabled} · 값 [${t.values.join(' | ').slice(0, 60)}] · 메인 Div '${mainDiv}'`, `${k.file}:${a.disabled_code?.ref || a.ref}`);
      else if (a.disabled_guarded.length) put('DIV_FIXED', ['EG284'], '판정필요', `AS-IS 조건부 비활성(${a.disabled_guarded[0].ref} — 분기 미평가)`, `disabled=${t.disabled} · 값 [${t.values.join(' | ').slice(0, 60)}] · 메인 Div '${mainDiv}'`, a.disabled_guarded[0].ref);
      else put('DIV_FIXED', ['EG284'], 'NA', '팝업 Div 고정', `AS-IS 비활성 문장 없음 · TO-BE disabled=${t.disabled}`, '');
    }
  }
  put('COND_LIST', ['EG278', 'EG330'], missing.length || mismatch.length ? '판정필요' : 'PASS', `AS-IS 조건 라벨 [${asis.map(a => a.label).join(', ')}]`, `TO-BE [${m.conds.map(x => `${x.label}:${x.kind}${x.disabled ? ':비활성' : ''}`).join(', ')}] · 누락 [${missing.join(', ')}] · 라벨 차이 [${mismatch.join(', ')}]`, `${k.file}`);
  // 다중/단일(AS-IS 컨트롤 형식) — 문서 DM-202·B6 팝업 조건
