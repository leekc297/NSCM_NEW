// 스냅샷 형상 검사(@snap · 2026-11-06 플랜 Phase 3) — 화면 독립: VERIFY_ID 만 받아 plan.json·원장에서 범위를 읽는다. 저장하지 않는다.
//   (a) 조회조건 패널 aria ×Div (b) 버튼 바 aria ×Div (c) 그리드 헤더 텍스트(모델) ×시트 (d) 조회조건 팝업 정적 aria (e) 화면샷(패널+헤더 띠, 1920/1366)
//   결과: Doc/verify/<ID>/snap/{received,diff,results.json,_review.md} + 원장 스냅샷 행(target '<ID> 스냅샷 <종류> <범위>')이 있으면 e2e_results.json 에 put.
//   골든 없음 = 판정필요(NEW) · 일치 = PASS · 다름 = FAIL(시험 검사 CM-SNAP 가 judge 에서 판정필요로 내린다 · 사용자 2화면 확인 후 confirmed)
import * as fs from 'node:fs';
import * as path from 'node:path';
import { createHash } from 'node:crypto';
import { expect, test } from '../../../tools/E2E/fixtures/test';
import { parseCsv } from '../../../tools/E2E/lib/probe';
import { setCondByLabel, findCondAny } from '../../../tools/E2E/lib/smoke-extra';
import { ariaOf, buttonBar, ensureDirs, headerTextOf, judgeText, keyOf, saveResults, searchAreaTagged, ROOT, type SnapKind, type SnapResult } from '../../../tools/E2E/lib/snap';

const ID = (process.env.VERIFY_ID || '').toUpperCase();
const DIR = path.join(ROOT, 'Doc', 'verify', ID);
const LEDGER = path.join(DIR, 'verify_ledger.csv');
const OUT = process.env.CL_RESULTS || path.join(DIR, 'e2e_results.json');
const CL_SELFTEST = !!(process.env.CL_MUTATE || process.env.CL_SELFTEST_BASE);
type Res = { row_id: string; result: 'PASS' | 'FAIL' | '판정필요' | 'ERROR' | 'NA'; evidence: string; tobe_ref?: string; cond?: string; mctx?: { calls: number; rows: number; req: number }; expect_src?: string; evidence_ref?: string; precond?: Record<string, unknown> };
const rows = ID && fs.existsSync(LEDGER) ? parseCsv(fs.readFileSync(LEDGER, 'utf8')) : [];
const plan = (() => { try { return JSON.parse(fs.readFileSync(path.join(ROOT, 'Doc', 'e2e', 'specs', `${ID}.plan.json`), 'utf8')); } catch { return null; } })();
const results: Res[] = []; const snaps: SnapResult[] = [];
const COND_HASH = new Map(rows.map(r => [r.row_id, createHash('sha1').update(String(r.condition || ''), 'utf8').digest('hex').slice(0, 8)]));
// 원장 스냅샷 행 찾기 — target '<ID> 스냅샷 <종류> <범위>' (ledger.py 가 만든다). 범위 정규화 후 정확 일치
const nrm = (s: string) => String(s || '').toLowerCase().replace(/[^a-z0-9가-힣]/g, '');
const rowFor = (kind: SnapKind, scope: string) => rows.find(r => /스냅샷/.test(r.target || '') && nrm(r.target) === nrm(`${ID} 스냅샷 ${kind} ${scope}`));
const SRC: Record<SnapKind, string> = {
  '조회조건': 'ASIS:plan.json fields/condOrder(search_cond.csv tobe_seq · AS-IS 라벨)', '버튼': 'ASIS:plan.json buttons/menuBtnCodes(AS-IS 버튼 메서드 · btn_auth)',
  '헤더': 'ASIS:plan.json expectedCols/headerSpec(SHEET_COLUMNS · AS-IS SetSheetHeaderColumn)', '팝업': 'ASIS:facts_popup(AS-IS 팝업 폼 · tobe_catalog)', '화면샷': 'RULE:디자인 룰 H4(레이아웃) — 골든은 사용자 승인본',
};
let CUR: { calls: number; rows: number } = { calls: 0, rows: -1 };
const put = (kind: SnapKind, scope: string, s: SnapResult, extra: Record<string, unknown> = {}) => {
  snaps.push(s);
  const r = rowFor(kind, scope); if (!r) return;
  const result: Res['result'] = s.status === 'MATCH' ? 'PASS' : s.status === 'DIFF' ? 'FAIL' : s.status === 'NEW' ? '판정필요' : 'ERROR';
  const ev = `[재실측 스냅샷 ${kind}] ${s.status === 'NEW' ? '골든 없음(승인 전)' : s.status === 'MATCH' ? `기준 ${s.golden} ↔ 실측 일치` : s.status === 'DIFF' ? `기준 ${s.golden} ↔ 실측 ${s.received} · 차이 ${s.lines}줄(${s.diff})` : '측정 실패'} · ${s.detail.slice(0, 500)} · 전제 Div ${String(extra.div || '-')} · calls ${CUR.calls} · rows ${CUR.rows} · 기대원천 ${SRC[kind]}`;
  results.push({ row_id: r.row_id, result, evidence: ev.slice(0, 1400), tobe_ref: `E2E @snap ${kind}`, cond: COND_HASH.get(r.row_id), mctx: { calls: CUR.calls, rows: CUR.rows, req: 0 }, expect_src: SRC[kind], evidence_ref: s.golden || s.received, precond: { div: extra.div || '', calls: CUR.calls, rows: CUR.rows, viewport: extra.viewport || '' } });
};
const flush = () => {
  if (!ID || CL_SELFTEST) return;
  saveResults(ID, snaps);
  if (!results.length) return;
  const prev: Res[] = fs.existsSync(OUT) ? JSON.parse(fs.readFileSync(OUT, 'utf8')) : [];
  const m = new Map(prev.map(r => [r.row_id, r])); for (const r of results) m.set(r.row_id, r);
  fs.writeFileSync(OUT, JSON.stringify([...m.values()], null, 1), 'utf8');
};
const divList = (): string[] => {
  const out: string[] = [];
  const s = plan && plan.sample && plan.sample.div ? String(plan.sample.div) : (process.env.E2E_DIVISION || '');
  if (s) out.push(s);
  for (const a of (plan && plan.accounts) || []) for (const d of a.divisions || []) if (!out.includes(String(d))) out.push(String(d));
  return out.slice(0, 3);
};
const divLabels = (): string[] => { const f = ((plan && plan.fields) || []).find((x: { labels?: string[] }) => (x.labels || []).some(l => /^(div|division)\.?$/i.test(l))); return f ? [...(f.labels || []), f.tobeLabel].filter(Boolean) : ['Div', 'Div.', 'Division']; };
const afterSearch = async (nscm: import('../../../tools/E2E/lib/nscm').Nscm) => {
  const before = nscm.calls.length;
  await (nscm as unknown as { search: () => Promise<unknown> }).search().catch(() => undefined);
  const mine = nscm.calls.slice(before); CUR = { calls: nscm.calls.length, rows: mine.reduce((m, c) => Math.max(m, c.rows == null ? -1 : Number(c.rows)), -1) };
};

test.describe('@snap 스냅샷 형상 검사', () => {
  test.skip(!ID || !plan, 'VERIFY_ID·plan.json 필요');
  test.beforeAll(() => { if (ID) ensureDirs(ID); });
  test.afterAll(() => flush());

  test('@snap 조회조건 패널·버튼 바 aria ×Div', async ({ nscm }) => {
    const r = await nscm.openScreen(ID); if (!r.authorized) { for (const d of divList()) { put('조회조건', `Div ${d}`, { key: keyOf('조회조건', `Div ${d}`), kind: '조회조건', scope: `Div ${d}`, status: 'ERROR', golden: '', received: '', diff: '', lines: 0, detail: '화면 권한 없음', at: '' }); } return; }
    await nscm.expandSearchArea(true).catch(() => undefined);
    const divs = divList(); const labels = divLabels();
    for (let i = 0; i < divs.length; i++) {
      const d = divs[i];
      if (i > 0 || (process.env.E2E_DIVISION && process.env.E2E_DIVISION !== d)) { let ok = false; for (const lb of labels) { ok = await setCondByLabel(nscm, lb, d).catch(() => false); if (ok) break; } if (!ok) { put('조회조건', `Div ${d}`, { key: keyOf('조회조건', `Div ${d}`), kind: '조회조건', scope: `Div ${d}`, status: 'ERROR', golden: '', received: '', diff: '', lines: 0, detail: `Div ${d} 선택 실패(라벨 ${labels.join('/')})`, at: '' }, { div: d }); continue; } await nscm.page.waitForTimeout(800); await nscm.expandSearchArea(true).catch(() => undefined); }
      try {
        // MDI keep-alive 로 숨은 SearchArea 가 .first() 에 잡혀 ariaSnapshot 이 10s 타임아웃(2026-11-06 실측) → 보이는 첫 요소
        // 2026-11-06 3차 실측: data 속성 태깅은 React 재렌더로 사라져 locator 가 못 찾음 → Playwright ':visible' 의사 클래스로 보이는 조회영역만
        // 2026-11-06 4차 실측(SCP0127): SearchArea 클래스·form 요소가 0개 → _formItem_ 최소 공통 조상 태깅(searchAreaTagged) → 그래도 없으면 바디 aria 에서 첫 조건 라벨~Search 버튼 구간
        const tagged = await searchAreaTagged(nscm.page);
        let a: string;
        if (tagged) a = await ariaOf(tagged);
        else {
          const body = await ariaOf(nscm.page.locator('body'));
          const lines = body.split('\n'); const first = labels[0] ? lines.findIndex(l => new RegExp(`text: "?${labels[0].replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`, 'i').test(l)) : -1;
          const end = lines.findIndex((l, i) => i > first && /button "(조회|Search)/i.test(l));
          a = first >= 0 ? lines.slice(first, end > first ? end + 1 : undefined).join('\n') + '\n' : body;
        }
        // 시각 순서(bbox · SC1 과 같은 기준) — aria 는 DOM 순서라 CSS 배치와 다를 수 있다(2026-11-06 SCP0127 실측: DOM Div→SCM Site→Type… ≠ 화면 Div→Plan Group→SCM Site…)
        const pos: { label: string; top: number; left: number }[] = [];
        for (const f of ((plan.fields || []) as { labels?: string[]; tobeLabel?: string; excluded?: boolean }[]).filter(x => !x.excluded)) {
          const ls = [...(f.labels || []), f.tobeLabel || ''].filter(Boolean); if (!ls.length) continue;
          const c = await findCondAny(nscm, ls, `vo${pos.length}`).catch(() => null); if (c) pos.push({ label: c.label.replace(/\s*\*+\s*$/, '').trim() || ls[0], top: c.top, left: c.left });
        }
        pos.sort((x, y) => (Math.abs(x.top - y.top) > 12 ? x.top - y.top : x.left - y.left));
        a += `# visual-order: ${pos.map(p => p.label).join(' > ')}\n`;
        put('조회조건', `Div ${d}`, judgeText(ID, '조회조건', `Div ${d}`, 'aria.yml', a, `조회영역 aria(${a.split('\n').length}줄 · ${tagged ? 'formItem 공통 조상' : '바디 구간 폴백'}) · 시각 순서 ${pos.length}칸`), { div: d });
      } catch (e) { put('조회조건', `Div ${d}`, { key: keyOf('조회조건', `Div ${d}`), kind: '조회조건', scope: `Div ${d}`, status: 'ERROR', golden: '', received: '', diff: '', lines: 0, detail: `aria 실패 ${String(e).slice(0, 300)}`, at: '' }, { div: d }); }
      const bar = await buttonBar(nscm.page);
      if (bar) { try { const b = await ariaOf(bar); put('버튼', `Div ${d}`, judgeText(ID, '버튼', `Div ${d}`, 'aria.yml', b, `버튼 바 aria(${b.split('\n').length}줄) · 보이는 버튼 ${(await nscm.visibleButtons()).join(',')}`), { div: d }); } catch (e) { put('버튼', `Div ${d}`, { key: keyOf('버튼', `Div ${d}`), kind: '버튼', scope: `Div ${d}`, status: 'ERROR', golden: '', received: '', diff: '', lines: 0, detail: `aria 실패 ${String(e).slice(0, 120)}`, at: '' }, { div: d }); } }
      else put('버튼', `Div ${d}`, { key: keyOf('버튼', `Div ${d}`), kind: '버튼', scope: `Div ${d}`, status: 'ERROR', golden: '', received: '', diff: '', lines: 0, detail: '버튼 바 컨테이너를 찾지 못함(로케이터 미확인)', at: '' }, { div: d });
    }
  });

  test('@snap 그리드 헤더 텍스트(모델) ×시트', async ({ nscm }) => {
    const r = await nscm.openScreen(ID); if (!r.authorized) return;
    await afterSearch(nscm);
    const sheets: { name: string }[] = (plan.mainSheets && plan.mainSheets.length ? plan.mainSheets : [{ name: 'main' }]);
    const n = Math.min(await nscm.grids().count().catch(() => 0), Math.max(1, sheets.length));
    for (let i = 0; i < n; i++) {
      const sc = (sheets[i] && sheets[i].name) || `grid${i + 1}`;
      const t = await headerTextOf(nscm.grid(i));
      if (t == null) { put('헤더', sc, { key: keyOf('헤더', sc), kind: '헤더', scope: sc, status: 'ERROR', golden: '', received: '', diff: '', lines: 0, detail: 'Wijmo 모델($WJ-CTRL) 헤더를 읽지 못함', at: '' }); continue; }
      put('헤더', sc, judgeText(ID, '헤더', sc, 'txt', t, `헤더 ${t.split('\n').filter(Boolean).length}행 · 칸 ${(t.split('\n')[0] || '').split(' | ').length}`));
    }
  });

  test('@snap 조회조건 팝업 정적 aria', async ({ nscm }) => {
    const r = await nscm.openScreen(ID); if (!r.authorized) return;
    await nscm.expandSearchArea(true).catch(() => undefined);
    const pops = ((plan.fields || []) as { labels?: string[]; tobeLabel?: string; kind?: string; excluded?: boolean }[]).filter(f => !f.excluded);
    let k = 0;
    for (const f of pops) {
      const labels = [...(f.labels || []), f.tobeLabel || ''].filter(Boolean);
      const c = await findCondAny(nscm, labels, `snap${k++}`).catch(() => null);
      if (!c || c.kind !== 'popup') continue;
      const scope = labels[0];
      try {
        const btn = c.root.locator('button, svg[cursor="pointer"], [class*="SearchIcon"]').first();
        await btn.click({ timeout: 5_000 });
        const dlg = nscm.page.locator('[role="dialog"]:visible, .MuiDialog-root:visible').last();
        await dlg.waitFor({ state: 'visible', timeout: 15_000 });
        await nscm.page.waitForTimeout(800);
        const a = await ariaOf(dlg);
        put('팝업', scope, judgeText(ID, '팝업', scope, 'aria.yml', a, `팝업 aria(${a.split('\n').length}줄)`));
        await nscm.page.keyboard.press('Escape').catch(() => undefined); await nscm.clearDialogs().catch(() => undefined);
      } catch (e) { put('팝업', scope, { key: keyOf('팝업', scope), kind: '팝업', scope, status: 'ERROR', golden: '', received: '', diff: '', lines: 0, detail: `팝업 열기/aria 실패 ${String(e).slice(0, 120)}`, at: '' }); await nscm.clearDialogs().catch(() => undefined); }
    }
  });

  test('@snap 화면샷 패널+헤더 띠 1920/1366', async ({ nscm }) => {
    const r = await nscm.openScreen(ID); if (!r.authorized) return;
    await afterSearch(nscm);
    for (const w of [1920, 1366]) {
      await nscm.page.setViewportSize({ width: w, height: 1080 }); await nscm.page.waitForTimeout(600);
      const scope = `${w}`; const key = keyOf('화면샷', scope);
      const rel = [ID, 'snap', 'golden', `${key}.png`];  // 배열 = 경로 세그먼트(문자열의 '/' 는 Playwright 가 '-' 로 치환한다 · 2026-11-06 실측)
      const sp = test.info().snapshotPath(...rel);
      const expected = path.join(ROOT, 'Doc', 'verify', ID, 'snap', 'golden', `${key}.png`);
      if (path.resolve(sp) !== path.resolve(expected)) { put('화면샷', scope, { key, kind: '화면샷', scope, status: 'ERROR', golden: '', received: '', diff: '', lines: 0, detail: `playwright.config snapshotPathTemplate 미설정(현재 ${sp})`, at: '' }, { viewport: w }); continue; }
      // 마스크: 기간 input · 그리드 셀 · 건수 · Wijmo 평가판 배너(개발환경 정상 문구 · 깜빡여 1366 diff 1,484px 원인 2026-11-06 실측)
      const mask = [nscm.page.locator('input[placeholder*="YYYY" i], [class*="dateBox" i], .wj-cells'), nscm.page.getByText(/Total\s*[:：]?\s*[\d,]+|총\s*[\d,]+\s*건/i), nscm.page.getByText(/Wijmo Evaluation/i)];
      const clip = await (async () => { const tg = await searchAreaTagged(nscm.page); const sa = tg ? await tg.boundingBox().catch(() => null) : await nscm.searchArea().boundingBox().catch(() => null); const g = await nscm.grid(0).boundingBox().catch(() => null); const top = sa ? sa.y : 0; const bottom = g ? Math.min(g.y + 120, 1080) : Math.min((sa ? sa.y + sa.height : 0) + 300, 1080); return { x: 0, y: Math.max(0, top - 8), width: w, height: Math.max(80, bottom - Math.max(0, top - 8)) }; })();
      const exists = fs.existsSync(expected);
      // 2026-11-07 T142 ②: 화면샷 골든 png 는 Playwright 가 첫 실행에 자동 생성한다 → 파일 존재 ≠ 승인. snap/manifest.json 에 그 key 의 승인 기록(snap_approve.py)이 있어야 MATCH/DIFF 판정,
      //   없으면 비교 결과를 적되 '골든 없음(승인 전)' = 판정필요(승인대기)로 둔다(chain6b 에서 확대 4화면 화면샷이 2회차에 PASS 된 결함)
      const approved = exists && (() => { try { const man = JSON.parse(fs.readFileSync(path.join(ROOT, 'Doc', 'verify', ID, 'snap', 'manifest.json'), 'utf8')) as Record<string, unknown>; return !!man[key] && !key.startsWith('_'); } catch { return false; } })();
      try {
        // 2026-11-13 점검: 골든 png 가 없는 첫 실행에서 toHaveScreenshot 은 후보를 쓰면서 테스트를 실패로 표시한다("A snapshot doesn't exist … writing actual" —
        //   11-06~11-13 15화면 30회 · judge 가 '측정 전 실패한 검증엔진 테스트' 로 집계). 첫 캡처는 실패가 아니라 '승인 전 후보 저장' 이므로 직접 찍어 저장하고 NEW 로 둔다(판정 = 종전과 같은 판정필요).
        if (!exists) {
          fs.mkdirSync(path.dirname(expected), { recursive: true });
          await nscm.page.screenshot({ path: expected, clip, mask, animations: 'disabled', caret: 'hide', scale: 'css', timeout: 15_000 });
          put('화면샷', scope, { key, kind: '화면샷', scope, status: 'NEW', golden: path.relative(ROOT, expected), received: '', diff: '', lines: 0, detail: '골든 없음 — 첫 캡처가 골든 후보로 저장됨(승인 전에는 판정필요)', at: '' }, { viewport: w });
          continue;
        }
        await expect(nscm.page).toHaveScreenshot(rel, { clip, mask, maxDiffPixelRatio: 0.002, animations: 'disabled', timeout: 15_000 });
        put('화면샷', scope, { key, kind: '화면샷', scope, status: approved ? 'MATCH' : 'NEW', golden: path.relative(ROOT, expected), received: '', diff: '', lines: 0, detail: approved ? '골든 화면샷과 일치(maxDiffPixelRatio 0.002)' : exists ? '골든 없음(승인 전) — 자동 생성 골든 후보 png 와 일치(maxDiffPixelRatio 0.002) · snap_approve.py 승인 전에는 판정필요' : '골든 없음 — 첫 캡처가 골든 후보로 저장됨(승인 전에는 판정필요)', at: '' }, { viewport: w });
      } catch (e) {
        // toHaveScreenshot 실패 — actual/diff 는 Playwright outputDir(artifacts) 에 남는다
        const art = test.info().outputPath(); put('화면샷', scope, { key, kind: '화면샷', scope, status: approved ? 'DIFF' : 'NEW', golden: path.relative(ROOT, expected), received: art, diff: art, lines: 1, detail: `${approved ? '화면샷 차이' : '골든 없음(승인 전) — 자동 생성 골든 후보 png 와 차이'} — ${String(e).replace(/\s+/g, ' ').slice(0, 200)} · actual/diff: ${art}`, at: '' }, { viewport: w });
      }
    }
    await nscm.page.setViewportSize({ width: 1920, height: 1080 });
  });
});
