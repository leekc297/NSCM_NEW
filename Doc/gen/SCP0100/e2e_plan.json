  "tcs": [
    {
      "id": "TC-ID",
      "kind": "구분",
      "pre": "사전조건",
      "step": "절차",
      "input": "입력값",
      "expect": "기대결과",
      "basis": "근거"
    },
    {
      "id": "TC-SCP0100-001",
      "kind": "초기화",
      "pre": "로그인(세션 NowGroupID, USER_ID 있음)",
      "step": "SCP0100 화면을 엽니다",
      "input": "—",
      "expect": "시트 SEARCH_LEVEL / REPORT / SEARCH_LEVEL_DETAIL이 생성되고, 메타 컬럼과 기간 컬럼이 3행 헤더로 구성됩니다",
      "basis": "`Form_Load` > CreateSpread > InitSpread > GetSpdTitle → `SCP.SCP0100_GET_SHEET_CALENDAR_3SPAN` / SP SCP0100_GET_SHEET_CALENDAR_3SPAN"
    },
    {
      "id": "TC-SCP0100-002",
      "kind": "초기화",
      "pre": "위와 같음",
      "step": "화면을 연 뒤 cboPlanDate 목록을 확인합니다",
      "input": "—",
      "expect": "SP 결과 행이 cboPlanDate 항목으로 채워집니다(표시 형식은 확인 필요)",
      "basis": "`Form_Load` > InitControls > GetPlanDate → `SCP.SCP0100_GET_PLAN_DATE` / SP SCP0100_GET_PLAN_DATE"
    },
    {
      "id": "TC-SCP0100-003",
      "kind": "초기화",
      "pre": "위와 같음",
      "step": "화면을 연 뒤 dCalendar 기간을 확인합니다",
      "input": "—",
      "expect": "PLAN_END_DATE 공통 데이터로 기간 범위가 설정됩니다(계산식은 확인 필요)",
      "basis": "`Form_Load` > SetCalendar > GetDayRange > GetPlanEndDate → `biz:CommonData.CommonDataList_REPORT`"
    },
    {
      "id": "TC-SCP0100-004",
      "kind": "초기화",
      "pre": "화면 Load 완료",
      "step": "화면이 표시된 직후 clbToSite 목록을 확인합니다",
      "input": "—",
      "expect": "SP 결과가 clbToSite 항목으로 채워집니다",
      "basis": "`SCP0100_Global_PSI_Report_Shown` > InitControlsAfter > RefreshToSite > GetSiteList → `SCP.SCP0100_GET_SITE` / SP SCP0100_GET_SITE"
    },
    {
      "id": "TC-SCP0100-005",
      "kind": "초기화",
      "pre": "화면 Load 완료",
      "step": "chkCellQty, chkAS, cboPlanType 상태를 확인합니다",
      "input": "—",
      "expect": "chkCellQty: Checked=true, Visible=false / chkAS: Visible=false / cboPlanType의 LayoutItem(PlanType): Enabled=false",
      "basis": "designer:248/284/929/1159, `ChkCellQty_CheckedChanged`, `ChkAS_CheckedChanged`, `CboPlanType_SelectedIndexChanged`"
    },
    {
      "id": "TC-SCP0100-006",
      "kind": "이벤트",
      "pre": "cboPlanDate 항목 2개 이상",
      "step": "cboPlanDate에서 다른 항목을 고릅니다",
      "input": "다른 Plan Date",
      "expect": "기간 헤더가 다시 구성되고, dCalendar 범위가 다시 계산됩니다",
      "basis": "`CboPlanDate_SelectedIndexChanged` → `SCP.SCP0100_GET_SHEET_CALENDAR_3SPAN`, `biz:CommonData.CommonDataList_REPORT`"
    },
    {
      "id": "TC-SCP0100-007",
      "kind": "이벤트",
      "pre": "화면 초기화 완료",
      "step": "dCalendar의 From/To를 바꿉니다",
      "input": "기간 변경",
      "expect": "기간 헤더가 다시 구성되고, 기간 컬럼 수가 새 기간에 맞게 바뀝니다",
      "basis": "`DCalendar_ValueChanged` > InitSpread > GetSpdTitle → `SCP.SCP0100_GET_SHEET_CALENDAR_3SPAN`"
    },
    {
      "id": "TC-SCP0100-008",
      "kind": "이벤트",
      "pre": "화면 초기화 완료",
      "step": "rgrpSearchLevel 선택을 바꿉니다",
      "input": "다른 라디오 항목",
      "expect": "헤더가 다시 구성됩니다. 시트 전환 여부는 확인 필요",
      "basis": "`rgrpSearchLevel_SelectedIndexChanged` → `SCP.SCP0100_GET_SHEET_CALENDAR_3SPAN`"
    },
    {
      "id": "TC-SCP0100-009",
      "kind": "이벤트",
      "pre": "화면 초기화 완료",
      "step": "btnMeasure를 누릅니다",
      "input": "—",
      "expect": "헤더가 다시 구성됩니다(메저 선택 UI는 확인 필요)",
      "basis": "`btnMeasure_Click` > InitSpread > GetSpdTitle → `SCP.SCP0100_GET_SHEET_CALENDAR_3SPAN`"
    },
    {
      "id": "TC-SCP0100-010",
      "kind": "이벤트",
      "pre": "화면 초기화 완료",
      "step": "btnColumn을 누릅니다",
      "input": "—",
      "expect": "헤더가 다시 구성됩니다(컬럼 선택 UI는 확인 필요)",
      "basis": "`BtnColumn_Click` > InitSpread > GetSpdTitle → `SCP.SCP0100_GET_SHEET_CALENDAR_3SPAN`"
    },
    {
      "id": "TC-SCP0100-011",
      "kind": "이벤트",
      "pre": "시트 생성 완료(_SI 있음)",
      "step": "cboBucketType을 MONTHLY로 바꿉니다",
      "input": "MONTHLY",
      "expect": "`M_`로 시작하는 컬럼만 보이고 나머지는 숨겨집니다. API 호출은 없습니다",
      "basis": "`CboBucketType_SelectedIndexChanged` > SetSpreadColumn :1103/:1107"
    },
    {
      "id": "TC-SCP0100-012",
      "kind": "이벤트",
      "pre": "시트 생성 완료(_SI 있음)",
      "step": "cboBucketType을 WEEKLY로 바꿉니다",
      "input": "WEEKLY",
      "expect": "`W_`로 시작하는 컬럼만 보이고 나머지는 숨겨집니다. API 호출은 없습니다",
      "basis": "`CboBucketType_SelectedIndexChanged` > SetSpreadColumn :1114/:1118"
    },
    {
      "id": "TC-SCP0100-013",
      "kind": "이벤트",
      "pre": "시트 미생성(_SI == null)",
      "step": "시트 생성 전에 cboBucketType 변경 이벤트가 발생하는 경우",
      "input": "임의",
      "expect": "SetSpreadColumn이 호출되지 않고 예외도 없습니다",
      "basis": "`CboBucketType_SelectedIndexChanged` `if(_SI != null)` :1804"
    },
    {
      "id": "TC-SCP0100-014",
      "kind": "이벤트",
      "pre": "화면 초기화 완료",
      "step": "cboDisplay 항목을 차례로 고릅니다",
      "input": "콤보 각 항목",
      "expect": "splitContainer1.SplitterDistance가 0, 750, 270 중 하나로 바뀝니다. 값별 대응은 확인 필요. 0일 때 Panel1(chartMain)이 접힙니다",
      "basis": "`CboDisplay_SelectedIndexChanged` :1833/:1841/:1849"
    },
    {
      "id": "TC-SCP0100-015",
      "kind": "이벤트",
      "pre": "화면 초기화 완료",
      "step": "cboSearchLevel 항목을 바꿉니다",
      "input": "각 항목",
      "expect": "예외 없이 처리됩니다. 세부 동작(SetLayout 호출 여부)은 확인 필요",
      "basis": "`CboSearchLevel_SelectedIndexChanged`"
    },
    {
      "id": "TC-SCP0100-016",
