def col_letter(i):
    s = ''
    while i:
        i, r = divmod(i - 1, 26); s = chr(65 + r) + s
    return s

def sheet(ws, cols, data, widths, extra_from=None):
    ws.append(cols)
    for i, c in enumerate(ws[1], 1):
        c.font = Font(bold=True, color='FFFFFF'); c.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')
        c.fill = HF if (extra_from is None or i < extra_from) else GF
        c.border = BD
    for r in data:
        ws.append([('' if v is None else (str(v)[:32000] if isinstance(v, str) else v)) for v in r])
    for row in ws.iter_rows(min_row=2):
        for c in row:
            c.alignment = Alignment(wrap_text=True, vertical='top'); c.border = BD
    for i, w in enumerate(widths, 1):
        ws.column_dimensions[col_letter(i)].width = w
    ws.freeze_panes = 'A2'
    ws.auto_filter.ref = ws.dimensions

def band(ws, keycols, ncols):
    prev = None
    for r in ws.iter_rows(min_row=2):
        k = tuple(r[i].value for i in keycols)
        if k != prev:
            for c in r[:ncols]:
                c.fill = SF
        prev = k

