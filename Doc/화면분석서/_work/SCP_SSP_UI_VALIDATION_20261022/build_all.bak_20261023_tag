def sname(sid):
    t = screens[sid]['title'] if sid in screens else ''
    return f'{sid} {t}'.strip()

def _args(a):
    if isinstance(a, str):
        try:
            import ast
            v = ast.literal_eval(a)
            return list(v) if isinstance(v, (list, tuple)) else [v]
        except Exception:
            return [a] if a.strip() not in ('', '[]') else []
    return list(a or [])

def render(msg_id, args, text=''):
    """(KO, EN) — MSG ID 면 TB_FX_MessageInfo 문구에 인자 치환."""
    args = _args(args)
    if msg_id and msg_id in MSG:
        ko, en = MSG[msg_id]['Ko'], MSG[msg_id]['En']
        for i, a in enumerate(args or []):
            ko = ko.replace('{%d}' % i, str(a)); en = en.replace('{%d}' % i, str(a))
        return f'[{msg_id}] {ko}', en
    if msg_id:
        return f'[{msg_id}] (메시지 마스터에 없음) {text}'.strip(), ''
    return text or '(메시지 없음)', ''

def norm_item(name):
    name = item_map.get(name, name)
    return name[4:] if name.startswith('NEW:') else name

