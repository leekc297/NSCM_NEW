# -*- coding: utf-8 -*-
"""결정표 — 기계로 PASS/FAIL 을 못 정한 항목(판정필요·WARN)을 사람이 한 번에 답할 수 있는 표로 만들고, 답을 원장에 '수동' 판정으로 반영한다 (2026-10-26)

  python tools/Harness/verify/decisions.py <MENU_ID>            → Doc/verify/<ID>/decisions.csv · decisions.md (답 칸 비움 — 기존 답은 보존)
  python tools/Harness/verify/decisions.py <MENU_ID> --apply    → decisions.csv 의 answer(P/F/N) 를 원장 행에 반영(tobe_ref='수동 결정 …' — judge/E2E 재실행이 덮지 않음)

  사용자 지시: "PASS·FAIL 이 아닌 항목이 잔여하지 않도록". 추측 PASS 는 금지(anti-simplification) → 기계가 못 정한 것은 근거를 보여 주고 사람이 정한다.
  답: P = AS-IS 와 같다(PASS) · F = 결함(FAIL — 보완대상) · N = 해당없음(NA — 사유 필수) · 빈칸 = 미결(남아 있음)
  원천: Doc/verify/<ID>/verify_ledger.csv 의 result ∈ {판정필요, WARN} 행 (TRACE·ASIS·COLUMN·SEARCH 등 전부)

  근거 등급(2026-10-26, Atlas Studio 규약 — AI 판단만으로는 통과 금지):
  by = 답한 사람(이름·계정). 비우면 반영하지 않는다. AI·claude 등이 답했으면 by 에 그대로 적는다.
    사람(by = 사람 이름)        → P·F·N 모두 반영 · tobe_ref '수동 결정(사람:<by>) …'
    AI(by = ai·claude·agent…)  → F 는 반영(보수적 — 보완대상으로 감) · tobe_ref '수동 결정(AI·근거 없음) …'
                                 P·N 은 evidence_ref(경로:줄)+evidence_quote(그 줄 원문 인용)가 evidence_check 로 확인될 때만 반영
                                 · tobe_ref '수동 결정(AI·근거 확인) …' — 확인 실패면 반영하지 않고 판정필요로 남긴다
"""
import csv, os, re, sys, json, collections, datetime
ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..'))
DOC = os.path.join(ROOT, 'Doc')
csv.field_size_limit(10 ** 8)
rdcsv = lambda p: list(csv.DictReader(open(p, encoding='utf-8-sig'))) if os.path.exists(p) else []
COLS = ['dec_id', 'row_id', 'rule_id', 'source', 'target', 'group', 'measured', 'question', 'options', 'answer', 'reason', 'by', 'evidence_ref', 'evidence_quote']
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import envelope  # noqa: E402
import evidence_check  # noqa: E402


def who(d):
    """('human'|'ai'|None, by) — 답한 주체. by 가 비면 None(반영 안 함)."""
    by = (d.get('by') or '').strip()
    if not by:
        return None, ''
    return ('ai' if envelope.AI_NAMES.match(by) else 'human'), by


def ai_evidence(d):
    """AI 답의 인용 근거 확인 → (ok, why)"""
    ref = (d.get('evidence_ref') or '').strip(); quote = (d.get('evidence_quote') or '').strip()
    if not ref or not quote:
        return False, '근거 인용(evidence_ref·evidence_quote) 없음'
    ev = evidence_check.check_ev({'kind': 'source', 'ref': ref, 'expect': [q for q in quote.split('||') if q.strip()] if '||' in quote else quote})
    return ev['verified'], ev['why']

