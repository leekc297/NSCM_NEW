async function condValue(root: Locator, kind: string): Promise<string> {
  return root.evaluate((el, k) => {
    const ctl = (el.children[1] as HTMLElement) || (el as HTMLElement);
    if (k === 'checkbox') return Array.from(ctl.querySelectorAll('input[type="checkbox"]')).map(i => ((i as HTMLInputElement).checked ? 'Y' : 'N')).join(',');
    if (k === 'radio') { const r = Array.from(ctl.querySelectorAll('input[type="radio"]')).find(i => (i as HTMLInputElement).checked); return r ? ((r.closest('label') as HTMLElement | null)?.innerText || (r as HTMLInputElement).value || '').trim() : ''; }
    const chips = Array.from(ctl.querySelectorAll('.MuiChip-label')).map(c => (c as HTMLElement).innerText.trim()).filter(Boolean);
    const ins = Array.from(ctl.querySelectorAll('input:not([type="hidden"])')).map(i => (i as HTMLInputElement).value).filter(Boolean);
    return [...chips, ...ins].join(' | ') || (ctl.innerText || '').replace(/\s+/g, ' ').trim();
  }, kind).catch(() => '');
}

