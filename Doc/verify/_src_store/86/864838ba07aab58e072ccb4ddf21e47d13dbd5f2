  const fmt = (h: Awaited<ReturnType<typeof rowHeadState>>) => (h ? `표시 '${h.status || h.text || '-'}'·색 ${h.bg || '-'}·CRUD '${h.crud || '-'}'` : '읽지 못함');
  const ev = `${head} · r${row} 편집 ${typed.join(', ') || '-'} · 행 머리(행 상태 칸) 편집 전 ${fmt(hBefore)} → 편집 뒤 ${fmt(hMid)} → Save 뒤 ${fmt(hAfter)} · 수정 안 한 행 r${base} ${fmt(hBase)} · 막은 쓰기 요청 ${guard.st.n}건(서버 미전송) · 알림 '${msgs.join(' | ').slice(0, 120) || '없음'}' · AS-IS ${cr.ref} 수정 표시 지움 + ${cr.color_edit || '-'}${want ? `(${want})` : ''} 칠함 · 규칙 칸 ${cr.columns || '-'} = TO-BE 행 머리 data-status`;
  await nscm.openScreen(ID).catch(() => undefined);  // 편집 버림(저장 안 함)
  if (unmet) return { result: 'ERROR', why: `[측정 전제 미충족] ${unmet} · ${ev}` };
  if (!hAfter) return { result: 'ERROR', why: `[측정 실패] Save 뒤 행 머리를 읽지 못함 · ${ev}` };
  if (guard.st.n > 0) return { result: 'FAIL', why: `Save 가 이 행 저장 요청을 냄(막음) — AS-IS 는 이 행의 수정 표시를 지우고 저장 대상에서 뺌 · ${ev}` };
  const still = hAfter.status === atoms.flag || hAfter.crud === atoms.flag;
  const colorOk = !!hAfter.bg && ((!!want && hAfter.bg.replace(/\s+/g, '') === want.replace(/\s+/g, '')) || (!!hBase && hAfter.bg === hBase.bg));
  if (still) return { result: 'FAIL', why: `Save 뒤에도 행 상태 칸에 수정 표시 '${atoms.flag}' 유지 — AS-IS 는 수정 표시를 지우고 ${cr.color_edit || ''} 로 칠함 · ${ev}` };
  return { result: colorOk ? 'PASS' : 'FAIL', why: `${colorOk ? '수정 표시 지워짐 · 행 상태 칸 색 = 수정 안 한 행·AS-IS 색과 같음' : `수정 표시는 지워졌으나 행 상태 칸 색 ${hAfter.bg} ≠ AS-IS ${want || cr.color_edit || '-'} · 수정 안 한 행 ${hBase ? hBase.bg : '-'}`} · ${ev}` };
}

test.describe(`검증엔진 ${ID} @trace`, () => {
  test.describe.configure({ retries: 0 });
  test.skip(!ID || !rows.length, `VERIFY_ID 없음 또는 원장 TRACE 행 없음: ${LEDGER} (mapping_trace.py ${ID} --to-ledger 먼저)`);
  test.afterEach(() => { try { flush(); } catch (e) { console.log(`[flush] 테스트 뒤 결과 기록 실패: ${String(e).slice(0, 120)}`); } });  // 2026-11-12 T270: 테스트마다 결과를 파일에 — 뒤 테스트가 멈춰 작업자가 죽어도 앞 결과가 남는다(DMF0005 608행 소실)
  test.afterAll(() => flush());
  test.afterEach(({ nscm }) => dynFlush(nscm));

  // 2026-10-30 테스트결과서: 이 테스트에서 FAIL 로 기록한 행이 있으면 테스트 종료 시점 화면을 저장하고 행 ↔ 파일 색인을 남긴다(Doc/verify/<ID>/e2e/shots/).
  //   판정에는 영향 없음(캡처 실패는 삼킨다) · 스펙별 색인 파일(index_trace.json)로 병렬 워커 간 쓰기 충돌을 피한다 · 캡처는 '종료 시점' 이라 실패 순간과 다를 수 있음을 색인 note 에 남긴다.
  let shotMark = 0;
  test.beforeEach(({ nscm }) => { CUR.nscm = nscm; shotMark = results.length; });
  test.afterEach(async ({ page }, testInfo) => {
    const fails = results.slice(shotMark).filter(r => r.result === 'FAIL');
    if (!fails.length) return;
    try {
      const dir = path.join(DIR, 'e2e', 'shots'); fs.mkdirSync(dir, { recursive: true });
      const slug = testInfo.title.replace(/[^\w가-힣]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 60) || 'test';
      const file = `trace_${slug}.png`;
      await page.screenshot({ path: path.join(dir, file), fullPage: false, timeout: 15_000 });
      const idxP = path.join(dir, 'index_trace.json');
      const idx: Record<string, unknown> = fs.existsSync(idxP) ? JSON.parse(fs.readFileSync(idxP, 'utf8')) : {};
      for (const r of fails) idx[r.row_id] = { file, test: testInfo.title, at: new Date().toISOString().slice(0, 19).replace('T', ' '), note: '테스트 종료 시점 화면(실패 순간과 다를 수 있음)' };
      fs.writeFileSync(idxP, JSON.stringify(idx, null, 1), 'utf8');
    } catch { /* 캡처 실패는 판정에 영향 없음 */ }
  });
