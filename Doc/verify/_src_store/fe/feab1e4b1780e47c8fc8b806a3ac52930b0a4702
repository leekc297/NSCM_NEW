        return 0
    if stalled:
        print(f'[WARN] 처리 대상 {after["actionable"]}행 · 직전 처리 대상 {prev_act}행 중 풀린 행 0 — 반복 중단, 남은 행은 원인·결정 목록으로 보고', flush=True)
    elif resolved_ids or new_ids:
