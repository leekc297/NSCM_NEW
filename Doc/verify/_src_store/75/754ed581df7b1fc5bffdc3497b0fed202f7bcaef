def now():
    return datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')


def _read(p):
    try:
        with open(p, encoding='utf-8-sig', newline='') as fh:
            return list(csv.DictReader(fh))
    except OSError:
        return []


def run(cmd, env=None, cwd=None, tag=''):
    t0 = time.time()
    print('$ ' + ' '.join(str(c) for c in cmd)[:500], flush=True)
    rc = subprocess.call(cmd, cwd=cwd or ROOT, env=dict(env or os.environ, PYTHONUNBUFFERED='1'))
    print(f'[시간] {tag or os.path.basename(str(cmd[1] if len(cmd) > 1 else cmd[0]))} · {time.time() - t0:.1f}s · rc={rc}', flush=True)
    return rc


def kind_of(r, res):
    """행 출처 → 재측정 방법"""
    rid = r.get('row_id') or ''
    if rid.startswith('FACT-'):
        return 'fact'
    if rid.startswith('ES-'):
        return 'suite'
    if rid.startswith('EG-') or (res.get(rid) or {}).get('tobe_ref', '').startswith('E2E @eg'):
        return 'eg'
    if r.get('source') == 'ASIS_DIFF' or (res.get(rid) or {}).get('tobe_ref', '').startswith('DB @diff'):
        return 'diff'
    ref = (res.get(rid) or {}).get('tobe_ref', '')
    if ref.startswith('E2E @verify') or ref.startswith('E2E @trace') or r.get('source') == 'TRACE' or rid in res:
        return 'e2e'
    if (r.get('rule_id') or '').upper() in SMOKE_RULES:
        return 'e2e'
    return 'static'


def pick_tests(rows, res, own):
    """E2E 행 → (시험 제목 집합, 시나리오 이름 집합, 스냅샷 필요, smoke 종류, 대응표 없이 고른 행)"""
    titles, scn, snap, kinds, guessed = set(), set(), False, set(), []
    for r in rows:
        rid = r['row_id']; rule = (r.get('rule_id') or '').upper(); tg = r.get('target') or ''
        if rule in SMOKE_RULES:
            kinds |= {'smoke'} | ({'auth', 'authcrud'} if rule in ('J1', 'J2', 'C1') else set())
        if rule in SNAP_RULES and '스냅샷' in tg:
            snap = True
        if ' 시나리오 ' in tg and tg.partition(' 시나리오 ')[2]:
            titles.add('문서 시나리오'); scn.add(tg.partition(' 시나리오 ')[2]); continue
        t = (res.get(rid) or {}).get('test') or ''
        # 2026-11-25 T634(SCP0005 V-a32c8abf: 기록된 시험 'W4d 잔여 판정필요 실측' 이 '[측정 코드 없음]' 고정 문구만 남김 → 측정은 다른 시험으로 옮겨짐):
        #   기록된 시험이 측정 경로·코드 없음으로 끝난 행은 기록된 시험과 규칙 소유 시험을 같이 고른다(검사기 보완으로 판정 주인이 바뀐 행)
        ev0 = str((res.get(rid) or {}).get('evidence') or '')
        if t:
            titles.add(t)
            if not re.match(r'\s*\[측정 (코드|경로) 없음\]', ev0):
                continue
        # 대응표 없음(2026-11-25 이전 결과) = 규칙 소유 분석(run_verify --only 와 같은 근거) + 대상 정규식
        guessed.append(rid); src = r.get('source') or ''
        for k, v in own.items():
            if not isinstance(k, tuple):
                continue
            hit = rule in (v.get('rules') or set()) and (not v.get('sources') or src in v['sources'])
            if not hit:
                hit = bool(re.search(rf'(?<![A-Z0-9]){re.escape(rule)}(?![A-Z0-9])', k[1])) if rule else False
            if not hit:
                for rx in v.get('target_res') or []:
                    try:
                        if re.search(rx, tg):
                            hit = True; break
                    except re.error:
                        continue
            if hit:
                titles.add(k[1])
        for _rn, pre, _suf, v in own.get('_tmpl', []):
            if rule in (v.get('rules') or set()) and pre:
                titles.add(pre)
    return titles, scn, snap, kinds, guessed


def eg_calls(mid, rows):
    """EG 행 → 팝업 호출 번호. 원장 target = '<ID> 팝업 <cls> <trig> <check>'(eg_ingest) ↔ popup_results.json 의 call·cls·trig. 반환 (번호 집합, 잇지 못한 행 ID)"""
    try:
        pr = json.load(open(os.path.join(ROOT, 'Doc', 'verify', mid, 'eg', 'popup', 'popup_results.json'), encoding='utf-8'))
    except (OSError, ValueError):
        pr = []
    pref = {}
    for e in pr:
        if e.get('call') is not None and e.get('cls'):
            pref.setdefault(f"{mid} 팝업 {e['cls']} {e.get('trig', '')}".strip(), set()).add(int(e['call']))
    calls, rest = set(), []
    for r in rows:
        tg = (r.get('target') or '').strip(); hit = [c for p_, cs in pref.items() if tg == p_ or tg.startswith(p_ + ' ') for c in cs]
        if hit:
            calls |= set(hit)
        else:
            rest.append(r['row_id'])
    return calls, rest


def ledger_sig(mid):
    return hash(tuple((x.get('row_id'), x.get('result')) for x in _read(os.path.join(ROOT, 'Doc', 'verify', mid, 'verify_ledger.csv'))))


def fold(mid, asis):
    """측정 결과 → 원장(run_verify stage_post 의 반입 구간과 같은 순서, AI 판정 검토 반입 없음)"""
    env = dict(os.environ, LLM_JUDGE_APPLY='0')
    s0 = None
    for _ in range(3):
        if run([PY, os.path.join(HERE, 'mapping_trace.py'), mid, '--asis', asis, '--to-ledger'], env=env):
            return 9
        run([PY, os.path.join(HERE, 'eg_ingest.py'), mid], env=env)
        run([PY, os.path.join(HERE, 'e2e_suite_ingest.py'), mid], env=env)
        if run([PY, os.path.join(HERE, 'judge.py'), mid], env=env):
            return 7
        s = ledger_sig(mid)
        if s == s0:
            break
        s0 = s
    run([PY, os.path.join(HERE, 'mapping_trace.py'), mid, '--asis', asis], env=env)
    return 0


