            U2.worklist_update(mid, out, count=os.environ.get('ROW_RUN_NOCOUNT') != '1')   # 측정만(검사기 수정 없음) = 시도 횟수에 넣지 않음
    except Exception as e:
        print(f'[WARN] 해소 원장 갱신 실패({type(e).__name__}: {str(e)[:120]})', flush=True)
    print(f"[{'OK' if not opened else 'INFO'}] 닫힘 {len(ids) - opened}/{len(ids)} · {(time.time() - t0) / 60:.1f}분", flush=True)
    return 0 if not opened else 2


def regress(mid, since):
    """퇴행 확인(2026-11-25 플랜 원칙 7): since 뒤 row_run 이 돈 시험을 행 제한 없이 1회 다시 돌려, 그 전에 판정이 난 행이 미검증으로 바뀌었는지 본다.
       반환 0 = 퇴행 없음 · 2 = 퇴행 있음(행 목록 출력, Doc/verify/<ID>/regress_rows.json) · 3 = 돌릴 시험 없음"""
    vd = os.path.join(ROOT, 'Doc', 'verify', mid)
    runs = []
    try:
        runs = [json.loads(l) for l in open(os.path.join(vd, 'row_run_runs.jsonl'), encoding='utf-8') if l.strip()]
    except OSError:
        pass
    runs = [r for r in runs if (r.get('at') or '') >= since]
    titles = sorted({t for r in runs for t in r.get('titles') or []}); scn = sorted({t for r in runs for t in r.get('scn') or []}); snap = any(r.get('snap') for r in runs)
    if not titles and not snap:
        print(f'[INFO] 퇴행 확인: {since} 뒤 row_run 이 돌린 시험 없음', flush=True); return 3
    import run_verify as RV
    asis = RV.asis_of(mid)
    before = {r['row_id']: r['result'] for r in _read(os.path.join(vd, 'verify_ledger.csv'))}
    lock = subprocess.run(['node', 'runlock.js', 'acquire', 'verify', mid], cwd=E2E, capture_output=True, text=True, encoding='utf-8')
    if lock.returncode:
        print(f'[ERROR] 같은 화면({mid}) 검증 실행 중', flush=True); return 4
    if not RV.dbwin_acquire(mid, max_min=30):
        subprocess.run(['node', 'runlock.js', 'release', 'verify', mid], cwd=E2E, capture_output=True); return 4
    t0 = time.time()
    try:
        env = dict(os.environ, VERIFY_RUN_ID='RG' + time.strftime('%Y%m%d%H%M%S'), VERIFY_ID=mid, E2E_RESULTS=os.path.join(vd, 'e2e'), PLAYWRIGHT_JSON_OUTPUT_NAME=os.path.join(vd, 'e2e', 'row_run_results.json'), VERIFY_ONLY='REGRESS')
        if scn:
            env['SCN_ONLY'] = '^(?:' + '|'.join(re.escape(n) for n in scn) + ')$'
        print(f'[퇴행 확인] 이번 해소에서 돈 시험 {len(titles)}개를 행 제한 없이 1회: ' + ' | '.join(titles)[:400], flush=True)
        run(['node', os.path.join('node_modules', '@playwright', 'test', 'cli.js'), 'test', '_verify', '_trace', *(['_snap'] if snap else []), '--grep', '|'.join(re.escape(t) for t in titles) + ('|@snap' if snap else ''), '--workers', '1', '--reporter=list,json'], env=env, cwd=E2E, tag='playwright 퇴행 확인')
        run([PY, os.path.join(HERE, 'db_orphan_sessions.py'), mid, '--kill']); run([PY, os.path.join(HERE, 'restore_touched.py'), mid, '--keep-trace']); run([PY, os.path.join(HERE, 'cleanup_marker.py'), mid])
        rc = fold(mid, asis)
        if rc:
            return rc
    finally:
        RV.dbwin_release(); subprocess.run(['node', 'runlock.js', 'release', 'verify', mid], cwd=E2E, capture_output=True)
    after = {r['row_id']: (r['result'], ' '.join((r.get('evidence') or '').split())[:140]) for r in _read(os.path.join(vd, 'verify_ledger.csv'))}
    bad = [(k, v, after[k][0], after[k][1]) for k, v in before.items() if k in after and v in ('PASS', 'FAIL', 'NA', '판정필요') and after[k][0] == 'ERROR']
    json.dump([{'row_id': k, 'before': b, 'after': a, 'evidence': e} for k, b, a, e in bad], open(os.path.join(vd, 'regress_rows.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
    for k, b, a, e in bad:
        print(f'  퇴행 {k}: {b} → {a} · {e}', flush=True)
    print(f"[{'OK' if not bad else 'ERROR'}] 퇴행 확인: 판정이 나 있던 행 중 미검증으로 바뀐 행 {len(bad)} · {(time.time() - t0) / 60:.1f}분", flush=True)
    return 0 if not bad else 2


