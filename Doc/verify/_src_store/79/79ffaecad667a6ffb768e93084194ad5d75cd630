def rd(p):
    if not os.path.exists(p): return []
    with open(p, encoding='utf-8-sig', newline='') as f: return list(csv.DictReader(f))


def dict_of(body):
    try: j = json.loads(body)
    except ValueError: return {}
    found = {}

    def walk(v):
        if isinstance(v, dict):
            for k, x in v.items():
                if isinstance(x, (dict, list)): walk(x)
                else: found[concept(k)] = '' if x is None else str(x)
        elif isinstance(v, list):
            for x in v: walk(x)
    walk(j); return found


def nk(s): return re.sub(r'[^a-z0-9]', '', str(s).lower())


def judge_shape(acols, arows, tcols, tr):
    """EG003·EG037 행 구성 — Measure 별 행 수·같은 (키,Measure) 중복·키당 Measure 수. 같은 인자로 얻은 두 결과의 공통 컬럼만 쓴다
    반환 (verdict, detail) · Measure 컬럼 없으면 None · FAIL = AS-IS 에 있는 Measure 가 TO-BE 0행 / AS-IS 한 행인 (키,Measure) 가 TO-BE 여러 행"""
    common = [(a, t) for a in acols for t in tcols if nk(a) == nk(t)]
    mc = next(((a, t) for a, t in common if re.fullmatch(r'(?i)measure(_?(nm|name|cd|code|id))?', a)), None)
    if not mc or not arows or not tr:
        return None
    ai = {a: i for i, a in enumerate(acols)}
    S = lambda v: '' if v is None else str(v).strip()
    ca, ct = {}, {}
    for r in arows: ca[S(r[ai[mc[0]]])] = ca.get(S(r[ai[mc[0]]]), 0) + 1
    for r in tr: ct[S(r.get(mc[1]))] = ct.get(S(r.get(mc[1])), 0) + 1
    if not set(ca) & set(ct):
        return 'REVIEW', f"[행 구성] Measure 표기가 양쪽에서 겹치지 않음 — AS-IS {sorted(ca)[:5]} · TO-BE {sorted(ct)[:5]}"
    keys = [(a, t) for a, t in common if (a, t) != mc and not re.search('(?i)CREAT|UPDATE|LAST_|_BY$|_DATE$|QTY|AMT|PRICE|SEQ|^W_?\\d|^M_?\\d|^D_?\\d|^\\d', a)
            and any(re.search(r'[A-Za-z가-힣]', S(r.get(t))) for r in tr[:200])][:8]
    gone = sorted(m for m in ca if m not in ct)
    diff = [f'{m} {ca[m]}↔{ct[m]}' for m in sorted(set(ca) & set(ct)) if ca[m] != ct[m]]
    extra = sorted(m for m in ct if m not in ca)
    if not keys:
        return ('FAIL' if gone else 'REVIEW' if diff or extra else 'PASS'), f"[행 구성] Measure {len(ct)}종 · 빠짐 {gone[:5]} · 행 수 차이 {diff[:4]} · TO-BE 전용 {extra[:5]} · 키 대조 없음"
    da, dt = {}, {}; pa, pt = {}, {}
    for r in arows:
        k = tuple(S(r[ai[a]]) for a, _ in keys); m = S(r[ai[mc[0]]]); da[(k, m)] = da.get((k, m), 0) + 1; pa.setdefault(k, set()).add(m)
    for r in tr:
        k = tuple(S(r.get(t)) for _, t in keys); m = S(r.get(mc[1])); dt[(k, m)] = dt.get((k, m), 0) + 1; pt.setdefault(k, set()).add(m)
    dup_a = sum(1 for v in da.values() if v > 1); dup_t = [km for km, v in dt.items() if v > 1]
    dist = lambda p: sorted({len(v) for v in p.values()})
    head = f"[행 구성] 키 {[a for a, _ in keys]} · 키당 Measure 수 AS-IS {dist(pa)[:6]} TO-BE {dist(pt)[:6]} · 중복 (키,Measure) AS-IS {dup_a} TO-BE {len(dup_t)}"
    if gone:
        return 'FAIL', f'{head} · AS-IS 있는 Measure TO-BE 0행 {gone[:5]}'
    if dup_t and not dup_a and len(arows) * 2 >= len(tr):  # AS-IS 행이 훨씬 적으면 '중복 없음'이 근거가 못 된다(2026-11-03 DMF0003 6행↔1738행)
        return 'FAIL', f'{head} · 한 행이어야 할 (키,Measure) 가 여러 행: {[km[1] + "/" + "/".join(km[0][:2]) for km in dup_t[:3]]}'
    if diff or extra or dist(pa) != dist(pt) or dup_a != len(dup_t):
        return 'REVIEW', f'{head} · 행 수 차이 {diff[:4]} · TO-BE 전용 {extra[:5]}'
    return 'PASS', f'{head} · Measure {len(ct)}종 행 수 일치'


def judge_time(a_sec, t_sec, a_rows, t_rows):
    """같은 인자 조회 시간(EG417) — TO-BE 가 10초를 넘고 AS-IS 의 3배를 넘으면 확인 대상 · DB 서버·데이터가 달라 FAIL 로 올리지 않는다"""
    if t_sec > 10 and t_sec > a_sec * 3:
        return 'ERROR', f'[확인 대상] 조회 시간 TO-BE {t_sec:.1f}초({t_rows}행) · AS-IS {a_sec:.1f}초({a_rows}행) — 3배 초과'
    return 'PASS', f'조회 시간 TO-BE {t_sec:.1f}초({t_rows}행) · AS-IS {a_sec:.1f}초({a_rows}행)'


