OPTIONS (SKIP=1, ROWS=1000, ERRORS=100)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE '/tmp/DM_MST_EXCHANGE_RATE.csv'
APPEND
INTO TABLE DM_MST_EXCHANGE_RATE
FIELDS TERMINATED BY ','
OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  DIVISION_ID         CHAR(120),
  YYYYMMDD            CHAR(32),
  CURRENCY            CHAR(40),
  UNIT_CURRENCY       CHAR(40),
  EXCHANGE_PRICE      "TO_NUMBER(:EXCHANGE_PRICE)",
  CREATED_BY          CHAR(600),
  CREATION_DATE       "TO_DATE(SUBSTR(:CREATION_DATE,1,19), 'YYYY-MM-DD HH24:MI:SS')",
  LAST_UPDATED_BY     CHAR(600),
  LAST_UPDATE_DATE    "TO_DATE(SUBSTR(:LAST_UPDATE_DATE,1,19), 'YYYY-MM-DD HH24:MI:SS')",
  ATTRIBUTE1          CHAR(600),
  ATTRIBUTE2          CHAR(600),
  ATTRIBUTE3          CHAR(600),
  ATTRIBUTE4          CHAR(600),
  ATTRIBUTE5          CHAR(600),
  ATTRIBUTE6          CHAR(600),
  ATTRIBUTE7          CHAR(600),
  ATTRIBUTE8          CHAR(600),
  ATTRIBUTE9          CHAR(600),
  ATTRIBUTE10         CHAR(600)
)
