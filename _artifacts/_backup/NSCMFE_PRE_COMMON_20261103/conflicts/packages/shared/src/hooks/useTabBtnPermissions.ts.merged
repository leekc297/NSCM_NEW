 */
interface MnuBtnAuthSheet {
  shtNm: string | null;
  btnCd: string;
}

export const useTabBtnPermissions = ({
  menuId,
  enabled = true,
  divisionId,
}: {
  menuId: string;
  enabled?: boolean;
  divisionId?: string;
}) => {
  // 'ALL'·복수 선택·빈값은 Division 축 없음(합집합) — 서버에 보내지 않아 캐시 키도 하나로 모인다
  const div = divisionId && !/^all$/i.test(divisionId) && !divisionId.includes(',') ? divisionId : '';
  const { data, isLoading, refetch } = useQuery({
    queryKey: ['menu-auth', menuId, div],
    queryFn: async () => {
<<<<<<< mine(local)
      const res = await apiClient.get<{ mnuBtnAuth: string[] }>(`/admin/menu/${menuId}/auth`, {
        params: div ? { divisionId: div } : undefined,
      });
      return res.data.result?.mnuBtnAuth ?? [];
=======
      const res = await apiClient.get<{
        mnuBtnAuth: string[];
        mnuBtnAuthSheets?: MnuBtnAuthSheet[];
        mnuBtnDefs?: MnuBtnAuthSheet[];
      }>(`/admin/menu/${menuId}/auth`);
      return {
        mnuBtnAuth: res.data.result?.mnuBtnAuth ?? [],
        mnuBtnAuthSheets: res.data.result?.mnuBtnAuthSheets ?? [],
        mnuBtnDefs: res.data.result?.mnuBtnDefs ?? [],
      };
