@echo off
REM AS-IS DQ tables 5종 export → c:\temp\asis_dq_*.txt
REM 사용법: 이 파일 더블 클릭 또는 cmd 에서 실행

set OUT=c:\temp
if not exist %OUT% mkdir %OUT%

set SQLCMD="C:\Program Files\SqlCmd\sqlcmd"
set CONN=-S "165.244.95.223,1433" -d LGCE_SCMDEV -U scp_mgr_dev -P "1234qwer" -C -W -s "|" -h-1 -k 1

echo === DQ_LIST ===
%SQLCMD% %CONN% -o %OUT%\asis_dq_list.txt -Q "SET NOCOUNT ON; SELECT DQ_ID, DIVISION_ID, DQ_NAME, DESCRIPTION, CAST(DQ_TEXT AS VARCHAR(4000)) AS DQ_TEXT, VALID_YN, ADMIN_ONLY_YN, CREATED_BY, CONVERT(VARCHAR(19), CREATION_DATE, 120) AS CREATION_DATE, LAST_UPDATED_BY, CONVERT(VARCHAR(19), LAST_UPDATE_DATE, 120) AS LAST_UPDATE_DATE FROM SCM_ADM_DQ_LIST"

echo === DQ_COLUMN ===
%SQLCMD% %CONN% -o %OUT%\asis_dq_column.txt -Q "SET NOCOUNT ON; SELECT DQ_ID, COLUMN_NAME, VALUE_YN, VALUE_TYPE, VALID_YN, CREATED_BY, CONVERT(VARCHAR(19), CREATION_DATE, 120) AS CREATION_DATE, LAST_UPDATED_BY, CONVERT(VARCHAR(19), LAST_UPDATE_DATE, 120) AS LAST_UPDATE_DATE FROM SCM_ADM_DQ_COLUMN"

echo === DQ_PARAMETER ===
%SQLCMD% %CONN% -o %OUT%\asis_dq_parameter.txt -Q "SET NOCOUNT ON; SELECT DQ_ID, PARAMETER_ID, PARAMETER_TYPE, OPERATION_ID, VALID_YN, REP_YN, CREATED_BY, CONVERT(VARCHAR(19), CREATION_DATE, 120) AS CREATION_DATE, LAST_UPDATED_BY, CONVERT(VARCHAR(19), LAST_UPDATE_DATE, 120) AS LAST_UPDATE_DATE FROM SCM_ADM_DQ_PARAMETER"

echo === DQ_USER_GROUP ===
%SQLCMD% %CONN% -o %OUT%\asis_dq_user_group.txt -Q "SET NOCOUNT ON; SELECT DQ_ID, GROUP_ID, VALID_YN, CREATED_BY, CONVERT(VARCHAR(19), CREATION_DATE, 120) AS CREATION_DATE, LAST_UPDATED_BY, CONVERT(VARCHAR(19), LAST_UPDATE_DATE, 120) AS LAST_UPDATE_DATE FROM SCM_ADM_DQ_USER_GROUP"

echo === DQ_EXECUTE_H ===
%SQLCMD% %CONN% -o %OUT%\asis_dq_execute_h.txt -Q "SET NOCOUNT ON; SELECT TOP 100 * FROM SCM_ADM_DQ_EXECUTE_H ORDER BY CREATION_DATE DESC"

echo.
echo === DONE ===
echo Output: %OUT%\asis_dq_*.txt
dir %OUT%\asis_dq_*.txt
pause
