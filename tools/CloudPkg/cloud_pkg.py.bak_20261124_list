# ───────────────────────── SQL 리터럴 ─────────────────────────
def lit(v, dtype='VARCHAR2'):
    if v is None:
        return 'NULL'
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return repr(v) if not isinstance(v, float) or not v.is_integer() else str(int(v))
    if hasattr(v, 'is_integer') and dtype == 'NUMBER':  # Decimal
        return str(v)
    if isinstance(v, datetime.datetime):
        return f"TO_DATE('{v:%Y-%m-%d %H:%M:%S}', 'YYYY-MM-DD HH24:MI:SS')"
    s = str(v)
    if dtype == 'NUMBER':
        return s
    parts = re.split(r'(\r\n|\n|\r)', s)
    out = []
    for p in parts:
        if p in ('\r\n', '\n', '\r'):
            out.append({'\r\n': 'CHR(13) || CHR(10)', '\n': 'CHR(10)', '\r': 'CHR(13)'}[p])
        elif p != '':
            out.append("'" + p.replace("'", "''") + "'")
    if not out:
        return "''"
    return ' || '.join(out)


def qq(text):
    """PL/SQL q-quote — 본문에 없는 구분자 선택"""
    for o, c in (('~', '~'), ('!', '!'), ('#', '#'), ('^', '^'), ('|', '|'), ('[', ']'), ('{', '}'), ('<', '>')):
        if (c + "'") not in text:
            return f"q'{o}{text}{c}'"
    raise ValueError('q-quote 구분자 없음')


def clob_assign(var, text, indent='    '):
    """긴 SQL 문자열을 CLOB 변수에 나눠 붙이는 PL/SQL 줄들(줄당 8,000자 이하)"""
    lines = [f"{indent}{var} := NULL;"]
    chunk = 8000
    for i in range(0, len(text), chunk):
        lines.append(f"{indent}{var} := {var} || {qq(text[i:i + chunk])};")
    return lines


