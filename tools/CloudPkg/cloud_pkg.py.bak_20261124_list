class _Conn:
    pass


def owner_conn():
    """리허설 = 패키지 소유 계정(SCM_MGR)으로 접속 — 생성 SQL 이 USER_* 뷰를 쓰므로(system 접속이면 USER_* 가 SYSTEM 기준)"""
    import oracledb
    r = dbconn.resolve('tobe', dbconn.load_cfg())
    cx = oracledb.connect(user=OWNER, password=r['password'], dsn=f"{r['host']}:{r['port']}/{r['service']}")
    o = _Conn(); o.cx = cx; o.cur = cx.cursor()
    o.cur.execute('SELECT USER FROM DUAL')
    if o.cur.fetchone()[0] != OWNER:
        raise RuntimeError('리허설 계정이 SCM_MGR 아님')
    return o


def rehearse(c0, pkg_dir, ctx, files):
    import run_sql
    out = []
    c = owner_conn()
    cur = c.cur

    def run_file(fname, transform=None, commit=False):
        path = os.path.join(pkg_dir, 'A_DB', fname)
        text = open(path, encoding='utf-8').read()
        if transform:
            text = transform(text)
        stmts = run_sql.split_script(text, {})
        cur.callproc('DBMS_OUTPUT.ENABLE', [None])
        res = {'file': fname, 'stmts': len(stmts), 'fail': 0, 'notes': []}
        for kind, st in stmts:
            sql = st.strip()
            if not sql:
                continue
            if re.match(r'^COMMIT\b', sql, re.I) and not commit:
                c.cx.rollback()
                res['notes'].append('COMMIT → ROLLBACK(리허설)')
                continue
            try:
                cur.execute(sql)
                if re.match(r'^\s*SELECT', sql, re.I):
                    rows = cur.fetchall()
                    res['notes'].append(f'SELECT {len(rows)}행' + (f' — {rows[:3]}' if rows and len(rows) <= 3 else ''))
                elif re.match(r'^\s*(MERGE|INSERT|UPDATE|DELETE)', sql, re.I):
                    res.setdefault('dml_rows', 0)
                    res['dml_rows'] += cur.rowcount or 0
            except Exception as e:
                res['fail'] += 1
                res['notes'].append('FAIL ' + str(e).splitlines()[0][:200] + ' :: ' + re.sub(r'\s+', ' ', sql)[:120])
            lv = cur.var(str)
            stv = cur.var(int)
            while True:
                cur.callproc('DBMS_OUTPUT.GET_LINE', (lv, stv))
                if stv.getvalue() != 0:
                    break
                res['notes'].append('> ' + (lv.getvalue() or ''))
        if not commit:
            c.cx.rollback()
        return res

    dry = lambda t: t.replace('c_dry   CONSTANT BOOLEAN := FALSE', 'c_dry   CONSTANT BOOLEAN := TRUE').replace('c_dry CONSTANT BOOLEAN := FALSE', 'c_dry CONSTANT BOOLEAN := TRUE')
    names = sorted(os.listdir(os.path.join(pkg_dir, 'A_DB')))
    for f in names:
        if f.startswith('00_') or f.startswith('90_'):
            out.append(run_file(f))
        elif f.startswith('05_'):
            out.append(run_file(f, commit=True))  # ZB 백업표 생성(사내) — 끝에 삭제
        elif f.startswith('10_') or f.startswith('40_'):
            out.append(run_file(f, transform=dry))
        elif f.startswith('30_'):
            r = run_file(f)
            r['notes'].insert(0, f"사내 기준 변경 행 {r.get('dml_rows', 0)} (0 이 정상 — 사내가 원천)")
            out.append(r)
        elif f.startswith('20_'):
            # 1.3.0: 지문 비교 블록 실행(DRY — 컴파일 안 함). 사내 = 원천이므로 전부 SKIP 이어야 정상
            r = run_file(f, transform=dry)
            if any(n.startswith('> DRY') for n in r['notes']):
                r['fail'] += 1
                r['notes'].insert(0, 'FAIL 사내 지문 불일치 — 빌드 후 사내 원문이 바뀜(다시 생성)')
            out.append(r)
        elif f.startswith('25_'):
            # 컴파일하지 않음(사내 현행 원문 그대로 · 세션 상태 무효화 방지) — 문장 분할만 점검
            import run_sql as rs
            st = rs.split_script(open(os.path.join(pkg_dir, 'A_DB', f), encoding='utf-8').read(), {})
            out.append({'file': f, 'stmts': len(st), 'fail': 0, 'notes': ['컴파일 생략(사내 원문 그대로) · 문장 분할 확인']})
    for f in names:
        if f.startswith('99_'):
            out.append(run_file(f, transform=dry))
    # 백업표 정리
    cur.execute("SELECT TABLE_NAME FROM USER_TABLES WHERE TABLE_NAME LIKE :p", p=f"ZB\\_{ctx['tag']}\\_%".replace('\\', ''))
    zbs = [r[0] for r in cur.fetchall() if r[0].startswith(f"ZB_{ctx['tag']}_")]
    for t in zbs:
        cur.execute(f'DROP TABLE {t} PURGE')
    out.append({'file': '(정리)', 'stmts': len(zbs), 'fail': 0, 'notes': [f'리허설 백업표 {len(zbs)}개 삭제']})
    c.cx.close()
    return out


