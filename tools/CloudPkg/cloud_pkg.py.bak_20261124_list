def mark_applied(ID, mode):
    """마지막 생성 패키지를 이관 기준선으로 확정한다. 클라우드 적용 여부는 빌더가 알 수 없어 사용자 표시로만 옮긴다."""
    st = load_state(ID)
    recs = [r for k, r in (st or {}).get('built', {}).items() if k.startswith(f'{mode}_')]
    if not recs and (st or {}).get('items'):
        # 1.1.0 이전에 만든 state — 기준선이 곧 마지막 생성분이라 값은 그대로 두고 확정 표시만 한다.
        pkg = latest_pkg(ID, mode)
        st.update(applied_at=now().strftime('%Y-%m-%d %H:%M:%S'), applied_pkg=pkg)
        write_state(ID, st)
        print(f"✅ 이관 완료 표시 · {pkg} (기준선 {st.get('built_at', '?')}) — 다음 수정본은 이 시점 이후 변경분만 담는다.")
        return 0
    if not recs:
        print(f'⚠ {ID}: 범위 {mode} 로 생성한 패키지 기록이 없어 기준선을 옮기지 않았다.')
        return 2
    rec = max(recs, key=lambda r: r['built'])
    if not os.path.isdir(os.path.join(PKG_ROOT, rec['pkg'])):
        print(f"⚠ {ID}: 마지막 패키지 폴더 없음({rec['pkg']}) — 기준선을 옮기지 않았다.")
        return 2
    for k, v in rec['items'].items():
        if mode == 'all' or not k.startswith(('FE:', 'BE:', 'BEF:')):
            st['items'][k] = v
    st.update(built_at=rec['built'], mode=mode, applied_at=now().strftime('%Y-%m-%d %H:%M:%S'), applied_pkg=rec['pkg'])
    write_state(ID, st)
    bs = os.path.join(STATE_ROOT, ID, 'built_src', rec['pkg'])
    if os.path.isdir(bs):   # 1.4.0: 다음 수정본 PKG 패치의 기준본
        ap = os.path.join(STATE_ROOT, ID, 'applied_src')
        if os.path.isdir(ap):
            shutil.rmtree(ap)
        shutil.copytree(bs, ap)
    print(f"✅ 이관 완료 표시 · {rec['pkg']} ({rec['built']} 생성) — 다음 수정본은 이 시점 이후 변경분만 담는다.")
    return 0


def latest_pkg(ID, mode, scope=None):
    """적용할 파일이 든 가장 최근 패키지. scope 없음 = 수정본·전체 무관, 'delta' = 수정본(MOD)만, 'full' = 전체(FULL)만. 00·90 만 있는 빈 패키지는 건너뛴다."""
    kind = {'delta': 'MOD', 'full': 'FULL'}.get(scope, 'MOD|FULL')
    pat = re.compile(rf"^{ID}_CLOUD_{'DBUI' if mode == 'all' else 'DB'}_({kind})_(\d{{8}}_\d{{4}}(?:\d{{2}})?)$")
    found = []
    for d in os.listdir(PKG_ROOT):
        m = pat.match(d)
        adb = os.path.join(PKG_ROOT, d, 'A_DB')
        if m and os.path.isdir(adb) and any(not f.startswith(('00_', '90_')) for f in os.listdir(adb)):
            found.append((m.group(2), d))
    return max(found)[1] if found else None


