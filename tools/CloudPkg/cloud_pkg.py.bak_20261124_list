class Corp:
    def __init__(self):
        self.cfg = dbconn.load_cfg()
        self.cx = dbconn.connect('tobe', self.cfg, write=True)
        self.cur = self.cx.cursor()
        self.cur.execute("SELECT SYS_CONTEXT('USERENV','SERVER_HOST'), SYS_CONTEXT('USERENV','DB_NAME'), USER, TO_CHAR(SYSDATE,'YYYY-MM-DD HH24:MI:SS') FROM DUAL")
        self.host, self.dbname, self.user, self.fetched = self.cur.fetchone()

    def q(self, sql, **b):
        self.cur.execute(sql, b)
        cols = [d[0] for d in self.cur.description]
        return [dict(zip(cols, r)) for r in self.cur.fetchall()]

    def lob(self, v):
        return v.read() if hasattr(v, 'read') else v


def collect_db(c, ID, ctx):
    """화면 소유 객체·공용 의존·META·권한 수집 → dict"""
    D = {}
    idre = f'(^|_){ID}(_|$)'
    objs = c.q(f"""SELECT OBJECT_NAME, OBJECT_TYPE, STATUS, TO_CHAR(LAST_DDL_TIME,'YYYY-MM-DD HH24:MI:SS') LAST_DDL
                     FROM ALL_OBJECTS WHERE OWNER = '{OWNER}' AND REGEXP_LIKE(OBJECT_NAME, :r)
                      AND OBJECT_TYPE IN ('PACKAGE','PACKAGE BODY','PROCEDURE','FUNCTION','TYPE','TYPE BODY','TABLE','VIEW','SEQUENCE','INDEX','SYNONYM')
                    ORDER BY OBJECT_NAME, OBJECT_TYPE""", r=idre)
    D['excluded'] = sorted({o['OBJECT_NAME'] for o in objs if EXCLUDE_NAME.search(o['OBJECT_NAME'])})
    objs = [o for o in objs if not EXCLUDE_NAME.search(o['OBJECT_NAME']) and o['OBJECT_TYPE'] not in ('INDEX', 'SYNONYM')]
    D['objects'] = objs
    names = sorted({o['OBJECT_NAME'] for o in objs})
    D['names'] = names
    inlist = lambda xs: ','.join("'" + x.replace("'", "''") + "'" for x in xs) or "'~'"

    # 코드 원문
    code = {}
    for o in objs:
        if o['OBJECT_TYPE'] in CODE_TYPES:
            rows = c.q("SELECT TEXT FROM ALL_SOURCE WHERE OWNER = :o AND NAME = :n AND TYPE = :t ORDER BY LINE", o=OWNER, n=o['OBJECT_NAME'], t=o['OBJECT_TYPE'])
            code[(o['OBJECT_NAME'], o['OBJECT_TYPE'])] = ''.join(r['TEXT'] or '' for r in rows)
    D['code'] = code
    # 뷰
    views = {}
    for o in objs:
        if o['OBJECT_TYPE'] == 'VIEW':
            r = c.q("SELECT TEXT FROM ALL_VIEWS WHERE OWNER = :o AND VIEW_NAME = :n", o=OWNER, n=o['OBJECT_NAME'])
            cols = c.q("SELECT COLUMN_NAME FROM ALL_TAB_COLUMNS WHERE OWNER = :o AND TABLE_NAME = :n ORDER BY COLUMN_ID", o=OWNER, n=o['OBJECT_NAME'])
            views[o['OBJECT_NAME']] = {'text': c.lob(r[0]['TEXT']) if r else '', 'cols': [x['COLUMN_NAME'] for x in cols]}
    D['views'] = views
    # 테이블(GTT/영구)
    tabs = {}
    for o in objs:
        if o['OBJECT_TYPE'] != 'TABLE':
            continue
        t = o['OBJECT_NAME']
        ti = c.q("SELECT TEMPORARY, DURATION FROM ALL_TABLES WHERE OWNER = :o AND TABLE_NAME = :t", o=OWNER, t=t)
        if not ti:
            continue
        cols = c.q("""SELECT COLUMN_NAME, DATA_TYPE, CHAR_LENGTH, CHAR_USED, DATA_LENGTH, DATA_PRECISION, DATA_SCALE, NULLABLE, DATA_DEFAULT
                        FROM ALL_TAB_COLUMNS WHERE OWNER = :o AND TABLE_NAME = :t ORDER BY COLUMN_ID""", o=OWNER, t=t)
        for cc in cols:
            cc['DATA_DEFAULT'] = (c.lob(cc['DATA_DEFAULT']) or '').strip() or None
        idx = []
        for ix in c.q("SELECT INDEX_NAME, UNIQUENESS FROM ALL_INDEXES WHERE TABLE_OWNER = :o AND TABLE_NAME = :t AND INDEX_TYPE LIKE '%NORMAL%' ORDER BY 1", o=OWNER, t=t):
            ic = c.q("SELECT COLUMN_NAME, DESCEND FROM ALL_IND_COLUMNS WHERE INDEX_OWNER = :o AND INDEX_NAME = :i ORDER BY COLUMN_POSITION", o=OWNER, i=ix['INDEX_NAME'])
            idx.append({'name': ix['INDEX_NAME'], 'unique': ix['UNIQUENESS'] == 'UNIQUE', 'cols': [x['COLUMN_NAME'] + (' DESC' if x['DESCEND'] == 'DESC' else '') for x in ic]})
        pk = c.q("""SELECT C.CONSTRAINT_NAME, LISTAGG(K.COLUMN_NAME, ',') WITHIN GROUP (ORDER BY K.POSITION) COLS
                      FROM ALL_CONSTRAINTS C JOIN ALL_CONS_COLUMNS K ON K.OWNER = C.OWNER AND K.CONSTRAINT_NAME = C.CONSTRAINT_NAME
                     WHERE C.OWNER = :o AND C.TABLE_NAME = :t AND C.CONSTRAINT_TYPE = 'P' GROUP BY C.CONSTRAINT_NAME""", o=OWNER, t=t)
        sig = c.q("""SELECT LISTAGG(COLUMN_NAME||'|'||DATA_TYPE||'|'||CHAR_LENGTH||'|'||DATA_PRECISION||'|'||DATA_SCALE||'|'||NULLABLE, ';')
                            WITHIN GROUP (ORDER BY COLUMN_ID) S FROM ALL_TAB_COLUMNS WHERE OWNER = :o AND TABLE_NAME = :t""", o=OWNER, t=t)[0]['S']
        ddl = None
        if ti[0]['TEMPORARY'] != 'Y':
            ddl = metadata_ddl(c, 'TABLE', t)
        tabs[t] = {'temp': ti[0]['TEMPORARY'] == 'Y', 'duration': ti[0]['DURATION'], 'cols': cols, 'idx': idx, 'pk': pk[0] if pk else None, 'sig': sig, 'ddl': ddl}
    D['tables'] = tabs
    # TYPE / SEQUENCE DDL(없을 때만 생성용)
    D['seq_ddl'] = {o['OBJECT_NAME']: metadata_ddl(c, 'SEQUENCE', o['OBJECT_NAME']) for o in objs if o['OBJECT_TYPE'] == 'SEQUENCE'}
    # 권한·시노님
    D['grants'] = c.q(f"""SELECT TABLE_NAME, GRANTEE, LISTAGG(PRIVILEGE, ', ') WITHIN GROUP (ORDER BY PRIVILEGE) PRIVS
                           FROM ALL_TAB_PRIVS WHERE TABLE_SCHEMA = '{OWNER}' AND TABLE_NAME IN ({inlist(names)})
                          GROUP BY TABLE_NAME, GRANTEE ORDER BY 1, 2""")
    D['synonyms'] = c.q(f"""SELECT OWNER, SYNONYM_NAME, TABLE_OWNER, TABLE_NAME FROM ALL_SYNONYMS
                            WHERE TABLE_OWNER = '{OWNER}' AND TABLE_NAME IN ({inlist(names)}) AND OWNER <> 'PUBLIC' ORDER BY 1, 2""")
    # 공용 의존(화면 소유가 아닌 참조)
    deps = c.q(f"""SELECT DISTINCT D.REFERENCED_OWNER RO, D.REFERENCED_NAME RN, D.REFERENCED_TYPE RT
                     FROM ALL_DEPENDENCIES D
                    WHERE D.OWNER = '{OWNER}' AND D.NAME IN ({inlist(names)})
                      AND D.REFERENCED_OWNER NOT IN ('SYS','PUBLIC','SYSTEM','XDB','MDSYS','CTXSYS','ORDSYS')
                      AND D.REFERENCED_TYPE IN ('TABLE','VIEW','PACKAGE','PROCEDURE','FUNCTION','TYPE','SEQUENCE','SYNONYM')
                    ORDER BY 1, 2""")
    deps = [d for d in deps if not (d['RO'] == OWNER and d['RN'] in names)]
    # 2026-11-06 W8: 동적 SQL(문자열) 안의 참조는 ALL_DEPENDENCIES 에 없다(SCP0016 WATERFALL 의 재고 뷰 SCP_PLN_SALES_ONHAND_V·SCP_OPT_PLANT_ONHAND_V)
    #   → 화면 코드 원문의 식별자 토큰 중 SCM_MGR 실존 객체를 공용 의존(DYN=Y)으로 추가 — H14 패치 파일 매칭·00 PRECHECK 대상이 된다
    try:
        toks = set()
        for src in D['code'].values():
            toks |= set(re.findall(r'\b([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+)\b', src or ''))
        have = {d['RN'] for d in deps} | set(names)
        cand = sorted(t for t in toks if t not in have and len(t) >= 8)
        for i in range(0, len(cand), 500):
            for r in c.q(f"""SELECT OBJECT_NAME RN, OBJECT_TYPE RT FROM ALL_OBJECTS WHERE OWNER = '{OWNER}'
                              AND OBJECT_TYPE IN ('TABLE','VIEW','PACKAGE','PROCEDURE','FUNCTION','TYPE','SEQUENCE') AND OBJECT_NAME IN ({inlist(cand[i:i + 500])})"""):
                deps.append({'RO': OWNER, 'RN': r['RN'], 'RT': r['RT'], 'DYN': 'Y'})
    except Exception as _ex:
        print(f'[WARN] 동적 SQL 참조 수집 실패(ALL_DEPENDENCIES 만 사용): {_ex}')
    for d in deps:
        st = c.q("""SELECT MAX(STATUS) ST, TO_CHAR(MAX(LAST_DDL_TIME),'YYYY-MM-DD HH24:MI:SS') LD FROM ALL_OBJECTS
                     WHERE OWNER = :o AND OBJECT_NAME = :n AND OBJECT_TYPE IN (:t, :t || ' BODY')""", o=d['RO'], n=d['RN'], t=d['RT'])
        d['STATUS'], d['LAST_DDL'] = (st[0]['ST'], st[0]['LD']) if st else (None, None)
        if d['RT'] in ('TABLE', 'VIEW'):
            d['COLS'] = [x['COLUMN_NAME'] for x in c.q("SELECT COLUMN_NAME FROM ALL_TAB_COLUMNS WHERE OWNER = :o AND TABLE_NAME = :t ORDER BY COLUMN_ID", o=d['RO'], t=d['RN'])]
    D['deps'] = deps
    # META
    D['meta'] = collect_meta(c, ID, D, ctx)
    return D


def metadata_ddl(c, typ, name):
    try:
        c.cur.execute("""BEGIN
            DBMS_METADATA.SET_TRANSFORM_PARAM(DBMS_METADATA.SESSION_TRANSFORM, 'SEGMENT_ATTRIBUTES', FALSE);
            DBMS_METADATA.SET_TRANSFORM_PARAM(DBMS_METADATA.SESSION_TRANSFORM, 'STORAGE', FALSE);
            DBMS_METADATA.SET_TRANSFORM_PARAM(DBMS_METADATA.SESSION_TRANSFORM, 'EMIT_SCHEMA', FALSE);
            DBMS_METADATA.SET_TRANSFORM_PARAM(DBMS_METADATA.SESSION_TRANSFORM, 'SQLTERMINATOR', FALSE);
            DBMS_METADATA.SET_TRANSFORM_PARAM(DBMS_METADATA.SESSION_TRANSFORM, 'REF_CONSTRAINTS', FALSE);
          END;""")
        c.cur.execute("SELECT DBMS_METADATA.GET_DDL(:t, :n, :o) FROM DUAL", t=typ, n=name, o=OWNER)
        v = c.cur.fetchone()[0]
        return (v.read() if hasattr(v, 'read') else v).strip()
    except Exception as e:
        return f'-- DDL 추출 실패: {str(e).splitlines()[0]}'


