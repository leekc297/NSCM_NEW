    ap = argparse.ArgumentParser(description='클라우드 이관 패키지 결정적 빌더')
    ap.add_argument('id')
    ap.add_argument('--mode', choices=['auto', 'db', 'all'], default='auto', help='auto = 환경설정 작업 모드(DB MODE → db · UI/DB MODE → all)')
    ap.add_argument('--stage', action='store_true', help='미리 만들어 둠(_staging) — 기준선 미갱신 · 작업 모드 범위의 수정본+전체')
    ap.add_argument('--full', action='store_true', help='전체 — 수정본이 아니라 화면 소유 DB·META 전부 + FE 페이지·참조 파일·ID 참조 BE 전부')
    ap.add_argument('--no-rehearse', action='store_true')
    ap.add_argument('--fetch', action='store_true', help='FE/BE 판정 전 공통소스 최신 받기(git fetch)')
    ap.add_argument('--applied', action='store_true', help='클라우드 적용 완료 표시 — 마지막 생성 패키지를 이관 기준선으로 확정')
    ap.add_argument('--since', help="기준선이 없을 때 수정본 기준 시각 직접 지정 'YYYY-MM-DD HH:MI' (기본 = 가장 최근 수정일 0시)")
    a = ap.parse_args()
    if a.since and not re.match(r'^\d{4}-\d{2}-\d{2}( \d{2}:\d{2}(:\d{2})?)?$', a.since.strip()):
        sys.exit(f"--since 형식 아님: {a.since} (예: 2026-11-11 09:00)")
    ID = a.id.strip().upper()
    if not re.match(r'^[A-Z]{2,4}\d{4}$', ID):
        sys.exit(f'화면 ID 형식 아님: {ID}')
    auto_mode = a.mode == 'auto'
    if auto_mode:
        a.mode = work_mode_scope()
    if a.applied:
        return mark_applied(ID, a.mode)
    need_fe = a.mode == 'all'
    scope_src = ('작업 모드 ' + ('UI/DB MODE' if a.mode == 'all' else 'DB MODE')) if auto_mode else '직접 지정'
    log(f'cloud_pkg {VERSION} · {ID} · 범위 {a.mode}({scope_src}) · {"stage(수정본+전체)" if a.stage else ("전체" if a.full else "수정본")}')

    ctx = {'ID': ID, 'built': now()}
    # FE 텍스트(MSG·콤보 탐색용) — 모드 무관(DB 메타가 FE 가 부르는 문구·콤보를 포함해야 함)
    pdir = page_dir(ID)
    fe_texts = []
    if pdir:
        for dp, dn, fn in os.walk(pdir):
            for f in fn:
                if f.endswith(('.ts', '.tsx', '.json')):
                    try:
                        fe_texts.append(open(os.path.join(dp, f), encoding='utf-8', errors='replace').read())
                    except Exception:
                        pass
    ctx['fe_texts'] = fe_texts

    c = Corp()
    ctx.update(host=c.host, db=c.dbname, fetched=c.fetched)
    log(f'사내 접속 {c.dbname} SERVER_HOST={c.host} · {c.user}')
    D = collect_db(c, ID, ctx)
    log(f"화면 객체 {len(D['objects'])} · 공용 참조 {len(D['deps'])} · META {sum(len(m['rows']) for m in D['meta'])}행")
    D['srchash'] = {}
    for (n, t) in D['code']:
        r = c.q(f"SELECT NVL(SUM(ORA_HASH(LINE || '~' || TEXT)), 0) H, COUNT(*) N FROM ALL_SOURCE WHERE OWNER = '{OWNER}' AND NAME = :n AND TYPE = :t", n=n, t=t)[0]
        D['srchash'][(n, t)] = (int(r['H']), int(r['N']))
    # 1.4.0: 수정본 PKG/코드 = 기준본 대비 바뀐 구간만 패치(patchgen) — 기준본 없거나 검증 실패면 전체 원문(지문 가드)
    D['patch'] = {}
    if not a.full or a.stage:
        for (n, t), src0 in D['code'].items():
            ld = next((o['LAST_DDL'] for o in D['objects'] if o['OBJECT_NAME'] == n and o['OBJECT_TYPE'] == t), None)
            ld_ts = datetime.datetime.strptime(ld, '%Y-%m-%d %H:%M:%S').timestamp() if ld else None
            base, label = patchgen.find_base(ROOT, STATE_ROOT, ID, n, t, src0, ld_ts)
            hh, ll = patchgen.expect_hash(c.cur, patchgen.norm(src0))
            if base is None:
                D['patch'][(n, t)] = {'kind': 'same' if '같음' in label else 'full', 'why': label, 'label': label, 'h': hh, 'l': ll}
                log(f"PKG 수정분 {t} {n}: {D['patch'][(n, t)]['kind']} · {label}")
                continue
            hunks, why = patchgen.make_hunks(base, src0)
            if hunks is None:
                D['patch'][(n, t)] = {'kind': 'full', 'why': f'{label} — {why}', 'label': label, 'h': hh, 'l': ll}
            elif not hunks:
                D['patch'][(n, t)] = {'kind': 'same', 'why': label, 'label': label, 'h': hh, 'l': ll}
            else:
                D['patch'][(n, t)] = {'kind': 'patch', 'hunks': hunks, 'why': why, 'label': label, 'h': hh, 'l': ll}
            log(f"PKG 수정분 {t} {n}: {D['patch'][(n, t)]['kind']} · {D['patch'][(n, t)]['why'] if D['patch'][(n, t)]['kind'] != 'patch' else why + ' · ' + label}")

    # ── 이관 대상 항목 + 해시
    items = {}
    for (n, t), src in D['code'].items():
        items[f'CODE:{n}:{t}'] = hashlib.sha1(src.encode('utf-8')).hexdigest()
    for n, v in D['views'].items():
        items[f'CODE:{n}:VIEW'] = sha(v)
    for t, info in D['tables'].items():
        items[f'TAB:{t}'] = sha({'sig': info['sig'], 'idx': info['idx'], 'temp': info['temp']})
    for s in D['seq_ddl']:
        items[f'SEQ:{s}'] = 'exists'
    for gr in D['grants']:
        items[f"GRANT:{gr['TABLE_NAME']}:{gr['GRANTEE']}"] = gr['PRIVS']
    for sy in D['synonyms']:
        items[f"SYN:{sy['OWNER']}.{sy['SYNONYM_NAME']}"] = sy['TABLE_NAME']
    for i, m in enumerate(D['meta']):
        for r in m['rows']:
            k = '|'.join(str(r.get(x)) for x in m['key'])
            items[f"META:{m['table']}:{m['mode']}:{k}"] = sha({cc['COLUMN_NAME']: r.get(cc['COLUMN_NAME']) for cc in m['cols'] if cc['COLUMN_NAME'] not in AUDIT})
    # 공용 객체 패치 파일(H14) — Doc/gen/<ID>/<공용객체>_*_<ID>.sql
    shared_files = []
    gdir = os.path.join(GEN_ROOT, ID)
    dep_names = {d['RN'] for d in D['deps']}
    if os.path.isdir(gdir):
        for f in sorted(os.listdir(gdir)):
            if f.endswith(f'_{ID}.sql') and any(f.startswith(dn + '_') or f == f'{dn}_{ID}.sql' for dn in dep_names):
                p = os.path.join(gdir, f)
                shared_files.append(p)
                items[f'SHARED:{f}'] = hashlib.sha1(open(p, 'rb').read()).hexdigest()

    # FE/BE
    fe_info = be_info = None
    if need_fe:
        tip_ref = 'refs/remotes/common/main'
        if a.fetch:
            r = subprocess.run(['git', '-C', FE_ROOT, 'fetch', 'common', 'main'], capture_output=True, text=True, timeout=120)
            log('공통소스 fetch ' + ('OK' if r.returncode == 0 else 'FAIL — 기존 참조로 계속'))
        tipc = subprocess.run(['git', '-C', FE_ROOT, 'log', '-1', '--format=%h %ci', tip_ref], capture_output=True, text=True).stdout.strip()
        ctx['tip'] = tipc
        if pdir:
            files, related, pageRel = fe_candidates(ID, pdir)
            wd = os.path.join(ROOT, '.vibe', 'cloudpkg', f'{ID}_{now():%Y%m%d_%H%M%S}')
            summ = fe_judge(ID, files + related, tip_ref, wd)
            fe_info = {'pageRel': pageRel, 'files': files, 'related': related, 'judge': summ['files'], 'wd': wd}
            for fj in summ['files']:
                fp = os.path.join(FE_ROOT, fj['rel'])
                items[f"FE:{fj['rel']}"] = (hashlib.sha1(open(fp, 'rb').read()).hexdigest() if os.path.exists(fp) else '-') + ':' + fj['mode']
        else:
            fe_info = {'pageRel': None, 'files': [], 'related': [], 'judge': []}
        bres, bother = be_judge(ID, tip_ref)
        be_delta = {'judge': bres, 'other': bother}
        for b in bres:
            fp = os.path.join(BE_ROOT, b['rel'])
            items[f"BE:{b['rel']}"] = hashlib.sha1(open(fp, 'rb').read()).hexdigest() + ':' + b['mode']
        need_full = a.stage or a.full
        be_full = be_delta
        if need_full:
            fres, _ = be_judge(ID, tip_ref, full=True)
            be_full = {'judge': fres, 'other': bother}
            for b in fres:
                fp = os.path.join(BE_ROOT, b['rel'])
                items[f"BEF:{b['rel']}"] = hashlib.sha1(open(fp, 'rb').read()).hexdigest() + ':' + b['mode']
        be_info = be_delta
        log(f"FE 후보 {len(fe_info['judge'])} · BE 후보 {len(bres)}" + (f" · BE 전체(ID 참조) {len(be_full['judge'])}" if need_full else ''))

    # ── 사내 수정 시각(기준선 없을 때 '최근 수정분만' 판정용 · 1.2.0)
    def _ts(v):
        if v is None:
            return None
        return v.strftime('%Y-%m-%d %H:%M:%S') if hasattr(v, 'strftime') else str(v)[:19]
    obj_ddl = {(o['OBJECT_NAME'], o['OBJECT_TYPE']): o.get('LAST_DDL') for o in D['objects']}
    modt = {}
    for (n, t) in D['code']:
        modt[f'CODE:{n}:{t}'] = obj_ddl.get((n, t))
    for n in D['views']:
        modt[f'CODE:{n}:VIEW'] = obj_ddl.get((n, 'VIEW'))
    for t in D['tables']:
        modt[f'TAB:{t}'] = obj_ddl.get((t, 'TABLE'))
    for s in D['seq_ddl']:
        modt[f'SEQ:{s}'] = obj_ddl.get((s, 'SEQUENCE'))
    for m in D['meta']:
        for r in m['rows']:
            k = f"META:{m['table']}:{m['mode']}:" + '|'.join(str(r.get(x)) for x in m['key'])
            modt[k] = max([x for x in (_ts(r.get('CREATION_DATE')), _ts(r.get('LAST_UPDATE_DATE'))) if x] or [None]) if any((r.get('CREATION_DATE'), r.get('LAST_UPDATE_DATE'))) else None
    for p in shared_files:
        modt[f'SHARED:{os.path.basename(p)}'] = datetime.datetime.fromtimestamp(os.path.getmtime(p)).strftime('%Y-%m-%d %H:%M:%S')
    known = [v for v in modt.values() if v]
    if a.since:
        since_auto = a.since.strip() + ('' if len(a.since.strip()) > 10 else ' 00:00') + ('' if a.since.strip().count(':') >= 2 else ':00')
    else:
        since_auto = (max(known)[:10] + ' 00:00:00') if known else None

    state0 = load_state(ID)
    variants = [(a.mode, s) for s in ('delta', 'full')] if a.stage else [(a.mode, 'full' if a.full else 'delta')]

    for mode, scope in variants:
        state = None if scope == 'full' or not (state0 or {}).get('items') else state0
        prev = (state or {}).get('items', {})
        recent = scope == 'delta' and state is None and since_auto is not None
        ctx['since'] = since_auto if recent else None
        if recent:
            # 기준선 없음 → 사내 수정 시각이 기준 시각 이후인 항목만. FE/BE 는 공통소스 판정(내 수정분)을 그대로 따른다.
            changed = (lambda k, _s=since_auto: k.startswith(('FE:', 'BE:', 'BEF:')) or bool(modt.get(k)) and modt[k] >= _s)
            ctx['older'] = sum(1 for k, v in modt.items() if v and v < since_auto)
            ctx['notime'] = sum(1 for k in items if k in modt and not modt[k])
        else:
            changed = (lambda k: True) if state is None else (lambda k, _p=prev: _p.get(k) != items[k])
        if mode == 'all' and be_info is not None:
            be_info = be_full if scope == 'full' else be_delta
        sub_items = {k: v for k, v in items.items() if (mode == 'all' or not k.startswith(('FE:', 'BE:', 'BEF:'))) and not (k.startswith('BEF:') and scope != 'full') and not (k.startswith('BE:') and scope == 'full')}
        fp = sha({'v': VERSION, 'mode': mode, 'scope': scope, 'items': sub_items, 'state': sha(prev), 'since': ctx['since'], 'patch': sha({f'{k[0]}:{k[1]}': (v['kind'], v['label'], v['h'], v['l']) for k, v in D['patch'].items()}) if scope == 'delta' else ''})
        vname = variant_name(mode, scope)
        stage_dir = os.path.join(STAGE_ROOT, ID, f'{mode}_{scope}')
        man_p = os.path.join(stage_dir, 'manifest.json')
        rec = (state0 or {}).get('built', {}).get(f'{mode}_{scope}')
        if not a.stage and rec and rec.get('fingerprint') == fp and rec.get('rehearsal_ok') and os.path.isfile(os.path.join(PKG_ROOT, rec['pkg'], '00_README.md')):
            print(f"\n✅ 변경 없음 · 기존 폴더 그대로 사용 · {os.path.relpath(os.path.join(PKG_ROOT, rec['pkg']), ROOT)}  ({rec['built']} 생성 · 입력 지문 동일)")
            print(f"   README: {os.path.relpath(os.path.join(PKG_ROOT, rec['pkg'], '00_README.md'), ROOT)}")
            emit_links(os.path.join(PKG_ROOT, rec['pkg']))
            continue
        if not a.stage and os.path.exists(man_p):
            try:
                man = json.load(open(man_p, encoding='utf-8'))
            except Exception:
                man = {}
            if man.get('fingerprint') == fp and man.get('rehearsal_ok', False) and man.get('nothing'):
                print_nothing(ID, mode, state or {})
                continue
            if man.get('fingerprint') == fp and man.get('rehearsal_ok', False):
                dst = new_pkg_path(ID, vname)
                shutil.copytree(stage_dir, dst, ignore=shutil.ignore_patterns('manifest.json'))
                record_built(ID, mode, scope, dst, sub_items, fp, True)
                save_built_src(ID, dst, D)
                log(f'미리 만든 묶음이 최신 — 복사만 함 ({man.get("built")})')
                print(f'\n✅ 완료 · {os.path.relpath(dst, ROOT)}  (사전 생성 {man.get("built")} · 입력 지문 동일)')
                print(f'   README: {os.path.relpath(os.path.join(dst, "00_README.md"), ROOT)}')
                emit_links(dst)
                continue
            log('미리 만든 묶음이 낡음(사내 객체·META·소스 변경) — 새로 만듦')
        tag = f"{ID}_{now():%Y%m%d%H%M}"
        dst = stage_dir if a.stage else new_pkg_path(ID, vname)
        ctx.update(tag=tag, scope=scope, pkg=os.path.basename(dst) if not a.stage else f'{ID}_{vname}_<취합일시>')
        warns = []

        # 포함 판정
        inc_code = sorted({(n, t) for (n, t) in D['code'] if changed(f'CODE:{n}:{t}')} | {(n, 'VIEW') for n in D['views'] if changed(f'CODE:{n}:VIEW')}, key=code_order)
        # 패키지 스펙·본문은 같이 간다
        names_inc = {n for n, t in inc_code}
        inc_code = sorted({(n, t) for (n, t) in list(D['code']) + [(v, 'VIEW') for v in D['views']] if n in names_inc}, key=code_order)
        inc_tabs = [t for t in D['tables'] if changed(f'TAB:{t}')]
        inc_seq = [s for s in D['seq_ddl'] if changed(f'SEQ:{s}')]
        for m in D['meta']:
            m['inc_rows'] = [r for r in m['rows'] if changed(f"META:{m['table']}:{m['mode']}:" + '|'.join(str(r.get(x)) for x in m['key']))]
            keys_now = {'|'.join(str(r.get(x)) for x in m['key']) for r in m['rows']}
            pref = f"META:{m['table']}:{m['mode']}:"
            m['deleted'] = sorted(k[len(pref):] for k in prev if k.startswith(pref) and k[len(pref):] not in keys_now)
        inc_grant_names = {n for n, t in inc_code} | set(inc_tabs) | set(inc_seq)
        if state is None and not recent:
            inc_grant_names |= set(D['names'])

        shared_inc = [p for p in shared_files if changed(f'SHARED:{os.path.basename(p)}')]
        fe_be_changed = mode == 'all' and any(changed(k) for k in sub_items if k.startswith(('FE:', 'BE:', 'BEF:')))
        db_changed = bool(inc_code or inc_tabs or inc_seq or shared_inc or any(m['inc_rows'] for m in D['meta']))
        ctx['nothing'] = not db_changed and not fe_be_changed
        if ctx['nothing'] and not a.stage and scope == 'delta':
            print_nothing(ID, mode, state or {})
            continue
        if os.path.exists(dst):
            shutil.rmtree(dst)
        os.makedirs(os.path.join(dst, 'A_DB'))

        # 파일 작성
        W = lambda f, t: open(os.path.join(dst, 'A_DB', f), 'w', encoding='utf-8', newline='\n').write(t)
        W('00_PRECHECK_CLOUD.sql', build_00(ctx, D, D['meta']))
        b05, r99 = build_05_99(ctx, D, inc_code, inc_tabs, D['meta'])
        if db_changed:
            W('05_BACKUP_CLOUD.sql', b05)
        if inc_tabs or inc_seq:
            W(f'10_DDL_{ID}.sql', build_10(ctx, D, inc_tabs, inc_seq))
        for nm in sorted({n for n, t in inc_code}):
            body, w = build_20(ctx, D, nm, [t for n, t in inc_code if n == nm])
            W(f'20_PKG_{nm}.sql', body)
            warns += w
        for p in shared_inc:
            f = os.path.basename(p)
            t = open(p, encoding='utf-8', errors='replace').read()
            W(f'25_SHARED_{f}', f"-- 공용 객체 — 이 화면 몫만, 다른 화면 부분은 건드리지 않음 (원천 Doc/gen/{ID}/{f} · 룰 H14)\n" + t)
        if any(m['inc_rows'] for m in D['meta']):
            W(f'30_META_{ID}.sql', build_30(ctx, D['meta']))
        g40, ng = build_40(ctx, D, inc_grant_names)
        if ng:
            W(f'40_GRANT_{ID}.sql', g40)
        W('90_VERIFY.sql', build_90(ctx, D, inc_code, inc_tabs, D['meta']))
        if db_changed:
            W('99_ROLLBACK.sql', r99)

        # 공용 객체 변경 감지(기준선 이후 LAST_DDL) — 패치 파일 없으면 경고
        since = (state or {}).get('built_at')
        if since is None and os.path.isdir(gdir):
            try:
                since = datetime.datetime.fromtimestamp(min(os.path.getmtime(os.path.join(gdir, f)) for f in os.listdir(gdir))).strftime('%Y-%m-%d %H:%M:%S')
            except ValueError:
                since = None
        shared_changed = [d for d in D['deps'] if since and d.get('LAST_DDL') and d['LAST_DDL'] > since and d['RT'] not in ('TABLE', 'VIEW', 'SYNONYM')]
        shared_nopatch = [d for d in shared_changed if not any(os.path.basename(p).startswith(d['RN'] + '_') for p in shared_files)]

        # FE/BE 파일
        fe_rows, be_rows = [], []
        if mode == 'all' and fe_info:
            mine_modes = ('whole-new', 'whole-mine', 'merged-mine')
            page_mine = any(j['mode'] in mine_modes for j in fe_info['judge'] if fe_info['pageRel'] and j['rel'].startswith(fe_info['pageRel'] + '/'))
            for j in fe_info['judge']:
                rel = j['rel']
                in_page = fe_info['pageRel'] and rel.startswith(fe_info['pageRel'] + '/')
                src_local = os.path.join(FE_ROOT, rel)
                full_scope = scope == 'full'
                if j['mode'] in ('whole-new', 'whole-mine') or ((full_scope or (in_page and page_mine)) and j['mode'] in ('skip-same', 'skip-notmine') and os.path.exists(src_local)):
                    if not full_scope and not changed(f'FE:{rel}') and not (in_page and page_mine):
                        fe_rows.append((rel, j['mode'], '직전 이관과 같음 — 제외'))
                        continue
                    d = os.path.join(dst, 'B_FE', 'nscm-fe', rel)
                    os.makedirs(os.path.dirname(d), exist_ok=True)
                    shutil.copy2(src_local, d)
                    fe_rows.append((rel, j['mode'], 'B_FE' + ((' (전체 취합)' if full_scope else ' (페이지 폴더 단위)') if j['mode'].startswith('skip') else '')))
                elif j['mode'] == 'merged-mine' and j.get('out'):
                    if not full_scope and not changed(f'FE:{rel}'):
                        fe_rows.append((rel, j['mode'], '직전 이관과 같음 — 제외'))
                        continue
                    d = os.path.join(dst, 'B_FE' if full_scope else 'FE_MERGE', 'nscm-fe', rel)
                    os.makedirs(os.path.dirname(d), exist_ok=True)
                    shutil.copy2(j['out'], d)
                    fe_rows.append((rel, j['mode'], ('B_FE' if full_scope else 'FE_MERGE') + ' (공통 최신 + 내 수정분) — ' + j.get('note', '')))
                elif j['mode'] == 'conflict':
                    if j.get('out'):
                        d = os.path.join(dst, 'FE_MERGE', '_conflicts', 'nscm-fe', rel)
                        os.makedirs(os.path.dirname(d), exist_ok=True)
                        shutil.copy2(j['out'], d)
                    fe_rows.append((rel, j['mode'], '⚠ 사람 확인 — ' + j.get('note', '')))
                    warns.append(f'FE 충돌 {rel}: {j.get("note", "")}')
                else:
                    fe_rows.append((rel, j['mode'], '제외 — ' + j.get('note', '')))
            for b in be_info['judge']:
                rel = b['rel']
                if b['mode'] in ('whole-new', 'whole-mine', 'merged-mine', 'conflict') and b.get('data') is not None:
                    if scope != 'full' and not changed(f'BE:{rel}'):
                        be_rows.append((rel, b['mode'], '직전 이관과 같음 — 제외'))
                        continue
                    sub = {'whole-new': 'B_BE', 'whole-mine': 'B_BE', 'merged-mine': 'BE_MERGE', 'conflict': os.path.join('BE_MERGE', '_conflicts')}[b['mode']]
                    d = os.path.join(dst, sub, 'nscm-be', rel)
                    os.makedirs(os.path.dirname(d), exist_ok=True)
                    open(d, 'wb').write(b['data'])
                    be_rows.append((rel, b['mode'], sub + ' — ' + b['note']))
                    if b['mode'] == 'conflict':
                        warns.append(f'BE 충돌 {rel}: {b["note"]}')
                elif scope == 'full' and os.path.exists(os.path.join(BE_ROOT, rel)):
                    d = os.path.join(dst, 'B_BE', 'nscm-be', rel)
                    os.makedirs(os.path.dirname(d), exist_ok=True)
                    shutil.copy2(os.path.join(BE_ROOT, rel), d)
                    be_rows.append((rel, b['mode'], 'B_BE (전체 취합) — ' + b['note']))
                else:
                    be_rows.append((rel, b['mode'], '제외 — ' + b['note']))

        # 리허설
        reh = []
        reh_ok = True
        if not a.no_rehearse:
            log('사내 리허설 (DRY·ROLLBACK)')
            try:
                reh = rehearse(c, dst, ctx, None)
                reh_ok = all(r['fail'] == 0 for r in reh)
                for r in reh:
                    if r['file'].startswith('30_') and r.get('dml_rows'):
                        warns.append(f"리허설 30_META 사내 기준 변경 {r['dml_rows']}행 — 사내가 원천이면 0 이어야 함(키·값 확인)")
            except Exception as e:
                reh_ok = False
                reh = [{'file': '리허설', 'stmts': 0, 'fail': 1, 'notes': [f'ERROR {e}']}]
        # README
        readme = build_readme(ctx, D, mode, inc_code, inc_tabs, inc_seq, shared_files, shared_changed, shared_nopatch, fe_info if mode == 'all' else None,
                              be_info if mode == 'all' else None, fe_rows, be_rows, warns, reh, reh_ok, state, a.no_rehearse, os.listdir(os.path.join(dst, 'A_DB')))
        open(os.path.join(dst, '00_README.md'), 'w', encoding='utf-8').write(readme)
        man = {'fingerprint': fp, 'built': now().strftime('%Y-%m-%d %H:%M:%S'), 'mode': mode, 'rehearsal_ok': reh_ok and not a.no_rehearse, 'version': VERSION, 'nothing': ctx.get('nothing', False)}
        if a.stage:
            json.dump(man, open(man_p, 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
            log(f'사전 생성 완료 [{mode}/{scope}] {os.path.relpath(dst, ROOT)} · 리허설 {"OK" if reh_ok else "FAIL"}')
        else:
            record_built(ID, mode, scope, dst, sub_items, fp, reh_ok and not a.no_rehearse)
            save_built_src(ID, dst, D)
            # 같은 지문으로 스테이징도 갱신(다음 취합 즉시)
            if os.path.exists(stage_dir):
                shutil.rmtree(stage_dir)
            print(f'\n{"✅" if reh_ok and not warns else "⚠"} 완료 · {os.path.relpath(dst, ROOT)} · 리허설 {"OK" if reh_ok else "FAIL"} · 경고 {len(warns)}'
                  + (' · 직전 이관 이후 변경 없음(확인 SQL 만)' if ctx.get('nothing') else ''))
            print(f'   README: {os.path.relpath(os.path.join(dst, "00_README.md"), ROOT)}')
            emit_links(dst)
            for w in warns[:20]:
                print('   ⚠ ' + w)
    log('끝')
    c.cx.close()
    return 0


def pkg_how(ctx, D, n, t):
    pp = (D.get('patch') or {}).get((n, t)) if ctx.get('scope') == 'delta' else None
    if not pp or t == 'VIEW':
        return '사내 원문 전체(클라우드 지문 다를 때만 적용)'
    if pp['kind'] == 'patch':
        return f"**수정분만 패치 {len(pp['hunks'])}개 구간** (기준본: {pp['label']})"
    if pp['kind'] == 'same':
        return f"변경 없음 — 적용 안 함(클라우드 같음 확인만 · {pp['label']})"
    return f"전체 원문(지문 다를 때만) — 패치 불가: {pp['why']}"


def build_readme(ctx, D, mode, inc_code, inc_tabs, inc_seq, shared_files, shared_changed, shared_nopatch, fe_info, be_info, fe_rows, be_rows, warns, reh, reh_ok, state, no_reh, adb):
    ID = ctx['ID']
    L = [f"# {ID} {VARIANTS[(mode, ctx.get('scope', 'delta'))][1]}", '',
         f"- 생성 {ctx['built']:%Y-%m-%d %H:%M} · tools/CloudPkg/cloud_pkg.py {VERSION} (결정적 빌더 — Claude 미사용)",
         f"- 원천 사내 {ctx['db']} (SERVER_HOST={ctx['host']}) 조회 {ctx['fetched']} — SOURCE-FRESH",
         f"- 이관 범위 = {('전체 — 화면 소유 DB 객체·META 전부 + ' + ('FE 페이지 폴더·참조 파일·ID 참조 BE 파일 전부' if mode == 'all' else 'FE·BE 없음') + ' (모든 SQL 멱등)') if ctx.get('scope') == 'full' else (('수정본 — 이관 완료 표시(' + state['applied_at'] + ') 이후 바뀐 것 전부' if state.get('applied_at') else '수정본 — 기준선(' + state.get('built_at', '?') + ' 생성 시각 · 이관 확정 아님) 이후 바뀐 것 전부') if state else (('수정본 — 이관 기준선 없음 → 사내 수정 시각 ' + ctx['since'] + ' 이후 바뀐 것만(최근 수정분 · 코드/테이블 LAST_DDL · META 행 CREATION/LAST_UPDATE_DATE). 그 이전 수정 ' + str(ctx.get('older', 0)) + '건 제외' + (' · 수정 시각 없음 ' + str(ctx.get('notime', 0)) + '건 제외' if ctx.get('notime') else '') + ' — 그 이전 수정분이 클라우드에 없으면 전체 메뉴 또는 --since 로 기준 시각을 앞당긴다') if ctx.get('since') else '수정본 — 이관 기준선이 없어 화면 소유 전부(모든 SQL 멱등)'))}",
         f"- 사내 리허설 = {'생략(--no-rehearse)' if no_reh else ('OK' if reh_ok else 'FAIL — 아래 리허설 표 확인')}",
         *(['', '> **직전 이관 이후 바뀐 것이 없다.** 적용할 SQL 이 없으므로 00_PRECHECK·90_VERIFY 로 클라우드 상태만 확인한다. 전부 담으려면 전체 메뉴를 쓴다.'] if ctx.get('nothing') else []),
         '', '## 실행 순서 (클라우드, SCM_MGR, 파일마다 전체 F5)', '']
    desc = {'00': '사전 확인(읽기 전용) — 공용 객체 누락·컬럼 누락이 있으면 멈추고 전달', '05': '현재 상태 백업(ZB_* 표) — 원복 대비',
            '10': 'GTT 구조 동기화·테이블/SEQUENCE 생성', '20': 'PKG/코드 — 수정본: 바뀐 구간만 패치(클라우드 USER_SOURCE 치환) · 전체: 지문 다른 SPEC·BODY 만 교체 · Output 창에서 SKIP/APPLY 확인', '25': '공용 객체 이 화면 몫 패치', '30': 'META·문구·콤보',
            '40': '권한·시노님', '90': '확인(읽기 전용)', '99': '원복(문제 시에만)'}
    for f in sorted(adb):
        L.append(f"1. `A_DB/{f}` — {desc.get(f[:2], '')}")
    if mode == 'all':
        L += ['', f"FE: `B_FE/` = 실경로 그대로 복사 · `FE_MERGE/` = 공통 최신 + 내 수정분(공통소스 반영본) · `_conflicts` = 사람 확인. 판정 기준 공통소스 {ctx.get('tip', '')}",
              "BE: `B_BE/` 전체 복사 · `BE_MERGE/` 병합본. 없으면 BE 변경 없음."]
    L += ['', '## 이관 축 점검표', '', '| 축 | 대상 | 이관 | 구분 | 근거 |', '|---|---|---|---|---|']
    inc_set = set(inc_code)
    exc = '제외(기준 시각 ' + ctx['since'] + ' 이전 수정)' if ctx.get('since') else '제외(직전과 같음)'
    for (n, t) in sorted(list(D['code']) + [(v, 'VIEW') for v in D['views']], key=code_order):
        L.append(f"| PKG/코드 | {t} {n} | {'포함' if (n, t) in inc_set else exc} | 화면 전용 | {pkg_how(ctx, D, n, t)} · LAST_DDL {next((o['LAST_DDL'] for o in D['objects'] if o['OBJECT_NAME'] == n and o['OBJECT_TYPE'] == t), '')} |")
    for t, info in D['tables'].items():
        L.append(f"| {'GTT' if info['temp'] else 'TABLE'} | {t} | {'포함' if t in inc_tabs else exc} | 화면 전용 | {'구조 동기화' if info['temp'] else '없을 때만 생성 · 차이는 PRECHECK'} |")
    for s in D['seq_ddl']:
        L.append(f"| SEQUENCE | {s} | {'포함' if s in inc_seq else '제외'} | 화면 전용 | 없을 때만 생성 |")
    for m in D['meta']:
        L.append(f"| META | {m['table']} ({m['desc']}) | {len(m['inc_rows'])}/{len(m['rows'])}행 | {'화면 전용' if m['mode'] == 'upsert' else '공용·권한·메뉴'} | {m['mode']} · 키 {', '.join(m['key'])} ({m['key_how']}){' · 사내에서 사라진 행 ' + str(len(m['deleted'])) + '건(자동 삭제 안 함)' if m.get('deleted') else ''} |")
    for d in D['deps']:
        L.append(f"| 공용 참조 | {d['RT']} {d['RO']}.{d['RN']} | 제외 | 공용 | 존재·VALID·컬럼 PRECHECK · LAST_DDL {d.get('LAST_DDL') or ''} |")
    for p in shared_files:
        L.append(f"| 공용 패치 | {os.path.basename(p)} | 25_SHARED | 공용 — 이 화면 몫 | Doc/gen/{ID} 패치 파일(H14) |")
    if D['excluded']:
        L += ['', '이름에 화면 ID 가 있지만 백업·임시 사본으로 보고 제외: ' + ', '.join(D['excluded'][:30])]
    if shared_nopatch:
        L += ['', '## ⚠ 공용 객체 변경 감지 — 이 화면 몫 패치 파일 없음', '',
              '기준선 이후 사내에서 바뀐 공용 객체다. 이 화면 작업 때문이면 Doc/gen/' + ID + '/<객체>_<멤버>_' + ID + '.sql 로 이 화면 몫만 남기고 다시 만들 것(다른 작업자 변경일 수 있음 — 임의 포함 안 함).', '']
        for d in shared_nopatch:
            L.append(f"- {d['RT']} {d['RO']}.{d['RN']} · LAST_DDL {d['LAST_DDL']}")
    if mode == 'all':
        L += ['', '## FE 판정 (공통소스 기준 · Upload(UI) 와 같은 규칙)', '', '| 파일 | 판정 | 처리 |', '|---|---|---|']
        L += [f'| `{r}` | {m} | {n} |' for r, m, n in fe_rows] or ['| (페이지 폴더 없음) | | |']
        L += ['', '## BE 판정', '']
        if be_rows:
            L += ['| 파일 | 판정 | 처리 |', '|---|---|---|'] + [f'| `{r}` | {m} | {n} |' for r, m, n in be_rows]
        else:
            L.append('BE 변경 없음 (nscm-be 변경 파일 중 이 화면 ID 를 담은 것이 없음)')
        if be_info and be_info['other']:
            L.append(f"\n참고: 화면 ID 가 없는 BE 변경 {len(be_info['other'])}건은 이 화면 몫으로 판정하지 않음(제외): " + ', '.join(be_info['other'][:10]))
    if warns:
        L += ['', '## ⚠ 확인 필요', ''] + [f'- {w}' for w in warns]
    if reh:
        L += ['', '## 사내 리허설 (DRY·ROLLBACK — 사내 변경 없음)', '', '| 파일 | 문장 | 실패 | 요약 |', '|---|---|---|---|']
        for r in reh:
            notes = [n for n in r['notes'] if not n.startswith('> SKIP') and not n.startswith('> BACKUP')][:6]
            L.append(f"| {r['file']} | {r['stmts']} | {r['fail']} | {' · '.join(x.replace('|', '/') for x in notes)[:400]} |")
    L += ['', '## 백업 표 정리 (클라우드 적용·확인 후)', '', '```sql',
          f"BEGIN FOR t IN (SELECT TABLE_NAME FROM USER_TABLES WHERE TABLE_NAME LIKE 'ZB\\_{ctx['tag']}\\_%' ESCAPE '\\') LOOP EXECUTE IMMEDIATE 'DROP TABLE ' || t.TABLE_NAME || ' PURGE'; END LOOP; END;",
          '/', '```']
    return '\n'.join(L) + '\n'


