def page_dir(ID):
    try:
        r = json.load(open(os.path.join(GEN_ROOT, ID, 'register.json'), encoding='utf-8'))
        p = os.path.join(FE_ROOT, 'features', r['feature'], 'src', 'pages', r['pageDir'])
        if os.path.isdir(p):
            return p
    except Exception:
        pass
    feat = os.path.join(FE_ROOT, 'features')
    for f in sorted(os.listdir(feat)) if os.path.isdir(feat) else []:
        pg = os.path.join(feat, f, 'src', 'pages')
        if not os.path.isdir(pg):
            continue
        for d in sorted(os.listdir(pg)):
            mp = os.path.join(pg, d, '__asis-mapping__.md')
            try:
                if os.path.exists(mp) and re.search(rf'\b{ID}\b', open(mp, encoding='utf-8', errors='replace').read(4000)):
                    return os.path.join(pg, d)
            except Exception:
                pass
    return None


def git_status(repo):
    r = subprocess.run(['git', '-C', repo, 'status', '--porcelain', '-uall'], capture_output=True, text=True, encoding='utf-8', errors='replace')
    out = []
    for l in r.stdout.splitlines():
        if len(l) < 4:
            continue
        p = l[3:].split(' -> ')[-1].strip().strip('"')
        out.append((l[:2], p))
    return out


def fe_candidates(ID, pdir):
    rel = lambda f: os.path.relpath(f, FE_ROOT).replace(os.sep, '/')
    files = []
    for dp, dn, fn in os.walk(pdir):
        dn[:] = [d for d in dn if d not in ('node_modules', '.git')]
        files += [rel(os.path.join(dp, f)) for f in fn]
    pageRel = rel(pdir)
    base = os.path.basename(pdir)
    pathRe = re.compile(rf'{re.escape(base)}|\b{ID}\b', re.I)
    bodyRe = re.compile(re.escape(base), re.I)
    ALLOW = re.compile(r'^(features|apps/web/src|packages|configs)/')
    DENY = re.compile(r'(^|/)(tools|\.vibe|\.claude|_artifacts|Doc|\.husky|node_modules|dist|build)(/|$)|VibeManager|Harness|\.vsix$|\.env(\.|$)', re.I)
    related = []
    for st, f in git_status(FE_ROOT):
        if f.startswith(pageRel + '/') or (re.search(r'(^|/)src/pages/[^/]+/', f) and not f.startswith(pageRel + '/')):
            continue
        if DENY.search(f) or not ALLOW.search(f):
            continue
        full = os.path.join(FE_ROOT, f)
        hit = bool(pathRe.search(f))
        if not hit and os.path.isfile(full) and os.path.getsize(full) < 2 * 1024 * 1024:
            try:
                hit = bool(bodyRe.search(open(full, encoding='utf-8', errors='replace').read()))
            except Exception:
                hit = False
        if not hit and f == 'configs/types/procedures.d.ts':
            try:
                hit = ID in open(full, encoding='utf-8', errors='replace').read()
            except Exception:
                pass
        if hit:
            related.append(f)
    return sorted(files), sorted(related), pageRel


def fe_judge(ID, files, tip_ref, workdir):
    """common_sync --upload-prepare 재사용 → [{'rel','mode','note','out'}]"""
    os.makedirs(workdir, exist_ok=True)
    lst = os.path.join(workdir, 'files.txt')
    open(lst, 'w', encoding='utf-8').write('\n'.join(files))
    summ = os.path.join(workdir, 'summary.json')
    cmd = [sys.executable, os.path.join(ROOT, 'tools', 'CommonSync', 'common_sync.py'), '--upload-prepare', '--fe', FE_ROOT,
           '--tip', tip_ref, '--keys', ID, '--files-from', lst, '--out', workdir, '--summary', summ]
    r = subprocess.run(cmd, capture_output=True, text=True, encoding='utf-8', errors='replace', env=dict(os.environ, PYTHONIOENCODING='utf-8'))
    if r.returncode != 0 or not os.path.exists(summ):
        raise RuntimeError('FE 공통소스 판정 실패: ' + (r.stdout + r.stderr)[-800:])
    return json.load(open(summ, encoding='utf-8'))


def be_judge(ID, tip_ref, full=False):
    """nscm-be 변경 파일(full=True 면 src 전체) 중 경로·내용에 ID → 공통 이력 판정(common_sync History 를 BE 경로로)"""
    import common_sync as cs
    res = []
    cands = []
    other = []
    if full:
        pool = []
        for dp, dn, fn in os.walk(os.path.join(BE_ROOT, 'src')):
            dn[:] = [d for d in dn if d not in ('build', 'out', 'node_modules')]
            pool += [('', os.path.relpath(os.path.join(dp, f), BE_ROOT).replace(os.sep, '/')) for f in fn]
    else:
        pool = git_status(BE_ROOT)
    for st, f in pool:
        full = os.path.join(BE_ROOT, f)
        if not os.path.isfile(full) or not re.search(r'^src/', f) or not f.endswith(('.java', '.xml', '.yml', '.yaml', '.properties', '.sql')):
            continue
        hit = bool(re.search(rf'\b{ID}\b', f, re.I))
        if not hit and os.path.getsize(full) < 2 * 1024 * 1024:
            try:
                hit = bool(re.search(rf'\b{ID}\b', open(full, encoding='utf-8', errors='replace').read(), re.I))
            except Exception:
                pass
        (cands if hit else other).append(f)
    if not cands:
        return res, other
    git = cs.Git(FE_ROOT)
    tip = git.out('rev-parse', tip_ref).strip()
    saved = cs.SCOPE
    cs.SCOPE = ['src']
    try:
        hist = cs.History(git, 'nscm-be/', tip, tip)
    finally:
        cs.SCOPE = saved
    for rel in cands:
        lb = cs.rfile(os.path.join(BE_ROOT, rel))
        tb = git.blob_at(tip, 'nscm-be/' + rel)
        ln, tn = cs.norm(lb), cs.norm(tb)
        r = {'rel': rel}
        if tb is None:
            r.update(mode='whole-new', note='공통에 없는 파일', data=lb)
        elif ln == tn:
            r.update(mode='skip-same', note='공통 최신과 동일')
        elif hist.matches_history(rel, ln) or hist.matches_history_fmt(rel, ln):
            r.update(mode='skip-notmine', note='내 편집 없음(공통 이력본과 같음)')
        else:
            okey, origin = hist.pick_base(rel, ln, None)
            if origin is None:
                r.update(mode='conflict', note='출발 판본 없음 — 사람 확인', data=lb)
            elif cs.norm(origin) == tn:
                r.update(mode='whole-mine', note=f'공통이 출발 판본({okey}) 이후 그대로 → 로컬 전체', data=lb)
            else:
                merged, nconf = cs.merge3(git, tb, origin, lb)
                if nconf:
                    r.update(mode='conflict', note=f'3-way 충돌 {nconf} (출발 판본 {okey})', data=merged)
                else:
                    r.update(mode='merged-mine', note=f'공통 최신 + 내 수정분(출발 판본 {okey})', data=cs.conv(merged, cs.eol_of(tb), cs.has_bom(tb)))
        res.append(r)
    git.close()
    return res, other


