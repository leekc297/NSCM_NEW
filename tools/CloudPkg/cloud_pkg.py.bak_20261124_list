    json.dump(st, open(os.path.join(STATE_ROOT, f'{ID}.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)


def record_built(ID, mode, scope, dst, items, fingerprint, rehearsal_ok):
