def hdr(title, ctx, extra=''):
    return (f"-- SOURCE-FRESH: {OWNER} 화면 {ctx['ID']} 객체·META (DB={ctx['db']} SERVER_HOST={ctx['host']}) FETCHED={ctx['fetched']}\n"
            f"/* {title}\n * 패키지 {ctx['pkg']} · 생성 tools/CloudPkg/cloud_pkg.py {VERSION} · {ctx['built']:%Y-%m-%d %H:%M}\n"
            f" * 실행 계정 = SCM_MGR (전체 F5 · 반복 실행 안전){extra}\n */\nSET DEFINE OFF\nSET SERVEROUTPUT ON SIZE UNLIMITED\n")


def coldef(cc):
    dt = cc['DATA_TYPE']
    if dt in ('VARCHAR2', 'NVARCHAR2', 'CHAR', 'NCHAR'):
        t = f"{dt}({cc['CHAR_LENGTH']}{' CHAR' if cc['CHAR_USED'] == 'C' and dt in ('VARCHAR2', 'CHAR') else ''})"
    elif dt == 'NUMBER':
        p, s = cc['DATA_PRECISION'], cc['DATA_SCALE']
        t = 'NUMBER' if p is None and s is None else (f'NUMBER({p},{s})' if p is not None else f'NUMBER(*,{s})')
    elif dt == 'RAW':
        t = f"RAW({cc['DATA_LENGTH']})"
    else:
        t = dt
    if cc['DATA_DEFAULT']:
        t += ' DEFAULT ' + cc['DATA_DEFAULT']
    if cc['NULLABLE'] == 'N':
        t += ' NOT NULL'
    return f"{cc['COLUMN_NAME']} {t}"


def gtt_ddl(t, info):
    body = ',\n'.join('    ' + coldef(cc) for cc in info['cols'])
    return f"CREATE GLOBAL TEMPORARY TABLE {t} (\n{body}\n) ON COMMIT {'PRESERVE' if info['duration'] == 'SYS$SESSION' else 'DELETE'} ROWS"


SIG_FN = """    FUNCTION cur_sig(p_tab VARCHAR2) RETURN VARCHAR2 IS
        v VARCHAR2(4000);
    BEGIN
        SELECT LISTAGG(COLUMN_NAME||'|'||DATA_TYPE||'|'||CHAR_LENGTH||'|'||DATA_PRECISION||'|'||DATA_SCALE||'|'||NULLABLE, ';')
                 WITHIN GROUP (ORDER BY COLUMN_ID) INTO v
          FROM USER_TAB_COLUMNS WHERE TABLE_NAME = p_tab;
        RETURN v;
    END;
"""


def build_10(ctx, D, inc_tabs, inc_seq):
    L = [hdr('10_DDL — 화면 소유 테이블(GTT 구조 동기화 · 영구 테이블/SEQUENCE 없을 때만 생성)', ctx,
             '\n * GTT: 없음 CREATE · 구조 다름 DROP 후 CREATE(+인덱스·권한, 세션 임시 데이터만이라 손실 없음) · 같음 SKIP\n * ORA-14452 = 이 GTT 를 쓰는 세션이 살아 있음 → BE 재기동 후 재실행')]
    grants = {}
    for g in D['grants']:
        grants.setdefault(g['TABLE_NAME'], []).append(g)
    L.append("""DECLARE
    c_dry   CONSTANT BOOLEAN := FALSE;   -- 리허설용(TRUE = DDL 실행 안 함)
    v_cre   PLS_INTEGER := 0;
    v_rebld PLS_INTEGER := 0;
    v_skip  PLS_INTEGER := 0;
""" + SIG_FN + """
    PROCEDURE run(p_sql VARCHAR2, p_tab VARCHAR2) IS
    BEGIN
        IF c_dry THEN
            RAISE_APPLICATION_ERROR(-20901, 'DRY: ' || p_tab || ' 에 DDL 필요 — ' || SUBSTR(p_sql, 1, 120));
        END IF;
        EXECUTE IMMEDIATE p_sql;
    EXCEPTION WHEN OTHERS THEN
        IF SQLCODE IN (-14452, -14450) THEN
            DBMS_OUTPUT.PUT_LINE('ERROR   ' || p_tab || ' : ' || SQLERRM || ' -> 사용 중 세션 존재, BE 재기동 후 재실행');
        ELSIF SQLCODE <> -20901 THEN
            DBMS_OUTPUT.PUT_LINE('ERROR   ' || p_tab || ' : ' || SQLERRM || ' :: ' || SUBSTR(p_sql, 1, 200));
        END IF;
        RAISE;
    END;

    PROCEDURE grant_to(p_tab VARCHAR2, p_grantee VARCHAR2, p_privs VARCHAR2) IS
    BEGIN
        IF c_dry THEN RETURN; END IF;
        EXECUTE IMMEDIATE 'GRANT ' || p_privs || ' ON ' || p_tab || ' TO ' || p_grantee;
    EXCEPTION WHEN OTHERS THEN
        IF SQLCODE IN (-1917, -1919) THEN DBMS_OUTPUT.PUT_LINE('  WARN  ' || p_grantee || ' 없음, GRANT 생략 (' || p_tab || ')');
        ELSE RAISE; END IF;
    END;

    FUNCTION exists_tab(p_tab VARCHAR2) RETURN BOOLEAN IS n PLS_INTEGER;
    BEGIN SELECT COUNT(*) INTO n FROM USER_TABLES WHERE TABLE_NAME = p_tab; RETURN n > 0; END;

    FUNCTION exists_obj(p_name VARCHAR2, p_type VARCHAR2) RETURN BOOLEAN IS n PLS_INTEGER;
    BEGIN SELECT COUNT(*) INTO n FROM USER_OBJECTS WHERE OBJECT_NAME = p_name AND OBJECT_TYPE = p_type; RETURN n > 0; END;

    /* GTT: TRUE = 새로 만들었음 */
    FUNCTION ensure_gtt(p_tab VARCHAR2, p_sig VARCHAR2, p_ddl VARCHAR2) RETURN BOOLEAN IS
        v VARCHAR2(4000);
    BEGIN
        IF NOT exists_tab(p_tab) THEN
            run(p_ddl, p_tab); v_cre := v_cre + 1;
            DBMS_OUTPUT.PUT_LINE('CREATE  ' || p_tab); RETURN TRUE;
        END IF;
        v := cur_sig(p_tab);
        IF v = p_sig THEN
            v_skip := v_skip + 1; DBMS_OUTPUT.PUT_LINE('SKIP    ' || p_tab || ' (구조 동일)'); RETURN FALSE;
        END IF;
        DBMS_OUTPUT.PUT_LINE('DIFF    ' || p_tab);
        DBMS_OUTPUT.PUT_LINE('  현재  ' || v);
        DBMS_OUTPUT.PUT_LINE('  기준  ' || p_sig);
        run('DROP TABLE ' || p_tab || ' PURGE', p_tab);
        run(p_ddl, p_tab); v_rebld := v_rebld + 1;
        DBMS_OUTPUT.PUT_LINE('REBUILD ' || p_tab); RETURN TRUE;
    END;

    PROCEDURE ensure_index(p_tab VARCHAR2, p_idx VARCHAR2, p_ddl VARCHAR2) IS n PLS_INTEGER;
    BEGIN
        SELECT COUNT(*) INTO n FROM USER_INDEXES WHERE INDEX_NAME = p_idx;
        IF n = 0 THEN run(p_ddl, p_tab); DBMS_OUTPUT.PUT_LINE('  INDEX ' || p_idx); END IF;
    END;
BEGIN""")
    for t in inc_tabs:
        info = D['tables'][t]
        if info['temp']:
            ddl = gtt_ddl(t, info)
            L.append(f"    /* {t} : GTT {len(info['cols'])} cols, index {len(info['idx'])} */")
            L.append(f"    IF ensure_gtt('{t}',\n        {lit(info['sig'])},\n        {qq(ddl)}) THEN")
            gl = grants.get(t, [])
            for g in gl:
                L.append(f"        grant_to('{t}', '{g['GRANTEE']}', '{g['PRIVS']}');")
            if not gl:
                L.append('        NULL;')
            L.append('    END IF;')
            for ix in info['idx']:
                ixd = f"CREATE {'UNIQUE ' if ix['unique'] else ''}INDEX {ix['name']} ON {t} ({', '.join(ix['cols'])})"
                L.append(f"    ensure_index('{t}', '{ix['name']}', {qq(ixd)});")
        else:
            L.append(f"    /* {t} : 영구 테이블 — 없을 때만 생성(있으면 컬럼 차이는 00_PRECHECK 보고만) */")
            L.append(f"    IF NOT exists_tab('{t}') THEN")
            L.append(f"        run({qq(info['ddl'])}, '{t}'); v_cre := v_cre + 1; DBMS_OUTPUT.PUT_LINE('CREATE  {t}');")
            for g in grants.get(t, []):
                L.append(f"        grant_to('{t}', '{g['GRANTEE']}', '{g['PRIVS']}');")
            L.append(f"    ELSE DBMS_OUTPUT.PUT_LINE('EXISTS  {t} (구조 차이는 00_PRECHECK 참조)'); END IF;")
        L.append('')
    for s in inc_seq:
        L.append(f"    IF NOT exists_obj('{s}', 'SEQUENCE') THEN run({qq(D['seq_ddl'][s])}, '{s}'); DBMS_OUTPUT.PUT_LINE('CREATE  {s}'); END IF;")
    L.append("""    DBMS_OUTPUT.PUT_LINE('RESULT  CREATE=' || v_cre || '  REBUILD=' || v_rebld || '  SKIP=' || v_skip);
END;
/
""")
    return '\n'.join(L)


def code_order(k):
    order = {'TYPE': 0, 'PACKAGE': 1, 'FUNCTION': 2, 'PROCEDURE': 3, 'VIEW': 4, 'PACKAGE BODY': 5, 'TYPE BODY': 6}
    return (order.get(k[1], 9), k[0])


def build_20(ctx, D, name, types):
    """1.3.0(2026-11-11): SPEC·BODY 를 각각 '클라우드 원문이 사내와 다를 때만' 적용한다.
    Oracle 은 패키지 일부 멤버만 반영할 수 없어(BODY 는 통째 CREATE OR REPLACE) 반영 단위 = 객체 타입(SPEC/BODY/PROC…).
    클라우드 USER_SOURCE 지문(SUM(ORA_HASH(LINE~TEXT))·줄수)이 사내와 같으면 SKIP — 바뀐 타입만 컴파일(세션 무효화 최소)."""
    L = [hdr(f'20_PKG {name} — 수정분만 적용(클라우드 원문이 사내와 다른 SPEC/BODY 만 CREATE OR REPLACE · 같으면 SKIP)', ctx,
             '\n * 결과 = DBMS_OUTPUT(DBeaver Output 창) 의 SKIP(같음·미적용) / APPLY(교체) / ERROR 줄로 확인'
             '\n * 되돌리기 = 05_BACKUP 을 먼저 실행해 두면 99_ROLLBACK 이 이 객체를 실행 전 원문으로 복원')]
    warns = []
    for t in sorted(types, key=lambda x: code_order((name, x))):
        if t == 'VIEW':
            v = D['views'][name]
            cols = ', '.join(v['cols'])
            L.append(f"CREATE OR REPLACE FORCE VIEW {name} ({cols}) AS\n{v['text'].rstrip().rstrip(';')}\n;\n")
            continue
        src = D['code'][(name, t)]
        if not src.strip():
            warns.append(f'{t} {name} 원문 없음')
            continue
        pp = (D.get('patch') or {}).get((name, t)) if ctx.get('scope') == 'delta' else None
        if pp and pp['kind'] == 'patch':
            L += patchgen.plsql_patch(name, t, pp['hunks'], pp['h'], pp['l'], pp['label'], clob_assign)
            continue
        if pp and pp['kind'] == 'same':
            L += patchgen.plsql_check_same(name, t, pp['h'], pp['l'], pp['label'])
            continue
        ld = next((o['LAST_DDL'] for o in D['objects'] if o['OBJECT_NAME'] == name and o['OBJECT_TYPE'] == t), None)
        if pp and ctx.get('since') and ld and ld < ctx['since']:
            # 기준본은 없지만 최근 수정 기준 시각 이전 수정(예: BODY 만 바뀌고 SPEC 은 그대로) — 적용하지 않고 같은지 확인만
            pp.update(kind='same', label=f"LAST_DDL {ld} < 기준 시각 {ctx['since']} — 이번 수정분 아님")
            L += patchgen.plsql_check_same(name, t, pp['h'], pp['l'], pp['label'])
            continue
        if ctx.get('scope') == 'delta':
            L.append(f"/* {t} {name} — 수정분 패치를 만들 수 없어 전체 원문(지문 다를 때만 적용) · 사유: {(pp or {}).get('why', '-')} */")
        h, n = D['srchash'][(name, t)]
        L.append(f"""DECLARE
    c_dry   CONSTANT BOOLEAN := FALSE;
    v_h     NUMBER;
    v_n     NUMBER;
    v_src   CLOB;
BEGIN
    SELECT NVL(SUM(ORA_HASH(LINE || '~' || TEXT)), 0), COUNT(*) INTO v_h, v_n
      FROM USER_SOURCE WHERE NAME = '{name}' AND TYPE = '{t}';
    IF v_h = {h} AND v_n = {n} THEN
        DBMS_OUTPUT.PUT_LINE('> SKIP  {t} {name} — 클라우드 원문이 사내와 같음({n}줄) · 적용 안 함');
    ELSIF c_dry THEN
        DBMS_OUTPUT.PUT_LINE('> DRY   {t} {name} — 적용 대상(클라우드 ' || v_n || '줄 · 사내 {n}줄)');
    ELSE
""")
        L += clob_assign('v_src', src, indent='        ')
        L.append(f"""        BEGIN
            EXECUTE IMMEDIATE 'CREATE OR REPLACE ' || v_src;
            DBMS_OUTPUT.PUT_LINE('> APPLY {t} {name} — 사내 원문으로 교체(이전 클라우드 ' || v_n || '줄 → {n}줄)');
        EXCEPTION WHEN OTHERS THEN
            -- ORA-24344(컴파일 오류 동반 생성) 포함 — 파일 끝 확인 SELECT 로 오류 확인
            DBMS_OUTPUT.PUT_LINE('> ERROR {t} {name} — ' || SQLERRM);
        END;
    END IF;
END;
/
""")
    L.append(f"""/* 확인 — VALID, 오류 0 */
SELECT OBJECT_NAME, OBJECT_TYPE, STATUS, TO_CHAR(LAST_DDL_TIME, 'YYYY-MM-DD HH24:MI:SS') AS LAST_DDL
  FROM USER_OBJECTS WHERE OBJECT_NAME = '{name}' ORDER BY OBJECT_TYPE;
SELECT TYPE, LINE, POSITION, TEXT FROM USER_ERRORS WHERE NAME = '{name}' ORDER BY TYPE, SEQUENCE;
""")
    return '\n'.join(L), warns


def key_pred(key, l='T', r='S'):
    return ' AND '.join(f"NVL(TO_CHAR({l}.{k}), '~') = NVL(TO_CHAR({r}.{k}), '~')" for k in key)


def row_select(m, row):
    parts = []
    for cc in m['cols']:
        cn = cc['COLUMN_NAME']
        if cn in AUDIT:
            continue
        parts.append(f"{lit(row.get(cn), cc['DATA_TYPE'])} {cn}")
    return 'SELECT ' + ', '.join(parts) + ' FROM DUAL'


def keys_view(m, rows):
    if not rows:
        return 'SELECT ' + ', '.join(f"CAST(NULL AS VARCHAR2(4000)) {k}" for k in m['key']) + ' FROM DUAL WHERE 1 = 0'
    sels = []
    for r in rows:
        sels.append('SELECT ' + ', '.join(f"{lit(r.get(k))} {k}" for k in m['key']) + ' FROM DUAL')
    return '\n    UNION ALL '.join(sels)


def build_30(ctx, metas):
    L = [hdr('30_META — 화면 메타 7영역 + MSG/LBL + 콤보 (멱등)', ctx,
             '\n * upsert = 없으면 INSERT · 값이 다르면 UPDATE(화면 전용 행) / insert = 없을 때만 INSERT(공용·권한·메뉴·문구·콤보)'
             '\n * 감사 컬럼 = admin / SYSDATE · ON 키 = PK 실측(없으면 유일 키 실측) · 클라우드에만 있는 행은 지우지 않음(90_VERIFY 보고)')]
    for m in metas:
        rows = m['inc_rows']
        L.append(f"\n/* ── {m['table']} — {m['desc']} · {m['mode']} · 키 {', '.join(m['key'])} ({m['key_how']}) · {len(rows)}행 */")
        if m.get('deleted'):
            L.append(f"/*   사내에서 사라진 행 {len(m['deleted'])}건(직전 이관 대비) — 클라우드 정리 필요 여부 확인, 자동 삭제 안 함:")
            for k in m['deleted'][:50]:
                L.append(f"     {k}")
            L.append('*/')
        if not rows:
            L.append('-- (대상 행 없음)')
            continue
        data_cols = [cc['COLUMN_NAME'] for cc in m['cols'] if cc['COLUMN_NAME'] not in AUDIT]
        audit_cols = [cc['COLUMN_NAME'] for cc in m['cols'] if cc['COLUMN_NAME'] in AUDIT]
        aud_val = {'CREATED_BY': "'admin'", 'LAST_UPDATED_BY': "'admin'", 'CREATION_DATE': 'SYSDATE', 'LAST_UPDATE_DATE': 'SYSDATE'}
        ins_cols = data_cols + audit_cols
        ins_vals = [f'S.{c}' for c in data_cols] + [aud_val[c] for c in audit_cols]
        upd_cols = [c for c in data_cols if c not in m['key']]
        if m['mode'] == 'insert':
            for r in rows:
                sel = row_select(m, r)
                L.append(f"INSERT INTO {OWNER}.{m['table']} ({', '.join(ins_cols)})\nSELECT {', '.join(ins_vals)}\n  FROM ({sel}) S\n WHERE NOT EXISTS (SELECT 1 FROM {OWNER}.{m['table']} T WHERE {key_pred(m['key'])});")
        else:
            for i in range(0, len(rows), 40):
                chunk = rows[i:i + 40]
                using = '\n       UNION ALL '.join(row_select(m, r) for r in chunk)
                L.append(f"MERGE INTO {OWNER}.{m['table']} T\nUSING ({using}) S\n   ON ({key_pred(m['key'])})")
                if upd_cols:
                    diff = ' OR '.join(f"DECODE(T.{c}, S.{c}, 0, 1) = 1" for c in upd_cols)
                    sets = ', '.join(f"T.{c} = S.{c}" for c in upd_cols)
                    au = ', '.join(f"T.{c} = {aud_val[c]}" for c in audit_cols if c.startswith('LAST_'))
                    L.append(f" WHEN MATCHED THEN UPDATE SET {sets}{', ' + au if au else ''}\n      WHERE {diff}")
                L.append(f" WHEN NOT MATCHED THEN INSERT ({', '.join(ins_cols)})\n      VALUES ({', '.join(ins_vals)});")
    L.append('\nCOMMIT;\n')
    return '\n'.join(L)


def build_40(ctx, D, inc_names):
    L = [hdr('40_GRANT — 화면 객체 권한·앱 계정 시노님 (사내 실측 그대로 · 멱등)', ctx)]
    L.append("""DECLARE
    c_dry CONSTANT BOOLEAN := FALSE;
    PROCEDURE g(p_obj VARCHAR2, p_to VARCHAR2, p_privs VARCHAR2) IS n PLS_INTEGER;
    BEGIN
        SELECT COUNT(*) INTO n FROM USER_OBJECTS WHERE OBJECT_NAME = p_obj;
        IF n = 0 THEN DBMS_OUTPUT.PUT_LINE('SKIP    ' || p_obj || ' 없음'); RETURN; END IF;
        IF NOT c_dry THEN EXECUTE IMMEDIATE 'GRANT ' || p_privs || ' ON ' || p_obj || ' TO ' || p_to; END IF;
        DBMS_OUTPUT.PUT_LINE('GRANT   ' || p_privs || ' ON ' || p_obj || ' TO ' || p_to);
    EXCEPTION WHEN OTHERS THEN
        IF SQLCODE IN (-1917, -1919) THEN DBMS_OUTPUT.PUT_LINE('  WARN  ' || p_to || ' 없음 — ' || p_obj);
        ELSE RAISE; END IF;
    END;
    PROCEDURE s(p_owner VARCHAR2, p_syn VARCHAR2, p_obj VARCHAR2) IS n PLS_INTEGER;
    BEGIN
        SELECT COUNT(*) INTO n FROM ALL_SYNONYMS WHERE OWNER = p_owner AND SYNONYM_NAME = p_syn AND TABLE_OWNER = 'SCM_MGR' AND TABLE_NAME = p_obj;
        IF n > 0 THEN RETURN; END IF;
        IF NOT c_dry THEN EXECUTE IMMEDIATE 'CREATE OR REPLACE SYNONYM ' || p_owner || '.' || p_syn || ' FOR SCM_MGR.' || p_obj; END IF;
        DBMS_OUTPUT.PUT_LINE('SYNONYM ' || p_owner || '.' || p_syn || ' -> SCM_MGR.' || p_obj);
    EXCEPTION WHEN OTHERS THEN
        IF SQLCODE = -1031 THEN DBMS_OUTPUT.PUT_LINE('  WARN  권한 부족(CREATE ANY SYNONYM) — ' || p_owner || '.' || p_syn || ' 는 system 계정으로');
        ELSIF SQLCODE = -1917 THEN DBMS_OUTPUT.PUT_LINE('  WARN  사용자 ' || p_owner || ' 없음');
        ELSE RAISE; END IF;
    END;
BEGIN""")
    n = 0
    for gr in D['grants']:
        if gr['TABLE_NAME'] in inc_names:
            L.append(f"    g('{gr['TABLE_NAME']}', '{gr['GRANTEE']}', '{gr['PRIVS']}');")
            n += 1
    for sy in D['synonyms']:
        if sy['TABLE_NAME'] in inc_names:
            L.append(f"    s('{sy['OWNER']}', '{sy['SYNONYM_NAME']}', '{sy['TABLE_NAME']}');")
            n += 1
    if not n:
        L.append('    NULL;')
    L.append('END;\n/\n')
    return '\n'.join(L), n


def build_00(ctx, D, metas):
    L = [hdr('00_PRECHECK_CLOUD — 읽기 전용(변경 없음). 결과를 보고 진행', ctx)]
    names = D['names']
    exp = '\n    UNION ALL '.join(f"SELECT {lit(o['OBJECT_NAME'])} N, {lit(o['OBJECT_TYPE'])} T FROM DUAL" for o in D['objects']) or "SELECT 'X' N, 'X' T FROM DUAL WHERE 1 = 0"
    L.append(f"""/* 1) 화면 소유 객체 — 클라우드 현재 상태 (CLOUD_STATUS 빈칸 = 클라우드에 없음 → 이 패키지가 생성) */
SELECT E.N AS OBJECT_NAME, E.T AS OBJECT_TYPE, O.STATUS AS CLOUD_STATUS, TO_CHAR(O.LAST_DDL_TIME, 'YYYY-MM-DD HH24:MI') AS CLOUD_LAST_DDL
  FROM ({exp}) E
  LEFT JOIN USER_OBJECTS O ON O.OBJECT_NAME = E.N AND O.OBJECT_TYPE = E.T
 ORDER BY 1, 2;
""")
    code_deps = [d for d in D['deps'] if d['RT'] not in ('TABLE', 'VIEW')]
    if code_deps:
        ex = '\n    UNION ALL '.join(f"SELECT {lit(d['RO'])} O, {lit(d['RN'])} N, {lit(d['RT'])} T FROM DUAL" for d in code_deps)
        L.append(f"""/* 2) 공용 참조 객체(이 패키지가 만들지 않음) — 0건이어야 정상. 행 = 클라우드에 없거나 INVALID → 먼저 이관 필요 */
SELECT E.O AS OWNER, E.N AS OBJECT_NAME, E.T AS OBJECT_TYPE, NVL(MAX(A.STATUS), '없음') AS CLOUD_STATUS
  FROM ({ex}) E
  LEFT JOIN ALL_OBJECTS A ON A.OWNER = E.O AND A.OBJECT_NAME = E.N AND A.OBJECT_TYPE IN (E.T, E.T || ' BODY')
 GROUP BY E.O, E.N, E.T
HAVING NVL(MAX(A.STATUS), '없음') <> 'VALID' OR MIN(A.STATUS) <> 'VALID'
 ORDER BY 1, 2;
""")
    colrows = []
    for d in D['deps']:
        if d['RT'] in ('TABLE', 'VIEW'):
            for cn in d.get('COLS', []):
                colrows.append(f"SELECT {lit(d['RO'])} O, {lit(d['RN'])} T, {lit(cn)} C FROM DUAL")
    for t, info in D['tables'].items():
        if not info['temp']:
            for cc in info['cols']:
                colrows.append(f"SELECT '{OWNER}' O, {lit(t)} T, {lit(cc['COLUMN_NAME'])} C FROM DUAL")
    if colrows:
        L.append(f"""/* 3) 참조 테이블·뷰 컬럼 누락 — 0건이어야 정상. 행 = 클라우드 표에 그 컬럼 없음 → PKG 컴파일 ORA-00904 원인.
 *    데이터·PK·배치 영향이 있어 자동 변경 안 함 — 결과를 그대로 전달(예: 2026-10-30 QA SCP_RPT_GLOBAL_PSI_MD_WW.PLAN_TYPE) */
SELECT E.O AS OWNER, E.T AS TABLE_NAME, E.C AS MISSING_COLUMN
  FROM ({chr(10).join(('    UNION ALL ' if i else '    ') + r for i, r in enumerate(colrows))}) E
 WHERE EXISTS (SELECT 1 FROM ALL_TABLES X WHERE X.OWNER = E.O AND X.TABLE_NAME = E.T
               UNION ALL SELECT 1 FROM ALL_VIEWS V WHERE V.OWNER = E.O AND V.VIEW_NAME = E.T)
   AND NOT EXISTS (SELECT 1 FROM ALL_TAB_COLUMNS C WHERE C.OWNER = E.O AND C.TABLE_NAME = E.T AND C.COLUMN_NAME = E.C)
 ORDER BY 1, 2, 3;
""")
        L.append(f"""/* 4) 참조 테이블·뷰 자체가 없음 — 0건이어야 정상 */
SELECT DISTINCT E.O AS OWNER, E.T AS TABLE_NAME
  FROM ({chr(10).join(('    UNION ALL ' if i else '    ') + r for i, r in enumerate(colrows))}) E
 WHERE NOT EXISTS (SELECT 1 FROM ALL_TABLES X WHERE X.OWNER = E.O AND X.TABLE_NAME = E.T)
   AND NOT EXISTS (SELECT 1 FROM ALL_VIEWS V WHERE V.OWNER = E.O AND V.VIEW_NAME = E.T)
   AND NOT EXISTS (SELECT 1 FROM ALL_SYNONYMS S WHERE S.OWNER = E.O AND S.SYNONYM_NAME = E.T)
 ORDER BY 1, 2;
""")
    mnu = next((m for m in metas if m['table'] == 'SCM_ADM_MNU_M'), None)
    if mnu and mnu['rows']:
        up = mnu['rows'][0].get('UPPR_MNU_ID')
        if up:
            L.append(f"""/* 5) 상위 메뉴 존재 — 1건이어야 정상 */
SELECT MNU_ID, USE_YN FROM {OWNER}.SCM_ADM_MNU_M WHERE MNU_ID = {lit(up)};
""")
    L.append("/* 6) META 현재 건수 (참고) */")
    for m in metas:
        if m['table'] in ('SCM_ADM_MSG_M', 'SCM_ADM_CMBO_SQL_M'):
            continue
        cond = m['cond'].replace(':id', lit(ctx['ID']))
        L.append(f"SELECT '{m['table']}' AS TBL, {lit(m['desc'])} AS AREA, COUNT(*) AS CLOUD_ROWS, {len(m['rows'])} AS CORP_ROWS FROM {OWNER}.{m['table']} WHERE {cond};")
    return '\n'.join(L) + '\n'


def zb(tag, suffix):
    return f'ZB_{tag}_{suffix}'[:128]


def build_05_99(ctx, D, inc_code, inc_tabs, metas):
    tag = ctx['tag']
    # 05 BACKUP
    B = [hdr(f'05_BACKUP_CLOUD — 적용 전 클라우드 현재 상태 보관(표 이름 ZB_{tag}_*). 이미 있으면 건너뜀(첫 백업 유지)', ctx,
             '\n * 99_ROLLBACK 이 이 백업으로 PKG 원문·GTT 구조·META 행을 되돌린다. 확인 끝나면 README 의 정리 SQL 로 ZB 표 삭제')]
    B.append("DECLARE\n    v CLOB;\n    PROCEDURE mk(p_tab VARCHAR2, p_sql CLOB) IS n PLS_INTEGER;\n    BEGIN\n"
             "        SELECT COUNT(*) INTO n FROM USER_TABLES WHERE TABLE_NAME = p_tab;\n"
             "        IF n > 0 THEN DBMS_OUTPUT.PUT_LINE('SKIP    ' || p_tab || ' (이미 백업됨 — 첫 백업 유지)'); RETURN; END IF;\n"
             "        EXECUTE IMMEDIATE p_sql;\n        DBMS_OUTPUT.PUT_LINE('BACKUP  ' || p_tab);\n    END;\nBEGIN")
    code_names = sorted({n for n, t in inc_code})
    tabs = list(inc_tabs)
    objs_list = sorted({n for n, t in inc_code} | set(tabs))
    if objs_list:
        exp = ' UNION ALL '.join(f"SELECT '{n}' NAME FROM DUAL" for n in objs_list)
        sql = (f"CREATE TABLE {zb(tag, 'OBJ')} AS SELECT E.NAME, O.OBJECT_TYPE, O.STATUS FROM ({exp}) E "
               f"LEFT JOIN USER_OBJECTS O ON O.OBJECT_NAME = E.NAME AND O.OBJECT_TYPE IN ('PACKAGE','PACKAGE BODY','PROCEDURE','FUNCTION','TYPE','TYPE BODY','VIEW','TABLE','SEQUENCE')")
        B += clob_assign('v', sql)
        B.append(f"    mk('{zb(tag, 'OBJ')}', v);")
    if code_names:
        sql = (f"CREATE TABLE {zb(tag, 'SRC')} AS SELECT NAME, TYPE, LINE, TEXT FROM USER_SOURCE WHERE NAME IN ({', '.join(chr(39) + n + chr(39) for n in code_names)})")
        B += clob_assign('v', sql)
        B.append(f"    mk('{zb(tag, 'SRC')}', v);")
    if tabs:
        sql = (f"CREATE TABLE {zb(tag, 'TAB')} AS SELECT T.TABLE_NAME, "
               "(SELECT LISTAGG(COLUMN_NAME||'|'||DATA_TYPE||'|'||CHAR_LENGTH||'|'||DATA_PRECISION||'|'||DATA_SCALE||'|'||NULLABLE, ';') WITHIN GROUP (ORDER BY COLUMN_ID) "
               "FROM USER_TAB_COLUMNS C WHERE C.TABLE_NAME = T.TABLE_NAME) SIG, DBMS_METADATA.GET_DDL('TABLE', T.TABLE_NAME) DDL "
               f"FROM USER_TABLES T WHERE T.TABLE_NAME IN ({', '.join(chr(39) + n + chr(39) for n in tabs)})")
        B += clob_assign('v', sql)
        B.append(f"    mk('{zb(tag, 'TAB')}', v);")
        sql = (f"CREATE TABLE {zb(tag, 'IDX')} AS SELECT I.TABLE_NAME, I.INDEX_NAME, DBMS_METADATA.GET_DDL('INDEX', I.INDEX_NAME) DDL "
               f"FROM USER_INDEXES I WHERE I.TABLE_NAME IN ({', '.join(chr(39) + n + chr(39) for n in tabs)}) AND I.INDEX_TYPE LIKE '%NORMAL%' "
               "AND NOT EXISTS (SELECT 1 FROM USER_CONSTRAINTS K WHERE K.INDEX_NAME = I.INDEX_NAME)")
        B += clob_assign('v', sql)
        B.append(f"    mk('{zb(tag, 'IDX')}', v);")
    for i, m in enumerate(metas, 1):
        if not m['inc_rows']:
            continue
        sql = (f"CREATE TABLE {zb(tag, 'M%02d' % i)} AS SELECT T.* FROM {OWNER}.{m['table']} T WHERE EXISTS (SELECT 1 FROM ("
               f"{keys_view(m, m['inc_rows'])}) S WHERE {key_pred(m['key'])})")
        B += clob_assign('v', sql)
        B.append(f"    mk('{zb(tag, 'M%02d' % i)}', v);  -- {m['table']} ({m['desc']})")
    B.append("    NULL;\nEND;\n/\n")
    # 99 ROLLBACK
    R = [hdr(f'99_ROLLBACK — 05_BACKUP(ZB_{tag}_*) 기준으로 되돌림: META 행 → GTT 구조 → PKG/코드 원문', ctx,
             '\n * 05_BACKUP 없이 적용했다면 실행하지 말 것(백업 표 없음 → 중단). 권한·시노님은 되돌리지 않음(무해).')]
    R.append("DECLARE\n    c_dry CONSTANT BOOLEAN := FALSE;   -- 리허설용(TRUE = 실제 변경 없이 점검만, 끝에 ROLLBACK)\n    v CLOB;\n    n PLS_INTEGER;\n"
             "    FUNCTION has(p_tab VARCHAR2) RETURN BOOLEAN IS k PLS_INTEGER;\n    BEGIN SELECT COUNT(*) INTO k FROM USER_TABLES WHERE TABLE_NAME = p_tab; RETURN k > 0; END;\n"
             + SIG_FN.replace('    FUNCTION cur_sig', '    FUNCTION cur_sig') +
             "    PROCEDURE ddl(p_sql CLOB, p_what VARCHAR2) IS\n    BEGIN\n"
             "        IF c_dry THEN DBMS_OUTPUT.PUT_LINE('DRY     ' || p_what || ' (' || DBMS_LOB.GETLENGTH(p_sql) || '자)'); RETURN; END IF;\n"
             "        EXECUTE IMMEDIATE p_sql; DBMS_OUTPUT.PUT_LINE('DONE    ' || p_what);\n    END;\nBEGIN")
    R.append(f"    IF NOT has('{zb(tag, 'OBJ')}') THEN RAISE_APPLICATION_ERROR(-20990, '05_BACKUP 표 {zb(tag, 'OBJ')} 없음 — 되돌릴 기준 없음'); END IF;")
    R.append("    /* 1) META 행 — 패키지 키 범위만 지우고 백업 행을 다시 넣음 */")
    for i, m in enumerate(metas, 1):
        if not m['inc_rows']:
            continue
        zt = zb(tag, 'M%02d' % i)
        sql_del = f"DELETE FROM {OWNER}.{m['table']} T WHERE EXISTS (SELECT 1 FROM ({keys_view(m, m['inc_rows'])}) S WHERE {key_pred(m['key'])})"
        R.append(f"    -- {m['table']} ({m['desc']})")
        R.append(f"    IF has('{zt}') THEN")
        R += clob_assign('v', sql_del, '        ')
        R.append(f"        EXECUTE IMMEDIATE v; n := SQL%ROWCOUNT;")
        R.append(f"        EXECUTE IMMEDIATE 'INSERT INTO {OWNER}.{m['table']} SELECT * FROM {zt}';")
        R.append(f"        DBMS_OUTPUT.PUT_LINE('META    {m['table']} 삭제 ' || n || ' · 복원 ' || SQL%ROWCOUNT);")
        R.append("    END IF;")
    R.append("    IF c_dry THEN ROLLBACK; DBMS_OUTPUT.PUT_LINE('DRY     META ROLLBACK'); ELSE COMMIT; END IF;")
    if tabs:
        R.append("    /* 2) 테이블 — 백업 때 없던 것은 DROP, 구조가 바뀐 GTT 는 백업 DDL 로 재생성 */")
        for t in tabs:
            R.append(f"    SELECT COUNT(*) INTO n FROM {zb(tag, 'OBJ')} WHERE NAME = '{t}' AND OBJECT_TYPE = 'TABLE';")
            R.append(f"    IF n = 0 THEN")
            R.append(f"        IF has('{t}') THEN ddl('DROP TABLE {t} PURGE', 'DROP {t} (백업 시 없었음)'); END IF;")
            R.append(f"    ELSE")
            R.append(f"        EXECUTE IMMEDIATE 'SELECT MAX(SIG) FROM {zb(tag, 'TAB')} WHERE TABLE_NAME = ''{t}''' INTO v;")
            R.append(f"        IF NVL(DBMS_LOB.SUBSTR(v, 4000, 1), '~') <> NVL(cur_sig('{t}'), '~') THEN")
            R.append(f"            ddl('DROP TABLE {t} PURGE', 'DROP {t} (구조 원복)');")
            R.append(f"            EXECUTE IMMEDIATE 'SELECT MAX(DDL) FROM {zb(tag, 'TAB')} WHERE TABLE_NAME = ''{t}''' INTO v;")
            R.append(f"            ddl(v, 'CREATE {t} (백업 DDL)');")
            for g in [g for g in D['grants'] if g['TABLE_NAME'] == t]:
                R.append(f"            IF NOT c_dry THEN BEGIN EXECUTE IMMEDIATE 'GRANT {g['PRIVS']} ON {t} TO {g['GRANTEE']}'; EXCEPTION WHEN OTHERS THEN IF SQLCODE IN (-1917, -1919) THEN NULL; ELSE RAISE; END IF; END; END IF;")
            R.append(f"        END IF;")
            R.append(f"    END IF;")
        R.append(f"    /* 2-1) 인덱스 — 백업에 있던 인덱스 중 없는 것 재생성 */")
        R.append(f"    DECLARE TYPE t_cur IS REF CURSOR; c t_cur; v_ix VARCHAR2(128); v_ddl CLOB; k PLS_INTEGER;")
        R.append(f"    BEGIN")
        R.append(f"        OPEN c FOR 'SELECT INDEX_NAME, DDL FROM {zb(tag, 'IDX')}';")
        R.append(f"        LOOP FETCH c INTO v_ix, v_ddl; EXIT WHEN c%NOTFOUND;")
        R.append(f"            SELECT COUNT(*) INTO k FROM USER_INDEXES WHERE INDEX_NAME = v_ix;")
        R.append(f"            IF k = 0 THEN ddl(v_ddl, 'INDEX ' || v_ix); END IF;")
        R.append(f"        END LOOP; CLOSE c;")
        R.append(f"    EXCEPTION WHEN OTHERS THEN IF SQLCODE = -942 THEN NULL; ELSE RAISE; END IF;")
        R.append(f"    END;")
    if code_names:
        R.append("    /* 3) 코드 — 백업 때 없던 객체 DROP, 있던 객체는 백업 원문으로 CREATE OR REPLACE (스펙 → 본문 순) */")
        order = ['TYPE', 'PACKAGE', 'FUNCTION', 'PROCEDURE', 'VIEW', 'PACKAGE BODY', 'TYPE BODY']
        for nm in code_names:
            types = sorted({t for n, t in inc_code if n == nm}, key=lambda x: order.index(x) if x in order else 9)
            main_t = 'PACKAGE' if 'PACKAGE' in types or 'PACKAGE BODY' in types else types[0]
            R.append(f"    SELECT COUNT(*) INTO n FROM {zb(tag, 'OBJ')} WHERE NAME = '{nm}' AND OBJECT_TYPE IS NOT NULL;")
            R.append(f"    IF n = 0 THEN")
            drop_t = 'VIEW' if main_t == 'VIEW' else main_t
            R.append(f"        SELECT COUNT(*) INTO n FROM USER_OBJECTS WHERE OBJECT_NAME = '{nm}' AND OBJECT_TYPE = '{drop_t}';")
            R.append(f"        IF n > 0 THEN ddl('DROP {drop_t} {nm}', 'DROP {nm} (백업 시 없었음)'); END IF;")
            R.append(f"    ELSE")
            for t in types:
                if t == 'VIEW':
                    R.append(f"        NULL; -- VIEW {nm}: 백업 원문 없음(USER_SOURCE 밖) — 필요 시 수동")
                    continue
                R.append(f"        v := NULL;")
                R.append(f"        FOR r IN (SELECT TEXT FROM {zb(tag, 'SRC')} WHERE NAME = '{nm}' AND TYPE = '{t}' ORDER BY LINE) LOOP v := v || r.TEXT; END LOOP;")
                R.append(f"        IF v IS NOT NULL THEN ddl('CREATE OR REPLACE ' || v, 'RESTORE {t} {nm}'); END IF;")
            R.append(f"    END IF;")
    R.append("    DBMS_OUTPUT.PUT_LINE('ROLLBACK 완료' || CASE WHEN c_dry THEN ' (DRY)' END);\nEND;\n/\n")
    if code_names:
        R.append(f"SELECT OBJECT_NAME, OBJECT_TYPE, STATUS FROM USER_OBJECTS WHERE OBJECT_NAME IN ({', '.join(chr(39) + n + chr(39) for n in code_names)}) ORDER BY 1, 2;\n")
    return '\n'.join(B), '\n'.join(R)


def build_90(ctx, D, inc_code, inc_tabs, metas):
    L = [hdr('90_VERIFY — 읽기 전용. 각 조회의 기대값 확인', ctx)]
    names = sorted({o['OBJECT_NAME'] for o in D['objects'] if o['OBJECT_TYPE'] in CODE_TYPES + ('VIEW',)})
    if names:
        il = ', '.join("'" + n + "'" for n in names)
        L.append(f"/* 1) 화면 코드 객체 — 전부 VALID */\nSELECT OBJECT_NAME, OBJECT_TYPE, STATUS FROM USER_OBJECTS WHERE OBJECT_NAME IN ({il}) ORDER BY 1, 2;\n")
        L.append(f"/* 2) 컴파일 오류 — 0건 */\nSELECT NAME, TYPE, LINE, POSITION, TEXT FROM USER_ERRORS WHERE NAME IN ({il}) ORDER BY NAME, TYPE, SEQUENCE;\n")
    gtts = [t for t, i in D['tables'].items() if i['temp']]
    if gtts:
        ex = '\n    UNION ALL '.join(f"SELECT {lit(t)} T, {lit(D['tables'][t]['sig'])} S FROM DUAL" for t in gtts)
        L.append(f"""/* 3) GTT 구조 — 0건(사내와 다른 GTT 가 있으면 행) */
SELECT E.T AS TABLE_NAME
  FROM ({ex}) E
 WHERE NVL((SELECT LISTAGG(COLUMN_NAME||'|'||DATA_TYPE||'|'||CHAR_LENGTH||'|'||DATA_PRECISION||'|'||DATA_SCALE||'|'||NULLABLE, ';') WITHIN GROUP (ORDER BY COLUMN_ID)
              FROM USER_TAB_COLUMNS C WHERE C.TABLE_NAME = E.T), '~') <> E.S
 ORDER BY 1;
""")
    L.append("/* 4) META — 패키지 행이 클라우드에 모두 있음: MISSING = 0 */")
    for m in metas:
        if not m['rows']:
            continue
        L.append(f"SELECT '{m['table']}' AS TBL, {lit(m['desc'])} AS AREA, COUNT(*) AS PKG_ROWS, SUM(CASE WHEN EXISTS (SELECT 1 FROM {OWNER}.{m['table']} T WHERE {key_pred(m['key'])}) THEN 0 ELSE 1 END) AS MISSING\n  FROM ({keys_view(m, m['rows'])}) S;")
    L.append("\n/* 5) 클라우드에만 있는 화면 META 행(사내에 없음) — 참고. 지우지 않음 */")
    for m in metas:
        if m['table'] in ('SCM_ADM_MSG_M', 'SCM_ADM_CMBO_SQL_M') or m['mode'] != 'upsert':
            continue
        cond = m['cond'].replace(':id', lit(ctx['ID']))
        L.append(f"SELECT '{m['table']}' AS TBL, {', '.join('T.' + k for k in m['key'])}\n  FROM {OWNER}.{m['table']} T\n WHERE ({cond})\n   AND NOT EXISTS (SELECT 1 FROM ({keys_view(m, m['rows'])}) S WHERE {key_pred(m['key'])});")
    return '\n'.join(L) + '\n'


