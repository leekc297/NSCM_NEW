    st = load_state(ID) or {'items': {}}
    st.setdefault('built', {})[f'{mode}_{scope}'] = {
        'pkg': os.path.basename(dst), 'built': now().strftime('%Y-%m-%d %H:%M:%S'), 'fingerprint': fingerprint,
        'rehearsal_ok': rehearsal_ok, 'mode': mode, 'scope': scope, 'items': items}
    write_state(ID, st)


def save_built_src(ID, pkg, D):
    """1.4.0: 이 패키지가 담은 시점의 사내 코드 원문 보관 — 이관 완료 표시 때 applied_src(다음 수정본 패치의 기준본)로 확정"""
    d = os.path.join(STATE_ROOT, ID, 'built_src', os.path.basename(pkg))
