META_AREAS = [
    ('SCM_ADM_MNU_M', "MNU_ID = :id", 'insert', '메뉴 행 (메뉴 트리·노출은 클라우드 운영값 존중 — 없을 때만)'),
    ('SCM_ADM_API_M', "API_ID LIKE :id || '\\_%' ESCAPE '\\'", 'upsert', '화면 전용 API'),
    ('SCM_ADM_API_M', "API_ID IN (SELECT API_ID FROM SCM_MGR.SCM_ADM_MNU_BTN_MPG_M WHERE MNU_ID = :id) AND API_ID NOT LIKE :id || '\\_%' ESCAPE '\\'", 'insert', '공용 API(이 화면 버튼이 씀)'),
    ('SCM_ADM_MNU_BTN_MPG_M', "MNU_ID = :id", 'upsert', '버튼 → API 매핑'),
    ('SCM_ADM_PROC_M', "PROC_NM LIKE 'PKG\\_' || :id || '.%' ESCAPE '\\'", 'upsert', '화면 PKG 프로시저 파라미터'),
    ('SCM_ADM_PROC_M', "PROC_NM IN (SELECT A.API_URL FROM SCM_MGR.SCM_ADM_API_M A JOIN SCM_MGR.SCM_ADM_MNU_BTN_MPG_M B ON B.API_ID = A.API_ID WHERE B.MNU_ID = :id) AND PROC_NM NOT LIKE 'PKG\\_' || :id || '.%' ESCAPE '\\'", 'insert', '공용 프로시저 파라미터'),
    ('SCM_ADM_USER_GR_MNU_MPG_M', "MNU_ID = :id", 'insert', '그룹 메뉴 권한'),
    ('SCM_ADM_USER_GR_MNU_BTN_MPG_M', "MNU_ID = :id", 'insert', '그룹 버튼 권한'),
    ('SCM_MST_SHEET_COLUMNS', "PROGRAM_ID = :id", 'upsert', '시트 컬럼'),
    ('SCM_MST_SHEET_MEASURE', "PROGRAM_ID = :id", 'upsert', '시트 Measure'),
]
NOPK_KEYS = {
    'SCM_MST_SHEET_COLUMNS': ['PROGRAM_ID', 'SHEET_NAME', 'COLUMN_NAME', 'DIVISION_ID', 'SMALL_CLASS_LABEL_NAME', 'LARGE_CLASS_LABEL_NAME', 'COLUMN_LABEL_NAME'],
    'SCM_MST_SHEET_MEASURE': ['PROGRAM_ID', 'SHEET_NAME', 'COLUMN_NAME', 'DIVISION_ID', 'SMALL_CLASS_LABEL_NAME', 'LARGE_CLASS_LABEL_NAME', 'COLUMN_LABEL_NAME'],
    'SCM_ADM_MSG_M': ['MSG_ID', 'LANG_CD'],
}


def table_cols(c, t):
    return c.q("SELECT COLUMN_NAME, DATA_TYPE, NULLABLE FROM ALL_TAB_COLUMNS WHERE OWNER = :o AND TABLE_NAME = :t ORDER BY COLUMN_ID", o=OWNER, t=t)


def table_pk(c, t):
    r = c.q("""SELECT LISTAGG(K.COLUMN_NAME, ',') WITHIN GROUP (ORDER BY K.POSITION) COLS FROM ALL_CONSTRAINTS C
                 JOIN ALL_CONS_COLUMNS K ON K.OWNER = C.OWNER AND K.CONSTRAINT_NAME = C.CONSTRAINT_NAME
                WHERE C.OWNER = :o AND C.TABLE_NAME = :t AND C.CONSTRAINT_TYPE = 'P'""", o=OWNER, t=t)
    return r[0]['COLS'].split(',') if r and r[0]['COLS'] else None


def pick_key(t, rows, pk):
    if pk:
        return pk, 'PK'
    cands = NOPK_KEYS.get(t, [])
    for n in range(2, len(cands) + 1):
        k = cands[:n]
        seen = set()
        ok = True
        for r in rows:
            v = tuple(r.get(x) for x in k)
            if v in seen:
                ok = False
                break
            seen.add(v)
        if ok:
            return k, '유일 키 실측(PK 없음)'
    return cands, '유일 키 없음 — 동일 행 중복'


def collect_meta(c, ID, D, ctx):
    out = []
    texts = []  # MSG/콤보 ID 탐색용 텍스트
    for (code_txt) in D['code'].values():
        texts.append(code_txt)
    texts.extend(ctx.get('fe_texts', []))
    for t, cond, mode, desc in META_AREAS:
        cols = table_cols(c, t)
        rows = c.q(f"SELECT * FROM {OWNER}.{t} WHERE {cond}", id=ID)
        pk = table_pk(c, t)
        key, how = pick_key(t, rows, pk)
        out.append({'table': t, 'cond': cond, 'mode': mode, 'desc': desc, 'cols': cols, 'rows': rows, 'key': key, 'key_how': how})
        for r in rows:
            texts.extend(str(v) for v in r.values() if isinstance(v, str))
    blob = '\n'.join(texts)
    # MSG / LBL / MNU
    ids = set(re.findall(r'\b(?:MSG|LBL|MNU)\d{3,6}\b', blob))
    ids |= set(re.findall(r'\bMNU_[A-Z]{3}\d{4}\b', blob))
    ids |= set(re.findall(r'\bMSG_API_[A-Z0-9_]+\b', blob))
    msg_rows = c.q(f"SELECT * FROM {OWNER}.SCM_ADM_MSG_M WHERE MSG_ID LIKE '%' || :id || '%'", id=ID)
    if ids:
        idl = sorted(ids)
        for i in range(0, len(idl), 500):
            part = ','.join("'" + x + "'" for x in idl[i:i + 500])
            msg_rows += c.q(f"SELECT * FROM {OWNER}.SCM_ADM_MSG_M WHERE MSG_ID IN ({part})")
    uniq = {}
    for r in msg_rows:
        uniq[(r['MSG_ID'], r['LANG_CD'])] = r
    msg_rows = [uniq[k] for k in sorted(uniq)]
    out.append({'table': 'SCM_ADM_MSG_M', 'cond': '참조 MSG/LBL/MNU ID + 이름에 화면 ID', 'mode': 'insert', 'desc': '문구(MSG/LBL/MNU) — INSERT NOT EXISTS 전용(#140)',
                'cols': table_cols(c, 'SCM_ADM_MSG_M'), 'rows': msg_rows, 'key': ['MSG_ID', 'LANG_CD'], 'key_how': '논리 키(MSG_ID, LANG_CD)'})
    # 콤보 SQL
    all_sql = [r['SQL_ID'] for r in c.q(f"SELECT DISTINCT SQL_ID FROM {OWNER}.SCM_ADM_CMBO_SQL_M")]
    meta_vals = set()
    for m in out:
        for r in m['rows']:
            meta_vals |= {v for v in r.values() if isinstance(v, str)}
    used = sorted(s for s in all_sql if s in meta_vals or re.search(r"""['"`]""" + re.escape(s) + r"""['"`]""", blob))
    cmb = []
    for i in range(0, len(used), 500):
        part = ','.join("'" + x.replace("'", "''") + "'" for x in used[i:i + 500])
        cmb += c.q(f"SELECT * FROM {OWNER}.SCM_ADM_CMBO_SQL_M WHERE SQL_ID IN ({part}) ORDER BY SQL_ID, MDU_DIVS_CD")
    out.append({'table': 'SCM_ADM_CMBO_SQL_M', 'cond': '화면 FE·PKG·META 가 부르는 콤보 SQL_ID', 'mode': 'insert', 'desc': '콤보 SQL(공용) — 없을 때만',
                'cols': table_cols(c, 'SCM_ADM_CMBO_SQL_M'), 'rows': cmb, 'key': table_pk(c, 'SCM_ADM_CMBO_SQL_M') or ['SQL_ID', 'MDU_DIVS_CD'], 'key_how': 'PK'})
    return out


