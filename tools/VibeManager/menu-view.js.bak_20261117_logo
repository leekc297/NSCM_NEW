  const el = (tag, cls, txt) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; };
  const svg = name => { const s = el('span'); s.style.display = 'contents'; s.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true">' + (IC[name] || IC.dot) + '</svg>'; return s.firstChild; };
