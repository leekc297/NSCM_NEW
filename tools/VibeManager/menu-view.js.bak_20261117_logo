  // 2.0.3(아코디언): 구획 머리줄을 위아래로 쌓고, 누른 구획만 그 자리에서 펼친다(한 번에 하나). 펼친 구획을 다시 누르면 접힌다.
  //   안쪽 접힌 항목(▸)으로 들어가면 펼친 구획 안에 뒤로 버튼과 경로가 나온다
  function draw() {
    const m = cur; const acc = $('acc'); const key = m.tab + '\u0001' + m.stack.join('\u0001'); const same = key === lastKey; const top = acc.scrollTop; lastKey = key;
