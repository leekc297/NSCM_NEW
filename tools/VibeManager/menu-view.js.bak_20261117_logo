  });

  function tile(n) {
    const dir = n.st === 'closed';
    const b = el('button', 'tile' + (dir ? ' dir' : '')); b.dataset.s = (n.name + ' ' + n.text + ' ' + n.desc + ' ' + n.tip).toLowerCase(); b.title = tipOf(n);
    const ic = el('span', 'ic' + (n.tone ? ' tone-' + n.tone : '')); ic.appendChild(svg(n.icon)); b.appendChild(ic);
    b.appendChild(el('span', 'lb', n.name));
    b.onclick = () => { if (dir) { st.stack = st.stack.concat([n.key]); $('q').value = ''; ask(); } else vscode.postMessage({ type: 'run', id: n.id }); };
    return b;
  }
  function row(n) {
    const dir = n.st === 'closed'; const hit = dir || n.run;
    const r = el('div', 'row'); r.dataset.s = (n.name + ' ' + n.text + ' ' + n.desc + ' ' + n.tip).toLowerCase();
    const body = el(hit ? 'button' : 'div', 'rb'); body.title = tipOf(n);
    const ri = el('span', 'ri' + (n.tone ? ' tone-' + n.tone : '')); if (n.icon) ri.appendChild(svg(n.icon)); body.appendChild(ri);
    const rt = el('span', 'rt'); rt.appendChild(el('div', 'rl', n.name)); if (n.desc && n.desc !== 'ID') rt.appendChild(el('div', 'rd', n.desc)); body.appendChild(rt);
    if (dir) { const cv = el('span', 'cv'); cv.appendChild(svg('chevron')); body.appendChild(cv); }
    if (hit) { r.classList.add('hit'); body.onclick = () => { if (dir) { st.stack = st.stack.concat([n.key]); $('q').value = ''; ask(); } else vscode.postMessage({ type: 'run', id: n.id }); }; }
    r.appendChild(body);
    if (n.act) { const a = el('button', 'ab'); a.appendChild(svg(n.act === 'toggle' ? 'power' : 'external')); a.title = n.act === 'toggle' ? S.toggle : S.open; a.setAttribute('aria-label', a.title); a.onclick = () => vscode.postMessage({ type: 'act', act: n.act, id: n.id }); r.appendChild(a); }
    return r;
  }
  // 2.1.0(D2): 모든 항목 = 한 줄 행(타일 격자 없음). 펼침 항목 = 접고 펼 수 있는 구획(머리 버튼 + 내용). 접힘 상태는 탭·경로·구획 이름 키로 보존
  function render(nodes, host, path) {
