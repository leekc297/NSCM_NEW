.grid{flex:1;min-height:60px;overflow:auto;padding:12px 14px;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;align-content:start}
.card{background:var(--card);border:1px solid var(--b);border-radius:10px;padding:11px 12px;cursor:pointer;display:flex;flex-direction:column;gap:6px;min-width:0}
.card:hover{border-color:var(--acc)}.card.sel{border-color:var(--acc);box-shadow:0 0 0 1px var(--acc) inset}
.card .top{display:flex;align-items:center;gap:8px}
.card .id{font-weight:700;font-size:13.5px}
.card .st{font-size:11px;color:var(--mut)}
.ring{--p:0;width:42px;height:42px;border-radius:50%;background:conic-gradient(var(--run) calc(var(--p)*1%),var(--b) 0);display:grid;place-items:center;margin-left:auto;flex:none}
.ring.done{background:conic-gradient(var(--ok) 100%,var(--b) 0)}.ring.fail{background:conic-gradient(var(--bad) calc(var(--p)*1%),var(--b) 0)}
.ring b{width:32px;height:32px;border-radius:50%;background:var(--vscode-editor-background);display:grid;place-items:center;font-size:10.5px;font-weight:600}
.card .stage{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.card .prog{font-size:11px;color:var(--mut);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.card .unv{font-size:11px;font-weight:600;color:var(--warn);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.card .unv.ok{color:var(--ok)} /* 2026-11-20 미검증 건수 */
.card .why{font-size:11px;color:var(--bad);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.card .why.ok{color:var(--mut)}
/* 2026-11-23 사용자: 카드를 누르면 상세 프로세스(단계별 진행). 사용자 매뉴얼처럼 Workbench 에서 볼 수 없는 모듈 업무는 자동으로 펼침 */
.detail{display:none;position:relative;flex:0 1 auto;max-height:50%;min-height:80px;overflow:auto;border-top:1px solid var(--b);padding:8px 14px 10px}#dClose{position:absolute;top:6px;right:10px}
.right.dOpen .detail{display:block}.right.dOpen .grid{flex:0 1 auto;max-height:38%}.right.dOpen.dBig .grid{flex:none;max-height:none}.right.dOpen .log{height:20%}.right.dOpen.dBig .detail{flex:1 1 auto;max-height:none}
.dh{display:flex;align-items:center;gap:4px 8px;flex-wrap:wrap;font-size:12px;margin-bottom:6px;padding-right:34px}.dh b{font-size:13px}.dh .hint{color:var(--mut)}
.dbar{height:4px;border-radius:2px;background:var(--b);overflow:hidden;margin:2px 0 8px}.dbar i{display:block;height:100%;background:var(--run)}.dbar i.ok{background:var(--ok)}.dbar i.bad{background:var(--bad)}
.fs{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:6px;font-size:12px}.fs+.fs,.fsx+.fs{margin-top:2px}
.fs .fi{width:16px;text-align:center;flex:none;font-weight:700}.fs .fn{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.fs .fa{font-size:10.5px;padding:1px 6px;border-radius:8px;border:1px solid var(--b);color:var(--mut);flex:none}.fs .fa.ai{border-color:var(--acc);color:var(--acc)}.fs .ft{font-size:11px;color:var(--mut);flex:none;min-width:64px;text-align:right}
.fs.f-run,.fs.f-repair{background:color-mix(in srgb,var(--run) 14%,transparent)}.fs.f-run .fi,.fs.f-repair .fi{color:var(--run)}.fs.f-ok .fi{color:var(--ok)}.fs.f-warn .fi,.fs.f-hold .fi,.fs.f-cut .fi{color:var(--warn)}.fs.f-fail{background:color-mix(in srgb,var(--bad) 12%,transparent)}.fs.f-fail .fi{color:var(--bad)}.fs.f-wait,.fs.f-skip,.fs.f-notrun{color:var(--mut)}
.fsx{margin:0 0 2px 32px;font-size:11px;color:var(--mut);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.fsx.bad{color:var(--bad);white-space:normal}
.dfoot{margin-top:8px;font-size:11.5px}.dfoot .out{margin-top:3px}
@keyframes dpulse{50%{opacity:.35}}.fs.f-run .fi,.fs.f-repair .fi{animation:dpulse 1.2s ease-in-out infinite}
.card .meta{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--mut)}
.card .meta .lk{opacity:.75}.card .meta .lk:hover{opacity:1}
.actor.claude{color:var(--cl)}
a.lk{color:var(--vscode-textLink-foreground);cursor:pointer;text-decoration:none}
.empty{color:var(--mut);padding:14px}
.log{height:30%;min-height:90px;overflow:auto;border-top:1px solid var(--b);font-family:var(--vscode-editor-font-family,monospace);font-size:11.5px;white-space:pre-wrap;word-break:break-all;padding:8px 14px;line-height:1.45}
.logh{display:flex;align-items:center;gap:8px;padding:4px 14px;border-top:1px solid var(--b);font-size:11px;color:var(--mut)}
@media (max-width:760px){.main{flex-direction:column}.side{width:auto !important;border-right:none;border-bottom:1px solid var(--b);max-height:55%}.split{display:none}}
.ico.hot:not(:disabled){background:var(--vscode-button-background);color:var(--vscode-button-foreground);border-color:transparent}
.head{position:relative;z-index:5}
.jam{position:relative;display:inline-flex}
.jam #jamBtn{width:auto;padding:0 5px;gap:2px}
.jam #jamBtn[aria-expanded=true]{border-color:var(--acc)}
.jamm{display:none;position:absolute;top:calc(100% + 6px);right:0;z-index:20;min-width:190px;padding:5px;flex-direction:column;gap:1px;border-radius:12px;border:1px solid var(--b);background:var(--vscode-menu-background,var(--vscode-editorWidget-background,var(--vscode-editor-background,#fff)));color:var(--vscode-menu-foreground,inherit);box-shadow:0 10px 28px -8px rgba(0,0,0,.55)}
.jamm.on{display:flex}
.jait{display:flex;align-items:center;gap:9px;width:100%;padding:6px 9px;border:0;border-radius:8px;background:transparent;color:inherit;font:inherit;font-size:12px;text-align:left;cursor:pointer;white-space:nowrap}
.jait:hover:not(:disabled),.jait:focus-visible{background:var(--vscode-list-hoverBackground,rgba(127,127,127,.15));outline:none}
.jait:disabled{opacity:.45;cursor:default}
.jait .ji{width:16px;flex:none;text-align:center}
/* ── 2026-11-20 사용자: VMW 프리미엄 글래스모피즘(은은한 색감) · VMO 와 같은 변수 ── */
:root{--acc:color-mix(in srgb,var(--vscode-focusBorder,#4c9aff) 58%,#8b93a7);--a1:color-mix(in srgb,var(--vscode-charts-blue,#3794ff) 58%,#8b93a7);--a2:color-mix(in srgb,var(--vscode-charts-purple,#a371f7) 55%,#8b93a7);--a3:color-mix(in srgb,var(--vscode-charts-green,#3fb9a8) 50%,#8b93a7);
  --run:color-mix(in srgb,var(--vscode-charts-blue,#58a6ff) 62%,#8b93a7);--cl:color-mix(in srgb,var(--vscode-charts-purple,#a371f7) 62%,#8b93a7);
  --ok:color-mix(in srgb,var(--vscode-testing-iconPassed,#3fb950) 72%,#8b93a7);--warn:color-mix(in srgb,var(--vscode-editorWarning-foreground,#d29922) 72%,#8b93a7);--bad:color-mix(in srgb,var(--vscode-errorForeground,#f85149) 70%,#8b93a7);
  --fg:var(--vscode-foreground);--b:color-mix(in srgb,var(--fg) 12%,transparent);--sel:color-mix(in srgb,var(--a1) 20%,transparent);
  --gx1:color-mix(in srgb,var(--fg) 7.5%,transparent);--gx0:color-mix(in srgb,var(--fg) 3%,transparent);--gxb:color-mix(in srgb,var(--fg) 12%,transparent);
  --gxh:inset 0 1px 0 rgba(255,255,255,.10),inset 0 -1px 0 rgba(255,255,255,.02);--gxs:0 16px 40px -18px rgba(0,0,0,.55),0 2px 6px rgba(0,0,0,.18)}
.vscode-light{--gxh:inset 0 1px 0 rgba(255,255,255,.85),inset 0 -1px 0 rgba(255,255,255,.3);--gxs:0 14px 36px -18px rgba(40,60,120,.26),0 2px 6px rgba(40,60,120,.06);--gx1:color-mix(in srgb,#fff 62%,transparent);--gx0:color-mix(in srgb,#fff 40%,transparent);--gxb:color-mix(in srgb,#fff 85%,transparent);--b:color-mix(in srgb,var(--fg) 14%,transparent)}
body{background:radial-gradient(120% 90% at 50% 0%,color-mix(in srgb,var(--vscode-editor-background) 92%,#24304d),var(--vscode-editor-background) 70%)}
.vmo-aur{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.vmo-aur i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.24;animation:vmoDrift 30s ease-in-out infinite alternate}
.vmo-aur i:nth-child(1){width:600px;height:600px;left:-160px;top:-240px;background:var(--a1)}
.vmo-aur i:nth-child(2){width:520px;height:520px;right:-170px;top:-140px;background:var(--a2);animation-duration:36s}
.vmo-aur i:nth-child(3){width:440px;height:440px;left:36%;bottom:-260px;background:var(--a3);opacity:.14;animation-duration:42s}
.vscode-light .vmo-aur i{opacity:.14}.vscode-light .vmo-aur i:nth-child(3){opacity:.09}
@keyframes vmoDrift{to{transform:translate(50px,34px) scale(1.06)}}
@media (prefers-reduced-motion:reduce){.vmo-aur i{animation:none}}
/* 유리 면: 왼쪽 설정 패널 · 오른쪽 머리줄 · 화면 카드 · 로그 */
.main{padding:8px 8px 0;gap:6px}
.side,.head,.card,.logwrap{background:linear-gradient(155deg,var(--gx1),var(--gx0) 60%);border:1px solid var(--gxb);-webkit-backdrop-filter:blur(22px) saturate(160%);backdrop-filter:blur(22px) saturate(160%);box-shadow:var(--gxs),var(--gxh)}
.side{border-radius:16px;overflow:hidden}
