//   Workbench = 화면 1개의 전 기능 / 업무 작업창 = 업무 1개 × 화면 여러 개 / VMO 창 = 기능·감시.
//   실행기 = job-runner.js(창을 닫아도 작업은 계속 돈다 · 다시 열면 이어서 본다). 화면 목록 = FLOW 대상(flow-panel.js targets) + AS-IS DB 프로그램 목록(버튼).
//   받는 메시지(웹뷰→확장): ready · loadAsis · create · openJob · start · pause · stop · retry · log · openWb · openFile
//   보내는 메시지(확장→웹뷰): init · asis · job · log · jobs · note
'use strict';
const vscode = require('vscode');
const cp = require('child_process');
const fs = require('fs');
const path = require('path');
const jr = require('./job-runner');
const flow = require('./flow-panel');

const panels = new Set();
// 2026-11-23 사용자: VMW 작업 완료 여부와 완료 뒤 산출물 위치를 알 수 있게. 작업이 끝나면 알림 1번(창이 여러 개여도) + 산출물 열기, 폴더 열기, 결과 요약
const notified = new Set();
function notifyEnd(p, jobId) {
  const j = jr.get(jobId); if (!j || notified.has(jobId + '|' + j.endedAt) || !/^(done|stopped)$/.test(j.status)) return; notified.add(jobId + '|' + j.endedAt);
  const c = {}; for (const s of j.screens) c[s.status] = (c[s.status] || 0) + 1; const outs = j.screens.flatMap(s => s.outputs || []);
  const ok = (c.done || 0) + (c.warn || 0); const bad = (c.fail || 0) + (c.cancel || 0);
  const msg = `Vibe_Manager VMW ${j.id} ${j.itemLabel.slice(0, 40)}: ${j.status === 'done' ? '끝남' : '중지'} · 완료 ${ok}/${j.screens.length}${bad ? ` · 실패 ${bad}` : ''}${outs.length ? ` · 산출물 ${outs.length}개: ${outs.join(', ')}` : ''}`;
  const btns = outs.length ? ['산출물 열기', '폴더 열기', '결과 요약'] : ['결과 요약'];
  (bad ? vscode.window.showWarningMessage : vscode.window.showInformationMessage)(msg, ...btns).then(a => {
    if (a === '산출물 열기') for (const o of outs) vscode.env.openExternal(vscode.Uri.file(path.join(p.root, o)));
    else if (a === '폴더 열기') vscode.commands.executeCommand('revealFileInOS', vscode.Uri.file(path.join(p.root, outs[0])));
    else if (a === '결과 요약') { const f = path.join(p.vibeDir, 'jobs', j.id, 'SUMMARY.md'); if (fs.existsSync(f)) vscode.commands.executeCommand('vscode.open', vscode.Uri.file(f)); }
  }, () => { });
}

function screenList(p) {
  const has = f => { try { return fs.existsSync(f); } catch { return false; } };
  let list = []; try { list = flow.targets(p); } catch { list = []; }
  return list.map(t => ({ id: t.id, title: t.title || '', status: t.status || '', dom: (/^[A-Z]+/.exec(t.id) || [''])[0],
    pack: has(path.join(p.outDir, 'screens', t.asis || t.id)), page: has(path.join(p.genDir, t.id, 'register.json')), chk: has(path.join(p.root, 'Doc', 'verify', t.id, 'run_verify.result.json')) }));
}
function loadAsis(p) {
  return new Promise(res => {
    const script = path.join(p.root, 'tools', 'DbConn', 'list_asis_programs.py'); if (!fs.existsSync(script)) return res({ ok: false, reason: 'tools/DbConn/list_asis_programs.py 없음' });
    let buf = ''; let child; try { child = cp.spawn(p.python || 'python', [script], { cwd: p.root, shell: process.platform === 'win32' }); } catch (e) { return res({ ok: false, reason: e.message }); }
    child.stdout.on('data', d => buf += d.toString('utf8')); child.stderr.on('data', d => buf += d.toString('utf8'));
    child.on('close', () => { try { res(JSON.parse(buf)); } catch { res({ ok: false, reason: (buf || '응답 없음').slice(0, 300) }); } });
    child.on('error', e => res({ ok: false, reason: `python 실행 실패: ${e.message}` }));
  });
}

// 2026-11-20 사용자 지시: 화면 선택에 '최근 선택'. 작업을 시작할 때 업무와 화면 목록을 .vibe/jobs/recent_sel.json 에 남긴다(최근 10개 · 같은 조합은 맨 앞으로)
function recentSel(p) { try { const a = JSON.parse(fs.readFileSync(path.join(p.vibeDir, 'jobs', 'recent_sel.json'), 'utf8')); return Array.isArray(a) ? a.slice(0, 10) : []; } catch { return []; } }
function addRecentSel(p, itemLabel, screens) {
  const key = `${itemLabel}|${screens.join(',')}`; const now = new Date(); const two = n => String(n).padStart(2, '0');
  const list = recentSel(p).filter(x => `${x.itemLabel}|${(x.screens || []).join(',')}` !== key);
  list.unshift({ at: `${now.getFullYear()}-${two(now.getMonth() + 1)}-${two(now.getDate())} ${two(now.getHours())}:${two(now.getMinutes())}`, itemLabel, screens: screens.slice(0, 500) });
  try { fs.mkdirSync(path.join(p.vibeDir, 'jobs'), { recursive: true }); fs.writeFileSync(path.join(p.vibeDir, 'jobs', 'recent_sel.json'), JSON.stringify(list.slice(0, 10), null, 1), 'utf8'); } catch (e) { try { require('./orch-errlog').note('jobs', 'addRecentSel', e); } catch { } }
  return list.slice(0, 10);
}

function open(api, focusId) {
  jr.init(api);
  // 2026-11-20 사용자 지적 '다시 로드 후 작업 재개 시 WORKBENCH 에서는 재개 되는데 VMW 에 재개된 작업이 보이지 않습니다': 작업 ID 를 받으면 열린 VMW 창이 있을 때 새 창 없이 그 창을 그 작업으로 바꾼다
  if (focusId && panels.size) { const st0 = [...panels][panels.size - 1]; st0.cur = focusId; try { st0.panel.reveal(); st0.panel.webview.postMessage({ type: 'jobs', items: jr.list(30) }); st0.panel.webview.postMessage({ type: 'job', job: jr.get(focusId) }); } catch { } return; }
  const p0 = api.paths(); const ko = p0.language === 'ko';
  const panel = vscode.window.createWebviewPanel('vibeManager.jobs', 'VMW', vscode.ViewColumn.Active, { enableScripts: true, retainContextWhenHidden: true });
  try { panel.iconPath = { light: vscode.Uri.file(path.join(api.ctx.extensionPath, 'media', 'vibe.svg')), dark: vscode.Uri.file(path.join(api.ctx.extensionPath, 'media', 'vibe-color.svg')) }; } catch { }
  const st = { panel, cur: focusId || '' }; panels.add(st);
  const post = m => { try { panel.webview.postMessage(m); } catch { } };
  const un = jr.on((jobId, kind, data) => {
    if (kind === 'end') { post({ type: 'jobs', items: jr.list(30) }); notifyEnd(p, jobId); }
    if (kind === 'start') { post({ type: 'jobs', items: jr.list(30) }); const cj = st.cur ? jr.get(st.cur) : null; if (jobId !== st.cur && (!cj || cj.status !== 'running')) { st.cur = jobId; post({ type: 'job', job: jr.get(jobId) }); } } // 2026-11-20 시작·재개된 작업을 보이게(보던 작업이 실행 중이면 그대로)
    if (jobId !== st.cur) return;
    if (kind === 'job') post({ type: 'job', job: data }); else if (kind === 'log') post({ type: 'log', screen: data.screen, text: data.text, append: true });
  });
  panel.onDidDispose(() => { try { un(); } catch { } panels.delete(st); });
  panel.webview.html = html(p0);
  panel.webview.onDidReceiveMessage(async m => {
    const p = api.paths();
    try {
      switch (m.type) {
        case 'vmerr': require('./orch-errlog').fromWebview('jobs', m); break;
        case 'orch:uiStat': { const uc = require('./orch-usercheck'); if (!uc.ready()) uc.init({ paths: () => api.paths() }); uc.noteUi(m); break; } // 개선안 20261121001943_SELF: VMW 작업 카드(tab job), 화면 목록(tab scr) 보고 → U16, U14 판정 자료
        case 'ready': {
          let mode = ''; try { mode = require('./workbench').workMode(p).db ? 'DB Mode' : 'UI&DB Mode'; } catch { }
          const jc = jr.loadCfg();
          post({ type: 'init', items: jr.batchItems(), screens: screenList(p), jobs: jr.list(30), recentSel: recentSel(p), mode, cfg: { maxPar: jc.jobMaxPar, maxClaude: jc.jobMaxClaude, cpuMax: jc.cpuMax, memMin: jc.memMin, rampSec: jc.rampSec } });
          if (!st.cur) { const ls = jr.list(30); const cut = ls.find(x => x.status === 'running') || ls.find(x => x.status === 'interrupted' && (jr.get(x.id) || {}).resumable); if (cut) st.cur = cut.id; } // 2026-11-20 작업 재개: 열 때 실행 중 작업, 없으면 가장 최근 재개 가능 작업을 고름
          if (st.cur) { const j = jr.get(st.cur); if (j) post({ type: 'job', job: j }); }
          break;
        }
        case 'loadAsis': { const d = await loadAsis(p); post({ type: 'asis', ok: !!d.ok, reason: d.reason || '', items: (d.items || []).map(x => ({ id: String(x.id || '').toUpperCase(), title: x.name || '' })) }); break; }
        case 'create': {
          let job; try { job = jr.create({ itemLabel: m.itemLabel, screens: m.screens, inputs: m.inputs || {}, onFail: m.onFail, autoAnswer: !!m.autoAnswer, mode: m.mode === 'par' ? 'par' : 'seq', maxPar: m.maxPar }); } catch (e) { post({ type: 'note', text: `작업을 만들 수 없음: ${e.message}`, bad: true }); break; }
          st.cur = job.id; jr.start(job.id); post({ type: 'job', job: jr.get(job.id) }); post({ type: 'jobs', items: jr.list(30) });
          post({ type: 'recentSel', items: addRecentSel(p, String(m.itemLabel || ''), (m.screens || []).map(String)) });
          break;
        }
        case 'pickFile': { // 2026-11-23 사용자 매뉴얼 업무 입력: 양식, 캡처 파일 선택
          const r = await vscode.window.showOpenDialog({ canSelectMany: !!m.many, canSelectFolders: !!m.folder, openLabel: '선택', filters: m.filters && typeof m.filters === 'object' ? m.filters : undefined, defaultUri: m.cur && fs.existsSync(m.cur) ? vscode.Uri.file(path.dirname(m.cur)) : undefined });
          if (r && r[0]) post({ type: 'picked', name: m.name, path: r[0].fsPath, paths: r.map(u => u.fsPath) });
          break;
        }
        case 'openOut': { const f = path.resolve(p.root, String(m.path || '')); if (path.relative(p.root, f).startsWith('..') || !fs.existsSync(f)) { post({ type: 'note', text: `파일 없음: ${m.path}`, bad: true }); break; } if (m.reveal) vscode.commands.executeCommand('revealFileInOS', vscode.Uri.file(f)); else vscode.env.openExternal(vscode.Uri.file(f)); break; } // 2026-11-23 산출물(PPTX 등)은 연결 프로그램으로 열기, 폴더 열기
        case 'openJob': { const j = jr.get(m.id); if (j) { st.cur = j.id; post({ type: 'job', job: j }); } break; }
        case 'start': if (!jr.start(m.id)) post({ type: 'note', text: '실행할 화면이 없거나 이미 실행 중입니다' }); break;
        case 'retry': if (!jr.retryFailed(m.id)) post({ type: 'note', text: '실패·중지한 화면이 없거나 실행 중입니다' }); break;
        case 'pause': jr.pause(m.id); break;
        case 'del': { // 2026-11-20 작업 삭제 = 중지 후 삭제(확인 뒤)
          const j = jr.get(m.id); if (!j) break; const running = /^(running|pausing)$/.test(j.status);
          const a = await vscode.window.showWarningMessage(`VMW 작업 ${m.id}(${j.itemLabel}, 화면 ${j.screens.length}개)을 삭제합니다.${running ? ' 실행 중인 화면을 먼저 중지합니다.' : ''} 목록, 화면 로그, 재개 기록이 지워지고 되돌릴 수 없습니다.`, { modal: true }, '삭제');
          if (a !== '삭제') break; post({ type: 'note', text: running ? '중지 중 … 끝나면 삭제' : '삭제 중 …' });
          const r = await jr.remove(m.id); if (!r.ok) { post({ type: 'note', text: `삭제 안 함: ${r.why}`, bad: true }); break; }
          if (st.cur === m.id) { st.cur = ''; post({ type: 'job', job: null }); } post({ type: 'jobs', items: jr.list(30) }); post({ type: 'note', text: `삭제함: ${m.id}${r.progress ? ` · 재개 기록 ${r.progress}건` : ''}` });
          break;
        }
        case 'stop': { const a = await vscode.window.showWarningMessage(ko ? '실행 중인 화면도 중지합니다. 그 화면의 진행분은 없어집니다.' : 'Stop running screens too?', { modal: true }, ko ? '중지' : 'Stop'); if (a) jr.stop(m.id); break; }
        case 'log': post({ type: 'log', screen: m.screen, text: jr.logOf(m.id, m.screen) || readLogFile(p, m.id, m.screen), append: false }); break;
        case 'openWb': {
          require('./workbench').openForScreen(api, m.screen); // 2026-11-20 같은 화면 창이 열려 있으면 그 창 Console, 없으면 새 창
          break;
        }
        case 'openFile': { const f = path.resolve(p.root, String(m.path || '')); if (!path.relative(p.root, f).startsWith('..') && fs.existsSync(f)) api.openPath(f); else post({ type: 'note', text: `파일 없음: ${m.path}` }); break; }
      }
    } catch (e) { post({ type: 'note', text: `오류: ${e.message}`, bad: true }); }
  });
  return st;
}
function readLogFile(p, jobId, screen) { try { const f = path.join(p.vibeDir, 'jobs', jobId, `${screen}.log`); const s = fs.readFileSync(f, 'utf8'); return s.length > 200000 ? s.slice(-200000) : s; } catch { return ''; } }

