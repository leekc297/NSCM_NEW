.card{transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease}
.ring{background:conic-gradient(var(--run) calc(var(--p)*1%),color-mix(in srgb,var(--fg) 10%,transparent) 0)}
.ring.done{background:conic-gradient(var(--ok) 100%,transparent 0)}.ring.fail{background:conic-gradient(var(--bad) calc(var(--p)*1%),color-mix(in srgb,var(--fg) 10%,transparent) 0)}
