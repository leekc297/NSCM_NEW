<script>
const vscode = acquireVsCodeApi(); /* 2026-11-20 사용자 지시 'VMW 의 왼쪽 영역을 펴기/닫기': 접은 상태는 웹뷰 상태(vscode.setState)에 남겨 창을 다시 열어도 유지 */ function paintSide(off){ const m=document.querySelector('.main'); const b=document.getElementById('bSide'); if(!m||!b) return; m.classList.toggle('sideOff',!!off); b.textContent=off?'▶':'◀'; const t=off?(KO?'왼쪽 영역 펴기':'Expand left panel'):(KO?'왼쪽 영역 접기':'Collapse left panel'); b.title=t; b.setAttribute('aria-label',t); b.setAttribute('aria-expanded',off?'false':'true'); } function sideState(){ try { return !!((vscode.getState()||{}).sideOff); } catch(e){ return false; } } function sideW(){ try { return Number((vscode.getState()||{}).sideW)||0; } catch(e){ return 0; } } function setSideW(w){ const sd=document.querySelector('.side'); if(!sd) return; const max=Math.max(260,Math.round(window.innerWidth*0.7)); const v=Math.max(220,Math.min(max,Math.round(w))); sd.style.width=v+'px'; return v; } window.addEventListener('DOMContentLoaded',function(){ if(sideW()) setSideW(sideW()); const sp=document.getElementById('split'); if(sp){ let x0=0,w0=0; const mv=function(e){ setSideW(w0+(e.clientX-x0)); }; const up=function(){ document.removeEventListener('mousemove',mv); document.removeEventListener('mouseup',up); sp.classList.remove('drag'); document.body.classList.remove('resizing'); const w=document.querySelector('.side').getBoundingClientRect().width; try { vscode.setState(Object.assign({}, vscode.getState()||{}, { sideW: Math.round(w) })); } catch(e){} }; sp.addEventListener('mousedown',function(e){ e.preventDefault(); x0=e.clientX; w0=document.querySelector('.side').getBoundingClientRect().width; sp.classList.add('drag'); document.body.classList.add('resizing'); document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up); }); sp.addEventListener('dblclick',function(){ const sd=document.querySelector('.side'); sd.style.width=''; try { const st=Object.assign({}, vscode.getState()||{}); delete st.sideW; vscode.setState(st); } catch(e){} }); } paintSide(sideState()); const b=document.getElementById('bSide'); if(b) b.onclick=function(){ const off=!document.querySelector('.main').classList.contains('sideOff'); try { vscode.setState(Object.assign({}, vscode.getState()||{}, { sideOff: off })); } catch(e){} paintSide(off); }; }); ${require('./orch-errlog').webviewSnippet('vscode')} const $ = id => document.getElementById(id); const KO = ${ko ? 'true' : 'false'};
const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let items=[], screens=[], sel=new Set(), dom='', job=null, logScreen='';
/* 2026-11-23 사용자 매뉴얼: 모듈 단위 업무(unit module) = 화면 목록 대신 모듈 체크 + 입력 칸(jobInputs). 입력값은 웹뷰 상태(jin)에 남김 */
const modSel=new Set(); let JIN={}; try{ JIN=(vscode.getState()||{}).jin||{}; }catch(e){}
function curItem(){ return items.find(x=>x.label===$('item').value)||null; }
function isMod(){ const it=curItem(); return !!(it&&it.unit==='module'); }
function today(){ const d=new Date(), t=n=>String(n).padStart(2,'0'); return d.getFullYear()+'-'+t(d.getMonth()+1)+'-'+t(d.getDate()); }
function saveJin(){ try{ const s0=vscode.getState()||{}; s0.jin=JIN; vscode.setState(s0); }catch(e){} }
function jinVal(f){ const k=f.name; if(f.multi){ const v=JIN[k]; return Array.isArray(v)?v:(v?[String(v)]:[]); } if(JIN[k]!=null&&JIN[k]!=='') return JIN[k]; return f.type==='date'?today():(f.default||''); }
function baseName(p){ const a=String(p).split(String.fromCharCode(92)).join('/').split('/'); return a[a.length-1]||p; }
/* 2026-11-23 사용자: 모듈 업무에서 최근 선택을 고를 수 없음(화면 영역과 같이 숨겨짐) → 모듈 업무면 최근 선택 목록을 모듈 영역으로 옮김 */
let RSEL_HOME=null; function placeRsel(on){ const r=$('rsel'); if(!r) return; if(!RSEL_HOME) RSEL_HOME={p:r.parentNode,n:r.nextSibling}; if(on){ if(r.parentNode!==$('rselMod')){ $('rselMod').appendChild(r); r.style.flex='1'; } } else if(r.parentNode!==RSEL_HOME.p){ RSEL_HOME.p.insertBefore(r,RSEL_HOME.n); } }
function paintMod(){ const it=curItem(); const on=isMod(); placeRsel(on); { const sd=document.querySelector('.side'); if(sd) sd.classList.toggle('modOn',on); } $('modSec').style.display=on?'':'none'; $('scrSec').style.display=on?'none':''; $('list').style.display=on?'none':''; $('pasteRow').style.display=on?'none':'';
  if(!on) return;
  $('mods').innerHTML=(it.modules||[]).map(m=>'<label class="togg"><input type="checkbox" data-m="'+esc(m)+'"'+(modSel.has(m)?' checked':'')+'> '+esc(m)+'</label>').join(' ');
  $('mods').querySelectorAll('input[data-m]').forEach(b=>b.onchange=()=>{ if(b.checked) modSel.add(b.dataset.m); else modSel.delete(b.dataset.m); paintSel(); });
  $('jin').innerHTML=(it.jobInputs||[]).map(f=>{ const lb=esc(KO?(f.label||f.name):(f.label_en||f.label||f.name)); const v=esc(jinVal(f));
    if(f.type==='file'&&f.multi){ const arr=jinVal(f); return '<div class="row" style="align-items:flex-start"><span class="hint" style="width:118px;flex:none;padding-top:4px" title="'+lb+'">'+lb+'</span><div class="flist">'+(arr.length?arr.map((x,i)=>'<div class="fi"><span title="'+esc(x)+'">'+esc(baseName(x))+'</span><button data-rm="'+esc(f.name)+'" data-i="'+i+'" title="'+(KO?'빼기':'Remove')+'">✕</button></div>').join(''):'<span class="hint">'+(KO?'파일 없음 · … 로 추가(여러 개 선택 가능)':'No files · add with …')+'</span>')+'</div><button class="ico" data-pick="'+esc(f.name)+'" title="'+(KO?'추가(여러 개 선택 가능)':'Add files')+'">…</button></div>'; }
    if(f.type==='file') return '<div class="row" title="'+lb+'"><span class="hint" style="width:118px;flex:none" title="'+lb+'">'+lb+'</span><input type="text" data-in="'+esc(f.name)+'" value="'+v+'" style="flex:1" placeholder="'+(KO?'파일 경로':'file path')+'"><button class="ico" data-pick="'+esc(f.name)+'" title="'+(KO?'찾기':'Browse')+'">…</button></div>';
    return '<div class="row"><span class="hint" style="width:118px;flex:none" title="'+lb+'">'+lb+'</span><input type="'+(f.type==='date'?'date':'text')+'" data-in="'+esc(f.name)+'" value="'+v+'" style="flex:1"></div>'; }).join('');
  $('jin').querySelectorAll('input[data-in]').forEach(e=>e.oninput=()=>{ JIN[e.dataset.in]=e.value; saveJin(); paintSel(); });
  $('jin').querySelectorAll('button[data-pick]').forEach(b=>b.onclick=()=>{ const f=(it.jobInputs||[]).find(x=>x.name===b.dataset.pick)||{}; const cur=f.multi?(jinVal(f)[0]||''):(JIN[f.name]||''); vscode.postMessage({type:'pickFile',name:f.name,filters:f.filters||null,many:!!f.multi,cur:cur}); });
  $('jin').querySelectorAll('button[data-rm]').forEach(b=>b.onclick=()=>{ const f=(it.jobInputs||[]).find(x=>x.name===b.dataset.rm)||{}; const arr=jinVal(f).slice(); arr.splice(+b.dataset.i,1); JIN[f.name]=arr; saveJin(); paintMod(); paintSel(); });
}
function jinMissing(){ const it=curItem(); if(!it||it.unit!=='module') return []; return (it.jobInputs||[]).filter(f=>f.optional!==true&&(f.multi?!jinVal(f).length:!String(jinVal(f)).trim())).map(f=>KO?(f.label||f.name):(f.label_en||f.name)); }
function jinOut(){ const it=curItem(); const o={}; for(const f of (it&&it.jobInputs)||[]){ if(f.multi){ o[f.name]=jinVal(f).slice(); continue; } let v=String(jinVal(f)).trim(); if(f.type==='date') v=fmtDay(v); /* 2026-11-23 Windows 일자 형식 */ o[f.name]=v; } return o; }
const SK = {wait:'대기',busy:'다른 곳에서 실행 중',admit:'입장 대기',run:'실행',done:'완료',warn:'완료(경고)',hold:'사람 확인 필요',fail:'실패',cancel:'중지',skip:'건너뜀'};
const JK = {idle:'시작 전',running:'실행 중',pausing:'일시 중지 중',paused:'일시 중지',stopped:'중지',interrupted:'중단됨',done:'끝남'};
function sec(n){ n=Math.max(0,Math.round(n||0)); if(n<60) return n+(KO?'초':'s'); const m=Math.floor(n/60); if(m<60) return m+(KO?'분 ':'m ')+(n%60)+(KO?'초':'s'); return Math.floor(m/60)+(KO?'시간 ':'h ')+(m%60)+(KO?'분':'m'); }
function note(t,bad){ const n=$('note'); n.textContent=t||''; n.className='note'+(bad?' bad':''); if(t) setTimeout(()=>{ if(n.textContent===t) n.textContent=''; }, 8000); }
function shown(){ const q=$('q').value.trim().toUpperCase(); const f=$('flt').value;
  return screens.filter(s=>(!dom||s.dom===dom)&&(!q||s.id.includes(q)||String(s.title).toUpperCase().includes(q))&&(f===''||(f==='pack'&&s.pack)||(f==='nopack'&&!s.pack)||(f==='page'&&s.page)||(f==='nopage'&&!s.page)||(f==='chk'&&s.chk)||(f==='nochk'&&!s.chk)||(f==='sel'&&sel.has(s.id)))); }
function paintList(){ const rows=shown(); $('cnt').textContent=(KO?'보이는 ':'shown ')+rows.length+' / '+screens.length+(KO?' · 선택 ':' · selected ')+sel.size;
  $('list').innerHTML = rows.length ? rows.slice(0,600).map(s=>'<label class="it"><input type="checkbox" data-id="'+s.id+'"'+(sel.has(s.id)?' checked':'')+'><b>'+esc(s.id)+'</b><span class="t" title="'+esc(s.title)+'">'+esc(s.title)+'</span><span class="f'+(s.pack?' y':'')+'" title="'+(KO?'AS-IS 분석 자료':'fact pack')+'"></span><span class="f'+(s.page?' y':'')+'" title="'+(KO?'TO-BE 화면 생성':'page')+'"></span><span class="f'+(s.chk?' y':'')+'" title="CheckList"></span></label>').join('')+(rows.length>600?'<div class="empty">'+(KO?'600개까지 표시 — 검색으로 좁히세요':'Showing 600')+'</div>':'') : '<div class="empty">'+(KO?'없음':'None')+'</div>';
  $('list').querySelectorAll('input[data-id]').forEach(c=>c.onchange=()=>{ if(c.checked) sel.add(c.dataset.id); else sel.delete(c.dataset.id); paintSel(); });
  paintSel(); uiStat('scr',{received:screens.length,blank:screens.filter(s=>!String(s.title||'').trim()||String(s.title).trim().toUpperCase()===s.id).map(s=>s.id)}); }
/* 개선안 20261121001943_SELF: 그린 목록을 감시(orch-usercheck noteUi)에 보고. 같은 내용은 60초에 1번, 내용이 바뀌면 바로 */
const UIS={};
function uiStat(tab,o){ const k=JSON.stringify(o); const u=UIS[tab]; const t=Date.now(); if(u&&u.k===k&&t-u.t<60000) return; UIS[tab]={k:k,t:t,o:o}; vscode.postMessage(Object.assign({type:'orch:uiStat',tab:tab},o)); }
setInterval(()=>{ for(const tab of Object.keys(UIS)){ const u=UIS[tab]; if(Date.now()-u.t>=60000) uiStat(tab,u.o); } },60000);
function paintSel(){ if(isMod()){ const it=curItem(); const a=(it.modules||[]).filter(m=>modSel.has(m)); const miss=jinMissing(); $('selTxt').textContent=a.length?((KO?'모듈 ':'Modules ')+a.join(', ')+(miss.length?(KO?' · 입력 빠짐: ':' · missing: ')+miss.join(', '):'')):(KO?'선택한 모듈 없음':'No modules selected'); $('go').disabled=!a.length||miss.length>0||!!it.disabled; $('mcnt').textContent=a.length+' / '+(it.modules||[]).length; return; }
  const a=[...sel]; $('selTxt').textContent=a.length?(KO?'선택 '+a.length+'개: ':'Selected '+a.length+': ')+a.join(', '):(KO?'선택한 화면 없음':'No screens selected'); { const itx=items.find(x=>x.label===$('item').value); $('go').disabled=!a.length||!$('item').value||!!(itx&&itx.disabled); } $('cnt').textContent=(KO?'보이는 ':'shown ')+shown().length+' / '+screens.length+(KO?' · 선택 ':' · selected ')+sel.size; }
function paintDoms(){ const ds=[...new Set(screens.map(s=>s.dom))].sort(); $('doms').innerHTML='<button data-d=""'+(dom===''?' class="on"':'')+'>'+(KO?'전체':'All')+'</button>'+ds.map(d=>'<button data-d="'+d+'"'+(dom===d?' class="on"':'')+'>'+d+' '+screens.filter(s=>s.dom===d).length+'</button>').join(''); $('doms').querySelectorAll('button').forEach(b=>b.onclick=()=>{dom=b.dataset.d;paintDoms();paintList();}); }
let CFG={maxPar:5,maxClaude:2,cpuMax:80,memMin:3072,rampSec:120};
function paintPar(){ const it=items.find(x=>x.label===$('item').value); const par=document.querySelector('input[name=md]:checked').value==='par'; let n=Math.max(1,Math.min(CFG.maxPar,parseInt($('mp').value,10)||CFG.maxPar)); $('mp').disabled=!par;
  $('parInfo').textContent=par?((KO?'동시 '+n+'화면까지(상한 '+CFG.maxPar+'). ':'Up to '+n+'. ')+(it&&it.selfAdmit?(KO?'CheckList 는 실행 스크립트가 부하를 재서 스스로 입장을 기다림. ':'CheckList admits itself. '):(KO?'두 번째 화면부터 CPU < '+CFG.cpuMax+'% · 여유 메모리 ≥ '+CFG.memMin+'MB · 입장 간격 '+CFG.rampSec+'초일 때만 시작, 아니면 순차. ':'2nd+ screen only when load allows. '))+(it&&it.claudeSteps?(KO?'AI Agent 는 동시에 '+CFG.maxClaude+'개까지.':'AI Agent sessions up to '+CFG.maxClaude+'.'):'')):(KO?'같은 화면이 다른 창에서 실행 중이면 뒤로 미룸':'Screens busy elsewhere are deferred'); }
function paintItem0(){ { const it0=items.find(x=>x.label===$('item').value); const w=$('itemWarn'); const msg=it0&&it0.disabled?it0.why:(it0&&it0.newScreen?(KO?'이미 생성된 화면은 건너뜁니다(일괄 작업은 기존 화면을 지우지 않음)':'Screens that already exist are skipped'):''); w.style.display=msg?'':'none'; w.textContent=msg; paintPar(); }
  const it=items.find(x=>x.label===$('item').value); $('itemInfo').textContent=it?((KO?'단계 ':'steps ')+(it.steps||1)+(it.claudeSteps?(KO?' · AI Agent 단계 ':' · AI Agent steps ')+it.claudeSteps:(KO?' · 스크립트만':' · script only'))+(it.hint?' · '+it.hint:'')):''; $('askRow').style.display=it&&it.hasAsk?'':'none'; if(it&&it.hasAsk) $('askTxt').textContent=(KO?'승인이 필요한 단계도 전 화면에 실행: ':'Also run steps that need approval: ')+String(it.askText||'').replace(/\\$\\{id\\}/g,KO?'화면':'screen').slice(0,120); paintSel(); }
// 2026-11-20 B 스튜디오: 화면별 카드(상태 점 · 진행 원 · 지금 단계 · 세부 진행 · 주체 · 소요 · 실패 원인 · 링크)
function pctOf(s){ if(s.status==='done'||s.status==='warn') return 100; const t=String(s.prog||''); let p=0; const st=/단계 (\\d+)\\/(\\d+)/.exec(t); if(st){ const i=+st[1], n=+st[2]||1; let f=0; const sub=/(?:시험|세부|AI 묶음) (\\d+)\\/(\\d+)/.exec(t); if(sub&&+sub[2]) f=Math.min(1,+sub[1]/+sub[2]); p=Math.round(((i-1)+f)/n*100); } return Math.max(0,Math.min(99,p)); }
function paintItem(){ paintMod(); paintItem0(); $('itemInfo').title=$('itemInfo').textContent; $('askTxt').parentNode.title=$('askTxt').textContent; $('parInfo').title=$('parInfo').textContent; }
/* 2026-11-20 사용자 지시 'VMW 카드에도 미검증 건수 표기': 이번 실행의 측정 분류 결과(Workbench 회차 판단 줄)만. 측정 전·이전 실행 값 없음 */
function unvLine(u){ if(!u) return ''; const t=KO?((u.round>1?(u.round-1)+'회차 재측정 뒤':'측정 뒤')+' 분류 · '+(u.go?u.round+'회차 보완 진행':'보완 반복 끝')+' · 읽은 시각 '+fmtD(u.at)):('round '+u.round+(u.go?' running':' done'));
  return '<div class="unv'+(u.total?'':' ok')+'" title="'+esc(t)+'">'+(KO?'미검증 '+u.total+'건 · 처리 대상 '+u.actionable+'건':'unverified '+u.total+' · actionable '+u.actionable)+'</div>'; }
function paintJob(){ const j=job; const has=!!j; const g=$('grid'); g.querySelectorAll('.card').forEach(c=>c.remove()); $('noJob').style.display=has?'none':'';
  if(!has){ $('jst').textContent=KO?'작업 없음':'No job'; $('jdot').className='dot'; $('jc').textContent=''; $('jn').textContent=''; $('jm').textContent=''; for(const b of ['bResume','bRetry','bPause','bStop','bSum','bDel']) $(b).disabled=true; uiStat('job',{received:0,jobIds:[]}); paintDetail(); return; }
