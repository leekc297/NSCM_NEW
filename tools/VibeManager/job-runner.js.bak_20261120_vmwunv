function summaryOf(job) { const c = {}; for (const s of job.screens) c[s.status] = (c[s.status] || 0) + 1; return { id: job.id, itemLabel: job.itemLabel, status: job.status, createdAt: job.createdAt, startedAt: job.startedAt, endedAt: job.endedAt, total: job.screens.length, counts: c, note: job.note || '' }; }

function busyElsewhere(job, screen) { // 같은 화면이 Workbench 나 다른 작업에서 체인 실행 중인가(같은 화면은 한 번에 1개)
