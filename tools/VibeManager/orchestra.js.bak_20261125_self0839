    return '<div class="a-lane"><div class="a-nm"><b>'+esc(l.key)+'</b><small>'+[l.sub?esc(l.sub):'',l.busySec?(KO?'실행 ':'run ')+aDur(l.busySec):'',l.waitSec?'<span class="a-wa">'+(KO?'대기 ':'wait ')+aDur(l.waitSec)+'</span>':''].filter(Boolean).join(' · ')+'</small></div><div class="a-track">'+segs+'<div class="a-nowln"></div></div></div>'; }).join('');
  $('bTlN').textContent=(KO?'최근 ':'last ')+T.min+(KO?'분 · 줄 ':'m · rows ')+T.lanes.length+(T.total>T.lanes.length?'/'+T.total:'');
  box.innerHTML='<div class="a-axis"><span></span><div class="a-ticks">'+ticks+'</div></div>'+(rows||'<div class="a-empty">'+(KO?'이 시간 동안 실행 기록 없음':'No activity in this window')+'</div>');
}
