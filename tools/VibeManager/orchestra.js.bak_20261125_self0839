<script>
const vscode = acquireVsCodeApi();
${require('./orch-errlog').webviewSnippet('vscode')}
${require('./id-input').webviewSnippet()}
${require('./date-fmt').webviewSnippet()}
const $ = id => document.getElementById(id);
const KO = ${ko ? 'true' : 'false'};
const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let cur = '';
let sub='be';
function showSub(k){ sub=(k==='fe'||k==='task')?k:'be'; document.querySelectorAll('.ls').forEach(b=>{const on=b.dataset.ls===sub;b.classList.toggle('on',on);b.setAttribute('aria-selected',on?'true':'false');if(on){const x=b.querySelector('.nb');if(x)x.remove();}}); $('belogB').style.display=sub==='be'?'':'none'; $('felogB').style.display=sub==='fe'?'':'none'; $('taskB').style.display=sub==='task'?'':'none'; scrollEnd(subBox()); paintSrvBtns(); }
function subBox(){ return sub==='fe'?'felogB':sub==='task'?'taskB':'belogB'; }
// 2026-11-20 BE · FE Log 켜고 끄기(사용자 지시). 꺼진 로그 칸에는 안내 1줄
let lgOn={be:false,fe:false};
function paintLg(){ ['be','fe'].forEach(function(k){ const b=$(k==='be'?'lgBe':'lgFe'); const on=!!lgOn[k]; b.classList.toggle('on',on); b.textContent=(k==='be'?'BE':'FE')+' '+(on?'On':'Off'); const tb=document.querySelector('.ls[data-ls="'+k+'"]'); if(tb) tb.classList.toggle('lgoff',!on); /* 2026-11-20 사용자 지시: 꺼짐이면 탭의 상태 점·응답 문구 숨김 */ b.title=(k==='be'?'BE':'FE')+' Log '+(on?(KO?'켜짐. 누르면 끔':'on. Click to turn off'):(KO?'꺼짐. 누르면 켜고 최근 부분부터 다시 읽음':'off. Click to turn on')); const box=$(boxOf(k)); if(!on){ box.textContent=''; const d=document.createElement('span'); d.className='mut'; d.textContent=(KO?'⏸ '+(k==='be'?'BE':'FE')+' Log 꺼짐. 위 '+(k==='be'?'BE':'FE')+' Off 단추를 누르면 켜지고 최근 부분부터 보입니다':'⏸ log off')+String.fromCharCode(10); box.appendChild(d); } }); }
document.querySelectorAll('[data-lg]').forEach(function(b){ b.onclick=function(){ const k=b.dataset.lg; lgOn[k]=!lgOn[k]; paintLg(); vscode.postMessage({type:'orch:logOn',stream:k,on:lgOn[k]}); }; });
function show(t){ if(t==='task'){ t='log'; setTimeout(()=>showSub('task'),0); } if(t==='belog'||t==='felog'){ const k=t==='felog'?'fe':'be'; t='log'; setTimeout(()=>showSub(k),0); } if(!$(t)) t='board'; cur=t; document.querySelectorAll('.tab').forEach(b=>{const on=b.dataset.t===t;b.classList.toggle('on',on);if(on){const n=b.querySelector('.nb');if(n)n.remove();}}); document.querySelectorAll('.pane').forEach(x=>x.classList.toggle('on',x.id===t)); const lb={log:subBox(),agent:'agB'}[t]; if(lb)scrollEnd(lb); try{vscode.setState({tab:t});}catch(e){} }
function scroller(id){ return $(id); }
function scrollEnd(id){ const s=scroller(id); s.scrollTop=s.scrollHeight; }
function mark(t){ if(cur===t) return; const b=document.querySelector('.tab[data-t="'+t+'"]'); if(b&&!b.querySelector('.nb')){const n=document.createElement('span');n.className='nb';n.textContent='●';b.appendChild(n);} }
function add(id, text, cls){ const b=$(id); const s=scroller(id); const stick=s.scrollHeight-s.scrollTop-s.clientHeight<60; const d=document.createElement('span'); if(cls)d.className=cls; d.textContent=text; b.appendChild(d); while(b.childNodes.length>5000)b.removeChild(b.firstChild); if(stick)s.scrollTop=s.scrollHeight; }
const boxOf = st => st==='be'?'belogB':st==='fe'?'felogB':'taskB';
const tabOf = st => 'log';
function markSub(k){ if(cur==='log'&&sub===k) return; const b=document.querySelector('.ls[data-ls="'+k+'"]'); if(b&&!b.querySelector('.nb')){const x=document.createElement('span');x.className='nb';x.textContent='●';b.appendChild(x);} }
function sec(n){ n=Math.max(0,Math.round(n||0)); if(n<60) return n+(KO?'초':'s'); const m=Math.floor(n/60); if(m<60) return m+(KO?'분 ':'m ')+(n%60)+(KO?'초':'s'); return Math.floor(m/60)+(KO?'시간 ':'h ')+(m%60)+(KO?'분':'m'); }
function hm(ms){ const d=new Date(ms); const p=n=>String(n).padStart(2,'0'); return p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds()); }
const stWord = s => s==='up'?(KO?'응답 있음':'Responding'):s==='listen'?(KO?'포트만 열림':'Port open, no HTTP'):(KO?'꺼짐':'Down');
let states=[]; let srvCmds={be:{},fe:{}};
function paintSrvBtns(){ const st=states.find(x=>x.port===(sub==='fe'?5173:8080)); const c=srvCmds[sub]||{}; const up=!!st&&st.state!=='down'; if($('lStart')){ $('lStart').disabled=sub==='task'||!c.start||up; $('lStop').disabled=sub==='task'||!c.stop||!up; } }
function paintServers(){
  const be=states.find(x=>x.port===8080), fe=states.find(x=>x.port===5173);
  $('dbe').className='dot '+(be?be.state:''); $('dfe').className='dot '+(fe?fe.state:''); $('dbe2').className='dot '+(be?be.state:''); $('dfe2').className='dot '+(fe?fe.state:'');
  $('sbe').textContent=be?stWord(be.state):''; $('sfe').textContent=fe?stWord(fe.state):''; paintSrvBtns();
  $('bSrv').innerHTML = states.length ? states.map(s=>'<div class="kpi '+s.state+'"><span class="kl"><span class="dot '+s.state+'"></span>'+esc(s.label)+' · '+s.port+'</span><span class="kv">'+(s.state==='up'?'ON':s.state==='listen'?(KO?'응답 없음':'NO HTTP'):'OFF')+(s.bootSec!=null&&s.state!=='down'?'<small>'+(KO?'기동 ':'boot ')+s.bootSec+'s</small>':'')+'</span><span class="ks">'+stWord(s.state)+' · '+hm(s.since)+(KO?' 부터':' since')+(s.owner?' · '+(s.owner==='vm'?(KO?'VM 이 띄움':'by VM'):(KO?'VM 밖에서 띄움':'external')):'')+'</span></div>').join('') : '<div class="kpi"><span class="kl">'+(KO?'서버':'Servers')+'</span><span class="kv">–</span><span class="ks">'+(KO?'측정 전':'Not measured yet')+'</span></div>';
}
function tbl(head, rows){ return rows.length ? '<table><tr>'+head.map(h=>'<th>'+h+'</th>').join('')+'</tr>'+rows.join('')+'</table>' : '<div class="empty">'+(KO?'없음':'None')+'</div>'; }
function paintBoard(d){
  $('bAt').textContent = hm(d.at);
  if(d.ai){ const c=$('cai'); c.textContent=(KO?'AI 검토 ':'AI review ')+(d.ai.on?(KO?'켬':'on'):(KO?'끔':'off'))+(d.ai.on?' · '+(d.ai.budget>0?(KO?'상한 ':'cap ')+d.ai.budget+' USD':(KO?'상한 없음':'no cap')):''); c.style.color=d.ai.on?'':'var(--warn)'; }
  if(d.mode) $('cmode').textContent=d.mode;
  const actor = a => '<span class="actor '+(a==='claude'?'claude':'')+'">'+(a==='claude'?'AI Agent':'Script')+'</span>';
  const win = w => w==null?'':(w===0?(KO?'VMO':'orch'):'VM#'+w);
  const rows=[];
  for(const j of d.jobs||[]) rows.push('<tr><td>'+'VMW'+'</td><td></td><td>'+esc(j.label)+'</td><td>'+j.done+'/'+j.total+(KO?' 완료 · 실행 ':' done · running ')+j.running+'</td><td></td><td class="n">'+sec(j.sec)+'</td></tr>');
  for(const c of d.chains||[]) rows.push('<tr><td>'+(KO?'체인':'Chain')+'</td><td>'+esc(c.screen)+'</td><td>'+esc(c.label)+'</td><td>'+(c.step?('['+c.step.no+'] '+esc(c.step.name)+' · '+sec(c.step.sec)):(KO?'단계 사이':'between steps'))+'</td><td>'+(c.step?actor(c.step.actor):'')+' '+win(c.wb)+'</td><td class="n">'+sec(c.sec)+'</td></tr>');
  for(const c of d.claudes||[]) rows.push('<tr><td>AI Agent</td><td>'+esc(c.screen)+'</td><td>'+esc(c.label||c.source)+'</td><td>PID '+(c.pid||'-')+'</td><td>'+actor('claude')+' '+win(c.wb)+'</td><td class="n">'+sec(c.sec)+'</td></tr>');
  for(const p of d.procs||[]) rows.push('<tr><td>'+(KO?'프로세스':'Process')+'</td><td>'+esc(p.screen)+'</td><td>'+esc(p.label)+'</td><td>PID '+(p.pid||'-')+' · '+esc(p.log)+'</td><td>'+actor('script')+' '+win(p.wb)+'</td><td class="n">'+sec(p.sec)+'</td></tr>');
  $('bRun').innerHTML = tbl(KO?['종류','화면','이름','현재','주체 · 창','경과']:['Kind','Screen','Name','Now','Actor · Window','Elapsed'], rows);
  const kindKo={admit:'부하 입장',lock:'화면 잠금',slot:'동시 상한',dbwin:'시험 데이터 구간',langwait:'언어 전환 대기',e2elock:'E2E 잠금'};
  $('bWait').innerHTML = tbl(KO?['종류','화면','사유','경과','최대']:['Kind','Screen','Why','Elapsed','Max'], (d.waits||[]).map(w=>'<tr><td>'+esc(KO?(kindKo[w.kind]||w.kind):w.kind)+'</td><td>'+esc(w.screen)+'</td><td>'+esc(w.why)+(w.blocker_pid?' · PID '+w.blocker_pid:'')+'</td><td class="n">'+sec(w.sec)+'</td><td class="n">'+(w.max_sec?sec(w.max_sec):'')+'</td></tr>'));
  $('bLock').innerHTML = tbl(KO?['파일','PID','주인','시작','인자','띄운 쪽']:['File','PID','Owner','Started','Args','Started by'], (d.locks||[]).map(l=>'<tr><td>'+esc(l.file)+'</td><td class="n">'+(l.pid||'')+'</td><td>'+(l.alive===null?'':(l.alive?(KO?'실행 중':'alive'):'<span style="color:var(--bad)">'+(KO?'프로세스 없음':'dead')+'</span>'))+'</td><td>'+esc(String(l.started).replace('T',' ').slice(0,19))+'</td><td>'+esc(l.args)+'</td><td title="'+esc(l.chain||'')+'">'+esc(l.parent?(l.parent+(l.ppid?' ('+l.ppid+')':'')):'')+'</td></tr>'));
  const L=d.load||{};
  const gz=(name,val,pct,mark,cls,sub)=>'<div class="gz '+cls+'"><div class="gh"><b>'+name+'</b><span class="gv">'+val+'</span><span class="gs">'+sub+'</span></div><div class="bar"><i style="width:'+Math.max(0,Math.min(100,pct))+'%"></i>'+(mark!=null?'<u style="left:'+mark+'%"></u>':'')+'</div></div>';
  const cpuC=L.cpu==null?'na':L.cpu>=80?'bad':L.cpu>=65?'warn':''; const memUsed=L.memTotalMB?Math.round(100*(1-L.memFreeMB/L.memTotalMB)):0; const memMark=L.memTotalMB?Math.round(100*(1-3072/L.memTotalMB)):null; const memC=L.memFreeMB==null?'na':L.memFreeMB<3072?'bad':L.memFreeMB<4608?'warn':'';
  const tcpC=L.tcp==null?'na':L.tcp>=14000?'bad':L.tcp>=12000?'warn':'';
  $('bLoad').innerHTML = gz('CPU',L.cpu==null?(KO?'미측정':'n/a'):L.cpu+'%',L.cpu||0,80,cpuC,KO?'입장 기준 < 80%':'admit < 80%')
    +gz(KO?'메모리':'Memory',L.memFreeMB!=null?(KO?'여유 ':'free ')+L.memFreeMB.toLocaleString()+' MB':'',memUsed,memMark,memC,(KO?'입장 기준 여유 ≥ 3,072 MB · 전체 ':'admit free ≥ 3,072 MB · total ')+(L.memTotalMB||0).toLocaleString()+' MB')
    +gz(KO?'TCP 연결 수':'TCP connections',L.tcp==null?(KO?'미측정':'n/a'):L.tcp.toLocaleString(),L.tcp==null?0:100*L.tcp/16000,75,tcpC,(KO?'경고 12,000 · E2E 중단 14,000':'warn 12,000 · abort 14,000')+(L.tcpAt?' · '+hm(L.tcpAt):''))
    +(function(){ const w=aiWk(L); return gz(KO?'AI 주간 한도':'AI weekly limit',w?w.pct+'%':(KO?'미측정':'n/a'),w?w.pct:0,80,w?w.cls:'na',w?esc(w.sub):(KO?'AI 실행 기록 없음':'no AI run log')); })();
  lastBoard=d; paintKpi();
}
let lastBoard=null;
function paintKpi(){ const d=lastBoard||{}; const run=(d.jobs||[]).length+(d.chains||[]).length+(d.claudes||[]).filter(c=>!(d.chains||[]).some(x=>x.wb===c.wb&&x.screen===c.screen)).length+(d.procs||[]).filter(p=>!(d.chains||[]).some(x=>x.wb===p.wb&&x.screen===p.screen)).length;
  const cl=(d.claudes||[]).length, wt=(d.waits||[]).length; const wmax=(d.waits||[]).reduce((a,w)=>Math.max(a,w.sec||0),0);
  const io=incs.filter(x=>x.status==='open'||x.status==='acting').length, iu=incs.filter(x=>x.status==='need-user').length, pp=props.filter(x=>x.status==='pending').length;
  const k=(cls,label,val,sub,tab)=>'<div class="kpi '+cls+'"'+(tab?' data-go="'+tab+'" style="cursor:pointer"':'')+'><span class="kl">'+label+'</span><span class="kv">'+val+'</span><span class="ks">'+sub+'</span></div>';
  $('bKpi').innerHTML = k(run?'on':'',KO?'실행 중':'Running',run,(d.chains||[]).length?(KO?'체인 ':'chains ')+(d.chains||[]).length+((d.jobs||[]).length?' · VMW '+(d.jobs||[]).length:''):(KO?'실행 중인 체인 없음':'no chains'))
    +k(cl?'on':'','AI Agent',cl,cl?(d.claudes||[]).map(c=>c.screen||(c.wb===0?'VMO':'')).filter(Boolean).join(', ')||(KO?'세션 실행 중':'sessions'):(KO?'실행 중인 세션 없음':'no sessions'))
    +k(wmax>600?'warn':'',KO?'대기':'Waiting',wt,wt?(KO?'가장 오래 ':'longest ')+sec(wmax):(KO?'대기 없음':'none'))
    +k(iu?'warn':io?'on':'',KO?'사건':'Incidents',io+iu,(KO?'열림 ':'open ')+io+(KO?' · 사용자 확인 ':' · need user ')+iu,'inc')
    +k(pp?'on':'',KO?'개선안':'Proposals',pp,KO?'승인 대기':'pending','prop');
  $('bKpi').querySelectorAll('[data-go]').forEach(e=>e.onclick=()=>show(e.dataset.go)); }
let tlHidden=false;
function tlShow(on){ if(on){ show('log'); showSub('task'); } }
function tlOut(){ markSub('task'); }
function note(text){ const b=$('bNote'); const e=b.querySelector('.empty'); if(e)e.remove(); const d=document.createElement('div'); d.textContent=hm(Date.now())+'  '+text; b.insertBefore(d,b.firstChild); while(b.childNodes.length>60)b.removeChild(b.lastChild); }
function paintMenu(groups){
  // 기능 타일: 라벨 맨 앞 그림 글자 = 아이콘 칸 · 나머지 = 이름 · 설명(hint) 첫 구절 = 둘째 줄
  const tile=it=>{ const s=String(it.show||''); const i=s.indexOf(' '); const head=i>0?s.slice(0,i):''; const isIcon=head&&!/[A-Za-z0-9가-힣]/.test(head); const name=isIcon?s.slice(i+1):s; const sub=String(it.hint||'').split(/ · | — |\\. /)[0].slice(0,60);
    return '<button class="tile" data-q="'+esc(it.label)+'" title="'+esc(it.hint||s)+'"><span class="ti">'+(isIcon?esc(head):'▸')+'</span><span class="tt"><b>'+esc(name)+'</b>'+(sub?'<span>'+esc(sub)+'</span>':'')+'</span></button>'; };
  $('menu').innerHTML = groups.map(g=>'<section class="cgrp glass"><h3>'+esc(g.title)+'<small>'+g.items.length+(KO?'개':'')+'</small></h3><div class="tiles">'+g.items.map(tile).join('')+'</div></section>').join('') || '<div class="empty">'+(KO?'기능 없음(quick.json area common)':'No common items')+'</div>';
  $('menu').querySelectorAll('button[data-q]').forEach(b=>b.onclick=()=>vscode.postMessage({type:'orch:quick',label:b.dataset.q}));
}
let incs=[]; const stKo={open:'열림',acting:'조치 중',resolved:'해결',closed:'닫음','need-user':'사용자 확인 필요'};
let incSel=new Set(), incArm=0;
function incBulk(rows){
  const b=$('incCloseAll'); const can=rows.filter(function(x){return x.status==='open'||x.status==='need-user';});
  Array.from(incSel).forEach(function(id){ if(!can.some(function(x){return x.id===id;})) incSel.delete(id); });
