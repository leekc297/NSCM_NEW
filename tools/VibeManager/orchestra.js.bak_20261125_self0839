:root{--acc:color-mix(in srgb,var(--vscode-charts-blue,#3794ff) 58%,#8b93a7);--acc2:color-mix(in srgb,var(--vscode-charts-purple,#a371f7) 55%,#8b93a7);--acc3:color-mix(in srgb,var(--vscode-charts-green,#3fb9a8) 50%,#8b93a7);
