  <div class="a-grid">
    <div class="a-col">
      <section class="panel glass"><h2>${T('지금 실행 중', 'Running now')}<small id="bRunN"></small><span class="a-sp"></span><small id="bAt"></small></h2><div class="a-body" id="bRun"></div></section>
