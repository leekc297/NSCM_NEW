    require('./orch-improve').IMPACT_RULE,
    '```json',
    '{ "summary": "3문장 이내", "purposes": [ { "purpose": "", "source": "근거 문서", "verdict": "맞음|어긋남|미확인", "evidence": "수치와 출처" } ], "proposals": [ { "title": "", "impact": "core|fix", "level": "L1|L2|L3|L4", "levelWhy": "", "evidence": "수치와 출처 파일", "targets": ["바꿀 파일 경로"], "before_after": "변경 전 → 변경 후", "verify": "반영 뒤 검증 명령과 기대 결과", "rollback": "되돌리는 방법", "sig": "같은 안을 가릴 짧은 서명", "plain": { "what": "", "risk": "", "undo": "" } } ] }',
