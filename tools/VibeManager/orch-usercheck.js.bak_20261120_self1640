// 2026-11-20 사용자 지적 점검(자가진단 S13) — 사용자 지시: "제가 VM 을 보완하기 위해서 입력한 프롬프트와 같이 상황을 보고 입력한 내용에 대해서는
//   모니터링을 통해서 자가진단하고 보완이 이루어 지도록 되어야 합니다"
//   ① 원장 user_checks.json: 지적 원문(U1~) + 감지기 이름 + 기준값. 감지기는 이 파일의 DETECTORS(코드, Claude 없음)
//   ② check(): 자가진단 가벼운 주기(selfLightMin)에 S13 으로 실행. fail = R12 사건 → Claude 진단 → 개선안 → 자동 반영(VM 코드, 게이트 통과 조건). warn = 표시만
//   ③ learn(): 사람이 입력한 프롬프트(세션 기록 entrypoint ≠ sdk-cli, 작업 중 끼운 메시지 queued_command origin human)를 원장 coveredUntil 뒤로만 읽어
//      Claude(읽기 전용)가 분류. 기존 감지기로 잡히는 지적 = 원장에 인용 추가 · 새 감지기가 필요한 지적 = 개선안(source self, check S13) · 지적 아님 = 제외 기록
//   기록: .vibe/orch/usercheck/state.json(감지기 상태) · ui.json(VMO 화면 표시 보고) · learn.json(학습 결과, 제외 사유)
'use strict';
const fs = require('fs');
const path = require('path');
const os = require('os');
let errlog = { note() { return null; } }; try { errlog = require('./orch-errlog'); } catch { /* 오류 기록 모듈 없음 */ }
let orchEv = null; try { orchEv = require('./orch-events'); } catch { orchEv = null; }

let getPaths = null; let opts = {}; let learning = null;
const P = () => getPaths();
const vmDir = () => opts.vmDir || path.join(P().root, 'tools', 'VibeManager');
const ucDir = () => path.join(P().vibeDir, 'orch', 'usercheck');
const ledgerFile = () => path.join(vmDir(), 'user_checks.json');
const readJson = (f, d) => { try { return JSON.parse(fs.readFileSync(f, 'utf8').replace(/^﻿/, '')); } catch { return d; } };
const writeJson = (f, v) => { try { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f + '.t', JSON.stringify(v, null, 1), 'utf8'); fs.renameSync(f + '.t', f); return true; } catch (e) { errlog.note('orch-usercheck', 'writeJson', e); return false; } };
const lsDir = d => { try { return fs.readdirSync(d, { withFileTypes: true }); } catch { return []; } };
const nowLocal = ms => (orchEv ? orchEv.nowLocal(ms) : new Date(ms || Date.now()).toISOString());
const hm = ms => nowLocal(ms).slice(5, 16).replace('T', ' ');
const mod = n => { if (opts.mods && opts.mods[n]) return opts.mods[n]; try { return require(`./${n}`); } catch (e) { errlog.note('orch-usercheck', `require ${n}`, e); return null; } };
function cfg() { const h = readJson(path.join(P().root, 'tools', 'Harness', 'harness.json'), {}); return Object.assign({ userCheckEnabled: true, userLearnGapMin: 60, checklistTargetMin: 30, selfLightMin: 10, selfDiagGapMin: 60, reviewEveryHours: 24 }, (h && h.orch) || {}); }
const ledger = () => readJson(ledgerFile(), { items: [] });
const incidents = () => { const w = mod('orch-watch'); try { return w ? w.list(400) : []; } catch { return []; } };
const proposals = () => { const i = mod('orch-improve'); try { return i ? i.list() : []; } catch { return []; } };
const events = () => (opts.events ? opts.events() : (orchEv ? orchEv.tail(6 * 1024 * 1024) : []));
const DAY = 86400000;
const done = s => s === 'resolved' || s === 'closed';
const isCL = e => /^checklist/i.test(e.chain || '') || /CheckList/i.test(e.chainLabel || e.label || '');

// ── 감지기(코드) ── 각 함수는 (항목 u, 문맥 x) → [{ level, what, detail, key }]
const DETECTORS = {
  // U1 업무 작업 카드 표시가 진행을 따라가지 않음: 스크립트 단계 화면의 로그는 늘었는데 단계, 세부 진행 글이 staleMin 넘게 그대로
  progressShown(u, x) {
    const out = []; const staleMs = (u.params.staleMin || 20) * 60000; const st = x.state.progress = x.state.progress || {}; const seen = new Set();
    for (const e of lsDir(path.join(P().vibeDir, 'jobs'))) {
      if (!e.isDirectory()) continue; const jf = path.join(P().vibeDir, 'jobs', e.name, 'job.json'); let m = 0; try { m = fs.statSync(jf).mtimeMs; } catch { continue; }
      if (x.now - m > DAY) continue; const j = readJson(jf, null); if (!j || j.status !== 'running') continue;
      for (const s of j.screens || []) {
        if (s.status !== 'run' || s.actor !== 'script') continue; const k = `${j.id}:${s.id}`; seen.add(k);
        let size = 0; try { size = fs.statSync(path.join(P().vibeDir, 'jobs', j.id, `${s.id}.log`)).size; } catch { continue; }
        const sig = `${s.step || ''}|${s.prog || ''}`; const prev = st[k];
        if (!prev || prev.sig !== sig) { st[k] = { sig, since: x.now, size }; continue; }
        if (x.now - prev.since > staleMs && size > prev.size) out.push({ level: 'fail', what: `VMW 표시 멈춤 ${s.id}`, detail: `${j.id} ${s.id} 카드 '${s.step || '-'} · ${s.prog || '세부 없음'}' 이 ${Math.round((x.now - prev.since) / 60000)}분째 같음. 같은 동안 로그 ${Math.round((size - prev.size) / 1024)}KB 늘어남(job-runner parseProg 가 이 단계 로그 형식을 읽지 못함)`, key: `S13|U1|${j.id}|${s.id}|${prev.sig}` });
      }
    }
    for (const k of Object.keys(st)) if (!seen.has(k)) delete st[k];
    return out;
  },
  // U2 CheckList 화면 1개 소요가 목표를 넘음(표시만 · 속도 개선은 정합성이 같은 방법만이라 큰 그림 점검과 사용자 승인으로)
  chainTarget(u, x) {
    const out = []; const tgt = (u.params.targetMin || x.cfg.checklistTargetMin) * 60000; const byScr = {};
    for (const e of x.events) if (e.type === 'chain.end' && isCL(e) && e.ms_run > tgt && x.now - (e.ms || 0) < DAY) byScr[e.screen] = e;
    for (const [scr, e] of Object.entries(byScr)) {
      const tm = readJson(path.join(P().root, 'Doc', 'verify', scr, 'run_timing.json'), []); const last = Array.isArray(tm) && tm.length ? tm[tm.length - 1] : null;
      const top = last && Array.isArray(last.top) ? last.top.slice(0, 3).map(t => `${t.stage} ${t.tool} ${t.min}분`).join(', ') : '구간 소요표 없음';
      out.push({ level: u.level || 'warn', what: `CheckList ${scr} ${Math.round(e.ms_run / 60000)}분(목표 ${Math.round(tgt / 60000)}분)`, detail: `${hm(e.ms)} 끝 · ${e.chainLabel || ''} · 오래 걸린 구간(Doc/verify/${scr}/run_timing.json ${last ? last.run_at : ''}): ${top}`, key: `S13|U2|${scr}` });
    }
    return out;
  },
  // U3 U5 U7 VMO 진단·반영 공백
  vmoCadence(u, x) {
    const out = []; const gap = (x.cfg.selfDiagGapMin || 60) * 2 * 60000;
    const idle = x.incidents.filter(i => i.status === 'open' && !i.notice && !(i.actions || []).length && x.now - (i.ms || 0) > gap);
    if (idle.length) out.push({ level: 'fail', what: `조치 기록 없는 열린 사건 ${idle.length}건`, detail: idle.slice(0, 8).map(i => `${i.id} ${i.rule} ${String(i.title).slice(0, 60)} (${Math.round((x.now - i.ms) / 60000)}분)`).join(' / '), key: 'S13|U3|idleInc' });
    const sc = mod('orch-selfcheck'); const elig = p => { try { return sc && sc.autoEligible ? sc.autoEligible(p) : { ok: false }; } catch { return { ok: false }; } };
    const pend = x.proposals.filter(p => p.status === 'pending' && x.now - (p.ms || 0) > (x.cfg.selfLightMin || 10) * 6 * 60000).filter(p => { const e = elig(p); return e.ok && e.kind === 'code'; });
    const stuck = pend.filter(p => !p.waitNote || x.now - (p.ms || 0) > 6 * 3600000);
    if (stuck.length) out.push({ level: 'fail', what: `자동 반영 대상인데 반영 안 된 개선안 ${stuck.length}건`, detail: stuck.slice(0, 8).map(p => `${p.id} ${String(p.title).slice(0, 60)} (${Math.round((x.now - p.ms) / 60000)}분${p.waitNote ? ` · ${p.waitNote}` : ''})`).join(' / '), key: 'S13|U3|stuckProp' });
    const imp = mod('orch-improve'); let rm = null; try { rm = imp && imp.meta ? imp.meta() : null; } catch { rm = null; }
    if (rm && rm.enabled && rm.lastMs && x.now - rm.lastMs > (x.cfg.reviewEveryHours || 24) * 2 * 3600000) out.push({ level: 'fail', what: '상시 분석 멈춤', detail: `마지막 상시 분석 ${hm(rm.lastMs)} · 주기 ${x.cfg.reviewEveryHours}시간의 2배 넘음`, key: 'S13|U3|review' });
    return out;
  },
  // U4 화면 진입 실패(R13) 미해결, 복구 뒤 재발
  openFail(u, x) {
    const out = []; const lim = (u.params.openMin || 30) * 60000; const r13 = x.incidents.filter(i => i.rule === 'R13' && !i.notice && x.now - (i.ms || 0) < DAY);
    for (const i of r13) if (!done(i.status) && x.now - (i.ms || 0) > lim) out.push({ level: 'fail', what: `화면 진입 실패 미해결 ${i.screen}`, detail: `${i.id} ${Math.round((x.now - i.ms) / 60000)}분째 ${i.status} · ${String(i.title).slice(0, 100)}`, key: `S13|U4|open|${i.id}` });
    const by = {}; for (const i of r13) (by[i.screen] = by[i.screen] || []).push(i);
    for (const [scr, arr] of Object.entries(by)) { arr.sort((a, b) => a.ms - b.ms); const k = arr.findIndex(i => done(i.status)); if (k >= 0 && arr.slice(k + 1).length) out.push({ level: 'fail', what: `화면 진입 실패 복구 뒤 재발 ${scr}`, detail: arr.map(i => `${i.id} ${i.status}`).join(' / '), key: `S13|U4|again|${scr}` }); }
    return out;
  },
  // U6 중지 뒤 거짓 실패 사건
  falseIncident(u, x) {
    const out = []; const win = (u.params.withinSec || 120) * 1000; const stops = x.events.filter(e => e.type === 'user.stop' && e.screen && x.now - (e.ms || 0) < DAY);
    for (const i of x.incidents) {
      if (!/^(R1|R2|R5|R11)$/.test(i.rule) || i.notice || i.reload || x.now - (i.ms || 0) > DAY || String(i.sig || '').startsWith('R2|R9')) continue;
      const s = stops.find(e => String(e.screen).toUpperCase() === String(i.screen || '').toUpperCase() && i.ms >= e.ms && i.ms - e.ms <= win);
      if (s) out.push({ level: 'fail', what: `중지 뒤 실패 사건 ${i.rule} ${i.screen}`, detail: `${i.id} 생성 ${hm(i.ms)} · 중지 ${hm(s.ms)}(${s.by || '사용자'}) 뒤 ${Math.round((i.ms - s.ms) / 1000)}초 · ${String(i.title).slice(0, 80)}`, key: `S13|U6|${i.id}` });
    }
    return out;
  },
  // U8 VMO 화면이 받은 목록과 원본 최신 활동 어긋남(웹뷰 보고 = noteUi)
  uiShown(u, x) {
    const ui = readJson(path.join(ucDir(), 'ui.json'), { miss: [] }); const gapMs = (u.params.gapMin || 10) * 60000;
    return (ui.miss || []).filter(m => x.now - m.ms < DAY && m.gapMs > gapMs).slice(-5).map(m => ({ level: 'fail', what: `VMO ${m.tab} 화면 표시 누락`, detail: `${hm(m.ms)} 화면이 받은 최신 활동 ${m.shownAt || '없음'} · 원본 최신 ${m.srcAt} (${m.srcId}) · 받은 ${m.received}건 / 원본 ${m.total}건`, key: `S13|U8|${m.tab}` }));
  },
  // U9 중지 뒤 계속 실행(R14) · 업무 작업 기록과 실제 불일치
  stopLeak(u, x) {
    const out = [];
    for (const i of x.incidents) if (i.rule === 'R14' && !done(i.status) && x.now - (i.ms || 0) < DAY) out.push({ level: 'fail', what: `중지 뒤 계속 실행 미해결 ${i.screen}`, detail: `${i.id} ${i.status} · ${String(i.title).slice(0, 100)}`, key: `S13|U9|${i.id}` });
    const live = new Set((x.snap.chains || []).map(c => c.job).filter(Boolean));
    for (const e of lsDir(path.join(P().vibeDir, 'jobs'))) {
      if (!e.isDirectory()) continue; const jf = path.join(P().vibeDir, 'jobs', e.name, 'job.json'); let m = 0; try { m = fs.statSync(jf).mtimeMs; } catch { continue; }
      if (x.now - m > DAY || x.now - m < 120000) continue; const j = readJson(jf, null); if (!j || !/^(stopped|done|interrupted)$/.test(j.status)) continue;
      const run = (j.screens || []).filter(s => s.status === 'run'); if (!run.length) continue;
      if (live.has(j.id)) continue; // 살아 있는 체인 = R14 가 맡음
      out.push({ level: 'fail', what: `VMW 기록 불일치 ${j.id}`, detail: `작업 상태 ${j.status}(${j.note || ''})인데 화면 ${run.map(s => s.id).join(', ')} 이 '실행 중'으로 남음. 실행 중 체인 없음`, key: `S13|U9|rec|${j.id}` });
    }
    return out;
  },
  // U10 Claude 를 쓰지 않은 CheckList 체인
  claudeUsed(u, x) {
    const out = [];
    for (const i of x.incidents) if (i.rule === 'R11' && i.status === 'open' && !(i.actions || []).length && x.now - (i.ms || 0) > 3600000 && x.now - (i.ms || 0) < DAY) out.push({ level: 'fail', what: `Claude 없이 끝난 체인 사건 미조치 ${i.screen}`, detail: `${i.id} ${String(i.title).slice(0, 100)}`, key: `S13|U10|${i.id}` });
    // 중지(사용자, VMO, 창 종료)로 끝난 체인은 뺀다(실측 11-20: 11건 중 중지·중단 체인이 섞임). 체인 시작~끝 사이 같은 창 user.stop 또는 aborted
    // 개선안 20261120131344_SELF: 끝 기록의 중지 표시(stopped)를 먼저 본다. 없는 옛 기록은 같은 업무 작업·화면의 job.item.end cancel(chain.end 뒤 2초 안), 종전 user.stop 창으로 본다
    const up = v => String(v || '').toUpperCase();
    const itemCancel = e => x.events.some(s => s.type === 'job.item.end' && s.status === 'cancel' && up(s.screen) === up(e.screen) && (!e.job || !s.job || s.job === e.job) && (s.ms || 0) >= (e.ms || 0) && (s.ms || 0) <= (e.ms || 0) + 2000);
    const stopped = e => e.stopped === true || e.aborted || itemCancel(e) || x.events.some(s => s.type === 'user.stop' && s.wb === e.wb && s.ms >= (e.ms - (e.ms_run || 0)) && s.ms <= e.ms + 1000);
    const failText = e => { const rows = e.rows || []; const f = rows.find(r => e.failNo != null && r.no === e.failNo) || rows.find(r => r.status === 'FAIL' || r.status === 'CANCEL'); const no = e.failNo != null ? e.failNo : (f ? f.no : '?'); return `${no}단계 ${(f && f.task) || '-'} ${(f && f.status) || 'FAIL'} 로 Claude 단계 ${e.claudeSkipped}개 미실행`; };
    for (const e of x.events) if (e.type === 'chain.end' && isCL(e) && e.ok === false && e.claudeRan === 0 && e.claudeSkipped > 0 && x.now - (e.ms || 0) < DAY && !stopped(e)) out.push({ level: 'warn', what: `Claude 단계 건너뛰고 끝난 CheckList ${e.screen}`, detail: `${hm(e.ms)} · ${failText(e)}`, key: `S13|U10|${e.screen}|${e.ms}` });
    return out;
  },
  // U11 반영 실패 개선안 방치
  repairRetry(u, x) {
    const lim = (u.params.hours || 6) * 3600000; const out = [];
    for (const p of x.proposals) {
      if (p.status !== 'apply-failed') continue; const fails = (p.history || []).filter(h => /^반영 실패/.test(String(h.what || ''))); const last = fails.length ? Date.parse(String(fails[fails.length - 1].at).replace(' ', 'T')) : (p.ms || 0);
      if (!Number.isFinite(last) || x.now - last < lim) continue; const ra = p.repair && p.repair.at ? Date.parse(String(p.repair.at).replace(' ', 'T')) : 0;
      if (ra && ra > last) continue;
      out.push({ level: 'fail', what: `반영 실패 개선안 ${Math.round((x.now - last) / 3600000)}시간 방치`, detail: `${p.id} ${String(p.title).slice(0, 80)} · 재진단 ${p.repair ? `${p.repair.decision || ''} ${p.repair.at || ''}` : '없음'}`, key: `S13|U11|${p.id}` });
    }
    return out;
  },
  // U13 창 다시 로드 뒤 VMW 작업 재개 누락: 중단(interrupted) 작업에 다시 실행할 화면(wait, run)이 남았는데
  //   재개 표시(chain_progress 끊긴 기록, job.json resumable, 화면 resume)가 없거나 waitMin 넘게 같은 작업의 job.start, chain.start 가 없음.
  //   R5 reloadcut 알림 사건의 끊긴 실행(evidence.runs) 뒤 같은 화면 chain.start 가 waitMin 넘게 없어도 같은 판정
  reloadResumeMissing(u, x) {
    const out = []; const waitMs = (u.params.waitMin || 30) * 60000; const settleMs = 120000;
    const prog = []; const pd = path.join(P().vibeDir, 'orch', 'chain_progress');
    for (const e of lsDir(pd)) { if (!e.isFile() || !e.name.endsWith('.json')) continue; const r = readJson(path.join(pd, e.name), null); if (r && r.runId && x.now - (r.updatedMs || 0) <= DAY && r.interruptedAt) prog.push(r); }
    const startedAfter = (pred, ms) => x.events.some(e => (e.type === 'job.start' || e.type === 'chain.start') && (e.ms || 0) > ms && pred(e));
    for (const e of lsDir(path.join(P().vibeDir, 'jobs'))) {
      if (!e.isDirectory()) continue; const jf = path.join(P().vibeDir, 'jobs', e.name, 'job.json'); let m = 0; try { m = fs.statSync(jf).mtimeMs; } catch { continue; }
      if (x.now - m > DAY) continue; const j = readJson(jf, null); if (!j || j.status !== 'interrupted') continue;
      const left = (j.screens || []).filter(s => s.status === 'wait' || s.status === 'run'); if (!left.length) continue;
      const stops = x.events.filter(v => v.type === 'user.stop' && v.job === j.id && (v.ms || 0) <= m + 1000).map(v => v.ms || 0);
      const cutMs = stops.length ? Math.max(...stops) : m; if (x.now - cutMs < settleMs) continue;
      if (startedAfter(v => v.job === j.id, cutMs)) continue; // 이미 다시 실행함
      const marked = new Set(prog.filter(r => r.job === j.id).map(r => String(r.screen || '').toUpperCase()));
      for (const s of left) if (s.resume) marked.add(String(s.id).toUpperCase());
      const noMark = left.filter(s => !marked.has(String(s.id).toUpperCase()) && !j.resumable);
      const ids = left.map(s => s.id).join(', ');
      if (noMark.length) out.push({ level: 'fail', what: `VMW 재개 표시 없음 ${j.id}`, detail: `작업 중단 ${hm(cutMs)}(${j.note || ''}) · 남은 화면 ${ids} 중 ${noMark.map(s => s.id).join(', ')} 에 재개 기록 없음(.vibe/orch/chain_progress 끊긴 기록, job.json resumable 없음). 작업 재개 단추를 쓸 수 없음`, key: `S13|U13|mark|${j.id}` });
      else if (x.now - cutMs > waitMs) out.push({ level: 'fail', what: `VMW 중단 뒤 재개 안 됨 ${j.id}`, detail: `작업 중단 ${hm(cutMs)}(${j.note || ''}) 뒤 ${Math.round((x.now - cutMs) / 60000)}분째 job.start, chain.start 없음 · 남은 화면 ${ids}`, key: `S13|U13|wait|${j.id}` });
    }
    for (const i of x.incidents) {
      if (i.rule !== 'R5' || !String(i.sig || '').startsWith('R5|reloadcut|') || x.now - (i.ms || 0) > DAY || x.now - (i.ms || 0) <= waitMs) continue;
      const runs = ((i.evidence || {}).runs || []).filter(r => r && r.screen);
