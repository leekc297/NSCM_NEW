function say(text, o) { feed.unshift(Object.assign({ at: new Date().toISOString(), text }, o || {})); if (feed.length > 100) feed.length = 100; try { require('./orch-events').emit('heal', Object.assign({ text }, o || {})); } catch { /* 사건 기록 실패는 무시 */ } }
