//   ③ 해결: python tools/CommonSync/screen_sync.py <ID> --deps-only(로컬에 없는 공용 파일만 공통 원문으로 받음 · 있는 파일은 건드리지 않음)
//   ④ 확인: 화면 파일을 FE 개발 서버에 다시 변환 요청해 오류 0
//   ⑤ 다시 기동: 그 화면 실행을 멈추고 같은 업무 작업에서 다시 실행(job-runner.requeueScreen · 같은 작업에서 2번까지)
//   ⑥ 사건 해결 처리 · 알림. ②의 분류가 아니거나 ③④가 실패하면 에이전트(Claude) 조치로 넘김
const path = require('path'); const cp = require('child_process');
