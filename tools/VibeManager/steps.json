{
  "$schema": "Vibe_Manager steps — 변수: ${root} ${toolsDir} ${harnessDir} ${tobeDir} ${outDir} ${tobeOutDir} ${gapDir} ${genDir} ${agentDriver} ${agentModel} ${input:이름}",
  "steps": [
    {
      "id": "S1",
      "title": "1. AS-IS 분석 (C# 파서)",
      "detail": "Roslyn·ScriptDom·MSSQL → Fact Pack. 교차검증 불일치 0 이 완료 기준.",
      "tasks": [
        {
          "id": "S1.run",
          "title": "파서 전체 실행 (빌드→함정테스트→scan→교차검증→pack)",
          "kind": "powershell",
          "script": "${toolsDir}/run.ps1",
          "confirm": "전체 스캔은 수 분 걸립니다. 실행할까요?",
          "gate": {
            "type": "csvRows",
            "file": "${outDir}/crosscheck_report.csv",
            "max": 0,
            "label": "교차검증 불일치"
          }
        },
        {
          "id": "S1.db",
          "title": "DB 메타 추출 (읽기 전용)",
          "kind": "powershell",
          "script": "${toolsDir}/db.ps1",
          "confirm": "MSSQL 에 접속해 메타를 추출합니다(읽기 전용). 실행할까요?",
          "gate": {
            "type": "csvRows",
            "file": "${outDir}/db/db_objects.csv",
            "min": 1,
            "label": "DB 객체"
          }
        },
        {
          "id": "S1.grid",
          "title": "Grid SP 실행(ROLLBACK) → 실제 컬럼",
          "kind": "powershell",
          "script": "${toolsDir}/grid.ps1",
          "confirm": "쓰기 없는 *_SPREAD_TITLE SP 만 트랜잭션 안에서 실행 후 ROLLBACK 합니다. 실행할까요?",
          "gate": {
            "type": "csvAll",
            "file": "${outDir}/db/grid/grid_runs.csv",
            "column": "status",
            "equals": "OK",
            "label": "SP 실행"
          }
        },
        {
          "id": "S1.pack",
          "title": "화면 Pack 재생성",
          "kind": "powershell",
          "script": "${toolsDir}/pack.ps1",
          "gate": {
            "type": "csvRows",
            "file": "${outDir}/screens/_index.csv",
            "min": 1,
            "label": "화면"
          }
        },
        {
          "id": "S1.screen",
          "title": "화면 Fact Pack 열기 — 화면ID",
          "kind": "open",
          "path": "${outDir}/screens/${input:id}",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S1.review",
          "title": "검수 체크포인트 열기",
          "kind": "open",
          "path": "${outDir}/_review"
        },
        {
          "id": "S1.recon",
          "title": "개발대상 대사표 — 누락 재확인 (xlsx→csv → recon.js)",
          "kind": "node",
          "script": "${reconDir}/recon.js",
          "args": [],
          "gate": {
            "type": "fileExists",
            "file": "${reconOutDir}/대사표.md",
            "label": "대사표"
          }
        },
        {
          "id": "S1.reconx",
          "title": "개발대상 xlsx → CSV/map_screen.csv (xlsx_to_csv.py)",
          "kind": "python",
          "script": "${reconDir}/xlsx_to_csv.py",
          "args": []
        },
        {
          "id": "S1.recondash",
          "title": "대사표 대시보드 열기 (Doc/recon/index.html)",
          "kind": "browser",
          "path": "${reconOutDir}/index.html"
        }
      ]
    },
    {
      "id": "S2",
      "title": "2. TO-BE 분석 · RULE",
      "detail": "TobeFacts(FE+BE) 로 같은 스키마의 Fact 를 뽑고, 룰은 CSV 사전으로 관리.",
      "tasks": [
        {
          "id": "S2.probe",
          "title": "DB 접속 점검 (asis MSSQL / tobe Oracle) — probe.py",
          "kind": "python",
          "script": "${dbconnDir}/probe.py",
          "args": []
        },
        {
          "id": "S2.export",
          "title": "To-Be Oracle 메타 export → Doc/tobefacts/db (export_tobe_meta.py)",
          "kind": "python",
          "script": "${dbconnDir}/export_tobe_meta.py",
          "args": [],
          "gate": {
            "type": "fileExists",
            "file": "${tobeOutDir}/db/proc_meta.csv",
            "label": "proc_meta.csv"
          }
        },
        {
          "id": "S2.run",
          "title": "To-Be 파서 실행 (추출→교차검증→Pack)",
          "kind": "powershell",
          "script": "${root}/tools/TobeFacts/run.ps1",
          "gate": {
            "type": "csvRows",
            "file": "${tobeOutDir}/crosscheck_report.csv",
            "max": 0,
            "label": "교차검증 불일치"
          }
        },
        {
          "id": "S2.rules",
          "title": "룰 사전 열기 (rules/)",
          "kind": "open",
          "path": "${harnessDir}/rules"
        },
        {
          "id": "S2.mine",
          "title": "사전 채굴 (짝 화면 → *.mined.csv)",
          "kind": "node",
          "script": "${harnessDir}/mine.js",
          "args": [
            "--tobe",
            "${tobeOutDir}",
            "--asis",
            "${outDir}",
            "--out",
            "${harnessDir}/rules"
          ]
        },
        {
          "id": "S2.dbmeta",
          "title": "클라우드 메타 CSV 폴더 열기 (Doc/tobefacts/db)",
          "kind": "open",
          "path": "${tobeOutDir}/db"
        },
        {
          "id": "S2.dbconn",
          "title": "DB 접속정보 열기 (dbconn.json — 비밀번호는 .env.asis)",
          "kind": "open",
          "path": "${dbconnDir}/dbconn.json"
        },
        {
          "id": "S2.examples",
          "title": "하우스 스타일 예제 채굴 (mine-examples.js → prompts/examples)",
          "kind": "node",
          "script": "${harnessDir}/mine-examples.js",
          "args": []
        },
        {
          "id": "S2.framework",
          "title": "To-Be 프레임워크·공통 카탈로그 생성 (framework.js → Doc/tobefacts/framework, rules/tobe_catalog.csv)",
          "kind": "node",
          "script": "${root}/tools/TobeFacts/framework.js",
          "args": []
        },
        {
          "id": "S2.frameworkopen",
          "title": "카탈로그 열기 (Doc/tobefacts/framework/INDEX.md)",
          "kind": "open",
          "path": "${tobeOutDir}/framework/INDEX.md"
        }
      ]
    },
    {
      "id": "S3",
      "title": "3. 문서 초안 생성 (Agent)",
      "detail": "Fact Pack → 분석서 5종 + 업무분석서·화면설계서·단위테스트. 게이트 total PASS.",
      "tasks": [
        {
          "id": "S3.agent",
          "title": "Agent 실행 — 화면ID",
          "kind": "powershell",
          "script": "${toolsDir}/agent.ps1",
          "splitArgs": true,
          "args": [
            "${input:ids}",
            "-Driver",
            "${agentDriver}",
            "-Model",
            "${agentModel}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (공백으로 여러 개)",
              "default": "DMF0052"
            }
          ],
          "gate": {
            "type": "agentGates",
            "file": "${outDir}/agent",
            "label": "Agent 게이트"
          }
        },
        {
          "id": "S3.docs",
          "title": "문서 3종만 재생성 — 화면ID (-Phase docs)",
          "kind": "powershell",
          "script": "${toolsDir}/agent.ps1",
          "splitArgs": true,
          "args": [
            "${input:ids}",
            "-Phase",
            "docs",
            "-Driver",
            "${agentDriver}",
            "-Model",
            "${agentModel}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S3.batch",
          "title": "Agent 전 화면 배치 (도메인 선택)",
          "kind": "agentBatch",
          "script": "${toolsDir}/agent.ps1"
        },
        {
          "id": "S3.report",
          "title": "Agent 게이트 집계 리포트",
          "kind": "gateReport"
        },
        {
          "id": "S3.open",
          "title": "Agent 결과 열기 — 화면ID",
          "kind": "open",
          "path": "${outDir}/agent/${input:id}",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        }
      ]
    },
    {
      "id": "S4",
      "title": "4. GAP 분석",
      "detail": "As-is Fact ↔ To-Be Fact 대사. COVERED/INTENDED/MISSING/UNMAPPED + 대시보드.",
      "tasks": [
        {
          "id": "S4.run",
          "title": "GAP 전 화면 실행 → Doc/gap",
          "kind": "node",
          "script": "${harnessDir}/gap.js",
          "gate": {
            "type": "csvRows",
            "file": "${gapDir}/_summary.csv",
            "min": 1,
            "label": "GAP 요약"
          }
        },
        {
          "id": "S4.one",
          "title": "GAP 실행 — 화면ID",
          "kind": "node",
          "script": "${harnessDir}/gap.js",
          "splitArgs": true,
          "args": [
            "${input:ids}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (공백으로 여러 개)",
              "default": "DMF0045"
            }
          ]
        },
        {
          "id": "S4.dash",
          "title": "GAP 대시보드 열기 (index.html)",
          "kind": "browser",
          "path": "${gapDir}/index.html"
        },
        {
          "id": "S4.open",
          "title": "GAP 결과 CSV — 화면ID",
          "kind": "open",
          "path": "${gapDir}/${input:id}_gap.csv",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0045"
            }
          ]
        },
        {
          "id": "S4.goldgen",
          "title": "골든 케이스 생성 (As-is SP ↔ To-Be PROC 짝) — gen_golden_cases.py",
          "kind": "python",
          "script": "${dbconnDir}/gen_golden_cases.py",
          "splitArgs": true,
          "args": [
            "${input:ids}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (비우면 전체)",
              "default": ""
            }
          ]
        },
        {
          "id": "S4.golden",
          "title": "골든 테스트 실행 (양쪽 SP 결과 대조) — golden.py",
          "kind": "python",
          "script": "${dbconnDir}/golden.py",
          "splitArgs": true,
          "args": [
            "${input:ids}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (비우면 전체 GET)",
              "default": "DMF0003"
            }
          ],
          "gate": {
            "type": "fileExists",
            "file": "${goldenDir}/_summary.md",
            "label": "골든 요약"
          }
        },
        {
          "id": "S4.goldopen",
          "title": "골든 결과 열기 (Doc/golden/_summary.md)",
          "kind": "open",
          "path": "${goldenDir}/_summary.md"
        }
      ]
    },
    {
      "id": "S5",
      "title": "5. 신규 UI 개발 (하네스)",
      "detail": "프로그램 ID 하나로: 골격 생성 → nscm-fe 적용 → 게이트 → Claude Code 가 TODO 만 채움.",
      "tasks": [
        {
          "id": "S5.pipeline",
          "title": "★ ID 하나로 끝까지 — 화면ID (pipeline.js: 골격→등록SQL→PKG→FE수선→PKG이식→E2E스펙→대사표)",
          "kind": "node",
          "script": "${harnessDir}/pipeline.js",
          "args": [
            "${input:id}",
            "--max",
            "3"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "confirm": "Claude Code 를 FE/PKG 각 최대 3회 호출합니다(수십 분). 진행할까요?",
          "gate": {
            "type": "fileExists",
            "file": "${genDir}/${input:id}/PIPELINE.md",
            "label": "PIPELINE.md"
          }
        },
        {
          "id": "S5.pipelinedry",
          "title": "파이프라인 드라이런 — 화면ID (--no-claude: 생성+게이트만)",
          "kind": "node",
          "script": "${harnessDir}/pipeline.js",
          "args": [
            "${input:id}",
            "--no-claude"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S5.pipelineregen",
          "title": "파이프라인 — PKG 골격 강제 재생성(--regen-pkg, 이식 결과 폐기)",
          "kind": "node",
          "script": "${harnessDir}/pipeline.js",
          "args": [
            "${input:id}",
            "--max",
            "3",
            "--regen-pkg"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "confirm": "Claude 가 이식한 <ID>_PKG.sql 을 버리고 골격부터 다시 만듭니다. 진행할까요?"
        },
        {
          "id": "S5.new",
          "title": "신규 화면 생성 — 화면ID (new-screen.ps1)",
          "kind": "powershell",
          "script": "${harnessDir}/new-screen.ps1",
          "splitArgs": true,
          "args": [
            "${input:id}"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "gate": {
            "type": "fileExists",
            "file": "${genDir}/${input:id}/GEN_NOTES.md",
            "label": "GEN_NOTES"
          }
        },
        {
          "id": "S5.repair",
          "title": "자동 수선 루프 — 화면ID (gen→Claude→게이트 재시도 3회)",
          "kind": "node",
          "script": "${harnessDir}/repair-loop.js",
          "splitArgs": true,
          "args": [
            "${input:ids}",
            "--max",
            "3"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (공백으로 여러 개)",
              "default": "DMF0052"
            }
          ],
          "confirm": "Claude Code 를 최대 3회 호출합니다. 진행할까요?"
        },
        {
          "id": "S5.claude",
          "title": "[Claude Code] TODO 이식 — 화면ID",
          "kind": "claude",
          "prompt": "new_screen.md",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S5.check",
          "title": "게이트 판정 — 화면 폴더 (check.js)",
          "kind": "node",
          "script": "${harnessDir}/check.js",
          "args": [
            "--page",
            "${input:dir}"
          ],
          "inputs": [
            {
              "name": "dir",
              "prompt": "nscm-fe 페이지 폴더 절대경로",
              "default": "C:\\Projects\\NSCM\\nscm-fe\\features\\demand\\src\\pages\\edi-summary"
            }
          ]
        },
        {
          "id": "S5.final",
          "title": "최종 게이트 (--final, 미구현 0)",
          "kind": "node",
          "script": "${harnessDir}/check.js",
          "args": [
            "--page",
            "${input:dir}",
            "--final"
          ],
          "inputs": [
            {
              "name": "dir",
              "prompt": "nscm-fe 페이지 폴더 절대경로",
              "default": "C:\\Projects\\NSCM\\nscm-fe\\features\\demand\\src\\pages\\edi-summary"
            }
          ]
        },
        {
          "id": "S5.notes",
          "title": "GEN_NOTES 열기 — 화면ID",
          "kind": "open",
          "path": "${genDir}/${input:id}/GEN_NOTES.md",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S5.diff",
          "title": "작업 전/후 소스 비교 — 페이지 폴더 (git)",
          "kind": "diff",
          "inputs": [
            {
              "name": "dir",
              "prompt": "nscm-fe 페이지 폴더 절대경로",
              "default": "C:\\Projects\\NSCM\\nscm-fe\\features\\demand\\src\\pages\\edi-summary"
            }
          ]
        },
        {
          "id": "S5.repairlog",
          "title": "수선 기록 열기 — 화면ID (REPAIR.md)",
          "kind": "open",
          "path": "${genDir}/${input:id}/REPAIR.md",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S5.tsc",
          "title": "컴파일·린트 게이트 — 화면 폴더 (check.js --tsc --lint)",
          "kind": "node",
          "script": "${harnessDir}/check.js",
          "args": [
            "--page",
            "${input:dir}",
            "--tsc",
            "--lint"
          ],
          "inputs": [
            {
              "name": "dir",
              "prompt": "nscm-fe 페이지 폴더 절대경로",
              "default": "C:\\Projects\\NSCM\\nscm-fe\\features\\demand\\src\\pages\\edi-summary"
            }
          ]
        },
        {
          "id": "S5.regsql",
          "title": "Oracle 메타 등록 SQL 생성 — 화면ID (gen-register-sql.js → Doc/gen/<ID>/<ID>_registration.sql)",
          "kind": "node",
          "script": "${harnessDir}/gen-register-sql.js",
          "args": [
            "${input:id}"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S5.regopen",
          "title": "등록 SQL 열기 — 화면ID",
          "kind": "open",
          "path": "${genDir}/${input:id}/${input:id}_registration.sql",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S5.pkg",
          "title": "Oracle PKG 골격 생성 — 화면ID (gen-pkg.js)",
          "kind": "node",
          "script": "${harnessDir}/gen-pkg.js",
          "args": [
            "${input:id}"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S5.pkgrepair",
          "title": "PKG 이식 루프 — 화면ID (Claude ×3 + check-pkg)",
          "kind": "node",
          "script": "${harnessDir}/repair-loop.js",
          "args": [
            "${input:id}",
            "--pkg",
            "--max",
            "3"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "confirm": "Claude Code 를 최대 3회 호출합니다. 진행할까요?"
        },
        {
          "id": "S5.pkgcheck",
          "title": "PKG 게이트 — 화면ID (check-pkg.js)",
          "kind": "node",
          "script": "${harnessDir}/check-pkg.js",
          "args": [
            "${input:id}"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ]
        },
        {
          "id": "S5.pkgdeploy",
          "title": "PKG 컴파일 배포 — 화면ID (run_sql.py --commit, USER_ERRORS)",
          "kind": "python",
          "script": "${dbconnDir}/run_sql.py",
          "args": [
            "${genDir}/${input:id}/${input:id}_PKG.sql",
            "--commit"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
