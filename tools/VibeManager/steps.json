{
  "$schema": "Vibe_Manager steps — 변수: ${root} ${toolsDir} ${harnessDir} ${tobeDir} ${outDir} ${tobeOutDir} ${gapDir} ${genDir} ${agentDriver} ${agentModel} ${input:이름}",
  "steps": [
    {
      "id": "S1",
      "title": "1. AS-IS 분석 (C# 파서)",
      "detail": "Roslyn·ScriptDom·MSSQL → Fact Pack. 교차검증 불일치 0 이 완료 기준.",
      "tasks": [
        {
          "id": "S1.run",
          "title": "파서 전체 실행 (빌드→함정테스트→scan→교차검증→pack)",
          "kind": "powershell",
          "script": "${toolsDir}/run.ps1",
          "confirm": "전체 스캔은 수 분 걸립니다. 실행할까요?",
          "gate": {
            "type": "csvRows",
            "file": "${outDir}/crosscheck_report.csv",
            "max": 0,
            "label": "교차검증 불일치"
          },
          "title_en": "Run full parser (build → trap test → scan → cross-check → pack)"
        },
        {
          "id": "S1.db",
          "title": "DB 메타 추출 (읽기 전용)",
          "kind": "powershell",
          "script": "${toolsDir}/db.ps1",
          "confirm": "MSSQL 에 접속해 메타를 추출합니다(읽기 전용). 실행할까요?",
          "gate": {
            "type": "csvRows",
            "file": "${outDir}/db/db_objects.csv",
            "min": 1,
            "label": "DB 객체"
          },
          "title_en": "Extract DB metadata (read-only)"
        },
        {
          "id": "S1.grid",
          "title": "Grid SP 실행(ROLLBACK) → 실제 컬럼",
          "kind": "powershell",
          "script": "${toolsDir}/grid.ps1",
          "confirm": "쓰기 없는 *_SPREAD_TITLE SP 만 트랜잭션 안에서 실행 후 ROLLBACK 합니다. 실행할까요?",
          "gate": {
            "type": "csvAll",
            "file": "${outDir}/db/grid/grid_runs.csv",
            "column": "status",
            "equals": "OK",
            "label": "SP 실행"
          },
          "title_en": "Run grid SPs (ROLLBACK) → actual columns"
        },
        {
          "id": "S1.pack",
          "title": "화면 Pack 재생성",
          "kind": "powershell",
          "script": "${toolsDir}/pack.ps1",
          "gate": {
            "type": "csvRows",
            "file": "${outDir}/screens/_index.csv",
            "min": 1,
            "label": "화면"
          },
          "title_en": "Rebuild all screen packs"
        },
        {
          "id": "S1.packone",
          "title": "Fact Pack 1화면 재생성 — 화면ID (pack.ps1 <ID>, 수 초)",
          "kind": "powershell",
          "script": "${toolsDir}/pack.ps1",
          "args": [
            "${input:ids}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID(공백 구분)",
              "default": "DMF0052"
            }
          ],
          "splitArgs": true,
          "gate": {
            "type": "fileExists",
            "file": "${outDir}/screens/${input:id}/${input:id}_summary.md",
            "label": "Fact Pack"
          },
          "title_en": "Rebuild Fact Pack for one screen — ID (pack.ps1 <ID>, seconds)"
        },
        {
          "id": "S1.screen",
          "title": "화면 Fact Pack 열기 — 화면ID",
          "kind": "open",
          "path": "${outDir}/screens/${input:id}",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "title_en": "Open screen Fact Pack — ID"
        },
        {
          "id": "S1.review",
          "title": "검수 체크포인트 열기",
          "kind": "open",
          "path": "${outDir}/_review",
          "title_en": "Open review checkpoints"
        },
        {
          "id": "S1.recon",
          "title": "개발대상 대사표 — 누락 재확인 (xlsx→csv → recon.js)",
          "kind": "node",
          "script": "${reconDir}/recon.js",
          "args": [],
          "gate": {
            "type": "fileExists",
            "file": "${reconOutDir}/대사표.md",
            "label": "대사표"
          },
          "title_en": "Target reconciliation — recheck omissions (xlsx→csv → recon.js)"
        },
        {
          "id": "S1.reconx",
          "title": "개발대상 xlsx → CSV/map_screen.csv (xlsx_to_csv.py)",
          "kind": "python",
          "script": "${reconDir}/xlsx_to_csv.py",
          "args": [],
          "title_en": "Target xlsx → CSV/map_screen.csv (xlsx_to_csv.py)"
        },
        {
          "id": "S1.recondash",
          "title": "대사표 대시보드 열기 (Doc/recon/index.html)",
          "kind": "browser",
          "path": "${reconOutDir}/index.html",
          "title_en": "Open reconciliation dashboard (Doc/recon/index.html)"
        }
      ],
      "title_en": "1. AS-IS Analysis (C# parser)"
    },
    {
      "id": "S2",
      "title": "2. TO-BE 분석 · RULE",
      "detail": "TobeFacts(FE+BE) 로 같은 스키마의 Fact 를 뽑고, 룰은 CSV 사전으로 관리.",
      "tasks": [
        {
          "id": "S2.probe",
          "title": "DB 접속 점검 (asis MSSQL / tobe Oracle) — probe.py",
          "kind": "python",
          "script": "${dbconnDir}/probe.py",
          "args": [],
          "title_en": "Check DB connections (asis MSSQL / tobe Oracle) — probe.py"
        },
        {
          "id": "S2.export",
          "title": "To-Be Oracle 메타 export → Doc/tobefacts/db (export_tobe_meta.py)",
          "kind": "python",
          "script": "${dbconnDir}/export_tobe_meta.py",
          "args": [],
          "gate": {
            "type": "fileExists",
            "file": "${tobeOutDir}/db/proc_meta.csv",
            "label": "proc_meta.csv"
          },
          "title_en": "Export To-Be Oracle metadata → Doc/tobefacts/db (export_tobe_meta.py)"
        },
        {
          "id": "S2.run",
          "title": "To-Be 파서 실행 (추출→교차검증→Pack)",
          "kind": "powershell",
          "script": "${root}/tools/TobeFacts/run.ps1",
          "gate": {
            "type": "csvRows",
            "file": "${tobeOutDir}/crosscheck_report.csv",
            "max": 0,
            "label": "교차검증 불일치"
          },
          "title_en": "Run To-Be parser (extract → cross-check → pack)"
        },
        {
          "id": "S2.rules",
          "title": "룰 사전 열기 (rules/)",
          "kind": "open",
          "path": "${harnessDir}/rules",
          "title_en": "Open rule dictionaries (rules/)"
        },
        {
          "id": "S2.mine",
          "title": "사전 채굴 (짝 화면 → *.mined.csv)",
          "kind": "node",
          "script": "${harnessDir}/mine.js",
          "args": [
            "--tobe",
            "${tobeOutDir}",
            "--asis",
            "${outDir}",
            "--out",
            "${harnessDir}/rules"
          ],
          "title_en": "Mine dictionaries (paired screens → *.mined.csv)"
        },
        {
          "id": "S2.dbmeta",
          "title": "클라우드 메타 CSV 폴더 열기 (Doc/tobefacts/db)",
          "kind": "open",
          "path": "${tobeOutDir}/db",
          "title_en": "Open cloud metadata CSV folder (Doc/tobefacts/db)"
        },
        {
          "id": "S2.dbconn",
          "title": "DB 접속정보 열기 (dbconn.json — 비밀번호는 .env.asis)",
          "kind": "open",
          "path": "${dbconnDir}/dbconn.json",
          "title_en": "Open DB connection info (dbconn.json — passwords in .env.asis)"
        },
        {
          "id": "S2.examples",
          "title": "하우스 스타일 예제 채굴 (mine-examples.js → prompts/examples)",
          "kind": "node",
          "script": "${harnessDir}/mine-examples.js",
          "args": [],
          "title_en": "Mine house-style examples (mine-examples.js → prompts/examples)"
        },
        {
          "id": "S2.framework",
          "title": "To-Be 프레임워크·공통 카탈로그 생성 (framework.js → Doc/tobefacts/framework, rules/tobe_catalog.csv)",
          "kind": "node",
          "script": "${root}/tools/TobeFacts/framework.js",
          "args": [],
          "title_en": "Build To-Be framework & shared catalog (framework.js)"
        },
        {
          "id": "S2.frameworkopen",
          "title": "카탈로그 열기 (Doc/tobefacts/framework/INDEX.md)",
          "kind": "open",
          "path": "${tobeOutDir}/framework/INDEX.md",
          "title_en": "Open catalog (Doc/tobefacts/framework/INDEX.md)"
        }
      ],
      "title_en": "2. TO-BE Analysis · Rules"
    },
    {
      "id": "S3",
      "title": "3. 문서 초안 생성 (Agent)",
      "detail": "Fact Pack → 분석서 5종 + 업무분석서·화면설계서·단위테스트. 게이트 total PASS.",
      "tasks": [
        {
          "id": "S3.agent",
          "title": "Agent 실행 — 화면ID",
          "kind": "powershell",
          "script": "${toolsDir}/agent.ps1",
          "splitArgs": true,
          "args": [
            "${input:ids}",
            "-Driver",
            "${agentDriver}",
            "-Model",
            "${agentModel}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (공백으로 여러 개)",
              "default": "DMF0052"
            }
          ],
          "gate": {
            "type": "agentGates",
            "file": "${outDir}/agent",
            "label": "Agent 게이트"
          },
          "title_en": "Run Agent — ID"
        },
        {
          "id": "S3.docs",
          "title": "문서 3종만 재생성 — 화면ID (-Phase docs)",
          "kind": "powershell",
          "script": "${toolsDir}/agent.ps1",
          "splitArgs": true,
          "args": [
            "${input:ids}",
            "-Phase",
            "docs",
            "-Driver",
            "${agentDriver}",
            "-Model",
            "${agentModel}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "title_en": "Regenerate 3 docs only — ID (-Phase docs)"
        },
        {
          "id": "S3.xlsx",
          "title": "문서 Excel 생성 — 화면ID (make_docs.py → 설계서·분석서·GAP·TestCases4, 팀 양식)",
          "kind": "python",
          "script": "${root}/tools/Docs/make_docs.py",
          "args": [
            "${input:ids}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID(공백 구분)",
              "default": "DMF0052"
            }
          ],
          "splitArgs": true,
          "gate": {
            "type": "fileExists",
            "file": "${root}/Doc/documents/${input:id}",
            "label": "Excel"
          },
          "title_en": "Generate Excel docs — ID (make_docs.py → design · analysis · GAP · TestCases4, team format)"
        },
        {
          "id": "S3.xlsxopen",
          "title": "문서 Excel 폴더 열기 — 화면ID",
          "kind": "open",
          "path": "${root}/Doc/documents/${input:id}",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "title_en": "Open Excel docs folder — ID"
        },
        {
          "id": "S3.batch",
          "title": "Agent 전 화면 배치 (도메인 선택)",
          "kind": "agentBatch",
          "script": "${toolsDir}/agent.ps1",
          "title_en": "Agent batch for all screens (choose domain)"
        },
        {
          "id": "S3.report",
          "title": "Agent 게이트 집계 리포트",
          "kind": "gateReport",
          "title_en": "Agent gate summary report"
        },
        {
          "id": "S3.open",
          "title": "Agent 결과 열기 — 화면ID",
          "kind": "open",
          "path": "${outDir}/agent/${input:id}",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "title_en": "Open Agent results — ID"
        }
      ],
      "title_en": "3. Draft Documents (Agent)"
    },
    {
      "id": "S4",
      "title": "4. GAP 분석",
      "detail": "As-is Fact ↔ To-Be Fact 대사. COVERED/INTENDED/MISSING/UNMAPPED + 대시보드.",
      "tasks": [
        {
          "id": "S4.run",
          "title": "GAP 전 화면 실행 → Doc/gap",
          "kind": "node",
          "script": "${harnessDir}/gap.js",
          "gate": {
            "type": "csvRows",
            "file": "${gapDir}/_summary.csv",
            "min": 1,
            "label": "GAP 요약"
          },
          "title_en": "Run GAP for all screens → Doc/gap"
        },
        {
          "id": "S4.one",
          "title": "GAP 실행 — 화면ID",
          "kind": "node",
          "script": "${harnessDir}/gap.js",
          "splitArgs": true,
          "args": [
            "${input:ids}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (공백으로 여러 개)",
              "default": "DMF0045"
            }
          ],
          "title_en": "Run GAP — ID"
        },
        {
          "id": "S4.dash",
          "title": "GAP 대시보드 열기 (index.html)",
          "kind": "browser",
          "path": "${gapDir}/index.html",
          "title_en": "Open GAP dashboard (index.html)"
        },
        {
          "id": "S4.open",
          "title": "GAP 결과 CSV — 화면ID",
          "kind": "open",
          "path": "${gapDir}/${input:id}_gap.csv",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0045"
            }
          ],
          "title_en": "GAP result CSV — ID"
        },
        {
          "id": "S4.goldgen",
          "title": "골든 케이스 생성 (As-is SP ↔ To-Be PROC 짝) — gen_golden_cases.py",
          "kind": "python",
          "script": "${dbconnDir}/gen_golden_cases.py",
          "splitArgs": true,
          "args": [
            "${input:ids}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (비우면 전체)",
              "default": ""
            }
          ],
          "title_en": "Generate golden cases (As-is SP ↔ To-Be PROC pairs) — gen_golden_cases.py"
        },
        {
          "id": "S4.golden",
          "title": "골든 테스트 실행 (양쪽 SP 결과 대조) — golden.py",
          "kind": "python",
          "script": "${dbconnDir}/golden.py",
          "splitArgs": true,
          "args": [
            "${input:ids}"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (비우면 전체 GET)",
              "default": "DMF0003"
            }
          ],
          "gate": {
            "type": "fileExists",
            "file": "${goldenDir}/_summary.md",
            "label": "골든 요약"
          },
          "title_en": "Run golden tests (compare both SP results) — golden.py"
        },
        {
          "id": "S4.goldopen",
          "title": "골든 결과 열기 (Doc/golden/_summary.md)",
          "kind": "open",
          "path": "${goldenDir}/_summary.md",
          "title_en": "Open golden results (Doc/golden/_summary.md)"
        }
      ],
      "title_en": "4. GAP Analysis"
    },
    {
      "id": "S5",
      "title": "5. 신규 UI 개발 (하네스)",
      "detail": "프로그램 ID 하나로: 골격 생성 → nscm-fe 적용 → 게이트 → Claude Code 가 TODO 만 채움.",
      "tasks": [
        {
          "id": "S5.pipeline",
          "title": "★ ID 하나로 끝까지 — 화면ID (pipeline.js: 골격→등록SQL→PKG→FE수선→PKG이식→E2E스펙→대사표)",
          "kind": "node",
          "script": "${harnessDir}/pipeline.js",
          "args": [
            "${input:id}",
            "--max",
            "3"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "confirm": "Claude Code 를 FE/PKG 각 최대 3회 호출합니다(수십 분). 진행할까요?",
          "gate": {
            "type": "fileExists",
            "file": "${genDir}/${input:id}/PIPELINE.md",
            "label": "PIPELINE.md"
          },
          "title_en": "★ One ID end-to-end — ID (pipeline.js: skeleton → registration SQL → PKG → FE repair → PKG port → E2E spec → reconciliation)"
        },
        {
          "id": "S5.pipelinedesign",
          "title": "★ 새 화면 — 화면설계서 우선(from 설계서: pipeline --design Doc/asisfacts/agent/<ID>/screen_design.md)",
          "kind": "node",
          "script": "${harnessDir}/pipeline.js",
          "args": [
            "${input:id}",
            "--max",
            "3",
            "--design",
            "${outDir}/agent/${input:id}/screen_design.md"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "gate": {
            "type": "fileExists",
            "file": "${genDir}/${input:id}/PIPELINE.md",
            "label": "PIPELINE.md"
          },
          "title_en": "★ New screen — design doc first (pipeline --design …/screen_design.md)"
        },
        {
          "id": "S5.pipelinedry",
          "title": "파이프라인 드라이런 — 화면ID (--no-claude: 생성+게이트만)",
          "kind": "node",
          "script": "${harnessDir}/pipeline.js",
          "args": [
            "${input:id}",
            "--no-claude"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "title_en": "Pipeline dry run — ID (--no-claude: generate + gates only)"
        },
        {
          "id": "S5.pipelineregen",
          "title": "파이프라인 — PKG 골격 강제 재생성(--regen-pkg, 이식 결과 폐기)",
          "kind": "node",
          "script": "${harnessDir}/pipeline.js",
          "args": [
            "${input:id}",
            "--max",
            "3",
            "--regen-pkg"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "confirm": "Claude 가 이식한 <ID>_PKG.sql 을 버리고 골격부터 다시 만듭니다. 진행할까요?",
          "title_en": "Pipeline — force PKG skeleton regeneration (--regen-pkg, discards port)"
        },
        {
          "id": "S5.new",
          "title": "신규 화면 생성 — 화면ID (new-screen.ps1)",
          "kind": "powershell",
          "script": "${harnessDir}/new-screen.ps1",
          "splitArgs": true,
          "args": [
            "${input:id}"
          ],
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "gate": {
            "type": "fileExists",
            "file": "${genDir}/${input:id}/GEN_NOTES.md",
            "label": "GEN_NOTES"
          },
          "title_en": "Create new screen — ID (new-screen.ps1)"
        },
        {
          "id": "S5.repair",
          "title": "자동 수선 루프 — 화면ID (gen→Claude→게이트 재시도 3회)",
          "kind": "node",
          "script": "${harnessDir}/repair-loop.js",
          "splitArgs": true,
          "args": [
            "${input:ids}",
            "--max",
            "3"
          ],
          "inputs": [
            {
              "name": "ids",
              "prompt": "화면ID (공백으로 여러 개)",
              "default": "DMF0052"
            }
          ],
          "confirm": "Claude Code 를 최대 3회 호출합니다. 진행할까요?",
          "title_en": "Auto repair loop — ID (gen → Claude → gate, 3 retries)"
        },
        {
          "id": "S5.claude",
          "title": "[Claude Code] TODO 이식 — 화면ID",
          "kind": "claude",
          "prompt": "new_screen.md",
          "inputs": [
            {
              "name": "id",
              "prompt": "화면ID",
              "default": "DMF0052"
            }
          ],
          "title_en": "[Claude Code] Port TODOs — ID"
        },
        {
          "id": "S5.check",
          "title": "게이트 판정 — 화면 폴더 (check.js)",
          "kind": "node",
          "script": "${harnessDir}/check.js",
          "args": [
            "--page",
            "${input:dir}"
          ],
          "inputs": [
            {
              "name": "dir",
              "prompt": "nscm-fe 페이지 폴더 절대경로",
