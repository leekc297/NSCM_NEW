    const gc=e2eCount(e,g.keys);
    if(e.segs.length>1||g.label)e.el.appendChild(el('div','e2ehead','▶ '+g.no+UI_BD.runN+(g.label?' · '+g.label:'')+' · 🧪 '+g.keys.length+'/'+(g.total||'?')+' · ✅'+gc.ok+' · ✖'+gc.fail));
