  const key=e.seg.no+'|'+m[2];const st=(m[1]==='ok'||m[1]==='✓')?'ok':m[1]==='-'?'skip':'fail';const prev=e.tests[key]; // 같은 제목이라도 다른 실행(구간)이면 다른 테스트
  if(!prev){e.order.push(key);e.seg.keys.push(key);}
