    if (!acted) { this.out(stream, `ℹ ${name} 실행 중 아님 — 포트 ${it.port || '-'} 비어 있음\n`, 'ok'); this.post({ type: 'chat', role: 'meta', text: `ℹ ${name} 실행 중 아님` }); this.post({ type: 'server', name, state: 'stopped', sec: 0 }); return; }
