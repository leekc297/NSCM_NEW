    });
    return result;
  }

  // 1.9.6: E2E 선행 — BE(8080)/FE(5173) 가 LISTEN 이 아니면 quick.json 의 ☕ BE Start / 🎨 FE Start 항목으로 먼저 기동하고 완료를 기다린다(사용자 지시 2026-10-21).
