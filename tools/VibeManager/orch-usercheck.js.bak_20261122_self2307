  },
  // U13 창 다시 로드 뒤 VMW 작업 재개 누락(개선안 20261120184524_SELF: 원래 중단 사건 기준으로 다시 세움)
  //   ① 중단 = events.jsonl chain.end(aborted) 또는 user.stop(why vscode.dispose) 의 runId, job, screen, ms. runId 없는 user.stop 은 같은 창(wb)의 5초 안 chain.end(aborted) 와 묶음.
  //      24시간 창과 경과 시간은 이 ms 로만 셈. job.json 수정 시각, interruptedAt, R5 사건 시각은 판정에 쓰지 않음
  //   ② 재개 가능 = jobs.js 작업 재개 단추 조건(실행 중 아님, 남은 화면 있음). job-runner 에 canResume 이 있으면 그것을 씀.
  //      job.json 이 없으면(사용자가 작업을 지움) 판정 안 함. 업무 작업 밖 Workbench 체인은 재개 기록(chain_progress 같은 runId)이 없으면 판정 안 함
  //   ③ 재실행 = 중단 뒤 같은 화면 chain.start(작업 번호 무관) 또는 같은 작업 job.start. waitMin 넘게 없으면 fail · key S13|U13|<중단 runId>
  //   ④ 단계 재개 기록(chain_progress)은 fail 조건 아님. 없으면 detail 에 '단계 처음부터' 만 적음
  //   ⑤ 중단 사건 줄이 없는 중단 작업(재개 기록 기능 이전 옛 기록)은 warn 1건으로 묶음
  reloadResumeMissing(u, x) {
    const out = []; const waitMs = (u.params.waitMin || 30) * 60000; const settleMs = 120000; const up = v => String(v || '').toUpperCase();
    const jr = mod('job-runner');
    const canResume = j => {
