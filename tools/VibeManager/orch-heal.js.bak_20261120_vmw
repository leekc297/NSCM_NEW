    watch.update(inc.id, { status: 'acting' }, { by: 'VMO 자가 복구', grade: 'A', what: `중지된 체인이 계속 실행 중. 프로세스 ${pids.length}개 종료(PID ${pids.join(', ') || '없음'}) · 체인 중지 다시 요청` });
