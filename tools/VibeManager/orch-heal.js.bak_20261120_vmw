    const what = `해결: @shared/${m[1]} 받음 · 화면 파일 변환 오류 0 확인 · ${rq.none ? `다시 실행 안 함(${rq.none})` : `업무 작업 ${rq.job} 에서 ${scr} 다시 실행(${rq.how === 'stop-requeue' ? '진행 중 실행을 멈추고 다시' : '대기로 돌림'})`}`;
    watch.update(inc.id, { status: 'resolved', resolvedBy: 'VMO 자가 복구' }, { by: 'VMO 자가 복구', grade: 'A', what });
