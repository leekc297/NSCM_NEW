.grp h3{font-size:12px;margin:0 0 6px}
.btns{display:flex;flex-wrap:wrap;gap:6px}
.btns button{background:var(--vscode-button-secondaryBackground);color:var(--vscode-button-secondaryForeground);border:none;border-radius:4px;padding:5px 10px;cursor:pointer;font-size:12px}
.btns button:hover{background:var(--vscode-button-secondaryHoverBackground)}
.split{display:flex;flex-direction:column;height:100%}
.split .menu{padding:10px 12px;display:flex;flex-direction:column;gap:8px;border-bottom:1px solid var(--b);max-height:46%;overflow:auto}
.split .log{flex:1;overflow:auto}
