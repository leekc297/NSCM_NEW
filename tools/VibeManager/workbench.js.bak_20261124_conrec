  <div class="pbox" id="pbox" data-mode="${esc(curMode)}">
    <textarea id="t" placeholder="${esc(String(t(p, 'ph')).replace(/\p{Extended_Pictographic}️?\s*/gu, ''))}"></textarea>
    <div class="pbar"><div class="pl">
