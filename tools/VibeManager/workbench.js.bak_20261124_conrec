// ── 1.6: 화면 ID 확정 유틸 (needsId quick 실행 전 반드시 호출) ──
//   사용자 지시: 묵시적 재사용 금지 — 항상 QuickPick 으로 명시 확인. "유지" 를 누를 때만 재사용.
async function pickFromAsisList(p, curId) {
  const script = path.join(p.root, 'tools', 'DbConn', 'list_asis_programs.py');
  if (!fs.existsSync(script)) {
    vscode.window.showWarningMessage('tools/DbConn/list_asis_programs.py 가 없어 목록 조회를 할 수 없습니다. ID 를 직접 입력하세요.');
    return null;
  }
  const data = await vscode.window.withProgress(
    { location: vscode.ProgressLocation.Notification, title: 'AS-IS DB 프로그램 목록 조회 중 (.env.asis)', cancellable: false },
    () => new Promise(res => {
      let buf = '';
      const child = cp.spawn(p.python || 'python', [script], { cwd: p.root, shell: process.platform === 'win32' });
      child.stdout.on('data', d => buf += d.toString('utf8'));
      child.stderr.on('data', d => buf += d.toString('utf8'));
      child.on('close', () => { try { res(JSON.parse(buf)); } catch { res({ ok: false, reason: (buf || '응답 없음').slice(0, 500) }); } });
      child.on('error', e => res({ ok: false, reason: `python 실행 실패: ${e.message}` }));
    })
  );
  if (!data.ok) { vscode.window.showWarningMessage(`AS-IS DB 조회 실패: ${data.reason || '사유 불명'}. 직접 입력으로 다시 시도하거나 .env.asis 를 확인하세요.`); return null; }
  const items = (data.items || []).map(it => ({
    label: `${it.id}  —  ${it.name || '(이름 없음)'}`,
    description: it.path || '',
    _id: it.id
  }));
  if (!items.length) { vscode.window.showInformationMessage('AS-IS 프로그램 목록이 비어 있습니다.'); return null; }
  const pick = await vscode.window.showQuickPick(items, {
    title: `AS-IS 프로그램 목록 (${items.length.toLocaleString()}건) · TB_FX_ProgramInfo UseYN=Y`,
    placeHolder: '프로그램 ID 또는 이름/경로로 검색' + (curId ? ` · 현재 ID: ${curId}` : ''),
    matchOnDescription: true,
    ignoreFocusOut: true
  });
  return pick ? pick._id : null;
}

async function confirmScreenIdOrPick(wb, curId, actionLabel) {
  const items = [];
  if (curId) items.push({ label: `✅ 현재 ID 유지: ${curId}`, description: '명시적으로 확인 후 그대로 진행', _action: 'keep' });
  items.push({ label: '✏️ 다른 ID 직접 입력', description: '형식: 2~4자 영문 + 2~6자리 숫자 (예: DMF0052, SCP0096)', _action: 'input' });
  items.push({ label: '🔎 AS-IS DB 프로그램 목록에서 선택', description: 'TB_FX_ProgramInfo WHERE UseYN=\'Y\' (.env.asis 접속 필요)', _action: 'list' });
  items.push({ label: '⛔ 취소', description: '이 작업을 실행하지 않음', _action: 'cancel' });
  // 1.9.41(2026-11-05 사용자 "UI ID 미지정 상태에서 최초 UI ID 입력하면 반응하지 않고 한번 더 입력해야 입력됨"):
  //   이 QuickPick 의 입력칸은 '목록 필터' 라서 ID(예 SCP0084)를 바로 치면 맞는 항목이 0개 → Enter 무반응 → ✏️ 를 골라 입력창에 다시 쳐야 했다.
  //   보완: 입력값이 ID 형식이면 맨 위에 '✅ <ID> 로 지정' 항목을 즉시 만들어 Enter 한 번으로 확정한다(기존 4개 선택지는 그대로).
  const ID_RE = /^[A-Z]{2,4}[0-9]{2,6}$/;
  const pick = await new Promise(resolve => {
    const qp = vscode.window.createQuickPick();
    require('./id-input').bindQuickPick(qp); // 2026-11-23 한글 입력 상태에서도 영문 대문자 ID
    let done = false;
    const finish = v => { if (done) return; done = true; resolve(v); qp.hide(); };
    qp.title = `워크벤치 #${wb.inst} · "${actionLabel}" 실행 전 화면 ID 확정`;
    qp.placeholder = (curId ? `현재 저장된 ID: ${curId} · ` : '화면 ID 가 설정되지 않았습니다 · ') + '여기에 화면 ID 를 바로 입력하고 Enter(예: SCP0084) 또는 아래에서 선택';
    qp.matchOnDescription = true;
    qp.ignoreFocusOut = true;
    qp.items = items;
    const typedItem = v => { const s = require('./id-input').toId(String(v || '').trim()); /* 2026-11-23 한글 조합 중에도 변환한 ID 로 '로 지정' 항목 */ return ID_RE.test(s) ? { label: `✅ ${s} 로 지정`, description: '입력한 화면 ID 로 바로 확정', _action: 'typed', _id: s, alwaysShow: true } : null; };
    qp.onDidChangeValue(v => {
      const ti = typedItem(v);
      qp.items = ti ? [ti, ...items] : items;
      if (ti) qp.activeItems = [qp.items[0]];
    });
    qp.onDidAccept(() => {
      const sel = (qp.selectedItems && qp.selectedItems[0]) || (qp.activeItems && qp.activeItems[0]) || typedItem(qp.value);
      if (sel) finish(sel);  // 형식이 아닌 값 + 선택 없음 = 그대로 대기(닫지 않음)
    });
    qp.onDidHide(() => { finish(undefined); qp.dispose(); });
    qp.show();
  });
  if (!pick || pick._action === 'cancel') return null;
  if (pick._action === 'typed') return pick._id;
  if (pick._action === 'keep') return curId;
  if (pick._action === 'input') {
    const nid = await require('./id-input').askId(vscode, { // 2026-11-23 한글 입력 상태에서도 영문 대문자 ID
      prompt: '화면 ID 입력',
      value: curId || '',
      placeHolder: 'DMF0052',
      ignoreFocusOut: true,
      validateInput: v => v && !/^[A-Z]{2,4}[0-9]{2,6}$/i.test(v.trim()) ? '형식: 2~4자 영문 + 2~6자리 숫자' : null
    });
    if (!nid || !nid.trim()) return null;
    return nid.trim().toUpperCase();
  }
  if (pick._action === 'list') {
    const picked = await pickFromAsisList(wb.api.paths(), curId);
    return picked;
  }
  return null;
}

// ── open: 패널 생성/활성화 ──
