// 2026-11-19 오케스트라 P8: JobRunner — 업무 1개(quick.json 항목)를 화면 여러 개에 실행한다(업무 작업창의 실행기).
//   화면마다 ChainRunner(chain-runner.js) 1개를 만들어 돌린다. 창이 없어도 돌고, 상태는 .vibe/jobs/<작업번호>/job.json 에 남는다.
//   · 순차 실행(maxPar 1). 같은 화면이 다른 곳(Workbench·다른 작업)에서 실행 중이면 그 화면을 뒤로 미루고 다음 화면부터 한다
//   · 실패 처리: continue = 실패 화면을 표시하고 다음 화면 계속 / stop = 첫 실패에서 중단
//   · 일시 중지 = 실행 중 화면은 끝까지, 새 화면은 시작 안 함 · 중지 = 실행 중 화면도 중지
//   · 이어서 실행 = 끝나지 않은 화면만 · 실패분만 다시 = 실패·중지 화면만
//   · VS Code 를 닫았다 열면 실행 중이던 작업은 '중단됨'으로 읽힌다(실행 중이던 화면은 대기로 되돌린다) → 이어서 실행
//   · 끝나면 .vibe/jobs/<작업번호>/SUMMARY.md(화면별 결과·소요·실패 원인 1줄)
//   사건 기록: job.start · job.item.start · job.item.end · job.end (.vibe/orch/events.jsonl)
'use strict';
const fs = require('fs');
const path = require('path');
const { ChainRunner } = require('./chain-runner');
const state = require('./orch-state');
let orchEv = null; try { orchEv = require('./orch-events'); } catch { orchEv = null; }

const DONE = new Set(['done', 'warn', 'hold', 'fail', 'cancel', 'skip']);     // 끝난 화면 상태
const STATUS_KO = { wait: '대기', busy: '다른 곳에서 실행 중', admit: '입장 대기', run: '실행', done: '완료', warn: '완료(경고)', hold: '사람 확인 필요', fail: '실패', cancel: '중지', skip: '건너뜀' };
const JOB_KO = { idle: '시작 전', running: '실행 중', pausing: '일시 중지 중', paused: '일시 중지', stopped: '중지', interrupted: '중단됨', done: '끝남' };

let api = null;                                   // extension.js wbApi()
const jobs = new Map();                           // id → { job, runners: Map(screen → ChainRunner), loop: Promise|null, logs: Map(screen → [text]) }
const listeners = new Set();                      // fn(jobId, kind, data)

const two = n => String(n).padStart(2, '0');
const stamp = () => { const d = new Date(); return `${d.getFullYear()}${two(d.getMonth() + 1)}${two(d.getDate())}_${two(d.getHours())}${two(d.getMinutes())}${two(d.getSeconds())}`; };
const nowLocal = ms => (orchEv ? orchEv.nowLocal(ms) : new Date(ms || Date.now()).toISOString());
const P = () => api.paths();
const jobsDir = () => path.join(P().vibeDir, 'jobs');
const jobDir = id => path.join(jobsDir(), id);
const readJson = (f, d) => { try { return JSON.parse(fs.readFileSync(f, 'utf8').replace(/^﻿/, '')); } catch { return d; } };
function evt(type, data) { try { if (orchEv) { orchEv.init(P().vibeDir); orchEv.emit(type, data); } } catch { } }
function emit(jobId, kind, data) { for (const fn of listeners) { try { fn(jobId, kind, data); } catch { } } }
function save(job) { try { fs.mkdirSync(jobDir(job.id), { recursive: true }); fs.writeFileSync(path.join(jobDir(job.id), 'job.json'), JSON.stringify(job, null, 2), 'utf8'); } catch { } emit(job.id, 'job', job); }
const normId = s => String(s || '').trim().toUpperCase();
/** 붙여 넣은 글에서 화면 ID 뽑기(중복 제거 · 순서 유지) */
function parseIds(text) { const out = []; for (const m of String(text || '').toUpperCase().matchAll(/\b[A-Z]{2,4}\d{4}[A-Z]?\b/g)) if (!out.includes(m[0])) out.push(m[0]); return out; }

function loadQuickItems() { const promptPanel = require('./prompt-panel'); const p = P(); return promptPanel.loadQuick(p.extDir, p.root).groups.flatMap(g => g.items || []); }
/** 업무 작업창에서 고를 수 있는 업무 = quick.json 항목 중 batch: true 이고 창 없이 돌릴 수 있는 종류 */
function batchItems() { return loadQuickItems().filter(it => it.batch === true && ChainRunner.supports(it)).map(it => ({ label: it.label, label_en: it.label_en || '', kind: it.kind, hint: it.hint || '', hasAsk: stepsOf(it).some(st => !!st.askUser), askText: (stepsOf(it).find(st => !!st.askUser) || {}).askUser || '', steps: stepsOf(it).length, claudeSteps: stepsOf(it).filter(st => !st.task).length })); }
function stepsOf(it) { return it.kind === 'chain' ? (it.steps || []) : it.kind === 'claude' ? (it.flow || []) : []; }
function findItem(label) { return loadQuickItems().find(x => x.label === label) || null; }

/** 작업 만들기. opts: itemLabel · screens[] · onFail('continue'|'stop') · autoAnswer(bool) · mode('seq') · maxPar */
function create(opts) {
  const item = findItem(opts.itemLabel); if (!item) throw new Error(`업무 항목 없음: ${opts.itemLabel}`);
  if (!ChainRunner.supports(item)) throw new Error(`창 없이 실행할 수 없는 종류: ${item.kind}`);
  const ids = []; for (const s of opts.screens || []) { const id = normId(s); if (/^[A-Z]{2,4}\d{4}[A-Z]?$/.test(id) && !ids.includes(id)) ids.push(id); }
  if (!ids.length) throw new Error('화면이 없습니다');
  let id = `J${stamp()}`; let n = 1; while (fs.existsSync(jobDir(id)) || jobs.has(id)) id = `J${stamp()}_${++n}`;
  const job = { id, itemLabel: item.label, kind: item.kind, status: 'idle', mode: opts.mode === 'par' ? 'par' : 'seq', maxPar: Math.max(1, Number(opts.maxPar) || 1), onFail: opts.onFail === 'stop' ? 'stop' : 'continue', autoAnswer: opts.autoAnswer === true,
    createdAt: nowLocal(), startedAt: '', endedAt: '', note: '', screens: ids.map(sid => ({ id: sid, status: 'wait', step: '', actor: '', sec: 0, summary: '', why: '', md: '', startedAt: '', endedAt: '', tries: 0 })) };
  jobs.set(id, { job, runners: new Map(), loop: null, logs: new Map() }); save(job);
  return job;
}
function get(id) { const h = jobs.get(id); if (h) return h.job; const j = readJson(path.join(jobDir(id), 'job.json'), null); if (j) { adopt(j); return j; } return null; }
// 파일에서 읽은 작업을 메모리에 올린다. 실행 중으로 적혀 있으면 이 프로세스가 돌리던 것이 아니므로 '중단됨'으로 바꾼다
function adopt(job) {
  if (jobs.has(job.id)) return jobs.get(job.id).job;
  if (/^(running|pausing)$/.test(job.status)) { job.status = 'interrupted'; job.note = 'VS Code 창을 닫거나 다시 로드해 중단됨 — 이어서 실행으로 남은 화면을 실행'; for (const s of job.screens) if (!DONE.has(s.status)) { if (s.status === 'run' || s.status === 'admit' || s.status === 'busy') { s.status = 'wait'; s.step = ''; s.summary = '중단됨 — 다시 실행 대상'; } } }
  jobs.set(job.id, { job, runners: new Map(), loop: null, logs: new Map() });
  if (job.status === 'interrupted') save(job);
  return job;
}
/** 최근 작업 목록(파일 기준, 최신 먼저) */
function list(limit) {
  let names = []; try { names = fs.readdirSync(jobsDir()).filter(n => /^J\d{8}_\d{6}/.test(n)).sort().reverse(); } catch { }
  const out = []; for (const n of names.slice(0, limit || 30)) { const j = get(n); if (j) out.push(summaryOf(j)); }
  return out;
}
function summaryOf(job) { const c = {}; for (const s of job.screens) c[s.status] = (c[s.status] || 0) + 1; return { id: job.id, itemLabel: job.itemLabel, status: job.status, createdAt: job.createdAt, startedAt: job.startedAt, endedAt: job.endedAt, total: job.screens.length, counts: c, note: job.note || '' }; }

function busyElsewhere(job, screen) { // 같은 화면이 Workbench 나 다른 작업에서 체인 실행 중인가(같은 화면은 한 번에 1개)
  try { return state.snapshot().chains.some(c => c.screen === screen && c.job !== job.id); } catch { return false; }
}
function pushLog(h, screen, text) { let a = h.logs.get(screen); if (!a) { a = []; h.logs.set(screen, a); } a.push(text); if (a.length > 1500) a.splice(0, a.length - 1500); }

async function runOne(h, s) {
  const job = h.job; const item = findItem(job.itemLabel);
  if (!item) { s.status = 'skip'; s.summary = 'quick.json 에 업무 항목이 없음'; s.endedAt = nowLocal(); save(job); return; }
  const t0 = Date.now(); s.status = 'run'; s.startedAt = nowLocal(t0); s.endedAt = ''; s.summary = ''; s.why = ''; s.step = ''; s.actor = ''; s.tries = (s.tries || 0) + 1; save(job);
  evt('job.item.start', { job: job.id, screen: s.id, label: job.itemLabel, try: s.tries });
  const logF = path.join(jobDir(job.id), `${s.id}.log`); let ws = null; try { ws = fs.createWriteStream(logF, { flags: 'a' }); ws.write(`\n===== ${nowLocal(t0)} ${job.itemLabel} · ${s.id} (시도 ${s.tries}) =====\n`); } catch { ws = null; }
  const runner = new ChainRunner(api, { id: s.id, jobId: job.id, autoAnswer: job.autoAnswer, name: `${job.id}:${s.id}`,
    onLog: (text) => { if (ws) try { ws.write(text); } catch { } pushLog(h, s.id, text); emit(job.id, 'log', { screen: s.id, text }); },
    onStep: st => { if (st.kind === 'step' && (st.status === 'RUN' || st.status === 'REPAIR')) { s.step = `[${st.no}] ${st.name}${st.status === 'REPAIR' ? ' (보완)' : ''}`; s.actor = st.status === 'REPAIR' ? 'claude' : st.actor; s.sec = Math.round((Date.now() - t0) / 1000); save(job); } },
    onNote: text => { pushLog(h, s.id, `ℹ ${text}\n`); if (ws) try { ws.write(`ℹ ${text}\n`); } catch { } } });
  h.runners.set(s.id, runner);
  let r; try { r = await runner.run(item); } catch (e) { r = { ok: false, status: 'FAIL', summary: `예외: ${e.message}`, sec: Math.round((Date.now() - t0) / 1000) }; }
  h.runners.delete(s.id); runner.dispose(); if (ws) try { ws.end(`\n===== 끝 ${nowLocal()} ${r.status} =====\n`); } catch { }
  const map = { OK: 'done', WARN: 'warn', HOLD: 'hold', FAIL: 'fail', CANCEL: 'cancel', BLOCKED: 'skip', UNSUPPORTED: 'skip' };
  s.status = map[r.status] || 'fail'; s.sec = r.sec != null ? r.sec : Math.round((Date.now() - t0) / 1000); s.endedAt = nowLocal(); s.step = ''; s.actor = '';
  s.summary = String(r.summary || '').split('\n')[0].slice(0, 300); s.actorNote = r.actorNote || ''; s.md = r.md || ''; s.why = r.fail && r.fail.why ? String(r.fail.why).split('\n')[0].slice(0, 300) : '';
  s.log = path.relative(P().root, logF);
  evt('job.item.end', { job: job.id, screen: s.id, label: job.itemLabel, status: s.status, ms_run: Date.now() - t0, why: s.why });
  save(job);
}

async function loop(h) {
  const job = h.job; const sleep = ms => new Promise(r => setTimeout(r, ms));
  while (job.status === 'running') {
    const pending = job.screens.filter(s => s.status === 'wait' || s.status === 'busy');
    if (!pending.length) break;
    const next = pending.find(s => !busyElsewhere(job, s.id));
    if (!next) { for (const s of pending) if (s.status !== 'busy') { s.status = 'busy'; s.summary = '같은 화면이 다른 곳에서 실행 중 — 끝나면 실행'; } save(job); await sleep(15000); continue; }
    for (const s of pending) if (s !== next && s.status === 'busy' && !busyElsewhere(job, s.id)) { s.status = 'wait'; s.summary = ''; }
    await runOne(h, next);
    if (job.status === 'running' && job.onFail === 'stop' && (next.status === 'fail')) { job.status = 'stopped'; job.note = `첫 실패에서 중단 — ${next.id}: ${next.why || next.summary}`; break; }
  }
  if (job.status === 'pausing') job.status = 'paused';
  if (job.status === 'running') job.status = 'done';
  if (job.status !== 'paused') job.endedAt = nowLocal();
  h.loop = null; writeSummary(job); save(job);
  evt('job.end', { job: job.id, label: job.itemLabel, status: job.status, counts: summaryOf(job).counts }); // 일시 중지도 실행이 멈춘 것이므로 끝 사건을 남긴다(이어서 실행하면 job.start 가 다시 남는다)
  emit(job.id, 'end', summaryOf(job));
}

function writeSummary(job) {
  try {
    const c = summaryOf(job).counts; const tot = job.screens.reduce((a, s) => a + (s.sec || 0), 0);
    const head = `# ${job.itemLabel} — 작업 ${job.id}`;
    const meta = [`- 상태: ${JOB_KO[job.status] || job.status}${job.note ? ` (${job.note})` : ''}`, `- 시작 ${job.startedAt || '-'} · 끝 ${job.endedAt || '-'} · 화면 ${job.screens.length}개 · 화면 소요 합계 ${tot}초`,
      `- 결과: ${Object.entries(c).map(([k, v]) => `${STATUS_KO[k] || k} ${v}`).join(' · ')}`, `- 실패 처리: ${job.onFail === 'stop' ? '첫 실패에서 중단' : '실패 화면 표시 후 계속'} · 승인 단계 답: ${job.autoAnswer ? '실행' : '실행 안 함'}`];
    const esc = s => String(s || '').replace(/\|/g, '/').replace(/\r?\n/g, ' ');
    const rows = job.screens.map((s, i) => `| ${i + 1} | ${s.id} | ${STATUS_KO[s.status] || s.status} | ${s.sec || 0} | ${esc(s.why || s.summary)} | ${esc(s.actorNote)} | ${s.md ? esc(s.md.replace(/\\/g, '/')) : ''} |`);
    fs.writeFileSync(path.join(jobDir(job.id), 'SUMMARY.md'), [head, '', ...meta, '', '| # | 화면 | 결과 | 소요(초) | 요약·실패 원인 | 실행 주체 | 실행 기록 |', '|---|---|---|---|---|---|---|', ...rows, ''].join('\n'), 'utf8');
  } catch { }
}

function begin(h) { const job = h.job; if (h.loop) return false; job.status = 'running'; job.note = ''; if (!job.startedAt) job.startedAt = nowLocal(); job.endedAt = ''; save(job); state.init(P()); evt('job.start', { job: job.id, label: job.itemLabel, total: job.screens.length, pending: job.screens.filter(s => !DONE.has(s.status)).length }); h.loop = loop(h); return true; }
/** 시작 · 이어서 실행(끝나지 않은 화면만) */
function start(id) { const j = get(id); const h = jobs.get(id); if (!j || !h) return false; if (!j.screens.some(s => !DONE.has(s.status))) return false; return begin(h); }
/** 실패·중지 화면만 다시 */
function retryFailed(id) { const j = get(id); const h = jobs.get(id); if (!j || !h || h.loop) return false; let n = 0; for (const s of j.screens) if (s.status === 'fail' || s.status === 'cancel') { s.status = 'wait'; s.summary = '다시 실행 대상'; s.why = ''; n++; } if (!n) return false; return begin(h); }
/** 일시 중지: 실행 중 화면은 끝까지, 새 화면은 시작 안 함 */
function pause(id) { const h = jobs.get(id); if (!h || !h.loop || h.job.status !== 'running') return false; h.job.status = 'pausing'; h.job.note = '일시 중지 — 실행 중 화면이 끝나면 멈춤'; save(h.job); return true; }
/** 중지: 실행 중 화면도 중지 */
function stop(id) { const h = jobs.get(id); if (!h) return false; if (!h.loop) { if (/^(idle|paused|interrupted)$/.test(h.job.status)) { h.job.status = 'stopped'; save(h.job); } return true; } h.job.status = 'stopped'; h.job.note = '사용자 중지'; for (const r of h.runners.values()) { try { r.stop(); } catch { } } save(h.job); return true; }
/** 오케스트라가 공통 원인(서버·부하)으로 작업을 잠시 멈출 때 */
function pauseAll(why) { let n = 0; for (const h of jobs.values()) if (h.loop && h.job.status === 'running') { h.job.status = 'pausing'; h.job.note = `오케스트라 일시 중지 — ${why}`; save(h.job); n++; } return n; }
function logOf(id, screen) { const h = jobs.get(id); return h && h.logs.get(screen) ? h.logs.get(screen).slice(-400).join('') : ''; }
function running() { return [...jobs.values()].filter(h => !!h.loop).map(h => summaryOf(h.job)); }
function on(fn) { listeners.add(fn); return () => listeners.delete(fn); }
function init(wbApi) { api = wbApi; }
function dispose() { for (const h of jobs.values()) if (h.loop) { h.job.status = 'interrupted'; h.job.note = 'VS Code 종료로 중단됨'; for (const r of h.runners.values()) { try { r.stop(); } catch { } } try { fs.writeFileSync(path.join(jobDir(h.job.id), 'job.json'), JSON.stringify(h.job, null, 2), 'utf8'); } catch { } } }

module.exports = { init, dispose, on, create, get, list, start, retryFailed, pause, stop, pauseAll, logOf, running, batchItems, findItem, parseIds, summaryOf, STATUS_KO, JOB_KO, DONE };
