def _join_blocks(sql, var_rx, ms):
    """「FROM 테이블(별칭) / WHERE …」 덩어리의 조건에 변수가 있으면 값 줄(PRM)을 조인하고 조건의 변수를 PRM.P_NAME 으로 바꾼다.
    덩어리 끝 = 괄호 깊이가 음수가 되는 곳 또는 깊이 0 에서 GROUP BY · UNION ALL · ORDER BY 줄"""
    frm = re.compile(r'\n( *)FROM ([A-Z0-9_]+)( [A-Z][A-Z0-9]?)?( WITH \(NOLOCK\))?\n( *)WHERE ')
    out = []; pos = 0
    while True:
        m = frm.search(sql, pos)
        if not m: break
        i = m.end(); depth = 0; end = len(sql)
        while i < len(sql):
            ch = sql[i]
            if ch == '(': depth += 1
            elif ch == ')':
                depth -= 1
                if depth < 0: end = i; break
            elif ch == '\n' and depth == 0 and re.match(r'\n *(GROUP BY|UNION ALL|ORDER BY)\b', sql[i:i + 40]): end = i; break
            i += 1
        block = sql[m.end():end]
        if re.search(var_rx, block):
            ind = m.group(1)
            join = f'\n{ind} CROSS JOIN PRM' if ms else f'\n{ind}   , PRM'
            head = f'\n{ind}FROM {m.group(2)}{m.group(3) or ""}{m.group(4) or ""}' + join + f'\n{m.group(5)}WHERE '
            out.append(sql[pos:m.start()] + head + re.sub(var_rx, lambda x: 'PRM.P_' + x.group(1), block))
        else:
            out.append(sql[pos:end])
        pos = end
    out.append(sql[pos:])
    return ''.join(out)


def defaults(vid, names):
    return {n: (PLAN_DEFAULT[vid] if n == 'PLAN_START' else BASE[n]) for n in names}


def note(vid, names):
    parts = [(PLAN_NOTE.get(PLAN_DEFAULT.get(vid), DESC[n]) if n == 'PLAN_START' else DESC[n]) for n in names]
    return ' · '.join(parts) + '. 이 줄의 값만 바꿔 실행'


def oracle(vid, sql, vals=None):
    sql = OVERRIDE_ORA.get(vid, sql)
    rx = r':([A-Z][A-Z0-9_]*)'
    names = list(dict.fromkeys(re.findall(rx, sql)))
    if not names: return sql
    vals = {**defaults(vid, names), **(vals or {})}
    head = 'WITH PRM AS (SELECT ' + ', '.join(f"'{vals[n]}' AS P_{n}" for n in names) + f' FROM DUAL)   /* {note(vid, names)} */'
    body = _join_blocks('\n' + sql, rx, False)[1:]
    body = re.sub(rx, lambda m: f'(SELECT P_{m.group(1)} FROM PRM)', body)
    return head + '\n' + body


def mssql(vid, sql, vals=None):
    sql = OVERRIDE_MS.get(vid, sql)
    prim = []; deriv = []; body = []
    for ln in sql.split('\n'):
        m = re.match(r"DECLARE @(\w+) \w+(?:\(\d+\))? = (.+?);", ln)
        if m: (prim if m.group(2).startswith("'") else deriv).append((m.group(1), m.group(2)))
        elif ln.strip().startswith('OPTION (RECOMPILE)'): continue
        else: body.append(ln)
    names = [n for n, _ in prim]
    vals = {**defaults(vid, names), **(vals or {})}
    if deriv:
        head = ('WITH PRM0 AS (SELECT ' + ', '.join(f"'{vals[n]}' AS P_{n}" for n in names) + f')   /* {note(vid, names)} */\n'
                '   , PRM AS (SELECT ' + ', '.join([f'P_{n}' for n in names] + [re.sub(r'@(\w+)', r'P_\1', e) + f' AS P_{n}' for n, e in deriv]) + ' FROM PRM0)')
    else:
        head = 'WITH PRM AS (SELECT ' + ', '.join(f"'{vals[n]}' AS P_{n}" for n in names) + f')   /* {note(vid, names)} */'
    rx = r'@([A-Z][A-Z0-9_]*)'
    out = _join_blocks('\n' + '\n'.join(body), rx, True)[1:]
    out = re.sub(rx, lambda m: f'(SELECT P_{m.group(1)} FROM PRM)', out)
    return head + '\n' + out


BAD = [(r'(?m)^\s*(SET|PROMPT|DEFINE|UNDEFINE)\s', 'SQL*Plus 명령'), (r'(?m)^&\w', '& 치환'), (r'(?m)^/\s*$', '단독 /'), (r'(?m)^\s*$', '빈 줄'), (r';\s*$', '끝 세미콜론'),
       (r'\?', '? 문자'), (r':[A-Za-z_가-힣]', ':이름 형태'), (r'@[A-Za-z_]', '@변수'), (r'(?m)^\s*DECLARE\b', 'DECLARE'), (r'\t', '탭 문자')]


def lint(sql):
    """DBeaver 실행을 막는 형태 검사 — 걸린 항목 이름 목록"""
    return [nm for rx, nm in BAD if re.search(rx, sql)]


def build(v9_tobe=None, test=False):
    """[[ID, 분류, 확인 내용, 대상 테이블, 확인 포인트, TO-BE SQL, AS-IS SQL]] — test=True 면 TO-BE 를 자료가 있는 일자 값으로"""
    rows = []
    for i, cat, what, tabs, point, sql, binds in VQ:
        rows.append([i, cat, what, tabs, point, oracle(i, sql, binds if test else None), mssql(i, ASIS[i][0]) if i in ASIS else '-'])
    for i, cat, what, tabs, point, tv in (v9_tobe or []):   # 기존 VQ-27 · VQ-31 (AS-IS 대조용으로 다시 적음)
        tv_vals = ({'PLAN_START': '20261009'} if i == 'VQ-31' else {'FROM_YYYYMMDD': '20261001'}) if test else None
        rows.append([i, cat, what + f' (검증쿼리 시트 {i} 와 같은 쿼리 · AS-IS 대조용)', tabs, point, oracle(i, tv, tv_vals), mssql(i, ASIS[i][0])])
    return rows
