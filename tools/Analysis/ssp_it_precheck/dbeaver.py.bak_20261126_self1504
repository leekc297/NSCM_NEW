def _vq41(ms):
    br = []
    for k, (unit, tab, rule, off, cond) in enumerate(_ST):
        if ms:
            cond = (cond.replace("TO_CHAR(TO_DATE(:TEST_DATE, 'YYYYMMDD') - 1, 'YYYYMMDD')", '@D1').replace("TO_CHAR(TO_DATE(:TEST_DATE, 'YYYYMMDD') - 3, 'YYYYMMDD')", '@D3')
                    .replace("TO_DATE(:TEST_DATE, 'YYYYMMDD') - 1", 'CONVERT(DATETIME, @D1, 112)').replace(':TEST_DATE', '@TEST_DATE'))
            unit, rule = 'N' + unit, 'N' + rule
        als = (' AS UNIT', ' AS TABLE_NAME', ' AS DATA_DATE_RULE', ' AS DAY_OFFSET', ' AS ROW_CNT', ' AS LAST_CREATED') if k == 0 else ('',) * 6
        br.append(f"SELECT {unit}{als[0]}, '{tab}'{als[1]}, {rule}{als[2]}, {off}{als[3]}, COUNT(*){als[4]}, MAX(CREATION_DATE){als[5]}\n"
                  f"          FROM {tab}{' WITH (NOLOCK)' if ms else ''} WHERE {cond}")
    inner = '\n         UNION ALL\n        '.join(br)
    date = ("CONVERT(CHAR(8), DATEADD(DAY, -X.DAY_OFFSET, CONVERT(DATE, @TEST_DATE, 112)), 112)" if ms else "TO_CHAR(TO_DATE(:TEST_DATE, 'YYYYMMDD') - X.DAY_OFFSET, 'YYYYMMDD')")
    return ("SELECT X.UNIT\n     , X.TABLE_NAME\n     , X.DATA_DATE_RULE\n     , " + date + " AS DATA_DATE\n     , X.ROW_CNT\n     , X.LAST_CREATED\n"
            "  FROM (" + inner + ") X")


