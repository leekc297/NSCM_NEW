    e.preventDefault(); e.stopPropagation(); var a = b.getAttribute('data-mv'), s = +p.dataset.s; p.dataset.user = '1';
    if (a === 'all') { apply(p, fitAll(p)); } else if (a === 'w') { apply(p, fitW(p)); port(p).scrollLeft = 0; } else if (a === '1') apply(p, 1);
