def timed_out(c):
    t = str(c.get("inline") or "")
    return "EXCEPTION" in t and bool(re.search(r"제한 시간|시간.{0,4}초과|timeout|timed out", t, re.I))


def grid_snap_form(host, form, rows=300):
    """열려 있는 팝업 폼의 그리드 값"""
    return grid_snap(host, rows=rows, form=form)


def grid_snap(host, rows=300, form="", raw=False):
    """화면 그리드의 현재 값(앞 rows 행) — {"그리드/시트": {"rows": 전체 행 수, "cols": [열 이름], "data": [[셀…]…]}} · form 을 주면 그 팝업 폼의 그리드"""
    kw = dict(rows=rows); 
    if form: kw["form"] = form
    if raw: kw["raw"] = "1"                                   # 표시 글자 옆에 셀의 원래 값("values")도 받는다
    try: d = host.send("dump", timeout=180, **kw).get("data") or {}
    except Exception: return {}
    out = {}
    for g in d.get("grids") or []:
        for sh in g.get("sheets") or []:
            cols = [(c.get("tag") or c.get("data_field") or c.get("label") or str(c.get("index"))) for c in sh.get("columns") or []]
            out["%s/%s" % (g.get("name"), sh.get("name"))] = {"rows": sh.get("rows"), "cols": cols, "data": sh.get("data") or []}
            if raw: out["%s/%s" % (g.get("name"), sh.get("name"))]["values"] = sh.get("values") or []
    return out


def grid_diff(a, b, cap=60):
    """버튼 전후 그리드 차이 — 행 수 변화와 바뀐 셀(행 번호·열 이름·전→후). 덤프한 앞쪽 행만 비교한다(한계)."""
    out = []
    for k in sorted(set(a) | set(b)):
        x, y = a.get(k), b.get(k)
        if x is None or y is None: out.append({"sheet": k, "change": "시트 %s" % ("생김" if x is None else "없어짐")}); continue
        e = {"sheet": k, "rows_before": x["rows"], "rows_after": y["rows"], "cells": [], "more": 0}
        for i in range(max(len(x["data"]), len(y["data"]))):
            ra = x["data"][i] if i < len(x["data"]) else None; rb = y["data"][i] if i < len(y["data"]) else None
            if ra == rb: continue
            if ra is None or rb is None:
                if len(e["cells"]) < cap: e["cells"].append({"row": i, "col": "(행)", "before": "없음" if ra is None else "있음", "after": "있음" if ra is None else "없음"})
                else: e["more"] += 1
                continue
            for j in range(max(len(ra), len(rb))):
                va = ra[j] if j < len(ra) else None; vb = rb[j] if j < len(rb) else None
                if va != vb:
                    if len(e["cells"]) < cap: e["cells"].append({"row": i, "col": y["cols"][j] if j < len(y["cols"]) else str(j), "before": va, "after": vb})
                    else: e["more"] += 1
        if e["cells"] or e["more"] or x["rows"] != y["rows"]: out.append(e)
    return out


def sweep(host, out, control):
    """떠 있는 팝업·예외 창을 닫고 목록을 돌려준다. 닫지 못한 창·메시지 상자가 남으면 out["restart"] 를 세운다."""
    try: sw = host.send("sweep", timeout=150)
    except Exception as ex: sw = {"ok": False, "error": str(ex)}
    if not sw.get("ok"):
        out["restart"] = True; out.setdefault("sweep_errors", []).append({"control": control, "error": str(sw.get("error"))[:200]}); return []
    if (sw.get("left") or 0) > 0 or (sw.get("dialogs_open") or 0) > 0:
        time.sleep(4)
        try: sw2 = host.send("sweep", timeout=150)
        except Exception: sw2 = {}
        sw["closed"] = (sw.get("closed") or []) + (sw2.get("closed") or [])
        if not sw2.get("ok") or (sw2.get("left") or 0) > 0 or (sw2.get("dialogs_open") or 0) > 0:
            out["restart"] = True; out.setdefault("sweep_errors", []).append({"control": control, "left": sw2.get("left"), "dialogs_open": sw2.get("dialogs_open")})
    return sw.get("closed") or []


def parse_preset(tok):
    """'이름=i2' → {"name","kind","arg","kw","label"} · 형식이 아니면 None"""
    m = re.match(r"^(\w+)=(i\d+|c[TF]|k\d+)$", tok.strip())
    if not m: return None
    n, v = m.group(1), m.group(2)
    if v[0] == "i": return {"name": n, "token": tok.strip(), "kw": dict(name=n, index=v[1:]), "label": "%s 콤보 %s번째 항목" % (n, v[1:])}
    if v[0] == "c": return {"name": n, "token": tok.strip(), "kw": dict(name=n, prop="Checked", value="True" if v[1] == "T" else "False"), "label": "%s 체크 %s" % (n, "켬" if v[1] == "T" else "끔")}
    return {"name": n, "token": tok.strip(), "kw": dict(name=n, check=v[1:], only="1"), "label": "%s 체크 목록 %s번째만 체크" % (n, v[1:])}


def apply_preset(host, out, preset):
    """조회 조건 값을 정해 놓는다(조회 전). 채움 규칙이 되돌리지 않도록 잠근다. 적용 뒤 그 컨트롤의 값·글자·체크를 읽어 적는다(조건식의 값과 맞춰 보는 근거). 반환 True = 적용됨"""
    real = next((c.get("name") for c in F.raw(host) if str(c.get("name") or "").lower() == preset["name"].lower()), None)
    if not real: out["preset"] = dict(preset, ok=False, error="화면에 보이는 컨트롤이 아님"); return False
    kw = dict(preset["kw"], name=real); t = R.now(); r = host.send("set", timeout=120, **kw); R.wait_quiet(t, 2, 60); F.LOCK.add(real)
    c = next((c for c in F.raw(host) if c.get("name") == real), {})
    out["preset"] = dict(preset, name=real, kw=kw, ok=bool(r.get("ok")), error=r.get("error"), applied=r.get("applied"),
                         value=str(c.get("control_values") or ""), text=str(c.get("text") or "")[:80], checked=c.get("checked"), selected_index=c.get("selected_index"))
    return bool(r.get("ok"))


def run_screen(host, mid, group, edit=False, only=None, division="", group_run=False, preset=None):
    group_run = bool(group_run or preset)                    # 조건 값을 정한 실행도 조회 자체가 관찰 대상이고, 이미 누른 버튼을 그 조건으로 다시 누른다
    todo, skipped = plan(mid)
    if only is not None:                                     # 수정 모드 재실행: 지정한 버튼만(실행 여부와 무관하게 다시 누른다)
        todo = [{"control": c, "scenarios": ids_of(mid, c)} for c in only]
    if (division or group_run) and only is None:             # Division·그룹을 바꿔 실행: 이미 실행된 버튼도 그 조건으로 다시 누른다
        todo = [{"control": c, "scenarios": ids_of(mid, c)} for c in sorted({t["control"] for t in todo} | set(pressed_before(mid)))]
    out = {"id": mid, "group": group, "edit": edit, "division": division, "acts": [], "skipped": skipped, "at": R.ts(R.now()) if hasattr(R, "ts") else ""}
    if not todo and not division and not group_run: out["note"] = "누를 버튼 없음"; return out, []
    sweep(host, out, None)                                   # 앞 화면이 남긴 창이 있으면 먼저 닫는다
    if out.get("restart"): out["error"] = "시작 전 남은 창을 닫지 못함"; return out, []
    r = host.send("open", timeout=180, id=mid)
    if not r.get("ok"): out["error"] = "화면 열기 실패: %s" % r.get("error"); out["restart"] = True; return out, []
    R.wait_quiet(R.now(), 3, 60)
    F.LOCK.clear()
    if division:
        if not set_division(host, out, division):
            host.send("close_screen", timeout=60); sweep(host, out, None)
            out["note"] = out.get("division_note") or ("Division %s 설정 실패: %s" % (division, (out.get("division_set") or {}).get("error"))); return out, []
    if preset:
        if not apply_preset(host, out, preset):
            host.send("close_screen", timeout=60); sweep(host, out, None)
            out["note"] = "조건 값 설정 실패(%s): %s" % (preset["token"], (out.get("preset") or {}).get("error")); return out, []
        print("   조건 %s → 값 '%s' 글자 '%s'" % (preset["label"], out["preset"].get("value"), out["preset"].get("text")), flush=True)
    try: fills, left = F.prefill(host, mid)
    except Exception as ex: fills, left = [], [str(ex)[:150]]
    out["fills"] = len(fills); out["fill_left"] = left
    t0 = R.now(); d0f = len((host.send("dialogs", timeout=30).get("dialogs") or [])); host.send("find", timeout=60); R.wait_find(host, t0, 0, 300)
    calls0 = []
    if division or group_run:
        # Division·그룹을 바꾼 실행은 조회 자체가 관찰 대상이다(조회 SP 인자·건수, 메시지) — 누를 버튼이 없는 화면도 이 기록은 남긴다
        n0, _s0 = R.db_inflight()
        if n0: R.wait_db_clear(900)
        calls0 = R.parse_dbprofile(t0, R.now())
        for c in calls0: c["phase"] = "find"
        dlf = (host.send("dialogs", timeout=30).get("dialogs") or [])[d0f:]
        out["acts"].append({"control": "(조회)", "kind": "find", "ok": True, "error": None, "popups": [], "dialogs": [{"text": (x.get("text") or "")[:200], "action": x.get("action")} for x in dlf],
                            "calls": [c.get("sp") for c in calls0 if "UP_FX_" not in str(c.get("sp"))][:20], "rows": [(c.get("sp"), c.get("rows")) for c in calls0 if "UP_FX_" not in str(c.get("sp")) and " " not in str(c.get("sp"))][:20],
                            "asis_timeout": sorted({str(c.get("sp")) for c in calls0 if timed_out(c)}), "scenarios": []})
        print("   (조회) · 호출 %d · 메시지 %d" % (len(calls0), len(dlf)), flush=True)
    if edit:
        # AS-IS 는 수정 모드(Edit F2)를 켜야 입력 버튼 분기가 실행된다(BaseForm.OnClickEditButton — 화면 상태만 바꾼다).
