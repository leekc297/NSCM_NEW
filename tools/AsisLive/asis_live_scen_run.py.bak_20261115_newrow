                    kd = ("states" if states else "pick") + ("_edit" if cedit else "")
                    d = P("Doc", "asislive", mid, "run_%s_acts_%s" % (time.strftime("%Y%m%d_%H%M%S"), kd)); os.makedirs(d, exist_ok=True)
                    json.dump({"calls": calls}, open(os.path.join(d, "calls.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1, default=str)
                    json.dump(out, open(os.path.join(d, "acts.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1, default=str)
                    json.dump({"id": mid, "group": cur, "kind": "acts_" + kd, "acts": len(out["acts"])}, open(os.path.join(d, "run.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1)
                    print("   %s · %s" % (kd, out.get("error") or out.get("note") or R.rel(d)), flush=True)
