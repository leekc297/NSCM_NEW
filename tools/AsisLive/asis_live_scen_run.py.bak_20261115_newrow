def screen_src_file(mid):
    """화면 메인 원문 .cs: 메뉴 ClassName 의 클래스 이름 파일(<클래스>.cs, Designer 제외).
    사본이 여럿이면 ProgramPath 가 화면 전용 DLL(경로에 \\ 포함)일 때 <ID>_*.UIL 폴더, 아니면 ProgramPath DLL 이름의 프로젝트 폴더. 메뉴 정보가 없으면 <ID>_*.cs 중 화면 폴더 우선"""
    pi = program_info(mid); cls = (pi.get("cls") or "").split(".")[-1]
    fs = [f for f in glob.glob(P("GSCM", "06.UIL", "**", (cls or mid + "_*") + ".cs"), recursive=True) if not f.endswith(".Designer.cs")]
    if cls and not fs:
        fs = [f for f in glob.glob(P("GSCM", "06.UIL", "**", mid + "_*.cs"), recursive=True) if not f.endswith(".Designer.cs") and re.search(r"partial\s+class\s+%s\b" % re.escape(cls), _src_text(os.path.basename(f)))]
    path = (pi.get("path") or "").replace("/", "\\"); proj = os.path.splitext(os.path.basename(path))[0].upper()
    def rank(f):
        parts = [x.upper() for x in f.replace("/", "\\").split("\\")]
        if "\\" in path: return (0 if any(x.startswith(mid.upper() + "_") for x in parts[-3:-1]) else 1, len(f))
        if proj: return (0 if proj in parts else 1, len(f))
        return (0 if os.path.basename(os.path.dirname(f)).upper().startswith(mid.upper() + "_") else 1, len(f))
    fs.sort(key=rank)
    return fs[0] if fs else None


def _method_body(t, name):
    """메서드 본문(중괄호 안)과 시작 줄 번호 — 없으면 (None, None)"""
    m = re.search(r"(?:override|private|protected|public)[^\n;{]*\b%s\s*\([^)]*\)\s*\{" % re.escape(name), t)
    if not m: return None, None
    i = m.end(); dep = 1; j = i
    while j < len(t) and dep:
        if t[j] == "{": dep += 1
        elif t[j] == "}": dep -= 1
        j += 1
    return t[i:j - 1], t.count("\n", 0, m.start()) + 1


def _code_only(b):
    b = re.sub(r"/\*.*?\*/", "", b or "", flags=re.S); b = re.sub(r"//[^\n]*", "", b)
    return b.strip()


def insert_targets(mid):
    """행 추가 원문 분석 → {"file", "exists", "evidence", "targets": [{"si", "grid", "sheet_key", "sheet_name", "line"}]}"""
    f = screen_src_file(mid); o = {"file": f, "exists": False, "targets": []}
    if not f: o["evidence"] = "원문 없음"; return o
    t = io.open(f, encoding="utf-8-sig", errors="replace").read(); rel = os.path.relpath(f, P())
    b, ln = _method_body(t, "InsertButton")
    if b is None: o["evidence"] = "%s: InsertButton 오버라이드 없음(BaseForm 빈 virtual)" % rel; return o
    code = _code_only(b)
    if not code: o["evidence"] = "%s:%d InsertButton 본문 비어 있음(주석만)" % (rel, ln); return o
    bodies = [(b, ln)]
    for cm in re.findall(r"\b(\w+)\s*\(\s*\)\s*;", code):
        if cm in ("InsertButton",): continue
        b2, l2 = _method_body(t, cm)
        if b2 is not None: bodies.append((b2, l2))
    has_code = lambda x: bool(_code_only(x)) and not re.fullmatch(r"(?:[\w.]+\s*\(\s*\)\s*;\s*)+", _code_only(x))
    if not any(has_code(x) for x, _ in bodies):
        o["evidence"] = "%s:%d InsertButton 본문에 행 추가 코드 없음(호출 메서드 %s)" % (rel, ln, ", ".join("%d행" % l for _, l in bodies[1:]) or "없음"); return o
    o["exists"] = True; o["evidence"] = "%s:%d InsertButton" % (rel, ln)
    for x, l0 in bodies:
        xc = _code_only(x)
        for m in re.finditer(r"\b(si\w+)\s*\.\s*ActiveSheet\s*\.\s*SheetName\s*==\s*(?:SpdSheet\s*\.\s*)?(sht\w+)", xc):
            si, key = m.group(1), m.group(2)
            if any(z["si"] == si and z["sheet_key"] == key for z in o["targets"]): continue
            o["targets"].append({"si": si, "grid": "spd" + si[2:], "sheet_key": key, "sheet_name": sheet_const(mid, key), "body_line": l0})
    return o


