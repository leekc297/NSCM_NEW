    return out, []


RX_SHEET = re.compile(r"(\w+)(?:\.ActiveSheet)?\.SheetName\s*==\s*SpdSheet\.(\w+)")
RX_COLEQ = re.compile(r"e\.Column\s*==\s*\w+\.GetColumnIndex\(DefColumns\.(\w+)\)")
RX_COLAFTER = re.compile(r"e\.Column\s*>=?\s*\w+\.GetColumnIndex\(DefColumns\.(\w+)\)\s*\+\s*1")
RX_ROWEQ = re.compile(r"Get(?:Text|Value)\(e\.Row,\s*\w+\.GetColumnIndex\(DefColumns\.(\w+)\)\)(?:\.ToString\(\))?\s*(==|!=)\s*\"([^\"]*)\"")


_SRC_CACHE = {}


def _src_text(fn):
    """AS-IS 원문 .cs (06.UIL 아래 파일 이름으로 찾음 · 원문 그대로)"""
    if fn in _SRC_CACHE: return _SRC_CACHE[fn]
    hit = glob.glob(P("GSCM", "06.UIL", "**", fn), recursive=True)
    t = ""
    if hit:
        try: t = io.open(hit[0], encoding="utf-8-sig", errors="replace").read()
        except Exception: t = ""
    _SRC_CACHE[fn] = t; return t


def expand_guard(r):
    """잘린 조건 구간 복원(11-15): '…' 로 끝난 구간을 원문에서 찾아 괄호 짝이 맞을 때까지 잇는다.
    같은 앞부분이 여러 번 나오면 시나리오 src 줄 이전의 가장 가까운 위치를 쓴다. 못 찾으면 그대로 둔다"""
    g = r.get("guard") or ""
    if "…" not in g: return g
    sp = (r.get("src") or "").split(":"); fn = sp[0].strip()
    try: ln = int(re.match(r"\d+", sp[1]).group(0)) if len(sp) > 1 else 10 ** 9
    except Exception: ln = 10 ** 9
    t = _src_text(fn) if fn else ""
    if not t: return g
    segs = [x.strip() for x in g.split("▸")]
    for n, sg in enumerate(segs):
        if not (sg.endswith("…)") or sg.endswith("…")): continue
        head = sg.rstrip(")").rstrip("…")
        head = re.sub(r"^else of\s*\(?\s*", "", head)
        if "if (" in head: head = head[head.find("if ("):]
        rx = re.compile(r"\s*".join(re.escape(w) for w in head.split()))
        best = None
        for m in rx.finditer(t):
            l = t.count("\n", 0, m.start()) + 1
            if l <= ln: best = m
        if best is None: continue
        st = t.find("(", best.start()); dep = 0; e = st
        while 0 <= e < len(t):
            if t[e] == "(": dep += 1
            elif t[e] == ")":
                dep -= 1
                if dep == 0: break
            e += 1
        if dep == 0: segs[n] = ("else of " if sg.startswith("else of") else "") + re.sub(r"\s+", " ", t[best.start():e + 1])
    return " ▸ ".join(segs)


def dbl_plan(mid):
    """더블클릭 분기마다 누를 대상(11-15): {grid, sheet_key, col, col_after, row_conds, ids, rule}. 'else of' 구간의 조건은 부정이므로 대상 조건으로 쓰지 않는다"""
    sc = rd(P("Doc", "asislive", mid, "scenarios_cov.csv")) or rd(P("Doc", "asislive", mid, "scenarios_src.csv")); plans = {}
    for r in sc:
        grids = []
        for e in [x.strip() for x in (r.get("entry") or "").split("|") if x.strip()]:
            m = CELLEV.match(e)
            if m and m.group(2) == "CellDoubleClick": grids.append(m.group(1)[:1].lower() + m.group(1)[1:])
        if not grids: continue
        segs = [x.strip() for x in expand_guard(r).split("▸")]
        pos = " ▸ ".join(x for x in segs if not x.startswith("else of"))
        skl = RX_SHEET.findall(pos); ce = RX_COLEQ.findall(pos); ca = RX_COLAFTER.findall(pos); rc = RX_ROWEQ.findall(pos)
        cols = [(c, False) for c in ce[:3]] + [(c, True) for c in ca[:1]] or [(None, False)]
        for g in sorted(set(grids)):
            # 시트 조건은 그 그리드의 것만(siDetail.ActiveSheet.SheetName → spdDetail · 11-15 SSP0021/23)
            sk = [x[1] for x in skl if re.sub(r"^(si|spd|fp)", "", x[0], flags=re.I).lower() == re.sub(r"^(si|spd|fp)", "", g, flags=re.I).lower()]
            for c, after in cols:
                k = (g, sk[-1] if sk else "", c or "", after, tuple(sorted(set(rc))))
                d = plans.setdefault(k, {"grid": g, "sheet_key": k[1], "sheet_name": sheet_const(mid, k[1]) if k[1] else None, "col": c, "col_after": after, "row_conds": list(k[4]), "ids": [], "has_else": any(x.startswith("else of") for x in segs)})
                if r["scenario_id"] not in d["ids"]: d["ids"].append(r["scenario_id"])
    # 메인 그리드 먼저(상세 그리드는 메인 더블클릭 뒤에 채워지는 화면이 있다 · SSP0021/SSP0023)
    return sorted(plans.values(), key=lambda x: (0 if x["grid"].lower().endswith("main") else 1, x["grid"], x["col"] is None, x["col"] or ""))


def _norm(x): return re.sub(r"[^a-z0-9]", "", (x or "").lower())


def sheet_const(mid, key):
    """SpdSheet 상수 → 시트 이름(11-15): 화면 원문(06.UIL 아래 <ID>*.cs)에서 'key = "이름"' 을 찾는다. 못 찾으면 None"""
    for f in glob.glob(P("GSCM", "06.UIL", "**", mid + "*.cs"), recursive=True):
        t = _src_text(os.path.basename(f))
        m = re.search(r"\b%s\s*=\s*\"([^\"]+)\"" % re.escape(key), t)
        if m: return m.group(1)
    return None


def resolve_target(d, t, used_cols):
    """dump 결과에서 대상 셀 찾기 → (gs, row, [열…], 사유). 못 찾으면 row=None"""
    gl = [g for g in (d.get("grids") or []) if (g.get("name") or "").lower() == t["grid"].lower()] or [g for g in (d.get("grids") or []) if any(sh.get("data") for sh in g.get("sheets") or [])][:1]
    if not gl: return None, None, [], "그리드 %s 없음" % t["grid"]
    g = gl[0]; shs = g.get("sheets") or []; si = None
    if t["sheet_key"]:
        kk = _norm(re.sub(r"^sht", "", t["sheet_key"])); kc = _norm(t.get("sheet_name") or "")
        for i, sh in enumerate(shs):
            if kc and _norm(sh.get("name")) == kc: si = i; break
        if si is None:
            for i, sh in enumerate(shs):
                if _norm(sh.get("name")) == kk or kk in _norm(sh.get("name")): si = i; break
        if si is None: return None, None, [], "시트 %s 못 찾음(시트 %s)" % (t["sheet_key"], [sh.get("name") for sh in shs])
    else:
        act = g.get("active_sheet_index")
        try: act = int(act)
        except Exception: act = 0
        si = act if act < len(shs) and (shs[act].get("data") or []) else next((i for i, sh in enumerate(shs) if sh.get("data")), act if act < len(shs) else 0)
    sh = shs[si]; cols = sh.get("columns") or []; data = sh.get("data") or []
    gs = {"grid": g.get("name") or "", "sheet": str(si)}
    if not data: return gs, None, [], "%s/%s 행 없음" % (g.get("name"), sh.get("name"))
    tag = lambda c: (c.get("tag") or c.get("data_field") or c.get("label") or str(c.get("index")))
    ix = {tag(c).upper(): n for n, c in enumerate(cols)}
    vis = lambda c: str(c.get("visible")) == "True" and float(c.get("width") or 0) > 1
    row = None; why = []
    for rn, rv in enumerate(data):
        ok = True
        for cn, op, val in t["row_conds"]:
            n = ix.get(cn.upper())
            if n is None: why.append("행 조건 열 %s 없음" % cn); continue
            v = str(rv[n] if n < len(rv) else "").strip()
            if (op == "==" and v != val) or (op == "!=" and v == val): ok = False; break
        if ok: row = rn; break
    if row is None: return gs, None, [], "행 조건 %s 를 만족하는 행 없음(앞 %d행)" % (t["row_conds"], len(data))
    if t["col"]:
        n = ix.get(t["col"].upper())
        if n is None: return gs, None, [], "열 %s 없음" % t["col"]
        if t["col_after"]:
            # 사용자는 값이 있는 칸을 누른다: 그 행에서 열 다음의 보이는 열 중 값이 있는(0 아님) 첫 열. 없으면 첫 보이는 열
            vk = [k for k in range(n + 1, len(cols)) if vis(cols[k])]
            if not vk: return gs, None, [], "열 %s 다음 보이는 열 없음" % t["col"]
            rv = data[row]; nz = [k for k in vk if k < len(rv) and str(rv[k]).strip() not in ("", "0", "0.0", "-")]
            n2 = (nz or vk)[0]
            return gs, row, [cols[n2]], "열 %s 다음 열 중 %s" % (t["col"], "값 있는 첫 열" if nz else "첫 열(값 있는 칸 없음)")
        if not vis(cols[n]): return gs, None, [], "열 %s 숨김" % t["col"]
        return gs, row, [cols[n]], "열 %s" % t["col"]
    vl = [c for c in cols if vis(c) and tag(c) not in used_cols]
    return gs, row, vl[:6], "열 조건 없는 분기: 앞쪽 보이는 열 6개"


