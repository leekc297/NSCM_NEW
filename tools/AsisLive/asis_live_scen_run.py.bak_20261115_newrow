GS = {}   # 셀 클릭·셀 상태에 넘길 그리드·시트(행이 있는 시트가 첫 그리드의 활성 시트가 아닐 때만 채운다)


def data_sheet(d):
    """dump 결과에서 행이 있는 시트 고르기(11-15): 첫 그리드 활성 시트에 행이 있으면 그대로(GS 비움), 아니면 행이 있는 첫 시트를 grid·sheet 로 지정.
    반환 (그리드 이름, 시트, GS)"""
    first = None; hit = None
    for gi, g in enumerate(d.get("grids") or []):
        act = g.get("active_sheet_index")
        for i, sh in enumerate(g.get("sheets") or []):
            if first is None and (act in (None, "", i) or str(act) == str(i)): first = (g.get("name") or "", sh)
            if hit is None and (sh.get("data") or []): hit = (gi, g.get("name") or "", i, sh, str(act) == str(i))
    if hit is None: return (first or ("", None))[0], (first or ("", None))[1], {}
    gi, gname, i, sh, is_act = hit
    if gi == 0 and is_act: return gname, sh, {}
    return gname, sh, {"grid": gname, "sheet": str(i)}


def focus_grid(host, vis=None):
    """수정 버튼 전 셀 1회 클릭(11-15): 사용자는 셀을 누른 뒤 수정 버튼을 누른다. AS-IS BaseForm 은 셀 클릭(FpSpread_CellClick)에서 fps 를 채우고,
    화면 EditButton 은 fps 가 있어야 시트 잠금을 푼다(SSP0014_ShipmentModelPIC.cs:267). 행이 없으면 누르지 않는다."""
    if vis is None:
        d = host.send("dump", timeout=180, rows=1).get("data") or {}; _g, sheet, gs = data_sheet(d); GS.clear(); GS.update(gs)
        if not sheet or not (sheet.get("data") or []): return "행 없음"
        vis = [c for c in (sheet.get("columns") or []) if str(c.get("visible")) == "True" and float(c.get("width") or 0) > 1]
    for c in (vis or [])[:4]:
        r = host.send("act", timeout=60, cell="0,%s" % c.get("index"), double="0", wait=2, **GS)
        if r.get("ok"): return "셀 0,%s" % c.get("index")
    return "누르지 못함"


def apply_data_cond(host, mid, out):
    """Doc/asislive/<ID>/data_cond.json {"set": [{name, value|index|check(+only)|prop}], "src", "why"} → 조회 전 조건 넣기. 넣은 결과를 out["data_cond"] 에 남긴다"""
    f = P("Doc", "asislive", mid, "data_cond.json")
    if not os.path.exists(f): return
    try: j = json.load(open(f, encoding="utf-8"))
    except Exception as e: out["data_cond"] = {"error": "data_cond.json 읽기 실패: %s" % e}; return
    done = []
    for st in j.get("set") or []:
        kw = {k: str(v) for k, v in st.items() if k in ("name", "value", "index", "check", "only", "prop", "call", "uncheck_all")}
        r = host.send("set", timeout=60, **kw); done.append({"set": kw, "ok": bool(r.get("ok")), "applied": r.get("applied"), "error": r.get("error")})
        tw = R.now(); time.sleep(float(st.get("wait") or 1)); R.wait_quiet(tw, 2, 60)   # 값 변경 이벤트가 목록을 다시 불러오는 시간
    out["data_cond"] = {"src": j.get("src"), "why": j.get("why"), "done": done}
    print("   데이터 조건 %s" % ", ".join("%s=%s%s" % (d["set"].get("name"), d.get("applied"), "" if d["ok"] else " 실패 " + str(d.get("error"))[:60]) for d in done), flush=True)


