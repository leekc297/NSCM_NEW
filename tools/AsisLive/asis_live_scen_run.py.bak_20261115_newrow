        if not R.acquire_lock("groups"): print("[ERROR] 다른 AS-IS 실측이 끝나지 않음"); return 3
        host, info, why = R.start_session(P("Doc", "asislive", "_cmd_groups_" + time.strftime("%H%M%S")))
        if host is None: print("[ERROR] 런처 세션 시작 실패: %s" % why); return 3
        try:
            g = host.send("group", timeout=60)
            print("계정 %s · 현재 그룹 %s · 메뉴 %s개" % (info.get("user_id"), g.get("current"), (info.get("main") or {}).get("menu_count")))
            for it in g.get("items") or []: print("   %s%s" % (it.get("code"), "" if it.get("code") == it.get("name") else " (%s)" % it.get("name")))
            json.dump({"at": time.strftime("%Y-%m-%d %H:%M:%S"), "user_id": info.get("user_id"), "current": g.get("current"), "items": g.get("items")}, open(P("Doc", "asislive", "_groups.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1)
            print("@@LINK 📄 그룹 목록|Doc/asislive/_groups.json")
        finally:
            try: host.send("quit", timeout=30)
            except Exception: pass
        return 0
    if not ids: print("사용: asis_live_scen_run.py <ID> [ID ...] [--group 그룹]"); return 2
    divs = [""]
    if "--division" in av:
        dv = av[av.index("--division") + 1] if av.index("--division") + 1 < len(av) else ""
        rest = [a for a in rest if a != dv]; ids = [a.upper() for a in rest if not a.startswith("-")]
        divs = [x.strip() for x in dv.split(",") if x.strip()] or [""]
    presets = [None]
    if "--preset" in av:
        pv = av[av.index("--preset") + 1] if av.index("--preset") + 1 < len(av) else ""
        rest = [a for a in rest if a != pv]; ids = [a.upper() for a in rest if not a.startswith("-")]
        presets = [parse_preset(x) for x in pv.split(";") if x.strip()]
        if not presets or any(x is None for x in presets): print("[ERROR] --preset 형식: 이름=iN | 이름=cT | 이름=cF | 이름=kN (여러 개는 ; 로 나눔)"); return 2
    conds = "--conds" in av; cells = "--cells" in av; states = "--states" in av; picks = "--pick" in av; inserts = "--insert" in av; violates = "--violate" in av
    edit = "--edit" in av
    if edit and not any(need_edit(m) for m in ids):
        for m in ids: print("[%s] 수정 모드에서 다시 누를 버튼 없음(직전 실행에 수정 모드 메시지 없음) — 런처를 띄우지 않음" % m)
        return 0
    if conds and not any(cond_targets(m) for m in ids):
        for m in ids: print("[%s] 값 변경 이벤트 분기 없음 — 런처를 띄우지 않음" % m)
        return 0
    if cells and not any(cell_targets(m) for m in ids):
        for m in ids: print("[%s] 셀 클릭·더블클릭 분기 없음 — 런처를 띄우지 않음" % m)
        return 0
    if picks and not any(cell_targets(m).get("dbl") for m in ids):
