    calls = list(calls0); xb = X.snap()                      # 지금 떠 있는 Excel = 사용자 것(닫지 않을 기준)
    for it in todo:
        g0 = grid_snap(host) if edit else {}                 # 수정 모드: 버튼이 화면 안 값만 바꾸는 경우가 있어 전후 그리드를 비교한다
        t1 = R.now(); d0 = len((host.send("dialogs", timeout=30).get("dialogs") or []))
