            t1b = R.now(); r = host.send("act", timeout=120, click=it["control"], wait=8); R.wait_quiet(t1b, 3, 120)
            n, _sec = R.db_inflight()
            if n: R.wait_db_clear(900)
            cs2 = R.parse_dbprofile(t1b, R.now()); cs = cs + cs2
            tmo = [c.get("sp") for c in cs2 if timed_out(c)]
        for c in cs: c["phase"] = "action:" + it["control"]
        calls += cs
        late = sweep(host, out, it["control"])               # 늦게 뜬 팝업·예외 창까지 기록하고 닫는다(11-13 창 쌓임 결함 보정)
        if late: r["popups"] = (r.get("popups") or []) + [dict(p, late=True) for p in late]
        gd = grid_diff(g0, grid_snap(host)) if edit and not out.get("restart") else []
        xr = X.close_new(xb, X.host_pids())                  # 이 버튼이 띄운 Excel: 문서 이름·시트 행 수 기록 뒤 닫기(사용자 문서는 유지)
        dl = (host.send("dialogs", timeout=30).get("dialogs") or [])[d0:]
        out["acts"].append({"control": it["control"], "ok": bool(r.get("ok")), "error": r.get("error"), "popups": r.get("popups"), "dialogs": [{"text": (x.get("text") or "")[:200], "action": x.get("action")} for x in dl],
                            "calls": [c.get("sp") for c in cs if "UP_FX_" not in str(c.get("sp"))][:20], "scenarios": it["scenarios"], "retried": retried, "asis_timeout": sorted(set(str(x) for x in tmo)),
                            "grid_changes": gd, "excel": xr.get("closed") or [], "excel_left": xr.get("left") or [], "excel_error": xr.get("error")})
