        return 0
    if not conds and not cells and not states and not picks and not inserts and not violates and not edit and divs == [""] and presets == [None] and not group and not any(plan(m)[0] for m in ids):
        for m in ids: print("[%s] 누를 버튼 없음 · 건너뛴 버튼 %d — 런처를 띄우지 않음" % (m, len(plan(m)[1])))
