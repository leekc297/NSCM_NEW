        if retried: print("      서버 호출 시간 초과 → 다시 누름 · %s" % ("이번에는 정상" if not tmo else "다시 초과 — AS-IS 조회 불가: " + ", ".join(sorted(set(str(x) for x in tmo)))), flush=True)
        if gd: print("      그리드 변화: " + " ; ".join("%s 행 %s→%s · 바뀐 셀 %d%s" % (g.get("sheet"), g.get("rows_before"), g.get("rows_after"), len(g.get("cells") or []), ("+" + str(g["more"])) if g.get("more") else "") if "cells" in g else "%s %s" % (g["sheet"], g["change"]) for g in gd)[:300], flush=True)
        if out.get("restart"): print("   남은 창을 닫지 못함 → 이 화면 중단 · 런처 다시 시작", flush=True); break
    if not out.get("restart"):
        d0c = len((host.send("dialogs", timeout=30).get("dialogs") or []))
        if edit: host.send("policy", timeout=30, dialogs="close")      # "이 화면을 닫으시겠습니까?"(MSG00013)에만 예 = 저장 없이 닫기 · 저장 확인류는 아니오
        cr = host.send("close_screen", timeout=60); time.sleep(2 if edit else 0)
        if edit and (cr.get("open_screens") or 0) != 0: cr = host.send("close_screen", timeout=60)
        sweep(host, out, None)
        out["close"] = {"open_screens": cr.get("open_screens"), "dialogs": [{"text": (x.get("text") or "")[:200], "action": x.get("action")} for x in (host.send("dialogs", timeout=30).get("dialogs") or [])[d0c:]]}
        if edit and (cr.get("open_screens") or 0) != 0: out["restart"] = True; out.setdefault("sweep_errors", []).append({"control": "close_screen", "open_screens": cr.get("open_screens")})
    if edit:
        try: host.send("policy", timeout=30, dialogs="default")
        except Exception: pass
    time.sleep(2); xr = X.close_new(xb, X.host_pids())      # 늦게 뜬 Excel
    if xr.get("closed") or xr.get("left"): out["excel_late"] = xr.get("closed") or []; out["excel_left"] = xr.get("left") or []
    return out, calls


def main():
    av = sys.argv[1:]; gtok = []
    if "--group" in av:                                      # 그룹 이름에 공백이 있다("SCP Planner") — VM 은 입력값을 공백으로 쪼개 넘기므로 다음 옵션 전까지를 이어 붙인다
        i = av.index("--group") + 1
        while i < len(av) and not av[i].startswith("--"): gtok.append(av[i]); i += 1
    group = " ".join(gtok).strip()
    if group in ("-", "현재", "(현재)"): group = ""
    rest = list(av)
    for g in gtok: rest.remove(g)
    ids = [a.upper() for a in rest if not a.startswith("-")]
