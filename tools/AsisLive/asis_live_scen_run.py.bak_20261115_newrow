# -*- coding: utf-8 -*-
"""소스 분기 시나리오 실행 — 화면 안 버튼으로 타는 조회·팝업 분기 (2026-11-13 · 플랜 P6-2 1단계)

  python tools/AsisLive/asis_live_scen_run.py <ID> [ID ...] [--group SCP Planner]     (그룹 이름은 따옴표 없이 띄어 써도 된다 · 실행 뒤 그룹을 되돌리지는 않는다 — 다음 세션은 런처 기본 그룹으로 시작)
  python tools/AsisLive/asis_live_scen_run.py <ID> --edit      (직전 실행에서 "수정모드가 아니므로 …" 메시지를 낸 버튼만 수정 모드에서 다시 누른다 · 화면을 닫을 때 저장 확인은 "아니오")
  python tools/AsisLive/asis_live_scen_run.py <ID> --division 81,40 | all      (Division 조건을 바꿔 가며 버튼 분기를 다시 실행 — Division 별 시나리오 · all = 그 화면 목록 전부)
  python tools/AsisLive/asis_live_scen_run.py <ID> --preset "cboType=i2;chkGap=cT;clbBucket=k0"      (조회 조건 값을 정해 놓고 조회·버튼 분기를 다시 실행 — 항목마다 화면을 새로 연다 · iN = 콤보 N번째 항목, cT/cF = 체크 켬/끔, kN = 체크 목록 N번째만 체크 · 값은 asis_live_scen_values.py 가 도출)
  python tools/AsisLive/asis_live_scen_run.py <ID> --conds     (조건 컨트롤의 값 변경 이벤트로 타는 분기: 콤보·체크 상자·체크 목록 값을 바꿔 호출·메시지·다른 컨트롤 변화를 기록 · 저장 없음)
  python tools/AsisLive/asis_live_scen_run.py <ID> --cells     (그리드 셀 클릭·더블클릭 분기: 조회 뒤 첫 행에서 분기 조건식에 나온 열을 실제 마우스 클릭으로 누름 · 팝업·새 화면·호출 기록 · 저장 없음)
  python tools/AsisLive/asis_live_scen_run.py --groups-list                           (이 계정의 그룹 목록·현재 그룹 읽기)
대상  scenarios_cov.csv 에서 아직 실행 안 된 분기 중, 진입점이 **화면 안 버튼 Click** 이고 그 버튼에서 저장 계열 분기로 이어지지 않는 것.
        · 저장·삭제·업로드로 이어지는 버튼은 이 단계에서 누르지 않는다(저장 시나리오는 대상 행 기록·복원과 함께 따로 실행).
        · Excel·인쇄·파일 대화상자를 여는 버튼은 누르지 않는다(이름 규칙) — 건너뛴 버튼은 목록으로 남긴다.
순서  화면 열기 → 필수 조건 최근 값 채움 → 조회 → 버튼마다: 누르기 → 뜬 팝업 기록·닫기 → 그동안의 서버 호출 수집
산출  Doc/asislive/<ID>/run_<시각>_acts/  calls.json(구간 = action:<버튼>) · acts.json(버튼별 결과·팝업·대화상자) · run.json
      실행 뒤 asis_live_scen_cov.py 를 다시 돌리면 실행 현황에 반영된다.
"""
import io, glob
import csv, json, os, re, sys, time

HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
import asis_live_run as R
import asis_live_fill as F
import asis_live_excel as X

SAVE = re.compile(r"save|delete|insert|upload|confirm|copy|create|apply|release|approve|reject|import|send|interface|i/?f\b", re.I)
SKIPNAME = re.compile(r"excel|export|download|upload|print|file|import|report", re.I)
RISKY = re.compile(r"update|chg|change|calc|status|run|exec|engine|batch|close|cancel|reset|init|plan(?!date)|send|mail|sync|gen|make|fix|lock|open|start|stop|new|add|del|remove|clear|copy|apply|confirm|approve", re.I)   # 조회가 아닐 수 있는 버튼(이름 규칙) — 누르지 않고 목록으로 남긴다
P = lambda *a: os.path.join(R.ROOT, *a)


def rd(p):
    if not os.path.exists(p): return []
    with open(p, encoding="utf-8-sig", newline="") as f: return list(csv.DictReader(f))


def click_target(entry):
    """진입점 문자열에서 버튼 컨트롤 이름 — event:this.btnInput.Click · event:btnInput_Click"""
    m = re.match(r"^event:(?:this\.)?(\w+)\.Click$", entry) or re.match(r"^event:(\w+)_Click$", entry)
    return m.group(1) if m else None


def plan(mid):
    sc = rd(P("Doc", "asislive", mid, "scenarios_cov.csv")) or rd(P("Doc", "asislive", mid, "scenarios_src.csv"))
    by = {}
    for r in sc:
        for e in [x.strip() for x in (r.get("entry") or "").split("|") if x.strip()]:
            c = click_target(e)
            if not c: continue
            d = by.setdefault(c, {"types": set(), "eps": set(), "todo": 0, "ids": []})
            d["types"].add(r["type"]); d["eps"] |= set(filter(None, (r.get("endpoints") or "").split(";")))
            if r.get("cov", "NOT_EXECUTED") in ("NOT_EXECUTED", "NO_CALL_EVIDENCE") and r["scenario_id"] not in d["ids"]: d["todo"] += 1; d["ids"].append(r["scenario_id"])
    todo, skipped = [], []
    for c, d in sorted(by.items()):
        if d["todo"] == 0: continue
        if "저장" in d["types"] or any(SAVE.search(e) for e in d["eps"]) or SAVE.search(c): skipped.append({"control": c, "why": "저장 계열 분기로 이어짐", "scenarios": d["todo"]})
        elif SKIPNAME.search(c): skipped.append({"control": c, "why": "파일·Excel·인쇄 버튼(이름 규칙)", "scenarios": d["todo"]})
        elif RISKY.search(c): skipped.append({"control": c, "why": "상태 변경·실행 가능성(이름 규칙) — 확인 후 실행", "scenarios": d["todo"]})
        else: todo.append({"control": c, "scenarios": d["ids"]})
    return todo, skipped


def pressed_before(mid):
    """지금까지 버튼 실행에서 눌렀던 버튼 이름(수정 모드 제외)"""
    import glob
    out = []
    for d in sorted(glob.glob(P("Doc", "asislive", mid, "run_*_acts*"))):
        try: j = json.load(open(os.path.join(d, "acts.json"), encoding="utf-8"))
        except Exception: continue
        if j.get("edit") or j.get("cond") or j.get("cellrun"): continue
        out += [a.get("control") for a in j.get("acts") or [] if a.get("ok") and not str(a.get("control") or "").startswith("(")]      # "(조회)" 는 버튼이 아니다
    return sorted(set(x for x in out if x))


def ids_of(mid, control):
    sc = rd(P("Doc", "asislive", mid, "scenarios_cov.csv")) or rd(P("Doc", "asislive", mid, "scenarios_src.csv"))
    return [r["scenario_id"] for r in sc if any(click_target(e.strip()) == control for e in (r.get("entry") or "").split("|"))]


def need_edit(mid):
    """가장 최근 버튼 실행에서 "수정모드가 아니므로 …" 메시지를 낸 버튼 — 수정 모드에서 다시 눌러야 그 분기가 실행된다"""
    import glob
    ds = [d for d in sorted(glob.glob(P("Doc", "asislive", mid, "run_*_acts"))) if not json.load(open(os.path.join(d, "acts.json"), encoding="utf-8")).get("edit")]   # _acts 로 끝나는 폴더만(조건 변경·수정 모드 기록 제외)
    if not ds: return []
    j = json.load(open(os.path.join(ds[-1], "acts.json"), encoding="utf-8"))
    return [a["control"] for a in j.get("acts") or [] if any(re.search(r"수정\s*모드|edit\s*mode", (d.get("text") or ""), re.I) for d in a.get("dialogs") or [])]


def division_control(host):
    """화면의 Division 조회 조건 — (종류 "combo"|"checklist"|None, 컨트롤 이름, 항목 문자열 목록)"""
    st = F.state(host)
    dv = next((c for c in st if c["t"] == "UsrCombo" and (F.DIV.search(c["label"]) or re.search(r"division", c.get("name") or "", re.I))), None)
    if dv: return "combo", dv["name"], [str(x) for x in dv.get("items") or []]
    dl = next((c for c in st if c["t"].startswith("UsrCheckedList") and (F.DIV.search(c["label"]) or re.search(r"division", c.get("name") or "", re.I))), None)
    if dl:
        d = host.send("dump", timeout=120, rows=-1).get("data") or {}
        for c in d.get("controls") or []:
            if "/" + dl["name"] + "/" in (c.get("path") or "") and (c.get("type") or "").endswith("CheckedListBox"):
                return "checklist", dl["name"], [str(x.get("text")) for x in c.get("items") or []]
        return "checklist", dl["name"], []
    return None, None, []


def div_id(item):
    """항목 문자열("81 Automotive Battery" · "81_UC …")의 Division 코드"""
    return (item or "").strip().split(" ")[0]


def set_division(host, out, division):
    """Division 조건을 지정한 값으로 바꾼다(조회 전). 채움 규칙이 되돌리지 않도록 잠근다. 반환 True = 적용됨"""
    kind, name, items = division_control(host)
    out["division_control"] = {"kind": kind, "name": name, "items": [div_id(x) for x in items]}
    if not kind: out["division_note"] = "이 화면에 Division 조회 조건이 없음"; return False
    idx = next((i for i, x in enumerate(items) if div_id(x) == division), None)
    if idx is None: out["division_note"] = "Division %s 이 이 화면 목록에 없음(목록 %s)" % (division, ",".join(div_id(x) for x in items)); return False
    t = R.now()
    r = host.send("set", timeout=120, name=name, index=str(idx)) if kind == "combo" else host.send("set", timeout=120, name=name, check=str(idx), only="1")
    R.wait_quiet(t, 2, 60); F.LOCK.add(name)
    out["division_set"] = {"ok": bool(r.get("ok")), "applied": r.get("applied"), "error": r.get("error")}
    return bool(r.get("ok"))


CHG = re.compile(r"^event:(?:this\.)?(\w+)[._](SelectedIndexChanged|ComboSelChange|CheckedChanged|ValueChanged|TextChanged|ComboCloseUp|SelectionChanged|EditValueChanged|SelectedValueChanged)$")


def cond_targets(mid):
    """조건 컨트롤의 값 변경 이벤트로 타는 분기 — {컨트롤 이름: [시나리오 ID]} (소스 분기 목록 기준)"""
    sc = rd(P("Doc", "asislive", mid, "scenarios_cov.csv")) or rd(P("Doc", "asislive", mid, "scenarios_src.csv")); out = {}
    for r in sc:
        for e in [x.strip() for x in (r.get("entry") or "").split("|") if x.strip()]:
            m = CHG.match(e)
            if m: out.setdefault(m.group(1), []).append(r["scenario_id"])
    return out


def ctl_state(host):
    """보이는 컨트롤의 상태 요약 — {이름: (글자, 항목 수, 선택 순번, 체크, 활성, 표시, 값)} · 값 변경이 다른 컨트롤에 준 영향을 보려는 것"""
    out = {}
    for c in F.raw(host):
        k = c.get("path") or c.get("name")                      # 이름이 겹치는 안쪽 컨트롤(체크 목록의 목록 상자 등)이 있어 경로로 구분한다
        if not k: continue
        it = c.get("items") or []
        out[k] = (str(c.get("text") or "")[:60], c.get("item_count") if c.get("item_count") is not None else (len(it) if it else None), c.get("selected_index"),
                  c.get("checked") if c.get("checked") is not None else (sum(1 for x in it if isinstance(x, dict) and x.get("checked")) if it and isinstance(it[0], dict) else None),
                  c.get("enabled"), c.get("visible"), str(c.get("control_values") or "")[:80])
    return out


def run_conds(host, mid, group):
    """조건 값 변경 분기 실행 — 콤보는 다음 항목으로 바꿨다가 되돌리고, 체크 상자는 뒤집었다가 되돌리고, 체크 목록은 한 항목만 체크한다(되돌리지 않음 — 화면을 닫으므로).
    바꿀 때마다 서버 호출·메시지·다른 컨트롤의 변화(항목 수·값·활성)를 기록한다. 저장 버튼은 누르지 않는다."""
    tg = cond_targets(mid)
    out = {"id": mid, "group": group, "cond": True, "acts": [], "skipped": [], "at": time.strftime("%Y-%m-%d %H:%M:%S")}
    if not tg: out["note"] = "값 변경 이벤트 분기가 없는 화면"; return out, []
    sweep(host, out, None)
    r = host.send("open", timeout=180, id=mid)
    if not r.get("ok"): out["error"] = "화면 열기 실패: %s" % r.get("error"); out["restart"] = True; return out, []
    R.wait_quiet(R.now(), 3, 60); F.LOCK.clear()
    try: F.prefill(host, mid)
    except Exception: pass
    ctrls = {}; calls = []
    for c in F.raw(host):
        if c.get("name") and c.get("name").lower() not in ctrls: ctrls[c.get("name").lower()] = c     # 처리기 이름에서 읽은 컨트롤 이름은 대소문자가 다를 수 있다(CboDivision ↔ cboDivision)
    merged = {}
    for n, ids in tg.items():
        real = (ctrls.get(n.lower()) or {}).get("name") or n; merged.setdefault(real, [])
        merged[real] += [x for x in ids if x not in merged[real]]
    tg = merged; ctrls = {c["name"]: c for c in ctrls.values()}
    order = sorted(tg, key=lambda n: (0 if (ctrls.get(n) or {}).get("t") == "CheckBox" else 1 if (ctrls.get(n) or {}).get("t") == "UsrCombo" else 2, n))     # 체크 목록은 되돌리지 않으므로 맨 뒤
    for name in order:
        c = ctrls.get(name)
        if not c: out["skipped"].append({"control": name, "why": "화면에 보이는 컨트롤이 아님(다른 탭·팝업 안·숨김)", "scenarios": len(tg[name])}); continue
        t = c.get("t") or ""; steps = []
        if t == "UsrCombo":
            n = c.get("item_count") or 0; cur = c.get("selected_index") or 0
            if n < 2: out["skipped"].append({"control": name, "why": "콤보 항목이 %d개라 바꿀 값이 없음" % n, "scenarios": len(tg[name])}); continue
            steps = [("다음 항목(%d → %d)" % (cur, (cur + 1) % n), dict(name=name, index=str((cur + 1) % n))), ("원래 항목으로(%d)" % cur, dict(name=name, index=str(cur)))]
        elif t == "CheckBox":
            ck = bool(c.get("checked")); steps = [("체크 %s → %s" % (ck, not ck), dict(name=name, prop="Checked", value=str(not ck))), ("원래대로(%s)" % ck, dict(name=name, prop="Checked", value=str(ck)))]
        elif t.startswith("UsrCheckedList"):
            n, _k, _t = F.checked_list_items(host, name)
            if n < 1: out["skipped"].append({"control": name, "why": "체크 목록이 비어 있음", "scenarios": len(tg[name])}); continue
            steps = [("첫 항목만 체크(목록 %d개)" % n, dict(name=name, check="0", only="1"))]
        else:
            out["skipped"].append({"control": name, "why": "값을 고르는 규칙이 없는 컨트롤 형식(%s)" % t, "scenarios": len(tg[name])}); continue
        for label, kw in steps:
            s0 = ctl_state(host); d0 = len((host.send("dialogs", timeout=30).get("dialogs") or [])); t1 = R.now()
            rr = host.send("set", timeout=120, **kw); R.wait_quiet(t1, 2, 60)
            n2, _s = R.db_inflight()
            if n2: R.wait_db_clear(600)
            late = sweep(host, out, name); cs = R.parse_dbprofile(t1, R.now())
            for x in cs: x["phase"] = "action:set:" + name
            calls += cs; s1 = ctl_state(host)
            GEN = {"pnlMain", "clb", "cmb", "cbo", "chkAll", "txt", "pnl", "panel1"}                # 안쪽 부품 이름 — 바깥 컨트롤 이름으로 적는다
            nm = lambda k: next((x for x in reversed(k.strip("/").split("/")) if x not in GEN), k.strip("/").split("/")[-1]) + ("" if k.strip("/").split("/")[-1] not in GEN else "(" + k.strip("/").split("/")[-1] + ")")
            ch = [{"control": nm(k), "before": list(s0.get(k) or []), "after": list(s1.get(k) or [])}
                  for k in sorted(set(s0) | set(s1)) if not k.rstrip("/").endswith("/" + name) and ("/" + name + "/") not in k and s0.get(k) != s1.get(k)][:30]
            dl = (host.send("dialogs", timeout=30).get("dialogs") or [])[d0:]
            out["acts"].append({"control": name, "kind": "cond", "change": label, "ok": bool(rr.get("ok")), "error": rr.get("error"), "applied": rr.get("applied"),
                                "popups": [dict(p, late=True) for p in late], "dialogs": [{"text": (x.get("text") or "")[:200], "action": x.get("action")} for x in dl],
                                "calls": [x.get("sp") for x in cs if "UP_FX_" not in str(x.get("sp"))][:20], "asis_timeout": sorted({str(x.get("sp")) for x in cs if timed_out(x)}),
                                "changed_controls": ch, "scenarios": tg[name]})
            print("   %s · %s · %s · 호출 %d · 메시지 %d · 바뀐 컨트롤 %d%s" % (name, label, "적용" if rr.get("ok") else "실패", len(cs), len(dl), len(ch), (" — " + str(rr.get("error"))[:80]) if not rr.get("ok") else ""), flush=True)
            if out.get("restart"): break
        if out.get("restart"): print("   남은 창을 닫지 못함 → 이 화면 중단", flush=True); break
    if not out.get("restart"): host.send("close_screen", timeout=60); sweep(host, out, None)
    return out, calls


CELLEV = re.compile(r"^event:(?:this\.)?(\w+)[._](CellClick|CellDoubleClick)$")


def cell_targets(mid):
    """그리드 셀 클릭·더블클릭으로 타는 분기 — {"click"|"dbl": {"ids": [시나리오 ID], "text": 그 분기들의 조건식·관찰점 글자}}"""
    sc = rd(P("Doc", "asislive", mid, "scenarios_cov.csv")) or rd(P("Doc", "asislive", mid, "scenarios_src.csv")); out = {}
    for r in sc:
        for e in [x.strip() for x in (r.get("entry") or "").split("|") if x.strip()]:
            m = CELLEV.match(e)
            if m:
                d = out.setdefault("dbl" if m.group(2) == "CellDoubleClick" else "click", {"ids": [], "text": ""})
                if r["scenario_id"] not in d["ids"]: d["ids"].append(r["scenario_id"]); d["text"] += " " + (r.get("guard") or "") + " " + (r.get("observe") or "")
    return out


def cells_need_edit(mid):
    """셀 클릭 분기의 조건식에 잠금·수정 모드 조건이 있으면 수정 모드에서도 한 번 더 눌러야 한다"""
    return any(re.search(r"IsLock|IsEditMode", v["text"]) for v in cell_targets(mid).values())


def run_cells(host, mid, group, max_cols=12, edit=False):
    """셀 클릭·더블클릭 분기 실행 — 조회 뒤 첫 행에서, 분기 조건식에 이름이 나온 열(없으면 앞쪽 보이는 열)을 실제 마우스 클릭으로 누른다.
    뜨는 팝업·메시지·서버 호출·새로 열린 화면(드릴다운)·그리드 변화를 기록하고 닫는다. 수정 모드는 켜지 않는다(저장 없음)."""
    tg = cell_targets(mid)
