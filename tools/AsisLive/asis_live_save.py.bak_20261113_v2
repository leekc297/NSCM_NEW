            print("[3] 저장 호출 %d · 메시지 %s · DB 행 %d → %d · 값 %s → %s" % (len(sv), [x["text"][:40] for x in out["save_dialogs"]], len(before), len(after), before[0].get(sc["edit"].get("db_col") or ecol) if before else "(행 없음)", after[0].get(sc["edit"].get("db_col") or ecol) if after else None), flush=True)
            host.send("policy", timeout=30, dialogs="close"); host.send("close_screen", timeout=60); time.sleep(2); SR.sweep(host, out, None)
            out["restore_sql"] = restore(table, pk, before, after)
            out["side_cleanup"] = side_clean(sc.get("side"), where, side_pre)      # 저장 SP 가 덧붙인 이력 행 등 — 이번 실행분만 삭제
            _c, fin = db_rows(table, where); out["db_restored"] = fin; ok_r = same(before, fin, pk)
            print("[4] 복원 %d문 · 덧붙은 행 삭제 %d · 복원 뒤 전 기록과 같음 %s" % (len(out["restore_sql"]), sum(1 for x in out["side_cleanup"] if x.get("rows")), ok_r), flush=True)
            out["status"] = "RESTORE_FAIL" if not ok_r else ("OK" if saved else "SAVE_TIMEOUT" if out.get("save_timeout") else "SAVE_NOT_CONFIRMED")
        rc = 0 if out["status"] in ("OK", "DRY_OK") else 2
        return rc
    except Exception as ex:
        out["status"] = out["status"] or "ERROR"; out["exception"] = "%s: %s" % (type(ex).__name__, str(ex)[:300]); print("[ERROR] " + out["exception"]); return 3
    finally:
        try:
            if before is not None and out.get("status") not in ("OK", "DRY_OK"):
                _c, now_rows = db_rows(table, out["where"])
                if not same(before, now_rows, pk):                  # 어떤 경로로 끝났든 DB 가 전 기록과 다르면 되돌린다
                    out["restore_sql_final"] = restore(table, pk, before, now_rows); _c, fin = db_rows(table, out["where"]); out["db_restored_final"] = fin
                    print("[복원] 비정상 종료 경로 · 복원 뒤 전 기록과 같음 %s" % same(before, fin, pk), flush=True)
        except Exception as ex2:
            out["restore_error"] = str(ex2)[:300]; print("[ERROR] 복원 확인 실패: %s" % out["restore_error"])
        try: host.send("policy", timeout=30, dialogs="close"); host.send("quit", timeout=30)
        except Exception: pass
        save_out()
        print("[%s] %s 저장 시나리오%s · %s" % (out.get("status"), mid, " (저장 안 함)" if dry else "", out.get("note") or R.rel(d)))


