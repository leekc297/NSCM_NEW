# -*- coding: utf-8 -*-
"""AS-IS 저장 시나리오 시범 — 셀 1개 수정 → 저장 → 저장 인자 포착 → 원래 값 복원·대조 (2026-11-13 · 플랜 P6-2 · 사용자 승인 "네, 시범 진행")

  python tools/AsisLive/asis_live_save.py <ID> [--dry]
입력  Doc/asislive/<ID>/save_scenario.json   화면별 저장 시나리오 정의(사람이 소스·SP 원문을 보고 적는다 — 자동 추정하지 않는다)
        {"table": 저장 대상 테이블, "pk": [테이블 키 컬럼…], "match": {테이블 컬럼: 그리드 열 Tag …}  ← 그리드 행에서 대상 DB 행을 찾는 조건,
         "edit": {"col": 그리드 열 Tag, "rule": "plus1"}, "pick": {"col": 그리드 열 Tag, "nonempty": true}  ← 어떤 행을 고칠지,
         "save_sp": 저장 SP 이름, "basis": 근거(파일:줄)}
순서  ① 화면 열기 → 필수 조건 → 조회 → 고칠 행 선택(pick)  ② DB 에서 그 행의 지금 값 기록(전)  ③ 수정 모드 → 셀 값 입력(사용자 편집 경로) → 변경 표시 확인
      ④ (--dry) 저장하지 않고 닫는다 → DB 가 그대로인지 확인
         (실행) 저장 버튼(OnClickSaveButton) → 뜬 메시지 기록 → 저장 SP 호출·인자 포착 → DB 값 기록(후)
      ⑤ 복원: 전 기록의 행은 키로 찾아 키가 아닌 컬럼을 전 값으로 UPDATE · 전에 없던 행은 키로 DELETE(모두 WHERE 키 지정 · 행 단위) → 다시 읽어 전 기록과 전 컬럼 대조
산출  Doc/asislive/<ID>/run_<시각>_save/save.json(전·후·복원 뒤 값 · 저장 호출 인자 · 메시지 · 판정) · calls.json
판정  OK = 저장 SP 가 호출됐고, DB 값이 입력대로 바뀌었고, 복원 뒤 전 기록과 전 컬럼이 같다 / RESTORE_FAIL = 복원 뒤 값이 다르다(즉시 보고 · 복원 SQL 을 save.json 에 남긴다)
제약  AS-IS 개발 DB 에만 쓴다(.env.asis). 테이블 전체 삭제·구조 변경 없음. 대상 행이 1개가 아니거나 전 기록을 못 읽으면 저장하지 않는다.
"""
import datetime as dt, decimal, json, os, sys, time

HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
ROOT = os.path.abspath(os.path.join(HERE, "..", "..")); sys.path.insert(0, os.path.join(ROOT, "tools", "DbConn"))
import asis_live_run as R
import asis_live_fill as F
import asis_live_scen_run as SR
P = lambda *a: os.path.join(ROOT, *a)


def jv(v):
    if isinstance(v, (dt.datetime, dt.date)): return v.strftime("%Y-%m-%d %H:%M:%S.%f")[:23]
    if isinstance(v, decimal.Decimal): return str(v)
    return v


def db_rows(table, where):
    import dbconn
    cx = dbconn.connect("asis"); cur = cx.cursor()
    cur.execute("SELECT * FROM %s WHERE %s" % (table, " AND ".join("%s = ?" % k for k in where)), list(where.values()))
    cols = [d[0] for d in cur.description]; rows = [dict(zip(cols, r)) for r in cur.fetchall()]; cx.close()
    return cols, rows


def restore(table, pk, before, after):
    """전 기록으로 되돌린다 — 행 단위 UPDATE/DELETE(모두 키 조건). 실행한 문장 목록을 돌려준다."""
    import dbconn
    cx = dbconn.connect("asis"); cur = cx.cursor(); done = []
    key = lambda r: tuple(r[k] for k in pk)
    bset = {key(r): r for r in before}
    for r in after:
        if key(r) not in bset:
            sql = "DELETE FROM %s WHERE %s" % (table, " AND ".join("%s = ?" % k for k in pk)); cur.execute(sql, [r[k] for k in pk])
            done.append({"sql": sql, "key": [jv(r[k]) for k in pk], "rows": cur.rowcount})
    for r in before:
        nk = [c for c in r if c not in pk]
        sql = "UPDATE %s SET %s WHERE %s" % (table, ", ".join("%s = ?" % c for c in nk), " AND ".join("%s = ?" % k for k in pk))
        cur.execute(sql, [r[c] for c in nk] + [r[k] for k in pk]); done.append({"sql": sql[:60] + "…", "key": [jv(r[k]) for k in pk], "rows": cur.rowcount})
        if cur.rowcount == 0:                                   # 저장이 그 행을 지웠다면 다시 넣는다
            cols = list(r); sql = "INSERT INTO %s (%s) VALUES (%s)" % (table, ", ".join(cols), ", ".join("?" for _ in cols)); cur.execute(sql, [r[c] for c in cols])
            done.append({"sql": sql[:60] + "…", "key": [jv(r[k]) for k in pk], "rows": cur.rowcount})
    cx.commit(); cx.close()
    return done


def same(a, b, pk):
    ka = sorted(a, key=lambda r: [str(r[k]) for k in pk]); kb = sorted(b, key=lambda r: [str(r[k]) for k in pk])
    return [{c: jv(v) for c, v in r.items()} for r in ka] == [{c: jv(v) for c, v in r.items()} for r in kb]


def main():
    av = sys.argv[1:]; ids = [a.upper() for a in av if not a.startswith("-")]; dry = "--dry" in av
    if len(ids) != 1: print(__doc__); return 2
    mid = ids[0]
    try: sc = json.load(open(P("Doc", "asislive", mid, "save_scenario.json"), encoding="utf-8"))
    except Exception as ex: print("[ERROR] 저장 시나리오 정의 없음: Doc/asislive/%s/save_scenario.json (%s)" % (mid, ex)); return 3
    table, pk = sc["table"], sc["pk"]
    out = {"id": mid, "dry": dry, "scenario": sc, "at": time.strftime("%Y-%m-%d %H:%M:%S"), "status": "", "steps": []}
    d = P("Doc", "asislive", mid, "run_%s_save%s" % (time.strftime("%Y%m%d_%H%M%S"), "_dry" if dry else "")); os.makedirs(d, exist_ok=True)
    def save_out():
        json.dump(out, open(os.path.join(d, "save.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1, default=jv)
    if not R.acquire_lock("save"): print("[ERROR] 다른 AS-IS 실측이 끝나지 않음"); return 3
    host, info, why = R.start_session(P("Doc", "asislive", "_cmd_save_" + time.strftime("%H%M%S")))
    if host is None: print("[ERROR] 런처 세션 시작 실패: %s" % why); return 3
    before = None; rc = 3
    try:
        t0 = R.now()
        r = host.send("open", timeout=180, id=mid)
        if not r.get("ok"): out["status"] = "ERROR"; out["note"] = "화면 열기 실패: %s" % r.get("error"); return 3
        R.wait_quiet(R.now(), 3, 60); F.LOCK.clear()
        try: F.prefill(host, mid)
        except Exception: pass
        tf = R.now(); host.send("find", timeout=60); R.wait_find(host, tf, 0, 300)
        g = SR.grid_snap(host, rows=500); sheet = next(iter(g.values()), None)
        if not sheet or not sheet["data"]: out["status"] = "ERROR"; out["note"] = "조회 결과 행 없음"; return 3
        cols = sheet["cols"]; ci = lambda tag: cols.index(tag)
        pick = sc.get("pick") or {}; row = None
        for i, rw in enumerate(sheet["data"]):
            if not pick or (str(rw[ci(pick["col"])]).strip() != "") == bool(pick.get("nonempty", True)): row = i; break
        if row is None: out["status"] = "ERROR"; out["note"] = "고칠 행을 찾지 못함(pick %s · 앞 %d행)" % (pick, len(sheet["data"])); return 3
        rw = sheet["data"][row]; where = {tc: rw[ci(gt)] for tc, gt in sc["match"].items()}
        out["grid_row"] = {"index": row, "values": dict(zip(cols, rw))}; out["where"] = where
        _c, before = db_rows(table, where); out["db_before"] = before
        print("[1] 대상 행 %d · 조건 %s · DB 전 기록 %d행" % (row, where, len(before)), flush=True)
        if len(before) != 1: out["status"] = "ERROR"; out["note"] = "DB 대상 행이 1개가 아님(%d) — 저장하지 않음" % len(before); return 3
        ecol = sc["edit"]["col"]; old = str(rw[ci(ecol)]).replace(",", "").strip()
        new = str(int(old) + 1) if sc["edit"].get("rule") == "plus1" else str(sc["edit"].get("value"))
        out["edit"] = {"col": ecol, "old": old, "new": new}
        host.send("policy", timeout=30, dialogs="no")                    # 저장 전까지는 어떤 확인 창에도 '아니오'
        er = host.send("act", timeout=120, method="OnClickEditButton", wait=5); SR.sweep(host, out, "OnClickEditButton")
        out["edit_mode"] = er.get("edit_mode")
        if not er.get("edit_mode"): out["status"] = "ERROR"; out["note"] = "수정 모드가 켜지지 않음"; return 3
        cr = host.send("cell", timeout=60, row=str(row), col=ecol, value=new); out["cell"] = {k: cr.get(k) for k in ("ok", "error", "before", "after", "action_before", "action_after", "locked", "entered", "how", "is_change", "edit_error")}
        print("[2] 셀 입력 %s: %s → %s · 변경 표시 '%s' → '%s' · 편집 상태 진입 %s" % (ecol, cr.get("before"), cr.get("after"), cr.get("action_before"), cr.get("action_after"), cr.get("entered")), flush=True)
        changed = cr.get("ok") and str(cr.get("after") or "").replace(",", "") == new and (cr.get("action_after") or "") in ("M", "I")
        if not changed: out["note"] = "셀 값·변경 표시가 기대대로 바뀌지 않음 — 저장하지 않음"
        d0 = len((host.send("dialogs", timeout=30).get("dialogs") or []))
        if dry or not changed:
            host.send("policy", timeout=30, dialogs="close"); host.send("close_screen", timeout=60); time.sleep(2); SR.sweep(host, out, None)
            _c, after = db_rows(table, where); out["db_after"] = after
            out["status"] = ("DRY_OK" if changed else "ERROR") if same(before, after, pk) else "RESTORE_NEEDED"
            print("[3] 저장하지 않고 닫음 · DB 그대로 %s" % same(before, after, pk), flush=True)
        else:
            host.send("policy", timeout=30, dialogs="default")
            ts = R.now(); sr = host.send("act", timeout=180, method="OnClickSaveButton", wait=10); R.wait_quiet(ts, 3, 120)
            n, _s = R.db_inflight()
            if n: R.wait_db_clear(600)
            cs = R.parse_dbprofile(ts, R.now())
            for c in cs: c["phase"] = "action:save"
            json.dump({"calls": cs}, open(os.path.join(d, "calls.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1, default=str)
            sv = [c for c in cs if str(c.get("sp") or "").upper().endswith(sc["save_sp"].upper())]
            out["save_call"] = [{"sp": c.get("sp"), "params": c.get("params"), "rows": c.get("rows"), "ms": c.get("ms")} for c in sv]
            out["save_dialogs"] = [{"text": (x.get("text") or "")[:200], "action": x.get("action")} for x in (host.send("dialogs", timeout=30).get("dialogs") or [])[d0:]]
            out["save_act"] = {"ok": sr.get("ok"), "error": sr.get("error")}
            _c, after = db_rows(table, where); out["db_after"] = after
            saved = bool(sv) and len(after) == 1 and str(after[0].get(sc["edit"].get("db_col") or ecol)) == new
            print("[3] 저장 호출 %d · 메시지 %s · DB 값 %s → %s" % (len(sv), [x["text"][:40] for x in out["save_dialogs"]], before[0].get(sc["edit"].get("db_col") or ecol), after[0].get(sc["edit"].get("db_col") or ecol) if after else None), flush=True)
            host.send("policy", timeout=30, dialogs="close"); host.send("close_screen", timeout=60); time.sleep(2); SR.sweep(host, out, None)
            out["restore_sql"] = restore(table, pk, before, after)
            _c, fin = db_rows(table, where); out["db_restored"] = fin; ok_r = same(before, fin, pk)
            print("[4] 복원 %d문 · 복원 뒤 전 기록과 같음 %s" % (len(out["restore_sql"]), ok_r), flush=True)
            out["status"] = "RESTORE_FAIL" if not ok_r else ("OK" if saved else "SAVE_NOT_CONFIRMED")
        rc = 0 if out["status"] in ("OK", "DRY_OK") else 2
        return rc
    except Exception as ex:
        out["status"] = out["status"] or "ERROR"; out["exception"] = "%s: %s" % (type(ex).__name__, str(ex)[:300]); print("[ERROR] " + out["exception"]); return 3
    finally:
        try:
            if before is not None and out.get("status") not in ("OK", "DRY_OK"):
                _c, now_rows = db_rows(table, out["where"])
                if not same(before, now_rows, pk):                  # 어떤 경로로 끝났든 DB 가 전 기록과 다르면 되돌린다
                    out["restore_sql_final"] = restore(table, pk, before, now_rows); _c, fin = db_rows(table, out["where"]); out["db_restored_final"] = fin
                    print("[복원] 비정상 종료 경로 · 복원 뒤 전 기록과 같음 %s" % same(before, fin, pk), flush=True)
        except Exception as ex2:
            out["restore_error"] = str(ex2)[:300]; print("[ERROR] 복원 확인 실패: %s" % out["restore_error"])
        try: host.send("policy", timeout=30, dialogs="close"); host.send("quit", timeout=30)
        except Exception: pass
        save_out()
        print("[%s] %s 저장 시나리오%s · %s" % (out.get("status"), mid, " (저장 안 함)" if dry else "", out.get("note") or R.rel(d)))


if __name__ == "__main__":
    sys.exit(main())
