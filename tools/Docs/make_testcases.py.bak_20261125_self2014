def flow_for(text):
    t = text or ''
    if re.search(r'Insert', t, re.I): return 'IN'
    if re.search(r'Edit|ComboSel|Change|Pasted|Leave|Cell(Click|DoubleClick)|LockRange|Lock', t, re.I): return 'UP'
    if re.search(r'Save', t, re.I): return 'SV'
    if re.search(r'Delete', t, re.I): return 'DL'
    if re.search(r'Popup|PopUp|\bP\b|Dialog', t): return 'PU'
    if re.search(r'Search|Find|GetData|Query', t, re.I): return 'SR'
    if re.search(r'^§1|clb|cbo|txt|조회조건', t): return 'SC'
    if re.search(r'Init|Load|Create|Layout|Form_', t, re.I): return 'DS'
    return 'ET'

