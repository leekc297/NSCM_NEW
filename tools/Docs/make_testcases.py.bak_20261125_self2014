def read_csv(p):
    if not os.path.exists(p): return []
    with open(p, encoding='utf-8-sig', newline='') as f: return list(csv.DictReader(f))
def read_json(p, default=None):
    try: return json.load(open(p, encoding='utf-8-sig'))
    except Exception: return default
def up(s): return (s or '').strip().upper()
def fam(d): return (d or '').split('_')[0]

def clean_expr(s):
    """AS-IS C# 조건식을 사람이 읽을 수 있게 — 컬럼 참조만 남긴다(원문은 '설명' 열에 그대로)"""
    s = s or ''
    s = re.sub(r'siMain\.ActiveSheet\.GetText\(\s*\w+\s*,\s*siMain\.GetColumnIndex\(DefColumns\.(\w+)\)\)(\.ToString\(\))?', r'[\1]', s)
    s = re.sub(r'siMain\.(Get(Text|Value))\(\s*\w+\s*,\s*siMain\.GetColumnIndex\(DefColumns\.(\w+)\)\)(\.ToString\(\))?', r'[\3]', s)
    s = re.sub(r'siMain\.GetColumnIndex\(DefColumns\.(\w+)\)', r'[\1]', s)
    s = re.sub(r'DefColumns\.(\w+)', r'[\1]', s)
    s = s.replace('▸', ' → ').replace('string.IsNullOrEmpty', '빈값').replace('String.IsNullOrEmpty', '빈값')
    return re.sub(r'\s+', ' ', s).strip()

def cols_in(text, known):
    return [c for c in dict.fromkeys(re.findall(r'[A-Z][A-Z0-9_]{2,}', up(text))) if c in known]


