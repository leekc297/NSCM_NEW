class Ledger:
    def __init__(self, S):
        self.S = S; self.rows = [r for r in S.ledger]; self.used = collections.defaultdict(set)   # row_id → {TC_ID}
        self.by_col = collections.defaultdict(list); self.by_cond = collections.defaultdict(list); self.by_rule = collections.defaultdict(list); self.by_trace = collections.defaultdict(list)
        conds = {up(c.get('ctl')): c for c in S.search_cond.get('order', [])}
        for r in self.rows:
            if r['rule_id'] == 'X-LOC': continue
            self.by_rule[r['rule_id']].append(r)
            tgt = r.get('target', ''); cnd = r.get('condition', '')
            info = {}
            if cnd.startswith('{'):
                try: info = json.loads(cnd)
                except Exception: info = {}
            if info.get('et') == 'ROW' or re.match(r'D\d{2}-\d+-\d+', tgt) or (r['source'] == 'TRACE' and info.get('et') == 'ENTRY'):
                self.by_trace[info.get('name') or tgt.split(' ')[0]].append(r); continue
            if r['area'] == '조회조건' or info.get('et') == 'CTRL' or tgt.startswith('조회조건'):
                lab = re.sub(r'^조회조건\s*', '', tgt).split(' / ')[0].strip()
                self.by_cond[up(lab)].append(r)
                for lb in (info.get('labels') or []): self.by_cond[up(lb)].append(r)
                continue
            cs = cols_in(tgt.split('(')[0] if '(' in tgt else tgt, S.known_cols) or [up(x) for x in (info.get('labels') or []) if up(x) in S.known_cols]
            for c in cs: self.by_col[c].append(r)
    def take(self, rows, tc):
        out = []
        seen = set()
        for r in rows:
            if r['row_id'] in seen: continue
            seen.add(r['row_id']); self.used[r['row_id']].add(tc); out.append(r)
        return out
    def col(self, c, rules=None, cond=None):
        return [r for r in self.by_col.get(c, []) if (rules is None or r['rule_id'] in rules) and (cond is None or cond(r))]
    def cond_rows(self, labels, rules=None):
        acc = []
        for l in labels: acc += [r for r in self.by_cond.get(up(l), []) if rules is None or r['rule_id'] in rules]
        return acc
    @staticmethod
    def verdict(rows):
        if not rows: return '미검증', ''
        res = [r['result'] for r in rows]
        v = 'FAIL' if 'FAIL' in res else '판정필요' if '판정필요' in res else 'PASS' if 'PASS' in res else 'NA'
        order = {'FAIL': 0, '판정필요': 1, 'PASS': 2, 'NA': 3}
        ev = []
        for r in sorted(rows, key=lambda r: order.get(r['result'], 9))[:4]:
            ev.append(f"[{r['result']} {r['rule_id']}] {(r.get('evidence') or r.get('expected') or '')[:220]}")
        cnt = collections.Counter(res)
        head = ' · '.join(f'{k} {v}' for k, v in cnt.items())
        return v, f'{head}\n' + '\n'.join(ev)


