class TCB:
    def __init__(self, S, L, div=None):
        self.S, self.L, self.div = S, L, div; self.tcs = []; self.seq = collections.Counter()
    def add(self, flow, sub, kind, target, title, expect, steps, pre='', inp='', rowtype='', role='', msg='', check='(정상)', ledger=(), basis='', desc='',
            tgt='', tgt_col='', src='', src_detail='', proc='', verify='', gap=False):
        self.seq[flow] += 1
        tid = f"TC-{self.S.ID}-{('D' + self.div + '-') if self.div else ''}{flow}{self.seq[flow]:03d}"
        lrows = self.L.take(list(ledger), tid)
        v, ev = Ledger.verdict(lrows)
        self.tcs.append(dict(id=tid, flow=flow, sub=sub, kind=kind, target=target, rowtype=rowtype, div=self.div or (self.cur_div if hasattr(self, 'cur_div') else '전체'), role=role or '공통(메뉴 권한 보유)',
                             title=title, expect=expect, steps=steps, pre=pre, inp=inp, msg=msg, check=check, basis=basis, desc=desc, tgt=tgt, tgt_col=tgt_col, src=src,
                             src_detail=src_detail, proc=proc, verify=verify, auto=v, auto_ev=ev, lids=', '.join(r['row_id'] for r in lrows), gap=gap))
        return tid


def msg_of(S, raw):
    m = re.search(r'MSG\d+', raw or '')
    return S.msg(m.group(0)) if m else (raw or '')[:60]


def asis_state(v):
    """AS-IS grid_effective 값 → 표시 / 선택(개인화 선택 시 표시) / 숨김(공란 = 해당 Division 에 없음)"""
    v = (v or '').replace('→', ' ').strip()
    if not v or '숨김' in v: return '숨김'
    if '선택' in v: return '선택'
    return '표시'


def tobe_state(c, family):
    t = c['tobe']
    if not tobe_vis(c, family): return '숨김'
    return '선택' if (t.get('default_flag') == 'N') else '표시'


def div_cond_result(cond, family):
    """'해제 when … Division … == "81"' 같은 Division 리터럴 조건을 계열 하나에 대해 풀어 본다 → '편집 가능'/'편집 불가'/''"""
    if not family or not cond: return ''
    for seg in cond.split(' | '):
        m = re.match(r'\s*(해제|잠금) when (.*)', seg)
        if not m or not re.search(r'[Dd]ivision', m.group(2)): continue
        lits = re.findall(r'==\s*"(\w+)"', m.group(2))
        if not lits: continue
        neg = m.group(2).strip().startswith('else of')
        hit = any(fam(x) == family or x == family for x in lits)
        if neg: hit = not hit
        unlock = (m.group(1) == '해제')
        return '편집 가능' if (hit == unlock) else '편집 불가'
    return ''


def tobe_vis(c, family):
    """TO-BE 표시 — visible_flag=Y 이고 DIVISION_ID 토큰이 비었거나 해당 계열 포함 (hook #92 column-division-id-visibility)"""
    t = c['tobe']
    if not t or t.get('visible_flag') != 'Y': return False
    toks = [x.strip() for x in (t.get('division_id') or '').split(',') if x.strip() and x.strip() not in ('-', '/')]
    return not toks or not family or any(fam(x) == family for x in toks)


