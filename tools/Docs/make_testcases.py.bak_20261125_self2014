    # 저장 대상 테이블 — AS-IS endpoints objects(쓰기) 기준
    def _write_tables(self):
        acc = collections.OrderedDict()
        for e in read_csv(os.path.join(ROOT, 'Doc', 'asisfacts', 'screens', self.ID, 'endpoints.csv')):
            for tok in re.split(r'[,\s]+', e.get('objects') or ''):
                if ':' not in tok: continue
                op, name = tok.split(':', 1); name = name.strip()
                if not re.fullmatch(r'[A-Za-z][A-Za-z0-9_.]{2,}', name or ''): continue
                if op.upper() in ('INSERT', 'UPDATE', 'DELETE', 'MERGE'): acc.setdefault(name, set()).add(op.upper())
        return acc

    def _columns(self):
        """메인 그리드 컬럼 = TO-BE 메타(정렬순) ∪ AS-IS 편집 기대 — 한쪽에만 있으면 격차로 표기"""
        tobe = {}
        for r in sorted(self.sheet_cols, key=lambda r: (r.get('sheet_name') or '', float(r.get('sort_order_no') or 0))):
            if (r.get('sheet_name') or '') != self.main_sheet: continue
            tobe.setdefault(up(r['column_name']), r)
        ee = {up(r['column']): r for r in self.edit_expect}
        cr = {}
        for r in self.cell_rules: cr.setdefault(up(r['column']), r)
        self.asis_vis = {}
        main_asis_sheet = None
        if self.grid_eff:
            cnt = collections.Counter(r['sheet'] for r in self.grid_eff)
            # AS-IS 메인 시트 = TO-BE 메인 시트명과 같은 이름(대소문자 무시) 우선, 없으면 컬럼 교집합이 가장 큰 시트
            main_asis_sheet = next((s for s in cnt if up(s) == up(self.main_sheet)), None) or max(cnt, key=lambda s: len({up(r['column']) for r in self.grid_eff if r['sheet'] == s} & set(tobe)))
            for r in self.grid_eff:
                if r['sheet'] == main_asis_sheet: self.asis_vis[up(r['column'])] = r
        self.asis_main_sheet = main_asis_sheet
        self.popup_grids = sorted({r['sheet'] for r in self.grid_eff} - {main_asis_sheet}) if self.grid_eff else []
        names = list(tobe) + [c for c in ee if c not in tobe] + [c for c in self.asis_vis if c not in tobe and c not in ee]
        self.cols = []
        for c in names:
            t = tobe.get(c); e = ee.get(c); a = self.asis_vis.get(c)
            tp = (t or {}).get('input_tp_cd') or ''
            self.cols.append({
                'name': c, 'label': (t or {}).get('column_label_name') or (a or {}).get('label') or c,
                'tobe': t, 'asis_edit': e, 'asis_vis': a, 'cell': cr.get(c), 'tp': tp,
                'tobe_new': EDIT_TP.get(tp, ('?', '?'))[0] if t else '-', 'tobe_old': EDIT_TP.get(tp, ('?', '?'))[1] if t else '-',
                'visible_tobe': (t or {}).get('visible_flag') == 'Y',
                'visible_asis': (e or {}).get('asis_visible', '') == 'Y' if e else bool(a),
                'required': bool(t and (t.get('column_label_name') or '').rstrip().endswith('*')) or tp in ('IM', 'M'),
                'ctrl': (t or {}).get('cell_control_object_type_code') or '',
            })
        self.known_cols = {c['name'] for c in self.cols}
        self.grid_combo = collections.defaultdict(list)
        for r in self.combo_src:
            if r.get('target_kind') == 'GRID': self.grid_combo[up(r['target'])].append(r)

    def _division_axis(self):
        """Division 별 작업 필요 판정 — ① 컬럼 표시가 Division 계열마다 다름 ② AS-IS 분기가 특정 Division 코드를 비교"""
        # Division 후보에서 빠지는 계열 — ① combo_src 필터 ② 콤보 원천 SP 의 해당 코드 분기 본문(ATTRIBUTE3 <> 'EE' 등, 예 UP_FX_GetCommonDataList 'MyDivision')
        excl = set(); codes = set()
        for r in self.combo_src:
            if r.get('target_kind') == 'SEARCH' and re.search(r'division', r.get('target', '') + r.get('code', ''), re.I):
                excl |= set(re.findall(r"ATTRIBUTE3\s*<>\s*'(\w+)'", r.get('filters', '')))
                if r.get('code'): codes.add(r['code'])
        if not codes:
            for r in self.actions: codes |= set(re.findall(r'"(MyDivision\w*|Division\w*)"', r.get('raw', '')))
        self.div_src_note = ''
        for code in sorted(codes):
            for f in glob.glob(os.path.join(ROOT, 'Doc', 'asisfacts', 'db', 'modules', 'dbo.UP_FX_GetCommonDataList*.sql')):
                txt = open(f, encoding='utf-8-sig', errors='replace').read()
                m = re.search(r"@Code\s*=\s*'" + re.escape(code) + r"'(.{0,3000}?)(?:\bIF\s+@Code\b|\Z)", txt, re.S | re.I)
                if not m: continue
                body = '\n'.join(l for l in m.group(1).split('\n') if not l.strip().startswith('--'))
                found = set(re.findall(r"ATTRIBUTE3\s*<>\s*'(\w+)'", body))
                if found: excl |= found; self.div_src_note = f"{os.path.basename(f)} '{code}' 분기 ATTRIBUTE3 <> {', '.join(sorted(found))}"
        self.div_excluded = sorted(excl)
        fams = list(dict.fromkeys(fam(d['division_id']) for d in self.divisions))
        self.families = [f for f in fams if f not in excl] or ['40', '81', '82']
        self.div_reasons = []
        if self.grid_eff:
            divcols = [k for k in self.grid_eff[0] if k not in ('sheet', 'sheet_rule', 'column', 'label', 'source')]
            roots = [f for f in self.families if f in divcols]
            for r in self.grid_eff:
                vals = {f: (r.get(f) or '').replace('→', '').strip() for f in roots}
                norm = {f: asis_state(v) for f, v in vals.items()}
                if len(set(norm.values())) > 1:
                    self.div_reasons.append(('컬럼 표시', f"{r['sheet']}.{r['column']}", ' · '.join(f'{f}={v}' for f, v in norm.items())))
        lit = collections.defaultdict(set)
        for r in self.actions:
            for m in re.finditer(r'(\w*[Dd]ivision\w*)\s*(?:==|!=|\.Equals\(|\.Contains\()\s*"(\w+)"', r.get('guard', '') + ' ' + r.get('raw', '')):
                if fam(m.group(2)) in self.families or m.group(2) in self.families:
                    lit[(r['method'], m.group(2))].add(r['line'])
        for (meth, code), lines in sorted(lit.items()):
            self.div_reasons.append(('AS-IS 분기', f'{meth} (Division = {code})', f"줄 {', '.join(sorted(lines, key=int)[:6])}"))
        self.split = bool(self.div_reasons)
        self.div_literal_actions = lit

    def _roles(self):
        std = STD_ROLES.get(self.domain)
