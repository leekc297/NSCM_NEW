class Plain:
    def __init__(self, ws, widths):
        self.ws, self.r = ws, 0
        for i, w in enumerate(widths, 1): ws.column_dimensions[get_column_letter(i)].width = w
        ws.sheet_view.showGridLines = False
    def title(self, t, sub=''):
        self.r += 1; self.ws.cell(self.r, 1, t).font = TITLE_F
        if sub: self.r += 1; c = self.ws.cell(self.r, 1, sub); c.font = Font(name=FONT_NAME, size=9, color='595959')
        self.r += 1
    def hdr(self, cells):
        self.r += 1
        for i, v in enumerate(cells, 1): c = self.ws.cell(self.r, i, v); c.fill = HDR_FILL; c.font = HDR_F; c.alignment = CENTER; c.border = THIN
    def row(self, cells, fill=None):
        self.r += 1
        for i, v in enumerate(cells, 1):
            c = self.ws.cell(self.r, i, v); c.font = BASE_F; c.alignment = WRAP; c.border = THIN
            if fill: c.fill = fill
    def gap(self): self.r += 1


