def screen_facts(sid):
    d = os.path.join(FACTS, sid)
    f = {'id': sid, 'facts': rel(d) if os.path.isdir(d) else '', 'sps': set(), 'reads': set(), 'writes': set(), 'buttons': {}}
    if not os.path.isdir(d):
        return f
    for r in rcsv(os.path.join(d, 'endpoints.csv')):
        if r.get('variant') == 'legacy':
            continue
        for part in re.split(r',\s*', r.get('objects') or ''):
            m = re.match(r'([A-Z]+):\s*\[?([\w.$#@]+)\]?', part.strip())
            if not m:
                continue
            k, n = m.group(1).upper(), m.group(2).split('.')[-1].upper()
            if k == 'EXEC':
                f['sps'].add(n)
            elif k in WRITE_KINDS:
                f['writes'].add(n)
            elif k in ('SELECT', 'FROM', 'JOIN'):
                f['reads'].add(n)
    for r in rcsv(os.path.join(d, 'flow.csv')):
        if r.get('variant') == 'legacy':
            continue
        m = re.search(r'(?:btn|button:)(\w+?)(?:Button)?(?:\.Click)?$', (r.get('entry') or '').replace('this.', ''))
        sp = (re.search(r'SP\s+(\w+)', r.get('sp_or_sql') or '') or [None, ''])[1]
        if m and sp:
            f['buttons'].setdefault(m.group(1), set()).add(sp.upper())
    return f


def batch_facts(mod, mod_sps):
    try:
        import ssp_batch_flow as SB
    except Exception:
        SB = None
    jobs = {j['name']: j for j in rcsv(os.path.join(BATCH, 'agent_jobs.csv'))}
    sch = {}
    for s in rcsv(os.path.join(BATCH, 'agent_schedules.csv')):
        sch.setdefault(s['job_name'], []).append(SB.decode_schedule(s) if SB else s.get('schedule_name', ''))
    hist = {h['job_name']: h for h in rcsv(os.path.join(BATCH, 'agent_jobhistory_summary.csv'))}
    rx = re.compile(MOD_JOB_RX[mod], re.I); rows = []
    for st in rcsv(os.path.join(BATCH, 'agent_jobsteps.csv')):
        cmd = st.get('command') or ''
        toks = {t.upper() for t in re.findall(r'\b([A-Za-z]\w{5,})\b', cmd)}
        execs = sorted({m.split('.')[-1].strip('[]').upper() for m in re.findall(r'(?i)\bEXEC(?:UTE)?\s+(?:@\w+\s*=\s*)?([\w.\[\]]+)', cmd)})
        if not (rx.search(st['job_name']) or (toks & mod_sps)):
            continue
        j = jobs.get(st['job_name'], {}); h = hist.get(st['job_name'], {}); first = execs[0] if execs else ''
        rows.append({'module': mod, 'job': st['job_name'], 'enabled': j.get('enabled', ''), 'desc': j.get('description', ''), 'schedule': (' / '.join(sch.get(st['job_name'], [])) or '스케줄 없음').replace(' · ', ', '),
                     'step': st.get('step_id', ''), 'stepName': st.get('step_name', ''), 'exec': ', '.join(execs[:6]),
                     'group': SB.group_of(first).replace('SSP', mod) if SB and first else '', 'ext': SB.ext_of(first) if SB and first else '',
                     'lastOutcome': st.get('last_run_outcome', ''), 'lastRun': st.get('last_run_date', ''), 'runs': h.get('runs', ''), 'failed': h.get('failed', '')})
    return rows


def flow_edges(screens):
    n = max(1, len(screens)); rd = {}
    for s in screens:
        for t in s['reads']:
            rd[t] = rd.get(t, 0) + 1
    hot = {t for t, c in rd.items() if c > max(3, n * 0.5)}
    edges = {}
    for a in screens:
        for t in a['writes']:
            if COMMON_TBL.search(t) or t in hot:
                continue
            for b in screens:
                if b['id'] != a['id'] and t in b['reads']:
                    edges.setdefault((a['id'], b['id']), set()).add(t)
    return [{'from': k[0], 'to': k[1], 'tables': sorted(v)} for k, v in sorted(edges.items())]


# ───────────────────────── 양식 구조 ─────────────────────────
def first_line(slide):
    return um.slide_title(slide).split('\n')[0].strip()


def slide_texts(slide):
    return [sh.text_frame.text.strip() for sh in slide.shapes if sh.has_text_frame and sh.text_frame.text.strip()]


def roles(prs):
    """양식 장표 역할 번호(0부터): cover, rev, toc, divider, end, body(글 본문), table(표 본문)"""
    sl = list(prs.slides); r = {'cover': 0}
    for i, s in enumerate(sl):
        tx = ' '.join(slide_texts(s))
        tbl = [sh for sh in s.shapes if sh.has_table]
        if 'rev' not in r and tbl and re.search(r'버전|Version|개정|Rev', ' '.join(c.text for c in tbl[0].table.rows[0].cells), re.I):
            r['rev'] = i
        elif 'toc' not in r and re.search(r'목\s*차|Contents', tx, re.I) and i > 0:
            r['toc'] = i
        elif 'end' not in r and re.search(r'End of Document|끝', tx, re.I) and len(slide_texts(s)) <= 2:
            r['end'] = i
        elif 'divider' not in r and i > 1 and len(slide_texts(s)) == 1 and not tbl and not HEAD_RX.match(first_line(s)) and len(s.shapes) <= 3:
            r['divider'] = i
        elif 'table' not in r and len(tbl) == 1 and HEAD_RX.match(first_line(s)):
            r['table'] = i
        elif 'body' not in r and not tbl and HEAD_RX.match(first_line(s)):
            r['body'] = i
    return r


def template_structure(path):
    from pptx import Presentation
    prs = Presentation(path); outline, seen = [], {}
    for i, s in enumerate(prs.slides):
        m = HEAD_RX.match(first_line(s))
        if not m:
            continue
        no, title = m.group(1), m.group(2)
        title = re.sub(r'\s*\(\s*\d+\s*/\s*\d+\s*\)\s*$', '', title)
        base, sub = (re.split(r'\s+[–-]\s+', title, maxsplit=1) + [''])[:2]
        base = re.sub(r'\s*\(.*\)\s*$', '', base).strip(); k = norm(base)
        if not k:
            continue
        if k not in seen:
            seen[k] = {'no': no, 'title': base, 'subs': [], 'slides': [], 'tables': []}; outline.append(seen[k])
        o = seen[k]; o['slides'].append(i + 1)
        if sub and sub not in o['subs']:
            o['subs'].append(sub)
        for sh in s.shapes:
            if sh.has_table:
                cols = [c.text.replace('\x0b', ' ').strip() for c in sh.table.rows[0].cells]
                if cols not in o['tables']:
                    o['tables'].append(cols)
    r = roles(prs)
    return {'file': path, 'roles': r, 'outline': outline, 'layouts': [l.name for l in prs.slide_layouts], 'slides': len(prs.slides),
            'dividerExample': first_line(list(prs.slides)[r['divider']]) if 'divider' in r else ''}


