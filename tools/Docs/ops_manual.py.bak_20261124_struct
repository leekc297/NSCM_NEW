def check_slide(tag, s, allids, jobs, seen, texts, fails):
    if not s.get('src'):
        fails.append(f'{tag}: 근거(src) 없음')
    for p in s.get('src') or []:
        if not os.path.exists(os.path.join(ROOT, re.split(r'[#:]', str(p))[0] if not re.match(r'^[A-Za-z]:', str(p)) else str(p))):
            fails.append(f'{tag}: 근거 파일 없음 {p}')
    k = s.get('kind')
    if k == 'flow':
        nids = {n.get('id') for n in s.get('nodes', [])}
        if not nids:
            fails.append(f'{tag}: 흐름 노드 없음')
        for e in s.get('edges', []):
            if e.get('from') not in nids or e.get('to') not in nids:
                fails.append(f'{tag}: 흐름 연결 끝점이 노드에 없음 {e.get("from")} → {e.get("to")}')
        seen['screens'] |= {n.get('id') for n in s.get('nodes', [])} & allids
        texts += [n.get('sub', '') for n in s.get('nodes', [])] + list(s.get('notes') or [])
    elif k == 'table':
        if not s.get('rows'):
            fails.append(f'{tag}: 표 행 없음')
        for r in s.get('rows', []):
            cells = [str(x) for x in r]
            seen['screens'] |= set(cells) & allids
            seen['jobs'] |= {j for j in jobs if any(j in c for c in cells)}
            # 표 칸은 화면 ID, SP, AS-IS 잡 설명(원문 인용) 이라 문장 규칙 검사에서 뺌. 문장 검사 = 본문(text), 흐름 메모(notes)
    elif k == 'text':
        if not s.get('lines'):
            fails.append(f'{tag}: 본문 없음')
        if any('작성 필요' in str(x) for x in s.get('lines', [])):
            fails.append(f'{tag}: 초안 문구(작성 필요) 남음')
        texts += list(s.get('lines', []))
    else:
        fails.append(f'{tag}: kind 는 flow, table, text 중 하나')


def cmd_check(a):
    key = um.mod_key(a.module); d = odir(key); plan = um.rj(os.path.join(d, PLAN), None)
    if not plan:
        out('[FAIL] plan.json 없음. prep 먼저'); return 2
    c, name = load_content(key); fails = []
    if name != MAIN:
        fails.append(f'content/{MAIN} 없음(AI 단계가 {AUTO} 와 facts 를 보고 작성)')
    c = c or {'chapters': []}
    titles = [norm(ch.get('outline') or '') + norm(ch.get('title') or '') for ch in c.get('chapters', [])]
    outline = plan['template']['outline']
    for o in outline:
        if not any(norm(o['title']) in t for t in titles):
            fails.append(f'양식 장 빠짐: {o["no"]}. {o["title"]}(해당 없으면 그 장에 text 1장으로 해당 없음과 근거를 적음)')
    S = rcsv(os.path.join(d, 'facts', 'screens.csv')); allids = {s['id'] for s in S}
    jobs = {b['job'] for b in rcsv(os.path.join(d, 'facts', 'batch.csv'))}
    seen = {'screens': set(), 'jobs': set()}; texts = []
    for ci, ch in enumerate(c.get('chapters', []), 1):
        if ch.get('divider'):
            continue
        if not ch.get('slides'):
            fails.append(f'장 {ci} {ch.get("title")}: 장표 없음')
        for i, s in enumerate(ch.get('slides', []), 1):
            check_slide(f'{ci}-{i} {s.get("title", "")}', s, allids, jobs, seen, texts, fails)
    miss = sorted(allids - seen['screens'])
    if miss:
        fails.append(f'화면 빠짐 {len(miss)}개(프로그램 목록이나 흐름에 없음): {", ".join(miss[:20])}')
    missj = sorted(jobs - seen['jobs'])
    if missj:
        fails.append(f'배치 잡 빠짐 {len(missj)}개(잡 목록 표에 없음): {", ".join(missj[:10])}')
    try:
        import doc_style
        hits = [h for t in texts if t and not re.match(r'^[\w./,: -]+$', str(t)) for h in (doc_style.check_text(str(t)) or [])]
        if hits:
            fails.append(f'문장 규칙 위반 {len(hits)}건(50_DOC_STYLE): {str(hits[:3])[:300]}')
    except Exception as e:
        out(f'문장 검사 못 함(계속): {e}')
    for f in fails:
        out(f'[FAIL] {f}')
    out(f'[{"OK" if not fails else "FAIL"}] check {key}: 양식 장 {len(outline) - sum(1 for f in fails if f.startswith("양식 장"))}/{len(outline)}, 화면 {len(allids & seen["screens"])}/{len(allids)}, 배치 잡 {len(jobs & seen["jobs"])}/{len(jobs)}, 실패 {len(fails)} · 내용 {name}')
    return 0 if not fails else 2


