def wcsv(path, rows, cols):
    with open(path, 'w', encoding='utf-8-sig', newline='') as fh:
        w = csv.DictWriter(fh, fieldnames=cols, extrasaction='ignore'); w.writeheader()
        for r in rows:
            w.writerow(r)


def cmd_prep(a):
    key = um.mod_key(a.module); mods = um.mods_of(key); inp = inputs_of(key); d = odir(key)
    os.makedirs(os.path.join(d, 'facts'), exist_ok=True); os.makedirs(os.path.join(d, 'content'), exist_ok=True)
    plan = {'key': key, 'mods': mods, 'at': datetime.datetime.now().strftime('%Y-%m-%d %H:%M'), 'template': template_structure(inp['template']), 'modules': []}
    S, B, E = [], [], []
    for mod in mods:
        groups = um.menu_tree(mod); scr = []
        for g in groups:
            for s in g['screens']:
                f = screen_facts(s['id']); f.update({'name': s['name'], 'ko': s.get('ko', ''), 'top': g['top'], 'group': g['group'], 'menuPath': s['menuPath']}); scr.append(f)
        mod_sps = set().union(*[s['sps'] for s in scr]) if scr else set()
        edges = flow_edges(scr); bt = batch_facts(mod, mod_sps); no_f = [s['id'] for s in scr if not s['facts']]
        plan['modules'].append({'mod': mod, 'groups': [{'top': g['top'], 'group': g['group'], 'screens': [s['id'] for s in g['screens']]} for g in groups], 'screens': len(scr),
                                'noFacts': no_f, 'edges': len(edges), 'batchJobs': len({b['job'] for b in bt}), 'batchSteps': len(bt)})
        for s in scr:
            save = ' '.join(f'{k}:{"/".join(sorted(v))}' for k, v in sorted(s['buttons'].items()) if re.search(r'save|upload|confirm|create|apply|exec|run|delete|close|release|cutoff', k, re.I))
            S.append({'module': mod, 'top': s['top'], 'group': s['group'], 'id': s['id'], 'name': s['name'], 'ko': s['ko'], 'facts': s['facts'] or '분석 자료 없음(미확인)',
                      'writes': ' '.join(sorted(s['writes'])), 'reads': ' '.join(sorted(s['reads'])), 'sps': ' '.join(sorted(s['sps'])), 'saveButtons': save})
        B += bt; E += [dict(e, module=mod, tables=' '.join(e['tables'])) for e in edges]
        out(f'{mod}: 화면 {len(scr)} · 분석 자료 없는 화면 {len(no_f)} · 화면 간 연결 {len(edges)} · 배치 잡 {len({b["job"] for b in bt})}개 단계 {len(bt)}')
    wcsv(os.path.join(d, 'facts', 'screens.csv'), S, ['module', 'top', 'group', 'id', 'name', 'ko', 'facts', 'writes', 'reads', 'sps', 'saveButtons'])
    wcsv(os.path.join(d, 'facts', 'batch.csv'), B, ['module', 'job', 'enabled', 'desc', 'schedule', 'step', 'stepName', 'exec', 'group', 'ext', 'lastOutcome', 'lastRun', 'runs', 'failed'])
    wcsv(os.path.join(d, 'facts', 'flow_edges.csv'), E, ['module', 'from', 'to', 'tables'])
    um.wj(os.path.join(d, PLAN), plan)
    um.wj(os.path.join(d, 'content', AUTO), auto_chapters(plan, S, B, E))
    t = plan['template']
    out(f'[OK] prep {key}: facts/screens.csv {len(S)}행, facts/batch.csv {len(B)}행, facts/flow_edges.csv {len(E)}행, content/{AUTO}')
    out(f'      양식 {os.path.basename(inp["template"])}: 장표 {t["slides"]}장, 장 제목 {len(t["outline"])}개({", ".join(o["no"] + " " + o["title"] for o in t["outline"])[:300]}), 역할 {t["roles"]}')
    return 0


def map_cols(cols):
    res = []
    for c in cols:
        f = ''
        for rx, k in COLMAP:
            if re.search(rx, c, re.I):
                f = k; break
        res.append(f)
    return res


def table_cols(o, default):
    return o['tables'][0] if o and o.get('tables') else default


def auto_chapters(plan, S, B, E):
    """양식 장 제목(outline) 순서대로 분석 자료 초안. AI 단계가 content/chapters.json 으로 다듬음"""
    k = plan['key']; srcS, srcB, srcE = f'Doc/OpsManual/{k}/facts/screens.csv', f'Doc/OpsManual/{k}/facts/batch.csv', f'Doc/OpsManual/{k}/facts/flow_edges.csv'
    jobs = {}
    for b in B:
        jobs.setdefault(b['job'], []).append(b)
    chs = []
    for o in plan['template']['outline']:
        t = o['title']; sl = []
        if re.search(r'인터페이스|interface', t, re.I):
            ext = {}
            for b in B:
                if b['ext']:
                    ext.setdefault(b['ext'], set()).update(x for x in b['exec'].split(', ') if x)
            ext = {x: v for x, v in ext.items() if x not in plan['mods']}
            hub = 'NSCM_' + '_'.join(plan['mods'])
            nodes = [{'id': x, 'label': x, 'sub': f'I/F SP {len(v)}개'} for x, v in ext.items()] + [{'id': hub, 'label': 'NSCM ' + ', '.join(plan['mods']), 'sub': '', 'hub': True}]
            edges = []
            for x, v in ext.items():
                rcv = [q for q in v if re.search(r'_R(_\w+)?$|_IF$', q)]; snd = [q for q in v if q not in rcv]
                if rcv:
                    edges.append({'from': x, 'to': hub, 'label': ', '.join(sorted(rcv)[:2])})
                if snd:
                    edges.append({'from': hub, 'to': x, 'label': ', '.join(sorted(snd)[:2])})
            sl.append({'kind': 'flow', 'layout': 'hub', 'title': f'{o["no"]}. {t}', 'nodes': nodes, 'edges': edges, 'src': [srcB]})
        elif re.search(r'프로그램\s*목록', t):
            cols = table_cols(o, ['Level1 Menu', 'Level2 Menu', 'Program ID', '화면명', '프로시저명', '내용']); fm = map_cols(cols)
            rows = [[{'top': s['top'], 'group': s['group'], 'id': s['id'], 'name': s['name'], 'sp': ' '.join(s['sps'].split()[:3]), 'desc': ''}.get(f, '') for f in fm] for s in S]
            sl.append({'kind': 'table', 'title': f'{o["no"]}. {t} - UI', 'columns': cols, 'rows': rows, 'src': [srcS]})
            sps = sorted({x for b in B for x in b['exec'].split(', ') if x})
            sl.append({'kind': 'table', 'title': f'{o["no"]}. {t} - Batch', 'columns': ['프로시저명', '내용'], 'rows': [[x, ''] for x in sps] or [['배치 SP 없음', '']], 'src': [srcB]})
        elif re.search(r'batch\s*job|배치\s*잡', t, re.I):
            cols = ['NAME', '내용', '주기', '실행']
            for c in o.get('tables', []):
                if len(c) <= 6:
                    cols = c; break
            fm = map_cols(cols)
            rows = [[{'job': j, 'desc': st[0]['desc'], 'schedule': st[0]['schedule'][:60], 'sp': ', '.join(x['exec'] for x in st if x['exec'])[:80], 'steps': str(len(st))}.get(f, '') for f in fm] for j, st in jobs.items()]
            sl.append({'kind': 'table', 'title': f'{o["no"]}. {t}', 'columns': cols, 'rows': rows or [['배치 잡 없음'] + [''] * (len(cols) - 1)], 'src': [srcB]})
        elif re.search(r'흐름도|flow', t, re.I):
            for j, st in list(jobs.items())[:40]:
                nodes = [{'id': f's{x["step"]}', 'label': x['stepName'][:28] or x['exec'][:28], 'sub': x['exec'][:30]} for x in st]
                edges = [{'from': nodes[i]['id'], 'to': nodes[i + 1]['id'], 'label': ''} for i in range(len(nodes) - 1)]
                sl.append({'kind': 'flow', 'title': f'{o["no"]}. {t} - {j[:40]}', 'nodes': nodes, 'edges': edges, 'notes': [f'스케줄: {st[0]["schedule"][:80]}'], 'src': [srcB]})
            for m in plan['modules']:
                for g in m['groups']:
                    ids = g['screens']; es = [e for e in E if e['module'] == m['mod'] and e['from'] in ids and e['to'] in ids]
                    nm = {s['id']: s['name'] for s in S}
                    sl.append({'kind': 'flow', 'title': f'{o["no"]}. 화면 흐름 - {m["mod"]} {g["group"]}', 'nodes': [{'id': i, 'label': i, 'sub': nm.get(i, '')[:24]} for i in ids],
                               'edges': [{'from': e['from'], 'to': e['to'], 'label': e['tables'].split()[0] if e['tables'] else ''} for e in es], 'src': [srcS, srcE]})
        else:
            sl.append({'kind': 'text', 'title': f'{o["no"]}. {t}', 'lines': ['작성 필요(AI 단계)'], 'src': [srcB if re.search(r'점검|배치', t) else srcS]})
        chs.append({'title': f'{o["no"]}. {t}', 'outline': t, 'slides': sl})
    return {'key': k, 'auto': True, 'chapters': chs}


