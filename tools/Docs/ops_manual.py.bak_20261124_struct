COLMAP = [
    (r'level\s*1', 'top'), (r'level\s*2', 'group'), (r'program\s*id|화면\s*id|^id$', 'id'), (r'화면명|screen', 'name'),
    (r'schedule|주기|period', 'schedule'), (r'프로시[저져]\s*설명|description|설명', 'desc'), (r'프로시[저져]명|프로시[저져] 호출|^sp|procedure|실행', 'sp'),
    (r'batch_job|^name$|잡|job', 'job'), (r'step', 'steps'), (r'내용', 'desc'),
]
