def proto_title_shape(slide):
    t = first_line(slide)
    for sh in slide.shapes:
        if sh.has_text_frame and sh.text_frame.text.strip().split('\n')[0].strip() == t:
            return sh
    return None


def new_from(prs, proto, title, keep_tables=False):
    """양식 장표 복제 → 제목, 쪽 번호만 남기고 나머지 도형 지움. 반환 (장표, 쪽 번호 도형)"""
    s = um.dup_slide(prs, proto); tshape = None; page = None; t0 = first_line(proto)
    for sh in list(s.shapes):
        txt = sh.text_frame.text.strip() if sh.has_text_frame else ''
        if tshape is None and txt and txt.split('\n')[0].strip() == t0:
            tshape = sh; continue
        if txt and PAGE_RX.match(txt):
            page = sh; continue
        if keep_tables and sh.has_table:
            continue
        sh._element.getparent().remove(sh._element)
    sub = ''
    sep = ' - ' if ' - ' in title else ' – '  # 양식 제목은 '–', 생성 제목은 '-'
    if len(title) > 34 and sep in title:
        title, sub = title.split(sep, 1)
        m = re.search(r'\s*\(\d+/\d+\)$', sub)
        if m:
            title, sub = title + m.group(0), sub[:m.start()]
    if tshape is not None:
        um.set_text_keep(tshape, title)
    if sub:
        from pptx.util import Pt
        from pptx.dml.color import RGBColor
        W, H = prs.slide_width, prs.slide_height
        tb = s.shapes.add_textbox(int(W * 0.04), int(H * 0.105), int(W * 0.92), int(H * 0.04))
        tb.text_frame.text = sub; r0 = tb.text_frame.paragraphs[0].runs[0]; r0.font.size = Pt(12); r0.font.bold = True; r0.font.color.rgb = RGBColor(0x1F, 0x3B, 0x63)
    return s, page


def body_box(prs):
    W, H = prs.slide_width, prs.slide_height
    return int(W * 0.04), int(H * 0.15), int(W * 0.92), int(H * 0.74)


def add_src(slide, prs, src):
    from pptx.util import Pt
    from pptx.dml.color import RGBColor
    W, H = prs.slide_width, prs.slide_height
    tb = slide.shapes.add_textbox(int(W * 0.04), int(H * 0.91), int(W * 0.8), int(H * 0.04))
    tb.text_frame.text = '근거: ' + ', '.join(src)[:170]
    r = tb.text_frame.paragraphs[0].runs[0]; r.font.size = Pt(7); r.font.color.rgb = RGBColor(0x80, 0x80, 0x80)


def fill_table_proto(t, cols, rows):
    """양식 표: 머리글 = cols, 둘째 행 서식을 복제해 rows 만큼 늘림(양식 표 모양 유지)"""
    tbl = t._tbl; trs = tbl.findall(um.qn('a:tr'))
    proto_tr = copy.deepcopy(trs[1] if len(trs) > 1 else trs[0])
    for tr in trs[1:]:
        tbl.remove(tr)
    for j, cname in enumerate(cols[:len(t.columns)]):
        um.table_set(t, 0, j, cname)
    for tc in proto_tr.iter(um.qn('a:tc')):
        for at in ('rowSpan', 'gridSpan', 'vMerge', 'hMerge'):
            tc.attrib.pop(at, None)  # 양식 표의 병합 칸이 복제 행에 따라오지 않게
    for r in rows:
        tr = copy.deepcopy(proto_tr); tbl.append(tr)
    for i, r in enumerate(rows, 1):
        for j in range(len(t.columns)):
            um.table_set(t, i, j, str(r[j]) if j < len(r) else '')


def split_rows(cols, rows, budget=22, widths=None, total=9000000):
    """행마다 줄 수 = 칸별 글 길이 / 칸 너비(글자 수, 9pt 영문 약 62000 EMU) 최댓값. 장표당 줄 수 합이 budget 넘으면 다음 장"""
    n = max(1, len(cols)); ws = widths if widths and len(widths) == n else [total // n] * n
    cws = [max(4, int(w // 62000)) for w in ws]; parts, cur, used = [], [], 0
    for r in rows:
        h = max([1] + [-(-len(str(x)) // cws[j]) for j, x in enumerate(r[:n])])
        if cur and used + h > budget:
            parts.append(cur); cur, used = [], 0
        cur.append(r); used += h
    parts.append(cur)
    return parts


def render_table(prs, P, sl, pages):
    from pptx.util import Pt
    cols, rows = sl.get('columns', []), sl.get('rows', [])
    proto = P.get('table'); widths = None
    if proto is not None:
        pt = [sh for sh in proto.shapes if sh.has_table][0].table
        if len(pt.columns) == len(cols):
            widths = [c.width for c in pt.columns]
    parts = split_rows(cols, rows, widths=widths)
    for pi, part in enumerate(parts):
        title = sl.get('title', '') + (f' ({pi + 1}/{len(parts)})' if len(parts) > 1 else '')
        proto = P.get('table')
        if proto is not None and len([sh for sh in proto.shapes if sh.has_table][0].table.columns) == len(cols):
            s, pg = new_from(prs, proto, title, keep_tables=True)
            fill_table_proto([sh for sh in s.shapes if sh.has_table][0].table, cols, part)
        else:
            s, pg = new_from(prs, P['body'], title)
            x, y, w, h = body_box(prs)
            t = s.shapes.add_table(len(part) + 1, max(1, len(cols)), x, y, w, min(h, 300000 * (len(part) + 1))).table
            for j, cn in enumerate(cols):
                t.cell(0, j).text = str(cn)
            for i, r in enumerate(part, 1):
                for j in range(len(cols)):
                    t.cell(i, j).text = str(r[j] if j < len(r) else '')
            for row in t.rows:
                for cell in row.cells:
                    for p in cell.text_frame.paragraphs:
                        for rn in p.runs:
                            rn.font.size = Pt(9)
        add_src(s, prs, sl.get('src') or []); pages.append(pg)


def render_text(prs, P, sl, pages, per=15):
    from pptx.util import Pt
    lines = sl.get('lines', []); parts = [lines[i:i + per] for i in range(0, max(1, len(lines)), per)]
    for pi, part in enumerate(parts):
        s, pg = new_from(prs, P['body'], sl.get('title', '') + (f' ({pi + 1}/{len(parts)})' if len(parts) > 1 else ''))
        x, y, w, h = body_box(prs)
        tf = s.shapes.add_textbox(x, y, w, h).text_frame; tf.word_wrap = True
        for i, ln in enumerate(part):
            p = tf.paragraphs[0] if i == 0 else tf.add_paragraph(); txt = str(ln)
            p.text = txt if re.match(r'^(\s|[·\-①-⑳]|\d+[.)]|SELECT|select|  )', txt) else '· ' + txt
            for rn in p.runs:
                rn.font.size = Pt(11)
                if re.match(r'^\s*(SELECT|FROM|WHERE|AND|ORDER|GROUP|EXEC)\b', txt, re.I):
                    rn.font.name = 'Consolas'; rn.font.size = Pt(9)
        add_src(s, prs, sl.get('src') or []); pages.append(pg)


def render_flow(prs, P, sl, pages, per_row=5, max_rows=3):
    """노드 = 둥근 사각형(격자), 연결 = 꺾인 화살표 + 이름표. 들어오는 연결 없는 노드가 앞"""
    from pptx.util import Pt
    from pptx.enum.shapes import MSO_SHAPE, MSO_CONNECTOR
    from pptx.dml.color import RGBColor
    from lxml import etree
    nodes = list(sl.get('nodes', [])); edges = sl.get('edges', [])
    indeg = {n['id']: 0 for n in nodes}
    for e in edges:
        if e.get('to') in indeg and e.get('from') != e.get('to'):
            indeg[e['to']] += 1
    if sl.get('layout') == 'hub':
        return render_hub(prs, P, sl, pages)
    order = sorted(nodes, key=lambda n: (indeg.get(n['id'], 0) > 0, nodes.index(n)))
    cap = per_row * max_rows; parts = [order[i:i + cap] for i in range(0, max(1, len(order)), cap)]
    x0, y0, W, H = body_box(prs); notes = sl.get('notes') or []
    for pi, part in enumerate(parts):
        s, pg = new_from(prs, P['body'], sl.get('title', '') + (f' ({pi + 1}/{len(parts)})' if len(parts) > 1 else ''))
        rows_n = max(1, (len(part) + per_row - 1) // per_row); hh = int(H * (0.8 if notes else 0.97))
        cw, ch = W // per_row, hh // rows_n; bw, bh = int(cw * 0.74), min(int(ch * 0.55), 650000); pos = {}
        for i, n in enumerate(part):
            r, c = divmod(i, per_row); bx, by = x0 + c * cw + (cw - bw) // 2, y0 + r * ch + (ch - bh) // 2
            shp = s.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, bx, by, bw, bh)
            shp.fill.solid(); shp.fill.fore_color.rgb = RGBColor(0xE8, 0xF0, 0xFB); shp.line.color.rgb = RGBColor(0x3B, 0x6E, 0xB5)
            tf = shp.text_frame; tf.word_wrap = True; tf.text = str(n.get('label') or n['id'])[:40]
            r0 = tf.paragraphs[0].runs[0]; r0.font.size = Pt(10); r0.font.bold = True; r0.font.color.rgb = RGBColor(0x1F, 0x3B, 0x63)
            if n.get('sub'):
                p = tf.add_paragraph(); p.text = str(n['sub'])[:34]; p.runs[0].font.size = Pt(7); p.runs[0].font.color.rgb = RGBColor(0x40, 0x40, 0x40)
            pos[n['id']] = (bx, by, bw, bh)
        for e in edges:
            if e.get('from') not in pos or e.get('to') not in pos or e.get('from') == e.get('to'):
                continue
            ax, ay, aw, ah = pos[e['from']]; bx, by, bw, bh = pos[e['to']]
            if abs(ay - by) < 10:
                sx, sy, ex, ey = (ax + aw, ay + ah // 2, bx, by + bh // 2) if ax < bx else (ax, ay + ah // 2, bx + bw, by + bh // 2)
            else:
                sx, sy, ex, ey = (ax + aw // 2, ay + ah, bx + bw // 2, by) if ay < by else (ax + aw // 2, ay, bx + bw // 2, by + bh)
            cn = s.shapes.add_connector(MSO_CONNECTOR.ELBOW, sx, sy, ex, ey)
            cn.line.color.rgb = RGBColor(0x3B, 0x6E, 0xB5); cn.line.width = Pt(1.25)
            etree.SubElement(cn.line._get_or_add_ln(), '{http://schemas.openxmlformats.org/drawingml/2006/main}tailEnd').set('type', 'triangle')
            if e.get('label'):
                tb = s.shapes.add_textbox((sx + ex) // 2 - 550000, (sy + ey) // 2 - 110000, 1100000, 200000)
                tb.text_frame.text = str(e['label'])[:36]; q = tb.text_frame.paragraphs[0].runs[0]; q.font.size = Pt(7); q.font.color.rgb = RGBColor(0x60, 0x60, 0x60)
        if notes and pi == 0:
            tf = s.shapes.add_textbox(x0, y0 + hh, W, H - hh).text_frame; tf.word_wrap = True
            for i, ln in enumerate(notes[:5]):
                p = tf.paragraphs[0] if i == 0 else tf.add_paragraph(); p.text = '· ' + str(ln); p.runs[0].font.size = Pt(9)
        add_src(s, prs, sl.get('src') or []); pages.append(pg)


def render_hub(prs, P, sl, pages):
    """허브 그림(인터페이스 구성도): hub 노드 = 가운데, 나머지 = 왼쪽, 오른쪽 열. 연결 이름표 = 선 위"""
    from pptx.util import Pt
    from pptx.enum.shapes import MSO_SHAPE, MSO_CONNECTOR
    from pptx.dml.color import RGBColor
    from lxml import etree
    nodes = sl.get('nodes', []); hubs = [n for n in nodes if n.get('hub')] or nodes[-1:]; others = [n for n in nodes if n not in hubs]
    s, pg = new_from(prs, P['body'], sl.get('title', '')); x0, y0, W, H = body_box(prs)
    bw, bh = int(W * 0.2), 520000; pos = {}

    def box(n, bx, by, hub=False):
        shp = s.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, bx, by, bw, bh); shp.fill.solid()
        shp.fill.fore_color.rgb = RGBColor(0xFF, 0xF2, 0xCC) if hub else RGBColor(0xE8, 0xF0, 0xFB); shp.line.color.rgb = RGBColor(0x3B, 0x6E, 0xB5)
        tf = shp.text_frame; tf.word_wrap = True; tf.text = str(n.get('label') or n['id'])[:30]
        r0 = tf.paragraphs[0].runs[0]; r0.font.size = Pt(12); r0.font.bold = True; r0.font.color.rgb = RGBColor(0x1F, 0x3B, 0x63)
        if n.get('sub'):
            q = tf.add_paragraph(); q.text = str(n['sub'])[:40]; q.runs[0].font.size = Pt(8); q.runs[0].font.color.rgb = RGBColor(0x40, 0x40, 0x40)
        pos[n['id']] = (bx, by)
    hy = y0 + (H - bh * len(hubs)) // 2
    for i, n in enumerate(hubs):
        box(n, x0 + (W - bw) // 2, hy + i * (bh + 150000), True)
    for col, xs in ((others[0::2], x0), (others[1::2], x0 + W - bw)):
        gap = H // max(1, len(col))
        for i, n in enumerate(col):
            box(n, xs, y0 + i * gap + (gap - bh) // 2)
    for e in sl.get('edges', []):
        if e.get('from') not in pos or e.get('to') not in pos:
            continue
        (ax, ay), (bx, by) = pos[e['from']], pos[e['to']]
        sx, ex = (ax + bw, bx) if ax < bx else (ax, bx + bw)
        sy, ey = ay + bh // 2, by + bh // 2
        cn = s.shapes.add_connector(MSO_CONNECTOR.STRAIGHT, sx, sy, ex, ey); cn.line.color.rgb = RGBColor(0x3B, 0x6E, 0xB5); cn.line.width = Pt(1.25)
        etree.SubElement(cn.line._get_or_add_ln(), '{http://schemas.openxmlformats.org/drawingml/2006/main}tailEnd').set('type', 'triangle')
        if e.get('label'):
            tb = s.shapes.add_textbox(min(sx, ex) + 60000, (sy + ey) // 2 - 240000, max(300000, abs(ex - sx) - 120000), 220000)
            tb.text_frame.text = str(e['label'])[:60]; q = tb.text_frame.paragraphs[0].runs[0]; q.font.size = Pt(7); q.font.color.rgb = RGBColor(0x60, 0x60, 0x60)
    if sl.get('notes'):
        tf = s.shapes.add_textbox(x0, y0 + H - 400000, W, 400000).text_frame; tf.word_wrap = True
        tf.text = ' / '.join(sl['notes'])[:200]; tf.paragraphs[0].runs[0].font.size = Pt(9)
    add_src(s, prs, sl.get('src') or []); pages.append(pg)


def fill_cover(slide, key, inp):
    """표지: 글 상자 역할로 바꿈(일자, 버전, 관리부서·작성자, 가장 큰 글 = 제목, 나머지 = 프로젝트). 양식 글 남기지 않음"""
    tfs = [sh for sh in slide.shapes if sh.has_text_frame and sh.text_frame.text.strip()]

    def size(sh):
        v = [r.font.size or 0 for p in sh.text_frame.paragraphs for r in p.runs]
        return max(v) if v else 0
    done = set()
    for sh in tfs:
        t = sh.text_frame.text
        if re.search(r'\d{4}\s*[-./]\s*\d{1,2}\s*[-./]\s*\d{1,2}', t):
            um.set_text_keep(sh, inp['date']); done.add(id(sh))
        elif re.search(r'(?i)\bver(sion)?\b', t):
            um.set_text_keep(sh, inp['version']); done.add(id(sh))
        elif re.search(r'관리부서|작성자|Author', t, re.I):
            um.set_text_keep(sh, f'작성자 : {inp["author"]}'); done.add(id(sh))
    rest = sorted([sh for sh in tfs if id(sh) not in done], key=size, reverse=True)
    if rest:
        um.set_text_keep(rest[0], f'NSCM 운영자 매뉴얼 ({key.replace("_", ", ")})')
    for sh in rest[1:]:
        um.set_text_keep(sh, 'LG Energy Solution NSCM')


def fill_toc(slide, key, inp, items):
    tfs = [sh for sh in slide.shapes if sh.has_text_frame and sh.text_frame.text.strip()]
    for sh in tfs:
        t = sh.text_frame.text.strip()
        if re.search(r'\d{4}\s*[-./]\s*\d{1,2}\s*[-./]\s*\d{1,2}', t):
            um.set_text_keep(sh, inp['date'])
        elif re.search(r'매뉴얼|manual', t, re.I) and len(t) < 40:
            um.set_text_keep(sh, f'운영자 매뉴얼 ({key.replace("_", ", ")})')
    lists = [sh for sh in tfs if len(sh.text_frame.paragraphs) >= 3]
    if lists:
        box = max(lists, key=lambda sh: len(sh.text_frame.paragraphs)); n0 = len(box.text_frame.paragraphs)
        sz = [r.font.size for p in box.text_frame.paragraphs for r in p.runs if r.font.size]
        names = []
        for it in items:
            t = re.sub(r'^\s*\d+(?:[.-]\d+)?\s*\.{0,2}\s*', '', it)  # 양식 목록이 번호를 붙임
            if t not in names:
                names.append(t)
        um.set_text_keep(box, '\n'.join(names))
        if sz and len(names) > n0:
            from pptx.util import Pt
            new = max(Pt(10), int(sz[0] * n0 / len(names)))
            for p in box.text_frame.paragraphs:
                for r in p.runs:
                    r.font.size = new


def fill_rev(slide, inp):
    for sh in slide.shapes:
        if not sh.has_table:
            continue
        t = sh.table
        for r in range(1, len(t.rows)):
            for cc in range(len(t.columns)):
                um.table_set(t, r, cc, '')
        for cc, h in enumerate(c.text for c in t.rows[0].cells):
            v = inp['version'] if re.search(r'버전|Ver|Rev', h, re.I) else inp['date'] if re.search(r'일자|날짜|Date', h, re.I) else inp['author'] if re.search(r'작성자|Author', h, re.I) else '최초 작성' if re.search(r'내용|Desc|변경', h, re.I) else ''
            if len(t.rows) > 1:
                um.table_set(t, 1, cc, v)
        return


def cmd_build(a):
    from pptx import Presentation
    key = um.mod_key(a.module); d = odir(key); inp = inputs_of(key); plan = um.rj(os.path.join(d, PLAN), None)
    if not plan:
        out('[FAIL] plan.json 없음. prep 먼저'); return 2
    c, name = load_content(key)
    if not c:
        out(f'[FAIL] 내용 없음(content/{MAIN}, {AUTO})'); return 2
    prs = Presentation(inp['template']); orig = list(prs.slides); n0 = len(orig); R = roles(prs)
    P = {k: orig[v] for k, v in R.items()}
    if 'body' not in P:
        P['body'] = orig[min(len(orig) - 1, 4)]
    chs = c.get('chapters', [])
    toc = []
    for ch in chs:
        t = re.sub(r'\s*[–-].*$', '', str(ch.get('title', '')))
        if not ch.get('divider') and t not in toc:
            toc.append(t)
    pages = []
    for ch in chs:
        if ch.get('divider'):
            if 'divider' in P:
                s = um.dup_slide(prs, P['divider'])
                for sh in s.shapes:
                    if sh.has_text_frame and sh.text_frame.text.strip():
                        um.set_text_keep(sh, ch.get('title', '')); break
            continue
        for sl in ch.get('slides', []):
            k = sl.get('kind')
            if k == 'flow':
                render_flow(prs, P, sl, pages)
            elif k == 'table':
                render_table(prs, P, sl, pages)
            else:
                render_text(prs, P, sl, pages)
    if 'end' in P:
        um.dup_slide(prs, P['end'])
    keep = sorted({R[k] for k in ('cover', 'rev', 'toc') if k in R})
    fill_cover(orig[0], key, inp)
    if 'rev' in R:
        fill_rev(orig[R['rev']], inp)
    if 'toc' in R:
        fill_toc(orig[R['toc']], key, inp, toc)
    ids = list(prs.slides._sldIdLst)
    for i in reversed(range(n0)):
        if i not in keep:
            prs.part.drop_rel(ids[i].get('{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id')); prs.slides._sldIdLst.remove(ids[i])
    total = len(prs.slides)
    idx = {id(s): i + 1 for i, s in enumerate(prs.slides)}
    for pg in pages:
        if pg is not None:
            sl = pg.part.slide if hasattr(pg, 'part') else None
            no = idx.get(id(sl), '') if sl is not None else ''
            um.set_text_keep(pg, f'{no}/{total}' if no else '')
    f = os.path.join(d, f'SCM_OM_운영자매뉴얼_{key}_v{um.ver_tag(inp["version"])}.pptx')
    try:
        prs.save(f)
    except PermissionError:
        out(f'[FAIL] 파일이 열려 있어 저장하지 못함: {rel(f)}. PowerPoint 에서 닫고 다시 실행'); return 4
    out(f'[OK] build {key}: {rel(f)} · 장표 {total}장(양식 유지 {len(keep)}, 본문 {total - len(keep)}) · 내용 {name} · 양식 역할 {R}')
    return 0


def main():
    ap = argparse.ArgumentParser(); ap.add_argument('cmd', choices=['prep', 'check', 'build']); ap.add_argument('--module', required=True)
    a = ap.parse_args()
    return {'prep': cmd_prep, 'check': cmd_check, 'build': cmd_build}[a.cmd](a)


if __name__ == '__main__':
    sys.exit(main())
