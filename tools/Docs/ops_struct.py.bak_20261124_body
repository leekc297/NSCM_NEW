SYS_SP = re.compile(r'^SP_|^XP_', re.I)  # SQL Server 시스템 프로시저(sp_start_job, sp_executesql)
NO_DESC = re.compile(r'^\s*$|설명이 없습니다|No description', re.I)
SQL_KW = {'SELECT', 'WHERE', 'SET', 'VALUES', 'TOP', 'WITH', 'AS', 'ON', 'AND', 'OR', 'NOT', 'NULL', 'EXISTS', 'OPENQUERY', 'DUAL', 'INSERTED', 'DELETED', 'OUTPUT', 'STRING_SPLIT', 'OPENJSON'}


def rcsv(f):
    try:
        with open(f, encoding='utf-8-sig', newline='') as fh:
            return list(csv.DictReader(fh))
    except Exception:
        return []


def wcsv(path, rows, cols):
    with open(path, 'w', encoding='utf-8-sig', newline='') as fh:
        w = csv.DictWriter(fh, fieldnames=cols, extrasaction='ignore'); w.writeheader()
        for r in rows:
            w.writerow(r)


def srcp(key, n):
    """근거 경로(저장소 기준). OPS_MANUAL_OUT 이면 그 폴더 기준"""
    base = os.environ.get('OPS_MANUAL_OUT') or os.path.join(ROOT, 'Doc', 'OpsManual')
    return os.path.relpath(os.path.join(base, key, 'facts', n), ROOT).replace(os.sep, '/')


def proc_of(job, execs):
    s = (job + ' ' + ' '.join(execs)).upper()
    for name, rx in PROC_RULES:
        if not rx or re.search(rx, s):
            return name
    return '기타'


def hhmm(v):
    try:
        v = int(v)
    except Exception:
        return ''
    return f'{v // 10000:02d}:{(v // 100) % 100:02d}'


def sched_info(s):
    """msdb.sysschedules 한 줄 → { days, every, times, hours, on }"""
    try:
        ft, fi, st, si = int(s['freq_type']), int(s['freq_interval']), int(s['freq_subday_type']), int(s['freq_subday_interval'])
        rf = int(s.get('freq_recurrence_factor') or 0); a, b = int(s['active_start_time']), int(s['active_end_time'])
    except Exception:
        return {'days': '해독 불가', 'every': '', 'times': [], 'hours': [], 'on': s.get('enabled') == '1'}
    days = {1: '1회', 4: '매일' if fi == 1 else f'{fi}일마다', 8: (f'{rf}주마다 ' if rf > 1 else '') + ','.join(d for i, d in enumerate(DOW) if fi & (1 << i)),
            16: f'매월 {fi}일', 32: '매월 상대일', 64: 'Agent 시작 때', 128: '유휴 때'}.get(ft, f'freq_type {ft}')
    if st in (2, 4, 8):
        unit = {2: '초', 4: '분', 8: '시간'}[st]
        return {'days': days, 'every': f'{si}{unit}마다 {hhmm(a)}~{hhmm(b)}', 'times': [], 'hours': list(range(a // 10000, b // 10000 + 1)), 'on': s.get('enabled') == '1'}
    return {'days': days, 'every': '', 'times': [hhmm(a)], 'hours': [a // 10000], 'on': s.get('enabled') == '1'}


# ───────────────────────── AS-IS SP 본문(읽기, 쓰기 테이블) ─────────────────────────
_DDL = None


def ddl_index():
    """AS-IS SP DDL 파일(Doc/_legacy_source/DB_DDL/AsIs_*SP*_DDL.sql) → { SP이름: (파일, 시작, 끝) }"""
    global _DDL
    if _DDL is not None:
        return _DDL
    _DDL = {}
    for f in sorted(glob.glob(os.path.join(DDL_DIR, 'AsIs_*SP*_DDL.sql'))):
        try:
            t = open(f, encoding='utf-8', errors='ignore').read()
        except Exception:
            continue
        ms = list(re.finditer(r'(?im)^\s*CREATE\s+(?:OR\s+ALTER\s+)?PROC(?:EDURE)?\s+(?:\[?\w+\]?\.)?\[?(\w+)\]?', t))
        for i, m in enumerate(ms):
            _DDL.setdefault(m.group(1).upper(), (f, m.start(), ms[i + 1].start() if i + 1 < len(ms) else len(t)))
    return _DDL


_TXT = {}


def sp_body(name):
    ix = ddl_index().get(name.upper())
    if not ix:
        return ''
    f, a, b = ix
    if f not in _TXT:
        _TXT[f] = open(f, encoding='utf-8', errors='ignore').read()
    return _TXT[f][a:b]


def tbl_names(rx, body):
    out = set()
    for m in re.finditer(rx, body):
        n = m.group(1).upper()
        if n.startswith(('#', '@')) or n in SQL_KW or len(n) < 4 or '_' not in n:
            continue
        out.add(n)
    return out


def sp_io(name):
    """SP 본문 문자열 기준 쓰기, 읽기 테이블(INSERT, UPDATE, MERGE, DELETE, TRUNCATE = 쓰기 · FROM, JOIN = 읽기). 본문 없으면 (None, None)"""
    b = re.sub(r'(?s)/\*.*?\*/', ' ', sp_body(name)); b = re.sub(r'--[^\n]*', ' ', b)
    if not b.strip():
        return None, None
    w = tbl_names(r'(?is)\b(?:INSERT\s+(?:INTO\s+)?|UPDATE\s+|MERGE\s+(?:INTO\s+)?|DELETE\s+(?:FROM\s+)?|TRUNCATE\s+TABLE\s+)(?:\[?\w+\]?\.)?(?:\[?\w+\]?\.)?\[?([#@]?\w+)\]?', b)
    cur = {m.upper() for m in re.findall(r'(?is)\bDECLARE\s+(\w+)\s+(?:INSENSITIVE\s+|SCROLL\s+)*CURSOR\b', b)}  # 커서 이름 = 테이블 아님
    r = tbl_names(r'(?is)(?<!FETCH\s)(?<!NEXT\s)\b(?:FROM|JOIN)\s+(?:\[?\w+\]?\.)?(?:\[?\w+\]?\.)?\[?([#@]?\w+)\]?', b) - w - cur
    return sorted(w - cur), sorted(r)


# ───────────────────────── 사실 수집(prep) ─────────────────────────
def collect(d, plan, S, B, common_rx):
    """facts/jobs.csv, timeline.csv, job_links.csv, sp_tables.csv, tables.csv. 반환 요약 dict"""
    jobs_meta = {j['name']: j for j in rcsv(os.path.join(BATCH, 'agent_jobs.csv'))}
    hist = {h['job_name']: h for h in rcsv(os.path.join(BATCH, 'agent_jobhistory_summary.csv'))}
    sch = {}
    for s in rcsv(os.path.join(BATCH, 'agent_schedules.csv')):
        sch.setdefault(s['job_name'], []).append(s)
    mods_jobs = {}
    for b in B:
        mods_jobs.setdefault(b['job'], []).append(b)
    steps_cmd = {}
    for st in rcsv(os.path.join(BATCH, 'agent_jobsteps.csv')):
        if st['job_name'] in mods_jobs:
            steps_cmd.setdefault(st['job_name'], []).append(st.get('command') or '')
    J, T, L, SPT = [], [], [], {}
    for job, st in mods_jobs.items():
        execs = [x for b in st for x in b['exec'].split(', ') if x and not SYS_SP.match(x)]
        meta = jobs_meta.get(job, {}); h = hist.get(job, {})
        J.append({'job': job, 'module': st[0]['module'], 'process': proc_of(job, execs), 'enabled': meta.get('enabled', ''), 'desc': (meta.get('description') or '').replace('\r', ' ').replace('\n', ' ')[:300],
                  'schedule': st[0]['schedule'], 'steps': len(st), 'exec': ', '.join(dict.fromkeys(execs)), 'ext': next((b['ext'] for b in st if b['ext']), ''),
                  'runs': h.get('runs', ''), 'failed': h.get('failed', ''), 'lastOutcome': st[-1]['lastOutcome'], 'lastRun': st[-1]['lastRun']})
        for s in sch.get(job, []) or [{}]:
            if not s:
                T.append({'job': job, 'jobOn': meta.get('enabled', ''), 'on': '', 'days': '스케줄 없음', 'every': '', 'times': '', 'hours': ''}); continue
            i = sched_info(s)
            T.append({'job': job, 'jobOn': meta.get('enabled', ''), 'on': '1' if i['on'] else '0', 'days': i['days'], 'every': i['every'], 'times': ' '.join(i['times']), 'hours': ' '.join(str(x) for x in i['hours'])})
        for cmd in steps_cmd.get(job, []):
            for m in re.finditer(r"(?i)sp_start_job\s+(?:@job_name\s*=\s*)?N?'([^']+)'", cmd):
                L.append({'from': job, 'to': m.group(1), 'how': 'sp_start_job'})
        for sp in dict.fromkeys(execs):
            if sp not in SPT:
                w, r = sp_io(sp)
                SPT[sp] = {'sp': sp, 'found': 'Y' if w is not None else 'N', 'writes': ' '.join(w or []), 'reads': ' '.join(r or [])}
    tables = {}

    def tb(n):
        return tables.setdefault(n, {'table': n, 'kind': next((k for rx, k in TBL_KIND if re.search(rx, n)), '기타'), 'screenWrites': set(), 'screenReads': set(), 'batchWrites': set(), 'batchReads': set()})
    for s in S:
        for t in s['writes'].split():
            if not common_rx.search(t):
                tb(t)['screenWrites'].add(s['id'])
        for t in s['reads'].split():
            if not common_rx.search(t) and t in tables:
                tables[t]['screenReads'].add(s['id'])
    for sp in SPT.values():
        for t in sp['writes'].split():
            if not common_rx.search(t):
                tb(t)['batchWrites'].add(sp['sp'])
    for sp in SPT.values():
        for t in sp['reads'].split():
            if t in tables:
                tables[t]['batchReads'].add(sp['sp'])
    for s in S:  # 쓰는 곳이 생긴 뒤 화면 읽기 다시
        for t in s['reads'].split():
            if t in tables:
                tables[t]['screenReads'].add(s['id'])
    TB = [{k: (' '.join(sorted(v)) if isinstance(v, set) else v) for k, v in x.items()} for x in sorted(tables.values(), key=lambda x: (x['kind'], x['table']))]
    wcsv(os.path.join(d, 'facts', 'jobs.csv'), J, ['job', 'module', 'process', 'enabled', 'desc', 'schedule', 'steps', 'exec', 'ext', 'runs', 'failed', 'lastOutcome', 'lastRun'])
    wcsv(os.path.join(d, 'facts', 'timeline.csv'), T, ['job', 'jobOn', 'on', 'days', 'every', 'times', 'hours'])
    wcsv(os.path.join(d, 'facts', 'job_links.csv'), L, ['from', 'to', 'how'])
    wcsv(os.path.join(d, 'facts', 'sp_tables.csv'), list(SPT.values()), ['sp', 'found', 'writes', 'reads'])
    wcsv(os.path.join(d, 'facts', 'tables.csv'), TB, ['table', 'kind', 'screenWrites', 'screenReads', 'batchWrites', 'batchReads'])
    return {'jobs': len(J), 'schedules': len(T), 'links': len(L), 'sps': len(SPT), 'spFound': sum(1 for x in SPT.values() if x['found'] == 'Y'), 'tables': len(TB),
            'processes': sorted({j['process'] for j in J}, key=lambda p: PROC_ORDER.index(p) if p in PROC_ORDER else 99)}


def facts(d):
    f = lambda n: rcsv(os.path.join(d, 'facts', n))
    return {'S': f('screens.csv'), 'J': f('jobs.csv'), 'T': f('timeline.csv'), 'L': f('job_links.csv'), 'SPT': f('sp_tables.csv'), 'TB': f('tables.csv'), 'B': f('batch.csv'), 'E': f('flow_edges.csv')}


def processes(F, content):
    po = (content or {}).get('processOf') or {}
    for j in F['J']:
        j['process'] = po.get(j['job']) or j['process']
    order = list((content or {}).get('processOrder') or []) + [p for p in PROC_ORDER]
    names = []
    for j in F['J']:
        if j['process'] not in names:
            names.append(j['process'])
    return sorted(names, key=lambda p: order.index(p) if p in order else 99)


