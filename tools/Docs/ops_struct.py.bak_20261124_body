        return sl
    if cid == 'C6':
        # AS-IS 잡 추출 원천 = 개발 DB(LGCE_SCMDEV, Doc/asisfacts/db/batch/_extract_log.md). 사용 여부는 개발 DB 값이라 실행표, 요약에 쓰지 않음(운영 미확인)
        bands = [(0, 6), (6, 12), (12, 18), (18, 24)]; on = [t for t in T if t['days'] != '스케줄 없음']
        cnt = [[sum(1 for t in on if any(a <= int(h) < b for h in t['hours'].split())) for a, b in bands]]
