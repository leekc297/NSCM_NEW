def rel(p):
    return os.path.relpath(p, ROOT).replace('\\', '/')


def rcsv(f):
    try:
        with open(f, encoding='utf-8-sig', newline='') as fh:
            return list(csv.DictReader(fh))
    except Exception:
        return []


def norm(s):
    return re.sub(r'[^0-9a-z가-힣]', '', str(s or '').lower())


def inputs_of(key):
