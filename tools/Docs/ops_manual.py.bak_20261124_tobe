    for k in ('author', 'date', 'version', 'template'):
        if not str(inp.get(k) or '').strip():
            raise SystemExit(f'입력 빠짐: {k} (Doc/OpsManual/{key}/_inputs.json)')
    if not os.path.exists(inp['template']):
