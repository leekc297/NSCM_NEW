from pptx.oxml.ns import qn  # noqa: E402

RID = qn('r:id'); REMBED = qn('r:embed'); RLINK = qn('r:link')


def dup_slide(prs, src):
    """src 장표를 끝에 복제(그림 관계 유지 · 다른 장표로 가는 링크는 제거)"""
    new = prs.slides.add_slide(src.slide_layout)
    for sh in list(new.shapes):
        sh._element.getparent().remove(sh._element)
    rmap = {}
    for rid, rel in src.part.rels.items():
        if rel.is_external:
            continue
        if 'image' in rel.reltype or 'media' in rel.reltype:
            rmap[rid] = new.part.relate_to(rel.target_part, rel.reltype)
    for el in src.shapes._spTree.iterchildren():
        tag = el.tag.split('}')[-1]
        if tag in ('nvGrpSpPr', 'grpSpPr'):
            continue
        e2 = copy.deepcopy(el)
        for node in e2.iter():
            for attr in (REMBED, RLINK, RID):
                v = node.get(attr)
                if v is None:
                    continue
                if v in rmap:
                    node.set(attr, rmap[v])
                elif node.tag.endswith('hlinkClick') or node.tag.endswith('hlinkHover'):
                    node.attrib.pop(attr, None)
                else:
                    node.attrib.pop(attr, None)
        new.shapes._spTree.append(e2)
    return new


def drop_slides(prs, keep_from):
    sld = prs.slides._sldIdLst
    for s in list(sld)[:keep_from]:
        rid = s.get(RID); prs.part.drop_rel(rid); sld.remove(s)


def set_text_keep(shape_or_cell, text):
    """첫 문단 첫 글자 서식으로 글을 바꿈(줄바꿈 = 문단)"""
    tf = shape_or_cell.text_frame
    ps = tf.paragraphs
    p0 = ps[0]._p
    r0 = p0.find(qn('a:r'))
    rpr = copy.deepcopy(r0.find(qn('a:rPr'))) if r0 is not None and r0.find(qn('a:rPr')) is not None else None
    ppr = copy.deepcopy(p0.find(qn('a:pPr'))) if p0.find(qn('a:pPr')) is not None else None
    end = p0.find(qn('a:endParaRPr'))
    body = p0.getparent()
    for p in list(body.findall(qn('a:p'))):
        body.remove(p)
    for line in str(text).split('\n'):
        body.append(make_para(ppr, rpr, line, end))


def make_para(ppr, rpr, text, end=None):
    from lxml import etree
    p = etree.SubElement(etree.Element('dummy'), qn('a:p'))
    p = copy.deepcopy(p);
    if ppr is not None:
        p.append(copy.deepcopy(ppr))
    if text != '':
        r = etree.SubElement(p, qn('a:r'))
        if rpr is not None:
            r.append(copy.deepcopy(rpr))
        t = etree.SubElement(r, qn('a:t')); t.text = text
    elif end is not None:
        p.append(copy.deepcopy(end))
    return p


def para_styles(shape):
    """설명 상자 문단 서식 3종: 제목(●), 소제목(①), 본문(-)"""
    sty = {}
    for p in shape.text_frame.paragraphs:
        t = p.text.strip()
        k = 'title' if t.startswith('●') else 'sec' if t[:1] in CIRCLED else 'line' if t.startswith('-') else None
        if k and k not in sty:
            r0 = p._p.find(qn('a:r'))
            rpr = r0.find(qn('a:rPr')) if r0 is not None else None
            if rpr is None:  # 글자 서식이 없는 문단은 견본으로 쓰지 않음(샘플 ② 문단 = 서식 없음 → 화면에 안 보임)
                continue
            sty[k] = (copy.deepcopy(p._p.find(qn('a:pPr'))) if p._p.find(qn('a:pPr')) is not None else None, copy.deepcopy(rpr))
    base = sty.get('line') or sty.get('sec') or sty.get('title') or (None, None)
    for k in ('title', 'sec', 'line'):
        sty.setdefault(k, base)
    return sty


def fill_desc(shape, title, sections, overview=None):
    sty = para_styles(shape)
    body = shape.text_frame._txBody
    end = None
    for p in body.findall(qn('a:p')):
        e = p.find(qn('a:endParaRPr'))
        if e is not None and end is None:
            end = e
        body.remove(p)
    body.append(make_para(*sty['title'], f'● {title}'))
    # 2026-11-23 사용자: 조회 조건 설명 전에 화면 설명(overview)이 먼저
    for ln in ov_lines(overview):
        body.append(make_para(*sty['line'], ln))
    for s in sections:
        body.append(make_para(*sty['line'], '', end))
        no = int(s.get('no') or 0)
        mark = CIRCLED[no - 1] if 1 <= no <= len(CIRCLED) else f'({no})'
        body.append(make_para(*sty['sec'], f'{mark} {s.get("title", "")}'.strip()))
        for ln in s.get('lines') or []:
            ln = str(ln).strip()
            body.append(make_para(*sty['line'], ln if ln.startswith('-') else f' - {ln}'))


def table_set(tbl, r, c, text):
    try:
        set_text_keep(tbl.cell(r, c), text)
    except Exception:
        pass


def find_shapes(slide):
    f = {'title': None, 'head': None, 'key': None, 'desc': None, 'frame': None, 'pic': None, 'ellipse': None, 'others': []}
    for sh in slide.shapes:
        if sh.is_placeholder and sh.placeholder_format.type == 1:
            f['title'] = sh
        elif sh.has_table:
            first = sh.table.cell(0, 0).text.strip().replace(' ', '').lower()
            if first == '메뉴':
                f['head'] = sh
            elif first == 'keypoint':
                f['key'] = sh
        elif sh.shape_type == 13:
            if f['pic'] is None or sh.width * sh.height > f['pic'].width * f['pic'].height:
                if f['pic'] is not None:
                    f['others'].append(f['pic'])
                f['pic'] = sh
            else:
                f['others'].append(sh)
        elif sh.has_text_frame and sh.text_frame.text.strip().startswith('●'):
            f['desc'] = sh
        elif sh.name.startswith('타원') or (sh.has_text_frame and re.fullmatch(r'[0-9A-Z]', sh.text_frame.text.strip() or '#') and sh.width < 1.0 * EMU_CM):
            if f['ellipse'] is None:
                f['ellipse'] = sh
            else:
                f['others'].append(sh)
        elif sh.shape_type == 1 and not sh.text_frame.text.strip() if sh.has_text_frame else False:
            f['others'].append(sh)
    # 그림 테두리 = 그림을 감싸는 가장 큰 빈 사각형
    best = None
    for sh in list(f['others']):
        if sh.shape_type == 1 and sh.has_text_frame and not sh.text_frame.text.strip() and f['pic'] is not None:
            if sh.left <= f['pic'].left + EMU_CM and sh.left + sh.width >= f['pic'].left + f['pic'].width - EMU_CM and sh.height > 5 * EMU_CM:
                if best is None or sh.width * sh.height > best.width * best.height:
                    best = sh
    if best is not None:
        f['others'].remove(best); f['frame'] = best
    return f


def place_picture(slide, pic, frame, img_path):
    from PIL import Image
    with Image.open(img_path) as im:
        w, h = im.size
    box = frame if frame is not None else pic
    bx, by, bw, bh = box.left, box.top, box.width, box.height
    pad = int(0.1 * EMU_CM)
    bw2, bh2 = bw - 2 * pad, bh - 2 * pad
    sc = min(bw2 / w, bh2 / h)
    nw, nh = int(w * sc), int(h * sc)
    _, rid = slide.part.get_or_add_image_part(img_path)
    blip = pic._element.find('.//' + qn('a:blip'))
    blip.set(REMBED, rid)
    pic.left, pic.top, pic.width, pic.height = bx + (bw - nw) // 2, by + (bh - nh) // 2, nw, nh
    sp = pic._element.find('.//' + qn('a:srcRect'))
    if sp is not None:
        sp.getparent().remove(sp)
    return pic


def add_marker(slide, tmpl, pic, m):
    e = copy.deepcopy(tmpl._element)
    slide.shapes._spTree.append(e)
    sh = slide.shapes[-1]
    size = tmpl.width
    sh.left = int(pic.left + float(m['x']) * pic.width - size / 2)
    sh.top = int(pic.top + float(m['y']) * pic.height - size / 2)
    set_text_keep(sh, str(m.get('no', '')))
    return sh


def wrap_lines(text, width_chars):
    n = 0
    for ln in str(text).split('\n'):
        w = sum(2 if ord(ch) > 0x1100 else 1 for ch in ln)
        n += max(1, -(-w // width_chars))
    return n


def ov_lines(ov):
    """화면 설명 → 줄 목록(문자열이면 줄바꿈으로 나눔)"""
    if not ov:
        return []
    return [str(x).strip() for x in (ov if isinstance(ov, list) else str(ov).split('\n')) if str(x).strip()]


def split_page(page, max_lines=30, width_chars=56):
    """설명이 길면 섹션 단위로 다음 장표로 나눔(마커도 섹션 번호를 따라감)"""
    secs = page.get('sections') or []
    ov_used = sum(wrap_lines(l, width_chars) for l in ov_lines(page.get('overview')))  # 화면 설명은 첫 장에만
    chunks, cur, used = [], [], 2 + ov_used
    for s in secs:
        need = 2 + sum(wrap_lines(l, width_chars) for l in (s.get('lines') or []))
        if cur and used + need > max_lines:
            chunks.append(cur); cur, used = [], 2
        cur.append(s); used += need
    if cur:
        chunks.append(cur)
    if len(chunks) <= 1:
        return [page]
    res = []
    for k, ch in enumerate(chunks):
        nos = {int(s.get('no') or 0) for s in ch}
        res.append(dict(page, sections=ch, overview=page.get('overview') if k == 0 else None, markers=[m for m in (page.get('markers') or []) if int(m.get('no') or 0) in nos]))
    return res


def base_title(t):
    """제목 끝 '(1/2)' 같은 장 번호를 뗌. 번호는 생성기가 화면별 전체 장 수로 한 번만 붙임(2026-11-23 '(1/2) (1/2)' 중복)"""
    return re.sub(r'(\s*\(\d+\s*/\s*\d+\))+\s*$', '', str(t or '')).strip()


def render_screen(prs, tmpl, c, page, title, inp, d, part_no=None):
    s = dup_slide(prs, tmpl)
    f = find_shapes(s)
    for sh in f['others']:
        sh._element.getparent().remove(sh._element)
    if f['title'] is not None:
        set_text_keep(f['title'], title + (f' ({part_no})' if part_no else ''))
    if f['head'] is not None:
        t = f['head'].table
        table_set(t, 0, 1, c.get('menuPath', '')); table_set(t, 0, 3, inp['author']); table_set(t, 0, 5, inp['version'])
        table_set(t, 1, 1, c.get('uiName', title)); table_set(t, 1, 3, inp['date'])
        table_set(t, 2, 1, c.get('definition', ''))
    if f['key'] is not None:
        table_set(f['key'].table, 0, 1, page.get('keyPoint') or c.get('keyPoint') or '')
    if f['desc'] is not None:
        fill_desc(f['desc'], base_title(page.get('title') or title), page.get('sections') or [], page.get('overview'))
    cap = page.get('capture') or ((c.get('captures') or [None])[0])
    ell = f['ellipse']
    if cap and f['pic'] is not None and os.path.exists(os.path.join(d, cap)):
        pic = place_picture(s, f['pic'], f['frame'], os.path.join(d, cap))
        if ell is not None:
            for m in page.get('markers') or []:
                add_marker(s, ell, pic, m)
    elif f['pic'] is not None:
        f['pic']._element.getparent().remove(f['pic']._element)
        if f['frame'] is not None and f['frame'].has_text_frame:
            set_text_keep(f['frame'], '최신 UI 캡처 없음')
    if ell is not None:
        ell._element.getparent().remove(ell._element)
    return s


LABEL_EN = {'상단 메뉴': 'Top Menu', '모듈 메뉴': 'Module Menu', '왼쪽 메뉴': 'Menu Tree', '메뉴 트리': 'Menu Tree', '화면 탭': 'Screen Tab', '화면 제목': 'Screen Title',
