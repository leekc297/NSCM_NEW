def mods_of(key):
    """'DM_SYSTEM' 같은 묶음 키 → ['DM', 'SYSTEM'](MOD_ORDER 순) · 모르는 모듈이면 종료"""
    ms = [m for m in str(key).upper().replace('+', '_').replace(',', '_').split('_') if m]
    bad = [m for m in ms if m not in MODULES]
    if bad or not ms:
        raise SystemExit(f'모듈 아님: {", ".join(bad) or key} (DM, SCP, SSP, SYSTEM 또는 DM_SYSTEM 처럼 묶음)')
    return [m for m in MOD_ORDER if m in ms]


def mod_key(key):
    return '_'.join(mods_of(key))


