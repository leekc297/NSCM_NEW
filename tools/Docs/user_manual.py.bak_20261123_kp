def check_content(c, has_cap):
    why = []
    if c['id'] == '_LAYOUT':
        if not c.get('captures'):
            why.append('captures 없음')
        if not c.get('labels'):
            why.append('labels 없음')
        han = [lb.get('text', '') for lb in c.get('labels') or [] if re.search('[가-힣]', str(lb.get('text', '')))]
        if han:  # 2026-11-23 사용자: Layout 영역 표기 = 영문
            why.append(f'labels 영문 아님: {", ".join(han)}')
        return why
    if not str(c.get('definition') or '').strip():
        why.append('definition 비어 있음')
    if c['id'] != '_COMMON' and not ov_lines(c.get('overview') or ((c.get('pages') or [{}])[0].get('overview'))):
        why.append('overview(조회 조건 앞 화면 설명 2~4줄) 없음')
    pages = c.get('pages') or []
    if not pages:
        why.append('pages 없음')
    for i, pg in enumerate(pages, 1):
        secs = pg.get('sections') or []
        if not secs:
            why.append(f'page {i} sections 없음')
        if not str(pg.get('keyPoint') or c.get('keyPoint') or '').strip():
            why.append(f'page {i} keyPoint 없음')
        for m in pg.get('markers') or []:
            if not (0 <= float(m.get('x', -1)) <= 1 and 0 <= float(m.get('y', -1)) <= 1):
                why.append(f'page {i} marker {m.get("no")} 위치 범위 밖(0~1)')
        if has_cap and secs and not pg.get('markers'):
            why.append(f'page {i} markers 없음(캡처 있음)')
    return why


def texts_of(c):
    """매뉴얼에 들어가는 문장(UI 정의, 소제목, 설명 줄, Key Point, 이름표)"""
    t = [c.get('definition', ''), c.get('keyPoint', '')] + ov_lines(c.get('overview'))
    for pg in c.get('pages') or []:
        t.append(pg.get('keyPoint', ''))
        for s in pg.get('sections') or []:
            t.append(s.get('title', '')); t += [str(x) for x in s.get('lines') or []]
    t += [lb.get('text', '') for lb in c.get('labels') or []]
    return [x for x in t if str(x).strip()]


def style_hits(c):
    """문장 규칙(tools/VibeManager/rules/50_DOC_STYLE.md) 위반 → ['종류 «걸린 표현»']"""
    try:
