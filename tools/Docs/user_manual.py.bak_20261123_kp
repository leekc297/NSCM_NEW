def label_en(t):
    """Layout 이름표 = 영문(2026-11-23 사용자). 한글이면 자주 쓰는 이름 표로 바꿈(검사 단계가 한글을 실패로 잡아 AI 가 고침)"""
    t = str(t or '').strip()
    return LABEL_EN.get(t, t)


def fit_font(shape, pt):
    """이름표 글자 크기를 pt 로 고정하고 줄바꿈을 끔(상자 크기는 글자 길이로 이미 맞춤)"""
    tf = shape.text_frame; tf.word_wrap = False
    for p_ in tf.paragraphs:
        for r_ in p_.runs:
            r_.font.size = int(pt * 12700)


def render_layout(prs, tmpl, c, d):
    s = dup_slide(prs, tmpl)
    pic = next((sh for sh in s.shapes if sh.shape_type == 13), None)
    labels = [sh for sh in s.shapes if sh.shape_type == 1 and sh.has_text_frame and sh.text_frame.text.strip()]
    lab_t = labels[0] if labels else None
    for sh in s.shapes:
        if sh.is_placeholder and sh.placeholder_format.type == 1:
            set_text_keep(sh, c.get('uiName') or 'Next SCM Layout')
    cap = (c.get('captures') or [None])[0]
    if pic is not None and cap and os.path.exists(os.path.join(d, cap)):
        pic = place_picture(s, pic, pic, os.path.join(d, cap))
        if lab_t is not None:
            # 2026-11-23 사용자: 이름표 글이 상자를 넘음 → 상자 크기 = 글자 길이(AI 의 w, h 는 쓰지 않음, x, y = 이름표 왼쪽 위), 글자 크기 고정, 줄바꿈 없음, 그림 안에 둠
            placed = []
            for lb in c.get('labels') or []:
                text = label_en(lb.get('text', ''))
                e = copy.deepcopy(lab_t._element); s.shapes._spTree.append(e); sh = s.shapes[-1]
                units = sum(2 if ord(ch) > 0x1100 else 1 for ch in text)
                pt = 11; w = int((units * pt * 0.62 + 16) * 12700); h = int((pt * 1.9) * 12700)
                sh.width, sh.height = w, h
                sh.left = int(min(max(pic.left, pic.left + float(lb.get('x', 0)) * pic.width), pic.left + pic.width - w))
                sh.top = int(min(max(pic.top, pic.top + float(lb.get('y', 0)) * pic.height), pic.top + pic.height - h))
                for _ in range(20):  # 앞 이름표와 겹치면 아래로 비킴(그림 안)
                    hit = next((r for r in placed if sh.left < r[0] + r[2] and r[0] < sh.left + w and sh.top < r[1] + r[3] and r[1] < sh.top + h), None)
                    if hit is None:
                        break
                    sh.top = hit[1] + hit[3] + int(2 * 12700)
                    if sh.top + h > pic.top + pic.height:
                        sh.top = int(pic.top); sh.left = min(int(hit[0] + hit[2] + 4 * 12700), int(pic.left + pic.width - w))
                placed.append((sh.left, sh.top, w, h))
                set_text_keep(sh, text); fit_font(sh, pt)
    for sh in labels:
        sh._element.getparent().remove(sh._element)
    return s


def render_hierarchy(prs, tmpl, plan, first_slide_of, mod):
    """메뉴 계층도: 1단(모듈 메뉴) → 2단(묶음) → 화면 상자 + 바로가기. 화면이 많으면 여러 장"""
    f = {'lv1': None, 'lv2': None, 'leaf': None, 'link': None, 'line': None}
    for sh in tmpl.shapes:
        if sh.shape_type == 1 and sh.has_text_frame and sh.text_frame.text.strip():
            w = sh.width / EMU_CM
            if f['leaf'] is None and w > 4: f['leaf'] = sh
            elif f['lv1'] is None and 2 < w < 4: f['lv1'] = sh
            elif f['lv2'] is None and 2 < w < 4: f['lv2'] = sh
        elif sh.name.startswith('실행 단추') and f['link'] is None:
            f['link'] = sh
        elif sh.shape_type == 9 and f['line'] is None:
            f['line'] = sh
    if not (f['lv1'] and f['lv2'] and f['leaf']):
        return []
    step = int(0.68 * EMU_CM); y0 = f['leaf'].top; ymax = int(17.6 * EMU_CM)
    rows_per = max(1, (ymax - y0) // step)
    items = []  # (top, group, screen)
    for g in plan['groups']:
        for sc in g['screens']:
            items.append((g['top'], g['group'], sc))
    pages = [items[i:i + rows_per * 2] for i in range(0, len(items), rows_per * 2)]
    slides = []
    for pi, pg in enumerate(pages, 1):
        s = dup_slide(prs, tmpl)
        for sh in list(s.shapes):
            if not (sh.is_placeholder and sh.placeholder_format.type == 1):
                sh._element.getparent().remove(sh._element)
            else:
                set_text_keep(sh, 'Menu Hierarchy' + (f' ({pi}/{len(pages)})' if len(pages) > 1 else ''))
        cols = [pg[:rows_per], pg[rows_per:]]
        for ci, col in enumerate(cols):
            if not col:
                continue
            xoff = int(ci * 13.2 * EMU_CM)
            y = y0; last = (None, None)
            for top, grp, sc in col:
                if (top, grp) != last:
                    for key, text in (('lv1', top if (top, None) != (last[0], None) else ''), ('lv2', grp)):
                        if not text:
                            continue
                        e = copy.deepcopy(f[key]._element); s.shapes._spTree.append(e); b = s.shapes[-1]
                        b.left = f[key].left + xoff if key == 'lv1' else f[key].left + xoff; b.top = y
                        if key == 'lv1':
                            b.left = int(f['lv1'].left * 0.4) + xoff; b.width = int(2.3 * EMU_CM)
                        else:
                            b.left = int(f['lv1'].left * 0.4) + xoff + int(2.5 * EMU_CM); b.width = int(2.6 * EMU_CM)
                        set_text_keep(b, text)
                    last = (top, grp)
                e = copy.deepcopy(f['leaf']._element); s.shapes._spTree.append(e); b = s.shapes[-1]
                b.left = int(f['lv1'].left * 0.4) + xoff + int(5.3 * EMU_CM); b.top = y; b.width = int(6.6 * EMU_CM)
                set_text_keep(b, f'{sc["name"]} ({sc["id"]})')
                tgt = first_slide_of.get(sc['id'])
                if tgt is not None:
                    b.click_action.target_slide = tgt
                    if f['link'] is not None:
                        e2 = copy.deepcopy(f['link']._element); s.shapes._spTree.append(e2); l2 = s.shapes[-1]
                        l2.left = b.left + b.width + int(0.1 * EMU_CM); l2.top = y
                        for node in l2._element.iter():
                            if node.tag.endswith('hlinkClick'):
                                node.getparent().remove(node)
                        l2.click_action.target_slide = tgt
                y += step
        slides.append(s)
    return slides


def cmd_build(a):
    from pptx import Presentation
    mod = mod_key(a.module); mods = mods_of(mod); d = mdir(mod); inp = inputs_of(mod); plan = rj(os.path.join(d, 'plan.json'))
    if not plan:
        out('plan.json 없음(prep 먼저)'); return 2
    if a.require_complete and cmd_check(a) != 0:
        out('내용이 다 채워지지 않아 만들지 않음(check 결과)'); return 3
    prs = Presentation(inp['sample'])
    src = list(prs.slides); n0 = len(src)
    tm = {'cover': src[0], 'rev': None, 'hier': None, 'section': None, 'layout': None, 'common': None, 'screen': None}
    for s in src:
        t = norm(slide_title(s)); f = find_shapes(s)
        if tm['rev'] is None and '개정이력' in ''.join(norm(sh.text_frame.text) for sh in s.shapes if sh.has_text_frame):
            tm['rev'] = s
        elif tm['hier'] is None and 'menuhierarchy' in t:
            tm['hier'] = s
        elif tm['section'] is None and '사용자화면설명' in t:
            tm['section'] = s
        elif tm['layout'] is None and t.endswith('layout'):
            tm['layout'] = s
        elif tm['common'] is None and '공통기능' in t:
            tm['common'] = s
        elif tm['screen'] is None and f['head'] is not None and f['pic'] is not None and f['desc'] is not None:
            tm['screen'] = s
    if tm['screen'] is None:
        out('[FAIL] 양식에서 화면 장표(메뉴 표 + 그림 + ● 설명)를 찾지 못함'); return 2
    # 표지
    cov = dup_slide(prs, tm['cover'])
    for sh in cov.shapes:
        if sh.has_text_frame:
            t = sh.text_frame.text
            if '매뉴얼' in t:
                set_text_keep(sh, re.sub(r'SCM\.\w+', f'SCM.{", ".join(mods)}', t.split('매뉴얼')[0]).rstrip() + f' 매뉴얼 {inp["version"]}')
            elif re.search(r'\d{4}[.\-]\d{1,2}[.\-]\d{1,2}', t):
                set_text_keep(sh, re.sub(r'\d{4}[.\-]\d{1,2}[.\-]\d{1,2}', inp['date'], t))
    # 개정이력
    if tm['rev'] is not None:
        rv = dup_slide(prs, tm['rev'])
        for sh in rv.shapes:
            if sh.has_table:
                t = sh.table
                vals = [ver_tag(inp['version']), inp['date'].replace('.', '-'), '최초 작성(Next SCM 최신 UI 기준)', inp['author'], '']
                for c, v in enumerate(vals[:len(t.columns)]):
                    table_set(t, 1, c, v)
                for r in range(2, len(t.rows)):
                    for c in range(len(t.columns)):
                        table_set(t, r, c, '')
    hier_pos = len(prs.slides)  # 계층도는 화면 장표를 만든 뒤 이 자리로 옮김
    if tm['section'] is not None:
        dup_slide(prs, tm['section'])
    content = lambda sid: rj(os.path.join(d, 'content', f'{sid}.json'), {}) or {}
    lay = content('_LAYOUT')
    if tm['layout'] is not None and lay.get('captures'):
        render_layout(prs, tm['layout'], lay, d)
    com = content('_COMMON')
    if com.get('pages'):
        callp = []  # 2026-11-23 사용자: 공통기능도 넘치면 다음 장
        for pg in com['pages']:
            callp += split_page(pg)
        for i, pg in enumerate(callp, 1):
            render_screen(prs, tm['screen'], com, pg, base_title(pg.get('title') or com.get('uiName') or '공통기능'), inp, d, f'{i}/{len(callp)}' if len(callp) > 1 else None)
    first = {}; nscreen = 0; problems = []
    byid = {sc['id']: sc for g in plan['groups'] for sc in g['screens']}
    for sid in (plan.get('order') or list(byid)):
        if True:
            sc = byid[sid]
            c = content(sc['id'])
            pages = c.get('pages') or [{'title': sc['name'], 'sections': [], 'markers': []}]
            if not c.get('pages'):
                problems.append(f'{sc["id"]} 내용 없음')
            allp = []
            for k, pg in enumerate(pages):
                if k == 0 and not pg.get('overview') and c.get('overview'):
                    pg = dict(pg, overview=c['overview'])
                allp += split_page(pg if k == 0 else dict(pg, overview=None))
            for i, pg in enumerate(allp, 1):
                sl = render_screen(prs, tm['screen'], c, pg, base_title(pg.get('title') or c.get('uiName') or sc['name']), inp, d, f'{i}/{len(allp)}' if len(allp) > 1 else None)
                first.setdefault(sc['id'], sl); nscreen += 1
    hs = render_hierarchy(prs, tm['hier'], plan, first, mod) if tm['hier'] is not None else []
    sld = prs.slides._sldIdLst  # 계층도(맨 뒤에 만듦)를 표지, 개정이력 뒤로 옮김
    moved = list(sld)[len(sld) - len(hs):] if hs else []
    for k, el in enumerate(moved):
        sld.remove(el); sld.insert(hier_pos + k, el)
    drop_slides(prs, n0)
    prs.core_properties.author = inp['author']; prs.core_properties.title = f'SCM.{", ".join(mods)} 사용자 매뉴얼 {inp["version"]}'
    fn = os.path.join(d, f'SCM_IM_사용자매뉴얼_{mod}_v{ver_tag(inp["version"])}.pptx')
    prs.save(fn)
    total = sum(len(g['screens']) for g in plan['groups'])
    out(f'== 생성: {os.path.relpath(fn, ROOT)} · 장표 {len(prs.slides)}장(계층도 {len(hs)}, 화면 {nscreen}) · 화면 {total}개')
    # 결과 검사
    chk = Presentation(fn); txt = ' '.join(sh.text_frame.text for s in chk.slides for sh in s.shapes if sh.has_text_frame)
    tbl = ' '.join(c.text for s in chk.slides for sh in s.shapes if sh.has_table for r in sh.table.rows for c in r.cells)
    if inp['author'] not in tbl:
        problems.append('작성자가 장표 표에 없음')
    if inp['version'] not in tbl:
        problems.append('Version 이 장표 표에 없음')
    nm = [g for g in plan['groups'] for sc in g['screens'] if sc['id'] not in first]
    if nm:
        problems.append(f'장표 없는 화면 {len(nm)}개')
    for p in problems:
        out(f'[FAIL] {p}')
    if plan.get('notInCapture'):
        out(f'[INFO] 캡처 파일에 없어 뺀 메뉴 화면 {len(plan["notInCapture"])}: {", ".join(x["id"] for x in plan["notInCapture"])}')
    return 3 if problems else 0


def main():
    ap = argparse.ArgumentParser(description='모듈별 사용자 매뉴얼 PPTX')
    ap.add_argument('cmd', choices=['prep', 'check', 'build'])
    ap.add_argument('--module', required=True, help='DM, SCP, SSP, SYSTEM 또는 묶음 DM_SYSTEM(순서 무관, 문서는 DM, SCP, SSP, SYSTEM 순)')
    ap.add_argument('--require-complete', action='store_true', help='build: 내용 검사 통과 때만 생성')
    a = ap.parse_args()
    return {'prep': cmd_prep, 'check': cmd_check, 'build': cmd_build}[a.cmd](a)


if __name__ == '__main__':
    sys.exit(main() or 0)
