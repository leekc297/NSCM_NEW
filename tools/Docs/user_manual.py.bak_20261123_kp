def menu_tree(mod):
    from dbconn import connect
    cfg = MODULES[mod]
    q = """select connect_by_root m.mnu_id top, m.mnu_id, m.uppr_mnu_id, m.mnu_lv_no, m.mnu_tp_cd, m.mnu_url, m.sort_ord,
                  (select msg_nm from scm_adm_msg_m g where g.msg_id = m.mnu_msg_id and g.lang_cd = 'KO' and rownum = 1) ko,
                  (select msg_nm from scm_adm_msg_m g where g.msg_id = m.mnu_msg_id and g.lang_cd = 'EN' and rownum = 1) en,
                  m.mnu_desc
             from scm_adm_mnu_m m
            where m.use_yn = 'Y'
            start with m.uppr_mnu_id is null connect by prior m.mnu_id = m.uppr_mnu_id
            order siblings by m.sort_ord"""
    with connect('tobe') as cx:
        cx.call_timeout = 60000
        cur = cx.cursor(); cur.execute(q); rows = cur.fetchall()
        btn = {}
        try:
            cur.execute("""select b.mnu_id, b.sht_nm, b.mnu_btn_cd from scm_adm_mnu_btn_mpg_m b where nvl(b.use_yn,'Y') = 'Y' order by b.mnu_id, b.sht_nm, b.mnu_btn_cd""")
            for mid, sht, cd in cur.fetchall():
                btn.setdefault(mid, []).append(f'{sht}:{cd}')
        except Exception as e:
            out(f'버튼 매핑 조회 실패(계속): {str(e)[:120]}')
    name = {r[1]: (r[8] or r[7] or r[9] or r[1]) for r in rows}
    groups, order = {}, []
    for top, mid, up, lv, tp, url, so, ko, en, desc in rows:
        if lv != 3 or tp != 'SCREEN':
            continue
        pre = (re.match(r'[A-Z]+', mid) or [''])[0]
        if top in cfg['tops']:
            pass
        elif top == 'Report' and pre in cfg['report']:
            pass
        else:
            continue
        g = name.get(up, up)
        key = f'{top}>{up}'
        if key not in groups:
            groups[key] = {'top': name.get(top, top), 'topId': top, 'group': g, 'screens': []}; order.append(key)
        groups[key]['screens'].append({'id': mid, 'name': en or ko or mid, 'ko': ko or '', 'en': en or '', 'url': url or '',
                                       'menuPath': f'{mod}> {g}> {en or ko or mid}', 'buttons': btn.get(mid, []), 'sort': len(groups[key]['screens'])})
    return [groups[k] for k in order]


# ───────────────────────── 캡처 추출 ─────────────────────────
def pic_shapes(slide):
    out_ = []
    for sh in slide.shapes:
        if sh.shape_type == 13:
            out_.append(sh)
        elif sh.shape_type == 6:  # 그룹 안 그림
            for s2 in sh.shapes:
                if s2.shape_type == 13:
                    out_.append(s2)
    return sorted(out_, key=lambda s: -(int(s.width or 0) * int(s.height or 0)))


def slide_title(slide):
    try:
        if slide.shapes.title is not None and slide.shapes.title.text.strip():
            return slide.shapes.title.text.strip()
    except Exception:
        pass
    for sh in slide.shapes:
        if sh.has_text_frame and sh.text_frame.text.strip():
            return sh.text_frame.text.strip().split('\n')[0]
    return ''


def captures_from_pptx(path):
    """반환: { 'index': {코드: page}, 'names': {코드: 프로그램명}, 'slides': [ {no, title, pics:[(blob, ext, w, h)]} ] }"""
    from pptx import Presentation
    prs = Presentation(path)
    index, names, slides = {}, {}, []
    for no, s in enumerate(prs.slides, 1):
        for sh in s.shapes:
            if not sh.has_table:
                continue
            rows = [[c.text.strip() for c in r.cells] for r in sh.table.rows]
            if not rows:
                continue
            head = [norm(x) for x in rows[0]]
            ci = next((i for i, h in enumerate(head) if '프로그램코드' in h or h in ('화면id', 'uiid', 'id')), None)
            pi = next((i for i, h in enumerate(head) if h in ('page', '페이지', 'p')), None)
            ni = next((i for i, h in enumerate(head) if '프로그램명' in h or h in ('화면명', 'name')), None)
            if ci is None or pi is None:
                continue
            for r in rows[1:]:
                code = (r[ci] if ci < len(r) else '').strip().upper()
                pg = re.sub(r'\D', '', r[pi] if pi < len(r) else '')
                if re.match(r'^[A-Z]{2,4}\d{4}', code) and pg:
                    index[code] = int(pg)
                    if ni is not None and ni < len(r):
                        names[code] = r[ni].strip()
        pics = []
        for p in pic_shapes(s):
            try:
                pics.append((p.image.blob, p.image.ext, p.image.size[0], p.image.size[1]))
            except Exception:
                pass
        slides.append({'no': no, 'title': slide_title(s), 'pics': pics})
    return {'index': index, 'names': names, 'slides': slides}


def captures_from_docx(path):
    import docx
    d = docx.Document(path)
    rels = {r.rId: r for r in d.part.rels.values() if 'image' in r.reltype}
    slides, title, no = [], '', 0
    for para in d.paragraphs:
        t = para.text.strip()
        blips = para._p.findall('.//{http://schemas.openxmlformats.org/drawingml/2006/main}blip')
        if t and not blips:
            title = t
        for b in blips:
            rid = b.get('{http://schemas.openxmlformats.org/officeDocument/2006/relationships}embed')
            if rid in rels:
                part = rels[rid].target_part; no += 1
                slides.append({'no': no, 'title': title, 'pics': [(part.blob, part.partname.ext, 0, 0)]})
    return {'index': {}, 'names': {}, 'slides': slides}


def captures_from_files(path):
    files = []
    if os.path.isdir(path):
        for base, _, fs in os.walk(path):
            files += [(os.path.join(base, f), None) for f in fs]
    elif zipfile.is_zipfile(path):
        z = zipfile.ZipFile(path)
        files = [(n, z) for n in z.namelist()]
    else:
        files = [(path, None)]
    slides = []
    for i, (f, z) in enumerate(sorted(files, key=lambda x: x[0]), 1):
        ext = os.path.splitext(f)[1].lower().lstrip('.')
        if ext not in ('png', 'jpg', 'jpeg', 'gif', 'bmp'):
            continue
        blob = z.read(f) if z else open(f, 'rb').read()
        slides.append({'no': i, 'title': os.path.splitext(os.path.basename(f))[0], 'pics': [(blob, ext, 0, 0)]})
    return {'index': {}, 'names': {}, 'slides': slides}


def load_captures(path):
    ext = os.path.splitext(path)[1].lower()
    if ext == '.pptx':
        return captures_from_pptx(path)
    if ext == '.docx':
        return captures_from_docx(path)
    return captures_from_files(path)


def match_capture(cap, sc):
    """화면 1개에 맞는 캡처 장표 찾기. 반환 (slide, how)"""
    sid = sc['id'].upper()
    keys = {norm(sc['en']), norm(sc['ko']), norm(sc['name']), norm(cap['names'].get(sid, ''))} - {''}
    by_no = {s['no']: s for s in cap['slides']}
    pg = cap['index'].get(sid)
    if pg and pg in by_no and by_no[pg]['pics']:
        s = by_no[pg]
        if not keys or norm(s['title']) in keys or any(k and (k in norm(s['title']) or norm(s['title']) in k) for k in keys):
            return s, f'목록 표 Page {pg}'
        for d in (1, -1, 2, -2):  # 표 Page 가 장표 번호와 한두 장 어긋난 경우
            s2 = by_no.get(pg + d)
            if s2 and s2['pics'] and norm(s2['title']) in keys:
                return s2, f'목록 표 Page {pg} → 제목 일치 {pg + d}'
        return s, f'목록 표 Page {pg}(제목 다름: {s["title"][:30]})'
    for s in cap['slides']:
        if s['pics'] and (sid in s['title'].upper() or norm(s['title']) in keys):
            return s, f'제목 일치 {s["no"]}'
    return None, ''


def legacy_texts(sample_path):
    """양식 샘플의 화면 장표 글(제목 → 설명, Key Point, UI 정의). 같은 화면이면 AI 가 참고"""
    from pptx import Presentation
    res = {}
    try:
        prs = Presentation(sample_path)
    except Exception:
        return res
    for s in prs.slides:
        t = slide_title(s); info = {'title': t, 'definition': '', 'desc': '', 'keyPoint': ''}
        for sh in s.shapes:
            if sh.has_table:
                rows = [[c.text.strip() for c in r.cells] for r in sh.table.rows]
                for r in rows:
                    if r and r[0].replace(' ', '') == 'UI정의' and len(r) > 1:
                        info['definition'] = r[1]
                    if r and r[0].replace(' ', '').lower() == 'keypoint' and len(r) > 1:
                        info['keyPoint'] = r[1]
            elif sh.has_text_frame and sh.text_frame.text.strip().startswith('●'):
                info['desc'] = sh.text_frame.text.strip()
        if info['desc']:
            res.setdefault(norm(t), info)
    return res


PREFIX_MOD = (('DMF', 'DM'), ('DMD', 'DM'), ('SCP', 'SCP'), ('SSP', 'SSP'), ('SYS', 'SYSTEM'))


def module_of(code, info):
    """화면 ID → 모듈. 사용자 메뉴 1단계가 정본, Report 와 메뉴에 없는 화면은 화면 ID 앞글자"""
    if info:
        for m, cfg in MODULES.items():
            if info['top'] in cfg['tops']:
                return m
    for pre, m in PREFIX_MOD:
        if code.upper().startswith(pre):
            return m
    return ''


def db_screens():
    """사용자 메뉴의 화면 전부: id → {top, topName, group, name, ko, en, buttons, sort, mod}"""
    res = {}
    for mod in MODULES:
        for g in menu_tree(mod):
            for sc in g['screens']:
                res.setdefault(sc['id'], dict(sc, top=g['topId'], topName=g['top'], group=g['group'], mod=mod))
    return res


def cmd_prep(a):
    mod = mod_key(a.module); mods = mods_of(mod); inp = inputs_of(mod); d = mdir(mod)
    t0 = datetime.datetime.now()
    info = db_screens()
    mine = [x for x in info.values() if x['mod'] in mods]
    out(f'== 사용자 메뉴(사내 DB): 전체 화면 {len(info)}개, {mod} {len(mine)}개 ({(datetime.datetime.now() - t0).total_seconds():.1f}s)')
    caps = []
    for fi, f in enumerate(inp['captures'], 1):
        c = load_captures(f); caps.append(c)
        for sl in c['slides']:
            sl['file'] = fi
        out(f'== 캡처 파일 {fi}/{len(inp["captures"])} {os.path.basename(f)}: 장표 {len(c["slides"])}개, 목록 표 {len(c["index"])}건')
    # 2026-11-23 사용자: 샘플 매뉴얼은 양식만 씀. 내용, 화면 목록, 메뉴 순서, 메뉴 구성 = 최신 UI 캡처 파일 기준.
    #   화면 목록과 순서 = 캡처 파일 '화면 목록 및 ID' 표(프로그램 코드, Page) 순, 화면 이름 = 그 표의 프로그램 명(없으면 장표 제목)
    #   2단 묶음 이름 = 사용자 메뉴(DB), 메뉴에 없는 화면 = '기타' 묶음, 목록 표가 없는 캡처 파일 = 메뉴 화면 이름과 장표 제목을 맞춤
    os.makedirs(os.path.join(d, 'captures'), exist_ok=True); os.makedirs(os.path.join(d, 'content'), exist_ok=True)
    entries = []  # ((파일 순서, 장표 번호), code, slide, how, name) · 같은 화면이 여러 파일에 있으면 앞 파일
    seen = set()
    for fi, cap in enumerate(caps, 1):
        part = []
        if cap['index']:
            for code, pg in sorted(cap['index'].items(), key=lambda x: x[1]):
                if code in seen or module_of(code, info.get(code)) not in mods:
                    continue
                sc = info.get(code) or {'id': code, 'name': cap['names'].get(code, code), 'en': '', 'ko': ''}
                s, how = match_capture(cap, dict(sc, id=code))
                if s:
                    part.append(((fi, s['no']), code, s, f'파일 {fi} {how}' if len(caps) > 1 else how, cap['names'].get(code) or s['title'] or sc['name']))
        else:
            for sc in sorted(mine, key=lambda x: x.get('sort', 0)):
                if sc['id'] in seen:
                    continue
                s, how = match_capture(cap, sc)
                if s:
                    part.append(((fi, s['no']), sc['id'], s, f'파일 {fi} {how}' if len(caps) > 1 else how, s['title'] or sc['name']))
        for e in part:
            seen.add(e[1])
        entries += part
    # 화면 장표 순서 = 모듈 순서(DM, SCP, SSP, SYSTEM) → 같은 모듈 안에서 캡처 파일 순서
    entries.sort(key=lambda x: (mods.index(module_of(x[1], info.get(x[1]))), x[0]))
    if not entries:
        raise SystemExit(f'캡처 파일에서 {mod} 화면을 찾지 못함(목록 표 프로그램 코드, 장표 제목 확인)')
    plan = {'module': mod, 'groups': [], 'captureFile': inp['captures'], 'sample': inp['sample'], 'at': datetime.datetime.now().strftime('%Y-%m-%d %H:%M'),
            }
    # 2026-11-23 사용자: UI 목록, 장표 순서 = 캡처 파일. 메뉴 계층도, 메뉴 경로 = 사내 DB 메뉴 구성(묶음, SORT_ORD)
    #   캡처에 있으나 사내 메뉴에 없는 화면 = 계층도 끝 '메뉴 미등록' 묶음
    UNREG = '메뉴 미등록'
    scr = {}
    for (fno, no), code, s, how, name in entries:
        di = info.get(code) or {}
        grp = di.get('group') or UNREG
        files = []
        for k, (blob, ext, w, h) in enumerate(s['pics'][:4], 1):
            fn = f'{code}{"" if k == 1 else "_" + str(k)}.{ext}'
            with open(os.path.join(d, 'captures', fn), 'wb') as fh:
                fh.write(blob)
            files.append(f'captures/{fn}')
        mp = f'{module_of(code, di) or mod}> {grp}> {name}'
        scr[code] = {'id': code, 'name': name, 'menuPath': mp, 'captures': files, 'captureFrom': how, 'captureFile': fno, 'captureSlide': no,
                     'inMenu': bool(di), 'buttons': di.get('buttons', [])}
        cf = os.path.join(d, 'content', f'{code}.json')
        draft = rj(cf, None) or {}
        if not draft.get('pages') and len(mods) > 1:  # 묶음 문서: 모듈별로 이미 쓴 내용이 있으면 가져옴(AI 다시 쓰지 않음)
            for m in mods:
                old = rj(os.path.join(mdir(m), 'content', f'{code}.json'), None)
                if old and old.get('pages'):
                    draft.update({k: old[k] for k in ('definition', 'pages', 'keyPoint') if k in old}); draft['reusedFrom'] = m; break
        draft.pop('legacy', None)
        draft.update({'id': code, 'uiName': name, 'menuPath': mp, 'captures': files,
                      'facts': [f for f in [f'Doc/tobefacts/screens/{code}/', f'Doc/asisfacts/screens/{code}/', f'Doc/gen/{code}/'] if os.path.isdir(os.path.join(ROOT, f))],
                      'buttons': di.get('buttons', [])})
        draft.setdefault('definition', ''); draft.setdefault('pages', [])
        wj(cf, draft)
    plan['order'] = [e[1] for e in entries]
    plan['orderRule'] = '화면 장표 = 최신 UI 캡처 파일 화면 목록 순서, 계층도 = 사내 메뉴(SCM_ADM_MNU_M) 묶음과 SORT_ORD'
    for m in mods:  # 계층도 = 모듈 순서 → 사내 메뉴 묶음, SORT_ORD
        for g in menu_tree(m):
            ss = [scr[x['id']] for x in g['screens'] if x['id'] in scr]
            if ss:
                plan['groups'].append({'top': g['top'], 'group': g['group'], 'screens': ss})
    for m in mods:
        un = [scr[c] for c in plan['order'] if not scr[c]['inMenu'] and module_of(c, None) == m]
        if un:
