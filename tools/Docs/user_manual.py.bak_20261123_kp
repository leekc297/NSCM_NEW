def mdir(mod):
    return os.path.join(ROOT, 'Doc', 'UserManual', mod)


def rj(f, d=None):
    try:
        with open(f, encoding='utf-8-sig') as fh:
            return json.load(fh)
    except Exception:
        return d


def wj(f, o):
    os.makedirs(os.path.dirname(f), exist_ok=True)
    with open(f, 'w', encoding='utf-8') as fh:
        json.dump(o, fh, ensure_ascii=False, indent=1)


def inputs_of(mod):
    inp = rj(os.path.join(mdir(mod), '_inputs.json'), None)
    if not inp:
        raise SystemExit(f'입력 없음: Doc/UserManual/{mod}/_inputs.json (VMW 사용자 매뉴얼 업무로 시작)')
    for k in ('author', 'date', 'version', 'sample', 'captures'):
        if not (inp.get(k) if isinstance(inp.get(k), list) else str(inp.get(k) or '').strip()):
            raise SystemExit(f'입력 빠짐: {k} (Doc/UserManual/{mod}/_inputs.json)')
    # 2026-11-23 사용자: 캡처 파일 여러 개 선택 가능 → captures = 경로 목록(예전 문자열 1개도 받음)
    caps = inp['captures'] if isinstance(inp['captures'], list) else [inp['captures']]
    inp['captures'] = [str(c).strip() for c in caps if str(c).strip()]
    if not inp['captures']:
        raise SystemExit(f'입력 빠짐: captures (Doc/UserManual/{mod}/_inputs.json)')
    for f in [inp['sample']] + inp['captures']:
        if not os.path.exists(f):
            raise SystemExit(f'파일 없음: {f}')
    return inp


def ver_tag(v):
    m = re.search(r'(\d+(?:\.\d+)*)', str(v))
    return m.group(1) if m else re.sub(r'\W+', '', str(v)) or '1.0'


def norm(s):
    return re.sub(r'[^0-9a-z가-힣]', '', str(s or '').lower())


