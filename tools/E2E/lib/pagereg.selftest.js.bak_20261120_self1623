// pagereg.emptyAnswered(2026-11-20 CheckList 속도 개선 B1): 조회 응답이 끝났고 전부 0행일 때만 true. 모르는 경우는 전부 false(종전대로 상한까지 대기) · 실패 1건이라도 있으면 exit 1
const fs = require('fs'), path = require('path');
const ROOT = path.join(__dirname, '..', '..', '..');
const ts = require(path.join(ROOT, 'nscm-fe', 'node_modules', 'typescript'));
const src = fs.readFileSync(path.join(__dirname, 'pagereg.ts'), 'utf8');
const m = { exports: {} }; new Function('module', 'exports', 'require', ts.transpileModule(src, { compilerOptions: { module: 'commonjs', target: 'es2020' } }).outputText)(m, m.exports, require);
const { pageReg, emptyAnswered } = m.exports;
let fail = 0; const chk = (n, c) => { console.log(c ? 'PASS' : 'FAIL', n); if (!c) fail++; };
const now = Date.now(); const iso = ms => new Date(ms).toISOString();
const page = {}; const t0 = now - 5000;
const set = (calls, o = {}) => pageReg.set(page, Object.assign({ allCalls: calls, pendingProc: 0, lastProcReqAt: now - 4000 }, o));
const C = (o = {}) => Object.assign({ btn: 'SEARCH', at: iso(now - 4000), rows: 0, rowsSure: true, done: true, doneAt: now - 3000 }, o);
set([C()]); chk('응답 1건 0행 · 끝남 · 확실 = true', emptyAnswered(page, t0) === true);
set([C(), C({ sheet: 2 })]); chk('응답 2건 모두 0행 = true', emptyAnswered(page, t0) === true);
set([C(), C({ rows: 5 })]); chk('한 건이라도 행 있음 = false', emptyAnswered(page, t0) === false);
set([C({ done: false })]); chk('응답 처리 중 = false', emptyAnswered(page, t0) === false);
set([C({ rowsSure: false })]); chk('행 수를 확실히 못 셈(깊은 구조) = false', emptyAnswered(page, t0) === false);
set([C({ rows: null, rowsSure: undefined })]); chk('스트리밍·비JSON(rows null) = false', emptyAnswered(page, t0) === false);
set([C()], { pendingProc: 1 }); chk('진행 중 요청 있음 = false', emptyAnswered(page, t0) === false);
set([C()], { lastProcReqAt: now - 1000 }); chk('마지막 요청 뒤 2.5초 안 = false', emptyAnswered(page, t0) === false);
set([C()]); chk('waitRows 시작 2.5초 안 = false', emptyAnswered(page, now - 1000) === false);
set([C({ doneAt: now - 300 })]); chk('마지막 응답 1초 안 = false', emptyAnswered(page, t0) === false);
set([C({ at: iso(now - 120000) })]); chk('최근 60초 안 조회 응답 없음 = false', emptyAnswered(page, t0) === false);
set([C({ btn: 'SAVE' })]); chk('저장 응답만 있음 = false', emptyAnswered(page, t0) === false);
set([C(), C({ btn: 'SAVE', rows: 3 })]); chk('저장 응답은 판정에서 제외 = true', emptyAnswered(page, t0) === true);
chk('page 기록 없음 = false', emptyAnswered({}, t0) === false);
console.log(fail ? `SOME FAIL ${fail}` : 'ALL PASS'); process.exit(fail ? 1 : 0);
