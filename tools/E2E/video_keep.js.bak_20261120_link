// TO-BE 실측 녹화 보관(2026-11-20 사용자 지시 '창 없이 실행 · 창 띄우기 · 녹화') — playwright.config.ts 가 e2eView=record 일 때만 부른다.
//   녹화 = 시험마다 동영상(video.webm · Playwright 전용 ffmpeg · 2026-11-20 사용자 지시로 받음). 실패한 시험은 실행 기록(trace.zip)도 함께 보관.
//   Playwright 는 실행할 때마다 outputDir(results/artifacts)을 비우므로
//     ① 정상 종료: globalTeardown(이 파일 기본 내보내기)이 <results>/video/<시각>_<pid>/ 로 옮긴다
//     ② 중단된 실행(사용자 중지 · 창 종료 · 강제 종료로 마무리 단계가 없음): 다음 실행이 설정 파일을 읽을 때(비우기 전 · 실행 관리 프로세스에서만) rescue() 가
//        남은 녹화를 <results>/video/<시각>_<pid>_중단/ 으로 옮긴다(2026-11-20 사용자 지시 '중단된 실행도 녹화를 보관 폴더로')
//     ③ 보관 폴더는 결과 폴더마다 최근 N회만 남긴다(harness.json recordKeepRuns · 기본 5 · 2026-11-20 사용자 지시)
//   동영상이 없으면(ffmpeg 없음 등) 실행 기록 장면을 tools/E2E/trace_gif.py 로 GIF 로 만든다(대체 경로).
const fs = require('node:fs');
const path = require('node:path');
const cp = require('node:child_process');

function stamp() { const d = new Date(); const t = n => String(n).padStart(2, '0'); return `${d.getFullYear()}${t(d.getMonth() + 1)}${t(d.getDate())}_${t(d.getHours())}${t(d.getMinutes())}${t(d.getSeconds())}`; }

function keepRuns() {
  try { const j = JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'Harness', 'harness.json'), 'utf8').replace(/^﻿/, '')); const n = Number(j.recordKeepRuns); return Number.isFinite(n) && n >= 1 ? Math.floor(n) : 5; } catch { return 5; }
}

function moveFile(f, to) {
  try { fs.renameSync(f, to); return true; } catch { /* 다른 드라이브 · 잠김 */ }
  try { fs.copyFileSync(f, to); try { fs.unlinkSync(f); } catch { /* 지우기 실패 = 다음 비우기 때 지워짐 */ } return true; } catch { return false; }
}

/** artifacts 아래 녹화(*.webm)와 실행 기록(trace*.zip)을 dest 로 옮긴다. 반환 = 옮긴 파일 수 */
function keep(artifacts, dest) {
  let n = 0; const used = new Set();
  const walk = d => {
    let ents = []; try { ents = fs.readdirSync(d, { withFileTypes: true }); } catch { return; }
    for (const e of ents) {
      const f = path.join(d, e.name);
      if (e.isDirectory()) walk(f);
      else if (/^trace.*\.zip$/i.test(e.name) || /\.webm$/i.test(e.name)) {
        fs.mkdirSync(dest, { recursive: true });
        const rel = path.relative(artifacts, d).replace(/[\\/]/g, '__') || 'test';
        const base = `${rel}${/^(trace\.zip|video\.webm)$/i.test(e.name) ? '' : '_' + e.name.replace(/\.(zip|webm)$/i, '')}`; const ext = path.extname(e.name);
        let to = path.join(dest, base + ext); for (let k = 2; used.has(to) || fs.existsSync(to); k++) to = path.join(dest, `${base}_${k}${ext}`);
        used.add(to); if (moveFile(f, to)) n++;
      }
    }
  };
  walk(artifacts);
  return n;
}

/** <video 폴더> 아래 실행 폴더를 이름(시각) 순으로 최근 keepN 개만 남긴다. 반환 = 지운 폴더 수 */
function prune(videoRoot, keepN) {
  let dirs = []; try { dirs = fs.readdirSync(videoRoot, { withFileTypes: true }).filter(e => e.isDirectory() && /^\d{8}_\d{6}/.test(e.name)).map(e => e.name).sort(); } catch { return 0; }
  let n = 0;
  for (const d of dirs.slice(0, Math.max(0, dirs.length - keepN))) { try { fs.rmSync(path.join(videoRoot, d), { recursive: true, force: true }); n++; } catch { /* 열려 있는 파일 등 = 다음에 */ } }
  return n;
}

/** 중단된 실행이 남긴 녹화를 보관 폴더로(설정 파일을 읽을 때 · 실행 관리 프로세스에서만 부름) */
function rescue(artifacts) {
  try {
    if (!fs.existsSync(artifacts)) return 0;
    const vroot = path.join(path.dirname(artifacts), 'video'); const dest = path.join(vroot, `${stamp()}_${process.pid}_중단`);
    const n = keep(artifacts, dest);
    const del = n ? prune(vroot, keepRuns()) : 0;
    if (n) console.log(`[TO-BE 녹화] 지난 실행(중단)에 남은 녹화 ${n}개 → ${dest}` + (del ? ` · 오래된 보관 ${del}회 지움(최근 ${keepRuns()}회 유지)` : ''));
    return n;
  } catch (e) { console.log(`[WARN] 중단된 녹화 보관 실패: ${e.message}`); return 0; }
}

module.exports = async function videoKeep(config) {
  const artifacts = (config && config.projects && config.projects[0] && config.projects[0].outputDir) || '';
  if (!artifacts) return;
  const vroot = path.join(path.dirname(artifacts), 'video');
  const dest = path.join(vroot, `${stamp()}_${process.pid}`);
  const n = keep(artifacts, dest);
  const del = prune(vroot, keepRuns());
  console.log(`[TO-BE 녹화] 녹화 파일 ${n}개(동영상 webm · 실패 시험 실행 기록 zip) → ${dest}` + (del ? ` · 오래된 보관 ${del}회 지움(최근 ${keepRuns()}회 유지)` : ''));
  const hasVideo = (() => { try { return fs.readdirSync(dest).some(f => /\.webm$/i.test(f)); } catch { return false; } })();
  if (n && !hasVideo) { try { const r = cp.spawnSync(process.env.PYTHON || 'python', [path.join(__dirname, 'trace_gif.py'), dest], { encoding: 'utf8', timeout: 600000 }); console.log(String(r.stdout || '').trim() || String(r.stderr || '').trim().slice(0, 300)); } catch (e) { console.log(`[WARN] 녹화 GIF 만들기 실패: ${e.message}`); } }
};
module.exports.keep = keep;
module.exports.prune = prune;
module.exports.rescue = rescue;
module.exports.keepRuns = keepRuns;
