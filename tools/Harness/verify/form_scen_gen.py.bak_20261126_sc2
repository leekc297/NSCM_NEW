def split_top(s, op):
    out, d, cur, i, q = [], 0, '', 0, False
    while i < len(s):
        ch = s[i]
        if ch == '"' and (i == 0 or s[i - 1] != '\\'):
            q = not q
        if not q:
            d += ch == '('; d -= ch == ')'
            if d == 0 and s.startswith(op, i):
                out.append(cur); cur = ''; i += len(op); continue
        cur += ch; i += 1
    out.append(cur)
    return [re.sub(r'\s+', '', x) for x in out if x.strip()]


def stmt_before(sc, meth, var, line):
    """메시지 줄 앞에서 var 에 값을 넣는 문장(여러 줄) → (줄, 문장) | (0, '')"""
    rows = sc.by_meth.get(meth, [])
    if not rows:
        return 0, ''
    lines = sc.src_lines(rows[0]['file']); lo = min(int(r['line']) for r in rows) - 8
    for k in range(line - 1, max(lo, 1) - 1, -1):
        if k - 1 < len(lines) and re.search(r'\b%s\s*=(?!=)' % re.escape(var), lines[k - 1]):
            buf = []
            for j in range(k, min(k + 40, len(lines)) + 1):
                buf.append(lines[j - 1])
                if ';' in lines[j - 1]:
                    break
            return k, ' '.join(x.strip() for x in buf)
    return 0, ''


def count_lambda(stmt):
    """'v = dt.AsEnumerable().Count(row => P);' → (dt, {조건 조각}) | None"""
    m = re.search(r'(\w+)\.AsEnumerable\(\)\s*\.Count\(\s*\w+\s*=>\s*(.*)\)\s*;\s*$', stmt, re.S)
    if not m:
        return None
    return m.group(1), frozenset(split_top(m.group(2), '&&'))


def is_query_table(sc, meth, dt):
    """dt 가 조회 응답 표(… = ds.Tables[n]…)로 채워지는가 — 화면 원문 전체에서"""
    rows = sc.by_meth.get(meth, [])
    if not rows:
        return False
    return any(re.search(r'\b%s\s*=\s*\w+\.Tables\[' % re.escape(dt), ln) for ln in sc.src_lines(rows[0]['file']))


def lookup_info(sc, handler, meth):
    """조회 메서드(호출 인자 = 입력칸) → {ctl, sp, param, like, size}"""
    call = next((a for a in sc.by_meth.get(handler, []) if a['kind'] == 'CALL_LOCAL' and re.sub(r'^this\.', '', a['target']) == meth), None)
    if not call:
        return None
    v = call['value'].strip()
    args = [x.strip() for x in v[1:-1].split(',')] if v.startswith('(') and v.endswith(')') else []
    ci = next((i for i, x in enumerate(args) if re.match(r'^\w+\.(Text|EditValue)$', x) and sc.ctl_kind(x.split('.')[0]) == 'text'), -1)
    if ci < 0:
        return None
    ctl = args[ci].split('.')[0]
    rows = sc.by_meth.get(meth, [])
    sig = ''
    if rows:
        sig = next((ln for ln in sc.src_lines(rows[0]['file']) if re.search(r'\b%s\s*\(' % re.escape(meth), ln) and re.search(r'\b(private|public|protected|internal)\b', ln)), '')
    ps = re.findall(r'\b\w+\s+(\w+)\s*(?=,|\))', sig.split('(', 1)[1]) if '(' in sig else []
    pname = ps[ci] if ci < len(ps) else ''
    key = ''
    for a in rows:
        mk = re.search(r'\["(\w+)"\]', a['target'])
        if a['kind'] == 'DATA_OP' and mk and pname and a['value'].strip() == pname:
            key = mk.group(1); break
    ep = next((e for e in sc.eps if e['member'] == meth), None)
    sp = re.sub(r'^SP\s+', '', (ep or {}).get('sp_or_sql', '')).strip()
    like, size = False, 0
    if sp and key and os.path.isdir(MODDIR):
        want = {f'dbo.{sp}.sql'.lower(), f'{sp}.sql'.lower()}
        f = next((os.path.join(MODDIR, n) for n in os.listdir(MODDIR) if n.lower() in want), '')
        if f:
            sql = open(f, encoding='utf-8-sig', errors='replace').read()
            like = bool(re.search(r"LIKE\s*'%'\s*\+\s*@" + re.escape(key) + r"\s*\+\s*'%'", sql, re.I))
            m = re.search(r'@' + re.escape(key) + r'\s+N?VARCHAR\s*\((\d+)\)', sql, re.I)
            size = int(m.group(1)) if m else 0
    return {'ctl': ctl, 'sp': sp, 'param': key, 'like': like, 'size': size}


def lookup_count(ats):
    """가드 원자의 Rows.Count 조건을 모두 만족하는 건수 → 0 | 1 | 2 | None"""
    cons = []
    for br, c in ats:
        m = re.search(r'Rows\.Count\s*(==|>=|>|<|!=)\s*(\d+)', c)
        if m:
            cons.append((br, m.group(1), int(m.group(2))))
    if not cons:
        return None
    ops = {'==': lambda a, b: a == b, '>': lambda a, b: a > b, '>=': lambda a, b: a >= b, '<': lambda a, b: a < b, '!=': lambda a, b: a != b}
    for n in (0, 1, 2):
        if all(ops[o](n, v) == (br == 'if') for br, o, v in cons):
            return n
    return None


def known_cols(sc):
    cols = {r['column'].upper() for r in rd(os.path.join(FACTS, sc.asis, 'grid_columns_asis.csv')) if r.get('column')}
    for rel in {a['file'] for a in sc.acts}:
        cols.update(c.upper() for c in re.findall(r'\.Field<\w+>\("(\w+)"\)', '\n'.join(sc.src_lines(rel))))
    return cols


def save_where(sc, smeth, passed, lookups, cols):
    """저장 SP 인자 → 그리드 칸 조건(p_x → X) · 값 = 앞선 검사 통과값"""
    where, src = {}, []
    asg = sc.assigns(smeth)
    for a in sc.by_meth.get(smeth, []):
        m = re.search(r'Parameters\["(\w+)"\]', a['target'])
        if a['kind'] != 'DATA_OP' or not m:
            continue
        col = re.sub(r'^p_', '', m.group(1), flags=re.I).upper()
        if col not in cols:
            continue
        v = a['value'].strip(); ex = asg.get(v, v)
        x, part = resolve(sc, smeth, v)
        if x:
            pp = next((p for p in passed if p['ctl'] == x and p['kind'] == 'input'), None)
            if pp and pp['op'] == 'period' and part in ('Text1', 'Value1'):
                where[col] = pp['pass']['from']; src.append(f'{m.group(1)}={x}.{part}')
            elif pp and pp['op'] == 'period' and part in ('Text2', 'Value2'):
                where[col] = pp['pass']['to']; src.append(f'{m.group(1)}={x}.{part}')
            elif pp and pp['op'] == 'text':
                where[col] = pp['pass']['value']; src.append(f'{m.group(1)}={x}.{part}')
            continue
        fv = re.match(r'^(\w+)$', ex)
        if fv:
            for lm, lk in lookups.items():
                if any(r['kind'] in ('LOCAL', 'FLAG') and r['target'] == fv.group(1) for r in sc.by_meth.get(lm, [])):
                    where[col] = f"@{ctl_name(lk['ctl'])}"; src.append(f"{m.group(1)}={fv.group(1)}({lm} 조회 결과, {lk['ctl']})")
    return where, src


def grid_reads(sc, meth):
    return any(RX_GRID.search(' '.join((r['target'], r['value'], r['guard'], r['raw']))) for r in sc.by_meth.get(meth, []))


def build(asis, vars_=None):
    sc = Screen(asis)
    if not sc.acts:
        return {'ok': False, 'why': f'AS-IS 사실 없음 Doc/asisfacts/screens/{asis}'}
    master = msg_master(); savem = sc.save_members(); vars_ = vars_ or {}
    buttons, gen, pending = [], [], []
    seen_msg = set(); chains = sc.chains(); cols = known_cols(sc)

    def blab(b):
        return next((p['value'].strip().strip('"') for p in sc.props if re.sub(r'^this\.', '', p['target']) == b and p['prop'] == 'Text'), '') or PREFIX.sub('', b)

    for btn, ch in sorted(chains.items()):
        handler = ch['handler']; chain = ch['meths']
        names = {m for m, _k, _r in chain}
        sv = [m for m in names if m in savem]
        if not sv:
            continue
        tables = sorted(set().union(*[savem[m] for m in sv]))
        grid = [m for m in sv if grid_reads(sc, m)]
        if grid:
            buttons.append({'button': btn, 'form': False, 'why': f'저장 메서드 {",".join(sorted(grid))} 가 그리드를 읽음', 'save': sorted(sv), 'tables': tables})
            continue
        blabel = blab(btn)
        buttons.append({'button': btn, 'form': True, 'label': blabel, 'save': sorted(sv), 'tables': tables})
        keyof = {m: k for m, k, _r in chain}
        msgs = []
        for m in names:
            for a in sc.by_meth.get(m, []):
                if a['kind'] == 'MESSAGE':
                    msgs.append((keyof.get(m, ()) + (int(a['line']),), m, a))
        msgs.sort(key=lambda t: t[0])
        msgs = [t for t in msgs if (t[1], t[2]['line']) not in seen_msg]
        seen_msg.update((t[1], t[2]['line']) for t in msgs)
        passed = []    # 앞선 검사: {ctl, op, pass, line, meth, msg, needs, guard, kind: input|none|unknown}
        lookups = {}   # 조회 메서드 → lookup_info
        cnt_prev = []  # (meth, guard, cond, 조건 조각, line, msg) — 건수 조건 포함 관계(도달 불가) 판정
        deferred = []  # 기존 행 중복 검사(준비 행이 있어야 발생) → 저장 성공 갈래를 본 뒤 만든다
        setup = None

        def prior_steps(ga, skip_ctl=None):
            """앞선 검사 통과 단계 → (steps, needs, labels, 해석 못 한 앞선 검사)"""
            steps, needs, lab = [], [], {}
            for p in passed:
                if exclusive(p['guard'], ga):
                    continue
                if p['kind'] == 'unknown':
                    return None, None, None, p
                if p['kind'] != 'input' or p['ctl'] == skip_ctl:
                    continue
                lb = sc.label(p['ctl']); lab[p['ctl']] = lb
                steps.append({'op': p['op'], 'label': lb['label'], **({'fuzzy': True} if lb['fuzzy'] else {}), **p['pass']}); needs += p['needs']
            return steps, sorted(set(needs)), lab, None

        def add_pass(ctl, op, pv, a, m, code, needs, ga, kind='input'):
            if kind != 'input' or not any(p['ctl'] == ctl and p['kind'] == 'input' for p in passed):
                passed.append({'ctl': ctl, 'op': op, 'pass': pv, 'line': a['line'], 'meth': m, 'msg': code, 'needs': needs, 'guard': ga, 'kind': kind})

        def emit(sc_, needs):
            miss = [n for n in needs if n not in vars_]
            if needs:
                sc_['needs'] = needs
            if miss:
                pending.append({**sc_, 'why': f"앞선 검사 통과값 vars 미지정: {', '.join(miss)} (Doc/verify/<ID>/form_vars.json)"})
            else:
                gen.append(sc_)

        for _key, m, a in msgs:
            ga = atoms(a['guard'])
            mcode = re.search(r'"(MSG\d+)"', a['value'])
            code = mcode.group(1) if mcode else ''
            mr = master.get(code, {})
            base = {'msg': code or '(동적 메시지)', 'meth': m, 'asis_line': f"cs:{a['line']}", 'asis_text': mr.get('Ko', ''),
                    'asis_text_alt': [t for t in (mr.get('En', ''), mr.get('Ch', '')) if t], 'button': btn}
            ats = [inner(x) for x in ga if not x.startswith('for (') and x != 'try']
            br, cond = ats[-1] if ats else ('', '')
            confirm = [{'op': 'dialog', 'how': 'cancel'}] if mr.get('Button') and mr.get('Button') != '0202001' else []
            if 'catch' in (a['guard'] or '') or 'ForException' in a['target'] + a['value']:
                gen.append({**base, 'kind': 'error_branch', 'basis': f"예외 catch 블록({m} cs:{a['line']})"}); continue
            if not code:
                gen.append({**base, 'kind': 'error_branch', 'basis': f"오류 문구·코드를 그대로 띄우는 분기({a['guard'] or m})"}); continue
            rk = resp_kind(sc, m, cond, savem, names)
            # ── 저장 응답 ──
            if rk == 'save':
                if br == 'else':
                    gen.append({**base, 'kind': 'error_branch', 'basis': f"저장 응답 실패 갈래({cond[:100]} · {m} cs:{a['line']})"}); continue
                steps, needs, lab, unk = prior_steps(ga)
                if unk:
                    pending.append({**base, 'why': f"저장 성공 갈래 — 앞선 검사 {unk['msg']}({unk['meth']} cs:{unk['line']})의 통과 입력을 해석하지 못함"}); continue
                where, wsrc = save_where(sc, m, passed, lookups, cols)
                mt = set(savem.get(m, ()))
                tear = []
                for b2, c2 in sorted(chains.items()):
                    if b2 == btn:
                        continue
                    sv2 = [q for q in {q for q, _k, _r in c2['meths']} if q in savem and set(savem[q]) & mt]
                    if sv2 and any(grid_reads(sc, q) for q in sv2):
                        tear.append((b2, c2, sv2))
                if not where:
                    pending.append({**base, 'why': '저장 성공 갈래 — 저장 SP 인자에서 그리드 칸 조건(matchAfter)을 만들지 못함'}); continue
                if not tear:
                    pending.append({**base, 'why': f"저장 성공 갈래 — 같은 표({', '.join(sorted(mt))})의 행을 해제·삭제하는 그리드 단추가 없어 검증용 행을 정리할 수 없음"}); continue
                tb, tch, _sv2 = tear[0]
                tmeths = {q for q, _k, _r in tch['meths']}
                tmsg = None
                for q in sorted(tmeths):
                    for r in sc.by_meth.get(q, []):
                        if r['kind'] == 'MESSAGE' and re.search(r'"(MSG\d+)"', r['value']) and 'catch' not in (r['guard'] or ''):
                            ta = [inner(x) for x in atoms(r['guard']) if not x.startswith('for (') and x != 'try']
                            if ta and ta[-1][0] == 'if' and resp_kind(sc, q, ta[-1][1], savem, tmeths) == 'save':
                                tmsg = (q, r); break
                    if tmsg:
                        break
                setup = {**base, 'kind': 'dynamic', 'phase': 'setup', 'allowSave': True, 'expectSave': 1,
                         'steps': steps + [{'op': 'click', 'name': blabel, 'ms': 4500}],
                         'matchAfter': {'where': where, 'min': 1},
                         'note': f"정상 저장(검증용 행 생성) · 조건 칸 근거 {', '.join(wsrc)} · 정리 단추 {tb}"}
                emit(setup, needs)
                tcode = re.search(r'"(MSG\d+)"', tmsg[1]['value']).group(1) if tmsg else ''
                tmr = master.get(tcode, {})
                tdown = {'msg': tcode or '(동작)', 'meth': tmsg[0] if tmsg else tch['handler'], 'asis_line': f"cs:{tmsg[1]['line']}" if tmsg else '',
                         'asis_text': tmr.get('Ko', ''), 'asis_text_alt': [t for t in (tmr.get('En', ''), tmr.get('Ch', '')) if t], 'button': tb,
                         'kind': 'dynamic', 'phase': 'teardown', 'allowSave': True, 'expectSave': 1, 'expectRowsMin': 1,
                         'steps': [{'op': 'checkrows', 'where': where}, {'op': 'click', 'name': blab(tb), 'ms': 3000}],
                         'matchAfter': {'where': where, 'max': 0}, 'note': f'검증용으로 만든 행만 골라 {blab(tb)}(정리)'}
                emit(tdown, sorted({v[1:] for v in where.values() if v.startswith('@') and not v.startswith('@TODAY') and v != '@ME'}))
                continue
            # ── 조회 결과 갈래 ──
            if rk == 'lookup':
                lk = lookups.get(m) or lookup_info(sc, handler, m)
                n = lookup_count(ats)
                if not lk:
                    pending.append({**base, 'why': f'조회 결과 갈래({cond[:80]}) — 조회 인자 입력칸을 원문에서 찾지 못함'})
                    add_pass(None, '', {}, a, m, code, [], ga, 'unknown'); continue
                lookups[m] = lk; x = lk['ctl']
                trig, why = None, ''
                if n is not None and n >= 2:
                    if lk['like']:
                        trig = {'value': ''}; why = f"빈 검색어 = {lk['sp']} @{lk['param']} LIKE '%'+@{lk['param']}+'%' 전부 일치(여러 건)"
                    else:
                        why = f"여러 건 갈래 — {lk['sp']} @{lk['param']} 이 LIKE 검색이 아니어서 여러 건 입력을 정하지 못함"
                elif n == 0:
                    if lk['param']:
                        v = NOMATCH[:lk['size']] if lk['size'] else NOMATCH
                        trig = {'value': v}; why = f"일치 없는 검색어 '{v}'({lk['sp']} @{lk['param']}{' 길이 ' + str(lk['size']) if lk['size'] else ''})"
                    else:
                        why = '0건 갈래 — 조회 SP 인자를 찾지 못함'
                else:
                    why = f'조회 결과 갈래({cond[:80]}) — 건수 조건을 풀지 못함'
                if trig is None:
                    pending.append({**base, 'why': why})
                else:
                    steps, needs, lab, unk = prior_steps(ga, skip_ctl=x)
                    if unk:
                        pending.append({**base, 'why': f"앞선 검사 {unk['msg']}({unk['meth']} cs:{unk['line']})의 통과 입력을 해석하지 못함"})
                    else:
                        lb = sc.label(x)
                        st = steps + [{'op': 'text', 'label': lb['label'], **({'fuzzy': True} if lb['fuzzy'] else {}), **trig}, {'op': 'click', 'name': blabel}] + confirm
                        emit({**base, 'kind': 'dynamic', 'note': f"{x} {why} · 라벨 근거 {x}={lb['src']}", 'steps': st}, needs)
                add_pass(x, 'text', {'value': f'@{ctl_name(x)}'}, a, m, code, [ctl_name(x)], ga)
                continue
            # ── 건수 조건(포함 관계 · 기존 행 중복) ──
            mc = re.match(r'^(\w+)\s*>\s*0$', strip_par(cond))
            if br == 'if' and mc:
                ln, stmt = stmt_before(sc, m, mc.group(1), int(a['line']))
                cl = count_lambda(stmt) if stmt else None
                if cl:
                    dt, conj = cl
                    sup = next((q for q in cnt_prev if q[0] == m and q[1] == ga and q[2] == strip_par(cond) and q[3] < conj), None)
                    cnt_prev.append((m, ga, strip_par(cond), conj, a['line'], code))
                    if sup:
                        gen.append({**base, 'kind': 'unreachable', 'basis': f"cs:{ln} 건수 조건은 앞선 {sup[5]}(cs:{sup[4]}) 조건에 {' && '.join(sorted(conj - sup[3]))[:120]} 를 더한 것이라, 이 조건이 참이면 앞선 조건이 먼저 참이 되어 cs:{sup[4]} 에서 끝남"})
                        add_pass(None, '', {}, a, m, code, [], ga, 'none'); continue
                    if is_query_table(sc, m, dt):
                        deferred.append((base, a, dt, ln))
                        add_pass(None, '', {}, a, m, code, [], ga, 'none'); continue
            pt = pattern(sc, m, br, cond, chain, handler)
            if 'why' in pt:
                pending.append({**base, 'why': pt['why']})
                add_pass(None, '', {}, a, m, code, [], ga, 'unknown'); continue
            x = pt['ctl']
            clash = next((p for p in passed if p['kind'] == 'input' and not exclusive(p['guard'], ga) and p['ctl'] == x and pt['op'] == 'text' and pt['trigger'].get('value') == ''), None)
            if clash:
                gen.append({**base, 'kind': 'unreachable', 'basis': f"앞선 검사 {clash['msg']}({clash['meth']} cs:{clash['line']})가 같은 칸 {x} 를 먼저 검사함 — 빈값이면 그 검사에서 끝남"})
                add_pass(x, pt['op'], pt['pass'], a, m, code, pt.get('needs', []), ga); continue
            steps, needs, lab, unk = prior_steps(ga, skip_ctl=x)
            if unk:
                pending.append({**base, 'why': f"앞선 검사 {unk['msg']}({unk['meth']} cs:{unk['line']})의 통과 입력을 해석하지 못함"})
            else:
                lb = sc.label(x); lab[x] = lb
                steps.append({'op': pt['op'], 'label': lb['label'], **({'fuzzy': True} if lb['fuzzy'] else {}), **pt['trigger']})
                steps += [{'op': 'click', 'name': blabel}] + confirm
                note = f"{x} {'빈값' if pt['trigger'].get('value') == '' else json.dumps(pt['trigger'], ensure_ascii=False)}" + (f" · {pt['note']}" if pt.get('note') else '') + \
                       ' · 라벨 근거 ' + ', '.join(f"{k}={v['src']}" for k, v in lab.items())
                emit({**base, 'kind': 'dynamic', 'note': note, 'steps': steps}, sorted(set(needs + pt.get('needs', []))))
            add_pass(x, pt['op'], pt['pass'], a, m, code, pt.get('needs', []), ga)
        # 기존 행 중복 검사 = 준비(setup)와 같은 입력으로 다시 저장(준비 행이 있어야 발생)
        for base, a, dt, ln in deferred:
            if not setup:
                pending.append({**base, 'why': f'기존 행 중복 검사({dt} 건수 cs:{ln}) — 준비 행을 만들 저장 성공·정리 경로가 없음'}); continue
            st = [dict(s) for s in setup['steps']]
            st[-1] = {'op': 'click', 'name': blabel}
            emit({**base, 'kind': 'dynamic', 'expectRowsMin': 1, 'steps': st,
                  'note': f'준비({setup["meth"]} {setup["asis_line"]})와 같은 입력으로 다시 저장 · 조회 표 {dt} 의 건수 조건(cs:{ln})'}, list(setup.get('needs', [])))
    for i, s in enumerate(gen, 1):
        s['id'] = f'G{i:02d}'
    for i, s in enumerate(pending, 1):
        s['id'] = f'GP{i:02d}'
    return {'ok': True, 'asis': asis, 'buttons': buttons, 'scenarios': gen, 'pending': pending}


def compare(gen, manual):
    """수작업본 ↔ 생성분: (meth, asis_line, msg) 기준"""
    key = lambda s: (s.get('meth'), s.get('asis_line'), s.get('msg'))
    g = {key(s): s for s in gen['scenarios']}; gp = {key(s): s for s in gen['pending']}
    rows = []
    for s in manual.get('scenarios', []):
        k = key(s)
        if k in g:
            kg = g[k]['kind']
            rows.append({'manual': s['id'], 'gen': g[k]['id'], 'kind_manual': s['kind'], 'kind_gen': kg, 'same_kind': kg == s['kind'],
                         'same_text': (g[k].get('asis_text') or '') == (s.get('asis_text') or '')})
        elif k in gp:
            rows.append({'manual': s['id'], 'gen': gp[k]['id'], 'kind_manual': s['kind'], 'kind_gen': '보류', 'why': gp[k]['why']})
        else:
            rows.append({'manual': s['id'], 'gen': '', 'kind_manual': s['kind'], 'kind_gen': '없음', 'meth': s.get('meth'), 'asis_line': s.get('asis_line')})
    return rows


def asis_of(mid):
    p = os.path.join(ROOT, 'Doc', 'verify', mid, 'run_mode.json')
    try:
        a = json.load(open(p, encoding='utf-8')).get('asis')
        if a:
            return a
    except Exception:
        pass
    return mid


def run(mid, asis=None, dry=False):
    asis = asis or asis_of(mid)
    vdir = os.path.join(ROOT, 'Doc', 'verify', mid)
    vf = os.path.join(vdir, 'form_vars.json'); vars_ = {}
    if os.path.exists(vf):
        try:
            vars_ = json.load(open(vf, encoding='utf-8-sig'))
        except Exception as e:
            print(f'[WARN] {vf} 읽기 실패({type(e).__name__}) — vars 없이 생성')
    target = os.path.join(vdir, 'form_scenarios.json')
    manual = None
    if os.path.exists(target):
        try:
            cur = json.load(open(target, encoding='utf-8-sig'))
            if not cur.get('_gen'):
                manual = cur
                vars_ = {**(cur.get('vars') or {}), **vars_}
        except Exception:
            manual = {}
    g = build(asis, vars_)
    if not g['ok']:
        print(f"[SKIP] {mid}: {g['why']}"); return 0
    forms = [b for b in g['buttons'] if b['form']]
    dyn = [s for s in g['scenarios'] if s['kind'] == 'dynamic']
    stamp = time.strftime('%Y-%m-%d %H:%M:%S')
    rep = {'_gen': f'form_scen_gen.py {stamp}', 'menu_id': mid, 'asis': asis, 'buttons': g['buttons'],
           'counts': {'active': len(g['scenarios']), 'dynamic': len(dyn), 'pending': len(g['pending'])},
           'scenarios': g['scenarios'], '_pending': g['pending']}
    if manual is not None:
        rep['compare_manual'] = compare(g, manual)
    msg = f"[form_scen_gen] {mid}(AS-IS {asis}) 폼 저장 단추 {len(forms)}개 · 활성 {len(g['scenarios'])}건(dynamic {len(dyn)}) · 보류 {len(g['pending'])}건"
    if not forms:
        if manual is None and os.path.exists(target) and not dry:
            os.remove(target)  # 지난 생성분(_gen)만 정리
        print(msg + ' — 폼 저장형 화면 아님(파일 안 만듦)'); return 0
    if dry:
        print(msg + ' (--dry)'); return 0
    os.makedirs(vdir, exist_ok=True)
    with open(os.path.join(vdir, 'form_scen_gen.json'), 'w', encoding='utf-8') as f:
        json.dump(rep, f, ensure_ascii=False, indent=1)
    if manual is not None:
        print(msg + ' — 사람이 쓴 form_scenarios.json 있음: 덮지 않고 대조만(form_scen_gen.json compare_manual)')
    elif not dyn:
        print(msg + ' — dynamic 0건: form_scenarios.json 안 만듦(form_scen_gen.json 에 보류 사유)')
        if os.path.exists(target):
            os.remove(target)  # 지난 생성분(_gen) 정리
    else:
        out = {'_gen': rep['_gen'], '_doc': 'form_scen_gen.py 생성분 — 사람이 고치려면 _gen 키를 지운다(그 뒤로 생성기가 덮지 않음)',
               'vars': {k: v for k, v in vars_.items()}, 'scenarios': g['scenarios']}
        with open(target, 'w', encoding='utf-8') as f:
            json.dump(out, f, ensure_ascii=False, indent=1)
        print(msg + ' — form_scenarios.json 씀')
    return 0


def selftest():
    mf = os.path.join(ROOT, 'Doc', 'verify', 'SSP0020', 'form_scenarios.json')
    manual = json.load(open(mf, encoding='utf-8-sig'))
    g = build('SSP0020', manual.get('vars') or {})
    rows = compare(g, manual)
    bad = []
    want = {  # 수작업본과 같아야 할 판정(생성기가 다루는 Save 사슬 메시지 + 정리 단추 UnSet 성공 문구)
        ('UserName_Search', 'cs:802', 'MSG00302'): 'dynamic',
        ('UserName_Search', 'cs:811', 'MSG00301'): 'dynamic',
        ('Validation_Check', 'cs:372', 'MSG00298'): 'unreachable',
        ('Validation_Check', 'cs:379', 'MSG00305'): 'dynamic',
        ('Validation_Check', 'cs:385', 'MSG00134'): 'dynamic',
        ('Validation_Check', 'cs:393', 'MSG00219'): 'dynamic',
        ('Validation_Check', 'cs:426', 'MSG00105'): 'dynamic',
        ('Validation_Check', 'cs:440', 'MSG00296'): 'unreachable',
        ('Validation_Check', 'cs:454', 'MSG00297'): 'unreachable',
        ('Validation_Check', 'cs:462', 'MSG00299'): 'dynamic',
        ('SaveData', 'cs:523', 'MSG00004'): 'dynamic',
        ('UnSet', 'cs:749', 'MSG00004'): 'dynamic',
        ('SaveData', 'cs:528', 'MSG00284'): 'error_branch',
        ('SaveData', 'cs:535', '(동적 메시지)'): 'error_branch',
        ('BtnSave_Click', 'cs:359', '(동적 메시지)'): 'error_branch',
    }
    idx = {(s['meth'], s['asis_line'], s['msg']): s for s in g['scenarios']}
    for k, kind in want.items():
        s = idx.get(k)
        if not s:
            bad.append(f'{k} 생성 안 됨(보류 {[p["why"] for p in g["pending"] if (p["meth"], p["asis_line"], p["msg"]) == k]})')
        elif s['kind'] != kind:
            bad.append(f'{k} kind {s["kind"]} ≠ {kind}')
    man = {}
    for s in manual['scenarios']:
        man.setdefault((s['meth'], s['asis_line'], s['msg']), s)   # 같은 메시지 2회차(F09b·F13b)는 1회차로 대조
    nv = lambda v: '<NOMATCH>' if isinstance(v, str) and (v.startswith('@NO') or v == NOMATCH) else v
    tx = lambda t: re.sub(r'\{\d+\}', '', t or '')
    for k in want:
        s, m = idx.get(k), man.get(k)
        if not (s and m):
            continue
        for f in ('phase', 'allowSave', 'expectRowsMin'):
            if s.get(f) != m.get(f):
                bad.append(f'{k} {f} 생성 {s.get(f)} ≠ 수작업 {m.get(f)}')
        if s['kind'] == 'dynamic':
            ops_g = [(t['op'], nv(t.get('value')), t.get('from'), t.get('to'), t.get('mode'), json.dumps(t.get('where'), sort_keys=True)) for t in s['steps'] if t['op'] != 'click']
            ops_m = [(t['op'], nv(t.get('value')), t.get('from'), t.get('to'), t.get('mode'), json.dumps(t.get('where'), sort_keys=True)) for t in m['steps'] if t['op'] != 'click']
            if ops_g != ops_m:
                bad.append(f'{k} 단계 차이 생성 {ops_g} ↔ 수작업 {ops_m}')
            if (s.get('matchAfter') or None) != (m.get('matchAfter') or None):
                bad.append(f"{k} matchAfter 차이 {s.get('matchAfter')} ↔ {m.get('matchAfter')}")
            if not tx(s.get('asis_text')).startswith(tx(m.get('asis_text')) or 'NO-TEXT'):
                bad.append(f"{k} 문구 차이 '{s.get('asis_text')}' ↔ '{m.get('asis_text')}'")
    # 그리드 저장 단추(UnSet)는 폼 저장 단추가 아님 · 저장 시나리오는 준비·정리 단계에만
    if any(b['button'] == 'btnUnSet' and b['form'] for b in g['buttons']):
        bad.append('btnUnSet 을 폼 저장 단추로 봄')
    if any(s.get('allowSave') and s.get('phase') not in ('setup', 'teardown') for s in g['scenarios']):
        bad.append('준비·정리 밖 allowSave 시나리오 생성')
    if sum(1 for s in g['scenarios'] if s.get('phase') == 'setup') != sum(1 for s in g['scenarios'] if s.get('phase') == 'teardown'):
        bad.append('준비(setup)와 정리(teardown) 건수 다름')
    if g['pending']:
        bad.append(f"보류 {len(g['pending'])}건: " + ' | '.join(p['why'] for p in g['pending']))
    print(f"[selftest] SSP0020 생성 활성 {len(g['scenarios'])}건 · 보류 {len(g['pending'])}건 · 수작업 {len(manual['scenarios'])}건 대조")
    for r in rows:
        print('  ', json.dumps(r, ensure_ascii=False))
    for b in bad:
        print('  [FAIL]', b)
    print('[selftest]', 'PASS' if not bad else f'FAIL {len(bad)}건')
    return 0 if not bad else 1


def main(argv):
    if '--selftest' in argv:
        return selftest()
    dry = '--dry' in argv
    if '--all' in argv:
        for sid in sorted(os.listdir(FACTS)):
            if os.path.isdir(os.path.join(FACTS, sid)):
                try:
                    run(sid, sid, dry)
                except Exception as e:
                    print(f'[ERROR] {sid}: {type(e).__name__} {e}')
        return 0
    args = [a for a in argv if not a.startswith('--')]
    if not args:
        print(__doc__); return 2
    asis = None
    if '--asis' in argv:
        i = argv.index('--asis'); asis = argv[i + 1] if i + 1 < len(argv) else None
        args = [a for a in args if a != asis]
    try:
        return run(args[0].upper(), asis, dry)
    except Exception as e:
        print(f'[ERROR] form_scen_gen {args[0]}: {type(e).__name__} {e}')
        return 0  # 체인 중단 안 함


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
