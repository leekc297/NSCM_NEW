import csv, json, os, re, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, '..', '..', '..'))
FACTS = os.path.join(ROOT, 'Doc', 'asisfacts', 'screens')
MSGCSV = os.path.join(ROOT, 'Doc', 'asisfacts', 'db', 'meta', 'dbo.TB_FX_MessageInfo.csv')
SRC = os.path.join(ROOT, 'GSCM')
csv.field_size_limit(10 ** 9)

RX_GRID = re.compile(r'\b(si\w*|spd\w*|fpSpread\w*)\.(Get(Text|Value|Cell)\w*|ActiveSheet|Sheets)\b|GetChanged|GetSave\w*Data|GetModified|ActiveSheet\.', re.I)
RX_DML = re.compile(r'\b(INSERT|UPDATE|DELETE|MERGE):([A-Z0-9_\.]+)', re.I)
RX_RESP = re.compile(r'\bresponse\b|\.DataSet\b|Tables\s*\[|Rows\s*\[\s*0\s*\]\s*\[|ExecuteDataSet')
RX_NOSAVE_T = re.compile(r'^(dbo\.)?(SCM_SYS_LOG|SCM_MST_TITLESET|SCM_ADM_DB_SCRIPT|TB_FX_)', re.I)
RX_NOSAVE_M = re.compile(r'^(Find|Get|Search|Select|Init|Load|Set\w*Title|\w*TitleSet)', re.I)
RX_NOSAVE_SP = re.compile(r'_(GET|SEARCH|FIND|SELECT|SEL|LIST)(_|\b)', re.I)
RX_ME = re.compile(r'UserInfoContext\.Current\.UserId|base\.UserInfo\.UserId|UserInfo\.UserId')
PREFIX = re.compile(r'^(txt|clb|drp|dtp|cbo|cmb|chk|rdo|num|mcb|lkp|usr|edt|lbl)(?=[A-Z])')


def rd(p):
    if not os.path.exists(p):
        return []
    with open(p, encoding='utf-8-sig', newline='') as f:
        return list(csv.DictReader(f))


def atoms(guard):
    return [s.strip() for s in (guard or '').split('▸') if s.strip()]


def inner(atom):
    """'if (X)' · 'else of (X)' → ('if'|'else', X)"""
    m = re.match(r'^(if|else of|else if)\s*\((.*)\)\s*$', atom.strip(), re.S)
    if not m:
        return ('', atom.strip())
    return ('else' if m.group(1) == 'else of' else 'if', m.group(2).strip())


def strip_par(t):
    t = t.strip()
    while t.startswith('(') and t.endswith(')'):
        d = 0; ok = True
        for k, ch in enumerate(t):
            d += ch == '('; d -= ch == ')'
            if d == 0 and k < len(t) - 1:
                ok = False; break
        if not ok:
            break
        t = t[1:-1].strip()
    return t


def exclusive(prior, cur):
    """앞선 메시지 가드와 이번 가드가 같은 조건의 if / else 갈래로 갈리면 True(앞선 검사는 이번 경로에서 실행되지 않음)"""
    for a, b in zip(prior, cur):
        if a == b:
            continue
        ka, ca = inner(a); kb, cb = inner(b)
        return ca == cb and {ka, kb} == {'if', 'else'}
    return False


def ctl_name(name):
    base = PREFIX.sub('', name)
    return re.sub(r'[^A-Za-z0-9]', '', base).upper() or name.upper()


class Screen:
    def __init__(self, asis):
        d = os.path.join(FACTS, asis)
        self.asis = asis
        self.acts = rd(os.path.join(d, 'actions.csv'))
        self.entries = rd(os.path.join(d, 'actions_entries.csv'))
        self.events = rd(os.path.join(d, 'events.csv'))
        self.eps = rd(os.path.join(d, 'endpoints.csv'))
        self.props = rd(os.path.join(d, 'props.csv'))
        self.ctls = {c['name']: c for c in rd(os.path.join(d, 'controls.csv'))}
        self.by_meth = {}
        for a in self.acts:
            self.by_meth.setdefault(a['method'], []).append(a)
        self._src = {}
        self.labels = self._labels()

    # ── 원문 ──
    def src_lines(self, rel):
        if rel not in self._src:
            p = os.path.join(SRC, rel.replace('\\', os.sep))
            try:
                with open(p, encoding='utf-8-sig', errors='replace') as f:
                    self._src[rel] = f.read().splitlines()
            except OSError:
                self._src[rel] = []
        return self._src[rel]

    def assigns(self, meth):
        """메서드 원문 범위의 '변수 = 식;' → {변수: 식}"""
        rows = self.by_meth.get(meth, [])
        if not rows:
            return {}
        rel = rows[0]['file']; lines = self.src_lines(rel)
        lo = min(int(r['line']) for r in rows) - 8; hi = max(int(r['line']) for r in rows)
        txt = '\n'.join(lines[max(lo - 1, 0):hi])
        out = {}
        for m in re.finditer(r'(?:\b(?:string|var|int|bool|DateTime|decimal|double|long)\s+)?\b([A-Za-z_]\w*)\s*=\s*(?!=)([^;]+);', txt):
            out.setdefault(m.group(1), m.group(2).strip())
        return out

    # ── 라벨 ──
    def _labels(self):
        item_text, item_ctl = {}, {}
        for p in self.props:
            if p['prop'] == 'Text':
                v = p['value'].strip()
                if v.startswith('"') and v.endswith('"'):
                    item_text[p['target']] = v[1:-1]
            if p['prop'] == 'Control':
                m = re.match(r'this\.(\w+)$', p['value'].strip())
                if m:
                    item_ctl[p['target']] = m.group(1)
        out = {}
        for it, c in item_ctl.items():
            if it in item_text and item_text[it] and not item_text[it].startswith(it):
                out[c] = {'label': item_text[it].replace('*', '').strip(), 'src': f'{it}.Text', 'fuzzy': False}
        return out

    def label(self, ctl):
        if ctl in self.labels:
            return self.labels[ctl]
        base = PREFIX.sub('', ctl)
        return {'label': re.sub(r'(?<=[a-z])(?=[A-Z])', ' ', base), 'src': f'컨트롤 이름 {ctl}', 'fuzzy': True}

    def ctl_kind(self, ctl):
        t = (self.ctls.get(ctl, {}).get('type') or '')
        if re.search(r'CheckedListBox|CheckedComboBox|MultiCheck', t):
            return 'multi'
        if re.search(r'DateRange|Period|DateEditRange', t) or ctl.startswith('drp'):
            return 'period'
        if re.search(r'Combo|LookUp', t):
            return 'combo'
        if re.search(r'Text|Editor|Edit\b|MemoEdit', t):
            return 'text'
        return ''

    # ── 단추 사슬 ──
    def save_members(self):
        out = {}
        for e in self.eps:
            # 로그·화면 개인 설정(타이틀셋·프레임워크 TB_FX_) 표와 조회 메서드·조회 SP 는 저장으로 보지 않음(2026-11-26 DMF0044 FindData 타이틀셋 저장 오탐)
            if RX_NOSAVE_M.search(e['member']) or RX_NOSAVE_SP.search(e.get('sp_or_sql') or ''):
                continue
            tabs = [t for k, t in RX_DML.findall(e.get('objects') or '') if not RX_NOSAVE_T.search(t)]
            if tabs:
                out.setdefault(e['member'], set()).update(tabs)
        return out

    def chains(self):
        """단추 Click 처리 → [(method, order_key, call_args)]"""
        res = {}
        btns = [ev for ev in self.events if ev['event'] == 'Click' and ev['op'] == '+=']
        for ev in btns:
            ent = f"{ev['target']}.Click"
            rows = [r for r in self.entries if r['entry'] == ent]
            if not rows:
                continue
            meths = []
            for r in rows:
                path = r['path'].split(' > ')
                # 호출 줄 사슬: 경로 각 단계의 call_line 을 찾아 키로 쓴다
                key = []
                for k in range(1, len(path)):
                    sub = ' > '.join(path[:k + 1])
                    hit = next((q for q in rows if q['path'] == sub), None)
                    key.append(int(hit['call_line']) if hit and hit['call_line'].isdigit() else 0)
                meths.append((r['method'], tuple(key), r))
            res[re.sub(r'^this\.', '', ev['target'])] = {'handler': ev['handler'], 'meths': meths}
        return res


def msg_master():
    out = {}
    for r in rd(MSGCSV):
        out[r['MessageID']] = r
    return out


def resp_kind(sc, meth, cond, savem, chain_meths):
    """조건이 서버 응답을 읽는가 → 'save' | 'lookup' | ''"""
    names = set(re.findall(r'\b([A-Za-z_]\w*)\b', cond))
    hit = bool(RX_RESP.search(cond))
    if not hit:
        # 조건 변수가 응답 갈래 안에서 대입되는가(bolSuessceChk 등)
        for a in sc.by_meth.get(meth, []):
            if a['kind'] in ('LOCAL', 'FLAG') and a['target'] in names and a['value'] and RX_RESP.search(a['guard'] or ''):
                hit = True; break
    if not hit:
        return ''
    return 'save' if meth in savem else 'lookup'


def lookup_ctl(sc, handler, meth):
    """조회 메서드 호출 인자의 칸 → [ctl]"""
    for a in sc.by_meth.get(handler, []):
        if a['kind'] == 'CALL_LOCAL' and re.sub(r'^this\.', '', a['target']) == meth:
            return re.findall(r'\b([A-Za-z_]\w*)\.(?:Text|EditValue|Value)\b', a['value'])
    return []


def resolve(sc, meth, operand):
    """피연산자 → (ctl, part) part = Text|Text1|Text2|Value1|Value2|''"""
    operand = operand.strip()
    m = re.match(r'^([A-Za-z_]\w*)\.(Text1|Text2|Value1|Value2|Text|EditValue)\b', operand)
    if m and m.group(1) in sc.ctls:
        return m.group(1), m.group(2)
    if re.match(r'^[A-Za-z_]\w*$', operand):
        ex = sc.assigns(meth).get(operand, '')
        m = re.search(r'\b([A-Za-z_]\w*)\.(Text1|Text2|Value1|Value2|Text|EditValue)\b', ex)
        if m and m.group(1) in sc.ctls:
            return m.group(1), m.group(2)
    return '', ''


def pattern(sc, meth, br, cond, chain, handler):
    """→ {'trigger': step, 'pass': step, 'ctl': ctl} | {'why': 사유}"""
    c = strip_par(cond)
    parts = [strip_par(x) for x in re.split(r'\|\|', c)]
    # 기간 빈값
    if br == 'if' and len(parts) == 2 and all(re.match(r'^string\.IsNullOr(?:WhiteSpace|Empty)\((.+)\)$', p) for p in parts):
        rs = [resolve(sc, meth, re.match(r'^string\.IsNullOr(?:WhiteSpace|Empty)\((.+)\)$', p).group(1)) for p in parts]
        if rs[0][0] and rs[0][0] == rs[1][0] and sc.ctl_kind(rs[0][0]) == 'period':
            x = rs[0][0]
            return {'ctl': x, 'op': 'period', 'trigger': {'from': '', 'to': ''}, 'pass': {'from': '@TODAY', 'to': '@TODAY'}}
    # 빈값
    m = re.match(r'^string\.IsNullOr(?:WhiteSpace|Empty)\((.+)\)$', c) or re.match(r'^(.+?)(?:\.Trim\(\))?\s*==\s*""$', c) or re.match(r'^(.+?)\.(?:Trim\(\)\.)?Length\s*==\s*0$', c)
    if br == 'if' and m:
        x, part = resolve(sc, meth, m.group(1))
        if x and sc.ctl_kind(x) == 'text':
            return {'ctl': x, 'op': 'text', 'trigger': {'value': ''}, 'pass': {'value': f'@{ctl_name(x)}'}, 'needs': [ctl_name(x)]}
        return {'why': f'빈값 검사 대상 {m.group(1)} 의 입력칸을 원문에서 찾지 못함'}
    # 기간 역전
    m = re.match(r'^Convert\.ToInt(?:32|64)\((\w+)\)\s*>\s*Convert\.ToInt(?:32|64)\((\w+)\)$', c) or re.match(r'^(\w+)\s*>\s*(\w+)$', c)
    if br == 'if' and m:
        a, b = resolve(sc, meth, m.group(1)), resolve(sc, meth, m.group(2))
        if a[0] and a[0] == b[0] and sc.ctl_kind(a[0]) == 'period' and a[1] in ('Text1', 'Value1') and b[1] in ('Text2', 'Value2'):
            return {'ctl': a[0], 'op': 'period', 'trigger': {'from': '@TODAY+1', 'to': '@TODAY'}, 'pass': {'from': '@TODAY', 'to': '@TODAY'}}
    # 선택 없음
    m = re.match(r'^(\w+)\s*==\s*true$', c)
    if br == 'else' and m:
        f = m.group(1); boxes = set()
        for a in sc.by_meth.get(meth, []):
            if a['kind'] in ('LOCAL', 'FLAG') and a['target'] == f and a['value'].strip() == 'true':
                boxes.update(re.findall(r'\b(\w+)\.Items\[\w+\]\.CheckState\s*==\s*CheckState\.Checked', a['guard'] or ''))
        if len(boxes) == 1 and sc.ctl_kind(next(iter(boxes))) == 'multi':
            x = next(iter(boxes))
            return {'ctl': x, 'op': 'multi', 'trigger': {'mode': 'none'}, 'pass': {'mode': 'all'}}
    m = re.match(r'^(\w+)\.CheckedItems\.Count\s*==\s*0$', c)
    if br == 'if' and m and sc.ctl_kind(m.group(1)) == 'multi':
        return {'ctl': m.group(1), 'op': 'multi', 'trigger': {'mode': 'none'}, 'pass': {'mode': 'all'}}
    # 본인 지정
    m = re.match(r'^(\w+)\s*==\s*(.+)$', c)
    if br == 'if' and m and RX_ME.search(m.group(2)):
        v = m.group(1)
        for cm, _k, _r in chain:
            if any(a['kind'] in ('LOCAL', 'FLAG') and a['target'] == v for a in sc.by_meth.get(cm, [])):
                xs = [x for x in lookup_ctl(sc, handler, cm) if sc.ctl_kind(x) == 'text']
                if len(xs) == 1:
                    return {'ctl': xs[0], 'op': 'text', 'trigger': {'value': '@ME'}, 'pass': {'value': f'@{ctl_name(xs[0])}'}, 'needs': [ctl_name(xs[0])],
                            'note': f'{v} = {cm} 조회 결과({xs[0]} 값) · 로그인 계정과 같으면 발생'}
    return {'why': f'조건 해석 패턴 없음: {br} ({c[:120]})'}


