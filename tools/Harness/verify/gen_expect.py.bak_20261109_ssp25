HANDLER_SKIP = re.compile(r'^(SaveData|InsertButton|DeleteButton|InsertRow|Save|FindData|SearchButton|Form_Load|InitControls)', re.I)


def p_dirty(S):
    out, why = [], []
    seen = set()
    for a in S.actions:
        if a['kind'] != 'MESSAGE' or not re.search(r'==\s*CAppSetting\.(FlagI|StringI)', a['guard']):
            continue
        meth = a['method']
        if HANDLER_SKIP.search(meth) or '_' not in meth:
            continue
        ctl = meth.split('_', 1)[0]
        typ = S.ctype.get(ctl, '')
        m = re.search(r'"(MSG\d+)"', a['value'])
        if not m:
            continue
        texts, b = msg_texts(m.group(1))
        mre = text_re(texts)
        if not mre:
            why.append(f'{meth}:{a["line"]} 메시지 문구 없음')
            continue
        if re.search(r'Combo|Radio|CheckedList|Check', typ):
            lab = S.label.get(ctl) or S.text.get(ctl, '')
            if not lab:
                why.append(f'{ctl} 라벨 못 찾음')
                continue
            k = ('C4', lab)
            if k in seen:
                continue
            seen.add(k)
            out.append(row(S, 'P14', 'C4', f'신규 행 있을 때 {lab} 변경 차단', f'{S.prefix()}search;insert;cond:{lab}=@other', f"AS-IS {meth}:{a['line']} guard FlagI → {b}", msg_re=mre))
        elif re.search(r'Button', typ):
            lab = S.text.get(ctl, '')
            if not lab:
                why.append(f'{ctl} 버튼 글자 못 찾음')
                continue
            k = ('H10', lab)
            if k in seen:
                continue
            seen.add(k)
            out.append(row(S, 'P15', 'H10', f'신규 행 있을 때 {lab} 차단 안내', f'{S.prefix()}search;insert;btn:{lab}', f"AS-IS {meth}:{a['line']} guard FlagI → {b}", msg_re=mre))
        else:
            why.append(f'{meth}:{a["line"]} 컨트롤 형식 미확인({ctl}={typ or "없음"})')
    # DM-52 일반 규칙(문서 general_rule=Y): 편집 중 데이터가 있을 때 다른 기능 실행 → 모든 화면 단일 코드 MSG00680
    #   대상 = AS-IS 화면의 기능 버튼(공통 버튼 제외) — AS-IS 에 FlagI 검사가 없어도 TO-BE 확정 규칙(O2)이라 생성
    t680 = glob_facts()['tobe_msg'].get('MSG00680', {})
    m680 = text_re([x for x in (t680.get('KO'), t680.get('EN')) if x])
    common = re.compile(r'^(search|save|insert|delete|excel|edit|close|ok|cancel|확인|취소|닫기|조회|저장|추가|삭제|reset.*|column.*|measure.*|excel\s*(form|upload|download).*|upload|download|apply|select|선택|\.\.\.)$', re.I)
    for c, typ in S.ctype.items():
        if not re.search(r'Button', typ):
            continue
        lab = S.text.get(c, '').strip()
        if not lab or common.match(lab) or ('H10', lab) in seen or len(lab) > 30:
            continue
        seen.add(('H10', lab))
        out.append(row(S, 'P15', 'H10', f'편집 중 {lab} 실행 → MSG00680(DM-52 일반 규칙)', f'{S.prefix()}search;insert;btn:{lab}', f'DM-52 general_rule · AS-IS 버튼 {c} Text {lab!r}', msg_re=m680 or 'unsaved changes|저장하지 않은|저장 또는 취소|미저장'))
    if not out and not why:
        why.append('AS-IS 이벤트 핸들러에 신규 행(FlagI/StringI) 검사 메시지 없음 · 기능 버튼 없음')
    return out, why


