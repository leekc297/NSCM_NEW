COLREF = re.compile(r'DefColumns\.(\w+)')


def p_popfill(S):
    """팝업 셀 연쇄 채움(C3/D1) — AS-IS CellDoubleClick: e.Column==X 아래 POPUP → SetText/SetValue(e.Row, Y) · X 팝업 선택 뒤 Y 칸 값 있음"""
    pops = defaultdict(set)
    ref = {}
    for a in S.actions:
        if 'DoubleClick' not in a['method'] or a['kind'] != 'GRID_SET' or 'e.Row' not in a['raw']:
            continue
        xs = [x.upper() for x in re.findall(r'e\.Column\s*==\s*\w+\.GetColumnIndex\(DefColumns\.(\w+)\)', a['guard'])]
        if not xs or not re.search(r'SetText|SetValue', a['raw']):
            continue
        y = COLREF.search(a['raw'])
        for x in xs:  # e.Column == ITEM_ID || e.Column == ITEM_ID40 — 같은 팝업의 칸 별칭 전부
            if y and y.group(1).upper() not in xs:
                pops[x].add(y.group(1).upper())
                ref.setdefault(x, f"{a['method']}:{a['line']}")
    newcols = {r['column_name'].upper(): r for r in S.edit_cols(True)}
    out = []
    for x, ys in sorted(pops.items()):
        if x not in newcols:
            continue
        vis = [y for y in sorted(ys) if y in S.colmodel()]
        if not vis:
            continue
        cells = ';'.join(f'cell:~,{y}=~\\S' for y in vis)
        out.append(row(S, 'P24', 'C3', f'{x} 팝업 선택 → {", ".join(vis)} 채움', f'{S.prefix(newcols[x])}search;insert;popcell:{x}=;{cells}', f'AS-IS {ref[x]} 팝업 뒤 SetText {", ".join(vis)}'))
    return out, ([] if out else ['AS-IS 더블클릭 팝업 뒤 다른 칸 채움 없음(또는 신규 행 편집 칸 아님)'])


def p_samekey(S):
    """같은 키 묶음 동반 갱신(F3/F5) — AS-IS *_Changed: e.Column==X ▸ for 행 ▸ if (k1==n1 && k2==n2) ▸ SetValue(i, X, v)"""
    local = {}
    for a in S.actions:
        if a['kind'] == 'LOCAL':
            m = re.search(r'(\w+)\s*=\s*\w+\.Get(?:Text|Value)\([^,]+,\s*\w+\.GetColumnIndex\(DefColumns\.(\w+)\)', a['raw'])
            if m:
                local[(a['method'], m.group(1))] = m.group(2).upper()
    out, seen = [], set()
    for a in S.actions:
        if a['kind'] != 'GRID_SET' or 'Changed' not in a['method']:
            continue
        g = re.search(r'e\.Column\s*==\s*\w+\.GetColumnIndex\(DefColumns\.(\w+)\)\)\s*▸\s*for \(.*?\)\s*▸\s*if \((.+)\)\s*$', a['guard'])
        y = COLREF.search(a['raw'])
        if not g or not y or y.group(1).upper() != g.group(1).upper():
            continue
        x = g.group(1).upper()
        keys = [local.get((a['method'], v)) for v in re.findall(r'(\w+)\s*==', g.group(2))]
        keys = [k for k in keys if k]
        if not keys or x in seen or x not in {r['column_name'].upper() for r in S.edit_cols(False)}:
            continue
        seen.add(x)
        r = next(r for r in S.edit_cols(False) if r['column_name'].upper() == x)
        kk = ','.join(dict.fromkeys(['DIVISION_ID'] + keys if 'DIVISION_ID' in S.colmodel() else keys))
        out.append(row(S, 'P25', 'F3', f'{x} 입력 → 같은 {"·".join(keys)} 행 동반 갱신', f'{S.prefix(r)}search;gridcols:{x};samekey:{x}=9@{kk}', f"AS-IS {a['method']}:{a['line']} for 행 · if({g.group(2)[:60]}) SetValue {x}"))
    return out, ([] if out else ['AS-IS 변경 핸들러의 같은 키 행 동반 갱신 없음'])


# ── Division 조건 노출(doc_ui_expect 형식 · 2026-11-04 W8-2 ③) ─────────────────────────────
#   원천: AS-IS grid_code.csv set:Visible/VisibleColumns/SetColumnVisible/SetVisibleSheetColumn 의 conditions(부모 조건 사슬 ' ⟫ ' · else 쪽 = 'else!(…)')
#         · props.csv 버튼 Visible + 원문 감싼 if/else. Division 술어만 참·거짓으로 계산하고, 다른 술어(시트명·라디오·반복문)가 섞이면 만들지 않는다(사유).
#   판정 위험: col_hidden 은 머리글 글자로 찾으므로 라벨이 틀리면 허위 PASS → 같은 칸이 다른 Division 에서 '보임' 짝이 있을 때만 숨김 행을 만든다.
DIV_VAR = re.compile(r'[A-Za-z_][\w.]*(?:\(\))?(?:\.ToString\(\))?', re.I)
DOCUI_COLS = ['menu_id', 'cond', 'kind', 'name', 'source'] + ER.AUTO_COLS
