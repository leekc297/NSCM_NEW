def msg_texts(asis_id):
    """AS-IS 메시지 ID → (TO-BE 문구들 우선, 없으면 AS-IS 문구들) · 문구로 TO-BE ID 를 찾는다(msgmap 규칙 — ID 그대로 쓰지 않음)"""
    G = glob_facts()
    a = G['asis_msg'].get(asis_id.upper())
    if not a:
        return [], f'AS-IS 메시지 {asis_id} 원장 없음'
    cand = G['byko'].get(G['norm'](a['KO'])) or G['byen'].get(G['norm'](a['EN'])) or []
    if cand:
        t = G['tobe_msg'][sorted(cand)[0]]
        return [x for x in (t.get('KO'), t.get('EN')) if x], f'{asis_id}→{sorted(cand)[0]}(문구 일치)'
    return [x for x in (a['KO'], a['EN']) if x], f'{asis_id}(TO-BE 같은 문구 없음 → AS-IS 문구)'


def text_re(texts):
    """문구 → 정규식(자리표시자 사이 가장 긴 조각 · 4자 이상) — 언어별 OR"""
    parts = []
    for t in texts:
        frags = [f.strip(' .') for f in re.split(r'\{\s*\d+\s*\}|\n', t or '')]
        frags = [f for f in frags if len(f) >= 4]
        if frags:
            parts.append(re.escape(max(frags, key=len))[:60])
    return '|'.join(dict.fromkeys(parts))


