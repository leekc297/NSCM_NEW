def need_buttons(steps):
    """시나리오 단계가 누르는 데이터 변경 버튼 코드"""
    st = [x.strip() for x in (steps or '').split(';') if x.strip()]
    kinds = [x.split(':', 1)[0] for x in st]
    need = set()
    if 'insert' in kinds or 'insertat' in kinds:
        need.add('INSERT')
    if 'save' in kinds or any(x.lower().startswith('btn:save') for x in st):
        need.add('SAVE')
    if 'delrow' in kinds:
        need.add('DELETE')
    return need


def row_groups(r):
    """행의 계정 그룹 — user 열 'Div=40;DM Admin' 의 그룹 · 없으면 기본 계정 소속 그룹 합집합(화면 버튼 노출 기준 CR-070)"""
    G = glob_facts()
    grp = [x.strip() for x in (r.get('user') or '').split(';') if x.strip() and not re.match(r'^Div\s*=', x.strip(), re.I)]
    if grp:
        return set(grp), f"user 열 {'·'.join(grp)}"
    return set(G['user_gr'].get(DEFAULT_ACCOUNT, set())), f'기본 계정 {DEFAULT_ACCOUNT}'


def auth_filter(S, rows):
    G = glob_facts()
    keep, drop = [], []
    for r in rows:
        if r.get('_file', 'scenario_expect.csv') != 'scenario_expect.csv':
            keep.append(r)
            continue
        need = need_buttons(r.get('steps'))
        if not need:
            keep.append(r)
            continue
        grs, who = row_groups(r)
        # 그룹 ID 대소문자 무시(행 user 'DM Admin' ↔ btn_auth 'DM ADMIN' — 2026-11-05 DMF0042·0044·0049 176행 허위 제외)
        gl = {g.lower() for g in grs}
        have = set().union(*[v for k, v in G['btn_gr'][S.id].items() if k.lower() in gl]) if gl else set()
        miss = need - have
        if miss:
            drop.append(f"{r['pattern_id']} {r['name'][:40]} — {who} 그룹에 {'·'.join(sorted(miss))} 권한 없음(btn_auth use_yn=Y)")
        else:
            keep.append(r)
    return keep, drop


