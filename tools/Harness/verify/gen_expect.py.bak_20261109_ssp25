def p_sumtoggle(S):
    """P28 — AS-IS Sum 체크박스 = 재조회 없이 합계(기간 묶음 M_/W_) 칸 보임 토글 → sum_toggle toggle (GAP-338 DMF0048 유형)
       조건: chkSum 'Sum' · CheckedChanged 핸들러 · flow 에 그 핸들러 서버 경로 없음 · 원문 '.Visible = chkSum.Checked' · AS-IS 첫 상태 해제
       (실행기는 한 번 클릭해 칸이 늘어야 PASS — 첫 상태가 체크면 방향이 반대라 만들지 않는다)"""
    t = S.text.get('chkSum', '').strip()
    if not t or ER._norm_label(t) != 'sum':
        return [], ['AS-IS chkSum(Sum) 없음']
    ev = rcsv(os.path.join(S.dir, 'events.csv'))
    if not any(e.get('target', '').endswith('chkSum') and e.get('event') == 'CheckedChanged' for e in ev):
        return [], ['chkSum CheckedChanged 핸들러 없음']
    fl = rcsv(os.path.join(S.dir, 'flow.csv'))
    if any('chkSum' in (f.get('entry') or '') for f in fl):
        return [], ['chkSum 핸들러에 서버 경로 있음(flow) → 재조회형 — immediate 판단은 문서 몫']
    files = {r['file'] for r in rcsv(os.path.join(S.dir, 'files.csv')) if r.get('file', '').endswith('.cs') and is_main(r, S.dir)}
    uses, sets_true_designer, sets_false_code, bucket = [], False, False, False
    for f in files:
        L = asis_src(f) or []
        for i, ln in enumerate(L, 1):
            code = re.sub(r'//.*', '', ln)
            if re.search(r'\.Visible\s*=\s*chkSum\.Checked\b', code):
                ch = _enclosing(L, i) or ''
                uses.append(f'{os.path.basename(f)}:{i}')
                bucket = bucket or 'BucketType' in ch
            m = re.search(r'chkSum\.(?:Checked\s*=\s*(true|false)|CheckState\s*=\s*[\w.]*\.(Checked|Unchecked))', code)
            if m:
                on = (m.group(1) == 'true') or (m.group(2) == 'Checked')
                if 'Designer' in f:
                    sets_true_designer = sets_true_designer or on
                elif not on:
                    sets_false_code = True
    if not uses:
        return [], ["원문 '.Visible = chkSum.Checked' 없음 → 합계 칸 토글 아님"]
    if sets_true_designer and not sets_false_code:
        return [], ['AS-IS 첫 상태 = 체크(Designer true · 코드 해제 없음) → 실행기 토글 방향 반대 · 만들지 않음']
    cond = ''
    if bucket:
        bl = next((v for c, v in S.label.items() if 'bucket' in c.lower() and v), '')
        if not bl:
            return [], [f'합계 칸 조건이 BucketType({uses[0]})인데 화면 Bucket 조회조건 라벨 없음']
        cond = f'{bl.strip().rstrip("*").strip()}=Weekly'
    basis = f"원문 Visible = chkSum.Checked {len(uses)}곳({', '.join(uses[:3])}) · 서버 경로 없음 · 첫 상태 해제{' · Bucket 분기(Daily 외 = M_ 합계)' if bucket else ''}"
    return [{'_file': 'sum_toggle_expect.csv', 'menu_id': S.id, 'mode': 'toggle', 'label': t, 'cond': cond, 'source': f'자동 생성 P28 · {basis}', 'other': '',
             'pattern_id': 'P28', 'basis': basis, 'key': f'G7|sum|{ER._norm_label(t)}'}], []


