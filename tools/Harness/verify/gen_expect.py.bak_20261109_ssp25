def p_colvis(S):
    """P26 — AS-IS Division 조건 칸 보임/숨김 → doc_ui col_shown/col_hidden(Division 하나씩) · DM-47 AS FROM SITE · DM-239 · DM-243 유형"""
    why = []
    p = os.path.join(S.dir, 'grid_code.csv')
    if not os.path.exists(p):
        return [], ['AS-IS grid_code.csv 없음']
    dc = None
    U = base_divisions()
    ev = defaultdict(lambda: defaultdict(list))  # col → div → [(member,line,visible)]
    has_div, incomplete = set(), {}
    # 같은 칸의 대입은 조건 유무와 무관하게 전부 본다(2026-11-04 SCP0070 TYPE — 라디오 조건 줄을 빼고 남은 줄로만 정하면 근거 불완전):
    #   조건 없음 = 모든 Division · Division 술어만 = 계산 · 다른 술어 섞임 = 그 칸 전체 제외(incomplete)
    for r in rcsv(p):
        if not is_main(r, S.dir) or r['api'] not in VIS_API:
            continue
        cond = r.get('conditions') or ''
        raw = r.get('raw') or ''
        vis = re.findall(r'\b(true|false)\b', raw)
        if not vis:
            why.append(f"{r['line']} 표시 값 없음({raw[:40]})")
            continue
        col = (r.get('columns') or '').strip()
        if not col:
            m = re.search(r'DefColumns\.(\w+)', raw)
            if m:
                dc = dc if dc is not None else _defcols(S)
                col = dc.get(m.group(1), '')
                if not col:
                    why.append(f"{r['line']} DefColumns.{m.group(1)} 상수 원문 없음")
                    continue
        if not col or ',' in col:
            if re.search(r'div', cond, re.I):
                why.append(f"{r['line']} 칸 이름 미확정({col or raw[:40]})")
            continue
        C = col.upper()
        if re.search(r'div', cond, re.I):
            has_div.add(C)
        hits = []
        for d in U:
            v, w = chain_value(cond, d)
            if v is None:
                incomplete.setdefault(C, f"{r['member']}:{r['line']} {w}")
                break
            if v:
                hits.append(d)
        else:
            for d in hits:
                ev[C][d].append((r['member'], int(r['line']), vis[-1] == 'true'))
    out = []
    for C, w in sorted(incomplete.items()):
        if C in has_div:
            why.append(f'{C} 제외 — 같은 칸 대입에 Division 아닌 술어({w})')
    for col, bd in sorted(ev.items()):
        if col not in has_div or col in incomplete:
            continue
        state, clash = {}, ''
        for d, lst in bd.items():
            per_member = {}
            for mem, ln, v in sorted(lst, key=lambda x: x[1]):
                per_member[mem] = v  # 같은 핸들러 안 = 마지막 줄이 이김
            vs = set(per_member.values())
            if len(vs) > 1:
                clash = f'Division {d} 핸들러 간 상충 {per_member}(실행 순서 근거 없음)'
                break
            state[d] = vs.pop()
        if clash:
            why.append(f'{col} 제외 — {clash}')
            continue
        if True not in state.values() or False not in state.values():
            why.append(f'{col} 보임·숨김 짝 없음 {state} → 라벨 확인 불가(숨김 단독 행은 허위 PASS 위험)')
            continue
        lab, w = tobe_label(S, col)
        if not lab:
            why.append(f'{col} {w}')
            continue
        for want, kind in ((True, 'col_shown'), (False, 'col_hidden')):
            d = next(x for x in U if state.get(x) is want)  # division.csv 순서(40·81·82·EE) 첫 값 — EE 는 그 상태가 EE 뿐일 때만
            basis = f"grid_code {col} Division {d} {'보임' if want else '숨김'} · 전체 {dict(sorted(state.items()))}"
            out.append({'_file': 'doc_ui_expect.csv', 'menu_id': S.id, 'cond': f'Div={d}', 'kind': kind, 'name': lab, 'source': f'자동 생성 P26 · {basis}',
                        'pattern_id': 'P26', 'basis': basis, 'key': f"K4|docui|{kind}|{ER._norm_label(lab)}"})
    return out, (why if not out else why[:20])


BTN_CODE_ALIAS = {'excelform': ('EXCEL_FORM', 'TEMPLATE', 'EXCEL_TEMPLATE'), 'upload': ('EXCEL_UPLOAD', 'UPLOAD'), 'excelupload': ('EXCEL_UPLOAD', 'UPLOAD')}


def _enclosing(L, ln):
    """원문 ln(1부터) 을 감싼 블록 머리 사슬(안→밖) — 'if(...)' · 'else!(…)' 형식"""
    out, depth, i = [], 0, ln - 2
    while i >= 0 and len(out) < 6:
        t = re.sub(r'//.*', '', L[i])
        depth += t.count('}') - t.count('{')
        if depth < 0:
            hdr = t.split('{')[0].strip() or re.sub(r'//.*', '', L[i - 1]).strip()
            if hdr.startswith('if'):
                out.append('if(' + hdr[hdr.index('(') + 1:hdr.rindex(')')] + ')')
            elif hdr.startswith('else'):
                # 짝 if 찾기: 위로 '}' 직전 블록의 머리
                j, dep = i - 1, 0
                while j >= 0:
                    tj = re.sub(r'//.*', '', L[j])
                    dep += tj.count('}') - tj.count('{')
                    if dep < 0 or (dep == 0 and re.match(r'\s*if\s*\(', tj)):
                        break
                    j -= 1
                hj = re.sub(r'//.*', '', L[j]).strip() if j >= 0 else ''
                if not hj.startswith('if'):
                    return None
                out.append('else!(' + hj[hj.index('(') + 1:hj.rindex(')')] + ')')
            else:
                break  # 메서드 머리
            depth = 0
        i -= 1
    return ' ⟫ '.join(reversed(out))


def p_btnvis(S):
    """P27 — AS-IS 버튼 Visible 의 Division 조건 → doc_ui btn_shown/btn_hidden · TO-BE 원장(btn_auth)에 같은 버튼 코드가 있을 때만"""
