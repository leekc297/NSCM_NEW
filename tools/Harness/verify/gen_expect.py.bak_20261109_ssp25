def base_divisions():
    G = glob_facts()
    if 'divs' not in G:
        G['divs'] = [r['division_id'] for r in rcsv(os.path.join(TOBE, 'division.csv')) if r.get('valid_yn', 'Y') == 'Y' and '_' not in r['division_id']]
    return G['divs']


def _div_atom_value(atom, d):
    """Division 술어 하나 → True/False · Division 아닌 술어면 None"""
    a = atom.strip()
    neg = False
    while a.startswith('!') and not a.startswith('!='):
        neg, a = not neg, a[1:].strip()
    while a.startswith('(') and a.endswith(')') and a.count('(') == a.count(')'):
        a = a[1:-1].strip()
    m = re.fullmatch(r'(.+?)\s*==\s*false', a)
    if m:
        neg, a = not neg, m.group(1).strip()
    m = re.fullmatch(r'(.+?)\s*!=\s*null', a)
    if m:
        return not neg  # null 검사 = 화면이 떠 있으면 참
    v = None
    m = re.fullmatch(r'(.+?)\s*(==|!=)\s*"([^"]*)"', a)
    if m and re.search(r'div', m.group(1), re.I):
        lhs, op, lit = m.groups()
        dd = d[:2] if 'Substring(0, 2)' in lhs or 'Substring(0,2)' in lhs else d
        v = (dd == lit) if op == '==' else (dd != lit)
    m2 = re.fullmatch(r'(.+?)\.(Equals|Contains|StartsWith)\("([^"]*)"\)', a)
    if v is None and m2 and re.search(r'div', m2.group(1), re.I):
        lhs, fn, lit = m2.groups()
        dd = d[:2] if 'Substring(0, 2)' in lhs or 'Substring(0,2)' in lhs else d
        v = (dd == lit) if fn == 'Equals' else (lit in dd) if fn == 'Contains' else dd.startswith(lit)
    if v is None:
        return None
    return (not v) if neg else v


def div_pred(expr, d):
    """조건식(&&·|| 결합) → True/False · Division 아닌 술어가 있으면 None"""
    out = []
    for tok in re.split(r'(\&\&|\|\|)', expr):
        if tok in ('&&', '||'):
            out.append(' and ' if tok == '&&' else ' or ')
            continue
        t = tok.strip()
        # 괄호 균형 맞추기(바깥 괄호 벗기기 · 원자 안 괄호는 유지)
        lead = ''
        while t.startswith('(') and t.count('(') > t.count(')'):
            lead, t = lead + '(', t[1:].strip()
        trail = ''
        while t.endswith(')') and t.count(')') > t.count('('):
            trail, t = trail + ')', t[:-1].strip()
        v = _div_atom_value(t, d)
        if v is None:
            return None
        out.append(f'{lead}{v}{trail}')
    try:
        return bool(eval(''.join(out), {'__builtins__': {}}, {}))
    except Exception:
        return None


def chain_value(cond, d):
    """부모 조건 사슬 ' ⟫ ' 전체가 Division d 에서 참인지 · 하나라도 Division 아닌 술어면 None(사유)"""
    if not cond:
        return True, ''
    for part in cond.split(' ⟫ '):
        part = part.strip()
        if part.startswith('else!('):
            e, neg = part[len('else!('):-1], True
        elif part.startswith('if('):
            e, neg = part[3:-1], False
        else:
            return None, f'조건 {part[:40]} (if/else 아님)'
        v = div_pred(e, d)
        if v is None:
            return None, f'Division 아닌 술어 {e[:50]}'
        if neg:
            v = not v
        if not v:
            return False, ''
    return True, ''


def _defcols(S):
    """DefColumns 상수 → 칸 이름(AS-IS 원문 const string X = "Y") · 화면 파일 전부"""
    if hasattr(S, '_dc'):
        return S._dc
    dc = {}
    for f in {r['file'] for r in rcsv(os.path.join(S.dir, 'files.csv')) if r.get('file', '').endswith('.cs') and is_main(r, S.dir)} if os.path.exists(os.path.join(S.dir, 'files.csv')) else set():
        L = asis_src(f)
        for ln in L or []:
            m = re.search(r'(?:const\s+string|static\s+(?:readonly\s+)?string)\s+(\w+)\s*=\s*"([^"]+)"', ln)
            if m:
                dc.setdefault(m.group(1), m.group(2))
    S._dc = dc
    return dc


def _empty_override(S, name):
    """AS-IS 화면 파일(current)에 'override void <name>()' 이 있고 본문에 문장이 없으면 '파일:줄' — 주석·빈 줄만 있는 본문"""
    for f in sorted({r['file'] for r in rcsv(os.path.join(S.dir, 'files.csv')) if r.get('file', '').endswith('.cs') and is_main(r, S.dir)} if os.path.exists(os.path.join(S.dir, 'files.csv')) else set()):
        L = asis_src(f) or []
        for i, ln in enumerate(L):
            if re.search(r'override\s+void\s+' + name + r'\s*\(\s*\)', ln) and not ln.strip().startswith('//'):
                body, depth, started = [], 0, False
                for x in L[i:]:
                    code = re.sub(r'//.*', '', x)
                    for ch in code:
                        if ch == '{':
                            depth += 1
                            started = True
                        elif ch == '}':
                            depth -= 1
                    body.append(code)
                    if started and depth <= 0:
                        break
                inner = re.sub(r'/\*.*?\*/', '', ' '.join(body), flags=re.S)
                inner = inner[inner.find('{') + 1: inner.rfind('}')] if '{' in inner else inner
                if not inner.strip():
                    return f"{os.path.basename(f)}:{i + 1}"
                return ''
    return ''


_SRC = {}


def asis_src(f):
    if f not in _SRC:
        p = os.path.join(ROOT, 'GSCM', f.replace('\\', os.sep))
        try:
            with open(p, encoding='utf-8-sig', errors='replace') as h:
                _SRC[f] = h.read().split('\n')
