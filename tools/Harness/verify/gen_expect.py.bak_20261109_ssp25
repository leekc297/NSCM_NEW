def asis_of(mid):
    """TO-BE ID → AS-IS ID — run_verify.asis_of 와 같은 규칙(map_screen.csv tobe_id → asis_id · 없으면 같은 ID)
       2026-11-04: 종전엔 Doc/asisfacts/screens/<TO-BE ID> 를 읽어 SYS 19화면(SYS0002 ↔ GSCM_USERINFO 등)이 AS-IS 사실 없이 생성됐다"""
    G = glob_facts()
    if 'asis_map' not in G:
        G['asis_map'] = {}
        for r in rcsv(os.path.join(ROOT, 'tools', 'Harness', 'rules', 'map_screen.csv')):
            G['asis_map'].setdefault((r.get('tobe_id') or '').upper(), (r.get('asis_id') or '').upper())
    return G['asis_map'].get(mid.upper()) or mid


class Screen:
    def __init__(self, mid, asis=None):
        self.id = mid
        G = glob_facts()
        self.asis = (asis or asis_of(mid)).upper()
        d = os.path.join(ASIS, 'screens', self.asis)
        self.dir = d
        self.has_asis = os.path.exists(os.path.join(d, 'actions.csv'))
        self.actions = rcsv(os.path.join(d, 'actions.csv'))
        self.props = rcsv(os.path.join(d, 'props.csv'))
        self.controls = rcsv(os.path.join(d, 'controls.csv'))
        self.cell_clear = rcsv(os.path.join(d, 'cell_clear.csv'))
        self.cell_rules = rcsv(os.path.join(d, 'cell_rules.csv'))
        self.combo_src = rcsv(os.path.join(d, 'combo_src.csv'))
        self.cols = [r for r in G['sheet'].get(mid, []) if r.get('valid_yn', 'Y') == 'Y' and r.get('visible_flag', 'Y') == 'Y']
        self.btns = G['btn'].get(mid, set())
        self.btn_codes = {b for _, b in self.btns}
        # 레이아웃 라벨: 항목 Control=this.X → 항목 Text · 버튼 자체 Text
        ctl_item, txt = {}, {}
        for p in self.props:
            if not is_main(p, self.dir):
                continue
            if p['prop'] == 'Control':
                ctl_item[p['value'].replace('this.', '').strip()] = p['target']
            elif p['prop'] == 'Text':
                txt.setdefault(p['target'], p['value'].strip().strip('"'))
        self.label = {c: txt.get(it, '') for c, it in ctl_item.items()}
        self.text = txt
        self.ctype = {}
        for c in self.controls:
            if is_main(c, self.dir):
                self.ctype.setdefault(c['name'], c['type'].split('.')[-1])
        self.env = self._env()

    def _env(self):
        G = glob_facts()
        ov = G['env_override'].get(self.id)
        if ov:
            return {'division': ov.get('division', ''), 'user': ov.get('user', ''), 'basis': f"override {ov.get('source', '')}"}
        c = Counter(r['division_id'].strip() for r in self.cols if re.fullmatch(r'40|81|82', (r.get('division_id') or '').strip()))
        if not c:
            return {'division': '', 'user': '', 'basis': 'sheet_columns 단일 Division 칸 없음 → 기본 계정·기본 조건'}
        d, n = c.most_common(1)[0]
        return {'division': d, 'user': '', 'basis': f'sheet_columns 단일 Division 칸 최다 {d}({n}칸 · 분포 {dict(c)})'}

    # TO-BE 칸 분류(INPUT_TP_CD: S 표시 · O/M 편집(M 필수) · IO/IM 신규 행만(IM 필수))
    #   2026-11-04 실측: 같은 칸이 공통 시트(Production = S)와 Division 시트(production_81 = M)에 따로 있다 → 칸 이름으로 모은 뒤
    #   편집 판정은 '어느 행이든 편집 코드', Division 은 편집 행의 시트 접미(_40/_81/_82) 또는 division_id 목록에서 고른다.
    def colmodel(self):
        if hasattr(self, '_cm'):
            return self._cm
        cm = {}
        for r in self.cols:
            k = r['column_name'].upper()
            m = cm.setdefault(k, {'col': k, 'rows': [], 'tp': set(), 'divs': set(), 'alldiv': False, 'ctrl': ''})
            m['rows'].append(r)
            tp = (r.get('input_tp_cd') or '').strip()
            m['tp'].add(tp)
            if tp in ('O', 'M', 'IO', 'IM'):
                sm = re.search(r'_(40|81|82)$', r['sheet_name'])
                dl = [x.strip() for x in (r.get('division_id') or '').split(',') if re.fullmatch(r'40|81|82', x.strip())]
                if sm:
                    m['divs'].add(sm.group(1))
                elif dl:
                    m['divs'] |= set(dl)
                else:
                    m['alldiv'] = True
            t = (r.get('cell_control_object_type_code') or '').strip()
            if t and (not m['ctrl'] or tp in ('O', 'M', 'IO', 'IM')):
                m['ctrl'] = t
                m['src'] = r
        for m in cm.values():
            m.setdefault('src', m['rows'][0])
        self._cm = cm
        return cm

    def edit_cols(self, new_row, required=False):
        ok = (('M', 'IM') if new_row else ('M',)) if required else (('O', 'M', 'IO', 'IM') if new_row else ('O', 'M'))
        out = []
        for m in self.colmodel().values():
            if m['tp'] & set(ok):
                r = dict(m['src'])
                r['column_name'] = m['col']
                r['cell_control_object_type_code'] = m['ctrl']
                r['input_tp_cd'] = '/'.join(sorted(m['tp'] & set(ok)))
                r['_divs'] = m['divs']
                r['_alldiv'] = m['alldiv']
                out.append(r)
        return out

    def has_div_cond(self):
        return any(re.fullmatch(r'div(ision)?', ER._norm_label(v)) for v in self.label.values()) or any(r['column_name'].upper() == 'DIVISION_ID' for r in self.cols)

    def div_for(self, r=None):
        """칸이 편집되는 Division — 화면 기본(env)이 그 칸에 해당하면 그것, 아니면 칸의 첫 Division(81·82·40 순)"""
        d = self.env['division']
        if r is None or r.get('_alldiv') or not r.get('_divs'):
            return d
        if d in r['_divs']:
            return d
        return next(x for x in ('81', '82', '40') if x in r['_divs'])

    def prefix(self, r=None):
        """시나리오 공통 머리 — Division 조건(조회조건에 Division 이 있을 때)"""
        d = self.div_for(r)
        return f'cond:Div={d};' if d and self.has_div_cond() else ''


DATE_NAME = re.compile(r'(^|_)(DATE|DT|YYYYMMDD)($|_)', re.I)


def ctype_kind(r):
    t = (r.get('cell_control_object_type_code') or '').strip()
    if 'Combo' in t:
        return 'combo'
    if 'Date' in t:
        return 'date'
    # 날짜를 숫자 글자(yyyymmdd)로 받는 칸 — DMF0072 VALID_START_DATE = FPNumberText(2026-11-04 실측)
    if DATE_NAME.search(r.get('column_name') or '') and t in ('FPNumberText', 'FPText', 'FPTextBox', 'FPNumber', 'FPDateText'):
        return 'date'
    if 'Number' in t or t == 'FPPercent':
        return 'number'
    if 'Modal' in t:
        return 'popup'
    if 'CheckBox' in t:
        return 'check'
    return 'text'


