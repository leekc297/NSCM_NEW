                out.append({'_file': 'doc_ui_expect.csv', 'menu_id': S.id, 'cond': f'Div={d}', 'kind': kind, 'name': txt, 'source': f'자동 생성 P27 · {basis}',
                            'pattern_id': 'P27', 'basis': basis, 'key': f"K4|docui|{kind}|{ER._norm_label(txt)}"})
    return out, why[:20]


def p_divroundtrip(S):
    """P30 — AS-IS 메타(SCM_MST_SHEET_COLUMNS.DIVISION_ID)가 일부 Division 에만 둔 칸 → Div A→B→A 전환 뒤 칸 노출(colvis) · DM-P60(DMF0021 K2) 유형
       칸 선택: DEFAULT_FLAG=Y 이고 (필수 M/IM 우선 → 사용자 숨김 불가 USER_SELECTABLE_FLAG=N) · TO-BE sheet_columns 에 같은 칸 · 화면당 1칸(실행 시간)
       Division 고정 화면(scenario_env_override) 제외 · 0행이어도 칸은 그려지므로 search0"""
    if glob_facts()['env_override'].get(S.id):
        return [], [f"Division 고정 화면(override {glob_facts()['env_override'][S.id].get('division', '')}) — 전환 시험 불가"]
    p = os.path.join(S.dir, 'dbmeta_dbo_SCM_MST_SHEET_COLUMNS.csv')
    if not os.path.exists(p):
        return [], ['AS-IS 메타 SCM_MST_SHEET_COLUMNS 없음(코드로 그리는 화면)']
    if not S.has_div_cond():
        return [], ['조회조건에 Division 없음']
    pre = lambda d: [x.strip()[:2] for x in (d or '').split(',') if x.strip()]
    rows = [r for r in rcsv(p) if (r.get('PROGRAM_ID') or '').upper() == S.asis and r.get('VALID_YN') == 'Y' and r.get('VISIBLE_FLAG') == 'Y']
    U = [d for d in base_divisions() if any(d in pre(r['DIVISION_ID']) for r in rows)]
    # 주 그리드 = AS-IS 메타 칸이 가장 많은 시트(colvis 는 현재 그리드만 본다 — 저장용·하위 시트 칸을 고르면 허위 FAIL · 2026-11-04 DMF0082 'Sales Price Save All')
    sc = Counter(r['SHEET_NAME'] for r in rows)
    main = sc.most_common(1)[0][0] if sc else ''
    rows = [r for r in rows if r['SHEET_NAME'] == main]
    # 칸 고르기 = TO-BE 플래그(시험 계정 개인화로 숨겨지지 않는 칸 — TO-BE user_selectable N) · 기대(어느 Division 에 있나) = AS-IS 메타
    #   2026-11-04 DMF0021 END_CUSTOMER40: AS-IS S·선택 가능 / TO-BE IM·선택 불가 — AS-IS 플래그로 고르면 빠졌다
    tobe = defaultdict(list)
    for t0 in glob_facts()['sheet'].get(S.id, []):
        if t0.get('valid_yn', 'Y') == 'Y':
            tobe[t0['column_name'].upper()].append(t0)
    cand = []
    for r in rows:
        ds = sorted(set(pre(r['DIVISION_ID'])), key=lambda x: U.index(x) if x in U else 9)
        out_ds = [d for d in U if d not in ds]
        tb = tobe.get(r['COLUMN_NAME'].upper(), [])
        if not ds or not out_ds or r.get('DEFAULT_FLAG') != 'Y' or not tb:
            continue
        if not any(x.get('user_selectable_flag') == 'N' and x.get('default_flag', 'Y') == 'Y' for x in tb):
            continue
        req = any((x.get('input_tp_cd') or '').strip() in ('M', 'IM') for x in tb)
        rank = (0 if req else 1) + (2 if r['COLUMN_NAME'].upper().endswith('_ID') or r['COLUMN_NAME'].upper() == 'DIVISION_ID' else 0)
        if True:
            cand.append((rank, int(r.get('SORT_ORDER_NO') or 0), r, ds[0], out_ds[0]))
    if not cand:
        return [], [f'일부 Division 칸 중 AS-IS 기본 표시 · TO-BE 숨김 불가 칸 없음(화면 Division {U})']
    rank, _, r, a, b = sorted(cand, key=lambda x: (x[0], x[1]))[0]
