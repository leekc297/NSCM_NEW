def generate(mid, asis=None):
    S = Screen(mid, asis)
    rows, rep = [], {'id': mid, 'asis': S.asis, 'at': datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'), 'has_asis': S.has_asis, 'tobe_cols': len(S.cols), 'buttons': sorted(S.btn_codes), 'env': S.env, 'patterns': {}}
    for fn in PATTERNS:
        try:
            out, why = fn(S)
        except Exception as e:  # 패턴 하나의 사실 형식 문제로 전체가 멈추지 않게 — 사유는 보고서에
            out, why = [], [f'예외 {type(e).__name__}: {e}']
        rows += out
        rep['patterns'][fn.__name__] = {'rows': len(out), 'why_not': why}
    # 2026-11-05 사용자 지시: 시험 계정에 그 버튼 권한(btn_auth use_yn=Y)이 실제로 있는 행만 — Insert·Save·Delete 단계 행
    #   실측 05:44: Insert 단계 자동 행 814 중 70(11화면 · P07~P10·P14·P15)이 INSERT=Y 그룹 0 인 화면에 생성돼 '버튼 없음' ERROR 원인
    rows, rep['auth_drop'] = auth_filter(S, rows)
    # 이름 중복 방지(시나리오 대상 = '<ID> 시나리오 <name>')
    seen = Counter()
    for r in rows:
        if r.get('_file', 'scenario_expect.csv') != 'scenario_expect.csv':
            continue  # doc_ui 등은 name 이 화면 글자 대조값 — 접미 금지(대상 이름은 kind·name·cond 로 이미 유일)
        seen[r['name']] += 1
        if seen[r['name']] > 1:
            r['name'] += f' #{seen[r["name"]]}'
    od = os.path.join(ER.V, mid, 'auto_expect')
    os.makedirs(os.path.join(od, '_all'), exist_ok=True)
    # _all = 전체(재현율 측정용) · 본 파일 = 손 행과 키가 전부 겹치는 행을 뺀 소비용(spec 은 손 행 + 이 파일을 이어 붙이기만 한다)
    #   파일별(2026-11-04 W8-2 ③): 행의 _file(없으면 scenario_expect.csv) · 행이 0 이어도 머리글만 있는 파일을 써서 지난 생성본을 지운다
    used_tot = 0
    rep['files'] = {}
    for fname, cols in FILE_COLS.items():
        frows = [r for r in rows if r.get('_file', 'scenario_expect.csv') == fname]
        hk = set()
        for h in ER.hand_rows(fname, mid):
            hk |= ER.keys_of(fname, h)
        use = [r for r in frows if not ({x for x in r['key'].split(' + ') if x} and {x for x in r['key'].split(' + ') if x} <= hk)]
        used_tot += len(use)
        rep['files'][fname] = {'rows': len(frows), 'used': len(use)}
        for path, rs in ((os.path.join(od, '_all', fname), frows), (os.path.join(od, fname), use)):
            if not rs and not os.path.exists(path) and fname != 'scenario_expect.csv':
                continue
            with open(path, 'w', encoding='utf-8-sig', newline='') as f:
                w = csv.DictWriter(f, fieldnames=cols)
                w.writeheader()
                for r in rs:
                    w.writerow({k: r.get(k, '') for k in cols})
    rep['rows'] = len(rows)
    rep['rows_used'] = used_tot
    rep['dup_of_hand'] = len(rows) - used_tot
    with open(os.path.join(od, '_gen_report.json'), 'w', encoding='utf-8') as f:
        json.dump(rep, f, ensure_ascii=False, indent=1)
    return rows, rep


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('ids', nargs='*')
    ap.add_argument('--all', action='store_true', help='손 기대 행이 있는 화면 + 원장 있는 화면 전부')
    ap.add_argument('--asis', default='', help='AS-IS ID(화면 1개일 때 · 없으면 map_screen.csv)')
    a = ap.parse_args()
    ids = list(a.ids)
    if a.all:
        hs = set()
        for n in ER.EXPECT_FILES:
            hs |= {r['menu_id'] for r in ER.read_csv(os.path.join(ER.V, n))[0] if r.get('menu_id')}
        hs |= {d for d in os.listdir(ER.V) if os.path.exists(os.path.join(ER.V, d, 'verify_ledger.csv'))}
        ids = sorted(hs)
    if not ids:
        ap.error('화면 ID 또는 --all')
    tot = 0
    for mid in ids:
        rows, rep = generate(mid, a.asis if a.asis and len(ids) == 1 else None)
        tot += len(rows)
        pc = Counter(r['pattern_id'] for r in rows)
        print(f"{mid}: 자동 행 {len(rows)} {dict(sorted(pc.items()))} · env {rep['env']['division'] or '-'}({rep['env']['basis'][:50]})")
    print(f'합계 {tot}행 · 화면 {len(ids)}')


if __name__ == '__main__':
