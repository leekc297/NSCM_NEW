def row(S, pid, rule, name, steps, basis, msg_re='', no_save='', no_editor='', user=None):
    r = {'menu_id': S.id, 'name': f'[자동] {name}', 'steps': steps, 'msg_re': msg_re, 'no_save': no_save, 'no_editor': no_editor,
