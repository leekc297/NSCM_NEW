            m = re.search(r'"(MSG\d+)"', a['value'])
            if m:
                msgs.append((m.group(1), a))
    if not req and not msgs:
        return [], ['필수 칸(M/IM) 없음 · AS-IS 저장 빈값 검사 없음']
    texts, basis = [], []
    for mid, a in msgs[:20]:
