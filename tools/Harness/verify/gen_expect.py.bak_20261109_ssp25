    req = [r for r in S.edit_cols(True) if (r.get('input_tp_cd') or '').strip() in ('M', 'IM')]
    msgs = []
    for a in S.actions:
        # 2026-11-05 SCP0111 — 바깥 guard(nowGroupID IsNullOrEmpty)까지 보면 중복·성공 문구가 섞임 → 가장 안쪽 조건만
        inner = (a['guard'] or '').split(' ▸ ')[-1]
