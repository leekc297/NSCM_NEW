_G = {}


def glob_facts():
    if _G:
        return _G
    _G['sheet'] = defaultdict(list)
    for r in rcsv(os.path.join(TOBE, 'sheet_columns.csv')):
        if r['program_id'] and r['program_id'] != '--':
            _G['sheet'][r['program_id']].append(r)
    _G['btn'] = defaultdict(set)
    _G['btn_gr'] = defaultdict(lambda: defaultdict(set))  # mnu_id → user_gr_id → {버튼 코드}(use_yn=Y)
    for r in rcsv(os.path.join(TOBE, 'btn_auth.csv')):
        if r.get('use_yn', 'Y') == 'Y':
            _G['btn'][r['mnu_id']].add((r['sht_nm'].lower(), r['mnu_btn_cd'].upper()))
            _G['btn_gr'][r['mnu_id']][r['user_gr_id']].add(r['mnu_btn_cd'].upper())
    _G['user_gr'] = defaultdict(set)  # user_id → {user_gr_id}
    for r in rcsv(os.path.join(TOBE, 'user_group_user.csv')):
        if r.get('use_yn', 'Y') == 'Y':
            _G['user_gr'][r['user_id']].add(r['user_gr_id'])
    tob = defaultdict(dict)
    for r in rcsv(os.path.join(TOBE, 'msg_master.csv')):
        if r['msg_id'].upper().startswith('MSG') and r.get('use_yn', 'Y') == 'Y':
            tob[r['msg_id'].upper()][r['lang_cd'].upper()] = r['msg_nm']
    _G['tobe_msg'] = tob
    asis = {}
    for r in rcsv(os.path.join(ASIS, 'db', 'meta', 'dbo.TB_FX_MessageInfo.csv')):
        asis[(r.get('MessageID') or '').upper()] = {'KO': r.get('Ko', ''), 'EN': r.get('En', '')}
    _G['asis_msg'] = asis
    norm = lambda s: re.sub(r"[\s.,!?。！？:;'\"`·~\-_()\[\]]", '', re.sub(r'\{\s*\d+\s*\}', '{n}', s or '')).lower()
    _G['norm'] = norm
    byko, byen = defaultdict(list), defaultdict(list)
    for i, t in tob.items():
        if t.get('KO'):
            byko[norm(t['KO'])].append(i)
        if t.get('EN'):
            byen[norm(t['EN'])].append(i)
    _G['byko'], _G['byen'] = byko, byen
    ov = {}
    for r in rcsv(os.path.join(ER.V, 'scenario_env_override.csv')):
        ov[r['menu_id']] = r
