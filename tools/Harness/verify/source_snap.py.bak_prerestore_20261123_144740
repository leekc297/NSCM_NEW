    chk('두 단계 바뀜 = 앞 단계부터', resume_decide(order, done, fps, core, com, dict(now, **{'v/eg.py': '9', 'v/facts.py': '9'}), com)[:2] == ('from', 'facts'))
    r = resume_decide(order, done, fps, core, com, dict(now, **{'v/run_verify.py': '9'}), com, engine={'v/diff_verify.py': '1', 'v/run_verify.py': '1'})
    chk('run_verify.py 바뀜 = 처음부터, 바뀐 파일에 diff_verify.py 도 적음', r == ('restart', 'pre', ['v/diff_verify.py', 'v/run_verify.py']))
    chk('공용(FE) 바뀜, 새 공용 파일 = 처음부터', resume_decide(order, done, fps, core, com, now, {'fe:a.tsx': '2'})[0] == 'restart' and resume_decide(order, done, fps, core, com, now, {'fe:a.tsx': '1', 'fe:n.tsx': '1'})[2] == ['fe:n.tsx'])
    chk('첫 단계 지문 바뀜 = 처음부터', resume_decide(order, done, fps, core, com, dict(now, **{'v/pre.py': '9'}), com)[:2] == ('restart', 'pre'))
    chk('끝난 단계 지문 기록 없음 = 그 단계부터 다시', resume_decide(order, done, {k: v for k, v in fps.items() if k != 'e2e'}, core, com, now, com) == ('from', 'e2e', []))
    chk('사건에 적는 이름', short_name('lib:tools/E2E/lib/x.ts') == 'x.ts' and short_name('tools/Harness/verify/diff_verify.py') == 'diff_verify.py' and short_name('test:_verify.spec.ts:가 시험') == '_verify.spec.ts:가 시험')
    print('ALL PASS' if ok else 'SOME FAIL'); return 0 if ok else 1


def main():
    a = sys.argv[1:]
    if '--selftest' in a:
        return selftest()
    if not a:
        print(__doc__); return 2
    mid = a[0].upper()
    if '--save' in a:
        mode = 'full' if '--full' in a else 'delta'
        s = save(mid, mode)
        print(f"[기준선] {mid} 저장 · 항목 {len(s['items'])}개 · {('DB 읽기 실패 ' + s['db_error']) if s['db_error'] else 'DB 읽음'} · {mode} → Doc/verify/{mid}/source_baseline.json", flush=True); return 0
    if '--diff' in a:
        base = load(mid)
        if not base:
            print(json.dumps({'menu_id': mid, 'baseline': None}, ensure_ascii=False)); return 3
        cur = snapshot(mid); ch, ad, rm = diff(base, cur)
        out = {'menu_id': mid, 'baseline_at': base.get('at'), 'last_full': base.get('last_full', ''), 'now': cur['at'], 'db_error': cur['db_error'],
               'changed': ch, 'added': ad, 'removed': rm, 'n_base': len(base.get('items') or {})}
        json.dump(out, open(path_of(mid, 'source_diff.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
        print(json.dumps({k: (v if not isinstance(v, list) else len(v)) for k, v in out.items()}, ensure_ascii=False)); return 0
    print(__doc__); return 2


if __name__ == '__main__':
    sys.exit(main())
