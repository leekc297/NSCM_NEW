def local_imports(path, seen=None):
    """py 파일이 import 하는 같은 폴더, tools/Harness/verify 모듈 파일(재귀, 함수 안 import 포함) → 절대경로 집합"""
    seen = set() if seen is None else seen
    path = os.path.abspath(path)
    if path in seen or not path.endswith('.py'):
        return seen
    seen.add(path)
    try:
        src = open(path, encoding='utf-8', errors='replace').read()
    except OSError:
        return seen
    names = set()
    for m in re.finditer(r'(?m)^[ \t]*(?:from[ \t]+([A-Za-z_]\w*)[\w.]*[ \t]+import\b|import[ \t]+([^\n#;]+))', src):
        if m.group(1):
            names.add(m.group(1))
        else:
            for part in m.group(2).split(','):
                n = part.strip().split(' ')[0].split('.')[0]
                if n:
                    names.add(n)
    for n in sorted(names):
        for d in (os.path.dirname(path), HERE):
            p = os.path.join(d, n + '.py')
            if os.path.isfile(p):
                local_imports(p, seen); break
    return seen


def stage_items(scripts=(), mods=()):
    """단계 지문 {저장소 상대경로: 해시}. scripts = 단계가 실행한 스크립트 경로, mods = 단계 중 run_verify 프로세스에 새로 올라온 모듈 파일"""
    files = set()
    for s, deep in [(x, True) for x in scripts] + [(x, False) for x in mods]:
        p = os.path.abspath(s)
        if not os.path.isfile(p) or not p.startswith(ROOT + os.sep) or (os.sep + 'node_modules' + os.sep) in p:
            continue
        if deep and p.endswith('.py'):
            local_imports(p, files)   # 따로 띄운 스크립트는 올라온 모듈을 볼 수 없어 import 글줄로 따라간다
        else:
            files.add(p)              # 이 프로세스에 올라온 모듈은 그 파일만(올라온 것이 곧 쓴 것)
    return {rel(p): fhash(p) for p in sorted(files)}


def file_hashes(keys):
    """저장소 상대경로 목록 → {경로: 지금 해시}(없는 파일은 '')"""
    return {k: fhash(os.path.join(ROOT, *k.split('/'))) for k in keys}


def short_name(key):
    """지문 키 → 사건, 로그에 적는 이름. 파일은 파일명, 시험 본문은 '스펙:제목'"""
    if key.startswith('test:'):
        return key[5:]
    return os.path.basename(key.split(':', 1)[1] if key.split(':', 1)[0] in ('fe', 'shared', 'lib', 'spec') else key)


def resume_decide(order, done, fps, core, common, now_files, now_common, engine=None):
    """재개 판정. fps = {단계: {경로: 해시}}, core, engine = {경로: 해시}, common = {키: 해시}, now_files = 지금 {경로: 해시}, now_common = 지금 공용 지문
       반환 (mode, 단계, 바뀐 키 목록): 'keep' = 그대로 재개, 'from' = 그 단계부터 다시(앞 단계 유지), 'restart' = 처음부터(core 또는 공용이 바뀜, 첫 단계 지문이 바뀜)"""
    def ch(d):
        return sorted(k for k, v in (d or {}).items() if now_files.get(k, '') != v)
    cc = ch(core)
    cm = sorted(k for k in set(common or {}) | set(now_common or {}) if (common or {}).get(k) != (now_common or {}).get(k))
    per = {st: ch(fps.get(st)) for st in order if st in done}
    if cc or cm:
        allch = set(cc) | set(cm) | set(ch(engine))
        for v in per.values():
            allch |= set(v)
        return 'restart', order[0], sorted(allch)
    for st in order:
        if st not in done:
            continue
        if st not in (fps or {}):
            return ('restart' if st == order[0] else 'from'), st, []   # 끝난 단계인데 지문 기록이 없음 = 모르는 것은 다시 실행
        if per[st]:
            return ('restart' if st == order[0] else 'from'), st, per[st]
    return 'keep', '', []


