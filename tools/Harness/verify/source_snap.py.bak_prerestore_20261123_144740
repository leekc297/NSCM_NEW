            if fn.endswith(('.ts', '.tsx')):
                try:
                    names |= set(re.findall(r"""from\s+['"]@shared/([A-Za-z0-9_-]+)['"]""", open(os.path.join(dp, fn), encoding='utf-8').read()))
                except (OSError, ValueError):
                    pass
