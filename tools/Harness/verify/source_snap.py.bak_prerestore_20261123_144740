def blob(data):
    return hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest()


def fhash(p):
    try:
        with open(p, 'rb') as f:
            return blob(f.read())
    except OSError:
        return ''


def rel(p):
    return os.path.relpath(p, ROOT).replace(os.sep, '/')


