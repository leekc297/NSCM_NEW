    # 3) 그리드 컬럼 — 기대값은 AS-IS 근거(facts_lockrules.py edit_expect.csv · facts_cellrules.py cell_rules.csv). TO-BE 메타는 '대상 목록'일 뿐 정답이 아니다
    sdir = P('Doc', 'asisfacts', 'screens', asis_id)
