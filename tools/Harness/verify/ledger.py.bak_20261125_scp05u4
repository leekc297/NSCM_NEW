        add('RULE_SCREEN', 'G1', f'{mid} 텍스트 부분일치 {_nm}', condition='값의 일부만 입력해 조회', area='조회조건', expected='부분일치(Like) — 그 값을 가진 행 포함 · 조건 밖 행 0', method='E2E', note='전용')
