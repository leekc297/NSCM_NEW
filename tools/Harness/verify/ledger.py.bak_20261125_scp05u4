                #   → CELL=FPTextBox 도 일반 텍스트 셀. 종전엔 CELL=- 만 일반으로 봐 '직접 편집 차단' 기대를 만들었다
                _plain = (_acr.get('cell_type') or 'TEXT').upper() in ('TEXT', '', 'FPTEXTBOX') and re.search(r'CELL=(-|FPTextBox)(?!\w)', _acr.get('ref') or 'CELL=-') is not None
