        self.combo_targets = {r.get('target') or '' for r in rdcsv(os.path.join(sd, 'combo_src.csv'))} - {''}  # T271
        # 팝업 클래스 문장에만 나오고 이 화면 TO-BE 시트에도 없는 컬럼 = 팝업 내부 그리드 컬럼(메인 그리드에서 찾으면 오판)
        by_cls = collections.defaultdict(set)
        for rs in acts.values():
            for r in rs:
                for m in re.finditer(r'Def[A-Z]\w*\.([A-Z0-9_]+)(?![A-Za-z0-9_…])', r['raw'] + ' ' + r['value']): by_cls[r['class']].add(m.group(1))
        main_cols = by_cls.get(self.main_cls, set()) | set(self.tobe) | {c for c in self.cols if self.cols.get(c)}
        self.popup_cols = {c for cls, cs in by_cls.items() if cls != self.main_cls for c in cs} - main_cols
        # 팝업을 여는 셀(트리거) = POPUP 문장이 있는 메서드의 guard 'e.Column == …DefColumns.X' — G5·H6 는 이 컬럼에만 붙는다(인자 컬럼 전체에 붙이던 과대귀속 수정)
        self.trigger_cols = set()
        for (cls, meth), rs in acts.items():
            if cls != self.main_cls or not any(r['kind'] == 'POPUP' for r in rs): continue
            for r in rs:
                for m in re.finditer(r'e\.Column\s*==\s*\w+\.GetColumnIndex\(\s*Def[A-Z]\w*\.([A-Z0-9_]+)(?![A-Za-z0-9_…])', r['guard'] + ' ' + r['raw']): self.trigger_cols.add(m.group(1))
        # 2026-11-25 T573(SCP0005 H6·G5 T-7eacee67·T-e425f595·T-3beee65f·T-a391f109): trigger_cols 는 팝업 메서드 모든 문장의 guard 에서 칸을 모아,
        #   바깥 조건(cs:1112~1116 FROM_CITY·FROM_COUNTRY·TO_CITY·TO_COUNTRY)에 없는 안쪽 조건 칸(FROM_CITY_NAME·TO_CITY_NAME, cs:1123·1127 — 도달 불가)까지 '팝업을 여는 칸'으로 셌다.
        #   팝업 사실(E02 facts · facts_popup.py T568 = 호출 줄을 감싼 가장 안쪽 e.Column 조건, 잘린 조건은 원문 재독)의 CELL 트리거 칸을 정본으로 쓴다. 사실 파일이 없으면 None(종전 동작)
        self.popup_open_cols, self.popup_open_ref = None, ''
        try:
            _fj = json.load(open(os.path.join(DOC, 'verify', '_parallel', 'E02', 'facts', f'{asis}.json'), encoding='utf-8'))
            _cc = [c_ for c_ in (_fj.get('calls') or []) if c_ and (c_.get('trigger') or {}).get('kind') == 'CELL' and re.sub(r'\.cs$', '', (c_.get('asis_ref') or '').split(':')[0]) == self.main_cls]
            if _cc:
                self.popup_open_cols = {c_['trigger'].get('column') for c_ in _cc if c_['trigger'].get('column')}
                self.popup_open_ref = ' · '.join(sorted({c_.get('asis_ref') or '' for c_ in _cc}))[:120]
        except (OSError, ValueError):
            pass
        # 2026-11-20 T403(SSP0014 T-a5fcd2ff H6 · T-049a5854 M4): 팝업을 여는 메서드 안에서 값만 읽혀 팝업 인자로 넘어가는 조회조건(clbFromSite.ControlValues → Form_Load 인자)은
        #   팝업을 열지도, 팝업 선택값을 받지도 않는다 → H6(팝업 표준)·M4(선택값 반영) 대상이 아니다. 그 팝업을 여는 컨트롤(이벤트 등록 대상)로 대상을 옮긴다. G5(인자)는 그대로
        self.popup_arg_only = {}
        _ev_h = collections.defaultdict(set)
        for ev in rdcsv(os.path.join(sd, 'events.csv')):
            if (ev.get('op') or '+=') == '+=' and ev.get('handler'): _ev_h[(ev.get('handler') or '').strip()].add((ev.get('target') or '').replace('this.', '').split('.')[0])
        for (cls, meth), rs in acts.items():
            if not any(r['kind'] == 'POPUP' for r in rs): continue
            trig = {t for t in _ev_h.get(meth, set()) if t}
            recv = {(r.get('target') or '').replace('this.', '').split('.')[0] for r in rs if r['kind'] == 'VALUE_SET'}
            refs = {m.group(0) for r in rs for m in RX_COND.finditer(r.get('raw') or '') if m.group(0) in self.conds}
            for cnd in refs - trig - recv:
                if trig: self.popup_arg_only.setdefault(cnd, set()).update(trig)
        for (cls, meth), rs in acts.items():  # 다른 팝업 메서드에서 트리거·수신 컨트롤이면 인자 전용 아님
            if not any(r['kind'] == 'POPUP' for r in rs): continue
            for t in _ev_h.get(meth, set()) | {(r.get('target') or '').replace('this.', '').split('.')[0] for r in rs if r['kind'] == 'VALUE_SET'}: self.popup_arg_only.pop(t, None)
        # 2026-11-20 T480: 요소의 팝업 연결 판단 재료(AS-IS 메인 클래스 문장, 현행 이벤트, 컨트롤 선언, 정적 팝업 인자 대조 AS-IS 행)
        self.acts = acts
        self.events_cur = [ev for ev in rdcsv(os.path.join(sd, 'events.csv')) if is_cur(ev)]
        self.ctl_decl = collections.defaultdict(list)
        for r in rdcsv(os.path.join(sd, 'controls.csv')):
            if is_cur(r): self.ctl_decl[r.get('name', '')].append(r)
        self.prop_get = {}   # 메인 클래스 속성 getter 원문(팝업 인자가 속성을 거쳐 컨트롤 값을 읽는 경우)
        try:
            for f in sorted(main_files(sd) or []):
                p = next((q for q in (os.path.join(ROOT, 'GSCM', f), os.path.join(ROOT, 'GSCM_20260512', f)) if os.path.isfile(q)), '')
                if p.lower().endswith('.cs') and not p.lower().endswith('.designer.cs'):
                    src = open(p, encoding='utf-8-sig', errors='ignore').read()
                    for m in re.finditer(r'\b(\w+)\s*\{\s*get\s*\{(.{0,600}?)\}\s*(?:set\b|\})', src, re.S): self.prop_get.setdefault(m.group(1), m.group(2))
        except Exception:
            self.prop_get = {}
        self.popup_args_asis = [r for r in rdcsv(os.path.join(DOC, 'verify', MENU, 'popup_args.csv')) if r.get('side') == 'ASIS']
        # 콤보 SQL ID(plan.json comboId) → 조회조건 컨트롤 — FE 대조표 행이 SQL_ID 만 적은 경우 조건 요소로 잇는다
        self.combo_of = {}
        if os.path.exists(pf):
            for f in json.load(open(pf, encoding='utf-8')).get('fields', []):
                if f.get('comboId') and f.get('asis'): self.combo_of[f['comboId']] = f['asis']
        # 호출 그래프(CALL_LOCAL) — 진입점이 간접 호출하는 SP 까지 잇는다(FindButton → FindData_Main → SP)
        self.callees = collections.defaultdict(set)
        for (cls, meth), rs in acts.items():
            for r in rs:
                if r['kind'] == 'CALL_LOCAL': self.callees[f'{cls}.{meth}'].add(f"{cls}.{r['target']}")
        # 조건 컨트롤 이벤트 핸들러 → 조건 컨트롤(events.csv) — 핸들러 본문의 GRID_CLEAR 문장(ClearDataSource 등)에는 컨트롤 이름이 없어 C4 요소를 못 찾던 결함(2026-10-30 SCP0111 Plan Date 그리드 초기화 미검출)
        #   CALL_LOCAL 피호출 메서드(SetChangedPeriod 등)도 같은 조건 컨트롤에 귀속
        self.handler_cond = {}
        for ev in rdcsv(os.path.join(sd, 'events.csv')):
            tgt = (ev.get('target') or '').replace('this.', '').split('.')[0]; h = (ev.get('handler') or '').strip()
            if h and tgt in self.conds and (ev.get('op') or '+=') == '+=': self.handler_cond.setdefault(h, tgt)
        for (cls, meth), rs in acts.items():
            if meth in self.handler_cond:
                for r in rs:
                    if r['kind'] == 'CALL_LOCAL': self.handler_cond.setdefault(r['target'], self.handler_cond[meth])

    def of(self, text):
        out = []
        for m in RX_COND.finditer(text):
            n = m.group(0)
            if n in self.conds or (not NOT_COND.match(n) and n in self.lab): out.append(('COND', n))
        for cid, ctl in self.combo_of.items():
            if re.search(r'(?<![A-Za-z0-9_])' + re.escape(cid) + r'(?![A-Za-z0-9_])', text): out.append(('COND', ctl))
        for m in RX_BTN.finditer(text):
            b = m.group(0).split('_')[0]  # btnFromSrch_Click(메서드) → btnFromSrch(컨트롤)
            if b not in ('btnButtonList',): out.append(('BTN', b))
        for c in self.cols:
            if re.search(r'(?<![A-Za-z0-9_])' + re.escape(c) + r'(?![A-Za-z0-9_])', text): out.append(('COL', c))
        for k, v in getattr(self, 'col_alias', {}).items():  # T359: 상수 이름으로 적힌 칸 → 실제 칸 이름
            if re.search(r'(?<![A-Za-z0-9_])' + re.escape(k) + r'(?![A-Za-z0-9_])', text): out.append(('COL', v))
        for p in self.popups:
            if p in text: out.append(('POPUP', p))
        for m in RX_MSG.finditer(text): out.append(('MSG', m.group(0)))
        return list(dict.fromkeys(out))

    def popup_link(self, check, et, name):
        """T480: popup_linkage 를 이 화면 사실로 부른다"""
        return popup_linkage(check, et, name, self.acts, self.main_cls, self.events_cur, self.ctl_decl, self.popup_args_asis, self.trigger_cols, self.prop_get)

    def aliases(self, et, n):
        if et == 'COND': return [n] + self.lab.get(n, [])
        if et in ('COL', 'PCOL'): return [n] + ([self.cols[n]] if self.cols.get(n) else [])
        return [n]


