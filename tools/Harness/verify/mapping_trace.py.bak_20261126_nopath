RX_ECOL = re.compile(r'e\.Column\s*==\s*\w+\.GetColumnIndex\(\s*Def[A-Z]\w*\.([A-Z0-9_]+)(?![A-Za-z0-9_…])')
RX_ICOL = re.compile(r'\b\w+\s*==\s*\w+\.GetColumnIndex\(\s*Def[A-Z]\w*\.([A-Z0-9_]+)(?![A-Za-z0-9_…])')


def cascade_src(r, rmap, depth=0):
    """연쇄 문장의 원천 컬럼 — ① guard 체인 가장 안쪽 'e.Column == …DefColumns.X'('else of' 제외) ② 'i == GetColumnIndex(X)' ③ guard 의 str 변수를 같은 메서드에서 GetText/GetValue(X) 로 세팅
       ④ 이 메서드를 CALL_LOCAL 로 부르는 호출자의 guard(SetCityCode 처럼 핸들러에서 호출되는 보조 메서드) — _verify.spec resolveSrc 와 같은 규칙"""
    segs = [s.strip() for s in (r.get('guard') or '').split('▸')]
    inner = [s for s in segs if 'e.Column' in s and not s.startswith('else of')]
    m = RX_ECOL.search(inner[-1]) if inner else None
    if m: return m.group(1)
    m = RX_ICOL.search(' '.join(s for s in segs if not s.startswith('else of')))
    if m: return m.group(1)
    same = [x for x in rmap.values() if x.get('src') == 'AS-IS 액션' and x.get('kind') != 'ENTRY' and x.get('cls') == r.get('cls') and x.get('meth') == r.get('meth')]
    for v in set(re.findall(r'\bstr[A-Z_][A-Za-z0-9_]*\b', r.get('guard') or '')):
        for x in same:
            if re.match(r'^' + re.escape(v) + r'\s*=', x.get('raw', '')) and re.search(r'Def[A-Z]\w*\.', x.get('raw', '')):  # 2026-11-17: DefColumns 고정 → Def* 클래스 전부(SCP0111 DefMain)
                m = re.search(r'Def[A-Z]\w*\.([A-Z0-9_]+)(?![A-Za-z0-9_…])', x['raw'])
                if m: return m.group(1)
    if depth < 2:
        callers = [x for x in rmap.values() if x.get('src') == 'AS-IS 액션' and x.get('kind') == 'CALL_LOCAL' and x.get('cls') == r.get('cls') and re.match(r'^' + re.escape(r.get('meth', '')) + r'\s*\(', x.get('raw', ''))]
        for x in callers:
            s = cascade_src(x, rmap, depth + 1)
            if s: return s
    return ''


def combo_applicable(et, name, cell_type, combo_targets, grid_cols=None):
    """콤보 검사(B1·B2·B3·B4)가 이 대상에 해당하는가 → (True|False|None, 근거). None = 사실 부족(판정 안 함). T271
    cell_type = cell_rules.csv 의 그 컬럼 셀 유형('' = 사실 없음) · combo_targets = combo_src.csv 의 target 집합"""
    nm = (name or '').split(' / ')[0].strip()
    if nm in combo_targets:
        return True, 'combo_src.csv 에 AS-IS 콤보 원천 있음'
    if et in ('COL', 'PCOL'):
        ct = (cell_type or '').upper()
        # 2026-11-18 미검증 해소(SCP0096 COLUMN_NAME·DAY_CODE B3·B4 '실행 경로 없음'): AS-IS 그리드 컬럼(grid_effective)도 셀 규칙도 콤보 원천도 없는 이름 = 데이터 테이블 컬럼(GetDayOfWeek 의 dt.Select 등) — 콤보 아님
        if not ct and grid_cols and nm not in grid_cols and not re.match(r'^(<DYNAMIC|[A-Z]{1,2}_?[0-9]{6,8}$)', nm):  # 사실 파일이 비었거나 동적 칸이면 판정 안 함
            return False, f"AS-IS 그리드 컬럼 아님(grid_effective.csv {len(grid_cols)}개·cell_rules.csv 에 없음) · combo_src.csv 에 콤보 원천 없음 — 데이터 테이블 컬럼"
        if not ct:
            return None, ''
        if 'COMBO' in ct:
            return True, f'cell_rules.csv 셀 유형 {cell_type}'
        return False, f"AS-IS 셀 유형 {cell_type}(cell_rules.csv) · combo_src.csv 에 콤보 원천 없음"
    if et == 'COND':
        if re.match(r'(drp|dtp|dte|chk|txt|rdo|rb|lbl|btn|spn|num)[A-Z_]', nm):
            return False, f"AS-IS 조회조건 컨트롤 {nm} = 콤보류 아님(이름 접두) · combo_src.csv 에 콤보 원천 없음"
        return None, ''
    return None, ''


