    def lmatch(x, d):
        if x['rule_id'] != d['check']: return False
        et = d['et']
        if et == 'SCREEN': return x['source'] in ('RULE_SCREEN', 'CONFIRMED', 'DEFECT', 'GENERAL') or x.get('area') == '화면'
        if et == 'COND':
            if x['source'] != 'SEARCH': return False
            t = norm(re.sub(r'^조회조건\s*', '', x['target']))
            return any(norm(al) == t for al in E.aliases('COND', d['name']))
        if et == 'COL':
            if x['source'] == 'COLUMN': return bool(re.match(r'^[^.]+\.' + re.escape(d['name']) + r'\b', x['target']))
            return x['source'] == 'ASIS' and bool(re.search(r'(?<![A-Z0-9_])' + re.escape(d['name']) + r'(?![A-Z0-9_])', f"{x['target']} {x['condition']}"))
        if et == 'SP': return x['source'] == 'SP' and tail(x['target']) == tail(d['name'])
        if et == 'ENTRY': return x['source'] == 'ASIS' and x.get('asis_ref', '').rstrip().endswith(d['name'].split('.', 1)[-1]) and d['name'].split('.')[0] in x.get('asis_ref', '')
        if et in ('BTN', 'POPUP', 'MSG'): return x['source'] == 'ASIS' and d['name'] in f"{x['target']} {x['condition']} {x['asis_ref']}"
        return False

    # 2026-11-20 T495(SCP0028 M4 T-ba663c76·T-c5782dcb · H6 T-a239a7e1 '검증 엔진이 실행됐으나 판정하지 못함'): 팝업 전용 검사기(eg_popup)가 원장에 남긴 실측
    #   ('<ID> 팝업 <팝업 클래스> COND:<라벨>|BTN:<글자> <항목>')을 추적 요소에 잇지 않았다. 조회조건 = 라벨 별칭 일치 · 버튼 = AS-IS 클릭 처리 메서드가 'new <팝업>(' 으로 여는 팝업 클래스 일치
