        # Designer 연결은 events.csv 에 'this.컨트롤' 로 있다 — 이걸 안 보면 핸들러·하위 조건이 전부 비어 C1 이 재요청 여부만 판정했다(2026-11-02 DMF0005 EG084)
        hs |= {e['handler'] for e in rdcsv(os.path.join(DOC, 'asisfacts', 'screens', asis_id(), 'events.csv')) if re.sub(r'^this\.', '', e.get('target') or '') == d['name'] and e.get('handler') and is_cur(e)}
        body = [x for x in acts if x['method'] in hs]
        calls = {x['target'] for x in body if x['kind'] == 'CALL_LOCAL'}
        body += [x for x in acts if x['method'] in calls]
        j['handlers'] = sorted(hs)
        seen = {m.group(0) for x in body for m in RX_COND.finditer(f"{x['target']} {x['value']}") if m.group(0) != d['name'] and not NOT_COND.match(m.group(0)) and m.group(0) in E.conds}  # 화면 조건 컨트롤만(dtFromSite 같은 DataTable 변수 제외)
        j['children'] = sorted(c2 for c2 in seen if any(cond_written(x, c2) for x in body))  # 값·후보를 바꾸는 컨트롤만 — 읽기만 한 컨트롤(상위 입력)은 parents
        j['parents'] = sorted(seen - set(j['children']))
        # 하위 후보 재구성 경로: 핸들러 체인에 DB 호출(ENDPOINT)이 없으면 메모리 필터(DBUtils.Filter·Select) — TO-BE 도 클라이언트 필터면 콤보 재요청 0건이 정상(2026-10-29 SCP0020)
        j['rebindVia'] = 'db' if any(x['kind'] == 'ENDPOINT' for x in body) else 'memory'
        j['childLabels'] = {c: list(dict.fromkeys(E.aliases('COND', c)))[:6] for c in j['children']}  # 하위 조건의 화면 라벨 후보(검증 엔진이 칸을 찾는다)
        j['clear'] = [f"{x['method']}:{x['line']} {x['raw'][:80]}" for x in body if x['kind'] == 'GRID_CLEAR' or re.search(r'RowCount\s*=\s*0|DataSource\s*=\s*null|\.Clear\(|ClearSheet|ClearSpread|ClearDataSource|RemoveRows\(|Rows\.Clear|InitSpread', x['raw'])]
        # 초기화 뒤 같은 핸들러 체인이 즉시 재조회(FindData·SearchButton·Search*·Retrieve*)하면 기대는 '초기화 후 즉시 재조회' — TO-BE 자동 재조회가 정상(2026-10-30 SCP0100 CboBucketType: SetGridClear(); … FindData())
        j['requery'] = [f"{x['method']}:{x['line']} {x['target']}" for x in body if x['kind'] in ('CALL_LOCAL', 'CALL_BASE') and re.match(r'^(FindData|SearchButton|Search\w*|Retrieve\w*|Inquiry\w*|GetData\w*|LoadData\w*)$', x['target'] or '')]
    elif c == 'D6':
        acts = rdcsv(os.path.join(DOC, 'asisfacts', 'screens', asis_id(), 'actions.csv'))
        ins = [x for x in acts if x['method'] == 'InsertButton' and re.search(r'\.Insert\(|AddRows?\(|AddNew', x['raw'])]
        j['insert'] = [f"{x['line']} {x['raw'][:80]}" for x in ins]
    elif c == 'K4':
        acts = rdcsv(os.path.join(DOC, 'asisfacts', 'screens', asis_id(), 'actions.csv'))
        main = collections.Counter(x['class'] for x in acts).most_common(1)[0][0] if acts else ''
        ms = {x['method'] for x in acts if x['class'] == main}
        excl = [r for r in rmap.values() if r.get('src') == 'FE 대조표' and re.match(r'^(제외|해당없음)', r.get('status', ''))]
        j['excluded'] = sorted({b for b, m in (('Edit', 'EditButton'), ('Insert', 'InsertButton'), ('Delete', 'DeleteButton'), ('Save', 'SaveButton'), ('Search', 'FindButton')) if any(m in r['text'] for r in excl)} | {'Edit'})  # 대조표가 제외로 결정한 버튼 + Edit(CR-093: TO-BE 는 편집 모드 버튼 없이 셀 직접 편집 — 사용자 결정 2026-10-30)
        j['buttons'] = [b for b, m in (('Search', 'FindButton'), ('Insert', 'InsertButton'), ('Delete', 'DeleteButton'), ('Save', 'SaveButton'), ('Edit', 'EditButton'), ('Excel', 'ExcelButton'), ('Print', 'PrintButton')) if m in ms]
        j['custom'] = sorted({m.group(1) for x in acts if 'ButtonList' in x['method'] for m in re.finditer(r'"([A-Za-z][A-Za-z ]{1,30})"', x['raw'])})
    if 'editExpect' in j: j['editExpect'] = {k: (v[:400] if isinstance(v, str) else v) for k, v in j['editExpect'].items()}
    s = json.dumps(j, ensure_ascii=False)
    # 원장 셀 상한 3000자 — 문자열을 자르면 JSON 이 깨지므로(2026-10-26 실측) 덜 중요한 키부터 줄이거나 뺀다
    # 2026-11-20 T520(SCP0028 A5 T-fc9d26c9): ENTRY 행 asisVisible(컬럼 18 × Division 14)이 아래 ('asisVisible', 4) 단계에서 앞 4컬럼만 남아
    #   TO_SITE·TRANS_MODE_CODE(메타 VISIBLE_FLAG N) 숨김 정보가 빠지고 _trace.spec A5 가 표시 컬럼으로 셈(AS-IS 17 ↔ TO-BE 15 허위 차이).
    #   → 자르기 전에 손실 없이 줄인다: 전 Division 값이 같은 컬럼은 문자열 하나로(소비자 _trace.spec visOf 가 문자열·dict 둘 다 읽음).
    #   그래도 길어 잘리면 asisVisCut=True 를 남겨 소비자가 잘린 정보로 판정하지 않게 한다(측정 경로 없음 ERROR)
    if isinstance(j.get('asisVisible'), dict) and len(s) > 3000:
        _av = j['asisVisible']
        if all(isinstance(v, dict) for v in _av.values()):
            j['asisVisible'] = {col: (next(iter(set(v.values()))) if len(set(v.values())) == 1 else v) if isinstance(v, dict) and v else v for col, v in _av.items()}
        s = json.dumps(j, ensure_ascii=False)
    _av_n = len(j['asisVisible']) if isinstance(j.get('asisVisible'), dict) else -1
    for step in (('raws', 2), ('asisVisible', 4), ('siteSamples', 2), ('e4', 3), ('d3', 3), ('m4', 2), ('widths', None), ('metaWidth', None), ('d4expr', 0), ('raws', 0), ('editExpect', None), ('asisVisible', None), ('childLabels', None), ('tobeMeta', None), ('siteSamples', None), ('e4', None), ('d3', None), ('m4', None), ('src', None), ('labels', 3)):
        if len(s) <= 3000: break
        k, n = step
        if k not in j: continue
        if n is None: j.pop(k)
        elif isinstance(j[k], list): j[k] = j[k][:n]
        elif isinstance(j[k], dict): j[k] = {kk: j[k][kk] for kk in list(j[k])[:n]}
        s = json.dumps(j, ensure_ascii=False)
    if _av_n >= 0 and j.get('et') == 'ENTRY' and (not isinstance(j.get('asisVisible'), dict) or len(j['asisVisible']) < _av_n):
        j['asisVisCut'] = True; s = json.dumps(j, ensure_ascii=False)  # T520 — 잘린 숨김 정보로 A5 를 판정하지 않는다
    if len(s) > 3000: s = json.dumps({**{'et': j.get('et'), 'name': j.get('name'), 'labels': j.get('labels', [])[:3], 'truncated': True}, **{k: j[k] for k in ('dead', 'popup', 'asisCombo', 'merge', 'viaPopup', 'popMap', 'd5Src', 'd5', 'noAssign', 'selfAssign', 'valueOnly', 'clearOnly', 'allFlag', 'ctlType', 'asisLabel', 'asisVisCut') if k in j}}, ensure_ascii=False)  # 작은 판정 키는 폴백에도 남긴다(2026-10-27 VMI_YN asisCombo 누락)
    return s


def to_ledger(inst, od, rmap):
    """원장 연결 행이 없는 인스턴스 → 원장 source=TRACE 행(rule_id=검사 ID). 재실행 시 교체하되 E2E·수동 판정은 보존"""
    p = os.path.join(od, 'verify_ledger.csv')
    if not os.path.exists(p):
        print(f'[INFO] 원장 없음({p}) — 편입 생략(run_verify 의 ledger 단계 후 실행)'); return
    with open(p, encoding='utf-8-sig') as fp:
        rd = csv.DictReader(fp); cols = rd.fieldnames; old = list(rd)
    prev = {r['row_id']: r for r in old if r.get('source') == 'TRACE'}
    keep = [r for r in old if r.get('source') not in ('MAPPING', 'TRACE')]
    add = []
    for d in inst.values():
        # linked = 요소 실측(RULE_SCREEN·SEARCH·COLUMN·ASIS·SP·MSG 원장 행)만 — GENERAL/DEFECT/CONFIRMED 행은 소비자(상속)라 연결로 치지 않는다
        #   (2026-10-30 T14: judge 가 GENERAL K4 를 판정한 뒤 2차 --to-ledger 가 'linked' 로 보고 측정된 TRACE K4 FAIL 행을 버리던 되먹임)
        linked = d['et'] == 'LEDGER' or any(h[1].startswith('원장 ') and not re.search(r'\b(GENERAL|DEFECT|CONFIRMED)\b', h[1]) for h in d['hits'])
        rid0 = trace_id(d['key']); pr0 = prev.get(rid0, {})
        measured_now = bool(pr0) and pr0.get('result') in ('PASS', 'FAIL', 'NA', 'ERROR', '판정필요') and re.match(r'^(E2E|수동(?! 사용자판정))', pr0.get('tobe_ref', '')) and not re.match(r'^(실측\[T-[0-9a-f]+\]: )?(검증엔진|선행 대조표 |행 집계|진입점 집계|대조표 상태 미구현|선행 미구현에 종속)', pr0.get('evidence') or '')
        # 원장에 그 검사 행이 이미 있으면 건너뛴다 — 단 검증 엔진(@trace) 구현 검사인데 원장 행이 전부 미실행이면 엔진이 실행하도록 TRACE 행을 만든다(SEARCH C1 Div 등)
        # A6 는 정적 대조(원장 SP 행)와 E2E 실측(TRACE 행)이 별개 증거 — 둘 다 남긴다 · 이번 실행에 실측된 TRACE 행은 어떤 경우에도 버리지 않는다(T14)
        if linked and d['check'] != 'A6' and not measured_now and not (d['check'] in ENGINE_CHECKS and all(h[0] == 'NOT_RUN' for h in d['hits'] if h[1].startswith('원장 '))): continue
        df = DEFS.get(d['check'], {}); fam = d['check'][0] if re.match(r'^[A-N]\d', d['check']) else FAM.get(df.get('layer', 'GEN'), 'G')
        rid = trace_id(d['key']); pr = prev.get(rid, {})
        res = d['static'][0] if d['static'] else ('NOT_RUN' if d['result'] in ('NOT_RUN', 'NOPATH', 'TODO', 'BLOCKED') else d['result'])
        if d['result'] == 'BLOCKED': res = 'FAIL'  # 선행 미구현(W1) 에 종속 — 사용자 지시(2026-10-26): 미구현 = FAIL, 종속 검사도 FAIL(구현 후 자동 재검증, W8)
        res = {'REVIEW': '판정필요', 'WARN': '판정필요'}.get(res, res)
        ev = d['static'][1] if d['static'] else d['why']
        tobe = ''
        pev = pr.get('evidence') or ''
        # 2026-11-17: '수동 사용자판정' 은 judge 가 매 실행 다시 얹는다 — 이전 행을 실측으로 보존하면 검사기 원판정이 갱신되지 않는다(SCP0104 UC-02 회귀 보고 원판정 FAIL 고착)
        measured = pr.get('result') not in (None, '', 'NOT_RUN') and re.match(r'^(E2E|수동(?! 사용자판정))', pr.get('tobe_ref', '')) and not re.match(r'^(실측\[T-[0-9a-f]+\]: )?(검증엔진|선행 대조표 |행 집계|진입점 집계|대조표 상태 미구현|선행 미구현에 종속)', pev) and not (pr.get('tobe_ref', '').startswith('수동') and not pev.startswith('[사용자판정]')) \
            and pr.get('tobe_ref', '') != '수동 사용자판정(CheckList)'  # 파생 증거·해제된 사용자판정은 보존 대상 아님(2026-10-27) · CheckList 사용자판정은 judge 가 매번 다시 반입 — 여기서 보존하면 검사기 자신의 판정(원판정)이 다시 계산되지 않아 회귀 오라클이 무력화됨(2026-10-30 T12)
        cond_now = CLEAN(engine_condition(d, rmap)); cond_prev = pr.get('condition') or ''
        if measured and cond_prev and cond_prev != cond_now and not (pr.get('tobe_ref', '').startswith('수동')) and not d.get('dead'):  # dead = 정적 결론(검사 대상 아님)이 우선 — 재측정 대상이 아니다(2026-10-30)
            # 2026-10-29(재발 방지): 검사 조건(배선·라벨·대상)이 바뀌었으면 옛 E2E 판정은 그 조건의 것 — 보존하지 않고 재측정 대상으로(미실행). 옛 FAIL 이 조치 필요에 남던 원인
            measured = False; ev = f"[재측정 필요] 검사 조건 변경(이전 판정 {pr.get('result')} 보류: {(pr.get('evidence') or '')[:160]})"; res = 'NOT_RUN'
        if measured and (not d['static'] or d['check'] == 'X-NOTIMPL'):
            res, ev, tobe = pr['result'], pr.get('evidence', ''), pr['tobe_ref']  # 검증 엔진·사람 판정 보존 — X-NOTIMPL(대조표 미구현) 도 W9 실측이 있으면 실측이 정답(2026-10-27 사용자: 확인 없이 FAIL 처리하면 보완 불가)
            if d['check'] == 'X-NOTIMPL':
                rr = rmap.get(d['name'], {}); ev = (f"[대조표 {d['name']} '{(rr.get('label') or '')[:70]}' 상태 '미구현' — 실측으로 판정] " + ev)[:1400]
                if res == 'PASS': ev = (ev + ' ⇒ 대조표 상태가 실측과 다름(이미 구현됨) — 대조표 상태 갱신 대상')[:1500]
        elif d['result'] == 'BLOCKED':
            # 선행 미구현 종속 행 — 그 미구현 행의 W9 실측이 있으면 실측 결과를 상속(실측 PASS 면 종속 검사도 막히지 않음 → 다음 실행에서 정상 실행되게 NOT_RUN)
            srcs = [(rid, prev.get(trace_id(f'X-NOTIMPL|ROW:{rid}'), {})) for rid in d['rows'] if rid in rmap]
            srcs = [(rid, q) for rid, q in srcs if q.get('result') in ('PASS', 'FAIL', 'NA') and re.match(r'^(E2E|수동)', q.get('tobe_ref', ''))]
            if srcs:
                rid0, q0 = srcs[0]; res = 'NOT_RUN' if q0['result'] == 'PASS' else q0['result']
                ev = (f"선행 대조표 {rid0} '{(rmap[rid0].get('label') or '')[:60]}' 실측 결과 상속({q0['result']}): {q0.get('evidence', '')[:700]}")[:1500]; tobe = q0.get('tobe_ref', '')
        add.append({**{c: '' for c in cols}, 'row_id': rid, 'source': 'TRACE', 'family': fam, 'rule_id': d['check'], 'axis': AXIS.get(fam, ''), 'area': '대조표',
                    'target': CLEAN(f"{d['display'][:80]}" if d['et'] != 'ROW' else f"{d['name']} · {(rmap.get(d['name'], {}).get('label') or rmap.get(d['name'], {}).get('section', ''))[:70]}"),
                    'condition': CLEAN(engine_condition(d, rmap)), 'oracle': 'O1', 'expected': CLEAN(f"{df.get('how', '')} — 대조표 {len(d['rows'])}행" + (f" · 요지: {rmap[d['name']].get('label', '')[:120]}" + (f" · 사유: {rmap[d['name']].get('why', '')[:160]}" if rmap[d['name']].get('why') else '') if d['et'] == 'ROW' and d['name'] in rmap else '')),
                    'asis_ref': CLEAN(d.get('asis_ref') or ' '.join(dict.fromkeys(d['cs']))[:200] or ' '.join(d['rows'][:3])[:200]), 'method': df.get('method', 'E2E'),  # T480 asis_ref
                    'result': res, 'evidence': CLEAN(ev[:900]), 'tobe_ref': tobe or ('STATIC mapping_trace' if d['static'] else ''),
                    'note': f"impl={df.get('impl', '?')} · {df.get('checker', '')[:60]} · key={d['key'][:80]}"})
    with open(p, 'w', encoding='utf-8-sig', newline='') as fp:
        w = csv.DictWriter(fp, fieldnames=cols); w.writeheader(); [w.writerow(r) for r in keep + add]
    c = collections.Counter(r['rule_id'] for r in add)
    print(f'원장 편입: TRACE {len(add)}행(원장 연결 없던 검사 인스턴스) — ' + ' '.join(f'{k}:{v}' for k, v in c.most_common(12)) + f' → {p}')


def summarize(out, inst, od, asis, page, mpath, n_fe, n_act):
    cnt = collections.Counter(x['verdict'] for x in out)
    by_check = collections.defaultdict(collections.Counter); by_layer = collections.defaultdict(collections.Counter)
    for d in inst.values():
        by_check[d['check']][d['result']] += 1; by_layer[LNAME.get(d['layer'], d['layer'])][d['result']] += 1
    reasons = collections.Counter()
    for x in out:
        if x['verdict'] == '미검증':
            for kv in x['checks'].split(' '):
                v = kv.split('=', 1)[-1]
                if v and v not in ('PASS', 'NA'): reasons[v] += 1
    todo = {k: sum(c.values()) for k, c in by_check.items() if c.get('TODO')}
    summ = {'version': 2, 'menu_id': MENU, 'asis_id': asis, 'generated': datetime.datetime.now().isoformat(timespec='seconds'), 'mapping_file': os.path.relpath(mpath, ROOT) if mpath else '',
            'rows': len(out), 'fe_rows': n_fe, 'action_rows': n_act, 'fe_page': os.path.relpath(page, ROOT) if page else '', 'fe_mapping_missing': bool(page) and not mpath,
            'verdict': dict(cnt), 'instances': len(inst), 'instance_result': dict(collections.Counter(d['result'] for d in inst.values())),
            'by_layer': {k: dict(v) for k, v in by_layer.items()}, 'by_check': {k: dict(v) for k, v in sorted(by_check.items())}, 'todo_checks': todo, 'unverified_reasons': dict(reasons)}
    json.dump(summ, open(os.path.join(od, 'mapping_trace_summary.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
    ST = ['PASS', 'FAIL', 'WARN', 'REVIEW', 'ERROR', 'NA', 'NOT_RUN', 'NOPATH', 'TODO', 'BLOCKED']
    L = [f'# 대조표 ↔ 검증 추적표 v2 — {MENU} (AS-IS {asis}) · {summ["generated"]}', '',
         '> 대조표의 **모든 행이 검증 대상**이다(제외·해당없음 행 = 사유 근거 검사 X-REASON). 행마다 카탈로그(`mapping_checks.csv`)가 정한 검사를 대상 단위 인스턴스로 묶어 판정한다.',
         '> **NOT_RUN** = 검사기 있음·이 대상 미실행 · **TODO** = 검사기 미구현(검증 엔진 구현 대상) · **BLOCKED** = 대조표 상태 미구현(구현 엔진 대상 — 구현 후 검증) · REVIEW = 판정필요', '',
         f"- 대상: FE 대조표 {n_fe}행{' (' + summ['mapping_file'] + ')' if mpath else ' (없음)'} · AS-IS 액션 {n_act}행(진입점 + 전 문장) = **{len(out)}행** → 검사 인스턴스 **{len(inst)}개**",
         '- 행 판정: ' + ' · '.join(f'{k} {v}' for k, v in cnt.most_common()),
         '- 인스턴스 결과: ' + ' · '.join(f'{k} {v}' for k, v in collections.Counter(d['result'] for d in inst.values()).most_common()), '',
         '## 검사별', '', '| 검사 | 층 | 검사기 | ' + ' | '.join(ST) + ' | 방법 |', '|---' * (len(ST) + 4) + '|']
    for k in sorted(by_check, key=lambda k: (LAYERS.index(DEFS.get(k, {}).get('layer', 'GEN')) if DEFS.get(k, {}).get('layer', 'GEN') in LAYERS else 99, k)):
        df = DEFS.get(k, {}); c = by_check[k]
        L.append(f"| {k} | {LNAME.get(df.get('layer', ''), '')} | {'있음' if df.get('impl') == 'Y' else '**미구현**'} | " + ' | '.join(str(c.get(s, 0)) for s in ST) + f" | {df.get('how', '')[:60]} |")
    L += ['', '## 층별', '', '| 층 | ' + ' | '.join(ST) + ' |', '|---' * (len(ST) + 1) + '|']
    for k in [LNAME[x] for x in LAYERS]:
        c = by_layer.get(k, {}); L.append(f'| {k} | ' + ' | '.join(str(c.get(s, 0)) for s in ST) + ' |')
    L += ['', '## FAIL 인스턴스', ''] + [f"- {d['key']} — {d['why'][:160]} (대조표 {len(d['rows'])}행)" for d in inst.values() if d['result'] == 'FAIL'][:300]
    L += ['', '## TODO — 검증 엔진 구현 대상(검사기 없음)', ''] + [f"- {k}: {v}개 — {DEFS.get(k, {}).get('how', '')}" for k, v in sorted(todo.items(), key=lambda x: -x[1])]
    L += ['', '## NOT_RUN — 검사기 있음·실행 필요(상위 200)', ''] + [f"- {d['key']} — {d['why'][:120]}" for d in inst.values() if d['result'] == 'NOT_RUN'][:200]
    open(os.path.join(od, 'mapping_trace.md'), 'w', encoding='utf-8').write('\n'.join(L) + '\n')
    print(f"{MENU}: 대조표 {len(out)}행(FE {n_fe} · 액션 {n_act}) → 인스턴스 {len(inst)} — 행 " + ' · '.join(f'{k} {v}' for k, v in cnt.most_common())
          + ' | 인스턴스 ' + ' · '.join(f'{k} {v}' for k, v in collections.Counter(d['result'] for d in inst.values()).most_common()) + f" → Doc/verify/{MENU}/mapping_trace.md")


