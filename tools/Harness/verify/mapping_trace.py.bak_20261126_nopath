# ── 행 → 검사 ID ──
# T558(2026-11-25 SCP0005 X-NOTIMPL 1행): 상태 '미구현(신설 금지)' = 만들지 않기로 한 행(제외). X-NOTIMPL(구현 대상 FAIL)로 보내면 W9 가 사유와 무관하게 FAIL 을 썼다 → X-REASON(사유 근거 검사)로
RX_EXCL_ST = re.compile(r'^(제외|해당없음|N/A|없음|미이식|이식 ?안 ?함|불필요|삭제|dead|미구현\s*\(\s*(?:신설|이식)\s*금지)', re.I)
RX_EXCL_SEC = re.compile(r'이식하지 않|미이식|데드코드|잔재|무발동|제외 목록')


def is_excl(r):
    """제외·해당없음 행 — 상태 값 또는 섹션 제목('⑦ 이식하지 않은 것' 등)으로 판정 → 사유 근거 검사(X-REASON)"""
    return bool(RX_EXCL_ST.match(r.get('status', '')) or (r.get('src') == 'FE 대조표' and RX_EXCL_SEC.search(r.get('section', '')) and not re.match(r'^(구현|완료|부분)', r.get('status', ''))))


def checks_for(r):
    if r['src'] == 'FE 대조표':
        st = r['status']
        if is_excl(r): return ['X-REASON'], ''
        cs = []
        for t in CHECKS:
            if t['scope'] == 'FE' and t['type'] != 'GENERIC' and t['rx'].search(f"{r['section']} {r['text']}"): cs += split(t['checks'])
        if not cs: cs = ['X-ROW']
        cs = list(dict.fromkeys(cs))
        if re.match(r'^미구현', st): return ['X-NOTIMPL'] + cs, 'BLOCKED'
        return ['X-LOC'] + cs, ''
    # AS-IS 액션
    ent = [t for t in CHECKS if t['scope'] == 'ACT' and t['type'] != 'A_GENERIC' and t['rx'].search(r['meth'])]
    cs = [c for t in ent for c in split(t['checks'])] or ['X-ROW']
    if r['popup']: cs += ['M3']
    if r['kind'] != 'ENTRY':
        cs += [c for t in CHECKS if t['scope'] == 'ACTKIND' and t['pattern'] == r['kind'] for c in split(t['checks'])]
    return list(dict.fromkeys(cs)), ''


