# -*- coding: utf-8 -*-
"""menu_auth_sync — 그룹별 메뉴·버튼 권한 AS-IS ↔ TO-BE 대조(읽기 전용 · 2026-11-18 SCP0111 V-d9598564 J4 GAPSELF-22 '측정 코드 없음')

  python tools/Harness/verify/menu_auth_sync.py <MENU_ID> [--asis <AS-IS ID>]   → Doc/verify/<ID>/menu_auth_sync.json
  python tools/Harness/verify/menu_auth_sync.py --selftest

원천
  AS-IS : dbo.TB_FX_GroupMenuAuth(MenuID = AS-IS 화면 ID · UseYN='Y') — 그룹 · BasicACLC/R/U/D · ExtendedACL
  TO-BE : SCM_ADM_USER_GR_MNU_MPG_M(USE_YN='Y') 그룹 · SCM_ADM_USER_GR_MNU_BTN_MPG_M 그룹×버튼(USE_YN='Y' = 허용)
버튼 짝(AS-IS 원문 GSCM/01.Framework/GSCM.Windows.Forms/UI/BaseForm.cs)
  OnClickFindButton = CanSelect(R) → SEARCH · OnClickInsertButton = CanInsert(C) → INSERT · OnClickEditButton = CanUpdate(U) → EDIT · OnClickDeleteButton = CanDelete(D) → DELETE
  OnClickSaveButton = CanSave — 정의가 Fox 어셈블리 안이라 원문 없음 → 그룹의 C·U·D 값이 모두 같을 때만 기대값을 정한다(OR·AND 어느 쪽이든 같은 값) · 다르면 미측정
  TO-BE 에만 있는 버튼(EXCEL·SAVEDETAIL 등)은 AS-IS ACL 대응이 없어 비교하지 않는다(참고 기록)
판정
  메뉴 그룹 집합이 다르면 FAIL(TO-BE 만·AS-IS 만 그룹) · 공통 그룹의 버튼 허용 값이 다르면 FAIL · 전부 같으면 PASS
  측정 못 한 칸(Save 기대 미정·TO-BE 버튼 정의 없음)이 있으면 PASS 대신 PARTIAL(판정은 ERROR 유지 · 증거에 남김)
  AS-IS 행 0 = AS-IS 권한표에 화면 없음 → ERROR(원천 없음 · 추정 금지)
"""
import datetime, json, os, sys

HERE = os.path.dirname(os.path.abspath(__file__)); ROOT = os.path.abspath(os.path.join(HERE, '..', '..', '..'))
BTN = (('R', 'SEARCH'), ('C', 'INSERT'), ('U', 'EDIT'), ('D', 'DELETE'))


def judge(asis, tobe_groups, tobe_btn, tobe_menu_btns):
    """asis = {그룹: {'C','R','U','D','X'(ExtendedACL)}: bool} · tobe_groups = 그룹 집합 · tobe_btn = {그룹: {버튼: 'Y'|'N'}} · tobe_menu_btns = 메뉴에 정의된 버튼 집합"""
    ga, gb = set(asis), set(tobe_groups)
    fails, gaps, notes = [], [], []
    if ga - gb:
        fails.append(f"AS-IS 만 메뉴 권한 그룹 {sorted(ga - gb)}")
    if gb - ga:
        fails.append(f"TO-BE 만 메뉴 권한 그룹 {sorted(gb - ga)}")
    for g in sorted(ga & gb):
        acl = asis[g]; have = tobe_btn.get(g, {})
        exp = [(f'{a}→{b}', b, bool(acl.get(a))) for a, b in BTN]
        cud = {bool(acl.get(k)) for k in ('C', 'U', 'D')}
        if len(cud) == 1 and not acl.get('X'):
            exp.append(('C·U·D→SAVE', 'SAVE', cud.pop()))
        else:
            gaps.append(f"{g} SAVE 기대 미정(C·U·D 값 다름 또는 ExtendedACL 있음 · CanSave 원문 없음)")
        for lab, b, want in exp:
            if b not in tobe_menu_btns:
                if want:
                    gaps.append(f"{g} {lab}: TO-BE 메뉴에 {b} 버튼 정의 없음")
                continue
            got = have.get(b) == 'Y'
            if got != want:
                fails.append(f"{g} {lab}: AS-IS {'허용' if want else '불가'} ↔ TO-BE {'허용' if got else '불가'}")
    extra = sorted(tobe_menu_btns - {b for _, b in BTN} - {'SAVE'})
    if extra:
        notes.append(f"TO-BE 전용 버튼 {extra}(AS-IS ACL 대응 없음 · 비교 제외)")
    res = 'FAIL' if fails else 'PARTIAL' if gaps else 'PASS'
    return res, fails, gaps, notes


def measure(mid, asis_id):
    sys.path.insert(0, os.path.join(ROOT, 'tools', 'DbConn'))
    from dbconn import connect
    with connect('asis') as ax:
        a = ax.cursor()
        a.execute("SELECT GroupID, BasicACLC, BasicACLR, BasicACLU, BasicACLD, ExtendedACL FROM dbo.TB_FX_GroupMenuAuth WHERE MenuID=? AND UseYN='Y'", (asis_id,))
        asis = {str(g): {'C': bool(c), 'R': bool(r), 'U': bool(u), 'D': bool(d), 'X': bool(x)} for g, c, r, u, d, x in a.fetchall()}
    with connect('tobe') as cx:
        c = cx.cursor()
        c.execute("SELECT USER_GR_ID FROM SCM_MGR.SCM_ADM_USER_GR_MNU_MPG_M WHERE MNU_ID=:m AND USE_YN='Y'", m=mid); groups = {r[0] for r in c.fetchall()}
        c.execute("SELECT USER_GR_ID, MNU_BTN_CD, MAX(USE_YN) FROM SCM_MGR.SCM_ADM_USER_GR_MNU_BTN_MPG_M WHERE MNU_ID=:m GROUP BY USER_GR_ID, MNU_BTN_CD", m=mid)
        btn = {}
        for g, b, u in c.fetchall():
            btn.setdefault(g, {})[b] = u
        c.execute("SELECT DISTINCT MNU_BTN_CD FROM SCM_MGR.SCM_ADM_MNU_BTN_MPG_M WHERE MNU_ID=:m", m=mid); mbtn = {r[0] for r in c.fetchall()}
    return asis, groups, btn, mbtn


def main(mid, asis_id):
    out = os.path.join(ROOT, 'Doc', 'verify', mid, 'menu_auth_sync.json')
    at = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    try:
        asis, groups, btn, mbtn = measure(mid, asis_id)
    except Exception as ex:  # 접속 실패 = 측정 못 함(ERROR) — 판정 근거 아님
        res = {'menu_id': mid, 'asis_id': asis_id, 'at': at, 'result': 'ERROR', 'why': f'DB 조회 실패 {str(ex)[:200]}'}
    else:
        if not asis:
            res = {'menu_id': mid, 'asis_id': asis_id, 'at': at, 'result': 'ERROR', 'why': f'AS-IS TB_FX_GroupMenuAuth 에 MenuID={asis_id} 행 없음(원천 없음)'}
        else:
            r, fails, gaps, notes = judge(asis, groups, btn, mbtn)
            res = {'menu_id': mid, 'asis_id': asis_id, 'at': at, 'result': r, 'fails': fails, 'gaps': gaps, 'notes': notes,
                   'asis_groups': {g: ''.join(k for k in 'CRUD' if v[k]) for g, v in sorted(asis.items())},
                   'tobe_groups': sorted(groups), 'tobe_buttons': {g: sorted(f"{b}{'' if u == 'Y' else '(N)'}" for b, u in v.items()) for g, v in sorted(btn.items())},
                   'why': (f"그룹 {len(asis)}↔{len(groups)} · " + ('; '.join(fails) if fails else '; '.join(gaps) if gaps else '메뉴 권한 그룹·버튼(R·C·U·D·SAVE) 일치'))[:900]}
    with open(out, 'w', encoding='utf-8') as f:
        json.dump(res, f, ensure_ascii=False, indent=1)
    print(f"[menu_auth_sync] {mid}(AS-IS {asis_id}): {res['result']} — {res['why'][:300]} → {os.path.relpath(out, ROOT)}")
    return 0


def selftest():
    full = {'C': True, 'R': True, 'U': True, 'D': True, 'X': False}; view = {'C': False, 'R': True, 'U': False, 'D': False, 'X': False}
    mb = {'SEARCH', 'INSERT', 'EDIT', 'DELETE', 'SAVE', 'EXCEL'}
    ok_btn = {'A': {'SEARCH': 'Y', 'INSERT': 'Y', 'EDIT': 'Y', 'DELETE': 'Y', 'SAVE': 'Y'}, 'V': {'SEARCH': 'Y', 'INSERT': 'N', 'DELETE': 'N', 'SAVE': 'N'}}
    cases = [('일치', judge({'A': full, 'V': view}, {'A', 'V'}, ok_btn, mb)[0], 'PASS'),
             ('TO-BE 만 그룹', judge({'A': full}, {'A', 'V'}, ok_btn, mb)[0], 'FAIL'),
             ('버튼 다름', judge({'A': full, 'V': view}, {'A', 'V'}, {**ok_btn, 'V': {**ok_btn['V'], 'INSERT': 'Y'}}, mb)[0], 'FAIL'),
             ('SAVE 기대 미정', judge({'A': {**full, 'D': False}}, {'A'}, {'A': {**ok_btn['A'], 'DELETE': 'N'}}, mb)[0], 'PARTIAL'),
             ('메뉴 버튼 정의 없음', judge({'A': full}, {'A'}, ok_btn, mb - {'EDIT'})[0], 'PARTIAL'),
             ('불가 버튼 정의 없음은 통과', judge({'V': view}, {'V'}, ok_btn, mb - {'EDIT'})[0], 'PASS')]
    bad = 0
    for n, got, want in cases:
        k = got == want; bad += 0 if k else 1
        print(f"{'OK ' if k else 'NG '} {n} → {got}(기대 {want})")
    print(f'{len(cases) - bad}/{len(cases)}')
    return 1 if bad else 0


if __name__ == '__main__':
    if '--selftest' in sys.argv:
        sys.exit(selftest())
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    if not args:
        print(__doc__); sys.exit(2)
    m = args[0].upper()
    sys.exit(main(m, sys.argv[sys.argv.index('--asis') + 1].upper() if '--asis' in sys.argv else m))
