def main_e2e_on(py, mid, asis, a, only, blocked):
    if not a.skip_e2e and not blocked and rs_done('e2e') and rs_done('eg') and not RS['p']['vars'].get('formsetup_done'):
        rs_skip('e2e'); rs_skip('eg')
    elif not a.skip_e2e and not blocked:
        e2e_done = rs_done('e2e'); e2e_resume = RS['on'] and not e2e_done and RS['p'].get('cur') == 'e2e'
        if e2e_resume and os.path.exists(os.path.join(ROOT, 'Doc', 'verify', mid, 'form_scenarios.json')) and not RS['p']['vars'].get('formsetup_done'):
            # 폼 저장형 화면: 준비(@formsetup) 기록이 없거나 정리(@formteardown)까지 끝난 실행, 끝난 시험이 다른 준비 데이터로 잰 것일 수 있어 E2E 단계는 새 실행 ID 로 처음부터
            RS['p']['run_id'] = time.strftime('%Y%m%d%H%M%S'); rs_save(); e2e_resume = False
            print(f"[재개 거부] E2E 단계: 폼 저장형 준비 기록 없음 → 새 실행 ID {RS['p']['run_id']} 로 E2E 단계 처음부터", flush=True)
        if e2e_done:
            rs_skip('e2e')
        else:
            stage('e2e', f'tier {a.tier}' + (', 이어서(끝난 시험 다음부터)' if e2e_resume else '')); rs_stage_start('e2e')
        guard_servers('E2E 검증엔진')
        # 2026-11-09 T173(SSP0024·SSP0025 시험 저장 잔존): cleanup_spec.json 정의가 없는 화면은 E2E 실저장 뒤 restore_touched 가 'ERROR 표 없음'·cleanup_marker 가 SKIP 으로 끝나
        #   사내 DB 에 시험 행(SSP0025 신규 1행)·감사 칸·이력 2행(SSP0024)이 남았다. 실저장 전에 저장 PROC DML 대상으로 정의를 자동 생성한다(수기 정의는 건드리지 않음)
        try:
            _has_spec = mid in json.load(open(os.path.join(HERE, 'cleanup_spec.json'), encoding='utf-8'))
        except (OSError, ValueError):
            _has_spec = False
        if not _has_spec:
            print(f'[cleanup_spec] {mid} 정의 없음 → gen_cleanup_spec.py --write (실저장 정리·복원 대상 표 자동 생성)')
            if run([py, os.path.join(HERE, 'gen_cleanup_spec.py'), mid, '--write']):
                print(f'[WARN] {mid} cleanup_spec 자동 생성 실패 — 실저장 시험 행이 남을 수 있음(체인 끝 restore_touched/cleanup_marker 결과 확인)')
        with open(os.path.join(E2E, 'e2e.config.json'), encoding='utf-8-sig') as f:
            cfg = json.load(f)
        urls = {'FE': cfg['feUrl'], 'BE': cfg['beUrl']}
        down = [n for n, u in urls.items() if not reachable(u)]
        if down:
            print(f"[FAIL] {' · '.join(f'{n}({urls[n]})' for n in down)} 미응답(최대 2분 재시도 뒤) — 서버 기동 후 다시 실행(☕ BE Start / 🎨 FE Start). E2E 판정 없이 문서를 만들려면 --skip-e2e")
            return 5
        # 2026-10-28: 화면별 잠금(runlock 'verify <ID>') — 다른 화면의 CheckList 는 동시에 돌고, 같은 화면만 끝나기를 기다린다(최대 120분 · 30초 폴링)
        waited = 0
        while True:
            lock = subprocess.run(['node', 'runlock.js', 'acquire', 'verify', mid], cwd=E2E, capture_output=True, text=True, encoding='utf-8')
            if not lock.returncode:
                break
            if waited == 0:
                print(lock.stderr.strip()); print(f'[WAIT] 같은 화면({mid})의 E2E 가 진행 중 — 끝나면 이어서 실행(최대 120분 대기)', flush=True)
                oev('wait.start', kind='lock', screen=mid, why=(lock.stderr or '').strip()[:300], max_sec=120 * 60)
            if waited >= 120 * 60:
                print(f'[FAIL] {mid} E2E 잠금 대기 120분 초과 — 이전 실행을 확인(tools/E2E: node runlock.js status)')
                oev('wait.end', kind='lock', screen=mid, sec_wait=waited, gave_up=True)
                return 4
            time.sleep(30); waited += 30
        if waited:
            print(f'[INFO] {mid} 잠금 획득 — {waited // 60}분 대기 후 시작', flush=True)
            oev('wait.end', kind='lock', screen=mid, sec_wait=waited, gave_up=False)
        # 2026-10-29: 동시 E2E 상한(슬롯 잠금) — 5화면 동시 실행에서 BE 커넥션 풀(maxPoolSize 10) 고갈 → 로그인 401(-9998)·콤보 60초 대기 → 검증엔진(@trace) 미기동(SCP0020·SCP0096·SCP0111 21:24~26)
        #   + CPU 포화로 15분 타임아웃(SCP0111 B1·B2). e2e.config.json verifyMaxConcurrent(기본 3 · 환경변수 VERIFY_MAX_CONCURRENT) 개까지만 동시에 E2E 를 돌리고 넘치면 빈 슬롯까지 대기(30초 폴링 · 최대 120분).
        # 2026-11-05 사용자 지시: 동시 상한 해제 — 0(또는 음수) = 무제한(슬롯 잠금 생략). 값 미설정일 때만 기본 3.
        _mp = os.environ.get('VERIFY_MAX_CONCURRENT')
        if _mp is None or str(_mp).strip() == '': _mp = cfg.get('verifyMaxConcurrent', 3)
        max_par = int(_mp)
        slot, waited = None, 0
