def load_now():
    """실측 (CPU 사용률 %, 여유 메모리 MB) — Win32_Processor.LoadPercentage 평균 · Win32_OperatingSystem.FreePhysicalMemory. 실패 = (None, None).
    11-06 10:18:53 실측 1회 3.3초(CPU 21 · 여유 5,657MB / 32,327MB)."""
    # 2026-11-10 T214(SSP0023 18:39~ 57분 입장 대기): Win32_Processor.LoadPercentage 가 100 으로 고정 보고 — 같은 시각(19:36) 성능 카운터
    #   '\Processor(_Total)\% Processor Time' 3회 30.8·30.9·32.1% · '% Processor Utility' 58.8·56.2% · 프로세스별 합 약 25%. 성능 카운터 3회(1초) 평균을 쓰고 실패 시만 WMI
    ps = ("try { $c=[math]::Round(((Get-Counter '\Processor(_Total)\% Processor Time' -SampleInterval 1 -MaxSamples 3 -ErrorAction Stop).CounterSamples | Measure-Object -Property CookedValue -Average).Average,1) }"
          " catch { $c=(Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average };"
          "$o=Get-CimInstance Win32_OperatingSystem; '{0} {1}' -f $c,[int]($o.FreePhysicalMemory/1024)")
    try:
        o = subprocess.run(['powershell', '-NoProfile', '-Command', ps], capture_output=True, text=True, timeout=60).stdout.split()
        return float(o[0]), int(o[1])
    except Exception:
        return None, None


def _alive(pid):
    if not pid:
        return False
    try:
        return f'"{pid}"' in subprocess.run(['tasklist', '/FI', f'PID eq {pid}', '/FO', 'CSV', '/NH'], capture_output=True, text=True, timeout=20).stdout
    except Exception:
        return True  # 지연·오류를 '죽음' 으로 보지 않는다(runlock 과 같은 보수 판정)


def running_e2e(mid):
    """지금 E2E 를 돌리는 다른 화면(runlock 'verify <ID>' 잠금 · 주인 프로세스 생존)"""
    import glob
    out = []
    for f in glob.glob(os.path.join(ROOT, 'Doc', 'e2e', '_run.verify.*.lock')):
        k = os.path.basename(f)[len('_run.verify.'):-len('.lock')]
        if k.upper() == mid.upper():
            continue
        try:
            with open(f, encoding='utf-8') as fh:
                if _alive(int(json.load(fh).get('pid') or 0)):
                    out.append(k)
        except Exception:
            pass
    return out


def lang_skipped(p):
    """lang_texts.json 에서 다른 화면 동시 실행 때문에 언어 전환을 생략한(T200) 언어 목록"""
    try:
        with open(p, encoding='utf-8') as fh:
            j = json.load(fh)
    except (OSError, ValueError):
        return []
    return [k for k, v in j.items() if isinstance(v, dict) and 'T200' in str(v.get('why') or '')]


def lang_retry(mid, env, out_dir, cfg):
    """2026-11-18 SCP0111 I2 미검증(EG-7a7637ba·EG-ee2bb45d): 언어 전환 문구 덤프(I2)는 다른 화면 E2E 가 돌면 6분 기다린 뒤 전환을 생략했다(T200 · 테스트 제한 600초).
    → 본 E2E 가 끝난 뒤(화면 잠금을 쥔 채) 다른 화면 E2E 가 끝나기를 최대 langRetryMaxMin(기본 45분) 기다렸다가 I2 시험만 다시 돌린다.
      기다리는 동안 언어 대기 표식(_run.langwait.<ID>.lock)을 둬 다른 화면의 I2 가 이 실행을 '측정 중' 으로 보지 않게 한다(T208 교착 방지).
      결과 파일은 lang_texts.json 만 바뀌고 Playwright 요약은 e2e/results_lang_retry.json 에 따로 쓴다(본 results.json 보존)"""
    lt = os.path.join(out_dir, 'lang_texts.json')
    sk = lang_skipped(lt)
    if not sk:
        return
    max_s = int(cfg.get('langRetryMaxMin', 45)) * 60
    wait_p = os.path.join(ROOT, 'Doc', 'e2e', f'_run.langwait.{mid.upper()}.lock')

    def busy():
        out = []
        for k in running_e2e(mid):
            try:
                with open(os.path.join(ROOT, 'Doc', 'e2e', f'_run.langwait.{k.upper()}.lock'), encoding='utf-8') as fh:
                    if _alive(int(json.load(fh).get('pid') or 0)):
                        continue  # 그 화면도 언어 전환을 기다리는 중(측정 안 함)
            except (OSError, ValueError):
                pass
            out.append(k)
        return out
    t0 = time.time(); o = busy()
    print(f"[INFO] {mid} I2 언어 전환 생략({','.join(sk)} · T200) — 다른 화면 E2E({','.join(o) or '없음'}) 종료 뒤 I2 만 다시 실행(최대 {max_s // 60}분 대기)", flush=True)
    try:
        with open(wait_p, 'w', encoding='utf-8') as fh:
            json.dump({'pid': os.getpid(), 'at': time.time(), 'tag': f'{mid} I2 재실행 대기'}, fh)
        if o:
            oev('wait.start', kind='langwait', screen=mid, why=f"다른 화면 E2E 실행 중({','.join(o)})", max_sec=max_s)
        while o and time.time() - t0 < max_s:
            time.sleep(30); o = busy()
        if time.time() - t0 >= 30:
            oev('wait.end', kind='langwait', screen=mid, sec_wait=int(time.time() - t0), gave_up=bool(o))
    finally:
        try:
            os.remove(wait_p)
        except OSError:
            pass
    if o:
        print(f"[WARN] {mid} I2 재실행 못 함 — {max_s // 60}분 뒤에도 다른 화면 E2E 실행 중({','.join(o)}) · I2 는 미검증으로 남음", flush=True)
        return
    e2 = dict(env, VERIFY_ONLY='I2', PLAYWRIGHT_JSON_OUTPUT_NAME=os.path.join(out_dir, 'e2e', 'results_lang_retry.json'))
    rc2 = run(['node', os.path.join('node_modules', '@playwright', 'test', 'cli.js'), 'test', '_verify', '--grep', '언어 전환 문구 덤프', '--workers', '1', '--retries', '0', '--reporter=list,json'], env=e2, cwd=E2E)
    left = lang_skipped(lt)
    print(f"[INFO] {mid} I2 재실행 rc={rc2} · {round((time.time() - t0) / 60, 1)}분 · 생략 남은 언어 {','.join(left) or '없음'}", flush=True)


def admit_by_load(mid, cfg):
    """2026-11-06 부하 기반 동시 E2E 입장(verifyMaxConcurrent 0).
    · 다른 E2E 가 없으면 즉시 입장
    · 있으면 CPU 사용률 < verifyLoadCpuMax(기본 80%) 이고 여유 메모리 ≥ verifyLoadMemFreeMinMB(기본 3072MB) 일 때만 입장 — 아니면 30초마다 다시 잼
    · 입장 잠금 Doc/e2e/_run.admit.lock(원자적 생성): 입장한 실행이 verifyAdmitRampSec(기본 120초) 동안 쥔다 — 방금 시작한 E2E 의 부하가 오르기 전에
      다른 화면들이 같은 순간 '여유 있음' 을 보고 한꺼번에 들어오는 것을 막는다(주인 죽음·유효 시각 지남 = 해제)
    · 최대 대기 verifyLoadWaitMaxMin(기본 240분) 초과 = 사유 문자열(호출자 rc 4). 측정 실패면 다른 E2E 가 1개 이하일 때만 입장(보수적)"""
    cpu_max = float(cfg.get('verifyLoadCpuMax', 80)); mem_min = int(cfg.get('verifyLoadMemFreeMinMB', 3072))
    ramp = int(cfg.get('verifyAdmitRampSec', 120)); wait_max = int(cfg.get('verifyLoadWaitMaxMin', 240)) * 60
    adm = os.path.join(ROOT, 'Doc', 'e2e', '_run.admit.lock'); waited, last_why, last_print = 0, '', -1
    while True:
        got = False
        try:
            fd = os.open(adm, os.O_CREAT | os.O_EXCL | os.O_WRONLY); os.close(fd); got = True
        except FileExistsError:
            try:
                with open(adm, encoding='utf-8') as fh:
                    info = json.load(fh)
                if time.time() > float(info.get('until') or 0) or not _alive(int(info.get('pid') or 0)):
                    os.remove(adm); continue
                why = f"다른 화면({info.get('id')})이 방금 시작해 부하 상승 대기 중({int(float(info['until']) - time.time())}초 남음)"
            except (json.JSONDecodeError, ValueError):
                why = '다른 화면이 입장 중'  # 막 생성되어 내용이 아직 없음
            except FileNotFoundError:
                continue
        if got:
            others = running_e2e(mid)
            cpu, mem = load_now() if others else (None, None)
            if not others:
                ok, why = True, '다른 E2E 없음'
            elif cpu is None:
                ok, why = len(others) <= 1, f'부하 측정 실패 — 실행 중 {len(others)}개({",".join(others)})' + (' · 1개 이하라 입장' if len(others) <= 1 else ' · 측정 복구까지 대기')
            else:
                ok = cpu < cpu_max and mem >= mem_min
                why = f'실행 중 {len(others)}개({",".join(others)}) · CPU {cpu:.0f}%(기준 <{cpu_max:.0f}) · 여유 메모리 {mem}MB(기준 ≥{mem_min})'
            if ok:
                with open(adm, 'w', encoding='utf-8') as fh:
                    json.dump({'pid': os.getpid(), 'id': mid, 'at': time.time(), 'until': time.time() + ramp}, fh)
                print(f"[INFO] {mid} E2E 시작 — {why}{f' · {waited // 60}분 {waited % 60}초 대기 후' if waited else ''} · 다음 화면 입장은 {ramp}초 뒤부터(부하 반영)", flush=True)
                if waited:
                    oev('wait.end', kind='admit', screen=mid, sec_wait=waited, gave_up=False, why=why[:300])
                return True
            os.remove(adm)
        if why != last_why or waited - last_print >= 600:
            print(f'[WAIT] {mid} 부하 기준 초과·입장 대기 — {why} · 30초 뒤 다시 잼(최대 {wait_max // 60}분)', flush=True)
            if last_print < 0:
                oev('wait.start', kind='admit', screen=mid, why=why[:300], max_sec=wait_max)
            last_why, last_print = why, waited
        if waited >= wait_max:
            oev('wait.end', kind='admit', screen=mid, sec_wait=waited, gave_up=True, why=why[:300])
            return f'{wait_max // 60}분 대기 — 마지막 사유: {why}'
        time.sleep(30); waited += 30


def _latest_doc(mid, kind):
    import glob
    fs = sorted(glob.glob(os.path.join(ROOT, 'Doc', 'UI_CHECKLIST', f'{mid}_*_{kind}_v*.xlsx')), key=os.path.getmtime)
    return fs[-1] if fs else ''


def docs_made_since(mid, started):
    """이번 실행(started 이후)이 CheckList·ActionItemList xlsx 를 둘 다 썼으면 True, 아니면 사유 문자열."""
    import datetime
    try:
        t0 = datetime.datetime.strptime(started, '%Y-%m-%d %H:%M:%S').timestamp() - 2
    except Exception:
        t0 = 0
    miss = []
    for kind in ('CheckList', 'ActionItemList'):
        f = _latest_doc(mid, kind)
        if not f:
            miss.append(f'{kind} 파일 없음')
        elif os.path.getmtime(f) < t0:
            miss.append(f"{kind} 최신본이 이번 실행 이전({datetime.datetime.fromtimestamp(os.path.getmtime(f)).strftime('%m-%d %H:%M')}) — {os.path.basename(f)}")
    return True if not miss else ' · '.join(miss)


def made_docs_text(mid):
    return ' · '.join(os.path.relpath(_latest_doc(mid, k), ROOT).replace('\\', '/') for k in ('CheckList', 'ActionItemList') if _latest_doc(mid, k))

