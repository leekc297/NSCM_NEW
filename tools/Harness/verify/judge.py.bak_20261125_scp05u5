        ev0 = r.get('evidence') or ''
        if ev0.startswith('[사용자판정]') or ev0.startswith('[재실측') or (r.get('tobe_ref') or '').startswith('수동') or '공용 컴포넌트 계약 CC-' in ev0: continue
        for x in _cc:
