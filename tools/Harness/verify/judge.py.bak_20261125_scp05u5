            sc = [t.strip().upper() for t in (x.get('scope') or 'ALL').split(';')]
            if 'ALL' not in sc and mid not in sc and not any(len(t) == 3 and mid.startswith(t) for t in sc): continue
            sf = [t.strip() for t in (x.get('source_filter') or 'ALL').split('|')]
