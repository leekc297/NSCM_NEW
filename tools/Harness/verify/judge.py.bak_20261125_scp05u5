                        r['result'] = 'NA'; r['evidence'] = f"인자 없는 팝업 문장 — 팝업 인자 판정은 [{call_row['row_id']}] {call_row['target'][:60]} 에서"; r['tobe_ref'] = 'STATIC popup_args_check (인자 판정 행 참조)'
