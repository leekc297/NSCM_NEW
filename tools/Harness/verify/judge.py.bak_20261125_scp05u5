    #   콤마로 나누지 않으면(String_Split·split 함수·CHARINDEX(',') 없음 — 단일 LIKE/= 비교) AS-IS 와 같은 동작 = 오류 아님(PASS · AS-IS 동일). 조건 ↔ 파라미터 = plan.json 칸 key ↔ @p_<이름>(기호 제거 비교)
    try:
        _plg = json.load(open(P('Doc', 'e2e', 'specs', f'{mid}.plan.json'), encoding='utf-8-sig'))
    except (OSError, ValueError):
        _plg = {}
    _gsp = [x['asis_sp'] for x in read_csv(P('tools', 'Harness', 'rules', 'sp_pair.csv')) if (x.get('menu_id') or '').upper() == str(mid).upper() and x.get('kind') == 'GET' and (x.get('tobe_proc') or x.get('source') == 'none')]  # T535: TO-BE 짝이 빠져도(source=none · 11-25 SSP0014 PKG 명세 주석 소실) AS-IS 화면 조회 SP 원문은 근거로 쓴다(unused·sp_replaced 제외)
    _gtxt = {}
    _bk2 = P('Doc', 'asisfacts', 'screens', mid, 'dbmeta_dbo_SCM_ADM_DB_SCRIPT_BACKUP.csv')
    if _gsp and os.path.exists(_bk2):
        csv.field_size_limit(10 ** 9)
        for x in csv.DictReader(open(_bk2, encoding='utf-8-sig')):
            if x.get('script_nm') in _gsp:
                _gtxt.setdefault(x['script_nm'], []).append((int(x.get('colid') or 0), x.get('text') or ''))
        _gtxt = {k: ''.join(t for _, t in sorted(v)) for k, v in _gtxt.items()}
    _nk = lambda s_: re.sub(r'[^a-z0-9]', '', (s_ or '').lower())
    for r in rows:
        # T535(2026-11-25 SSP0014 V-a70af79e): E2E 가 텍스트 칸 G2 에 G9 와 같은 콤마 다중 입력 실측을 적은 행('[텍스트 칸 콤마 다중 입력 · T497]')도 같은 근거로 판정
        _g2c = r['rule_id'] == 'G2' and '콤마 다중 입력 · T497' in (r.get('evidence') or '')
        if r['source'] != 'SEARCH' or (r['rule_id'] != 'G9' and not _g2c) or r['result'] != 'FAIL' or not _gtxt:
            continue
        lab = re.sub(r'^조회조건\s*', '', r['target'])
        fld = next((f for f in (_plg.get('fields') or []) if any(_nk(l) == _nk(lab) for l in [f.get('label', '')] + (f.get('labels') or []))), None)
        if not fld or not fld.get('key'):
            continue
        hits = []
        for sp, tx in _gtxt.items():
            for pm in sorted(set(re.findall(r'@(p_\w+)', tx, re.I))):
                # 2026-11-20 T381(SSP0014 V-3809bf77 G9 허위 FAIL): plan 칸 key 'user' ↔ AS-IS @p_user_id 처럼 끝의 id·ids 유무만 다른 이름을 못 맞춰
                #   AS-IS 단일 LIKE 비교(분리 없음) 근거를 못 읽었다 → 끝 'id'·'ids'·'s' 를 뗀 이름도 같은 칸으로 본다
                if _nk(pm[2:]) != _nk(fld['key']) and _g9_stem(pm[2:]) != _g9_stem(fld['key']):
                    continue
                split = re.search(r'(?i)(string_split|split\w*)\s*\(\s*@' + re.escape(pm) + r'\b|charindex\s*\(\s*\'[,;]\'\s*,\s*@' + re.escape(pm) + r'\b|@' + re.escape(pm) + r'\b[^\n]{0,40}\bIN\s*\(\s*SELECT', tx)
                uses = [m_.group(0).strip()[:90] for m_ in re.finditer(r'[^\n]{0,60}@' + re.escape(pm) + r'\b[^\n]{0,40}', tx)][:2]
                hits.append((sp, pm, bool(split), uses))
        if hits and not any(h[2] for h in hits):
            r['result'] = 'PASS'
            r['evidence'] = (f"AS-IS 조회 SP 도 '{lab}' 조건을 콤마로 나누지 않음(" + ' · '.join(f"{h[0]} @{h[1]}: {h[3][0] if h[3] else ''}" for h in hits)[:400]
                             + f") — 콤마 다중 입력 미지원은 AS-IS 와 같은 동작(사용자 판정 2026-11-18 SCP0111 '오류 아님 - AS-IS 도 멀티선택 안됨') · 실측: {(r.get('evidence') or '')[:300]}")[:1500]
            r['tobe_ref'] = 'STATIC AS-IS 조회 SP 원문(조건 파라미터 분리 여부) + E2E G9 실측'; r['precond'] = json.dumps({'asis_param': [h[1] for h in hits]}, ensure_ascii=False)
            stat.setdefault('G9_ASIS_SINGLE', 0); stat['G9_ASIS_SINGLE'] += 1

    # M3 팝업 데이터 조회 — popup_data.csv(AS-IS 개인화 팝업 ↔ TO-BE 메타 조회를 Division 값별 DB 실행, 2026-10-30 SCP0100 Measure 팝업 0건 미검출).
    #   원장 ASIS M3 행(팝업 생성 문장 file:line) 에 싣는다. 같은 문장의 항목(시트별) = FAIL 1건이라도 FAIL · 아니면 ERROR · 아니면 PASS · 전부 NA 면 NA.
    #   E2E FAIL·수동·사용자판정은 덮지 않는다.
    pd_p = P('Doc', 'verify', mid, 'popup_data.csv')
    if os.path.exists(pd_p):
        stat.setdefault('POPUP_DATA', 0)
        by_loc = {}
        for x in read_csv(pd_p):
            if x.get('asis_ref'):
                by_loc.setdefault(x['asis_ref'].split(' ')[0], []).append(x)
        order = {'FAIL': 0, 'ERROR': 1, 'PASS': 2, 'NA': 3}
        for r in rows:
            if r['rule_id'] != 'M3' or r['source'] != 'ASIS' or (r.get('tobe_ref') or '').startswith('수동') or (r.get('evidence') or '').startswith('[사용자판정]'):
                continue
            items = by_loc.get((r.get('asis_ref') or '').split(' ')[0])
            if not items:
                continue
            vs = [x['verdict'] for x in items]
            res = 'FAIL' if 'FAIL' in vs else 'ERROR' if 'ERROR' in vs else 'PASS' if 'PASS' in vs else 'NA'
            ev = ' | '.join(f"[{x['verdict']}] {x['kind']} 시트 '{x['sheet']}' ({x['tobe_ref']}): {x['note']}" for x in sorted(items, key=lambda x: order.get(x['verdict'], 9)))
            if r['row_id'] in e2e_ids and r['result'] == 'FAIL' and res != 'FAIL':
                r['evidence'] = (r['evidence'] + f" · 정적+DB 팝업 목록 {res}: {ev}")[:1500]; continue
            r['result'] = res
            r['evidence'] = f"팝업 목록 조회(TO-BE 메타 PROC 를 Division 값별 실행) — {ev}"[:1500]
            r['tobe_ref'] = 'STATIC+DB popup_data_check (AS-IS 개인화 팝업 ↔ TO-BE 메타 조회 Division 별 행수)'
            stat['POPUP_DATA'] += 1

    # W1 콤보 AS-IS 원천 비교(B4 집합·B3 순서·G7 표시 형식 10-28) — combo_oracle.json(2026-10-24). 조회조건 = 라벨, 그리드 = 바인딩으로 원장 행에 연결
    co_p = P('Doc', 'verify', mid, 'combo_oracle.json')
    if os.path.exists(co_p):
        with open(co_p, encoding='utf-8') as f:
            co = json.load(f)
        by_s = {norm(x['target']): x for x in co.get('results', []) if x['kind'] == 'SEARCH'}
        by_g = {norm(x['target']): x for x in co.get('results', []) if x['kind'] == 'GRID'}
        # 기존행 판정(EG059) — 신규행이 통과해도 기존행 후보가 틀리면 그 결과를 쓴다
        for x in co.get('results', []):
            if x['kind'] == 'GRID_EX' and x.get('b4') == 'FAIL' and (by_g.get(norm(x['target'])) or {}).get('b4') != 'FAIL':
                by_g[norm(x['target'])] = x
        stat.setdefault('W1', 0)
        for r in rows:
            if r['rule_id'] not in ('B4', 'B3', 'G7') or r['source'] not in ('SEARCH', 'COLUMN') or (r.get('tobe_ref') or '').startswith('수동'):
                continue
            if r['rule_id'] == 'G7' and r['source'] != 'SEARCH':
                continue
            if r['source'] == 'SEARCH':
                x = by_s.get(norm(r['target'].replace('조회조건', '', 1)))
            else:
                x = by_g.get(norm((re.search(r'\.([A-Za-z0-9_]+)', r['target']) or [None, ''])[1]))
            if not x:
                continue
            res, why = {'B4': (x.get('b4'), x.get('why', '')), 'B3': (x.get('b3'), x.get('b3_why', '')), 'G7': (x.get('g7'), x.get('g7_why', ''))}[r['rule_id']]
            if not res:
                continue
            extra = '' if r['rule_id'] in ('B3', 'G7') else (f" · AS-IS만 {x.get('asis_only_n', 0)} {x.get('asis_only', [])[:8]} · TO-BE만 {x.get('tobe_only_n', 0)} {x.get('tobe_only', [])[:8]}" if x.get('asis_only_n') or x.get('tobe_only_n') else '')
            r['result'] = res
            r['evidence'] = (f"[{x.get('scenario', '')}] {why}{extra} · 원천 {x.get('asis_src', '-')} · 표현 {x.get('rep', '-')}")[:1500]
            r['tobe_ref'] = f"W1 combo_oracle (AS-IS {co.get('asis_id')} DB 동시 실행 · 계정 {co.get('account')}/{co.get('group')})"
            stat['W1'] += 1
        # 2026-11-18 미검증 해소(SCP0096 cboDayWeek·cboInputValue B3/B4 '실행 경로 없음'): TO-BE 가 조회조건을 버튼 모달로 옮긴 경우 원장에 조회조건 행이 없다 →
        #   대조표 추적 행(TRACE · et COND)의 라벨 목록으로 콤보 검사 결과(조회조건 라벨 · modal 기록 포함)를 연결한다
        by_lab = {}
        for x in co.get('results', []):
            if x['kind'] == 'SEARCH':
                for k in (x.get('target'), x.get('label')):
                    if k: by_lab.setdefault(norm(k), x)
        for r in rows:
            if r['source'] != 'TRACE' or r['rule_id'] not in ('B3', 'B4') or '"et": "COND"' not in (r.get('condition') or '') or (r.get('tobe_ref') or '').startswith('수동'):
                continue
            try:
                labs = json.loads(r['condition']).get('labels') or []
            except ValueError:
                labs = []
            x = next((by_lab[norm(lb)] for lb in labs if lb and lb != '-' and norm(lb) in by_lab), None)
            if not x:
                continue
            res, why = (x.get('b4'), x.get('why', '')) if r['rule_id'] == 'B4' else (x.get('b3'), x.get('b3_why', ''))
            if not res:
                continue
            r['result'] = res; r['evidence'] = (f"[{x.get('scenario', '')}] {why} · 원천 {x.get('asis_src', '-')} · 라벨 {x.get('label', '')}")[:1500]
            r['tobe_ref'] = f"W1 combo_oracle (대조표 조건 라벨 연결 · 계정 {co.get('account')}/{co.get('group')})"
            stat['W1'] += 1
        # 2026-11-18 미검증 해소(SCP0096 B8 2행): '[측정 코드 없음] Team/Sales Site 계열 조건 X 존재' — Team(SSPM DEPT_ID 원천 규칙)이 없고 나머지 조건은
        #   '후보 = AS-IS 원천' 기대라 콤보 검사(B4) 결과로 판정한다. Team 이 있거나 B4 결과가 없는 조건이 하나라도 있으면 그대로 둔다
        for r in rows:
            mm = re.search(r'\[측정 코드 없음\] Team/Sales Site 계열 조건 ([^—]+?) 존재', r.get('evidence') or '')
            if r['rule_id'] != 'B8' or not mm:
                continue
            labs = [x.strip() for x in mm.group(1).split(',') if x.strip()]
            if not labs or any(l.lower() == 'team' for l in labs):
                continue
            got = [(l, by_lab.get(norm(l))) for l in labs]
            if any(not x or x.get('b4') not in ('PASS', 'FAIL') for _, x in got):
                continue
            bad = [l for l, x in got if x.get('b4') == 'FAIL']
            r['result'] = 'FAIL' if bad else 'PASS'
            r['evidence'] = ('Team 조건 없음 · ' + ' · '.join(f"{l} 후보 = AS-IS 원천 {x.get('b4')}({(x.get('why') or '')[:80]})" for l, x in got))[:1500]
            r['tobe_ref'] = 'W1 combo_oracle (B8 = 조건 후보 AS-IS 원천)'
            stat['W1'] += 1

    # A5(표시 여부) FAIL 중 그 컬럼이 확정 규칙·결함 원장에 언급되면 AS-IS 와 달라도 확정 요구일 수 있다 → 판정필요
    #   (2026-10-23 DMF0082: MEASURE·VERSION 표시 = DM-47 확정 요구 'Measure 컬럼 항상 표시'와 겹침)
    o2_text = ' '.join(x.get('requirement', '') + ' ' + x.get('target', '') for x in read_csv(P('tools', 'Harness', 'rules', 'confirmed_requirements.csv')))
    o2_text += ' ' + ' '.join(x.get('expected', '') + ' ' + x.get('target', '') for x in read_csv(P('Doc', 'verify', 'defects_classified.csv')) if x.get('menu_id') in (mid, 'COMMON'))
    o2_up = o2_text.upper()
    for r in rows:
        if r['rule_id'] == 'A5' and r['result'] == 'FAIL':
            col = (re.search(r'\.([A-Z0-9_]+)', r['target']) or [None, ''])[1]
            label = (re.search(r'\(([^)]*)\)', r['target']) or [None, ''])[1].replace('*', '').strip()
            if col == 'CHK':   # 2026-11-16 CR-104: 행 선택용 CHK 컬럼은 _trace.spec 이 행 머리 선택기 유무로 판정을 끝낸다(선택기 없음 = FAIL 유지). 룰 문구에 CHK 가 있다고 판정필요로 낮추지 않는다
                continue
            if col and (col in o2_up or (label and label.upper() in o2_up)):
                r['result'] = '판정필요'
                r['evidence'] += f" — 이 컬럼({col}/{label})이 확정 규칙·결함 원장에 언급됨: AS-IS 와 다른 확정 요구인지 확인"

    # 화면 단위 규칙(RULE_SCREEN)·조회조건(SEARCH) ← E2E smoke/auth 요약(Doc/e2e/results/_summary.csv) 반입 (2026-10-26: 원장 화면 규칙 12행이 smoke 를 돌려도 NOT_RUN 으로 남던 구멍)
    stat.setdefault('SMOKE', 0)
    import e2e_paths  # 2026-11-06: 화면별 요약(Doc/e2e/results/<ID>/_summary.csv) 우선 · 없으면 공용 색인
    summ = [x for x in read_csv(e2e_paths.summary_path(mid)) if x.get('menu_id', '').upper() == mid]
    ev_screen = {}  # rule → (result, evidence)
    ev_cond = {}    # (rule, norm(label)) → (result, evidence)
    V = {'OK': 'PASS', 'FAIL': 'FAIL', 'WARN': '판정필요', 'NA': 'NA', 'ERROR': 'ERROR'}
    for x in summ:
        kind, st = x.get('kind', ''), x.get('status', '')
        for part in (x.get('annotations') or '').split(' || '):
            t, _, desc = part.partition(': '); t = t.strip()
            m = re.match(r'\[(\w+)\]\s*(.+?)\((\w+)\)\s*—\s*(.*)', desc) if t in ('cond', 'common') else None
            if t == 'common' and m:
                v, name, _k2, note = m.groups()
                rule = 'K1' if re.search(r'sort|filter', name, re.I) else 'K2' if re.search(r'column|measure', name, re.I) else 'H7' if re.search(r'excel', name, re.I) else 'G3' if re.search(r'condition|reset', name, re.I) else 'K3' if re.search(r'manual', name, re.I) else ''
                if rule:
                    prev = ev_screen.get(rule)
                    # 2026-11-07 T150(SCP0084 H7): '조회된 데이터가 없습니다' 알림으로 끝난 공통 기능(Excel 다운로드 등)은 기능 결함이 아니라 측정 전제(조회 행) 미충족 → ERROR 로 반입
                    if v == 'FAIL' and re.search(r'조회된 데이터가 없|데이터가 없습니다|No data', note or ''): v = 'ERROR'; note = '[측정 전제 미충족: 조회 0행 알림] ' + (note or '')
                    res = V.get(v, '판정필요'); worse = prev and ({'FAIL': 0, 'ERROR': 1, '판정필요': 2, 'PASS': 3, 'NA': 4}.get(prev[0], 2) < {'FAIL': 0, 'ERROR': 1, '판정필요': 2, 'PASS': 3, 'NA': 4}.get(res, 2))
                    ev_screen[rule] = prev if worse else (res, f"E2E smoke 공통 '{name}' [{v}] {note[:100]}" + (f" | {prev[1][:80]}" if prev else ''))
            elif t == 'cond' and m:
                v, name, k2, note = m.groups()
                if k2 in ('combo', 'checkbox', 'radio', 'text', 'period', 'search'): ev_cond[('G1', norm(name))] = (V.get(v, '판정필요'), f"E2E smoke 조회조건 '{name}' [{v}] {note[:100]}")
                # 2026-11-07 T159: 기준표 순서(order)·제외 조건 잔존(gone) → 화면 규칙 SC1(RULE_SCREEN · 모든 화면) — 대조표에 SC1 이 걸리는 행이 없는 화면(SCP0127)도 원장에 들어오게. 판정은 order_rule(Excel 기준)
                elif k2 == 'order':
                    # 2026-11-09 CR-098(사용자 지시 · SCP0084 조치 필요 1건 '오류 아님'): Excel 조회조건 정리 대조는 사용여부·EDIT 형태까지만 — 순서는 판정 대상 제외.
                    #   순서 실측은 참고로만 남기고(NA), 같은 SC1 행의 사용여부(gone) FAIL 은 덮지 않는다(gone 이 뒤에 와도 NA 를 덮어쓴다)
                    ev_screen.setdefault('SC1', ('NA', f"E2E smoke cond order [{v}] — 조회조건 순서는 판정 대상 제외(CR-098 · 사용자 지시 2026-11-09) · 참고 실측: {note[:300]}"))
                elif k2 == 'gone':
                    prev = ev_screen.get('SC1'); res = V.get(v, '판정필요')
                    if not prev or res == 'FAIL' or prev[0] not in ('FAIL',): ev_screen['SC1'] = (res, f"E2E smoke cond {k2} [{v}] {note[:300]}" + (f" | {prev[1][:120]}" if prev else ''))
            elif t == 'columns': ev_screen.setdefault('A5', ('PASS' if re.search(r'누락 0', desc) else 'FAIL', f'E2E smoke columns {desc[:120]}'))
            elif t in ('access', 'buttons', 'authcrud') and kind.startswith('auth'):
                # 메뉴 접근 권한이 없는 그룹(menuAccess=N)의 기대값 없는 기록은 이 화면의 J2 판정 근거가 아니다(DM Admin 은 SCP 화면 접근 대상 아님) — 2026-10-27 v57 허위 FAIL
                if re.search(r'menuAccess=N', desc) and re.search(r'expected=(\s|$)', desc):
                    ev_screen.setdefault('J2', ('NA', f'E2E {kind} {desc[:100]} — 메뉴 접근 권한이 없는 그룹(menuAccess=N)의 기록은 이 화면 J2 판정 근거가 아님(접근 대상 아님 · 버튼 권한 실측은 J1/authcrud 다른 기록)')); continue
