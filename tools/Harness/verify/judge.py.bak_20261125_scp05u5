def popup_var_classes(acts, root=None, known=()):
    """actions.csv → {(메서드, 변수): 팝업 클래스}. 사실 파일의 팝업 생성 문장(`new <Class>` — 변수 이름 없음)의 원문 줄을 읽어 `<변수> = new <Class>(` 를 얻는다.
    사실 본문(raw·target·value)에 `변수 = new Class(` 가 그대로 있으면 그것도 쓴다. 같은 (메서드, 변수) 에 서로 다른 클래스면 빼낸다. T269"""
    seen = {}; cache = {}
    # 2026-11-25 T576(SCP0005 H6 V-718e1a16·V-616b4d31·V-e14533b1 · G5 V-a6bb7234): 클래스 이름에 'Pop' 이 없는 팝업(SCM0002_CitybyCountry · ExcelUploadForm2)은
    #   변수 → 클래스를 못 풀어 팝업 실측 상속(T269)이 빠졌다. known = 이 화면에서 팝업으로 실측된 클래스(원장 '… 팝업 <클래스> …' 행) — 이름 규칙에 더해 실측 사실로 인정
    known = set(known or ())
    _kn = ('|' + '|'.join(re.escape(k) for k in sorted(known))) if known else ''
    rx = re.compile(r'\b([A-Za-z_]\w*)\s*=\s*new\s+([A-Za-z_]\w*(?:Popup|PopUp|Pop)\w*' + _kn + r')\s*\(')

    def line_of(rel, n):
        if not root or not rel or not n:
            return ''
        if rel not in cache:
            cache[rel] = []
            for b in ('GSCM', 'GSCM_20260512'):
                fp = os.path.join(root, b, rel.replace(chr(92), '/'))
                if os.path.exists(fp):
                    with open(fp, encoding='utf-8', errors='replace') as f:
                        cache[rel] = f.read().split(chr(10))
                    break
        ls = cache[rel]
        return ls[n - 1].split('//')[0] if 0 < n <= len(ls) else ''
    for a in acts:
        txt = ' '.join(str(a.get(k) or '') for k in ('raw', 'target', 'value'))
        if re.search(r'\bnew\s+(?:[A-Za-z_]\w*(?:Popup|PopUp|Pop)\w*' + _kn + r')\b', txt) and not rx.search(txt):
            try:
                txt += ' ' + line_of(a.get('file') or '', int(a.get('line') or 0))
            except ValueError:
                pass
        for m in rx.finditer(txt):
            seen.setdefault((a.get('method') or '', m.group(1)), set()).add(m.group(2))
    return {k: next(iter(v)) for k, v in seen.items() if len(v) == 1}


def popup_class_of(text, var_classes, method='', known=()):
    """AS-IS 팝업 문장 → 팝업 클래스 이름('' = 못 품). `new <Class>(` 가 있으면 그것 · 없으면 `변수.멤버(` 의 변수를 같은 메서드의 var_classes 로. T269 · known = 실측된 팝업 클래스(T576)"""
    _kn = ('|' + '|'.join(re.escape(k) for k in sorted(set(known or ())))) if known else ''
    m = re.search(r'\bnew\s+([A-Za-z_]\w*(?:Popup|PopUp|Pop)\w*' + _kn + r')\s*\(', text or '')
    if m:
        return m.group(1)
    m = re.match(r'\s*(?:this\.)?([A-Za-z_]\w*)\.\w+', text or '')
    if m:
        return var_classes.get((method, m.group(1)), '')
    return ''


def _asis_toggle_prefixes(asis_id):
    """2026-11-18: AS-IS 원문에서 '...Columns[..].Visible = chkX.Checked' 바로 앞 3줄 안의 IndexOf("P_") 접두 → {접두: (chkX, '파일:행')}"""
    out = {}
    try:
        root = json.load(open(P('tools', 'Harness', 'harness.json'), encoding='utf-8')).get('asisSrcRoot') or P('GSCM')
    except (OSError, ValueError):
        root = P('GSCM')
    for f in read_csv(P('Doc', 'asisfacts', 'screens', asis_id, 'files.csv')):
        fp = os.path.join(root, f.get('file') or '')
        if not fp.endswith('.cs') or not os.path.exists(fp):
            continue
        lines = open(fp, encoding='utf-8', errors='replace').read().splitlines()
        for i, t in enumerate(lines):
            if t.strip().startswith('//'):
                continue
            m = re.search(r'\.Visible\s*=\s*(chk\w+)\.Checked', t)
            if not m:
                continue
            for k in range(max(0, i - 3), i + 1):
                if lines[k].strip().startswith('//'):
                    continue
                for px in re.findall(r'IndexOf\("([A-Z]{1,2}_)"\)', lines[k]):
                    out.setdefault(px, (m.group(1), f"{os.path.basename(fp)}:{i + 1}"))
    return out


def _asis_empty_handler(asis_id, name):
    """2026-11-18: AS-IS 화면 원문(Doc/asisfacts/screens/<ID>/files.csv · harness asisSrcRoot)에서 메서드 본문이 주석·빈 줄뿐이면 '파일:행' · 아니면 ''"""
    try:
        root = json.load(open(P('tools', 'Harness', 'harness.json'), encoding='utf-8')).get('asisSrcRoot') or P('GSCM')
    except (OSError, ValueError):
        root = P('GSCM')
    for f in read_csv(P('Doc', 'asisfacts', 'screens', asis_id, 'files.csv')):
        fp = os.path.join(root, f.get('file') or '')
        if not fp.endswith('.cs') or not os.path.exists(fp):
            continue
        txt = open(fp, encoding='utf-8', errors='replace').read()
        m = re.search(r'void\s+' + re.escape(name) + r'\s*\([^)]*\)\s*\{', txt)
        if not m:
            continue
        i, depth = m.end(), 1
        while i < len(txt) and depth:
            depth += {'{': 1, '}': -1}.get(txt[i], 0); i += 1
        body = re.sub(r'/\*[\s\S]*?\*/|//[^\r\n]*', '', txt[m.end():i - 1]).strip()
        return f"{os.path.basename(fp)}:{txt[:m.start()].count(chr(10)) + 1}" if not body else ''
    return ''


CASCADE_STOP = {'cascade', 'current', 'grid', 'combo', 'popup', 'insert', 'save', 'search', 'value', 'values', 'row', 'rows', 'list', 'tab'}


def cascade_entities(target):
    """2026-11-19 미검증 해소(SCP0028 C2 결함 유형 10행): '그리드 End Customer→Sold-to Customer cascade' · 'Sales Company/Sales Plant 콤보' ·
    'Measure(MKT_FCST·…)' 같은 다른 화면 결함 대상에서 칸 이름(영문 1~3단어)을 뽑는다. 괄호 안 값 목록·W35~W38 같은 기간 칸·일반어(CASCADE_STOP)는 뺀다"""
    t = re.sub(r'^\[[^\]]*\]\s*', '', target or '')
    t = re.sub(r'\([^)]*\)', ' ', t)
    out = []
    for ph in re.findall(r'[A-Za-z][A-Za-z_\-]*(?: [A-Za-z][A-Za-z_\-]*){0,2}', t):
        ws = [w for w in ph.split() if w.lower() not in CASCADE_STOP and not re.fullmatch(r'W\d+', w)]
        if ws and len(''.join(ws)) >= 3:
            out.append(' '.join(ws))
    return out


def _asis_insert_noop(asis_id):
    """2026-11-19: AS-IS Insert 진입점(actions_entries entry~insert)의 메서드에 실행 문장이 0 이면 'Insert경로:파일:행' · 아니면 ''.
    규칙 = tools/E2E/lib/newrow.ts asisInsertNoop · facts_lockrules insert_noop 과 같음(CALL_LOCAL·RETURN·BRANCH·LOCAL 외 문장 0). 진입점이 없으면 ''(InsertButton 없음은 따로 처리)"""
    d = P('Doc', 'asisfacts', 'screens', asis_id)
    ents, acts = read_csv(os.path.join(d, 'actions_entries.csv')), read_csv(os.path.join(d, 'actions.csv'))
    ms = {e.get('method') for e in ents if re.search('insert', e.get('entry') or '', re.I)}
    if not ms or not acts:
        return ''
    if any(a.get('method') in ms and a.get('kind') not in ('CALL_LOCAL', 'RETURN', 'BRANCH', 'LOCAL') for a in acts):
        return ''
    loc = next((f"{os.path.basename(a.get('file') or '')}:{a.get('line')}" for a in acts if a.get('method') in ms), '')
    if not loc:
        # 진입점 메서드 문장이 사실 파일에 하나도 없으면 재정의가 없는지(프레임워크 기본 Insert 가 동작) 빈 재정의인지 구분이 안 된다 → 원문에서 빈 본문을 확인한 경우만
        loc = next((_asis_empty_handler(asis_id, m) for m in sorted(ms) if _asis_empty_handler(asis_id, m)), '')
        if not loc:
            return ''
    return f"{','.join(sorted(ms))} 실행 문장 0{(' · ' + loc) if loc else ''}"


