                        r['tobe_ref'] = f"{e.get('tobe_ref', 'E2E')} @{at} (조건 변경)"; stat.setdefault('E2E_STALE', 0); stat['E2E_STALE'] += 1; e2e_ids.add(r['row_id']); continue
