# -*- coding: utf-8 -*-
"""
plain_detail — CheckList '설명' 열을 처음 보는 사람도 읽을 수 있게 다시 쓴다 (사용자 2026-11-13).
  형식(조치 필요·판정 필요 행):
    [오류] 대상 — 무엇이 잘못됐는지 한 문장            ← 맨 위: 어떤 부분이 오류인지 정의
    · AS-IS : AS-IS 에서는 어떻게 되어 있는지
    · TO-BE : TO-BE 에서는 어떻게 되어 있는지
    · 설명  : 그래서 무엇이 다른지 / 왜 기계가 결론을 못 냈는지
    · AS-IS 실행 확인 : AS-IS 런처를 실제로 띄워 본 기록(Doc/asislive/<ID>)이 있으면 그 값
    · 참고  : 같은 문제 n곳 · 재현 여부
  원칙: 증거(evidence)에 적힌 값만 풀어 쓴다. 증거에 없는 값을 지어내지 않는다. 풀어 쓸 규칙이 없으면 증거 원문을 용어만 바꿔 그대로 둔다.
  판정은 바꾸지 않는다(문구만). make_verify_docs.lrow 가 호출 · 실패하면 종전 한 줄 설명을 그대로 쓴다.
"""
import os, re, csv, json, glob

ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', '..'))
_S = {'mid': '', 'labels': {}, 'live': None}


def set_screen(mid):
    _S['mid'] = (mid or '').upper(); _S['labels'] = {}; _S['live'] = None
    try:
        p = os.path.join(ROOT, 'Doc', 'tobefacts', 'db', 'sheet_columns.csv')
        for x in csv.DictReader(open(p, encoding='utf-8-sig')):
            if (x.get('program_id') or '').upper() == _S['mid'] and x.get('column_name') and x.get('column_label_name'):
                _S['labels'].setdefault(x['column_name'].upper(), x['column_label_name'].strip())
    except Exception:
        pass
    try:  # AS-IS 런처 실구동 기록(가장 최근 · 그리드 덤프가 있는 것)
        runs = sorted(glob.glob(os.path.join(ROOT, 'Doc', 'asislive', _S['mid'], 'run_*', 'grids.json')))
        if runs:
            d = os.path.dirname(runs[-1]); g = json.load(open(runs[-1], encoding='utf-8')); cols = {}
            for gr in g.get('grids') or []:
                for sh in gr.get('sheets') or []:
                    if str(sh.get('visible')) != 'True': continue
                    for c in sh.get('columns') or []:
                        t = (c.get('tag') or '').upper()
                        if t: cols.setdefault(t, []).append({'sheet': sh.get('name'), 'label': c.get('label'), 'visible': str(c.get('visible')) == 'True', 'width': c.get('width'), 'locked': str(c.get('locked')) == 'True'})
            run = {}
            try: run = json.load(open(os.path.join(d, 'run.json'), encoding='utf-8'))
            except Exception: pass
            _S['live'] = {'at': str(run.get('started') or os.path.basename(d))[:16], 'user': run.get('user_id') or '', 'cols': cols}
    except Exception:
        _S['live'] = None


def col(name):
    """컬럼 코드 → '화면 이름(코드)'"""
    n = (name or '').strip(); lb = _S['labels'].get(n.upper())
    if not lb and _S['live']:
        c = _S['live']['cols'].get(n.upper()); lb = (c[0]['label'] if c else '') or ''
    lb = (lb or '').rstrip('*').strip()
    return f"'{lb}'({n})" if lb and lb.upper() != n.upper() else f"'{n}'"


_GLOSS = [(r'\br(\d+)\b', lambda m: f'{int(m.group(1)) + 1}번째 행'), (r'편집=false', '입력 불가(잠김)'), (r'편집=true', '입력 가능'), (r'SHEET_COLUMNS', '컬럼 메타'), (r'VISIBLE=N', '표시 안 함'), (r'VISIBLE=Y', '표시'),
          (r'golden_cases\.csv', '비교 조건 목록'), (r'콤보 재요청', '목록 다시 불러오기'), (r'\bcall-proc\b', '서버 호출'), (r'폴백', '임시 표시'), (r'USER_SELECTABLE_FLAG', '사용자 선택 가능 여부'),
          (r'\bSP\b', '조회·저장 프로그램(SP)'), (r'메타 밖 Div', '메타에 없는 Division'), (r'다중 체크리스트', '여러 개를 체크하는 목록')]


def soft(t, n=260):
    t = re.sub(r'\s+', ' ', str(t or '')).strip(' ·—|')
    for rx, to in _GLOSS: t = re.sub(rx, to, t)
    t = re.sub(r'\b([A-Z][A-Z0-9]*_[A-Z0-9_]+)\b', lambda m: col(m.group(1)) if m.group(1).upper() in _S['labels'] else m.group(1), t)
    return t if len(t) <= n else t[:n - 1] + '…'


def _prefix(ev):
    """증거 앞머리의 엔진 표식을 떼고, 사람이 알아야 할 사정만 문장으로 돌려준다"""
    notes = []; ev = (ev or '').replace('\n', ' ').strip()
    m = re.match(r'^\[시험 검사 CM-\d+[^\]]*\]\s*(.*?)(?: · 실측: |$)(.*)$', ev)
    if m and '실측: ' in ev:
        notes.append('이 검사는 아직 시험 단계라, 다르게 나와도 바로 오류로 올리지 않고 사람 확인으로 둡니다.'); ev = m.group(2).strip()
    m = re.match(r'^\[증거 부족:[^\]]*\]\s*(.*)$', ev)
    if m: notes.append('AS-IS 기준을 소스에서 직접 확인한 근거가 없어, 오류로 단정하지 않고 사람 확인으로 둡니다.'); ev = m.group(1).strip()
    ev = re.sub(r'^실측\[[A-Z]+-[0-9a-f]+\]:\s*', '', ev); ev = re.sub(r'^\[사용자판정\].*?— 실측: ', '', ev)
    return ev, notes


def _live_cols(names):
    lv = _S['live']
    if not lv: return ''
    out = []
    for n in names:
        cs = lv['cols'].get(n.upper())
        if not cs: out.append(f"{col(n)} — AS-IS 실행 화면의 그리드에 이 컬럼이 없습니다"); continue
        for c in cs[:2]:
            w = str(c.get('width') or ''); shown = c['visible'] and w not in ('0', '0.0')
            out.append(f"{col(n)} — 시트 {c['sheet']}: " + ('화면에 보입니다' if shown else ('컬럼은 있지만 폭이 0 이라 화면에는 보이지 않습니다' if c['visible'] else '숨김 컬럼입니다')) + f"(표시={'예' if c['visible'] else '아니오'} · 폭 {w})")
    tail = ' → 컬럼 설정으로는 보이는 컬럼인데 AS-IS 를 실제로 띄운 화면에서는 보이지 않았습니다. 이 항목은 실제 차이가 아니라 판정 오류일 수 있으니 확인이 필요합니다.' if any('보이지 않습니다' in x or '숨김' in x or '없습니다' in x for x in out) else ''
    return f"{lv['at']} 실행(계정 {lv['user'] or '?'} · 화면 기본 상태) 기준 — " + ' / '.join(out) + tail


# ── 규칙별 풀이: (r, ev) → dict(title, asis, tobe, why, live) 또는 None ──
def _a5(r, ev):
    div = (re.search(r'Div (\S+?)[ )]', ev) or [None, ''])[1]
    miss = re.search(r'누락\([^)]*\) \d+개 = ([^·]+)', ev); add = re.search(r'추가\([^)]*\) \d+개 = ([^·]+)', ev)
    el = re.match(r"^([A-Z0-9_]+): AS-IS\(Div ([^)]+)\) '([^']*)' ↔ TO-BE 표시=([YN])(?: — [^(]*)?(?:\(TO-BE 메타 VISIBLE=([YN])\))?", ev)
    if el:
        c = el.group(1); d = el.group(2); tb = el.group(4); mv = el.group(5)
        tobe = f"같은 조건에서 화면 그리드에 이 컬럼이 {'보입니다' if tb == 'Y' else '보이지 않습니다'}." + (f" TO-BE 컬럼 설정(컬럼 메타)의 표시 여부는 '{mv}' 입니다." if mv else '')
        why = ('TO-BE 컬럼 설정에서 이 컬럼이 표시 안 함으로 되어 있어 보이지 않습니다.' if mv == 'N' else '컬럼 설정은 표시인데도 화면에 보이지 않습니다. 화면(FE)에서 이 컬럼을 그리지 않는지 확인이 필요합니다.' if mv == 'Y' else '')
        return dict(title=f"그리드 컬럼 {col(c)} — AS-IS 에서는 보이는데 TO-BE 에서는 보이지 않습니다" if tb == 'N' else f"그리드 컬럼 {col(c)} — 표시 여부가 AS-IS 와 다릅니다",
                    asis=f"Division {d} 기준으로 이 컬럼은 기본 표시 컬럼입니다(AS-IS 컬럼 설정 '{el.group(3)}').", tobe=tobe, why=why, live=_live_cols([c]))
    if miss or add:
        ms = [x.strip() for x in miss.group(1).split(',')] if miss else []; ad = [x.strip() for x in add.group(1).split(',')] if add else []
        parts = []
        if ms: parts.append(f"AS-IS 에서 보이는 컬럼 {len(ms)}개가 TO-BE 화면에 없습니다: {', '.join(col(x) for x in ms)}")
        if ad: parts.append(f"AS-IS 에 없는 컬럼 {len(ad)}개가 TO-BE 화면에 더 보입니다: {', '.join(col(x) for x in ad)}")
        return dict(title='그리드 컬럼 구성 — ' + ' / '.join(parts), asis=f"Division {div or '?'} 기준 컬럼 설정에서 " + (f"{', '.join(col(x) for x in ms)} 은(는) 화면에 보이는 컬럼입니다." if ms else '해당 컬럼이 없습니다.'),
                    tobe='같은 조건으로 화면을 열었을 때 ' + (f"{', '.join(col(x) for x in ms)} 이(가) 그리드에 없습니다." if ms else '') + (f" {', '.join(col(x) for x in ad)} 이(가) 추가로 보입니다." if ad else ''),
                    why='컬럼을 보이게/숨기게 하는 설정(컬럼 메타) 또는 화면의 컬럼 구성이 AS-IS 와 다릅니다.', live=_live_cols(ms + ad))
    return None


def _d1(r, ev):
    ms = re.findall(r'(신규행|기존행) r(\d+) ([A-Z0-9_]+) 편집=(true|false)(?: \(AS-IS 편집 (가능|불가)\))?', ev)
    hit = [m for m in ms if m[4]]
    if not hit: return None
    kind, _, c, tb, asis = hit[0]; where = '새로 추가한 행' if kind == '신규행' else '조회된 기존 행'
    lv = ''
    if _S['live'] and _S['live']['cols'].get(c.upper()):
        x = _S['live']['cols'][c.upper()][0]; lv = f"{_S['live']['at']} 실행 기준 — {col(c)} 컬럼의 잠금 설정: {'잠김' if x['locked'] else '잠기지 않음'}(컬럼 단위 값 · 행별 잠금은 이 기록에 없음)"
    return dict(title=f"{where}의 {col(c)} 칸 — AS-IS 는 입력할 수 {'있는데' if asis == '가능' else '없는데'} TO-BE 는 입력할 수 {'없습니다' if tb == 'false' else '있습니다'}",
                asis=f"{where}에서 이 칸은 입력 {'가능' if asis == '가능' else '불가(잠김)'}합니다.", tobe=f"{where}에서 이 칸이 {'잠겨 있어 입력할 수 없습니다' if tb == 'false' else '열려 있어 입력할 수 있습니다'}.",
                why='칸의 입력 가능/잠금 상태가 AS-IS 와 반대입니다.', live=lv)


def _g6(r, ev):
    if '↔' not in ev: return None
    a, b = [x.strip() for x in ev.split('↔', 1)]; name = _name(r)
    a2 = re.sub(r'^AS-IS\s*', '', a); b2 = re.sub(r'^TO-BE\s*', '', b); b2 = re.sub(r'\s*불일치$', '', b2)
    b2 = re.sub(r"^초기 (?:표시 )?'([^']+)'$", r"화면을 열면 처음부터 '\1' 이(가) 선택(입력)되어 있습니다", b2); a2 = re.sub(r"^초기값 코드 '([^']+)'", r"처음 값은 '\1' 입니다", a2)
    same_empty = bool(re.search(r"초기값 코드 ''", a)) and bool(re.search(r"초기 표시 ''", b))
    d = dict(title=f"조회조건 {name} — 화면을 처음 열었을 때의 값이 AS-IS 와 다릅니다", asis=soft(a2).replace('선택 없음 = 전체', '아무것도 선택하지 않은 상태 = 전체 조회') + '.', tobe=soft(b2) + '.', why='화면을 열자마자 들어 있는 조회조건 값이 서로 다릅니다.')
    if same_empty:
        d['title'] = f"조회조건 {name} — 처음 값 비교 결과가 '다름' 으로 나왔지만, 기록된 두 값은 모두 빈 값입니다"
        d['why'] = "AS-IS 도 빈 값, TO-BE 도 빈 값으로 기록됐습니다. 검사기가 AS-IS 값의 화면 표시 이름을 찾지 못했다고 적혀 있어(라벨 미확인), 실제 차이가 아니라 판정 오류일 수 있습니다. 화면에서 두 값이 같은지 확인해 주세요."
    return d


def _h5(r, ev):
    its = re.findall(r"메타 SHEET_COLUMNS ([^|'—]+?)\.([A-Z0-9_]+) '([^']*)'", ev)
    if 'CR-092' in ev or 'Valid→Active' in (r.get('target') or ''):
        where = ' / '.join(f"시트 {s.strip()} 의 {col(c)} = '{v}'" for s, c, v in its) or soft(ev.split(' — ')[0])
        return dict(title=f"컬럼 이름 'Valid' — TO-BE 에서 'Active' 로 바꾸기로 한 이름이 아직 'Valid' 로 남아 있습니다({len(its) or '?'}곳)", asis="이 컬럼의 이름은 'Valid' 입니다.",
                    tobe=f"아직 'Valid' 로 표시됩니다: {where}.", why="SCP·SSP 화면은 'Valid' 를 'Active' 로 바꾸는 것이 확정 규칙(CR-092)입니다. AS-IS 와 같아서가 아니라, 바꾸기로 한 것이 안 바뀌어서 오류입니다. 컬럼 설정(컬럼 메타)의 이름을 'Active' 로 바꾸면 됩니다.")
    return None


def _a10(r, ev):
    m = re.search(r'그리드 (\d+)행', ev); auto = '기대 자동 조회' in ev; src = re.search(r'AS-IS 로드 중 조회 호출: ([A-Za-z_]+:\d+ [A-Za-z_]+)', ev)
    if not m: return None
    if auto:
        return dict(title='화면 열기 — AS-IS 는 화면을 열면 자동으로 조회되는데 TO-BE 는 조회되지 않습니다', asis='화면이 열리면서 조회가 자동으로 실행되어 그리드에 데이터가 보입니다' + (f"(소스 {soft(src.group(1), 60)})" if src else '') + '.',
                    tobe=f"화면을 연 직후 그리드가 {m.group(1)}행입니다(조회 버튼을 누르기 전).", why='처음 열었을 때 그리드에 데이터가 채워져 있어야 하는데 비어 있습니다.')
    return dict(title='화면 열기 — 조회 전 그리드의 처음 모습이 AS-IS 와 다릅니다', asis=soft(r.get('expected')), tobe=soft(ev), why='')


def _i2(r, ev):
    m = re.search(r"'_' 폴백 노출: (.+)$", ev)
    if not m: return None
    w = [x.strip() for x in re.split(r'[,·]', m.group(1)) if x.strip()]
    return dict(title=f"화면 문구 — 번역되지 않은 임시 문구가 그대로 보입니다: {', '.join(repr(x) for x in w[:6])}", asis='(AS-IS 와의 비교가 아니라 TO-BE 다국어 규칙 검사입니다.)',
                tobe=f"조회·행 추가 뒤 화면에 {', '.join(repr(x) for x in w[:6])} 가 보입니다. 밑줄(_)로 시작하는 문구는 다국어 사전에 등록되지 않았을 때 나오는 임시 표시입니다.", why='이 문구를 다국어 사전(메시지·라벨)에 등록해야 합니다.')


_K3 = {'hide': '컬럼 숨기기(Hide Column)', 'copy': '복사(Ctrl+C·우클릭 Copy)', 'ctrl': 'Ctrl+클릭 여러 칸 선택', 'hdr': '머리글 클릭으로 열 전체 선택', 'paste': '붙여넣기', 'key': '단축키'}


def _k3(r, ev):
    seg = re.findall(r'(?:^|\| )\s*(\w+) (PASS|FAIL|NA|ERROR): ([^|]*)', ev)
    bad = [(k, d) for k, s, d in seg if s == 'FAIL']
    if not bad: return None
    okn = [_K3.get(k, k) for k, s, d in seg if s == 'PASS']
    return dict(title='그리드 공통 기능 — ' + ', '.join(_K3.get(k, k) for k, _ in bad) + ' 이(가) 동작하지 않습니다', asis='(AS-IS 와의 비교가 아니라 TO-BE 그리드 공통 기능 규칙 검사입니다.)',
                tobe=' / '.join(f"{_K3.get(k, k)}: {soft(d.split(' · 미포함')[0], 150)}" for k, d in bad) + '.', why=('함께 시험한 ' + ', '.join(okn) + ' 은(는) 정상입니다. ' if okn else '') + '그리드 공통 컴포넌트의 기능이라 화면 한 곳이 아니라 공통 쪽 확인이 필요합니다.')


def _j4(r, ev):
    t = r.get('target') or ''; m = re.search(r'메뉴 트리 ([^/]+)/([^/]+)/(.+)$', t); e = re.search(r'기대 그룹 (\d+)개 중 메뉴 권한 (\d+)개 → (노출|미노출) · 실제 트리에 (없음|있음)', ev)
    if not (m and e): return None
    want = e.group(3) == '노출'; got = e.group(4) == '있음'
    return dict(title=f"메뉴 권한 — 권한 그룹 '{m.group(3).strip()}'(Division {m.group(2)}) 사용자의 메뉴에 이 화면이 {'보여야 하는데 보이지 않습니다' if want and not got else '보이지 않아야 하는데 보입니다'}",
                asis=f"이 사용자가 속한 권한 그룹 {e.group(1)}개 중 {e.group(2)}개에 이 화면의 메뉴 권한이 있습니다(권한 그룹-메뉴 배정 기준). 따라서 메뉴에 {'보여야' if want else '보이지 않아야'} 합니다.",
                tobe=f"로그인한 뒤 메뉴 트리에 이 화면이 {'있습니다' if got else '없습니다'}.", why='화면 자체가 아니라 메뉴가 안 보이는 문제입니다. 상위 메뉴 그룹에 권한 배정이 빠져 있거나 메뉴 위치가 바뀌었는지 확인이 필요합니다.')


def _c2(r, ev):
    m = re.search(r'신규행 ([A-Z0-9_]+) 콤보 후보 없음(?: — (.*))?$', ev)
    if not m: return None
    return dict(title=f"새로 추가한 행의 {col(m.group(1))} 칸 — 고를 수 있는 목록이 비어 있습니다", asis='새 행에서 이 칸을 누르면 고를 수 있는 목록이 나옵니다.', tobe='새 행에서 이 칸의 목록이 비어 있어 값을 고를 수 없습니다.',
                why=soft(m.group(2) or '', 160))


def _e3(r, ev):
    m = re.search(r'기대 메타 필수 (\d+)개 · 실제 표시 (\d+)개(?:.*?표시 누락 ([^·]+))?', ev)
    if not m: return None
    miss = (m.group(3) or '').strip()
    return dict(title='필수 입력 표시(*) — 필수 컬럼 일부에 필수 표시가 보이지 않습니다' + (f": {miss}" if miss else ''), asis=f"컬럼 설정상 필수 컬럼은 {m.group(1)}개입니다.", tobe=f"화면에서 필수 표시(*)가 붙은 컬럼은 {m.group(2)}개입니다." + (f" 빠진 컬럼: {miss}." if miss else ''),
                why='필수인데 표시가 없으면 사용자가 빈 칸으로 저장을 시도하게 됩니다.')


def _a1(r, ev):
    m = re.match(r'^골든 비교 케이스 없음\(([A-Z0-9_.]+)', ev)
    if m:
        return dict(title=f"조회·저장 프로그램 {m.group(1)} — AS-IS 와 결과를 비교하지 못했습니다(오류로 확인된 것이 아닙니다)", asis='(비교하지 못함)', tobe='(비교하지 못함)',
                    why='같은 조건으로 AS-IS 와 TO-BE 를 각각 실행해 결과 건수를 맞춰 보는 검사인데, 이 프로그램은 비교에 쓸 조건(화면이 실제로 보내는 값)이 준비되어 있지 않아 실행하지 못했습니다. 화면에서 이 기능을 한 번 실행한 기록이 생기면 비교할 수 있습니다.')
    return None


def _agg(r, ev):
    m = re.match(r'^(행 집계|진입점 집계)\s*—\s*(?:대조표\s*)?(.+?)\s*의\s*(\S+)\s*(\d+)요소:\s*(.*?)(?: · FAIL 요소: (.*))?$', ev)
    if m:
        first = (m.group(6) or '').split('; ')[0]; first = re.sub(r'^.*? — ', '', first, count=1) if ' — 실측' in first or ' — 골든' in first else first
        sub = build_core(dict(r, target=(m.group(6) or '').split(' — ')[0].strip(), evidence=first, _noagg=True)) if first else None
        return dict(title=f"묶음 요약 — AS-IS 기능 '{soft(m.group(2).strip(chr(39) + ' '), 60)}' 에 딸린 세부 검사 {m.group(4)}건을 묶은 줄입니다(새로운 오류가 아닙니다)", asis='', tobe='',
                    why='같은 내용이 세부 항목 줄에 따로 있습니다. 이 줄만 따로 조치할 것은 없습니다.' + (f" 묶인 내용: {sub['title']}" if sub and sub.get('title') else ''))
    m = re.match(r'^진입점 집계\s*(\d+)검사\s*—\s*(.*)$', ev)
    if m:
        return dict(title=f"묶음 요약 — AS-IS 소스의 한 메서드({soft(r.get('target'), 60)})에 딸린 세부 검사 {m.group(1)}건을 묶은 줄입니다", asis='', tobe='', why='세부 결과: ' + soft(m.group(2)).replace('FAIL', '다름').replace('ERROR', '검사 못 함').replace('NOT_RUN', '아직 검사 안 함').replace('NA', '대상 아님').replace('PASS', '같음') + '. 조치는 세부 항목 줄에서 합니다.')
    return None


def _name(r):
    t = (r.get('target') or '').strip(); ps = [p.strip() for p in t.split('/') if p.strip()]
    nice = [p for p in ps if not re.match(r'^(clb|txt|cbo|rgrp|lci|dte|chk|spd|usr)[A-Z]', p)]
    return "'" + (nice[0] if nice else (ps[-1] if ps else t))[:50] + "'"


BUILDERS = {'A5': _a5, 'D1': _d1, 'G6': _g6, 'H5': _h5, 'A10': _a10, 'I2': _i2, 'K3': _k3, 'J4': _j4, 'C2': _c2, 'E3': _e3, 'A1': _a1}


def build_core(r):
    ev, notes = _prefix(r.get('evidence')); rule = r.get('rule_id') or ''
    d = None
    if not r.get('_noagg'):
        try: d = _agg(r, ev)
        except Exception: d = None
    if d is None and rule in BUILDERS:
        try: d = BUILDERS[rule](r, ev)
        except Exception: d = None
    if d is None and '↔' in ev:  # 증거가 'AS-IS … ↔ TO-BE …' 꼴이면 그대로 둘로 나눈다
        a, b = [x.strip() for x in ev.split('↔', 1)]
        d = dict(title='', asis=soft(re.sub(r'^AS-IS\s*', '', a)), tobe=soft(re.sub(r'^TO-BE\s*', '', b)), why='')
    if d is None: d = dict(title='', asis='', tobe='', why='', raw=soft(ev, 420))
    d['notes'] = notes
    return d


def build(r, short, repro='', same='', mean=''):
    """조치 필요·판정 필요 행의 설명. short = 종전 한 줄 설명(제목을 못 만들 때 대신 쓴다)"""
    res = r.get('result') or ''
    if res not in ('FAIL', '판정필요'): return short + repro + same
    d = build_core(r)
    head = '[오류]' if res == 'FAIL' else '[확인 필요]'
    title = d.get('title') or ((mean + (' — AS-IS 와 다르게 나왔습니다' if res == 'FAIL' else ' — 기계가 결론을 내지 못했습니다')) if mean else (soft(re.sub(r"^\[[^\]]*\]\s*", '', r.get('target') or ''), 80) + (' — AS-IS 와 다르게 나왔습니다' if res == 'FAIL' else ' — 기계가 결론을 내지 못했습니다')) if re.match(r'^(사람 확인 필요|[A-Z]+\d*: )', short or '') else soft(short, 200))
    out = [f"{head} {title}"]
    if d.get('asis'): out.append('· AS-IS : ' + d['asis'])
    if d.get('tobe'): out.append('· TO-BE : ' + d['tobe'])
    why = ' '.join(x for x in [d.get('why') or ''] + (d.get('notes') or []) if x)
    if why: out.append('· 설명 : ' + why)
    if d.get('raw'): out.append('· 측정 기록 : ' + d['raw'])
    if d.get('live'): out.append('· AS-IS 실행 확인 : ' + d['live'])
    elif res in ('FAIL', '판정필요') and not _S['live'] and not d.get('title', '').startswith('묶음 요약'): out.append('· AS-IS 실행 확인 : 이 화면은 AS-IS 를 실제로 띄워 본 기록이 아직 없습니다.')
    ref = []
    if same: ref.append(re.sub(r'^\s*\(같은 내용 (\d+)건: (.*)\)\s*$', r'같은 문제가 \1곳에서 나왔습니다(\2)', same.strip()))
    if '재현 2회' in repro: ref.append('직전 실행에서도 같은 결과였습니다(2회 연속).')
    elif '1회 실측' in repro: ref.append('이번 실행에서 처음 나온 결과입니다. 다시 실행해 같은 결과가 나오는지 확인이 필요합니다.')
    if ref: out.append('· 참고 : ' + ' '.join(ref))
    return '\n'.join(out)
