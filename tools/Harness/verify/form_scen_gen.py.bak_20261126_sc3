"""
import csv, json, os, re, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, '..', '..', '..'))
FACTS = os.path.join(ROOT, 'Doc', 'asisfacts', 'screens')
MSGCSV = os.path.join(ROOT, 'Doc', 'asisfacts', 'db', 'meta', 'dbo.TB_FX_MessageInfo.csv')
SRC = os.path.join(ROOT, 'GSCM')
csv.field_size_limit(10 ** 9)

RX_GRID = re.compile(r'\b(si\w*|spd\w*|sprd\w*|fpSpread\w*)\.(Get(Text|Value|Cell)\w*|ActiveSheet|Sheets)\b|\.Sheets\[\d+\]\.Cells\[|GetChanged|GetSave\w*Data|GetModified|ActiveSheet\.', re.I)
CUR = {'file': '', 'line': 0}   # build 가 메시지마다 채움 — 같은 메서드 이름이 여러 파일(화면 변형)에 있을 때 그 메시지 파일의 원문을 읽게
RX_DML = re.compile(r'\b(INSERT|UPDATE|DELETE|MERGE):([A-Z0-9_\.]+)', re.I)
RX_RESP = re.compile(r'\bresponse\b|\.DataSet\b|Tables\s*\[|Rows\s*\[\s*0\s*\]\s*\[|ExecuteDataSet')
RX_NOSAVE_T = re.compile(r'^(dbo\.)?(SCM_SYS_LOG|SCM_MST_TITLESET|SCM_ADM_DB_SCRIPT|TB_FX_)', re.I)
RX_NOSAVE_M = re.compile(r'^(Find|Get|Search|Select|Init|Load|Set\w*Title|\w*TitleSet)', re.I)
RX_NOSAVE_SP = re.compile(r'_(GET|SEARCH|FIND|SELECT|SEL|LIST)(_|\b)', re.I)
RX_ME = re.compile(r'UserInfoContext\.Current\.UserId|base\.UserInfo\.UserId|UserInfo\.UserId')
PREFIX = re.compile(r'^(txt|clb|drp|dtp|cbo|cmb|chk|rdo|num|mcb|lkp|usr|edt|lbl)(?=[A-Z])')
# 2026-11-26 보류 해소 2차: 응답을 받는 문장(변수 대입 원문) · 조건 안 응답 판정 · 실패 방향 · 권한 검사
RX_RESP_STMT = re.compile(r'FoxDataClient|ExecuteDataSet|ExecuteNonQuery|SaveDataTable|ExcuteProcedure|DataService\.|\bclient\.\w+\(|\.Tables\[|Task\.Factory|\bawait\b|PostAsync|ReadAsStringAsync|GetStringAsync|GetAsync|SendAsync|HttpClient|WebClient|DownloadString|\.DataSet\b|\bresponse\b')
RX_RESP_COND = re.compile(r'\bt\.Success\b|\.Good\(\)|\btran\w*\.Success\b|result_code|err_code')
RX_FAIL = re.compile(r'!=|!\s*[\w(]|==\s*false|Count\s*==\s*0|IsNullOr|==\s*null|CheckDataEmpty|Contains\("error"\)', re.I)
RX_AUTH = re.compile(r'SecurityContext\.Can(Update|Save|Insert|Delete|Read)|\bCan(Update|Save|Insert|Delete)\b')
RX_CONFIRM = re.compile(r'GMessageBox\(\s*"(MSG\d+)"[^;]*?\)\s*(==|!=)\s*DialogResult\.(\w+)')
RX_WRAP = re.compile(r'^(?:int\.Parse|long\.Parse|decimal\.Parse|Convert\.To\w+|DateTime\.Parse|DateTime\.ParseExact|ScpUtils\.ConvertInt)\((.*)\)$', re.S)


def rd(p):
    if not os.path.exists(p):
        return []
    with open(p, encoding='utf-8-sig', newline='') as f:
        return list(csv.DictReader(f))


def atoms(guard):
    return [s.strip() for s in (guard or '').split('▸') if s.strip()]


def inner(atom):
    """'if (X)' · 'else of (X)' → ('if'|'else', X)"""
    m = re.match(r'^(if|else of|else if)\s*\((.*)\)\s*$', atom.strip(), re.S)
    if not m:
        return ('', atom.strip())
    return ('else' if m.group(1) == 'else of' else 'if', m.group(2).strip())


def strip_par(t):
    t = t.strip()
    while t.startswith('(') and t.endswith(')'):
        d = 0; ok = True
        for k, ch in enumerate(t):
            d += ch == '('; d -= ch == ')'
            if d == 0 and k < len(t) - 1:
                ok = False; break
        if not ok:
            break
        t = t[1:-1].strip()
    return t


def exclusive(prior, cur):
    """앞선 메시지 가드와 이번 가드가 같은 조건의 if / else 갈래로 갈리면 True(앞선 검사는 이번 경로에서 실행되지 않음)"""
    for a, b in zip(prior, cur):
        if a == b:
            continue
        ka, ca = inner(a); kb, cb = inner(b)
        return ca == cb and {ka, kb} == {'if', 'else'}
    return False


def ctl_name(name):
    base = PREFIX.sub('', name)
    return re.sub(r'[^A-Za-z0-9]', '', base).upper() or name.upper()


class Screen:
    def __init__(self, asis):
        d = os.path.join(FACTS, asis)
        self.asis = asis
        self.acts = rd(os.path.join(d, 'actions.csv'))
        self.entries = rd(os.path.join(d, 'actions_entries.csv'))
        self.events = rd(os.path.join(d, 'events.csv'))
        self.eps = rd(os.path.join(d, 'endpoints.csv'))
        self.props = rd(os.path.join(d, 'props.csv'))
        self.ctls = {c['name']: c for c in rd(os.path.join(d, 'controls.csv'))}
        self.by_meth = {}
        for a in self.acts:
            self.by_meth.setdefault(a['method'], []).append(a)
        self._src = {}
        self.labels = self._labels()

    # ── 원문 ──
    def src_lines(self, rel):
        if rel not in self._src:
            p = os.path.join(SRC, rel.replace('\\', os.sep))
            try:
                with open(p, encoding='utf-8-sig', errors='replace') as f:
                    self._src[rel] = f.read().splitlines()
            except OSError:
                self._src[rel] = []
        return self._src[rel]

    def assigns(self, meth):
        """메서드 원문 범위의 '변수 = 식;' → {변수: 식}"""
        rows = self.by_meth.get(meth, [])
        if not rows:
            return {}
        rel = rows[0]['file']; lines = self.src_lines(rel)
        lo = min(int(r['line']) for r in rows) - 8; hi = max(int(r['line']) for r in rows)
        txt = '\n'.join(lines[max(lo - 1, 0):hi])
        out = {}
        for m in re.finditer(r'(?:\b(?:string|var|int|bool|DateTime|decimal|double|long)\s+)?\b([A-Za-z_]\w*)\s*=\s*(?!=)([^;]+);', txt):
            out.setdefault(m.group(1), m.group(2).strip())
        return out

    # ── 라벨 ──
    def _labels(self):
        item_text, item_ctl = {}, {}
        for p in self.props:
            if p['prop'] == 'Text':
                v = p['value'].strip()
                if v.startswith('"') and v.endswith('"'):
                    item_text[p['target']] = v[1:-1]
            if p['prop'] == 'Control':
                m = re.match(r'this\.(\w+)$', p['value'].strip())
                if m:
                    item_ctl[p['target']] = m.group(1)
        out = {}
        for it, c in item_ctl.items():
            if it in item_text and item_text[it] and not item_text[it].startswith(it):
                out[c] = {'label': item_text[it].replace('*', '').strip(), 'src': f'{it}.Text', 'fuzzy': False}
        return out

    def label(self, ctl):
        if ctl in self.labels:
            return self.labels[ctl]
        base = PREFIX.sub('', ctl)
        return {'label': re.sub(r'(?<=[a-z])(?=[A-Z])', ' ', base), 'src': f'컨트롤 이름 {ctl}', 'fuzzy': True}

    def ctl_kind(self, ctl):
        t = (self.ctls.get(ctl, {}).get('type') or '')
        if re.search(r'CheckedListBox|CheckedComboBox|MultiCheck', t):
            return 'multi'
        if re.search(r'DateRange|Period|DateEditRange', t) or ctl.startswith('drp'):
            return 'period'
        if re.search(r'Combo|LookUp', t):
            # 2026-11-26: UsrCombo 를 CString.GetCheckedListValue(dt, X.ControlValues) 로 읽으면 다중 선택 콤보(DMF0042 clbDivision)
            if any(re.search(r'GetCheckedListValue\(\s*\w+\s*,\s*%s\.ControlValues' % re.escape(ctl), ln) for rel in {a['file'] for a in self.acts} for ln in self.src_lines(rel)):
                return 'multi'
            return 'combo'
        if re.search(r'DateEdit|DateTimePicker|UsrDate(?!Range)|Calendar', t) or re.match(r'^(dtp|dp)[A-Z]', ctl):
            return 'date'
        if re.search(r'Text|Editor|Edit\b|MemoEdit', t):
            return 'text'
        return ''

    # ── 단추 사슬 ──
    def save_members(self):
        out = {}
        for e in self.eps:
            # 로그·화면 개인 설정(타이틀셋·프레임워크 TB_FX_) 표와 조회 메서드·조회 SP 는 저장으로 보지 않음(2026-11-26 DMF0044 FindData 타이틀셋 저장 오탐)
            if RX_NOSAVE_M.search(e['member']) or RX_NOSAVE_SP.search(e.get('sp_or_sql') or ''):
                continue
            tabs = [t for k, t in RX_DML.findall(e.get('objects') or '') if not RX_NOSAVE_T.search(t)]
            if tabs:
                out.setdefault(e['member'], set()).update(tabs)
        return out

    def chains(self):
        """단추 Click 처리 → [(method, order_key, call_args)]"""
        res = {}
        btns = [ev for ev in self.events if ev['event'] == 'Click' and ev['op'] == '+=']
        for ev in btns:
            ent = f"{ev['target']}.Click"
            rows = [r for r in self.entries if r['entry'] == ent]
            if not rows:
                continue
            meths = []
            for r in rows:
                path = r['path'].split(' > ')
                # 호출 줄 사슬: 경로 각 단계의 call_line 을 찾아 키로 쓴다
                key = []
                for k in range(1, len(path)):
                    sub = ' > '.join(path[:k + 1])
                    hit = next((q for q in rows if q['path'] == sub), None)
                    key.append(int(hit['call_line']) if hit and hit['call_line'].isdigit() else 0)
                meths.append((r['method'], tuple(key), r))
            res[re.sub(r'^this\.', '', ev['target'])] = {'handler': ev['handler'], 'meths': meths}
        return res


def msg_master():
    out = {}
    for r in rd(MSGCSV):
        out[r['MessageID']] = r
    return out


def meth_params(sc, meth):
    """메서드 선언 원문의 인자 이름 목록"""
    rows = sc.by_meth.get(meth, [])
    if not rows:
        return []
    sig = next((ln for ln in sc.src_lines(rows[0]['file']) if re.search(r'\b%s\s*\(' % re.escape(meth), ln) and re.search(r'\b(private|public|protected|internal)\b', ln)), '')
    return re.findall(r'\b[\w<>\[\]]+\s+(\w+)\s*(?=,|\))', sig.split('(', 1)[1]) if '(' in sig else []


def method_body(sc, name, n=40):
    """화면 원문에서 메서드 선언부터 n 줄(접근 한정자 있는 선언만)"""
    for rel in sorted({a['file'] for a in sc.acts}):
        ls = sc.src_lines(rel)
        for i, ln in enumerate(ls):
            if re.search(r'\b(private|public|protected|internal)\b[^=;(]*\b%s\s*\(' % re.escape(name), ln):
                return '\n'.join(ls[i:i + n])
    return ''


def traced_resp(sc, meth, ident, line, depth=0, chain_meths=()):
    """변수 값이 서버 응답에서 오는가 — 메시지 앞 대입 문장을 3단계까지 따라가고, 메서드 인자면 호출부 인자 식을 따라감"""
    if depth > 3:
        return False
    ln, stmt = stmt_before(sc, meth, ident, line)
    if stmt:
        rhs = stmt.split('=', 1)[1] if '=' in stmt else stmt
        if RX_RESP_STMT.search(rhs):
            return True
        # 2026-11-26: 화면 메서드 호출 결과(obj = CallFileList(...))면 그 메서드 본문이 서버·외부 호출을 하는가
        for fn in re.findall(r'\b([A-Za-z_]\w*)\s*\(', rhs):
            if fn not in ('ToString', 'Parse', 'Replace', 'Trim', 'Substring') and RX_RESP_STMT.search(method_body(sc, fn)):
                return True
        for v in set(re.findall(r'\b([A-Za-z_]\w*)\b', rhs)) - {ident}:
            if v in sc.ctls or v in ('string', 'int', 'var', 'bool', 'new', 'this', 'base', 'null', 'true', 'false'):
                continue
            if traced_resp(sc, meth, v, ln, depth + 1, chain_meths):
                return True
        return False
    ps = meth_params(sc, meth)
    if ident in ps:
        ix = ps.index(ident)
        for cm in chain_meths:
            for a in sc.by_meth.get(cm, []):
                if a['kind'] == 'CALL_LOCAL' and re.sub(r'^this\.', '', a['target']) == meth:
                    v = a['value'].strip()
                    args = [x.strip() for x in v[1:-1].split(',')] if v.startswith('(') else []
                    if ix < len(args) and (RX_RESP_STMT.search(args[ix]) or any(traced_resp(sc, cm, w, int(a['line']), depth + 1, chain_meths) for w in re.findall(r'\b([A-Za-z_]\w*)\b', args[ix]) if w not in sc.ctls)):
                        return True
    return False


def resp_kind(sc, meth, cond, savem, chain_meths, line=0):
    """조건이 서버 응답을 읽는가 → 'save' | 'lookup' | ''"""
    names = set(re.findall(r'\b([A-Za-z_]\w*)\b', cond))
    hit = bool(RX_RESP.search(cond)) or bool(RX_RESP_COND.search(cond))
    if not hit:
        # 조건 변수가 응답 갈래 안에서 대입되는가(bolSuessceChk 등)
        for a in sc.by_meth.get(meth, []):
            if a['kind'] in ('LOCAL', 'FLAG') and a['target'] in names and a['value'] and RX_RESP.search(a['guard'] or ''):
                hit = True; break
    if not hit and line:
        # 2026-11-26: 조건 변수 값을 원문 대입 문장으로 따라가 응답이면(sResultMsg, iCount, specialty ← JObject.Parse(obj) ← 업로드 응답)
        hit = any(traced_resp(sc, meth, v, line, 0, tuple(chain_meths)) for v in names if v not in sc.ctls and not re.match(r'^(string|int|null|true|false|Count|Rows|Tables|ToString|Equals|Contains)$', v))
    if not hit:
        return ''
    return 'save' if meth in savem else 'lookup'


def resp_success(ats):
    """응답을 읽는 가드 원자들이 모두 성공 쪽이면 True(실패 표현 != · ! · == false · Count == 0 · IsNullOr · == null 을 else 와 합쳐 판정)"""
    ok = True
    for br, c in ats:
        if not c or c.startswith('for ('):
            continue
        s = not RX_FAIL.search(c)
        ok = ok and (s if br == 'if' else not s)
    return ok


def unwrap(expr):
    e = strip_par(expr.strip())
    for _ in range(4):
        e = re.sub(r'\.(?:ToString|Trim|Replace|Substring)\([^()]*\)$', '', e)
        m = RX_WRAP.match(e)
        if not m:
            break
        e = split_top(m.group(1), ',')[0] if ',' in m.group(1) else m.group(1).strip()
    return e


def lookup_ctl(sc, handler, meth):
    """조회 메서드 호출 인자의 칸 → [ctl]"""
    for a in sc.by_meth.get(handler, []):
        if a['kind'] == 'CALL_LOCAL' and re.sub(r'^this\.', '', a['target']) == meth:
            return re.findall(r'\b([A-Za-z_]\w*)\.(?:Text|EditValue|Value)\b', a['value'])
    return []


def resolve(sc, meth, operand):
    """피연산자 → (ctl, part) part = Text|Text1|Text2|Value1|Value2|''"""
    return _resolve(sc, meth, operand, 0)


def _resolve(sc, meth, operand, depth):
    # 2026-11-26: 감싼 식(int.Parse·Convert.To·DateTime.ParseExact) 풀기 · ControlValues(다중 선택 값, 기간 'a:b') · Split 배열 첨자 · 대입 3단계
    operand = unwrap(operand)
    m = re.match(r'^([A-Za-z_]\w*)\.(Text1|Text2|Value1|Value2|Text|EditValue|ControlValues|SelectedValue)\b', operand)
    if m and m.group(1) in sc.ctls:
        return m.group(1), m.group(2)
    def rhs_of(var):
        """메시지 줄 앞 가장 가까운 대입(같은 파일) → (식, 그 줄 가드) · 없으면 메서드 첫 대입"""
        if CUR['line']:
            ln, st = stmt_before(sc, meth, var, CUR['line'])
            if st and '=' in st:
                g = next((r['guard'] for r in sc.by_meth.get(meth, []) if r['file'] == CUR['file'] and r['line'] == str(ln)), '')
                g = ' ▸ '.join(x for x in atoms(g) if x not in ('try', 'finally') and not x.startswith('for (') and x not in CUR.get('guard', ()))  # 메시지 자기 가드 안 대입은 상태 조건 아님
                return st.split('=', 1)[1].strip().rstrip(';').strip(), g
        return sc.assigns(meth).get(var, ''), ''
    m = re.match(r'^([A-Za-z_]\w*)\[(\d)\]$', operand)
    if m:
        ex, _g = rhs_of(m.group(1))
        s = re.search(r'\b([A-Za-z_]\w*)\.(?:ControlValues|Text)\.Split\(', ex)
        if s and s.group(1) in sc.ctls:
            return s.group(1), ('Text1', 'Text2')[int(m.group(2))] if int(m.group(2)) < 2 else ''
        return '', ''
    if re.match(r'^[A-Za-z_]\w*$', operand) and depth < 3:
        ex, g = rhs_of(operand)
        if not ex:
            return '', ''
        if g and not re.search(r'\b([A-Za-z_]\w*)\.(Text1|Text2|Value1|Value2|Text|EditValue|ControlValues|SelectedValue)\b', ex):
            return '', f'DATA:{operand} 값이 화면 상태 조건({g[:80]}) 아래에서 바뀜'
        m = re.search(r'\b([A-Za-z_]\w*)\.(Text1|Text2|Value1|Value2|Text|EditValue|ControlValues|SelectedValue)\b', ex)
        if m and m.group(1) in sc.ctls:
            return m.group(1), m.group(2)
        u = unwrap(ex)
        if u != ex or re.match(r'^[A-Za-z_]\w*(\[\d\])?$', u):
            return _resolve(sc, meth, u, depth + 1)
    return '', ''


def pattern(sc, meth, br, cond, chain, handler):
    """→ {'trigger': step, 'pass': step, 'ctl': ctl} | {'why': 사유}"""
    c = strip_par(cond)
    parts = [strip_par(x) for x in re.split(r'\|\|', c)]
    # 기간 빈값
    if br == 'if' and len(parts) == 2 and all(re.match(r'^string\.IsNullOr(?:WhiteSpace|Empty)\((.+)\)$', p) for p in parts):
        rs = [resolve(sc, meth, re.match(r'^string\.IsNullOr(?:WhiteSpace|Empty)\((.+)\)$', p).group(1)) for p in parts]
        if rs[0][0] and rs[0][0] == rs[1][0] and sc.ctl_kind(rs[0][0]) == 'period':
            x = rs[0][0]
            return {'ctl': x, 'op': 'period', 'trigger': {'from': '', 'to': ''}, 'pass': {'from': '@TODAY', 'to': '@TODAY'}}
    # 빈값
    m = re.match(r'^string\.IsNullOr(?:WhiteSpace|Empty)\((.+)\)$', c) or re.match(r'^(.+?)(?:\.Trim\(\))?\s*==\s*""$', c) or re.match(r'^(.+?)\.(?:Trim\(\)\.)?Length\s*==\s*0$', c)
    if br == 'if' and m and '||' not in m.group(1) and '&&' not in m.group(1):
        x, part = resolve(sc, meth, m.group(1))
        if x and sc.ctl_kind(x) == 'text':
            return {'ctl': x, 'op': 'text', 'trigger': {'value': ''}, 'pass': {'value': f'@{ctl_name(x)}'}, 'needs': [ctl_name(x)]}
        if x and sc.ctl_kind(x) == 'multi':  # 2026-11-26: CString.GetCheckedListValue(dt, clbX.ControlValues) == "" → 선택 없음
            return {'ctl': x, 'op': 'multi', 'trigger': {'mode': 'none'}, 'pass': {'mode': 'all'}}
        return {'why': f'빈값 검사 대상 {m.group(1)} 의 입력칸을 원문에서 찾지 못함'}
    # 기간 역전 — A > B · DateTime.Compare(A, B) > 0 · A.CompareTo(B) > 0 (A·B = 같은 기간 칸 앞·뒤, 감싼 식·Split 첨자·대입 3단계까지 풀어 봄)
    m = re.match(r'^DateTime\.Compare\((.+)\)\s*>\s*0$', c)
    ab = split_top(m.group(1), ',') if m else None
    if not ab:
        m = re.match(r'^(.+?)\.CompareTo\((.+)\)\s*>\s*0$', c)
        ab = [m.group(1), m.group(2)] if m else None
    if not ab:
        ab = split_top(c, '>') if '>' in c and '>=' not in c and '=>' not in c else None
    if br == 'if' and ab and len(ab) == 2:
        a, b = resolve(sc, meth, ab[0]), resolve(sc, meth, ab[1])
        dat = next((p[1][5:] for p in (a, b) if p[1].startswith('DATA:')), '')
        if dat:
            return {'block': f'기간 비교 값 {dat} — 입력으로 정할 수 없음'}
        if a[0] and a[0] == b[0] and sc.ctl_kind(a[0]) == 'period' and a[1] in ('Text1', 'Value1') and b[1] in ('Text2', 'Value2'):
            return {'ctl': a[0], 'op': 'period', 'trigger': {'from': '@TODAY+1', 'to': '@TODAY'}, 'pass': {'from': '@TODAY', 'to': '@TODAY'}}
        if a[0] and b[0] and a[0] != b[0] and sc.ctl_kind(b[0]) == 'date':
            # 시작 칸(a)과 끝 칸(b)이 따로인 화면(SCP0123 txtProdStart · dpProdEnd): 끝 칸을 시작보다 앞(@TODAY-3650)으로 → 시작 > 끝. 통과값은 화면 기본값 그대로(단계 없음)
            return {'ctl': b[0], 'op': 'date', 'trigger': {'value': '@TODAY-3650'}, 'pass': None,
                    'note': f'시작 {a[0]}.{a[1]} > 끝 {b[0]}.{b[1]} — 끝 칸을 3650일 전으로'}
    # 기간 길이 상한 — X.Value1.AddYears(n) < X.Value2 · X.Value2 > X.Value1.AddYears(n) (AddMonths·AddDays 포함) → 상한 + 1일 넘는 기간
    m = re.match(r'^(\w+)\.(?:Value1|Text1)\.Add(Years|Months|Days)\((\d+)\)\s*<\s*(\w+)\.(?:Value2|Text2)$', c) or \
        re.match(r'^(\w+)\.(?:Value2|Text2)\s*>\s*(\w+)\.(?:Value1|Text1)\.Add(Years|Months|Days)\((\d+)\)$', c)
    if br == 'if' and m:
        g = m.groups()
        x, unit, n = (g[0], g[1], int(g[2])) if len(g) == 4 and g[1] in ('Years', 'Months', 'Days') else (g[1], g[2], int(g[3]))
        if x in sc.ctls and sc.ctl_kind(x) == 'period':
            days = {'Years': 366, 'Months': 31, 'Days': 1}[unit] * n + 1
            return {'ctl': x, 'op': 'period', 'trigger': {'from': '@TODAY', 'to': f'@TODAY+{days}'}, 'pass': {'from': '@TODAY', 'to': '@TODAY'},
                    'note': f'기간 상한 Add{unit}({n}) 보다 긴 {days}일'}
    # 숫자 범위 — V < N · V > N · V <= N · V >= N, V = 입력칸 값(Convert.ToInt32(txtX.Text) 등) → 경계 밖 값
    m = re.match(r'^(\w+)\s*(<=|>=|<|>)\s*(\d+)$', c)
    if br == 'if' and m:
        x, part = resolve(sc, meth, m.group(1))
        if part.startswith('DATA:'):
            return {'block': part[5:]}
        if x and sc.ctl_kind(x) == 'text':
            n = int(m.group(3)); v = {'<': n - 1, '>': n + 1, '<=': n, '>=': n}[m.group(2)]
            return {'ctl': x, 'op': 'text', 'trigger': {'value': str(v)}, 'pass': {'value': f'@{ctl_name(x)}'}, 'needs': [ctl_name(x)],
                    'note': f'{m.group(1)} {m.group(2)} {n} 이 되는 값 {v}'}
    # 선택 없음
    m = re.match(r'^(\w+)\s*==\s*true$', c)
    if br == 'else' and m:
        f = m.group(1); boxes = set()
        for a in sc.by_meth.get(meth, []):
            if a['kind'] in ('LOCAL', 'FLAG') and a['target'] == f and a['value'].strip() == 'true':
                boxes.update(re.findall(r'\b(\w+)\.Items\[\w+\]\.CheckState\s*==\s*CheckState\.Checked', a['guard'] or ''))
        if len(boxes) == 1 and sc.ctl_kind(next(iter(boxes))) == 'multi':
            x = next(iter(boxes))
            return {'ctl': x, 'op': 'multi', 'trigger': {'mode': 'none'}, 'pass': {'mode': 'all'}}
    m = re.match(r'^(\w+)\.CheckedItems\.Count\s*==\s*0$', c)
    if br == 'if' and m and sc.ctl_kind(m.group(1)) == 'multi':
        return {'ctl': m.group(1), 'op': 'multi', 'trigger': {'mode': 'none'}, 'pass': {'mode': 'all'}}
    # 본인 지정
    m = re.match(r'^(\w+)\s*==\s*(.+)$', c)
    if br == 'if' and m and RX_ME.search(m.group(2)):
        v = m.group(1)
        for cm, _k, _r in chain:
            if any(a['kind'] in ('LOCAL', 'FLAG') and a['target'] == v for a in sc.by_meth.get(cm, [])):
                xs = [x for x in lookup_ctl(sc, handler, cm) if sc.ctl_kind(x) == 'text']
                if len(xs) == 1:
                    return {'ctl': xs[0], 'op': 'text', 'trigger': {'value': '@ME'}, 'pass': {'value': f'@{ctl_name(xs[0])}'}, 'needs': [ctl_name(xs[0])],
                            'note': f'{v} = {cm} 조회 결과({xs[0]} 값) · 로그인 계정과 같으면 발생'}
    return {'why': f'조건 해석 패턴 없음: {br} ({c[:120]})'}


