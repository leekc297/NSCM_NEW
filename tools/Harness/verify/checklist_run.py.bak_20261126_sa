import argparse, csv, datetime, json, os, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__)); ROOT = os.path.abspath(os.path.join(HERE, '..', '..', '..'))
csv.field_size_limit(10 ** 8)
WORK = ('엔진', '대조표', '판단', '자동')


def run(args):
    print('$ ' + ' '.join(args[1:]), flush=True)
    return subprocess.call([sys.executable] + args[1:] if args[0] == 'py' else args, cwd=ROOT)


STAGE_OF = (('EG-', 'eg', '팝업·권한 검사기'), ('ES-', 'suite', 'E2E 4종'))


def recheck_plan(mid):
    """2026-11-20 C2: (규칙 목록, 함께 돌 단계 목록, 단계로만 판정되는 규칙, 사유) — 규칙 목록이 비면 전체 실행.
       종전(recheck_rules)은 EG-·ES-·ASIS_DIFF 행이 1행만 있어도 전체로 돌았다(11-20 SCP0005·SCP0028·SSP0014 재점검 3건 모두 전체 · 1단계 96~137분)"""
    p = os.path.join(ROOT, 'Doc', 'verify', mid, 'unverified_triage.csv')
    if not os.path.exists(p):
        return [], [], [], '미검증 분류 결과 없음'
    rows = [r for r in csv.DictReader(open(p, encoding='utf-8-sig')) if r.get('actor') in WORK]
    if not rows:
        return [], [], [], '처리 대상 0행'
    return plan_rows(rows)


def plan_rows(rows):
    """2026-11-25 행 목록 → (규칙, 함께 돌 단계, 단계로만 판정되는 규칙, 사유). recheck_plan 과 row_probe.py 가 같이 씀"""
    stages, names, per_rule = set(), set(), {}
    for r in rows:
        rid = (r.get('rule_id') or '').upper(); st = ''
        if r.get('source') == 'ASIS_DIFF':
            st = 'diff'; names.add('차등 검증')
        for pre, s_, nm in STAGE_OF:
            if (r.get('row_id') or '').startswith(pre):
                st = s_; names.add(nm)
        if st:
            stages.add(st)
        if rid:
            per_rule.setdefault(rid, set()).add(st or 'verify')
    rules = sorted(per_rule)
    stage_rules = sorted(r for r, s in per_rule.items() if 'verify' not in s)
    if not rules:
        return [], [], [], f'처리 대상 {len(rows)}행에 규칙 ID 없음'
    return rules, sorted(stages), stage_rules, f'처리 대상 {len(rows)}행 · 규칙 {len(rules)}개' + (f" · 함께 돌 단계 {', '.join(sorted(names))}" if stages else '')


ES_KIND = __import__('re').compile(r'E2E (authcrud|crud|auth)\b|\b(authcrud|crud|auth)\.spec')


def settle_env(rows, stages, stage_rules):
    """2026-11-25 해소 확인 재측정 환경(run_verify VERIFY_SETTLE): 함께 돌 단계, E2E 4종 종류(ES- 행 증거), 사실 검토 필요(FACT- 행)"""
    kinds = sorted({m.group(1) or m.group(2) for r in rows if (r.get('row_id') or '').startswith('ES-') for m in [ES_KIND.search((r.get('target') or '') + ' ' + (r.get('evidence') or ''))] if m})
    fact = any((r.get('row_id') or '').startswith('FACT-') for r in rows)
    return dict(os.environ, VERIFY_SETTLE='1', VERIFY_DELTA_STAGES=','.join(stages), VERIFY_STAGE_RULES=','.join(stage_rules),
                VERIFY_SUITE_KINDS=','.join(kinds), VERIFY_SETTLE_FACT='1' if fact else '0')


def effect_line(mid, since):
    """2026-11-20 A8: 이번 실행의 AI 지점별 효과(Doc/verify/<ID>/llm_effect.csv)"""
    try:
        rs = [r for r in csv.DictReader(open(os.path.join(ROOT, 'Doc', 'verify', mid, 'llm_effect.csv'), encoding='utf-8-sig')) if (r.get('at') or '') >= since]
    except OSError:
        return ''
    if not rs:
        return ''
    by = {}
    for r in rs:
        a = by.setdefault(r.get('kind') or '', [0, 0, 0, 0])
        for i, k in enumerate(('calls', 'cached', 'applied', 'nochange_calls')):
            try:
                a[i] += int(float(r.get(k) or 0))
            except ValueError:
                pass
    return '[AI 효과] ' + ' · '.join(f'{k} 호출 {v[0]}(기억 {v[1]}) 반영 {v[2]} 무변화 호출 {v[3]}' for k, v in sorted(by.items())) + f' · Doc/verify/{mid}/llm_effect.csv'


def recheck_rules(mid):
    """(규칙 목록, 사유) — 규칙 목록이 비면 전체 실행"""
    p = os.path.join(ROOT, 'Doc', 'verify', mid, 'unverified_triage.csv')
    if not os.path.exists(p):
        return [], '미검증 분류 결과 없음'
    rows = [r for r in csv.DictReader(open(p, encoding='utf-8-sig')) if r.get('actor') in WORK]
    if not rows:
        return [], '처리 대상 0행'
    blk = [r for r in rows if r.get('source') == 'ASIS_DIFF' or (r.get('row_id') or '').startswith(('EG-', 'ES-'))]
    if blk:
        kinds = sorted({'차등 검증' if r.get('source') == 'ASIS_DIFF' else ('팝업·권한 검사기' if r['row_id'].startswith('EG-') else 'E2E 4종') for r in blk})
        return [], f"처리 대상 {len(rows)}행 중 {len(blk)}행이 --only 로 다시 잴 수 없는 단계({', '.join(kinds)})"
    rules = sorted({(r.get('rule_id') or '').upper() for r in rows if r.get('rule_id')})
    return rules, f'처리 대상 {len(rows)}행 · 규칙 {len(rules)}개'


def settle_state(mid, kind, rc):
    """2026-11-25 사용자 '전체에 대해서 미검증을 다 해소한 후에 검증': 해소 확인 재측정 뒤 재검증 진행 가능 여부 → Doc/verify/<ID>/unverified_settle.json
       ready 1 = 처리 대상 0, 또는 남은 행 전부가 처리 대상 행만으로 잴 시험이 없는 행(전체 재측정으로만 잼). 그 밖(풀린 행 0, 재측정 실패, 반복 중) = 0"""
    vd = os.path.join(ROOT, 'Doc', 'verify', mid)
    try:
        j = json.load(open(os.path.join(vd, 'unverified_triage.json'), encoding='utf-8'))
    except (OSError, ValueError):
        j = {}
    act = j.get('actionable')
    try:
        rows = [r for r in csv.DictReader(open(os.path.join(vd, 'unverified_triage.csv'), encoding='utf-8-sig')) if r.get('actor') in WORK]
    except OSError:
        rows = []
    if act == 0:
        ready, why = 1, '처리 대상 0 · 재검증 진행'
    elif act is None:
        ready, why = 0, '분류 결과 없음'
    elif kind == 'fullonly':
        ready, why = 1, f'남은 처리 대상 {act}행 = 처리 대상 행만으로 잴 시험 없음, 전체 재검증으로만 잼 · 재검증 진행'
    elif kind == 'failed':
        ready, why = 0, f'해소 확인 재측정 실패(rc {rc}) · 남은 처리 대상 {act}행'
    elif j.get('stalled'):
        ready, why = 0, f"남은 처리 대상 {act}행 · 직전 처리 대상 중 풀린 행 0(같은 보완으로 더 풀리지 않음)"
    else:
        ready, why = 0, f'남은 처리 대상 {act}행 · 다음 회차 🧪 보완 대상'
    out = {'menu_id': mid, 'at': datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'), 'ready': ready, 'why': why, 'kind': kind, 'actionable': act,
           'continue': j.get('continue'), 'stalled': j.get('stalled'), 'rows': [{k: r.get(k, '') for k in ('row_id', 'rule_id', 'class', 'actor', 'remedy')} for r in rows][:500]}
    os.makedirs(vd, exist_ok=True)
    json.dump(out, open(os.path.join(vd, 'unverified_settle.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
    return out


def wl_refresh(mid):
    """해소 원장 상태를 지금 원장 판정으로 갱신(새 행은 넣지 않음) → (행 목록, 요약)"""
    sys.path.insert(0, HERE)
    import unverified_resolve as U
    rows, meta = U.wl_read(mid)
    if not rows:
        return [], {}
    led = {r.get('row_id'): r for r in csv.DictReader(open(os.path.join(ROOT, 'Doc', 'verify', mid, 'verify_ledger.csv'), encoding='utf-8-sig'))}
    remap = U.id_bridge(mid, list(led.values()))
    for w in rows:
        w['row_id'] = remap(w['row_id']); r = led.get(w['row_id'])
        if w['state'] == 'open' and w['kind'] != 'AI후보' and r is not None and (r.get('result') or '') not in ('ERROR', ''):
            w['state'] = 'closed'; w['closed_by'] = w.get('closed_by') or '원장 판정'; w['result'] = r.get('result') or ''
    return rows, U.wl_write(mid, rows, meta)


def wl_round(mid, max_round=3):
    """2026-11-25 행 단위 해소: 🧪 미검증 보완 회차 끝 점검 → unverified_worklist.json continue(다음 회차 여부).
       계속 = 열린 행 > 0 이고 이번 회차에 닫힌 행 ≥ 1 이고 회차 < max_round. 화면 전체 재측정은 하지 않음"""
    rows, m = wl_refresh(mid)
    if not rows:
        print(f'[INFO] 해소 원장 없음(Doc/verify/{mid}/unverified_worklist.csv) · 반복 끝', flush=True); return 0
    p = os.path.join(ROOT, 'Doc', 'verify', mid, 'unverified_worklist.json'); meta = json.load(open(p, encoding='utf-8'))
    rnd = int(meta.get('round') or 0) + 1; prev = int(meta.get('closed_seen') or 0); prog = meta['closed'] - prev
    cont = 1 if meta['open'] > 0 and prog > 0 and rnd < max_round else 0
    meta.update(round=rnd, closed_seen=meta['closed'], last_progress=prog, **{'continue': cont})
    json.dump(meta, open(p, 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
    why = '열린 행 0' if not meta['open'] else ('이번 회차 닫힌 행 0' if prog <= 0 else (f'회차 상한 {max_round}' if rnd >= max_round else '다음 회차'))
    print(f"[해소 원장] {rnd}회차 끝: 이번 회차 닫힘 {prog} · 열린 행 {meta['open']}(" + ', '.join(f'{k} {v}' for k, v in (meta.get('by_kind') or {}).items()) + f") · AI 후보 열림 {meta.get('open_ai', 0)} · {'계속' if cont else '반복 끝'}({why})", flush=True)
    return 0


def gate(mid):
    """2026-11-25 해소 게이트: 해소 원장(unverified_worklist) 열린 행 0 이면 통과. 원장이 없으면 종전 해소 확인 결과(unverified_settle.json)"""
    rows, m = wl_refresh(mid)
    if rows:
        if not m['open']:
            print(f"[OK] 미검증 해소 게이트 통과: 해소 원장 {m['total']}행 중 열린 행 0 · 닫힘·결정 {m['closed']} · AI 후보 열림 {m.get('open_ai', 0)}(판정 영향 없음, 보완 후보)", flush=True)
            return 0
        op = [w for w in rows if w['state'] == 'open' and w['kind'] not in ('집계', 'AI후보', '다음측정')]
        print(f"[ERROR] 미검증 해소 전: 열린 행 {len(op)} — 행마다 시도 횟수와 닫는 방법", flush=True)
        for w in op[:40]:
            print(f"  - {w['row_id']} {w['rule_id']} · 유형 {w['kind']} · 시도 {w.get('tries') or 0}회 · {w.get('close_by', '')[:80]}", flush=True)
        print(f'@@LINK 📋 해소 원장|{os.path.join(ROOT, "Doc", "verify", mid, "unverified_worklist.csv")}', flush=True)
        return 1
    p = os.path.join(ROOT, 'Doc', 'verify', mid, 'unverified_settle.json')
    try:
        st = json.load(open(p, encoding='utf-8'))
    except (OSError, ValueError):
        print(f'[ERROR] 해소 확인 결과 없음: {os.path.relpath(p, ROOT)} · 미검증 해소 반복이 끝나지 않음', flush=True)
        return 1
    if st.get('ready'):
        print(f"[OK] 미검증 해소 게이트 통과: {st.get('why')} ({st.get('at')})", flush=True)
        return 0
    why = st.get('why') or ''
    if st.get('continue'):
        why += ' · 반복 상한 도달'
    print(f"[ERROR] 미검증 해소 전이라 재검증 안 함: {why} ({st.get('at')})", flush=True)
    by = {}
    for r in st.get('rows') or []:
        by.setdefault((r.get('actor') or '', r.get('class') or ''), []).append(r.get('row_id') or '')
    for (actor, cls), ids in sorted(by.items(), key=lambda x: -len(x[1])):
        print(f"  - 담당 {actor} · 유형 {cls or '미분류'} {len(ids)}행: {', '.join(ids[:8])}{' …' if len(ids) > 8 else ''}", flush=True)
    print(f'@@LINK 📋 남은 처리 대상|{os.path.join(ROOT, "Doc", "verify", mid, "unverified_triage.md")}', flush=True)
    print(f'@@LINK 🧾 결정 목록|{os.path.join(ROOT, "Doc", "verify", mid, "_unverified_decisions.md")}', flush=True)
    return 1


def cl_path(mid):
    return os.path.join(ROOT, 'Doc', 'verify', mid, '_cl_resume.json')


def cl_save(mid, cl):
    cl['updated'] = time.time(); cl['updated_at'] = time.strftime('%Y-%m-%d %H:%M:%S')
    tmp = cl_path(mid) + '.tmp'; os.makedirs(os.path.dirname(tmp), exist_ok=True)
    json.dump(cl, open(tmp, 'w', encoding='utf-8'), ensure_ascii=False, indent=1); os.replace(tmp, cl_path(mid))


def cl_begin(mid, sig, started, want):
    """재개면 지난 기록, 아니면 새 기록(dict)"""
    why = ''
    if want:
        try:
            old = json.load(open(cl_path(mid), encoding='utf-8'))
            try:
                kh = float(os.environ.get('VM_RESUME_KEEP_HOURS') or 24)
            except ValueError:
                kh = 24.0
            if not isinstance(old, dict) or old.get('sig') != sig:
                why = '실행 인자가 다름'
            elif kh > 0 and time.time() - float(old.get('updated') or 0) > kh * 3600:
                why = f"끊긴 뒤 {kh:g}시간 경과(마지막 기록 {old.get('updated_at', '?')})"
            else:
                print(f"[재개] CheckList 실행 이어서, 처음 시작 {old.get('started')}, CheckList 측정 {'끝남' if old.get('rv_done') else '끊김(끊긴 단계부터)'}", flush=True)
                return old
        except FileNotFoundError:
            why = '진행 기록 없음(_cl_resume.json), CheckList 측정은 자체 기록으로 재개 판단'
        except (OSError, ValueError) as e:
            why = f'진행 기록 깨짐({type(e).__name__})'
        print(f'[재개] CheckList 실행 기록 사용 안 함: {why}', flush=True)
    cl = {'v': 1, 'sig': sig, 'started': started, 'rv_done': False}
    cl_save(mid, cl)
    return cl


def rv_done_same_run(mid, cl):
    """CheckList 측정(run_verify)이 이 실행에서 정상으로 끝났는가, 기록 + run_verify.result.json(완료, 이 실행 시작 이후)"""
    if not cl.get('rv_done'):
        return False
    try:
        j = json.load(open(os.path.join(ROOT, 'Doc', 'verify', mid, 'run_verify.result.json'), encoding='utf-8'))
        st = datetime.datetime.strptime(j.get('started') or '', '%Y-%m-%d %H:%M:%S')
        return j.get('state') == 'completed' and st >= datetime.datetime.strptime(cl['started'], '%Y-%m-%d %H:%M:%S')
    except (OSError, ValueError, KeyError, TypeError):
        return False


