def read_csv(p):
    if not os.path.exists(p):
        return []
    with open(p, encoding='utf-8-sig', newline='') as f:
        return list(csv.DictReader(f))


def test_ownership(spec_paths):
    """T61(2026-11-06): 스펙 본문이 실제로 고르는 행 — {(runner, 테스트 제목): {'sources': {...}, 'rules': {...}}} + 키 '_tmpl' = 템플릿 제목 목록.
    test('제목', …) / test(`템플릿`, async …) 부터 다음 test( 전까지에서 `source === 'X'` · `rule_id === 'Y'` 비교를 모은다.
    템플릿 제목(`그리드 컬럼 프로브${…} — …`)은 첫 ${ 앞 고정부 + 마지막 } 뒤 고정부로 맞춘다(own_of)."""
    out = {'_tmpl': []}
    for sp in spec_paths:
        try:
            src = open(sp, encoding='utf-8').read()
        except OSError:
            continue
        runner = 'trace' if '_trace' in os.path.basename(sp) else 'verify'
        heads = [(m.start(), m.end(), m.group(1).replace("\\'", "'"), False) for m in re.finditer(r"\btest\('((?:[^'\\]|\\.)*)'", src)]
        heads += [(m.start(), m.end(), m.group(1), True) for m in re.finditer(r"\btest\(`(.+?)`,\s*async", src)]
        heads.sort()
        for i, (st, en, title, tmpl) in enumerate(heads):
            body = src[en: heads[i + 1][0] if i + 1 < len(heads) else len(src)]
            v = {'sources': set(re.findall(r"\bsource\s*===\s*'([A-Z_]+)'", body)),
                 'rules': set(re.findall(r"\brule_id\s*===\s*'([A-Z][A-Za-z0-9-]*)'", body))}
            if tmpl and '${' in title:
                out['_tmpl'].append((runner, title.split('${')[0], title[title.rfind('}') + 1:], v))
            else:
                out[(runner, title)] = v
    return out


def own_of(own, runner, title):
    """T61: 테스트 제목 → 담당 {'sources','rules'} (없으면 {})"""
    v = own.get((runner, title))
    if v:
        return v
    for r, pre, suf, tv in own.get('_tmpl', []):
        if r == runner and title.startswith(pre) and title.endswith(suf):
            return tv
    return {}


def page_dir(mid):
    for r in read_csv(P('Doc', 'tobefacts', 'screens', '_index.csv')):
        if r['menu_id'].upper() == mid and '/components/' not in r['page_key']:
            feat, *rest = r['page_key'].split('/')
            return P('nscm-fe', 'features', feat, 'src', 'pages', *rest)
    return ''


def fe_sources(pdir):
    out = {}
    for dp, _, fs in os.walk(pdir):
        if 'node_modules' in dp:
            continue
        for f in fs:
            if f.endswith(('.ts', '.tsx')) and not f.endswith(('.test.ts', '.spec.ts')):
                p = os.path.join(dp, f)
                with open(p, encoding='utf-8') as h:
                    out[p] = h.read()
    return out


T_CALL = re.compile(r"""\bt\(\s*['"]([A-Za-z][A-Za-z0-9_]*)['"]\s*(?:,\s*['"]([^'"]*)['"])?""")



def lbl_consts(srcs):
    """페이지 소스의 `export const LBL = { KEY: 'LBL…' }` → {KEY: code}"""
    import re as _re
    out = {}
    for p, s in srcs.items():
        m = _re.search(r'export\s+const\s+LBL\s*=\s*\{(.*?)\}', s, _re.S)
        if m:
            for k, v in _re.findall(r"""([A-Z0-9_]+)\s*:\s*['"]([^'"]+)['"]""", m.group(1)):
                out.setdefault(k, v)
    return out


def label_codes(srcs):
    """화면 소스의 라벨/메시지 코드 전부 → {code: (loc, fallback)} — t('LBL00001','_x') 와 t(LBL.KEY,'_x')·multi(LBL.KEY,'_x',…)(2026-10-28 상수 코드 미인식 교정)"""
    import re as _re
    consts = lbl_consts(srcs); codes = {}
    rx = _re.compile(r"""\b\w+\(\s*(?:['"]([A-Za-z][A-Za-z0-9_]*)['"]|LBL\.([A-Z0-9_]+))\s*(?:,\s*['"]([^'"]*)['"])?""")
    for p, s in srcs.items():
        for i, line in enumerate(s.splitlines(), 1):
            for m in rx.finditer(line):
                code = m.group(1) or consts.get(m.group(2) or '')
                if not code or not _re.match(r'^(LBL|MSG|MNU)\d+$', code):
                    continue
                codes.setdefault(code, (os.path.relpath(p, ROOT).replace('\\', '/') + f':{i}', (m.group(3) or '')))
    return codes


def meta_i1(srcs, use_db):
    """FE t() 코드 → SCM_ADM_MSG_M 언어별 등록 여부"""
    codes = label_codes(srcs)
    if not codes:
        return None, '화면 소스에 라벨/메시지 코드 호출 없음'
    if not use_db:
        return None, f'DB 미조회(--no-db) — 코드 {len(codes)}개'
    from dbconn import connect  # noqa: E402
    have = {}
    with connect('tobe') as cx:
        cur = cx.cursor()
        keys = list(codes)
        for i in range(0, len(keys), 500):
            chunk = keys[i:i + 500]
            binds = ','.join(f':b{j}' for j in range(len(chunk)))
            cur.execute(f"SELECT MSG_ID, LANG_CD FROM SCM_ADM_MSG_M WHERE USE_YN = 'Y' AND MSG_ID IN ({binds})", {f'b{j}': c for j, c in enumerate(chunk)})
            for mid_, lang in cur:
                have.setdefault(mid_, set()).add((lang or '').upper())
    miss = []
    for c, (loc, fb) in sorted(codes.items()):
        lacking = [l for l in ('KO', 'EN', 'CN') if l not in have.get(c, set())]
        if lacking:
            miss.append(f"{c}({'/'.join(lacking)} 없음, fallback '{fb}', {loc})")
    return (not miss), (f"t() 코드 {len(codes)}개 중 미등록 {len(miss)}: " + '; '.join(miss)) if miss else f't() 코드 {len(codes)}개 KO/EN/CN 전부 등록'


def meta_i4(srcs, use_db):
    """I4 중복 채번(2026-10-28) — 화면 t() 코드마다 같은 유형(MSG_TP_CD)·KO·EN 문구(TRIM, 대소문자 구분)가 모두 같은 다른 MSG_ID(USE_YN=Y)가 있는가.
    단위테스트 결함 DM-96(동일 문구는 하나의 ID 만 채번·재사용). 이 화면 코드보다 앞선 ID 가 있으면 재사용 대신 새로 채번한 것 → FAIL,
    이 화면이 가장 앞선 ID 를 쓰면 다른 곳의 중복이라 PASS(근거에 함께 적음). 한계: 메뉴명(MNU)은 화면 t() 에 나오는 코드만 본다"""
    codes = sorted(label_codes(srcs))
    if not codes:
        return None, '화면 소스에 라벨/메시지 코드 호출 없음'
    if not use_db:
        return None, f'DB 미조회(--no-db) — 코드 {len(codes)}개'
    from dbconn import connect  # noqa: E402
    with connect('tobe') as cx:
        cur = cx.cursor()
        cur.execute("""WITH T AS (SELECT MSG_ID, MSG_TP_CD, MAX(CASE WHEN LANG_CD = 'KO' THEN TRIM(MSG_NM) END) KO, MAX(CASE WHEN LANG_CD = 'EN' THEN TRIM(MSG_NM) END) EN
                       FROM SCM_ADM_MSG_M WHERE USE_YN = 'Y' GROUP BY MSG_ID, MSG_TP_CD)
                       SELECT MSG_ID, MSG_TP_CD, KO, EN FROM T WHERE KO IS NOT NULL AND EN IS NOT NULL""")
        grp = {}
        for mid_, tp, ko, en in cur:
            grp.setdefault((tp, ko, en), []).append(mid_)
    twin = {i: sorted(v) for v in grp.values() if len(v) > 1 for i in v}
    bad, other = [], []
    for c in codes:
        if c in twin:
            ids = twin[c]
            (bad if ids[0] != c else other).append(f"{c}↔{'/'.join(x for x in ids if x != c)}")
    if bad:
        return False, f"t() 코드 {len(codes)}개 중 같은 문구의 앞선 코드가 있는데 새로 채번 {len(bad)}: {'; '.join(bad)}" + (f" · (이 화면이 앞선 코드 사용 {len(other)}: {'; '.join(other)})" if other else '')
    return True, f"t() 코드 {len(codes)}개 — 같은 문구 다른 코드 중복 없음" + (f" · 이 화면이 앞선 코드를 쓰는 다른 곳 중복 {len(other)}: {'; '.join(other)}" if other else '')


LBL_CALL = re.compile(r"""\b\w+\(\s*(?:['"]([A-Za-z][A-Za-z0-9_]*)['"]|LBL\.([A-Z0-9_]+))\s*,\s*['"](_?[^'"]*)['"]""")  # 폴백의 '_' 는 선택(2026-10-29 SCP0100 t(LBL.AS, 'A/S'))


def form_labels(srcs):
    """Form 파일의 라벨 호출 순서 → [(code, fallback, loc)].
    인식: t('LBL00001','_Div') · t(LBL.DIVISION,'_Div.') · multi(LBL.PLANT_SITE,'_Plant Site', …) 처럼 1번째 인자가 라벨 코드(문자열 또는 LBL 상수)이고
    2번째 인자가 '_문구' 인 호출 전부(2026-10-28: 'label' 단어가 있는 줄의 t('문자열') 만 보던 탓에 SCP0096 라벨 0건 → G4/H5 전부 허위 FAIL).
    LBL.KEY 는 같은 페이지 소스의 `LBL = { KEY: 'LBL…' }` 로 코드를 푼다(없으면 KEY 그대로)."""
    consts = {}
    for p, s in srcs.items():
        m = re.search(r'export\s+const\s+LBL\s*=\s*\{(.*?)\}', s, re.S)
        if m:
            for k, v in re.findall(r"""([A-Z0-9_]+)\s*:\s*['"]([^'"]+)['"]""", m.group(1)):
                consts.setdefault(k, v)
    out = []
    for p, s in srcs.items():
        if not re.search(r'Form\.tsx$', p):
            continue
        for i, line in enumerate(s.splitlines(), 1):
            if 'LBL' not in line and 'label' not in line:
                continue
            if re.match(r'\s*(//|/?\*)', line):
                continue  # 주석(예: "호출부는 t(LBL.KEY, '_Fallback')")은 라벨이 아님(2026-10-29 SCP0100 'Fallback' 허위 라벨)
            for m in LBL_CALL.finditer(line):
                if not m.group(2) and not (m.group(3) or '').startswith('_'):
                    continue  # 문자열 코드일 때는 '_폴백' 형태만(일반 t('MSG…','문구') 오인 방지)
                code = m.group(1) or consts.get(m.group(2) or '', m.group(2) or '')
                fb = (m.group(3) or '').lstrip('_')
                if not fb or fb.lower() in ('search', 'reset', 'clear', 'input', 'ok', 'close', 'cancel', 'save'):
                    continue  # 버튼 라벨은 조회조건이 아님
                out.append((code, fb, os.path.relpath(p, ROOT).replace('\\', '/') + f':{i}'))
    if len(out) < 3:  # 라벨 문구를 constants 의 조건 정의에 두는 화면(SCP0100 GlobalPsiReport: Form 은 labelText 변수) — 폴백으로 constants 를 본다(주석 제외)
        for p, s in srcs.items():
            if not re.search(r'\.constants\.ts$', p):
                continue
            for i, line in enumerate(s.splitlines(), 1):
                if ('LBL' not in line and 'label' not in line) or re.match(r'\s*(//|/?\*)', line):
                    continue
                for m in LBL_CALL.finditer(line):
                    if not m.group(2) and not (m.group(3) or '').startswith('_'):
                        continue
                    code = m.group(1) or consts.get(m.group(2) or '', m.group(2) or '')
                    fb = (m.group(3) or '').lstrip('_')
                    if not fb or fb.lower() in ('search', 'reset', 'clear', 'input', 'ok', 'close', 'cancel', 'save', 'monthly', 'weekly', 'daily'):
                        continue
                    out.append((code, fb, os.path.relpath(p, ROOT).replace(chr(92), '/') + f':{i}'))
    return out


def norm(s):
    return re.sub(r'[\s.*_]+', '', (s or '').lower())


# 결함원장·일반화 상속 매칭에서 빼는 일반 UI 단어 — 여러 팝업·화면 클래스명에 공통으로 박혀 있어 대상 식별력이 없다(2026-10-30 T6)
GENERIC_TOKENS = {'FORM', 'POPUP', 'MODAL', 'SEARCH', 'BUTTON', 'GRID', 'SHEET', 'LIST', 'DATA', 'DIALOG', 'CLICK', 'SPREAD', 'VIEW'}


