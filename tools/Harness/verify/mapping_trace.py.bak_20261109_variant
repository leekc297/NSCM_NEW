def file_text(f, srcs):
    """대조표 구현 위치의 파일 본문 — 페이지 소스(경로 끝 일치) → nscm-fe 기준 경로(packages/·features/·apps/web/) 순. 없으면 None"""
    f = f.replace(chr(92), '/').lstrip('./')
    hit = [k for k in srcs if k == f or k.endswith('/' + f) or (('/' not in f) and (k.split('/')[-1] == f or k.split('/')[-1].endswith('.' + f)))]  # 'constants.ts' = <page>.constants.ts 약칭
    if hit: return srcs[hit[0]]
    for base in ('nscm-fe', 'nscm-fe/apps/web', 'nscm-fe/apps/web/src', 'nscm-fe/packages', 'nscm-fe/features'):
        p = os.path.join(ROOT, base, f)
        if os.path.isfile(p):
            try: return open(p, encoding='utf-8').read()
            except Exception: return ''
    if '/' in f:  # 경로 앞부분 생략(components/X.tsx 등) — 페이지 소스 끝 일치는 위에서 실패, 전 features 에서 끝 일치 1건이면 인정
        return None
    return None


