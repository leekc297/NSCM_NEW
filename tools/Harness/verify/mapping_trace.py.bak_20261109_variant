    excl_rows = [r for r in rmap.values() if r.get('src') == 'FE 대조표' and is_excl(r)]
    for d in inst.values():
        if d['et'] != 'LEDGER' or d['result'] not in ('NOT_RUN', 'NOPATH', 'TODO'): continue
        meth = ''
        for h in d['hits']:
