def asis_fpmerge():
    """AS-IS 컬럼 선언 Add*Column("라벨", DefColumns.X, FPMerge.Policy, …) 의 병합 정책 — {('main'|'popup'): {COL: 'Restricted'|'None'|'Always'}}.
