        else: v = '미검증'
        cnt = collections.Counter(rs)
        out.append({'menu_id': MENU, 'source': r['src'], 'section': r['section'][:60], 'row_id': r['id'], 'line': r['line'], 'status': r['status'], 'verdict': v,
                    'checks': ' '.join(f"{inst[k]['check']}={inst[k]['result']}" for k in ks)[:600], 'result_counts': ' '.join(f'{k}:{n}' for k, n in cnt.most_common()),
                    'instances': ' '.join(ks)[:600], 'summary': CLEAN(((f"[실행 안 됨] {r['dead'][:120]} · " if r.get('dead') else '') + (r.get('detail') or r['text']))[:340])})
    od = os.path.join(DOC, 'verify', MENU); os.makedirs(od, exist_ok=True)
    if a.to_ledger: to_ledger(inst, od, rmap)
    wcsv(os.path.join(od, 'mapping_trace.csv'), out)
    wcsv(os.path.join(od, 'mapping_trace_checks.csv'), [{'row_id': rid, 'source': rmap[rid]['src'], 'check': inst[k]['check'], 'instance': k, 'result': inst[k]['result']} for rid, ks in links.items() for k in ks])
    icols = ['key', 'trace_row', 'check', 'layer', 'et', 'name', 'display', 'impl', 'result', 'why', 'rows', 'cs']
    wcsv(os.path.join(od, 'mapping_trace_instances.csv'), [{'key': d['key'], 'trace_row': trace_id(d['key']), 'check': d['check'], 'layer': d['layer'], 'et': d['et'], 'name': d['name'], 'display': d['display'],
                                                         'impl': DEFS.get(d['check'], {}).get('impl', ''), 'result': d['result'], 'why': CLEAN(d['why']), 'rows': len(d['rows']), 'cs': ' '.join(dict.fromkeys(d['cs']))[:300]} for d in inst.values()], icols)
    summarize(out, inst, od, asis, page, mpath, len(mrows), len(acts_rows))
    return 0


