    if _FPM: return _FPM
    out = {'main': {}, 'popup': {}, 'combo_main': set(), 'combo_popup': set()}
    try:
        for f in rdcsv(os.path.join(DOC, 'asisfacts', 'screens', asis_id(), 'files.csv')):
            rel = f.get('file', '')
            if not rel.endswith('.cs') or rel.endswith('.Designer.cs'): continue
            pth = next((q for q in (os.path.join(ROOT, 'GSCM', rel), os.path.join(ROOT, 'GSCM_20260512', rel)) if os.path.exists(q)), '')
            if not pth: continue
            src = open(pth, encoding='utf-8', errors='ignore').read()
            try:
                from facts_combosrc import strip_comments; src = strip_comments(src)  # /* */ 블록 주석 안 선언은 실행되지 않는 코드(2026-10-27 SCP0007 메인 Add*Column 31줄)
            except Exception: pass
            kind = 'popup' if re.search(r'popup', os.path.basename(rel), re.I) else 'main'
            for ln in src.splitlines():
