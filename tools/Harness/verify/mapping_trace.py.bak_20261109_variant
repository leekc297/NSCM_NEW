                    if k2 == 'order': res = 'NA'  # 2026-11-09 CR-098(사용자 지시 · SCP0084): 조회조건 순서는 판정 대상 제외 — 실측 문구는 desc 로 참고 보존
                    out.append((chk, 'SCREEN' if chk == 'SC1' else 'COND', name, res, f'E2E smoke cond {k2}', desc[:90]))
                else:
                    chk = 'K-SA' if re.search(r'search ?area', name, re.I) else 'G3' if re.search(r'condition|reset', name, re.I) else 'H7' if re.search(r'excel', name, re.I) \
                        else 'K1' if re.search(r'sort|filter', name, re.I) else 'K2' if re.search(r'column|measure', name, re.I) else 'K4'
                    out.append((chk, 'SCREEN', name, res, f'E2E smoke common {name}', desc[:90]))
            elif t == 'crud': out.append(('F1', 'SCREEN', '', stres, f'E2E {kind}', desc[:90]))
            elif t == 'labels': out.append(('G4', 'COND*', desc, 'FAIL' if re.search(r'누락 [1-9]', desc) else 'PASS', f'E2E {kind} labels', desc[:90]))  # 라벨 어노테이션 자체 결과(테스트 전체 FAIL 을 조건마다 귀속하지 않는다 — 2026-10-26 오귀속 12건)
            elif t == 'columns': out.append(('A5', 'COL*', desc, 'FAIL' if not re.search(r'누락 0', desc) else 'PASS', f'E2E {kind} columns', desc[:90]))
            elif t == 'dynamic': out.append(('A8', 'SCREEN', '', stres, f'E2E {kind} dynamic', desc[:90]))
            elif t == 'i18n': out.append(('I2', 'SCREEN', '', 'PASS' if desc.startswith("'_' 노출 0") else 'FAIL', f'E2E {kind} i18n', desc[:90]))
            elif t in ('access', 'buttons', 'authcrud'): out.append(('J2', 'SCREEN', '', stres, f'E2E {kind} {t}', desc[:90]))
            elif t == 'calls':
                try:
                    for sheet, btn, status, *_ in json.loads(desc): out.append(('F4', 'CALL', f'{sheet}|{btn}', 'PASS' if int(status) < 400 else 'FAIL', f'E2E {kind} call-proc', f'{sheet}/{btn} HTTP {status}'))
                except Exception: pass
            elif t == 'dberr':
                out.append(('F4', 'DBERR', desc, 'FAIL' if re.search(r'BE 5xx [1-9]', desc) else 'WARN', f'E2E {kind} dberr', desc[:100]))
    return out


def ev_gates():
    out = []
    chk = os.path.join(DOC, 'gen', MENU, 'CHECK.md')
    if os.path.exists(chk):
        for line in open(chk, encoding='utf-8'):
            m = re.match(r'-\s*(BLOCK|WARN|PASS|OK)\s+(\w+)\s+(.*)', line.strip())
            if not m: continue
            lv, code, msg = m.groups()
            c = 'G03-WIRE' if code == 'G03' else 'SC1' if code.startswith('SC') else 'I1' if code.startswith('I18N') else ''
            if c: out.append((c, 'BLOCK' if lv == 'BLOCK' else lv, f'게이트 {code}', msg[:90]))  # M*·기타 G0*·H0* 는 생성 품질 게이트 — 대조표 행 증거 아님
    return out


def judge(rs):
    if not rs: return None
    if 'FAIL' in rs: return 'FAIL'
    if 'ERROR' in rs: return 'ERROR'
    if 'PASS' in rs: return 'WARN' if 'WARN' in rs else 'PASS'
    for v in ('WARN', 'REVIEW', 'NOT_RUN'):
        if v in rs: return v
    return 'NA' if all(x == 'NA' for x in rs) else 'NOT_RUN'


RX_REASON = re.compile(r'대체|이동|공통|룰|rule|hook|#\d+|지시|결정|AS-IS (?:미사용|주석|dead)|미사용|주석|디자이너|레이아웃|컨테이너|리소스|서버측|프레임워크|동일 사유|위와 동일|대응 요소 없|구조로|흡수|불필요|조회 전용|dead|개념 자체가 없|단일 뷰|단일 그리드|탭 자체|시트 1개|무의미|읽기 ?전용|read-?only|Enabled\s*=\s*false|disabled|기준표|search_cond|SC1|SC2|BUTTON_AREA|IN_CALENDAR|COLUMN_PERSONAL|COMMON_BUTTON', re.I)



_LBL_ALIAS_CACHE = {}


def label_alias_map(mid):
    """TO-BE 라벨 별칭(CR-092 SCP·SSP Valid→Active, 2026-10-30) — {정규화 AS-IS 라벨: 정규화 TO-BE 라벨}. 정본 tools/Harness/rules/label_alias.csv"""
    if mid in _LBL_ALIAS_CACHE:
        return _LBL_ALIAS_CACHE[mid]
    out = _LBL_ALIAS_CACHE.setdefault(mid, {})
    pth = os.path.join(ROOT, 'tools', 'Harness', 'rules', 'label_alias.csv')
    if not os.path.exists(pth):
        return out
    sf = lambda v: re.sub(r'[^0-9a-z가-힣]', '', re.sub(r'\*', '', v or '').lower())
    with open(pth, encoding='utf-8-sig', newline='') as f:
        for x in csv.DictReader(f):
            ss = [t.strip().upper() for t in (x.get('scope') or 'ALL').split(';') if t.strip()]
            if 'ALL' in ss or mid in ss or any(len(t) == 3 and mid.startswith(t) for t in ss):
                out[sf(x.get('asis_label'))] = sf(x.get('tobe_label'))
    return out

def main():
    asis = asis_id(); page = find_page(); srcs = page_sources(page)
    acts_rows, acts, main_cls = parse_actions(asis)
    global E
    E = Elems(asis, acts)
    led, trace_led = ev_ledger()
    e2e = ev_e2e(E); gates = ev_gates()
    syn = [r for r in rdcsv(os.path.join(DOC, 'verify', MENU, 'syn_check.csv')) if r.get('kind') != 'NOTE']
    pm_all = [r for r in rdcsv(os.path.join(DOC, 'tobefacts', 'db', 'proc_meta.csv')) if r.get('proc')]
    pm = [r for r in pm_all if r.get('menu_id', '').upper() == MENU]
    tail = lambda s: re.sub(r'^(P_|UP_|SP_)', '', s.split('.')[-1].upper())
    # 같은 화면 PROC_M 우선, 없으면 다른 화면(공용 팝업 — 예 SCP0005 Distribution Route) PROC_M
    proc_of = lambda sp: next((r['proc'] for r in pm if tail(r['proc']) == tail(sp)), '') or next((r['proc'] for r in pm_all if tail(r['proc']) == tail(sp)), '')

    mrows, mpath = parse_mapping(page) if page else ([], None)
    rows = mrows + acts_rows
    entry_sp = collections.defaultdict(set)
    for r in acts_rows:
        for t in sp_tokens(f"{r.get('endpoint', '')} {r['text']}"): entry_sp[r['entry']].add(t)
    # 간접 호출(CALL_LOCAL 3단계) — FindButton → FindData_Main → SP 처럼 진입점 자체에 ENDPOINT 가 없는 경우
    for ek in list(entry_sp.keys()) + [e for e in E.callees]:
        seen, stack = set(), list(E.callees.get(ek, []))
        while stack:
            cal = stack.pop()
            if cal in seen or len(seen) > 30: continue
            seen.add(cal); entry_sp[ek] |= entry_sp.get(cal, set()); stack += list(E.callees.get(cal, []))
    led_by_cs = collections.defaultdict(list)
    for x in led:
        if x['source'] == 'ASIS':
            for m in RX_CS.finditer(x.get('asis_ref', '')): led_by_cs[f'{m.group(1)}:{m.group(2)}'].append(x)

    inst = collections.OrderedDict()  # key → dict(check, subj, et, name, rows[], hits[], static)

    def add_inst(key, check, et, name, row, display=None):
        d = inst.setdefault(key, {'key': key, 'check': check, 'et': et, 'name': name, 'display': display or name, 'rows': [], 'hits': [], 'static': None, 'cs': []})
        d['rows'].append(row['id']); d['cs'] += row.get('cs', [])[:5]
        return key

    links = collections.defaultdict(list)  # row id → [inst key]
    blocked_rows = set()
    # 대조표 '미구현' 행 중 W9 실측(X-NOTIMPL E2E) 이 PASS 인 행 = 이미 구현됨 → 종속 검사 차단 해제(2026-10-27 사용자: 확인 없이 FAIL 처리 금지)
    impl_ok = set()
    try:
        for q in rdcsv(os.path.join(DOC, 'verify', MENU, 'verify_ledger.csv')):
            if q.get('source') == 'TRACE' and q.get('rule_id') == 'X-NOTIMPL' and q.get('result') == 'PASS' and re.match(r'^(E2E|수동)', q.get('tobe_ref', '')): impl_ok.add(q.get('asis_ref', ''))
    except Exception: pass
    for r in rows:
        cs, blocked = checks_for(r)
        if blocked and r['id'] not in impl_ok: blocked_rows.add(r['id'])
        els = E.of(r['text'] if r['src'] == 'FE 대조표' else f"{r['text']} {r.get('raw', '')}")
        own = []
        # 원장 ASIS 행이 이 문장 위치(file.cs:line)에 있으면 그 규칙도 이 행의 검사(원장이 아는 구체 검사 우선)
        if r['src'] == 'AS-IS 액션' and r['kind'] != 'ENTRY':
            for x in led_by_cs.get(r['cs'][0], []):
                k = f"{x['rule_id']}|LEDGER:{x['row_id']}"; own.append(add_inst(k, x['rule_id'], 'LEDGER', x['target'], r)); inst[k]['hits'].append((RES.get(x['result'], x['result']), f"원장 {x['row_id']}"))
        inherited = set()
        if r['src'] == 'AS-IS 액션' and r['kind'] != 'ENTRY':
            ent = [t for t in CHECKS if t['scope'] == 'ACT' and t['type'] != 'A_GENERIC' and t['rx'].search(r['meth'])]
            inherited = {c for t in ent for c in split(t['checks'])}
        for c in cs:
            d = DEFS.get(c, {'subject': 'ROW'}); sj = d['subject']
            if c in ('X-LOC', 'X-REASON', 'X-NOTIMPL') or sj == 'ROW':
                own.append(add_inst(f'{c}|ROW:{r["id"]}', c, 'ROW', r['id'], r)); continue
            if sj == 'SCREEN':
                own.append(add_inst(f'{c}|SCREEN', c, 'SCREEN', MENU, r, f'{MENU} 화면')); continue
            if sj == 'ENTRY':
                ek = r.get('entry') or r['id']; own.append(add_inst(f'{c}|ENTRY:{ek}', c, 'ENTRY', ek, r)); continue
            if sj == 'SP':
                sps = [x for x in sp_tokens(re.sub(r'\s+IF\s+@[A-Za-z0-9_]+', ' ', f"{r.get('endpoint', '')} {r['text']}")) if not x.startswith('@')] or (sorted(entry_sp.get(r.get('entry'), [])) if r['src'] == 'AS-IS 액션' else [])
                if sps:
                    for sp in dict.fromkeys(sps):
                        tp = proc_of(sp) or sp
                        own.append(add_inst(f'{c}|SP:{tp.split(".")[-1]}', c, 'SP', tp, r))
                elif c not in inherited:
                    own.append(add_inst(f'{c}|{"ENTRY:" + r["entry"] if r.get("entry") else "ROW:" + r["id"]}', c, 'ENTRY' if r.get('entry') else 'ROW', r.get('entry') or r['id'], r))
                continue
            els2 = [('PCOL', n) if et == 'COL' and n in E.popup_cols else (et, n) for et, n in els]
            if c in ('C1', 'C4') and r['src'] == 'AS-IS 액션' and r.get('meth') in E.handler_cond and not any(et == 'COND' for et, _ in els2):
                els2 = els2 + [('COND', E.handler_cond[r['meth']])]  # 조건 변경 핸들러(또는 그 피호출) 안의 문장 → 그 조건 컨트롤의 C1/C4 요소(2026-10-30)
            ok = [(et, n) for et, n in els2 if c in ELEM_OK.get(et, set())]
            if c == 'D4' and r['src'] == 'AS-IS 액션' and r.get('meth') != 'InsertButton':
                ok = [(et, n) for et, n in ok if et not in ('COL', 'PCOL')]  # 신규행 기본값은 InsertButton 의 SetValue 만 — 다른 진입점의 SetValue 는 연쇄(C3)·팝업 반영(M4)
            if c in ('G5', 'H6') and r['src'] == 'AS-IS 액션':
                ok = [(et, n) for et, n in ok if et != 'COL' or n in E.trigger_cols]  # 팝업 검사는 팝업을 여는 셀에만 — 인자로 넘기는 컬럼 전체에 붙이지 않는다
            if ok:
                for et, n in ok: own.append(add_inst(f'{c}|{et}:{n}', c, et, n, r, ' / '.join(dict.fromkeys(E.aliases(et, n)))[:80]))
            elif c in inherited:
                pass  # 진입점에서 물려받은 요소 검사인데 이 문장에 요소가 없음 → 진입점 행이 맡는다
            elif r.get('entry'):
                # 문장 종류 검사인데 대상 요소가 없음(예: request.CommandTimeout UI_PROP) → 요소 검사를 할 수 없다 = 진입점 동작 재현(X-ROW)으로 검증
                own.append(add_inst(f'X-ROW|ENTRY:{r["entry"]}', 'X-ROW', 'ENTRY', r['entry'], r))
            else:
                own.append(add_inst(f'{c}|ROW:{r["id"]}', c, 'ROW', r['id'], r))
        if not own and r.get('entry'):
            # 문장 자체에 붙는 검사가 없음 = 진입점 동작으로 검증 — 진입점의 화면·진입점 단위 인스턴스를 공유한다
            ecs, _ = checks_for({**r, 'kind': 'ENTRY'})
            for c in ecs:
                sj = DEFS.get(c, {}).get('subject', 'ROW')
                own.append(add_inst(f'{c}|SCREEN', c, 'SCREEN', MENU, r, f'{MENU} 화면') if sj == 'SCREEN' else add_inst(f'{c}|ENTRY:{r["entry"]}', c, 'ENTRY', r['entry'], r))
        links[r['id']] = list(dict.fromkeys(own))

    # ── 인스턴스 증거 연결 ──
    def lmatch(x, d):
        if x['rule_id'] != d['check']: return False
        et = d['et']
        if et == 'SCREEN': return x['source'] in ('RULE_SCREEN', 'CONFIRMED', 'DEFECT', 'GENERAL') or x.get('area') == '화면'
        if et == 'COND':
            if x['source'] != 'SEARCH': return False
            t = norm(re.sub(r'^조회조건\s*', '', x['target']))
            return any(norm(al) == t for al in E.aliases('COND', d['name']))
        if et == 'COL':
            if x['source'] == 'COLUMN': return bool(re.match(r'^[^.\s]+\.' + re.escape(d['name']) + r'\b', x['target']))
            return x['source'] == 'ASIS' and bool(re.search(r'(?<![A-Z0-9_])' + re.escape(d['name']) + r'(?![A-Z0-9_])', f"{x['target']} {x['condition']}"))
        if et == 'SP': return x['source'] == 'SP' and tail(x['target']) == tail(d['name'])
        if et == 'ENTRY': return x['source'] == 'ASIS' and x.get('asis_ref', '').rstrip().endswith(d['name'].split('.', 1)[-1]) and d['name'].split('.')[0] in x.get('asis_ref', '')
        if et in ('BTN', 'POPUP', 'MSG'): return x['source'] == 'ASIS' and d['name'] in f"{x['target']} {x['condition']} {x['asis_ref']}"
        return False

    for d in inst.values():
        if d['et'] == 'LEDGER': continue
        for x in led:
            if lmatch(x, d): d['hits'].append((RES.get(x['result'], x['result']), f"원장 {x['row_id']} {x['source']}"))
        for chk, sj, name, res, src, note in e2e:
            if chk != d['check']: continue
            if sj == 'SCREEN' and d['et'] == 'SCREEN': d['hits'].append((res, src))
            elif sj == 'COND' and d['et'] == 'COND' and any(norm(al) == norm(name) for al in E.aliases('COND', d['name'])):
                # 원장(SEARCH 행)에 검증 엔진/사람의 확정 판정(PASS/FAIL/NA)이 있으면 smoke 의 건수 차이 WARN 은 정보일 뿐 — 실측이 정본(2026-10-26: G1 멀티선택 PASS 가 smoke WARN 에 덮이던 결함)
                if res in ('REVIEW', 'WARN') and any(h[1].startswith('원장 ') and h[0] in ('PASS', 'FAIL', 'NA') for h in d['hits']): continue
                d['hits'].append((res, src))
            elif sj == 'COND*' and d['et'] == 'COND': d['hits'].append((res, src))
            elif sj == 'COL*' and d['et'] == 'COL': d['hits'].append(('FAIL' if res == 'FAIL' and d['name'] in name else 'PASS' if res == 'PASS' else 'REVIEW', src))
            elif sj == 'CALL' and d['et'] == 'SP':
                sheet, btn = name.split('|', 1)
                p = next((r['proc'] for r in pm if r['sheet'] == sheet and r['btn'] == btn), '')
                if p and tail(p) == tail(d['name']): d['hits'].append((res, src))
            elif sj == 'DBERR' and d['et'] == 'SP' and tail(d['name']) in name.upper(): d['hits'].append((res, src))
        if d['check'] == 'A1' and d['et'] == 'SP':
            for g in rdcsv(__import__('e2e_paths').golden_path(MENU)):  # 2026-11-06 화면 폴더 골든 요약 우선
                if g.get('screen', '').upper() == MENU and tail(g.get('asis_sp', '') or '-') == tail(d['name']):
                    v = (g.get('verdict') or g.get('result') or '').upper()
                    # 데이터 원천이 다르다(AS-IS dev MSSQL vs TO-BE Oracle) — 행수·값 차이는 FAIL 이 아니라 해석 필요(REVIEW), 컬럼 집합 차이는 구조 결함(FAIL)
                    ar, tr_ = int(g.get('asis_rows') or -1), int(g.get('tobe_rows') or -1)
                    zero = (ar == 0) != (tr_ == 0) and max(ar, tr_) > 0  # 한쪽만 0건 = 조회 자체가 안 됨 → FAIL (사용자 2026-10-26)
                    res = 'PASS' if v == 'PASS' else 'FAIL' if (v in ('COLS', 'ERR') or zero) else 'NA' if (v == 'SKIP' and g.get('kind') == 'SAVE') else 'REVIEW'
                    note = (' — 저장 SP 는 골든(조회 결과 비교) 대상 아님: DB 반영은 CRUD 실저장(F1)·BE 오류(F4)로 판정' if (v == 'SKIP' and g.get('kind') == 'SAVE') else ' — 한쪽만 0건(조회 불가)' if zero else ' — 같은 조건 건수 차이(AS-IS dev DB ≠ TO-BE DB) 해석 필요' if v in ('ROWS', 'DIFF') else ' — 컬럼 집합 차이' if v == 'COLS' else ' — 실행 오류' if v == 'ERR' else ' — 파라미터 미정' if v == 'SKIP' else '')
                    if g.get('common_rows'): note += f" · 데이터 기준: 공통 {g['common_rows']}행 / AS-IS 전용 {g.get('asis_only', '')} / TO-BE 전용 {g.get('tobe_only', '')} (환경 데이터 차이 — 같은 행의 값은 A7, 순서는 A6 에서 대조)"
                    d['hits'].append((res, f"golden {v} AS-IS {ar}행 ↔ TO-BE {tr_}행: Doc/golden/{MENU}/{g.get('asis_sp', '')}.md{note}"))
        if d['check'] == 'A1' and d['et'] == 'SP' and not d['hits']:
            d['static'] = ('REVIEW', f"골든 비교 케이스 없음({d['name']} — 팝업·보조 SP 는 golden_cases.csv 에 FE 실전송 파라미터로 케이스 추가 필요)")
        if d['check'] == 'A6' and d['et'] == 'SP':
            for s in rdcsv(os.path.join(DOC, 'verify', MENU, 'sort_check.csv')):
                if tail(s['sp']) == tail(d['name']) or tail(s.get('tobe_proc', '') or '-') == tail(d['name']):
                    d['hits'].append(({'PASS': 'PASS', 'FAIL': 'FAIL', 'NA': 'NA'}.get(s['verdict'], 'REVIEW'), f"정렬대조 {s['verdict']} {s['note'][:50]}"))
            # 실측 순서(golden.py 2026-10-28): 같은 인자의 AS-IS·TO-BE 결과에서 공통·유일 행의 상대 순서 — ORDER BY 가 같아도 실제 순서가 다르면 FAIL
            no_order = any((tail(s['sp']) == tail(d['name']) or tail(s.get('tobe_proc', '') or '-') == tail(d['name'])) and s['verdict'] == 'NA' for s in rdcsv(os.path.join(DOC, 'verify', MENU, 'sort_check.csv')))
            for g in rdcsv(__import__('e2e_paths').golden_path(MENU)):  # 2026-11-06 화면 폴더 골든 요약 우선
                if no_order or g.get('screen', '').upper() != MENU or (g.get('order') or '') not in ('PASS', 'DIFF'): continue
                if tail(g.get('asis_sp', '') or '-') == tail(d['name']) or tail(g.get('tobe_proc', '') or '-') == tail(d['name']):
                    d['hits'].append(('PASS' if g['order'] == 'PASS' else 'FAIL', f"실측 순서대조 {g['order']} 공통 {g.get('common_rows', '')}행(Doc/golden/{MENU}/{g.get('asis_sp', '')}.order.csv)"))
        if d['check'] == 'DB-SYN' and d['et'] == 'SP':
            # 이 화면 syn_check 에 없는 SP(공용 팝업 — 타 화면 PKG)는 다른 화면의 syn_check.csv 에서 찾는다
