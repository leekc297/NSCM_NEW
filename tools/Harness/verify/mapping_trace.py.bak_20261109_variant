class Elems:
    def __init__(self, asis, acts):
        sd = os.path.join(DOC, 'asisfacts', 'screens', asis)
        self.lab = collections.defaultdict(list)  # 요소 이름 → 화면 라벨 후보
        props = rdcsv(os.path.join(sd, 'props.csv'))
        item_of = {r['value'].replace('this.', ''): r['target'].replace('this.', '') for r in props if r.get('prop') == 'Control'}
        text_of = {r['target'].replace('this.', ''): r['value'].strip('"') for r in props if r.get('prop') == 'Text'}
        for ctl, item in item_of.items():
            t = text_of.get(item) or text_of.get(ctl)
            if t and not re.match(r'^(layoutControlItem|lci)\d*$', t, re.I): self.lab[ctl].append(t.rstrip('*'))
        self.conds = set()
        for c in rdcsv(os.path.join(sd, 'controls.csv')):
            n = c.get('name', '')
            if RX_COND.fullmatch(n) and not NOT_COND.match(n): self.conds.add(n)
            b = re.sub(r'^(cbo|clb|txt|chk|btn|rdo|rgrp|drp|usr|dt|num|mrp)', '', n)
            if b and b != n: self.lab[n].append(re.sub(r'([a-z0-9])([A-Z])', r'\1 \2', b))
        self.sc_excl = {}  # AS-IS 조회조건 컨트롤 → (usage, 사유) — 기준표가 USE 가 아닌 것으로 정한 조건(TO-BE 룰 CR-071: 기준표 정의 조건만 사용)
        for r in rdcsv(os.path.join(ROOT, 'tools', 'Harness', 'rules', 'search_cond.csv')):
            if r.get('menu_id', '').upper() != MENU: continue
            for ctl, labs in list(self.lab.items()):
                if any(norm(l) == norm(r['asis_name']) for l in labs):
                    if r.get('tobe_name') not in ('', '-'): self.lab[ctl].append(r['tobe_name'])
                    # 보류(REVIEW·COMMON_REVIEW·SUNSET_REVIEW)는 AS-IS 그대로 생성 대상이라 제외 아님(40_SEARCH_COND §1)
                    if (r.get('usage') or 'USE') in ('DROP', 'SUNSET', 'NOT_MIGRATED', 'MERGED', 'BUTTON_AREA', 'BUTTON', 'IN_CALENDAR', 'COLUMN_PERSONAL', 'COMMON_BUTTON'): self.sc_excl[ctl] = (r.get('usage'), (r.get('usage_reason') or r.get('tobe_note') or r.get('change') or '').strip())
        pf = os.path.join(DOC, 'e2e', 'specs', f'{MENU}.plan.json')
        if os.path.exists(pf):
            for f in json.load(open(pf, encoding='utf-8')).get('fields', []):
                if f.get('asis'): self.lab[f['asis']] += list(f.get('labels') or [f.get('label', '')]); self.conds.add(f['asis'])
        self.cols = {}  # 컬럼 → 헤더 라벨
        for r in rdcsv(os.path.join(DOC, 'verify', MENU, 'verify_ledger.csv')):
            m = re.match(r'^[^.\s]+\.([A-Z0-9_]+)(?:\s*\((.*?)\*?\))?', r.get('target', '')) if r.get('source') == 'COLUMN' else None
            if m: self.cols[m.group(1)] = (m.group(2) or '').rstrip('*')
        for rs in acts.values():
            for r in rs:
                for m in re.finditer(r'DefColumns\.([A-Z0-9_]+)(?![A-Z0-9_…])', r['raw'] + ' ' + r['value']): self.cols.setdefault(m.group(1), '')  # '…' = 추출기 말줄임(잘린 이름 제외)
        self.main_cls = collections.Counter(r['class'] for rs in acts.values() for r in rs).most_common(1)[0][0] if acts else ''
        self.popups = {c for c, _ in acts} - {self.main_cls} if acts else set()
        # W5(2026-10-26): 검증 엔진이 컬럼 대상 검사에 쓰는 AS-IS·TO-BE 사실 — 라벨·표시(Division 별)·편집 기대·셀 규칙·TO-BE 메타
        self.tobe = {r['column_name']: r for r in rdcsv(os.path.join(DOC, 'tobefacts', 'db', 'sheet_columns.csv')) if r.get('program_id', '').upper() == MENU}
        # grid_effective·grid_rule 은 시트별 행 — 같은 컬럼명이 팝업 시트(Distribution Route)에도 있어 뒤 행이 메인 시트 행을 덮어썼다(2026-10-26 FROM_CITY 'City' 오판) → 메인 시트(TO-BE 메타와 가장 많이 겹치는 시트) 우선
        def by_main(rows):
            cnt = collections.Counter(r.get('sheet', '') for r in rows if r.get('column') in self.tobe)
            ms = cnt.most_common(1)[0][0] if cnt else ''
            out = {r['column']: r for r in rows if r.get('sheet', '') == ms}
            for r in rows: out.setdefault(r['column'], r)
            return out, ms
        self.geff_all = rdcsv(os.path.join(sd, 'grid_effective.csv')); self.grule_all = rdcsv(os.path.join(sd, 'grid_rule.csv'))
        self.geff, self.main_sheet = by_main(self.geff_all)
        self.grule, _ = by_main(self.grule_all)
        self.eexp = {r['column']: r for r in rdcsv(os.path.join(sd, 'edit_expect.csv'))}
        self.crule = {r['column']: r for r in rdcsv(os.path.join(sd, 'cell_rules.csv'))}
        # 팝업 클래스 문장에만 나오고 이 화면 TO-BE 시트에도 없는 컬럼 = 팝업 내부 그리드 컬럼(메인 그리드에서 찾으면 오판)
        by_cls = collections.defaultdict(set)
        for rs in acts.values():
            for r in rs:
                for m in re.finditer(r'DefColumns\.([A-Z0-9_]+)(?![A-Z0-9_…])', r['raw'] + ' ' + r['value']): by_cls[r['class']].add(m.group(1))
        main_cols = by_cls.get(self.main_cls, set()) | set(self.tobe) | {c for c in self.cols if self.cols.get(c)}
        self.popup_cols = {c for cls, cs in by_cls.items() if cls != self.main_cls for c in cs} - main_cols
        # 팝업을 여는 셀(트리거) = POPUP 문장이 있는 메서드의 guard 'e.Column == …DefColumns.X' — G5·H6 는 이 컬럼에만 붙는다(인자 컬럼 전체에 붙이던 과대귀속 수정)
        self.trigger_cols = set()
        for (cls, meth), rs in acts.items():
            if cls != self.main_cls or not any(r['kind'] == 'POPUP' for r in rs): continue
            for r in rs:
                for m in re.finditer(r'e\.Column\s*==\s*\w+\.GetColumnIndex\(\s*DefColumns\.([A-Z0-9_]+)', r['guard'] + ' ' + r['raw']): self.trigger_cols.add(m.group(1))
        # 콤보 SQL ID(plan.json comboId) → 조회조건 컨트롤 — FE 대조표 행이 SQL_ID 만 적은 경우 조건 요소로 잇는다
        self.combo_of = {}
        if os.path.exists(pf):
            for f in json.load(open(pf, encoding='utf-8')).get('fields', []):
                if f.get('comboId') and f.get('asis'): self.combo_of[f['comboId']] = f['asis']
        # 호출 그래프(CALL_LOCAL) — 진입점이 간접 호출하는 SP 까지 잇는다(FindButton → FindData_Main → SP)
        self.callees = collections.defaultdict(set)
        for (cls, meth), rs in acts.items():
            for r in rs:
                if r['kind'] == 'CALL_LOCAL': self.callees[f'{cls}.{meth}'].add(f"{cls}.{r['target']}")
        # 조건 컨트롤 이벤트 핸들러 → 조건 컨트롤(events.csv) — 핸들러 본문의 GRID_CLEAR 문장(ClearDataSource 등)에는 컨트롤 이름이 없어 C4 요소를 못 찾던 결함(2026-10-30 SCP0111 Plan Date 그리드 초기화 미검출)
        #   CALL_LOCAL 피호출 메서드(SetChangedPeriod 등)도 같은 조건 컨트롤에 귀속
        self.handler_cond = {}
        for ev in rdcsv(os.path.join(sd, 'events.csv')):
            tgt = (ev.get('target') or '').replace('this.', '').split('.')[0]; h = (ev.get('handler') or '').strip()
            if h and tgt in self.conds and (ev.get('op') or '+=') == '+=': self.handler_cond.setdefault(h, tgt)
        for (cls, meth), rs in acts.items():
            if meth in self.handler_cond:
                for r in rs:
                    if r['kind'] == 'CALL_LOCAL': self.handler_cond.setdefault(r['target'], self.handler_cond[meth])

    def of(self, text):
        out = []
        for m in RX_COND.finditer(text):
            n = m.group(0)
            if n in self.conds or (not NOT_COND.match(n) and n in self.lab): out.append(('COND', n))
        for cid, ctl in self.combo_of.items():
            if re.search(r'(?<![A-Za-z0-9_])' + re.escape(cid) + r'(?![A-Za-z0-9_])', text): out.append(('COND', ctl))
        for m in RX_BTN.finditer(text):
            b = m.group(0).split('_')[0]  # btnFromSrch_Click(메서드) → btnFromSrch(컨트롤)
            if b not in ('btnButtonList',): out.append(('BTN', b))
        for c in self.cols:
            if re.search(r'(?<![A-Za-z0-9_])' + re.escape(c) + r'(?![A-Za-z0-9_])', text): out.append(('COL', c))
        for p in self.popups:
            if p in text: out.append(('POPUP', p))
        for m in RX_MSG.finditer(text): out.append(('MSG', m.group(0)))
        return list(dict.fromkeys(out))

    def aliases(self, et, n):
        if et == 'COND': return [n] + self.lab.get(n, [])
        if et in ('COL', 'PCOL'): return [n] + ([self.cols[n]] if self.cols.get(n) else [])
        return [n]


