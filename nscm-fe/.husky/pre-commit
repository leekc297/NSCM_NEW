. "$(dirname "$0")/_/husky.sh"

npx lint-staged

# Hard Boundary 변경 감지 (룰 #62 regression-zero) — commit 차단 X, 경고만.
# 의도적 공용 자원 변경 시 분리 PR + 4 도메인 cross-check 권고.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
HB_HITS=$(printf "%s\n" "$STAGED" | grep -E '^(nscm-fe/)?(packages/(shared|foundation|lges)/|features/[^/]+/src/components/)|^nscm-be/' || true)
if [ -n "$HB_HITS" ]; then
  printf "\n\033[33m[regression-zero][warn] Hard Boundary 영역 변경 감지 — 분리 PR + 4 도메인 cross-check 권고\033[0m\n"
  printf "%s\n" "$HB_HITS" | sed 's/^/  - /'
  printf "  → 룰: Doc/_rules_v2/hooks/regression-zero-mandatory.md\n\n"
fi
